       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那股热度带着一点情色的暖意，明知正被卷进去却还不想出来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
