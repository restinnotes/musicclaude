 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "这份笃定很快散了，我心里空落落的，说不清舍不得什么。",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不能倒下却很想停下来",
       "keys": [],
       "from": [
        "S01-B2-p1"
       ]
      },
      {
       "text": "心里明明有东西",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      },
      {
       "text": "生气还是想念？",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ],
       "emotion": "悬着"
      },
      {
       "text": "伸手只摸到虚空",
       "keys": [],
       "from": [
        "S01-B4-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我离开了熟悉的生活，起初觉得终于不用再委屈自己。",
       "keys": [],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "找不到方向",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "偶尔想起从前，我仍想往前走，却不知道以后靠什么让自己安定下来。",
       "keys": [],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧场景忽然回来",
       "keys": [],
       "from": [
        "S01-B5-p1"
       ]
      },
      {
       "text": "记得清楚却回不去",
       "keys": [],
       "from": [
        "S01-B5-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "我舍不得从前自在的日子，一想到以后不能再那样过，心里就慌。",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "珍惜的东西还在",
       "keys": [],
       "from": [
        "S02-B2-p2"
       ]
      },
      {
       "text": "却不能像从前那样拥有",
       "keys": [],
       "from": [
        "S02-B2-p2"
       ]
      },
      {
       "text": "呼吸越来越急",
       "keys": [],
       "from": [
        "S02-B3-p1"
       ],
       "emotion": "不安"
      },
      {
       "text": "最后还是没落稳",
       "keys": [],
       "from": [
        "S02-B3-p2"
       ],
       "emotion": "悬着"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "那份舍不得一上来，我就提醒自己受过他们的气，怕心软后忘了为何离开。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "我没事第一次还有几分相信",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      },
      {
       "text": "第二次努力相信 第三次仍很在意",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "我还是不甘心：难道为了不再受他们的气，就得连以前的好日子也一起丢掉？",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "还不肯认输",
       "keys": [],
       "from": [
        "S02-B5-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "我心里还憋着气，可想起和他们在一起、被他们当作自己人时，还是短暂地高兴了。",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "愤怒与抗拒像重锤砸下",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "温柔得让人心颤",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ],
       "emotion": "亲密"
      },
      {
       "text": "越怀念越感到与眼前的距离",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ],
       "emotion": "亲密"
      },
      {
       "text": "刺痛得让人绝望",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可那点高兴还没散，我就又酸了：从前那样的日子回不去了，离开后就一定会更好吗？",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "轻松过后还是心酸",
       "keys": [],
       "from": [
        "S03-B4-p2",
        "S03-B4-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起和他们亲近的时候，我真盼着一切还能像从前那样继续。",
       "keys": [],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧记忆忽然鲜活",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      },
      {
       "text": "短暂的幸福",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可越盼，我越怀疑当初是不是走错了，却想不出如果没走，如今会怎样。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "美好回忆也刺痛",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "还能挽回吗？",
       "keys": [],
       "from": [
        "S04-B4-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我仍不服气，觉得当初那些气不该忍；可连过去开心的事都不敢多想，也太为难自己。",
       "keys": [],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "夜色里并肩低语",
       "keys": [],
       "from": [
        "S05-B1-p2"
       ]
      },
      {
       "text": "不能就这样算了",
       "keys": [],
       "from": [
        "S05-B2-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "眷恋里带着失落",
       "keys": [],
       "from": [
        "S05-B3-p3"
       ],
       "emotion": "孤单"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争得没了力气，不服气也渐渐淡了；想到如今不在他们身边，我只觉得难受。",
       "keys": [],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音稀疏下来 心里未必平静",
       "keys": [],
       "from": [
        "S05-B4-p2"
       ]
      },
      {
       "text": "不是想通了 是抵抗得累了",
       "keys": [],
       "from": [
        "S05-B4-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "难受缓了，我又想起和他们在一起、不必防备的日子。",
       "keys": [],
       "from": [
        "S06-1",
        "S06-2",
        "S06-4"
       ]
      },
      {
       "text": "这回没急着用受过的气压住想念。",
       "keys": [],
       "from": [
        "S06-1",
        "S06-2",
        "S06-4"
       ]
      },
      {
       "text": "离开后遇事，我常得独自撑着。",
       "keys": [],
       "from": [
        "S06-1",
        "S06-2",
        "S06-4"
       ]
      },
      {
       "text": "这才懂得，有人陪着有多轻松。",
       "keys": [],
       "from": [
        "S06-1",
        "S06-2",
        "S06-4"
       ]
      },
      {
       "text": "那些日子确实存在过，想起心里便暖。",
       "keys": [],
       "from": [
        "S06-1",
        "S06-2",
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "压住的愿望委屈和思念终于浮现",
       "keys": [],
       "from": [
        "S06-B1-p3"
       ]
      },
      {
       "text": "暂时松开戒备",
       "keys": [],
       "from": [
        "S06-B1-p3"
       ]
      },
      {
       "text": "母亲轻轻哼歌",
       "keys": [],
       "from": [
        "S06-B1-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我想再过不用多说就彼此亲近的日子。",
       "keys": [],
       "from": [
        "S06-3"
       ]
      },
      {
       "text": "又怕以后再没有那样的日子。",
       "keys": [],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "盼着回应却没把握",
       "keys": [],
       "from": [
        "S06-B2-p4"
       ],
       "emotion": "悬着"
      },
      {
       "text": "话停在一半",
       "keys": [],
       "from": [
        "S06-B3-p3"
       ],
       "emotion": "悬着"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚安心一点，我却猛然想到：以后遇难事还得一个人扛，我撑得住吗？",
       "keys": [],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "后颈一凉 脉搏猛跳",
       "keys": [],
       "from": [
        "S07-B1-p3"
       ]
      },
      {
       "text": "心里还没安定",
       "keys": [],
       "from": [
        "S07-B2-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "当初离开时，我只想着不再受他们的气，没想到会这么孤单；早知道这样，我还会走吗？",
       "keys": [],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "事情过去了 身体还不信",
       "keys": [],
       "from": [
        "S07-B3-p2"
       ]
      },
      {
       "text": "想冲出去却找不到出口",
       "keys": [],
       "from": [
        "S07-B3-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "我想找回从前的亲近，却不甘心再受那些气。",
       "keys": [],
       "from": [
        "S07-3"
       ]
      },
      {
       "text": "当初离开的决心，我也找不回了。",
       "keys": [],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "越熟悉越看见失去",
       "keys": [],
       "from": [
        "S07-B4-p3"
       ]
      },
      {
       "text": "把人从甜梦里拽回严寒",
       "keys": [],
       "from": [
        "S07-B5-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我暂时把回不回去放到一边，想起从前和他们亲近的时光，心里又暖了一会儿。",
       "keys": [],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "回头一眼 温柔又不舍",
       "keys": [],
       "from": [
        "S08-B2-p2",
        "S08-B2-p3"
       ]
      },
      {
       "text": "胸口终于吸进一口气",
       "keys": [],
       "from": [
        "S08-B3-p1"
       ],
       "emotion": "安心"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可暖意很快淡了，想到以后遇上难事时回忆不能陪我，我心里又悬了起来。",
       "keys": [],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那份安静刚被认出就退去",
       "keys": [],
       "from": [
        "S08-B2-p1"
       ]
      },
      {
       "text": "只是瞬间喘息还没重新安顿",
       "keys": [],
       "from": [
        "S08-B2-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "我忽然分不清，想回去是舍不得从前的生活，还是难受时只想有人陪。",
       "keys": [],
       "from": [
        "S09-1",
        "S09-2"
       ]
      },
      {
       "text": "这念头让我心慌，连往下想都不敢。",
       "keys": [],
       "from": [
        "S09-1",
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚稳住又散开",
       "keys": [],
       "from": [
        "S09-B1-p2"
       ]
      },
      {
       "text": "最初的问题又浮上来仍没有简单答案",
       "keys": [],
       "from": [
        "S09-B1-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "我渐渐明白，最舍不得的是从前被他们当作自己人的日子。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      },
      {
       "text": "可就算回去，也未必还能那样亲近。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      },
      {
       "text": "当初受过的气，不能当没发生。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      },
      {
       "text": "光凭舍不得，我还是不敢回去。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "历经许多仍无彻底答案的迟疑和疲惫",
       "keys": [],
       "from": [
        "S10-B1-p1"
       ]
      },
      {
       "text": "熟悉的声音再次浮现",
       "keys": [],
       "from": [
        "S10-B1-p5"
       ]
      },
      {
       "text": "只以断续碎片出现没有完整铺开",
       "keys": [],
       "from": [
        "S10-B1-p5"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "我反复想得很累，还是没有答案，连眼下的日子也过得不踏实。",
       "keys": [],
       "from": [
        "S10-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "整个人悬在半空",
       "keys": [],
       "from": [
        "S10-B2-p1"
       ]
      },
      {
       "text": "累得不想再讲一遍",
       "keys": [],
       "from": [
        "S10-B4-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我明知回去未必找得回那份亲近，还是忍不住盼着能。",
       "keys": [],
       "from": [
        "S11-3",
        "S11-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "害怕还在脚却已经往前走",
       "keys": [],
       "from": [
        "S11-B2-p2"
       ]
      },
      {
       "text": "柔软祈祷带回迈步节奏",
       "keys": [],
       "from": [
        "S11-B2-p2"
       ]
      },
      {
       "text": "祈祷开始变成意志",
       "keys": [],
       "from": [
        "S11-B2-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可我不愿只凭这点指望，就回去继续过忍让的日子。",
       "keys": [],
       "from": [
        "S11-1",
        "S11-2"
       ]
      },
      {
       "text": "我想暂缓决定，先把眼下日子过稳，或许比急着回去踏实。",
       "keys": [],
       "from": [
        "S11-1",
        "S11-2"
       ]
      },
      {
       "text": "我仍怕遇事只能自己扛，心里没底，却不想因害怕收回打算。",
       "keys": [],
       "from": [
        "S11-1",
        "S11-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "一次次顶住再用力",
       "keys": [],
       "from": [
