{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"落下来以后，却还没有真正落稳，仿佛仍悬在水面上方\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这里是刚刚踏上船板的感觉，还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"心里一下热了起来\"\n        },\n        {\n          \"text\": \"怕让对方为难\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"中\",\n          \"waste\": \"还不敢坦白\",\n          \"keep\": \"怕让对方为难\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像一根温柔的刺\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"温柔的刺\"\n        },\n        {\n          \"quote\": \"因为太喜欢眼前的东西，所以还没有失去，就已经生出一丝舍不得\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"慢慢放松\",\n          \"where\": \"后\",\n          \"waste\": \"没有退开\",\n          \"keep\": \"仍愿意亲近，他才\"\n        },\n        {\n          \"text\": \"他也想靠近些\",\n          \"point\": \"喜欢得几乎藏不住\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"几乎\"\n        },\n        {\n          \"text\": \"可他怕太急\",\n          \"point\": \"还没分开就先舍不得\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可他怕太急会破坏相处时的自在\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"它只在水面上露了一下头，没有变成一场真正的倾诉\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"音乐并未走向悲剧，却在那份顺畅之中生出了阻力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"思绪像被风吹碎的倒影，粼粼闪烁却难以拼凑完整\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"难得不用琢磨以后\",\n          \"point\": \"只想待在这份亲近里\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"难得不用琢磨以后\"\n        },\n        {\n          \"text\": \"他忽然想说出\",\n          \"point\": \"念头就淡了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可还没想好怎么开口\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"本来一句话已经够了，却忍不住再说一遍，又折回来补上更多细节\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"自己也许还没有意识到在害怕什么，动作已经先透露了出来\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"每一秒都在倒数\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"熟悉的亲近感又回来了\",\n          \"point\": \"想起上次没说出口的话\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"熟悉的亲近感又回来了\"\n        },\n        {\n          \"text\": \"他想把心意全说出来\",\n          \"point\": \"能喜欢坦白心意的自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"也盼着对方\"\n        },\n        {\n          \"text\": \"他想把眼下的好留久些\",\n          \"point\": \"怕让对方为难\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"留久些；失去自在\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"原来一直托着你的水波和摇晃，忽然像被抽掉了\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"从“我与你”的亲密中抽身，转而跌回自己的内心\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份幸福是真实的吗？它能维持多久？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方一直没退开\",\n          \"point\": \"终于没藏住喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方一直没退开，所以\"\n        },\n        {\n          \"text\": \"对方看出他有多在乎\",\n          \"point\": \"反倒空落落的\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"反倒；还怕自己太黏\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"白天明明和某个人相处得很好，晚上回到家后，心头却泛起一阵酸楚\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"恍惚间却像已经成了回忆\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方看出他的在乎\",\n          \"point\": \"放下心来\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却仍和他亲近\"\n        },\n        {\n          \"text\": \"他刚才那么怕被嫌弃\",\n          \"point\": \"对方其实并不知道\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"安静下来后才发现\"\n        },\n        {\n          \"text\": \"他又猜\",\n          \"point\": \"会不会也舍不得\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"也舍不得这份亲近\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"原先压着的感受反而变成了动力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"你明知道自己正在被卷进去，却暂时不想出来\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这一刻纵然完美，你也没有办法让它停住\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方总愿意陪着他\",\n          \"point\": \"或许也需要他\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"渐渐觉得对方或许\"\n        },\n        {\n          \"text\": \"想到这点\",\n          \"point\": \"只想继续陪在对方身边\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想到这点，他就\"\n        },\n        {\n          \"text\": \"他盼着以后\",\n          \"point\": \"还会想到自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方想找人陪时\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"没有哲学，没有防卫，没有分析\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连身体也像恢复了弹性，甚至带一点玩心\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"快乐的余温尚在，心头却已泛起一阵怀念\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"见对方依然愿意\",\n          \"point\": \"大大方方地回应\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"依然愿意和自己亲近\"\n        },\n        {\n          \"text\": \"两人相处得这么好\",\n          \"point\": \"心里就没底\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可一想到以后\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"强烈的渴望还在，却引而不发，那股绷紧的劲尚未真正松开\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"四周并未彻底暗下去，更像阳光被薄雾柔化——光还在，只是隔了一层朦胧的雾气\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"意识到眼前的美好其实比自己的愿望大得多\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他一想到对方\",\n          \"point\": \"不再需要他陪伴\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"有一天；就害怕\"\n        },\n        {\n          \"text\": \"他一下安静下来\",\n          \"point\": \"连往后都不敢再想