       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他也想顺势靠近，却怕太急弄坏眼下的自在，还是把热切收了回来",
       "keys": [
        "还是把热切收了回来"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这样的好总会过去，他还没分开，就先尝到舍不得",
       "keys": [
        "先尝到舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "人在船上舒服地漂着不急着靠岸，水和时间却一直在走",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像扎了根温柔的刺，眼前的好还在却已经有点鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他第一次发现，安静相处的满足并不比说出喜欢少",
