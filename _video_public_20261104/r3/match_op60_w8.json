{
 "blocks": [
  {
   "id": "S01-0-0",
   "a": "偏了",
   "b": "偏了",
   "lost": "甲把声音突然迸发理解成意外变化，乙理解成喜欢突然产生；原稿说的是声音如烟花骤然向上迸发。"
  },
  {
   "id": "S01-0-1",
   "a": "偏了",
   "b": "对上",
   "lost": "甲把身体失重转成靠近某人时的心理不安；原稿是踏上船板、身体瞬间失重的感受。"
  },
  {
   "id": "S01-1-0",
   "a": "偏了",
   "b": "偏了",
   "lost": "原稿重点是准备说出想了很久的事，以及开口前的沉默；两人都额外推断了害怕改变关系。"
  },
  {
   "id": "S01-1-1",
   "a": "对上",
   "b": "偏了",
   "lost": "乙把害怕关系改变理解成话说出口无法收回，遗漏了关系会因此发生变化这一层。"
  },
  {
   "id": "S02-0-0",
   "a": "对上",
   "b": "对上",
   "lost": ""
  },
  {
   "id": "S02-0-1",
