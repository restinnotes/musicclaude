        "被接纳的感觉"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可那份亲近未必还在，旧日委屈却确实发生过，怀念不足以让他安心回去",
       "keys": [
        "怀念不足以让他安心回去"
       ],
       "from": [
        "S10-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "反复盘算耗尽了他，他也看见自己因此连眼下都过不踏实",
       "keys": [
        "连眼下都过不踏实"
       ],
       "from": [
        "S10-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像忽然失重悬在半空，辨不清方向也没了着落",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "心里又浮出那个问题：那么，我究竟要怎么继续过下去？",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      },
      {
       "text": "像疲倦的人回想往事，明知它很重要，却没力气再讲一遍了",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他把盼望从回到旧日，慢慢转向未来还会有亲近",
       "keys": [
        "转向未来还会有亲近"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他不愿只凭这点盼望，就再过从前那种忍让日子",
       "keys": [],
       "from": [
        "S11-2"
       ],
       "bead": "S11-2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他决定先把眼前日子过稳，不再急着从旧关系里找答案",
