                                    </script></variant-radios><div class="product-single__quantity mt-35 mb-45"><span class="product-single__control-label">数量：</span><div class="product-form__item product-form__item--quantity d-flex align-items-center mb-10"><div class="quick_view_qty"><a href="javascript:void(0);" class="quick_view-qty quick_view-qty-minus">-</a><input type="number" id="Quantity" name="quantity" value="1" min="1" max="100" step="1" class="quantity-selector product-form__input" pattern="[0-9]*"><a href="javascript:void(0);" class="quick_view-qty quick_view-qty-plus">+</a></div><div class="product-form__item product-form__item--submit"><button data-handle="minisforum-ai-x1-pro" type="submit" name="add" id="AddToCart" class="btnAddToCart btn product-form__cart-submit"><span id="AddToCartText">添加至购物袋</span><span class="load"></span></button></div></div></div></form></div></div></div></div><div class="product-single__tab mt-60"><div class="container"><ul class="nav nav-tabs"></ul><div class="tab-content"></div></div></div><style>
                        .Tabox {
                            display: flex;
                            width: 100%;
                        }
                        .addtocart_box {
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                        }
                        .addtocart_box .product_name {
                            font-size: 2.3rem;
                            margin: 0;
                            color: #000;
                        }
                        .Tabox_link {
                            width: 20%;
                            cursor: pointer;
                            padding: 20px 10px;
                            color: #000;
                            font-size: 16px;
                            text-transform: capitalize;
                            display: block;
                            text-align: center;
                            transition: all 0.3s ease-in-out;
                            border-left: 1px solid #dadada;
                        }
                        .Tabox_link:hover {
                            color: #fff;
                            text-decoration: none;
                            background: var(--theme-color-default);
                        }
                        .Tabox_link.active {
                            color: #fff;
                            font-weight: bold;
                            text-decoration: none;
                            background: var(--theme-color-default);
                        }

                        .Tabox_box {
                            margin-top: 60px;
                        }
                        .add-to-cart-button {
                            border-top: 1px solid #dadada;
                            border-bottom: 1px solid #dadada;
                        }

                        .Tabox_fixed {
                            position: fixed;
                            top: 0;
                            left: 0;
                            width: 100%;
                            background-color: #fff;
                            z-index: 1000;
                            padding: 15px 0;
                            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
                            transition: transform 0.3s ease
                            , opacity 0.3s ease;
                        }
                        @media(max-width: 768px) {
                            .addtocart_box {
                                flex-flow: column;
                            }
                            .Tabox_link {
                                width: 50%;
                            }
                        }
                    </style><!--                    <div class="add-to-cart-button" id="addToCartButton">--><!--                        <div class="addtocart_box container">--><!--                            <div class="Tabox">--><!--                                <div class="Tabox_link active" data-target="#概述">--><!--                                    概述--><!--                                </div>--><!--                                <div class="Tabox_link" data-target="#规格">规格</div>--><!--                                <div class="Tabox_link" data-target="#兼容性">兼容性</div>--><!--                            </div>--><!--                        </div>--><!--                    </div>--><script>
                        document.addEventListener("DOMContentLoaded", () => {
                            const Tabox = document.querySelectorAll(".Tabox_link");
                            const Tabox_box = document.querySelectorAll(".Tabox_box_link");

                            // 点击 Tab 滚动到对应的盒子
                            Tabox.forEach(Tabox_link => {
                                Tabox_link.addEventListener("click", () => {
                                    const targetId = Tabox_link.getAttribute("data-target");
                                    const targetBox = document.querySelector(targetId);
                                    targetBox.scrollIntoView({ behavior: "smooth" });
                                });
                            });

                            // 监听滚动事件，切换 Tab 的激活样式
                            window.addEventListener("scroll", () => {
                                let current = "";

                                Tabox_box.forEach(Tabox_box_link => {
                                    const boxTop = Tabox_box_link.offsetTop;
                                    const boxHeight = Tabox_box_link.offsetHeight;
                                    if (window.scrollY >= boxTop - boxHeight / 2) {
                                        current = `#${Tabox_box_link.id}`;
                                    }
                                });

                                Tabox.forEach(Tabox_link => {
                                    Tabox_link.classList.remove("active");
                                    if (Tabox_link.getAttribute("data-target") === current) {
                                        Tabox_link.classList.add("active");
                                    }
                                });
                            });
                        });
                        document.addEventListener('DOMContentLoaded', function () {
                            const productTemplateContainer = document.querySelector('.product-template__container');
                            const addToCartButton = document.querySelector('#addToCartButton');

                            if (productTemplateContainer && addToCartButton) {
                                const observer = new IntersectionObserver(
                                    function (entries) {
                                        entries.forEach(entry => {
                                            if (!entry.isIntersecting) {
                                                addToCartButton.classList.add('Tabox_fixed');
                                            } else {
                                                addToCartButton.classList.remove('Tabox_fixed');
                                            }
                                        });
                                    },
                                    {
                                        root: null, // 视口为根元素
                                        threshold: 0, // 触发回调的阈值
                                    }
                                );

                                // 监听元素是否离开视口
                                observer.observe(productTemplateContainer);

                                // 监听滚动事件，判断是否到达顶部
                                window.addEventListener('scroll', () => {
                                    if (window.scrollY === 0) {
                                        addToCartButton.classList.remove('Tabox_fixed');
                                    }
                                });
                            }
                        });
                    </script></div></div></div><div id="Shopask" class="modal fade"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header mt-sm-40" data-dismiss="modal"><i class="zmdi zmdi-close"></i></div><div class="modal-body"><div class="Shopask-title font-800 text-uppercase text-center c_h mb-5">问一个问题</div><div class="text-center mb-30">请输入您的请求的详细信息。我们的支持人员将尽快回复。</div><form method="post" action="/zh-hans/contact#product-single__contact" id="product-single__contact" accept-charset="UTF-8" class="contact-form"><input type="hidden" name="form_type" value="contact"><input type="hidden" name="utf8" value="✓"><input type="hidden" name="contact[product]" value="UM870 Plus"><input type="hidden" name="contact[product url]" value="/index/product.html?id=60"><div class="form-group mb-10"><input type="text" name="contact[name]" value="" class="mb-0 " placeholder="你的名字" required></div><div class="form-group mb-10"><input type="email" name="contact[email]" value="" class="mb-0 " placeholder="你的邮件" required></div><div class="form-group mb-10"><input type="tel" name="contact[phone]" pattern="[0-9\-]*" value="" class="mb-0 " placeholder="电话号码"></div><div class="form-group mb-20"><textarea rows="12" cols="50" class="mb-0" name="contact[body]" placeholder="您的留言"></textarea></div><button class="btn btn_submit btn-2 text-center w-100" type="submit"><span>立即提交</span></button></form></div></div></div></div><script src="/index/static/js/jquery.tmpl.min.js" type="text/javascript"></script><script src="/index/static/js/jquery.products.min.js" type="text/javascript"></script><script>
            Shopify.Products.recordRecentlyViewed();
        </script><script type="module">
            import Lightbox from '/index/static/photoswipe-lightbox.esm.min.js';
            const leftArrowSVGString = '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 11 21"><polyline fill="none" stroke="currentColor"  points="10.5 0.5 0.5 10.5 10.5 20.5" stroke-width="1.25"></polyline></svg>';
            const rightArrowSVGString = '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 11 21"><polyline fill="none" stroke="currentColor" points="0.5 0.5 10.5 10.5 0.5 20.5" stroke-width="1.25"></polyline></svg>';
            const closeArrowSVGString = '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 16 14"><path d="M15 0L1 14m14 0L1 0" stroke="currentColor" fill="none" fill-rule="evenodd"></path></svg>'
            const lightbox = new Lightbox({
                gallery: '#proFeaturedImageZoom',
                children: '.item_img',
                bgOpacity: 1,
                showHideAnimationType: 'zoom',
                loop: false,
                counter: false,
                zoom: false,
                bgClickAction: false,
                arrowPrevSVG: leftArrowSVGString,
                arrowNextSVG: rightArrowSVGString,
                closeSVG: closeArrowSVGString,
                pswpModule: () => import('//cdn.shopify.com/s/files/1/0900/3319/3266/t/7/assets/photoswipe.esm.min.js?v=152856952341679890991732289543')
            });
            lightbox.on('uiRegister', function() {
                lightbox.pswp.ui.registerElement({
                    name: 'bulletsIndicator',
                    className: 'pswp__bullets-navigation',
                    appendTo: 'wrapper',
                    onInit: (el, pswp) => {
                        let prev;
                        let close;
                        let next;
                        prev = document.createElement('div');
                        prev.className = 'pswp__bullets-prev';
                        close = document.createElement('div');
                        close.className = 'pswp__bullets-close';
                        next = document.createElement('next');
                        next.className = 'pswp__bullets-next';

                    }
                });
            });
            lightbox.init();
        </script><script>
            jQuery('variant-radios :radio, variant-selects select').change(function() {
                var optionIndex = jQuery(this).closest('.swatch').attr('data-option-index');
                var optionValue = jQuery(this).val();
                jQuery(this).parents('fieldset, .product-form__input').find('.variant_current').text(optionValue);
                // Style image grid
                if ($(window).width() > 991 ) {
                    if ($('.product-template__imggrid').length > 0 || $('.product-template__scroll').length > 0) {
                        setTimeout(function() {
                            var parent = $('.product-template__imggrid .proFeaturedImage, .product-template__scroll .proFeaturedImage'),
                                active = parent.find('.act'),
                                offset = active.offset().top;
                            $("body,html").animate({scrollTop: offset}, "normal");
                        }, 200);
                    }
                }
            });
        </script><style data-shopify>
            .template-product .style-product-detail img {
                max-width: 41px;
                max-height: 34px;
            }
            .template-product .style-product-detail.bg-icon .policy-icon {
                width: 85px;
                min-width: 85px;
                height: 85px;
                border-radius: 100%;
                background-color: #e9ebeb;
            }
            .template-product .proFeaturedImage,
            .template-product .product-template__scroll .proFeaturedImage .item,
            .template-product .product-template__imggrid .proFeaturedImage .item-block,
            .template-product .product-template__sliderimg .proFeaturedImage .item-block,
            .template-product .product-template__sliderimgtwo .proFeaturedImage .item-block {
