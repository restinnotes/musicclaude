{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"落下来以后，却还没有真正落稳，仿佛仍悬在水面上方\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"水面上方仍悬着\"\n        },\n        {\n          \"quote\": \"身体有一瞬失重\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"正因太清楚\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然想靠近\",\n          \"point\": \"又怕对方觉得负担太重\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又怕\"\n        },\n        {\n          \"text\": \"这点亲近虽甜\",\n          \"point\": \"不敢把喜欢说透\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"虽甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"体温也仿佛融在了一处\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"水却一直在流，时间也一直在走\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"却仍在流\"\n        },\n        {\n          \"quote\": \"因为太喜欢眼前的东西，所以还没有失去，就已经生出一丝舍不得\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"因为太喜欢\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"慢慢放松下来\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方没有退开\"\n        },\n        {\n          \"text\": \"他想再靠近\",\n          \"point\": \"舍不得这一刻\