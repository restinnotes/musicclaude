        //「支持各大浏览器安装使用」的下载按钮：
        //  能访问外网 -> 走 href 直接跳应用商店
        //  不能访问   -> 弹手动安装弹窗，默认展开方法二，并选中这个浏览器的教程
        //  edge 和 360 系列的商店国内可直连，不做判断，一律跳商店
        var STORE_ONLY = ['edge', '360', '360_safe', '360_ai'];

        //Edge / 360 三兄弟 / 紫鸟 / 傲游 / Whale 走的是第三方扩展商店，商店侧看不到安装数，
        //点击量只能在本站统计，所以每个浏览器按钮点一次就补发一条同样的自定义事件
        function trackStoreClick($btn) {
            if (typeof window.gtag !== 'function') return;
            window.gtag('event', 'extension_store_click', {
                browser: $btn.attr('data-browser-key') || '',
                store: $btn.attr('data-store') || '',
                placement: 'homepage_browser_support',
                link_url: $btn.attr('href') || ''
            });
        }

        $('.new-browser-list .browser-btn').on('click', function (e) {
            var key = $(this).attr('data-browser-key') || '';
            trackStoreClick($(this));

            if (STORE_ONLY.indexOf(key) !== -1) return;

            //结论一般在进页面时就算好了，已知能访问外网就别拦，让 <a target="_blank"> 自己跳，
            //绕开 Promise 里 window.open 被浏览器当成非用户操作拦截的问题
            if (window.apNet.foreignAccess === true) return;

            //剩下的是「已知上不了外网」和「还没算出来」两种：前者立刻弹窗，
            //后者要现场探测（最慢 2 秒），checkWithLoading 只在后一种情况盖 loading
            e.preventDefault();
            var href = $(this).attr('href');
            window.apNet.checkWithLoading().then(function (canAccess) {
                if (canAccess) {
                    window.open(href, '_blank');
                } else {
                    window.apOpenInstallManual('manual', key);
                }
            });
        });
    });
</script></div></div></div></section><!--支持的浏览器  END--><!--图搜功能支持的平台--><section class="section mt-3"><div class="section-container"><div class="white-bg round"><div class="index-module-header"><h3 class="title">Platforms Supported by Image Search</h3></div><div class="index-module-body"><ul class="support-logo-list"><li class="support-logo-item"><a class="support-logo-link d-flex align-items-center gap-2 btn-install-offline-tmp" title="1688"><img loading="lazy" decoding="async" class="support-logo-img" src="https://cn01.aiprice.com/static/index/img/website-logo/1688.png" alt="1688"></a></li><li class="support-logo-item"><a class="support-logo-link d-flex align-items-center gap-2 btn-install-offline-tmp" title="Taobao"><img loading="lazy" decoding="async" class="support-logo-img" src="https://cn01.aiprice.com/static/index/img/website-logo/taobao.png" alt="Taobao"></a></li><li class="support-logo-item"><a class="support-logo-link d-flex align-items-center gap-2 btn-install-offline-tmp" title="Alibaba"><img loading="lazy" decoding="async" class="support-logo-img" src="https://cn01.aiprice.com/static/index/img/website-logo/alibaba.png" alt="Alibaba"></a></li><li class="support-logo-item"><a class="support-logo-link d-flex align-items-center gap-2 btn-install-offline-tmp" title="AliExpress"><img loading="lazy" decoding="async" class="support-logo-img" src="https://cn01.aiprice.com/static/index/img/website-logo/aliexpress.png" alt="AliExpress"></a></li><li class="support-logo-item"><a class="support-logo-link d-flex align-items-center gap-2 btn-install-offline-tmp" title="Amazon"><img loading="lazy" decoding="async" class="support-logo-img" src="https://cn01.aiprice.com/static/index/img/website-logo/Amazon.png" alt="Amazon"></a></li><li class="support-logo-item"><a class="support-logo-link d-flex align-items-center gap-2 btn-install-offline-tmp" title="SHEIN"><img loading="lazy" decoding="async" class="support-logo-img" src="https://cn01.aiprice.com/static/index/img/websi