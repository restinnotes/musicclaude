"waste\": \"\",\n          \"keep\": \"明知再想也改不了什么，念头还是绕回来\"\n        },\n        {\n          \"text\": \"他很想确认那段经历\",\n          \"point\": \"把它一点点想得更柔软、更美好\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"反复回想\"\n        },\n        {\n          \"text\": \"可同一个无解的问题\",\n          \"point\": \"同一个无解的问题又绕回来\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"他明知没有答案仍放不下\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"躲进更模糊、更安全的精神空间，只希望暂时待在一个没有痛苦的地方。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"暂时躲进一个更安全、没有痛苦的地方\"\n        },\n        {\n          \"quote\": \"熟悉的地方，却发现它已经不属于你了。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一刻的愉悦可以是真的，甚至有些陶醉，却没有把心里的阴影带走。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"愉悦是真的，但心里的阴影仍在\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想得太满时\",\n          \"point\": \"暂时有了些安全感\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"可这点轻松并不能证明失落已经过去\"\n        },\n        {\n          \"text\": \"随后那份难过又贴回心口\",\n          \"point\": \"重新找回那种珍贵的感觉\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对过去的留恋一下变得迫切\"\n        },\n        {\n          \"text\": \"心里像有两种意思轮番冒出来\",\n          \"point\": \"谁也说服不了另一边\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一边催自己继续过眼前的日子，一边又舍不得旧日的好\"\n        },\n        {\n          \"text\": \"他确实有一瞬觉得\",\n          \"point\": \"没有得到任何确定的把握\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"随即又把希望投向更长久的安稳\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"它们未必全然对立，却已经无法融成最初那种单一、平静的声音。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"并非全然对立，却再也拼不回平静\"\n        },\n        {\n          \"quote\": \"像眼泪渗进熟悉的句子。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"主动选择想什么、不想什么的余地变小\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"想不想，已经有些由不得自己\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他心里同时挤着好几种念头\",\n          \"point\": \"始终拼不成一个答案\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想留住那些好时候，又觉得不能总困在里面\"\n        },\n        {\n          \"text\": \"过去的难过不再只是\",\n          \"point\": \"重新变得贴身\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"连心里最细的地方都被牵动\"\n        },\n        {\n          \"text\": \"他想主动把念头理清\",\n          \"point\": \"很难决定何时想、何时停\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"旧事却一遍遍自己涌上来\"\n        },\n        {\n          \"text\": \"那些没处理好的感受\",\n          \"point\": \"仍不知道从哪里着手\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"好让眼前的日子安稳些\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"音乐似乎越来越忙碌，内心却未必真正走出了原地。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这不是彻底的解脱，只是短暂的松动。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是解脱，只是短暂松动\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想把心里的结\",\n          \"point\": \"连该先弄清什么都说不准\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"像被一股说不清的压力推着\"\n        },\n        {\n          \"text\": \"刚冒出的那股决心\",\n          \"point\": \"找不到一个真正能继续的方向\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"他发现自己没有答案\"\n        },\n        {\n          \"text\": \"一阵疲倦漫上来\",\n          \"point\": \"连刚才要追问的事都顾不上了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"他被这阵疲倦填满\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"这里的幸福不是兴奋，而是终于能安静呼吸\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是兴奋，是终于能安静呼吸\"\n        },\n        {\n          \"quote\": \"悲伤没有消失，只是暂时没有占满整个内心。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它不只是眼下舒服，而是让人看见自己真正希望拥有的生活是什么样子。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"过了一阵，他心里重新有了\",\n          \"point\": \"没再占满全部心思\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"旧日的痛苦退到后面\"\n        },\n        {\n          \"text\": \"这点安稳太珍贵\",\n          \"point\": \"挂念它能不能留下\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"仍有一丝不踏实\"\n        },\n        {\n          \"text\": \"他向往一种安全、温暖\",\n          \"point\": \"有归属感的生活\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"不必反复解释自己的感受\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"越是想抓住刚才那种美好的感受，越发现它并不是自己能够控制的东西\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越想抓住，越发现它