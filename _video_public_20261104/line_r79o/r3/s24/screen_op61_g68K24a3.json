{
 "uniform": true,
 "sections": [
  {
   "sec": "S01",
   "rows": [
    {
     "kind": "line",
     "text": "他总算离开熟悉的生活",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S01-1"
     ]
    },
    {
