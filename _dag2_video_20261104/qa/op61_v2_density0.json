    {
      "sec": "S07",
      "body_font": 22,
      "bead_nodes": [
        "S07-B2",
        "S07-B3",
        "S07-B1",
        "S07-B4",
        "S07-B5"
      ],
      "bead_edges": [
        {
          "a": "S07-B1",
          "b": "S07-B2",
          "type": "重叠但新增",
          "note": "两者都围绕182附近的突然转向。B1抓住冰冷长颤音造成的梦境破裂与身体惊悸；B2指出舞蹈性材料如何切断祈祷般的静谧。它们互相补充，但不是同一感受的重复表达。"
        },
        {
          "a": "S07-B2",
          "b": "S07-B3",
          "type": "段内先后",
          "note": "B2聚焦182–197的舞蹈性转向，B3聚焦198–205颤音带来的进一步紧张累积。这是本段实际的音乐进程，不能把两者合并成一次笼统的情绪变化。"
        },
        {
          "a": "S07-B2",
          "b": "S07-B5",
          "type": "另一种理解",
          "note": "B2依据多份原稿，将这一转向听成带马祖卡色彩的新舞蹈场景；B4依据另一组原稿，将其听成波兰舞曲相关材料的再现。两种材料辨认应明确区分，不构成无争议的主题回归。"
        },
        {
          "a": "S07-B2",
          "b": "S07-B4",
          "type": "重叠但新增",
          "note": "B5并不是另一个音乐事件，而是同一转向引发的生活化联想。它新增的是熟悉动作、舞蹈和日常生活的具体质地，以及亲切感可能带来的失去感。"
        },
        {
          "a": "S07-B5",
          "b": "S07-B4",
          "type": "可同时成立",
          "note": "B4讨论舞蹈性材料究竟应如何辨认，B5讨论这种突然转向可能唤起怎样的日常联想。两者处于不同层次，可以并存，不必拼成一个人物的连续经历。"
        },
        {
          "a": "S07-B5",
          "b": "S07-B3",
          "type": "段内先后",
          "note": "B4指向182–197的材料，实际早于B3的198–205。B4在正文中排于B3之后，只是为了先交代实际音乐进程，再说明另一种材料理解，并不意味着它发生得更晚。"
        }
      ],
      "story_nodes": [
