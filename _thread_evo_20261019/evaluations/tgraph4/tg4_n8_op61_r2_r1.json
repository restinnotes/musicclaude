    {
     "from": "I58",
     "to": "I73",
     "rel": "提供理由"
    },
    {
     "from": "I55",
     "to": "I74",
     "rel": "改写"
    }
   ]
  },
  {
   "bars": "181–205",
   "relation": "正在面对",
   "items": [
    {
     "id": "I82",
     "text": "他渐渐不满足于只在心里拥有那份安宁。",
     "key": "只在心里拥有",
     "kind": "满足照出未满足"
    },
    {
     "id": "I83",
     "text": "他想到一些事正使那种生活难以存在。",
     "key": "难以存在",
     "kind": ""
    },
    {
     "id": "I84",
     "text": "他知道怀念无法改变那些事。",
     "key": "怀念无法改变",
     "kind": "办法的限度"
    },
    {
     "id": "I85",
     "text": "他又不甘心只顾留恋。",
     "key": "只顾留恋",
     "kind": ""
    },
    {
     "id": "I86",
     "text": "他几乎责怪自己刚才忘了仍须面对的事。",
     "key": "几乎责怪",
     "kind": ""
    },
    {
     "id": "I87",
     "text": "他试着催自己重新振作。",
     "key": "重新振作",
     "kind": ""
    },
    {
     "id": "I88",
     "text": "他这一次无法再毫无顾忌地投入。",
     "key": "毫无顾忌",
     "kind": ""
    },
    {
     "id": "I89",
     "text": "他怕重新争取会一点点耗尽温柔。",
     "key": "耗尽温柔",
     "kind": ""
    },
    {
     "id": "I90",
     "text": "他怕自己最终只剩不肯退让的意志。",
     "key": "退让的意志",
     "kind": ""
    },
    {
     "id": "I91",
     "text": "他怕失去原本让一切值得争取的心。",
     "key": "值得争取的心",
     "kind": ""
    },
    {
     "id": "I92",
     "text": "他舍不得刚得的安宁。",
     "key": "刚得的安宁",
     "kind": ""
    },
    {
     "id": "I93",
     "text": "他又放不下威胁着那种生活的事。",
     "key": "威胁着",
     "kind": ""
    },
    {
     "id": "I94",
     "text": "他发现理由更多了，心里反而更为难。",
     "key": "理由更多",
     "kind": "知道更多反而更尖锐"
    }
   ],
   "because": [
    {
