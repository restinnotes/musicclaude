", \"bead\": \"S10-B2\", \"bars\": \"\"},\n            {\"text\": \"清风吹进来\", \"bead\": \"S10-B2\", \"bars\": \"\"},\n            {\"text\": \"时间松了\", \"bead\": \"S10-B2\", \"bars\": \"\"},\n            {\"text\": \"旋律空出一小块\", \"bead\": \"S10-B2\", \"bars\": \"\"},\n            {\"text\": \"暂时不用往前赶\", \"bead\": \"S10-B2\", \"bars\": \"\"},\n            {\"text\": \"不是长久的避风处\", \"bead\": \"S10-B2\", \"bars\": \"\"}\n          ]\n        },\n        {\n          \"kind\": \"line\",\n          \"text\": \"紧绷慢慢松开，心里亮堂得想笑，也有点想哭。\",\n          \"keys\": [\"慢慢松开\", \"想笑\", \"想哭\"],\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"]\n        },\n        {\n          \"kind\": \"feel\",\n          \"items\": [\n            {\"text\": \"身体失去重量\", \"bead\": \"S10-B3\", \"bars\": \"\"},\n            {\"text\": \"灵魂飘出躯壳\", \"bead\": \"S10-B3\", \"bars\": \"\"},\n            {\"text\": \"悬在夏夜微风里\", \"bead\": \"S10-B3\", \"bars\": \"\"},\n            {\"text\": \"肉身沉重碰不到\", \"bead\": \"S10-B3\", \"bars\": \"\"}\n          ]\n        },\n        {\n          \"kind\": \"feel\",\n          \"items\": [\n            {\"text\": \"极细的小音符\", \"bead\": \"S10-B4\", \"bars\": \"\"},\n            {\"text\": \"亮得像银丝\", \"bead\": \"S10-B4\", \"bars\": \"\"},\n            {\"text\": \"晨曦里的蛛丝\", \"bead\": \"S10-B4\", \"bars\": \"\"},\n            {\"text\": \"像细雨飘落\", \"bead\": \"S10-B4\", \"bars\": \"\"},\n            {\"text\": \"几乎没有重量\", \"bead\": \"S10-B4\", \"bars\": \"\"},\n            {\"text\": \"高处倾泻的琶音\", \"bead\": \"S10-B4\", \"bars\": \"80–83\"},\n            {\"text\": \"像一道飞瀑\", \"bead\": \"S10-B4\", \"bars\": \"80–83\"},\n            {\"text\": \"清亮落进水里\", \"bead\": \"S10-B4\", \"bars\": \"80–83\"}\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"rows\": [\n        {\n          \"kind\": \"line\",\n          \"text\": \"他想，就算对方以后不需要陪伴，自己仍愿留下。\",\n          \"keys\": [\"不需要陪伴\", \"仍愿留下\"],\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\"]\n        },\n        {\n          \"kind\": \"feel\",\n          \"items\": [\n            {\"text\": \"梦里漂着的感觉退去\", \"bead\": \"S11-B1\", \"bars\": \"\"},\n            {\"text\": \"忽然变得很真实\", \"bead\": \"S11-B1\", \"bars\": \"\"},\n            {\"text\": \"还是那艘船\", \"bead\": \"S11-B1\", \"bars\": \"\"},\n            {\"text\": \"还是那首歌\", \"bead\": \"S11-B1\", \"bars\": \"\"},\n            {\"text\": \"开头那份谨慎不见了\", \"bead\": \"S11-B1\", \"bars\": \"\"},\n            {\"text\": \"厚重和弦托起歌声\", \"bead\": \"S11-B1\", \"bars\": \"\"},\n            {\"text\": \"温柔水波变成巨浪\", \"bead\": \"S11-B1\", \"bars\": \"\"},\n            {\"text\": \"横跨几个八度\", \"bead\": \"S11-B1\", \"bars\": \"\"},\n            {\"text\": \"心里话终于出口\", \"bead\": \"S11-B1\", \"bars\": \"\"},\n            {\"text\": \"这是我的感情\", \"bead\": \"S11-B1\", \"bars\": \"\"},\n            {\"text\": \"不再为它道歉\", \"bead\": \"S11-B1\", \"bars\": \"\"}\n          ]\n        },\n        {\n          \"kind\": \"line\",\n          \"text\": \"这份喜欢不必再藏，他高兴得顾不上害臊。\",\n          \"keys\": [\"不必再藏\", \"顾不上害臊\"],\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S11-2\"]\n        },\n        {\n          \"kind\": \"feel\",\n          \"items\": [\n            {\"text\": \"多年后走回旧房子\", \"bead\": \"S11-B2\", \"bars\": \"\"},\n            {\"text\": \"家具好像没变\", \"bead\": \"S11-B2\", \"bars\": \"\"},\n            {\"text\": \"知道的事却多了\", \"bead\": \"S11-B2\", \"bars\": \"\"},\n            {\"text\": \"熟悉的温柔回来\", \"bead\": \"S11-B2\", \"bars\": \"\"},\n            {\"text\": \"这次有了新重量\", \"bead\": \"S11-B2\", \"bars\": \"\"},\n            {\"text\": \"越知道珍贵\", \"bead\": \"S11-B2\", \"bars\": \"\"},\n            {\"text\": \"心里越容易发疼\", \"bead\": \"S11-B2\", \"bars\": \"\"}\n          ]\n        },\n        {\n          \"kind\": \"feel\",\n          \"items\": [\n            {\"text\": \"灿烂得有点难受\", \"bead\": \"S11-B4\", \"bars\": \"\"},\n            {\"text\": \"夕阳沉下前\", \"bead\": \"S11-B4\", \"bars\": \"\"}