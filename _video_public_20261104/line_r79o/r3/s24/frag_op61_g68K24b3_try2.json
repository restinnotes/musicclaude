{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他终于离开熟悉生活",
     "accent": "终于离开",
     "emotion": "安心",
     "from": [
      "S01-1"
     ]
    },
    {
     "text": "起初他觉得不用再委屈自己",
     "accent": "不用再委屈自己",
     "emotion": "安心",
     "from": [
      "S01-1"
     ]
    },
    {
     "text": "可这份笃定很快就散了",
     "accent": "很快就散了",
     "emotion": "不安",
     "from": [
      "S01-2",
      "S01-B2"
     ]
    },
    {
     "text": "心里空落落的说不清舍不得什么",
     "accent": "空落落的",
     "emotion": "孤单",
     "from": [
      "S01-2",
      "S01-B3"
     ]
    },
    {
     "text": "他想往前过却不知靠什么安心",
     "accent": "不知靠什么安心",
     "emotion": "悬着",
     "from": [
      "S01-3"
     ]
    }
   ],
   "small": [
    {
     "text": "他逼自己挺直背脊，心里却想停下",
     "after": 2,
     "from": [
      "S01-B2"
     ],
     "bars": "1–23"
    },
    {
     "text": "分不清是愤怒、遗憾还是怀念",
     "after": 3,
     "from": [
      "S01-B3"
     ],
     "bars": "1–23"
    },
    {
     "text": "像刚醒来，四周冷空，还不知身在何处",
     "after": 3,
     "from": [
      "S01-B4"
     ],
     "bars": "1–23"
    },
    {
     "text": "胸口发紧，视线模糊，颤手摸到虚空",
     "after": 3,
     "from": [
      "S01-B4"
     ],
     "bars": "1–23"
    },
    {
     "text": "旧日声音光线回来，过去却不再是现在",
     "after": 4,
     "from": [
      "S01-B5"
     ],
     "bars": "9–17"
    },
    {
     "text": "身体先于意识记起如何迈步",
     "after": 4,
     "from": [
      "S01-B5"
     ],
     "bars": "18–23"
    }
   ],
   "notes": [
    {
     "text": "重和弦像召唤，向上音符如烟散去",
     "from": [
      "S01-B1"
     ],
     "bars": "1–6"
    },
    {
     "text": "停顿里仿佛还在等着回声",
     "from": [
      "S01-B1"
     ],
     "bars": "1–6"
    },
    {
     "text": "短句刚冒出来就被长停顿截断，余音散在冷空气里",
     "from": [
      "S01-B3"
     ],
     "bars": "1–23"
    },
    {
     "text": "旋律轮廓稍清，像旧场景忽然回来",
     "from": [
      "S01-B5"
     ],
     "bars": "9–17"
    },
    {
     "text": "波兰舞曲步态渐渐浮现，主题尚未站稳",
     "from": [
      "S01-B5"
     ],
     "bars": "18–23"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "他舍不得从前的自在",
     "accent": "舍不得",
     "emotion": "亲密",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "想到以后不能那样过就慌",
     "accent": "就慌",
     "emotion": "不安",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "他赶紧提醒自己受过的气",
     "accent": "受过的气",
     "emotion": "不安",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "怕一心软就忘了为何离开",
     "accent": "忘了为何离开",
     "emotion": "悬着",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "好日子也得一起丢掉吗？",
     "accent": "好日子也得一起丢掉吗",
     "emotion": "不安",
     "from": [
      "S02-3",
      "S02-B5"
     ]
    }
   ],
   "small": [
    {
     "text": "舞步像说给众人听，歌声只唱给自己",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "24–65"
    },
    {
     "text": "珍惜的东西还在，却不能再拥有",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "24–65"
    },
    {
     "text": "像腿脚发虚的人，在记忆里挪步",
     "after": 1,
     "from": [
      "S02-B2"
     ],
     "bars": "24–65"
    },
    {
     "text": "起初还信，后来反复说给自己听",
     "after": 3,
     "from": [
      "S02-B4"
     ],
     "bars": "24–65"
    },
    {
     "text": "说到第三遍，才看出他很在意",
     "after": 3,
     "from": [
      "S02-B4"
     ],
     "bars": "24–65"
    },
    {
     "text": "我不甘心就这样消亡",
     "after": 4,
     "from": [
      "S02-B5"
     ],
     "bars": "44–65"
    }
   ],
   "notes": [
    {
     "text": "波兰舞曲步态站稳，旋律却像远处旧歌",
     "from": [
      "S02-B1"
     ],
     "bars": "24–65"
    },
    {
     "text": "庄严步伐下，旋律仍显得脆弱凄婉",
     "from": [
      "S02-B2"
     ],
     "bars": "24–65"
    },
    {
     "text": "伴奏底下细碎的不安一直在游动",
     "from": [
      "S02-B2"
     ],
     "bars": "24–65"
    },
    {
     "text": "舞步端正挺拔，像整理衣服抬起头",
     "from": [
      "S02-B4"
     ],
     "bars": "24–65"
    },
    {
     "text": "先猛然往上推又退下，随后再聚拢力量",
     "from": [
      "S02-B3"
     ],
     "bars": "38–65"
    },
    {
     "text": "中段愈发焦灼，最后仍没安稳落地",
     "from": [
      "S02-B3"
     ],
     "bars": "52–65"
    },
    {
     "text": "连续的小音符，像把呼吸催得更急",
     "from": [
      "S02-B3"
     ],
     "bars": "56–65"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他心里还憋着一股气",
     "accent": "憋着一股气",
     "emotion": "炽热",
     "from": [
      "S03-1"
     ]
    },
    {
     "text": "想起被当自己人他开心了一会儿",
     "accent": "开心了一会儿",
     "emotion": "欢喜",
     "from": [
      "S03-1",
      "S03-B2"
     ]
    },
    {
     "text": "那点开心很快就酸了",
     "accent": "很快就酸了",
     "emotion": "孤单",
     "from": [
      "S03-2",
      "S03-B2"
     ]
    },
    {
     "text": "从前那样的日子回不去了",
     "accent": "回不去了",
     "emotion": "孤单",
     "from": [
      "S03-2"
     ]
    },
    {
     "text": "离开以后真的会更好吗？",
     "accent": "真的会更好吗",
     "emotion": "悬着",
     "from": [
      "S03-2",
      "S03-B5"
     ]
    }
   ],
   "small": [
    {
     "text": "故乡麦浪微风，也像从前亲近不设防",
     "after": 1,
     "from": [
      "S03-B2"
     ],
     "bars": "66–79、80–91"
    },
    {
     "text": "像暂时侧身离场，轻松是真的却没解答",
     "after": 2,
     "from": [
      "S03-B3"
     ],
     "bars": "66–91"
    },
    {
     "text": "我刚才真信了，还是只在努力相信？",
     "after": 4,
     "from": [
      "S03-B5"
     ],
     "bars": "66–91"
    }
   ],
   "notes": [
    {
     "text": "若突出这一击，会像重锤砸下",
     "from": [
      "S03-B1"
     ],
     "bars": "66–91"
    },
    {
     "text": "端正步态转成流动舞步，错开的重音让人心悬",
     "from": [
      "S03-B1"
     ],
     "bars": "66–91"
    },
    {
     "text": "前半段显得焦躁急切",
     "from": [
      "S03-B2"
     ],
     "bars": "66–79"
    },
    {
     "text": "后半段忽然柔和，带出田园般的轻盈",
     "from": [
      "S03-B2"
     ],
     "bars": "80–91"
    },
    {
     "text": "几条声音像低声絮语，彼此缠绕找不到出口",
     "from": [
      "S03-B4"
     ],
     "bars": "66–91"
    },
    {
     "text": "音乐重心像流沙，四处漂移抓不住",
     "from": [
      "S03-B4"
     ],
     "bars": "66–91"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "想起亲近日子他真盼着重来",
     "accent": "真盼着重来",
     "emotion": "亲密",
     "from": [
      "S04-1",
      "S04-B1"
     ]
    },
    {
     "text": "可那些委屈也跟着翻上来",
     "accent": "委屈也跟着翻上来",
     "emotion": "不安",
     "from": [
      "S04-2",
      "S04-B2"
     ]
    },
    {
     "text": "他开始怀疑当初走得对不对",
     "accent": "走得对不对",
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ]
    },
    {
     "text": "没走的话如今会怎样？",
     "accent": "会怎样",
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ]
    }
   ],
   "small": [
    {
     "text": "记忆里有感激、亲密和短暂幸福",
     "after": 0,
     "from": [
      "S04-B1"
     ],
     "bars": "92–107"
    },
    {
     "text": "那份坚定或许只是他想成为的样子",
     "after": 0,
     "from": [
      "S04-B1"
     ],
     "bars": "92–115"
    },
    {
     "text": "太好的记忆回不来，反倒更刺痛",
     "after": 1,
     "from": [
      "S04-B2"
     ],
     "bars": "108–115"
    },
    {
     "text": "像乱了拍的心跳，被时间催着跑",
     "after": 1,
     "from": [
      "S04-B3"
     ],
     "bars": "92–115"
    },
    {
     "text": "反复问如果当时，只为不让自己停下来",
     "after": 3,
     "from": [
      "S04-B4"
     ],
     "bars": "94–115"
    }
   ],
   "notes": [
    {
     "text": "熟悉主题回来，伴奏流动，旋律更抒情",
     "from": [
      "S04-B1"
     ],
     "bars": "92–107"
    },
    {
     "text": "温暖忽然转成风暴般的紧绷",
     "from": [
      "S04-B2"
     ],
     "bars": "108–115"
    },
    {
     "text": "下行的声音像撕扯着步步后退",
     "from": [
      "S04-B2"
     ],
     "bars": "108–115"
    },
    {
     "text": "细碎音符急促，低音一路追赶",
     "from": [
      "S04-B3"
     ],
     "bars": "92–115"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "他仍觉得那些气不该忍",
     "accent": "不该忍",
     "emotion": "炽热",
     "from": [
      "S05-1"
     ]
    },
    {
     "text": "可他连开心的旧事都不敢想",
     "accent": "都不敢想",
     "emotion": "不安",
     "from": [
      "S05-1"
     ]
    },
    {
     "text": "他跟自己争得没了力气",
     "accent": "没了力气",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    },
    {
     "text": "那股不服气渐渐淡了",
     "accent": "渐渐淡了",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    },
    {
     "text": "想到如今不在他们身边就难受",
     "accent": "不在他们身边",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    }
   ],
   "small": [
    {
     "text": "柔和歌唱里仍有股，不能就此算了的劲",
     "after": 0,
     "from": [
      "S05-B2"
     ],
     "bars": "116–127"
    },
    {
     "text": "可能是某个人、故乡或过去的生活",
     "after": 1,
     "from": [
      "S05-B3"
     ],
     "bars": "116–147"
    },
    {
     "text": "眷恋里还带着失落",
     "after": 1,
     "from": [
      "S05-B3"
     ],
     "bars": "116–147"
    },
    {
     "text": "紧绷最后像几次深呼吸，或一声叹息",
     "after": 3,
     "from": [
      "S05-B5"
     ],
     "bars": "144–147"
    },
    {
     "text": "那一下松动，更像抵抗得累了",
     "after": 4,
     "from": [
      "S05-B5"
     ],
     "bars": "约132–147"
    }
   ],
   "notes": [
    {
     "text": "歌唱转柔而克制，像两个影子夜里低声说话",
     "from": [
      "S05-B1"
     ],
     "bars": "116–147"
    },
    {
     "text": "流动渐渐变稀，最后化成稀疏的和弦",
     "from": [
      "S05-B4"
     ],
     "bars": "128–147"
    },
    {
     "text": "旋律几乎单独露出，像脚下地板忽然不见",
     "from": [
      "S05-B4"
     ],
     "bars": "128–147"
    },
    {
     "text": "躁动之后声音稀疏，像深深叹息",
     "from": [
      "S05-B5"
     ],
     "bars": "144–147"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "难受缓了他才肯想念从前",
     "accent": "才肯想念从前",
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "他如今才懂有人陪着多轻松",
     "accent": "有人陪着多轻松",
     "emotion": "亲密",
     "from": [
      "S06-2",
      "S06-B2"
     ]
    },
    {
     "text": "他想再有那样亲近的日子",
     "accent": "再有那样亲近",
     "emotion": "亲密",
     "from": [
      "S06-3"
     ]
    },
    {
     "text": "可他怕以后再也没有了",
     "accent": "再也没有了",
     "emotion": "悬着",
     "from": [
      "S06-3"
     ]
    },
    {
     "text": "想起真真切切拥有过心里暖了",
     "accent": "心里暖了",
     "emotion": "安心",
     "from": [
      "S06-4"
     ]
    }
   ],
   "small": [
    {
     "text": "像隔着透明玻璃，也像母亲轻哼摇篮曲",
     "after": 0,
     "from": [
      "S06-B1"
     ],
     "bars": "148–180"
    },
    {
     "text": "这份安宁不代表现实变好，也留不久",
     "after": 0,
     "from": [
      "S06-B1"
     ],
     "bars": "148–180"
    },
    {
     "text": "终于不用解释难过，也不用装坚强",
     "after": 1,
     "from": [
      "S06-B2"
     ],
     "bars": "148–180"
    },
    {
     "text": "愿望很真切，却不知远方会否回应",
     "after": 3,
     "from": [
      "S06-B2"
     ],
     "bars": "148–180"
    },
    {
     "text": "梦里远方忽然亮起，像看见已远去的家园",
     "after": 4,
     "from": [
      "S06-B2"
     ],
     "bars": "约160"
    },
    {
     "text": "明知挽不回，就轻轻看着它",
     "after": 4,
     "from": [
      "S06-B4"
     ],
     "bars": "148–180"
    }
   ],
   "notes": [
    {
     "text": "歌唱忽然变得绵长从容，近乎停驻",
     "from": [
      "S06-B1"
     ],
     "bars": "148–180"
    },
    {
     "text": "近似圣咏的庄严气息浮现",
     "from": [
      "S06-B2"
     ],
     "bars": "148–180"
    },
    {
     "text": "歌唱先含蓄试探，再逐渐展开，末尾像话没说完",
     "from": [
      "S06-B3"
     ],
     "bars": "148–180"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "以后难事还得自己一个人扛",
     "accent": "自己一个人扛",
     "emotion": "孤单",
     "from": [
      "S07-1"
     ]
    },
    {
     "text": "他真能撑得住吗？",
     "accent": "撑得住吗",
     "emotion": "不安",
     "from": [
      "S07-1",
      "S07-B3"
     ]
    },
    {
     "text": "早知道这么孤单还会走吗？",
     "accent": "还会走吗",
     "emotion": "悬着",
     "from": [
      "S07-2"
     ]
    },
    {
     "text": "他想找回亲近却不愿再受气",
     "accent": "不愿再受气",
     "emotion": "悬着",
     "from": [
      "S07-3"
     ]
    },
    {
     "text": "当初离开的决心也找不着了",
     "accent": "决心也找不着了",
     "emotion": "孤单",
     "from": [
      "S07-3"
     ]
    }
   ],
   "small": [
    {
     "text": "像寒风吹开窗，后颈一凉心跳加快",
     "after": 1,
     "from": [
      "S07-B1"
     ],
     "bars": "约182"
    },
    {
     "text": "思绪不停翻转，怎么也停不下来",
     "after": 2,
     "from": [
      "S07-B3"
     ],
     "bars": "198–205"
    },
    {
     "text": "心里有东西在颤，想冲出去却没出口",
     "after": 2,
     "from": [
      "S07-B3"
     ],
     "bars": "198–205"
    },
    {
     "text": "熟悉的动作、舞蹈和日常突然闯进来",
     "after": 3,
     "from": [
      "S07-B4"
     ],
     "bars": "181–205"
    },
    {
     "text": "那份亲切反而让失去更清楚",
     "after": 3,
     "from": [
      "S07-B4"
     ],
     "bars": "181–205"
    },
    {
     "text": "当初只想着别再受那些气",
     "after": 4,
     "from": [
      "S07-2"
     ],
     "bars": ""
    }
   ],
   "notes": [
    {
     "text": "高处忽然浮出一串轻细的长颤音",
     "from": [
      "S07-B1"
     ],
     "bars": "约182"
    },
    {
     "text": "另一种舞步突然闯入，截断前面的祈祷气息",
     "from": [
      "S07-B2"
     ],
     "bars": "182–197"
    },
    {
     "text": "早先那种庄严舞步又现，却不再完整鲜明",
     "from": [
      "S07-B5"
     ],
     "bars": "182–197"
    },
    {
     "text": "连续颤音让紧张一层层累积",
     "from": [
      "S07-B3"
     ],
     "bars": "198–205"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "他先把回去的事放一边",
     "accent": "放一边",
     "emotion": "悬着",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "想起被当自己人他心里又软了",
     "accent": "心里又软了",
     "emotion": "亲密",
     "from": [
      "S08-1",
      "S08-B1"
     ]
    },
    {
     "text": "那点暖意很快就淡了",
     "accent": "很快就淡了",
     "emotion": "孤单",
     "from": [
      "S08-2",
      "S08-B2"
     ]
    },
    {
     "text": "回忆帮不了未来他心又悬起来",
     "accent": "心又悬起来",
     "emotion": "悬着",
     "from": [
      "S08-2",
      "S08-B3"
     ]
    }
   ],
   "small": [
    {
     "text": "熟悉的柔软重新打开，回头一眼满是不舍",
     "after": 1,
     "from": [
      "S08-B1",
      "S08-B2"
     ],
     "bars": "206–213"
    },
    {
     "text": "胸口终于吸进一口气，却只是瞬间喘息",
     "after": 3,
     "from": [
      "S08-B3"
     ],
     "bars": "206–213"
    }
   ],
   "notes": [
    {
     "text": "缓慢宽广的歌唱短暂地重新回来",
     "from": [
      "S08-B1"
     ],
     "bars": "206–213"
    }
   ]
  },
  {
   "sec": "S09",
   "big": [
    {
     "text": "他忽然说不清想不想回去",
     "accent": "说不清",
     "emotion": "悬着",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "是舍不得亲近还是怕孤单",
     "accent": "还是怕孤单",
     "emotion": "悬着",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "怕自己连那些委屈也肯再受",
     "accent": "也肯再受",
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "这念头让他心慌得不敢再想",
     "accent": "不敢再想",
     "emotion": "不安",
     "from": [
      "S09-2",
      "S09-B2"
     ]
    }
   ],
   "small": [
    {
     "text": "像从另一面重新看见同一扇门",
     "after": 0,
     "from": [
      "S09-B1"
     ],
     "bars": "214–215"
    },
    {
     "text": "这一次，你已知道那个自己经历过什么",
     "after": 3,
     "from": [
      "S09-B2"
     ],
     "bars": "214–215"
    },
    {
     "text": "最初的问题又浮上来，仍没有答案",
     "after": 3,
     "from": [
      "S09-B2"
     ],
     "bars": "214–215"
    }
   ],
   "notes": [
    {
     "text": "巨大颤动声铺开，开头引子阴冷地闪回",
     "from": [
      "S09-B1"
     ],
     "bars": "214–215"
    },
    {
     "text": "声音短暂落稳，又向高处漂散",
     "from": [
      "S09-B1"
     ],
     "bars": "214–215"
    }
   ]
  },
  {
   "sec": "S10",
   "big": [
    {
     "text": "他最舍不得被当作自己人",
     "accent": "最舍不得",
     "emotion": "亲密",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "可回去还能像从前那样吗？",
     "accent": "还能像从前那样吗",
     "emotion": "悬着",
     "from": [
      "S10-1",
      "S10-B3"
     ]
    },
    {
     "text": "他不放心回去也想得很累",
     "accent": "想得很累",
     "emotion": "不安",
     "from": [
      "S10-2",
      "S10-3"
     ]
    },
    {
     "text": "眼下的日子也过得不踏实",
     "accent": "不踏实",
     "emotion": "悬着",
     "from": [
      "S10-3"
     ]
    }
   ],
   "small": [
    {
     "text": "当初那些委屈，也不能当没发生",
     "after": 2,
     "from": [
      "S10-2"
     ],
     "bars": ""
    },
    {
     "text": "像忽然失重，整个人悬在半空",
     "after": 2,
     "from": [
      "S10-B2"
     ],
     "bars": "221–225"
    },
    {
     "text": "走过许多后仍在问，究竟怎样继续？",
     "after": 3,
     "from": [
      "S10-B3"
     ],
     "bars": "216–225"
    },
    {
     "text": "明明知道往事重要，却没力气重讲",
     "after": 2,
     "from": [
      "S10-B4"
     ],
     "bars": "216–225"
    }
   ],
   "notes": [
    {
     "text": "熟悉歌声和舞步只剩断续的碎片",
     "from": [
      "S10-B1"
     ],
     "bars": "216–225"
    },
    {
     "text": "也像摇篮曲破碎地重新浮现",
     "from": [
      "S10-B1"
     ],
     "bars": "216–225"
    }
   ]
  },
  {
   "sec": "S11",
   "big": [
    {
     "text": "他还是忍不住想万一能呢？",
     "accent": "万一能呢",
     "emotion": "悬着",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "他不愿回去再过忍让的日子",
     "accent": "不愿再过忍让的日子",
     "emotion": "炽热",
     "from": [
      "S11-2"
     ]
    },
    {
     "text": "他想先把眼下日子过稳些",
     "accent": "过稳些",
     "emotion": "安心",
     "from": [
      "S11-3"
     ]
    },
    {
     "text": "他仍怕以后难事只能自己扛",
     "accent": "自己扛",
     "emotion": "不安",
     "from": [
      "S11-4"
     ]
    },
    {
     "text": "可这回他不想因害怕收回打算",
     "accent": "不想因害怕收回打算",
     "emotion": "炽热",
     "from": [
      "S11-4",
      "S11-B3"
     ]
    }
   ],
   "small": [
    {
     "text": "像困兽一次次顶住，害怕还在脚已往前",
     "after": 4,
     "from": [
      "S11-B1",
      "S11-B3"
     ],
     "bars": "226–241"
    },
    {
     "text": "前面的祈祷开始变成迈步的意志",
     "after": 4,
     "from": [
      "S11-B2"
     ],
     "bars": "226–241"
    }
   ],
   "notes": [
    {
     "text": "低音波涛涌起，重和弦一次次砸下，压力未解",
     "from": [
      "S11-B1"
     ],
     "bars": "226–237"
    },
    {
     "text": "步伐起初试探，最后几步向上聚拢",
     "from": [
      "S11-B2"
     ],
     "bars": "226–241"
    }
   ]
  },
  {
   "sec": "S12",
   "big": [
    {
     "text": "他知道当初那些气不该忍",
     "accent": "不该忍",
     "emotion": "炽热",
     "from": [
      "S12-1"
     ]
    },
    {
     "text": "和那些人在一起确实开心过",
     "accent": "确实开心过",
     "emotion": "欢喜",
     "from": [
      "S12-1",
      "S12-2"
     ]
    },
    {
     "text": "他不再怪自己当初离开",
     "accent": "不再怪自己",
     "emotion": "安心",
     "from": [
      "S12-2"
     ]
    },
    {
     "text": "他愿带着想念继续过日子",
     "accent": "带着想念",
     "emotion": "安心",
     "from": [
      "S12-2"
     ]
    },
    {
     "text": "他不肯只为有人陪就回头",
     "accent": "不肯只为有人陪",
     "emotion": "炽热",
     "from": [
      "S12-2"
     ]
    }
   ],
   "small": [
    {
     "text": "他不再逼自己选边，仍决定怎样站立",
     "after": 2,
     "from": [
      "S12-1",
      "S12-B2"
     ],
     "bars": "242–253"
    },
    {
     "text": "想起好时候会心软，也怕以后独自熬",
     "after": 3,
     "from": [
      "S12-2"
     ],
     "bars": ""
    },
    {
     "text": "他不必假装自己从未受伤",
     "after": 3,
     "from": [
      "S12-B2"
     ],
     "bars": "242–253"
    }
   ],
   "notes": [
    {
     "text": "熟悉主题轰然回来，沉重步子踏实落地",
     "from": [
      "S12-B1"
     ],
     "bars": "242–253"
    },
    {
     "text": "向前时色彩忽变，像地面短暂斜了一下",
     "from": [
      "S12-B3"
     ],
     "bars": "249–253"
    }
   ]
  },
  {
   "sec": "S13",
   "big": [
    {
     "text": "想起从前亲近他心里又热了",
     "accent": "心里又热了",
     "emotion": "欢喜",
     "from": [
      "S13-1"
     ]
    },
    {
     "text": "这份热意连着故土与共同记忆",
     "accent": "故土与共同记忆",
     "emotion": "炽热",
     "from": [
      "S13-B1"
     ]
    },
    {
     "text": "他有了劲头想把日子过好",
     "accent": "把日子过好",
     "emotion": "炽热",
     "from": [
      "S13-2"
     ]
    },
    {
     "text": "怕久等亲近的人心里渐静",
     "accent": "怕久等亲近的人",
     "emotion": "悬着",
     "from": [
      "S13-3"
     ]
    },
    {
     "text": "没人陪他也不为留人忍委屈",
     "accent": "不为留人忍委屈",
     "emotion": "安心",
     "from": [
      "S13-4"
     ]
    }
   ],
   "small": [
    {
     "text": "盼以后还能那样相处，有人来他会珍惜",
     "after": 0,
     "from": [
      "S13-1",
      "S13-4"
     ],
     "bars": ""
    },
    {
     "text": "他不再整天跟从前的事较劲",
     "after": 2,
     "from": [
      "S13-2"
     ],
     "bars": ""
    },
    {
     "text": "像心脏以最高负荷跳动",
     "after": 2,
     "from": [
      "S13-B1"
     ],
     "bars": "254–270"
    },
    {
     "text": "像被气流推着往前跑，兴奋得顾不上喘息",
     "after": 2,
     "from": [
      "S13-B2"
     ],
     "bars": "269–280"
    },
    {
     "text": "成功还牢不牢？也像终于能喘口气",
     "after": 3,
     "from": [
      "S13-B3"
     ],
     "bars": "281–287"
    },
    {
     "text": "最后那一下，像决定，也像忽然梦醒",
     "after": 4,
     "from": [
      "S13-B5"
     ],
     "bars": "286–288"
    }
   ],
   "notes": [
    {
     "text": "柔软歌唱被带进宏大音响，密集音流向上喷涌",
     "from": [
      "S13-B1"
     ],
     "bars": "254–270"
    },
    {
     "text": "快速炫目的音型一下向前冲出",
     "from": [
      "S13-B2"
     ],
     "bars": "269–280"
    },
    {
     "text": "冲势收敛，颤动装饰音重新带来不安",
     "from": [
      "S13-B3"
     ],
     "bars": "281–287"
    },
    {
     "text": "低处两记耳语和弦后，高处亮起清脆钟响",
     "from": [
      "S13-B4"
     ],
     "bars": "末尾几小节"
    }
   ]
  }
 ]
}