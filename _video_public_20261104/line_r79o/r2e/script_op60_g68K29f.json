     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "又担心对方会嫌自己太黏",
       "keys": [
        "担心对方会嫌自己太黏"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "连原本熟悉的亲近，在他心里也像忽然隔了一层",
       "keys": [],
       "from": [
        "S05-3"
       ],
       "bead": "S05-3"
      }
     ]
    }
   ]
