      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S02",
    "bars": "24–65",
    "relation": "正在面对",
    "items": [
     {
      "id": "S02-1",
      "text": "他希望自己能够安然承担已经作出的选择，不必反复向自己证明当初做得正确。",
      "key": "他希望自己能够安",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2"
      ]
     },
     {
      "id": "S02-2",
      "text": "他目前更愿意把心思放在终于不必继续受委屈的轻松上，借这份轻松让自己安定下来。",
      "key": "他目前更愿意把心",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S02-1"
      ]
     },
     {
      "id": "S02-3",
      "text": "即使心里仍有不安，他也不愿为了摆脱这种不安而回到原先那种必须一再委屈自己的生活。",
      "key": "即使心里仍有不安",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S02-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S01-2",
      "to": "S02-1",
      "rel": "引用"
     },
     {
