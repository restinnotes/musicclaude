        \"matter\": \"大\",\n          \"fix\": \"高音悬着，水波仍往前推\"\n        },\n        {\n          \"quote\": \"还没有失去什么，就已经舍不得了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"再次和对方亲近\",\n          \"point\": \"想起上回那些到了嘴边却没说的话\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"到了嘴边却没说\"\n        },\n        {\n          \"text\": \"他几乎想把藏着的话全说出来\",\n          \"point\": \"想把藏着的话全说出来\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"也盼对方喜欢他不再小心收着的样子\"\n        },\n        {\n          \"text\": \"他想多说一些\",\n          \"point\": \"还是有些话没说出口\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"好让眼下的好留久一点，又怕说太多让对方为难\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"丰满的声音只剩下一条单薄、孤零零的旋律\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"单薄、孤零零\"\n        },\n        {\n          \"quote\": \"一个人从“我与你”的亲密中抽身，转而跌回自己的内心\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"从亲密里抽身，跌回自己心里\"\n        },\n        {\n          \"quote\": \"这份幸福是真实的吗？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"这份幸福是真的吗？\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"前几次他都收住了喜欢\",\n          \"point\": \"让对方看出他有多在乎\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方一直愿意亲近\"\n        },\n        {\n          \"text\": \"他之前还能装作没那么在乎\",\n          \"point\": \"连怎么相处都没了主意\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"现在对方看出来了\"\n        },\n        {\n          \"text\": \"他担心对方会嫌自己太黏\",\n    