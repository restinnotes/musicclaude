       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "热切短暂增强后慢慢柔和，仍有一点不安定",
       "keys": [
        "仍有一点不安定"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
