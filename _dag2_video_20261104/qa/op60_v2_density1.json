      ],
      "bead_edges": [
        {
          "a": "S07-B1",
          "b": "S07-B3",
          "type": "重叠但新增",
          "note": "两者都具有热度增强、越来越难抽离的性质，但身体体验不同。B1是来自低音脉搏、伴奏增密和内声部攀升的推动力，渴望催着身体向前；B2则是记忆与各种感官混融之后的舒适、迷醉和失去方向。前者不再满足于原有的安静，后者却享受被感觉卷进去。这不是固定的因果先后，也不能把两种不同原稿中的感受强行安排给同一人物。"
        },
        {
          "a": "S07-B1",
          "b": "S07-B2",
          "type": "可同时成立",
          "note": "B1让人感到音乐正越来越迫切地向前，B3则让人听见时间本身无法停下。二者可以同时成立，但不能把B3解释成B1这股渴望的唯一心理原因。"
        },
        {
          "a": "S07-B3",
          "b": "S07-B2",
          "type": "可同时成立",
          "note": "感官上的沉醉和无法停止时间的意识可以并存。B2着重越舒服越失去方向，B3着重这一刻纵然完美也无法固定；不需要把它们写成先沉醉、随后害怕失去的故事。"
        }
      ],
