 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近这个人，心里一下热起来",
       "keys": [
        "那么想靠近这个人"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "连自己也有点意外，像夏夜烟花升起迸发又缓缓飘落",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "也像一脚踏上小船，木板微晃，身体有一瞬失重",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他怕对方看出自己多需要这份亲近会觉得负担太重，只敢露出一点点喜欢",
       "keys": [
        "只敢露出一点点喜欢"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像想了很久的话到嘴边先沉默几秒，怕说出口关系就变了",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "光这么一点亲近就让他觉得甜，还拿不准下次能不能更坦白些",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因为他露出在意就退开，仍愿意跟他亲近，他才渐渐放松下来",
       "keys": [
        "渐渐放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像紧挨着耳语连体温都融在一处，又像夏末微黏的暖风",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "也像熟人安静坐着不用找话，偶尔对望也不紧张",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "仿佛不必再踩实地面，把身体交给船底温柔地托着",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠得更近，有一阵子喜欢得几乎藏不住",
       "keys": [
        "喜欢得几乎藏不住"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "最后还是怕太急弄坏眼下的自在而收住了",
       "keys": [
        "怕太急弄坏眼下的自在"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话忍不住说得热切了些，又轻轻呼出一口气，没把心事说死",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待在一起这么好，他偏偏想到这时刻总会过去，还没分开就先有点鼻酸、舍不得",
       "keys": [
        "先有点鼻酸、舍不得"
       ],
       "from": [
        "S02-3",
        "S02-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像在船上舒服地漂着不急着靠岸，水和时间却一直在走",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像扎了根温柔的刺，忍不住希望这一刻再慢一点过去",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他难得不去琢磨两个人往后会怎样，只想舒舒服服地待在这份亲近里",
       "keys": [
        "待在这份亲近里"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像说完重要的话还停在里头，有一点陶醉，有一点走神",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "也像交谈后安静下来并不尴尬，人还在这儿，心却慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想说有多喜欢这样，也想问对方是否一样",
       "keys": [
        "想说有多喜欢这样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可没想好怎么开口，念头只在水面露了下头，很快又沉了回去",
       "keys": [
        "很快又沉了回去"
       ],
       "from": [
        "S03-2",
        "S03-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "仿佛谈话碰到了解不开的结，思绪像被风吹碎的倒影",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他满心欢喜，他想起上回明明想告诉对方却没有开口",
       "keys": [
        "满心欢喜"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想把藏着的话全说出来，盼着对方也喜欢他不再小心收着的样子",
