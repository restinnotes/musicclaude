      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S06",
    "bars": "40–50",
    "relation": "正在面对",
    "items": [
     {
      "id": "S06-1",
      "text": "对方仍愿意亲近他，没有因他显露更多依恋而疏远。",
      "key": "对方仍愿意亲近他",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1"
      ]
     },
     {
      "id": "S06-2",
      "text": "他渐渐习惯让对方知道自己的真实需要，先前的紧张也慢慢变成可以停留的安心；只是关于自己投入多深的牵念，仍有一部分只能由他自己消化。",
      "key": "他渐渐习惯让对方",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1",
       "S05-2"
      ]
     }
    ],
    "because": [
     {
