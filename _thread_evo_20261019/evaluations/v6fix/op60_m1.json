    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "不再为自己要得太多而难堪，他把爱尽情给出去。",
      "key": "不再为自己要得太",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-3"
      ]
     },
     {
      "id": "S12-2",
      "text": "亲近越丰盛，他越舍不得它改变，那点不安也使眼前更珍贵。",
      "key": "亲近越丰盛，他越",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-2"
      ]
     },
     {
      "id": "S12-3",
      "text": "欢喜和怕留不住混在一起，他快乐得近乎疼痛，却不愿收住。",
      "key": "欢喜和怕留不住混",
      "follows": false,
      "explains": [],
      "cite": []
     }
    ],
    "because": [
