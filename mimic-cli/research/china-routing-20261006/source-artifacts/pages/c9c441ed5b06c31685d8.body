</style><!-- END app snippet --><!--<script type="text/template" id="tl-switcher-template">--><!--  <div class="tl-switcher-container hidden top-right">--><!--    &lt;!&ndash; BEGIN app snippet: language_form &ndash;&gt;--><!--    <div class="tl-switcher tl-language">--><!--    <div class="tl-select">--><!--      <img--><!--              class="tl-flag"--><!--              loading="lazy"--><!--              width="20"--><!--              height="18"--><!--              alt="Language switcher country flag for 简体中文"--><!--              src="/index/static/cn.svg"--><!--      >--><!--      <span class="tl-label tl-name">简体中文</span>--><!--    </div>--><!--    <ul class="tl-options top-right" role="list">--><!--      --><!--      <li--><!--              onclick="window.location.href='/localization/zh/en'"--><!--              class="tl-option "--><!--              data-value="en"--><!--      >--><!--        <img--><!--                class="tl-flag"--><!--                loading="lazy"--><!--                width="20"--><!--                height="18"--><!--                alt="Language dropdown option country flag for English"--><!--                src="/index/static/gb.svg"--><!--        >--><!--        <span class="tl-label tl-name" for="English">English</span>--><!--      </li>--><!--      --><!--      <li--><!--              onclick="window.location.href='/localization/zh/fra'"--><!--              class="tl-option "--><!--              data-value="fra"--><!--      >--><!--        <img--><!--                class="tl-flag"--><!--                loading="lazy"--><!--                width="20"--><!--                height="18"--><!--                alt="Language dropdown option country flag for fran&ccedil;ais"--><!--                src="/index/static/fr.svg"--><!--        >--><!--        <span class="tl-label tl-name" for="fran&ccedil;ais">fran&ccedil;ais</span>--><!--      </li>--><!--      --><!--      <li--><!--              onclick="window.location.href='/localizati