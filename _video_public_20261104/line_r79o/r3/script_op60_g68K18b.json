 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "忽然想靠近，心热，自己意外。",
       "keys": [
        "想靠近",
        "心热"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕对方看出他太需要亲近、觉得负担重；像话到嘴边，明知出口会改关系，只露点喜欢。",
       "keys": [
        "太需要亲近",
        "只露点喜欢"
       ],
       "from": [
        "S01-2",
        "S01-B2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这点已甜，下次敢坦白？",
       "keys": [
        "这点已甜",
        "敢坦白"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "烟花骤升，碎光飘落后仍悬水面；又像初踏微晃船板，水纹荡开、身体失重，摇摆未稳",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因他露出在意就退开，仍愿意亲近，他才慢慢放松。",
       "keys": [
        "露出在意就退开",
        "慢慢放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "右手两条旋律线贴得很近，像肩膀相挨，呼吸和体温都融在一起；熟人安静坐着，偶尔对视也不尴尬",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "第4–5小节，左手像心跳，也像不停的水浪；身体交给船底托举，水却一直流，时间也没停",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "几次柔软落音像一根温柔的刺：眼前还很好，心里却先有点鼻酸，盼这一刻慢些过去",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠近，喜欢得几乎藏不住；可怕太急弄坏眼下的自在，最后还是收住了。",
       "keys": [
        "喜欢得几乎藏不住",
        "最后还是收住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "第12–14小节，歌声忽然往上涌；到14–16小节又轻轻呼气，回到柔和，心事没有说死",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待得这么好，他却想到这一刻总会过去，还没分开就先舍不得。",
       "keys": [
        "总会过去",
        "先舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不想以后，只想舒服地待在亲近里；歌声退远，像水波托着身体漂着，沉默不尴尬，心也慢慢漂远，像重要的话说完后还沉在余味里。",
       "keys": [
        "舒服地待在亲近里",
        "心也慢慢漂远"
       ],
       "from": [
        "S03-1",
        "S03-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "第20–21小节，摇曳中忽然冒出几句急促声音，露头就沉",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水波仍晃，暗流却拖住流动，声音绕远、挂在半途；思绪像风吹碎的倒影，难拼完整，像亲密谈话碰到解不开的结，却没走向悲剧",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "想说多喜欢，也想问对方是否一样；没想好怎么开口，念头就淡了。",
       "keys": [
        "多喜欢",
        "是否一样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉亲近又让他欢喜得鼻酸；想起上回想说，却没开口。",
       "keys": [
        "欢喜得鼻酸",
        "没开口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉歌声重来，两线贴耳低语，这遍更华丽急切，花腔如晃眼光斑；像一句话说完还折回补细节",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想说出藏着的话，盼对方喜欢自己不再收着；手也像不自觉握紧，越想抱牢当下，水面越颠簸，船舱平衡越脆弱。",
       "keys": [
        "说出藏着的话",
        "不自觉握紧"
       ],
       "from": [
        "S04-2",
        "S04-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "第32小节附近，长颤音像夕阳最后一道金光，亮得刺眼；右手悬高，左手水波仍推着往前",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "话到喉咙口发紧、哽咽，像一瞬全说开；音乐攀高又收弱，到34小节才慢下来，话仍在回荡",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "两道声线仍贴得很近，水波却一刻不停，像每秒都在倒数；还没失去，已经舍不得",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他盼说出口能留住眼下的好，又怕说太多让对方为难、弄丢自在，最后仍留了些话。",
       "keys": [
        "留住眼下的好",
        "留了些话"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "几次收住，装不在乎；对方亲近，这回露喜欢，被看出在乎。",
       "keys": [
        "装不在乎",
        "露喜欢"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波抽走，雾里单薄旋律游走，脚下无依、时间松开；像松手吸气",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "耳语戛止，他跌回心里：幸福真吗？能多久",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "被看穿后空落，拿不准相处，怕被嫌黏，亲近像隔层。",
       "keys": [
        "拿不准相处",
        "亲近像隔层"
       ],
       "from": [
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他在乎，相处没变，他自在了。",
       "keys": [
        "相处没变",
        "自在了"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "摇摆重来，波浪薄成细纹；暖金水面转入古桥阴影，A大调牧歌清澈如月光，像初恋午后",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "低声歌里旁声插话纠缠；“算了”后又浮起“放不下”，不哭不崩，只不再强装完整",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "像白天相处很好，独处却泛酸；再亲近也走不进心里每个角落，美好恍如回忆",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "不是欲望退潮，而是贴身沉醉：气味、身体感、幻想、遗憾、快感交叠，舒服得迷失方向",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "安静时仍想靠近，怕要太多；对方不知他怕被嫌弃，他有点孤单。",
       "keys": [
        "仍想靠近",
        "有点孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "没退开，会不会舍不得结束亲近？",
       "keys": [
        "没退开",
        "舍不得结束亲近"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这些日子对方总愿陪他，他渐渐觉得，对方也许需要自己，跟他在一起能安心。",
       "keys": [
        "对方也许需要自己",
        "能安心"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声重来，清澈底下暗涌攀爬；伴奏变密，低音八度与切分像沉重脉搏催促",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "压着的感受成了动力，身体被更深渴望推着往前，情欲、执念和对生命的眷恋一齐翻涌",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "像独自回想一段关系，气味、身体感、幻想、遗憾、快感交叠；情色暖意让人失向，明知被卷入却暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "美仍在，时间却经过；完美一刻也停不住",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到也许能互相依靠，他高兴得收不住，心里一紧却还想留下；盼对方以后想找人时想到自己，自己也一直陪着。",
       "keys": [
        "互相依靠",
        "一直陪着"
       ],
       "from": [
        "S07-2",
        "S07-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "上回无意露了心意，这回见对方依然亲近，他想主动些，大方回应。",
       "keys": [
        "依然亲近",
        "大方回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旋律忽然直白舒展，像意大利歌剧咏叹调；不讲哲理、不设防、不分析，歌句越唱越开，摇荡轻轻催人向前",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "歌声明亮轻盈，像重新碰到阳光和风；身体恢复弹性，带着玩心，像轻快调情与回应",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "这样想着，他开始盼往后的日子，觉得两个人说不定还能这么好很久。",
       "keys": [
        "开始盼往后的日子",
        "这么好很久"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "第69–70小节，歌声向上散开；约第71小节忽然停住，快乐余温还在，心头已泛起怀念",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可眼下都愿意亲近，以后未必还会这样，他心里没底。",
       "keys": [
        "以后未必还会这样",
        "心里没底"
       ],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕哪天对方不再需要他陪，连相处都不自在。",
       "keys": [
        "不再需要他陪",
        "相处都不自在"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "冲势骤停，摇摆退开；颤音、轻和弦悬空，像对视屏息，渴望仍绷着",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "明朗隔了薄雾，声音下沉变暗，光还在",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      },
      {
       "text": "像听自己的余响，反复问：那是真的吗？接下来呢",
       "keys": [],
       "from": [
        "S09-B3"
       ],
       "bead": "S09-B3"
      },
      {
       "text": "又像激动后抬头看夜空，美好大过愿望；不安没答案，却暂不占满心思",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他忽然安静，不敢再往下想。",
       "keys": [
        "忽然安静",
        "不敢再往下想"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想起对方没退开、两人仍亲近，这些都是真的；也许对方喜欢他在身边，他有点高兴。",
       "keys": [
        "这些都是真的",
        "有点高兴"
       ],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "再猜下去，今天都过不踏实；他先享受眼前亲近。肩膀松开，胸腔打开，亮得想笑又想哭，眼泪终于不用憋。",
       "keys": [
        "享受眼前亲近",
        "眼泪终于不用憋"
       ],
       "from": [
        "S10-1",
        "S10-2",
        "S10-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "清风拨开水波，时间松出空地；只是一口气，不是久留的避风处",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "身体失重，像灵魂离体，短暂悬在夏夜微风里，重担仿佛碰不到自己",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      },
      {
       "text": "右手高音细亮如晨曦银丝、细雨",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      },
      {
       "text": "80–83小节的琶音如飞瀑从高处倾泻，清亮落水",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他需要对方，对方有时需要他；即使对方不需要，仍愿陪，不藏喜欢。",
       "keys": [
        "需要对方",
        "不藏喜欢"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "84小节，同船同歌忽然直白，谨慎退去；厚和弦托歌，左手化作跨八度惊涛，像说：“这是我的感情，我不再为它道歉。”",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      },
      {
       "text": "92小节附近，悬着的期待似乎满足，仍未结束",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      },
      {
       "text": "灿烂如夕阳血金，刺眼得想哭，胸口疼",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      },
      {
       "text": "像多年后重回旧房：家具没变，温柔还在，越知珍贵越疼",
       "keys": [],
       "from": [
        "S11-B4"
       ],
       "bead": "S11-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他高兴得顾不上害臊，觉得在乎没错。",
       "keys": [
        "顾不上害臊",
        "在乎没错"
       ],
       "from": [
        "S11-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他能否一直陪着，不由自己决定；亲近未必长久，欢喜压心口。",
       "keys": [
        "不由自己决定",
        "欢喜压心口"
       ],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": []
    }
   ]
