       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他仍按自己认可的尺度对待自己，不拿自尊去交换重新属于那里的机会",
       "keys": [
        "不拿自尊去交换重新属于那里的机会"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "明知有些珍惜的事挽不回，便静静看着，不再急着抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "旧日安稳的怀念再次变得很强，几乎盖过眼前的自持",
