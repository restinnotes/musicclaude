       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
