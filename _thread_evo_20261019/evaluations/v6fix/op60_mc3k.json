    "bars": "84–92",
    "relation": "没在想",
    "items": [
     {
      "id": "S11-1",
      "text": "他又沉入熟悉的亲近，欢喜远比最初充实。",
      "key": "他又沉入熟悉的亲",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1"
      ]
     },
     {
      "id": "S11-2",
      "text": "他交出脆弱，尽情付出并安心收下温柔。",
      "key": "他交出脆弱，尽情",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-3"
      ]
     },
     {
      "id": "S11-3",
      "text": "旧有酸楚未散，欢喜浓得发疼。",
      "key": "旧有酸楚未散，欢",
      "follows": false,
      "explains": [],
      "cite": []
     }
    ],
    "because": [
     {
      "from": "S01-1",
