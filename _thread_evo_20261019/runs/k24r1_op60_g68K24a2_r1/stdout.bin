   \"text\": \"他更想听对方说以后也不变\",\n          \"accent\": \"以后也不变\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"时间飞快他仍怕这一切会结束\",\n          \"accent\": \"会结束\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他更怕对方哪天不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"少露些心意会不会少疼些？\",\n          \"accent\": \"少疼些\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"可他已不想再装作不在乎\",\n          \"accent\": \"不想再装作不在乎\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"就算听到保证，时间也不会慢下来\",\n          \"after\": 1,\n          \"from\": [\"S13-1\"],\n          \"bars\": \"\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"幸福里渐渐掺进尖锐的苦涩\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"得到珍贵的东西也会疼，因为留不住\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"可是没推翻幸福，真信过才会疼\",\n          \"after\": 3,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"站得很稳，胸口却一沉再沉\",\n          \"after\": 4,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"真心想对他好，藏回去反倒更难受\",\n          \"after\": 4,\n          \"from\": [\"S13-3\"],\n          \"bars\": \"\",\n          \"at\": 28\n        }\n      ],\n