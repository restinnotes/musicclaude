{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他已经离开熟悉的生活\",\n          \"accent\": \"离开\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"起初他觉得总算不用再委屈自己\",\n          \"accent\": \"不用再委屈自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"可这份笃定很快就散了\",\n          \"accent\": \"很快就散了\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 26\n        },\n        {\n          \"text\": \"他一时说不清舍不得什么\",\n          \"accent\": \"说不清\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-2\"],\n          \"at\": 38\n        },\n        {\n          \"text\": \"他想往前过却不知如何安心\",\n          \"accent\": \"不知如何安心\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-3\"],\n          \"at\": 64\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像硬撑着挺直背脊，心里却想停\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"说不清是愤怒遗憾还是怀念\",\n          \"after\": 3,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"\",\n          \"at\": 45\n        },\n        {\n          \"text\": \"像刚从昏沉里醒来，四周冷而空\",\n          \"after\": 3,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"\",\n          \"at\": 53\n        },\n        {\n          \"text\": \"胸口发紧，伸手却只摸到虚空\",\n          \"after\": 3,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"\",\n          \"at\": 61\n        },\n        {\n          \"text\": \"熟悉的声音和光线回来，却不是现在\",\n          \"after\": 4,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"9–17\",\n          \"at\": 74\n        },\n        {\n          \"text\": \"身体先记起该怎样迈步\",\n          \"after\": 4,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"18–23\",\n          \"at\": 82\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"沉重一响后琶音像烟雾散开，停顿里还等回声\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–6\"\n        },\n        {\n          \"text\": \"短句刚冒出就被长停顿截断\",\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"他舍不得从前的自在日子\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到以后不能那样过他就慌\",\n          \"accent\": \"他就慌\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-1\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他赶紧想起受过的那些气\",\n          \"accent\": \"受过的那些气\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 23\n        },\n        {\n          \"text\": \"他怕心软忘了为何离开\",\n          \"accent\": \"怕心软\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-2\"],\n          \"at\": 34\n        },\n        {\n          \"text\": \"不受气就得丢掉好日子吗？\",\n          \"accent\": \"丢掉好日子\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-3\"],\n          \"at\": 49\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"远处旧歌只剩几句模糊哼唱\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"舞步带着庄严，歌声像私下低哼\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"像腿脚发虚的人在记忆里挪步\",\n          \"after\": 1,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"抬头装作没事，反复说着才露出在意\",\n          \"after\": 3,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"\",\n          \"at\": 39\n        },\n        {\n          \"text\": \"悲伤还在，他不肯全交给它\",\n          \"after\": 3,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"\",\n          \"at\": 44\n        },\n        {\n          \"text\": \"不甘心就这样消亡\",\n          \"after\": 4,\n          \"from\": [\"S02-B5\"],\n          \"bars\": \"44–65\",\n          \"at\": 54\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏底下细碎声音一直不安地蠕动\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"音乐猛推又退，随后再聚力，连绵短音催得呼吸发急\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"38–65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他心里还憋着一股气\",\n          \"accent\": \"憋着一股气\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起被当自己人他短暂高兴\",\n          \"accent\": \"短暂高兴\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"从前那样的日子回不去了\",\n          \"accent\": \"回不去了\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S03-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"离开以后就一定更好过吗？\",\n          \"accent\": \"一定更好过吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 22\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"前段焦躁，后段麦浪微风般亲切\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"66–91\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"那份亲切让人心颤，也刺痛\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"80–91\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"像出去走走，轻松是真的，问题还在\",\n          \"after\": 2,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"66–91\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"耳边像多人低语缠绕，脚下像流沙\",\n          \"after\": 3,\n          \"from\": [\"S03-B4\"],\n          \"bars\": \"66–91\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"昂扬慢慢退去，我刚才真相信了吗？\",\n          \"after\": 3,\n          \"from\": [\"S03-B5\"],\n          \"bars\": \"66–91\",\n          \"at\": 25\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"重击后忽强忽弱，节奏忽然错开\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66–91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"他真盼着从前那样亲近\",\n          \"accent\": \"真盼着\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可亲近的回忆又勾起委屈\",\n          \"accent\": \"勾起委屈\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他开始问当初走得对不对\",\n          \"accent\": \"对不对\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\"],\n          \"at\": 19\n        },\n        {\n          \"text\": \"没走的话如今又会怎样？\",\n          \"accent\": \"又会怎样\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\"],\n          \"at\": 25\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"旧日子里有感激亲密和短暂幸福\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"外面还在往前，心里却多了回声\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"记忆太好了，想到回不去就刺痛\",\n          \"after\": 1,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108–115\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"像急促脚步和乱了拍的心跳\",\n          \"after\": 2,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92–115\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"如果当时还能怎样，为什么会变这样\",\n          \"after\": 3,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94–115\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"不停往前赶，只是怕停下来\",\n          \"after\": 3,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94–115\",\n          \"at\": 29\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"急促音符像乱跑的脚步，低沉声响一路追赶\",\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92–115\"\n        },\n        {\n          \"text\": \"声音忽然绷紧如风暴，一串音步步向下\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108–115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他仍觉得当初那些气不该忍\",\n          \"accent\": \"不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他不想连开心的回忆都躲着\",\n          \"accent\": \"开心的回忆\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"争得没了力气不服气也淡了\",\n          \"accent\": \"没了力气\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 22\n        },\n        {\n          \"text\": \"想到如今已不在那些人身边\",\n          \"accent\": \"不在那些人身边\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 32\n        },\n        {\n          \"text\": \"他心里只剩难受\",\n          \"accent\": \"难受\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 39\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像夜色里两个影子低声说话\",\n          \"after\": 0,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"116–147\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"怒气悲伤都在，他还想护住自己\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116–127\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"像某个人，也像故乡或过去的生活\",\n          \"after\": 2,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116–147\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"眷恋里还带着失去的难过\",\n          \"after\": 3,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116–147\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"旋律单独露出来，像脚下地板忽然消失\",\n          \"after\": 3,\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128–147\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"不安又加深，几次深呼吸后只是累了\",\n          \"after\": 4,\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"132–147\",\n          \"at\": 45\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"快速音型渐渐放慢变稀，最后化成疏疏和弦\",\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128–147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"心里那阵难受慢慢缓下来\",\n          \"accent\": \"慢慢缓下来\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"身边没人他才懂从前多轻松\",\n          \"accent\": \"多轻松\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"他很想再过不用多说的亲近日子\",\n          \"accent\": \"亲近日子\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-3\"],\n          \"at\": 27\n        },\n        {\n          \"text\": \"可他怕以后再也没有了\",\n          \"accent\": \"再也没有了\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-3\"],\n          \"at\": 40\n        },\n        {\n          \"text\": \"愿望委屈思念终于浮上来\",\n          \"accent\": \"终于浮上来\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-B2\"],\n          \"at\": 54\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"这回他没拿受过的气压住想念\",\n          \"after\": 0,\n          \"from\": [\"S06-1\"],\n          \"bars\": \"\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"真真切切拥有过，想起心里暖一点\",\n          \"after\": 2,\n          \"from\": [\"S06-4\"],\n          \"bars\": \"\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"像玻璃罩隔开世界，母亲轻哼摇篮曲\",\n          \"after\": 2,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\",\n          \"at\": 34\n        },\n        {\n          \"text\": \"安宁不代表现实变好，挽不回就轻轻看着\",\n          \"after\": 3,\n          \"from\": [\"S06-B1\", \"S06-B4\"],\n          \"bars\": \"148–180\",\n          \"at\": 45\n        },\n        {\n          \"text\": \"终于不用解释难过，也不用装坚强\",\n          \"after\": 4,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\",\n          \"at\": 50\n        },\n        {\n          \"text\": \"祈求未必有回应，梦里家园忽然亮起\",\n          \"after\": 4,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\",\n          \"at\": 58\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"声音绵长从容，像停在一片静谧里\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"旋律由含蓄试探渐渐展开，末尾像话没说完\",\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"148–180\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"刚安心又问自己能否独扛难事\",\n          \"accent\": \"能否独扛难事\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他当初只想不再受那些气\",\n          \"accent\": \"不再受那些气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"没料到离开后会这么孤单\",\n          \"accent\": \"这么孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-2\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"他想找回亲近却不愿再受气\",\n          \"accent\": \"不愿再受气\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\"],\n          \"at\": 25\n        },\n        {\n          \"text\": \"当初离开的决心也找不回了\",\n          \"accent\": \"找不回了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\"],\n          \"at\": 35\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"寒风像吹开紧闭的窗，后颈一凉\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"脉搏猛跳，甜梦一下被拽回严寒\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"像突然换了场景，心里却没安定\",\n          \"after\": 3,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182–197\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"熟悉动作和舞步闯进来，亲切反而刺痛\",\n          \"after\": 3,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181–205\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"熟悉的宣告声又回来，却已立不成秩序\",\n          \"after\": 4,\n          \"from\": [\"S07-B5\"],\n          \"bars\": \"182–197\",\n          \"at\": 39\n        },\n        {\n          \"text\": \"思绪不停翻转，想冲出去却找不到出口\",\n          \"after\": 4,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\",\n          \"at\": 44\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高处忽然浮出一串细长颤音\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182\"\n        },\n        {\n          \"text\": \"舞步突然闯入，前面的静谧被截断\",\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"颤音一层层连起来，迟迟不停\",\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"他先把回去的事放一边\",\n          \"accent\": \"放一边\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起被当自己人心暖未回头\",\n          \"accent\": \"心暖未回头\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"暖意一淡他又怕独自扛难事\",\n          \"accent\": \"怕独自扛难事\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-2\"],\n          \"at\": 10\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像临走前回头再看一眼旧地方\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"206–213\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"胸口终于吸进一口气，只是短暂喘息\",\n          \"after\": 2,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"206–213\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"回忆没法陪他熬过真正的难处\",\n          \"after\": 2,\n          \"from\": [\"S08-2\"],\n          \"bars\": \"\",\n          \"at\": 14\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"缓慢宽广的歌唱短暂地回来\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"206–213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他忽然分不清为何想回去\",\n          \"accent\": \"分不清\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"是舍不得被当作自己人的日子\",\n          \"accent\": \"被当作自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S09-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"还是怕孤单到肯再受那些气\",\n          \"accent\": \"肯再受那些气\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S09-1\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"这念头让他心慌得不敢往下想\",\n          \"accent\": \"不敢往下想\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-2\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从另一面重新看见同一扇门\",\n          \"after\": 0,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"刚有一点稳定，转眼又散到半空\",\n          \"after\": 3,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"重遇无措的自己，这回已知道他经历过什么\",\n          \"after\": 3,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–215\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"双手铺开一片巨大的颤音光晕\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"206–215\"\n        },\n        {\n          \"text\": \"开头沉重的引子从光晕中阴冷闪现\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\"\n        },\n        {\n          \"text\": \"声音短暂落稳又向高处漂去\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他最舍不得被当自己人的日子\",\n          \"accent\": \"最舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可回去还能像从前那样吗？\",\n          \"accent\": \"还能像从前那样吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"旧委屈还在他不敢凭想念回去\",\n          \"accent\": \"不敢凭想念回去\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"他想得很累还是没有答案\",\n          \"accent\": \"没有答案\",\n          \"emotion\": \"疲惫\",\n          \"from\": [\"S10-3\"],\n          \"at\": 13\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"摇篮曲碎片般凄婉，往事已累得讲不出\",\n          \"after\": 3,\n          \"from\": [\"S10-B1\", \"S10-B4\"],\n          \"bars\": \"216–225\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"忽然失重，整个人悬在半空没着落\",\n          \"after\": 3,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"221–225\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"我究竟要怎样继续生活？\",\n          \"after\": 3,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"216–225\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"连眼下的日子也过得不踏实\",\n          \"after\": 3,\n          \"from\": [\"S10-3\"],\n          \"bars\": \"\",\n          \"at\": 19\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的声音断断续续浮出，始终没有铺开\",\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216–225\"\n        },\n        {\n          \"text\": \"零碎的声音轻弱飘忽，像失去着落\",\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"221–225\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他知道回去未必找回亲近\",\n          \"accent\": \"未必找回亲近\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他还是忍不住想万一能呢？\",\n          \"accent\": \"万一能呢\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他不愿只凭希望回去再忍让\",\n          \"accent\": \"不愿只凭希望\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他想先把眼下日子过稳些\",\n          \"accent\": \"过稳些\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-3\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"怕难事独自扛他仍不收回打算\",\n          \"accent\": \"不收回打算\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-4\"],\n          \"at\": 15\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"停滞松开一点，问题却还没解决\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"226–241\",\n          \"at\": 15\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"低音像波涛翻涌，重重一响一次次砸下\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226–241\"\n        },\n        {\n          \"text\": \"步子起初试探，最后几下越聚越向前\",\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"226–241\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的力量一下把人推向前\",\n          \"accent\": \"推向前\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他决定经历动摇后仍要站稳\",\n          \"accent\": \"仍要站稳\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-B2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"他不必假装自己从没受过伤\",\n          \"accent\": \"不必假装\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-B2\"],\n          \"at\": 14\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像面向众人的昂扬，甚至带着集体感\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"242–253\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"脚步向前时，地面忽然斜了一下\",\n          \"after\": 1,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"249–253\",\n          \"at\": 16\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的那段旋律以雷鸣般声势轰然回来\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"242–253\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"想起从前亲近也盼以后再有\",\n          \"accent\": \"盼以后再有\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想好好过日子不再纠缠过去\",\n          \"accent\": \"好好过日子\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他怕很久都遇不到亲近的人\",\n          \"accent\": \"很久都遇不到\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S13-3\"],\n          \"at\": 19\n        },\n        {\n          \"text\": \"有人再把他当自己人他会珍惜\",\n          \"accent\": \"他会珍惜\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-4\"],\n          \"at\": 30\n        },\n        {\n          \"text\": \"没人相待他也好好过不为谁忍气\",\n          \"accent\": \"不为谁忍气\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S13-4\"],\n          \"at\": 39\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"心里又热起来\",\n          \"after\": 0,\n          \"from\": [\"S13-1\"],\n          \"bars\": \"\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"柔软的歌忽然站到明亮宏大的地方\",\n          \"after\": 1,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254–270\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"心脏全力跳动，想到故土共同的希望\",\n          \"after\": 1,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254–270\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"像被气流推着往前跑，兴奋得顾不上喘\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"269–280\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"冲势收住，成功真稳了吗？也能喘口气\",\n          \"after\": 2,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"281–287\",\n          \"at\": 43\n        },\n        {\n          \"text\": \"最后那一下像决定，也像从梦里醒来\",\n          \"after\": 4,\n          \"from\": [\"S13-B5\"],\n          \"bars\": \"286–288\",\n          \"at\": 43\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"柔软歌唱忽然变得开阔宏大\",\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254–270\"\n        },\n        {\n          \"text\": \"明亮迅疾的声音一阵阵向前冲\",\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"269–280\"\n        },\n        {\n          \"text\": \"狂