{"completed": true, "response": "```json\n{\n  \"segments\": [\n    {\n      \"segment\": \"S01\",\n      \"links\": [\n        {\n          \"thread_quote\": \"和声的色彩如此丰厚，偏偏迟迟不肯真正落稳\",\n          \"bead\": \"S01/B1\",\n          \"bead_quote\": \"落下来以后，却还没有真正落稳\",\n          \"type\": \"承接\",\n          \"note\": \"和声的丰厚与迟迟不落定解释了开场余响悬在空中的感觉。\"\n        },\n        {\n          \"thread_quote\": \"真正靠近之前，仍不知道自己将会得到什么，又会失去什么\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"有些话一旦说出来，关系就会改变\",\n          \"type\": \"承接\",\n          \"note\": \"吸引已经发生，但对靠近后果的顾虑使行动仍停留在尚未说出口的阶段。\"\n        },\n        {\n          \"thread_quote\": \"此刻还没有明确的摇荡替人承接这一切\",\n          \"bead\": \"S01/B3\",\n          \"bead_quote\": \"还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"type\": \"承接\",\n          \"note\": \"尚未建立的摇荡对应刚踏上船板、身体仍未找到稳定支撑的瞬间。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S02\",\n      \"links\": [\n        {\n          \"thread_quote\": \"左手终于搭起持续摇荡的节奏，像水面开始托住一只船\",\n          \"bead\": \"S02/B2\",\n          \"bead_quote\": \"把身体交给船底温柔的托举\",\n          \"type\": \"承接\",\n          \"note\": \"持续的摇荡从缺席变成支撑，使放下部分身体控制成为可能。\"\n        },\n        {\n          \"thread_quote\": \"第6小节起，右手两条旋律相伴而出，在三度、六度间靠近、分开\",\n          \"bead\": \"S02/B1\",\n          \"bead_quote\": \"两个紧挨在一起的人耳语\",\n          \"type\": \"承接\",\n          \"note\": \"两条旋律的贴近与分开对应亲密相伴而又保留各自声音的状态。\"\n        },\n        {\n          \"thread_quote\": \"句子缓缓下行，到了末尾便轻轻收住\",\n          \"bead\": \"S02/B3\",\n          \"bead_quote\": \"话已经到了嘴边，又轻轻咽回去\",\n          \"type\": \"承接\",\n          \"note\": \"旋律的克制收束解释了亲近已经发生、表达却仍有所保留的感受。\"\n        },\n        {\n          \"thread_quote\": \"如果每次靠近之后仍能自然退回\",\n          \"bead\": \"S02/B5\",\n          \"bead_quote\": \"没有把心事彻底说死\",\n          \"type\": \"承接\",\n          \"note\": \"靠近之后仍能退回，使短暂的热切不必发展成无法收束的高潮。\"\n        },\n        {\n          \"thread_q