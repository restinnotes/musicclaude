    <script src="https://cdnjs.cloudflare.com/ajax/libs/tocbot/4.12.3/tocbot.min.js"></script>
<script>
    (function () {
        const tocInjectTarget = document.querySelector('.gh-toc');
        if (!tocInjectTarget) return;

        const header = document.querySelector('#gh-head');
        const headerHeight = header ? header.getBoundingClientRect().height : 0;
        const headerGap = 16;
        const baseOffset = Math.round(headerHeight + headerGap);

        function getHeadingsOffset() {
            const isMobile = window.matchMedia('(max-width: 1299px)').matches;
            if (!isMobile) return baseOffset;
            const btn = document.getElementById('gh-toc-toggle-btn');
            const btnH = btn ? Math.ceil(btn.getBoundingClientRect().height) : 0;
            return baseOffset + btnH;
        }

        if (headerHeight) {
            document.documentElement.style.setProperty('--gh-fixed-header-height', `${Math.round(headerHeight)}px`);
        }

        function updateMobileTocPlaceholder() {
            if (!window.matchMedia('(max-width: 1299px)').matches) {
                document.documentElement.style.removeProperty('--gh-toc-mobile-placeholder');
                return;
            }
            const btn = document.getElementById('gh-toc-toggle-btn');
            if (!btn) return;
            const h = Math.ceil(btn.getBoundingClientRect().height);
            document.documentElement.style.setProperty('--gh-toc-mobile-placeholder', `${h}px`);
        }

        let lastHeadingsOffset = getHeadingsOffset();

        tocbot.init({
            tocSelector: '.gh-toc',
            contentSelector: '.gh-content-body',
            headingSelector: 'h1, h2',
            hasInnerContainers: true,
            orderedList: false,
            scrollSmooth: false,
            headingsOffset: lastHeadingsOffset,
            throttleTimeout: 0,
            scrollHandlerTimeout: 0,
            scrollHandlerType: 'throttle',
        });

        requestAnimationFrame(function () {
            updateMobileTocPlaceholder();
        });

        if (typeof ResizeObserver !== 'undefined') {
            const btnEl = document.getElementById('gh-toc-toggle-btn');
            if (btnEl) {
                new ResizeObserver(function () {
                    updateMobileTocPlaceholder();
                }).observe(btnEl);
            }
        }

        let tocResizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(tocResizeTimer);
            tocResizeTimer = setTimeout(function () {
                updateMobileTocPlaceholder();

                const next = getHeadingsOffset();
                if (next !== lastHeadingsOffset) {
                    lastHeadingsOffset = next;
                    tocbot.refresh({
                        ...tocbot.options,
                        headingsOffset: lastHeadingsOffset,
                    });
                }
            }, 120);
        });

        tocInjectTarget.addEventListener('click', function (e) {
            if (e.target.closest('a.toc-link')) return;
            const li = e.target.closest('.toc-list-item');
            if (!li || !tocInjectTarget.contains(li)) return;
            const link = li.querySelector(':scope > a.toc-link');
            if (link) link.click();
        });

        const sticky = document.querySelector('.gh-sidebar-sticky');
        const toggleBtn = document.getElementById('gh-toc-toggle-btn');
        const tocPanel = document.getElementById('gh-toc-panel');
        if (sticky && toggleBtn && tocPanel) {
            const backdrop = document.createElement('div');
            backdrop.className = 'gh-toc-backdrop';
            backdrop.hidden = true;
            document.body.appendChild(backdrop);

            function syncTocPanelA11y(collapsed) {
                toggleBtn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                tocPanel.setAttribute('aria-hidden', collapsed ? 'true' : 'false');
                backdrop.hidden = collapsed;
            }

            syncTocPanelA11y(sticky.classList.contains('is-toc-collapsed'));

            toggleBtn.addEventListener('click', function () {
                const collapsed = sticky.classList.toggle('is-toc-collapsed');
                syncTocPanelA11y(collapsed);
            });

            backdrop.addEventListener('click', function () {
                if (!sticky.classList.contains('is-toc-collapsed')) {
                    sticky.classList.add('is-toc-collapsed');
                    syncTocPanelA11y(true);
                }
            });

            tocInjectTarget.addEventListener('click', function (e) {
                const link = e.target.closest('a.toc-link');
                if (!link) return;
                if (!sticky.classList.contains('is-toc-collapsed')) {
                    sticky.classList.add('is-toc-collapsed');
                    syncTocPanelA11y(true);
                }
            });
        }
    })();
</script>



