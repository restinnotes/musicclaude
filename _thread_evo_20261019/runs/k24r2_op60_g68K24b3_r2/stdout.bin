{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然发现自己很想靠近\",\n          \"accent\": \"很想靠近\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"]\n        },\n        {\n          \"text\": \"他怕对方知道自己有多需要\",\n          \"accent\": \"有多需要\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"]\n        },\n        {\n          \"text\": \"所以他只敢露出一点喜欢\",\n          \"accent\": \"一点喜欢\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-2\"]\n        },\n        {\n          \"text\": \"这点甜让他想说更多却没把握\",\n          \"accent\": \"没把握\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S01-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像话到嘴边，先沉默几秒\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"刚踏上微晃的船板，身体一瞬失重\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"两下响亮的和弦像烟花突然迸开\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"细碎亮点缓缓落下，余音仍悬着\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"船歌的摇荡感还没有真正成形\",\n          \"from\": [\"S01-B1\", \"S01-B3\"],\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没有因为他的在意退开\",\n          \"accent\": \"没有退开\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-1\"]\n        },\n        {\n          \"text\": \"他才渐渐放松下来\",\n          \"accent\": \"放松下来\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"]\n        },\n        {\n          \"text\": \"他想靠得更近却还是收住\",\n          \"accent\": \"还是收住\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\"]\n        },\n        {\n          \"text\": \"他想到这样的好总会过去\",\n          \"accent\": \"总会过去\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\", \"S02-B2\"]\n        },\n        {\n          \"text\": \"还没分开他就有点舍不得\",\n          \"accent\": \"有点舍不得\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S02-3\", \"S02-B4\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像两人肩挨着肩，连呼吸都贴近\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约6–16\"\n        },\n        {\n          \"text\": \"像熟人静静坐着，不必找话题\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约6–16\"\n        },\n        {\n          \"text\": \"像夏末潮湿的风，温热地裹着皮肤\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约6–16\"\n        },\n        {\n          \"text\": \"身体交给船底，不必踩实，水仍往前流\",\n          \"after\": 4,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\"\n        },\n        {\n          \"text\": \"热切地涌上来，又轻轻退回去\",\n          \"after\": 2,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\"\n        },\n        {\n          \"text\": \"甜蜜里带着一点鼻酸\",\n          \"after\": 4,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"约7–11\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声还没浮出来，摇荡已先开始\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–5\"\n        },\n        {\n          \"text\": \"两道歌声贴得很近，像耳边低语\",\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约6–16\"\n        },\n        {\n          \"text\": \"几次柔软的落音轻轻点在句尾\",\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"约7–11\"\n        },\n        {\n          \"text\": \"歌声先向上涌起，随后轻轻收回\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得只想待在亲近里\",\n          \"accent\": \"只想待在亲近里\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"]\n        },\n        {\n          \"text\": \"他想说有多喜欢也想问对方\",\n          \"accent\": \"想问对方\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S03-2\"]\n        },\n        {\n          \"text\": \"没想好怎么开口念头就淡了\",\n          \"accent\": \"念头就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像说过重要的话，心还停在那里面\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"亲密交谈后的沉默很舒服\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"身体像被水波托着，暂时哪里也不去\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"急着表达的念头刚冒头就沉下去\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"约20–21\"\n        },\n        {\n          \"text\": \"像风吹碎的倒影，也像碰到解不开的结\",\n          \"after\": 2,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"亲密的谈话像碰到一个解不开的结\",\n          \"after\": 2,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"短促急切的几声突然冒出来\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"约20–21\"\n        },\n        {\n          \"text\": \"流动的声音像被暗流拖住\",\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20–22\"\n        },\n        {\n          \"text\": \"有些声音绕远了，像挂在半途\",\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20–22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近让他想起上回没说\",\n          \"accent\": \"上回没说\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"]\n        },\n        {\n          \"text\": \"这回他几乎想把喜欢全说出\",\n          \"accent\": \"全说出\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"]\n        },\n        {\n          \"text\": \"他甚至盼说出口能把好时光留久\",\n          \"accent\": \"把好时光留久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-3\"]\n        },\n        {\n          \"text\": \"可他怕说太多会让对方为难\",\n          \"accent\": \"让对方为难\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"]\n        },\n        {\n          \"text\": \"最后还是留了些话没说\",\n          \"accent\": \"留了些话没说\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他盼对方喜欢自己，喜欢他不再收着\",\n          \"after\": 1,\n          \"from\": [\"S04-2\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"像讲往事，越讲越急，还忍不住补细节\",\n          \"after\": 1,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"像话到喉咙口，忽然颤得说不出\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"约30–34\"\n        },\n        {\n          \"text\": \"像握着对方的手，不知不觉越握越紧\",\n          \"after\": 3,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"像想抱紧对方，船却晃得更厉害\",\n          \"after\": 3,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"明明好好的，心里鼻酸像在倒数\",\n          \"after\": 2,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的歌声回来，这次更华丽急切\",\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"高处一段细密颤动亮得刺眼\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"约30–34\"\n        },\n        {\n          \"text\": \"声音向高处走时又渐渐收弱\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"约30–34\"\n        },\n        {\n          \"text\": \"摇荡到结尾慢慢放缓\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他没藏住喜欢对方看出来了\",\n          \"accent\": \"看出来了\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"]\n        },\n        {\n          \"text\": \"他心里空落落不知怎么相处\",\n          \"accent\": \"不知怎么相处\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"]\n        },\n        {\n          \"text\": \"他怕对方嫌他太黏\",\n          \"accent\": \"太黏\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"熟悉的亲近忽然像隔了一层\",\n          \"after\": 2,\n          \"from\": [\"S05-3\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"像小船漂进雾里，脚下没了支撑\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\"\n        },\n        {\n          \"text\": \"连时间都像忽然松开了\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\"\n        },\n        {\n          \"text\": \"像从耳语中抽身，问幸福真能长久吗\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\"\n        },\n        {\n          \"text\": \"像终于松开手，深吸一口气\",\n          \"after\": 2,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"35–39\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"厚实的摇荡忽然抽走，只剩单薄旋律\",\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他在乎却没有退开\",\n          \"accent\": \"没有退开\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"]\n        },\n        {\n          \"text\": \"他才慢慢恢复从前的自在\",\n          \"accent\": \"从前的自在\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"]\n        },\n        {\n          \"text\": \"他还想靠近却怕自己要得太多\",\n          \"accent\": \"怕自己要得太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"]\n        },\n        {\n          \"text\": \"对方不知道他刚才多怕被嫌\",\n          \"accent\": \"不知道\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"]\n        },\n        {\n          \"text\": \"他猜对方也许舍不得结束亲近\",\n          \"accent\": \"也许\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"这让他有点孤单\",\n          \"after\": 3,\n          \"from\": [\"S06-2\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"暖金水面滑入阴影，像童年初恋的月光\",\n          \"after\": 1,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"心里一会儿说算了，一会儿又放不下\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"说着说着忘了有人看，不再装得完整\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"独处才泛酸，亲近的人也走不进每个角落\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"好时光还在眼前，恍惚已像回忆\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的摇荡变轻，碎成细细的水纹\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"清澈舒展的新歌浮出来\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"两道歌声一来一回，时而靠近时而退开\",\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他想起对方总愿意陪着他\",\n          \"accent\": \"总愿意陪着他\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-1\"]\n        },\n        {\n          \"text\": \"他开始觉得对方有时也需要他\",\n          \"accent\": \"也需要他\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"]\n        },\n        {\n          \"text\": \"想到互相依靠他高兴又心紧\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-2\"]\n        },\n        {\n          \"text\": \"情欲执念与生命眷恋一齐翻涌\",\n          \"accent\": \"一齐翻涌\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-B1\"]\n        },\n        {\n          \"text\": \"他盼对方想找人陪时会想到自己\",\n          \"accent\": \"想到自己\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"有他陪着，对方也许更安心\",\n          \"after\": 1,\n          \"from\": [\"S07-1\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"他也想一直陪在对方身边\",\n          \"after\": 4,\n          \"from\": [\"S07-3\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"身体仿佛被更深的渴望推着往前\",\n          \"after\": 3,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"气味身体感觉和幻想遗憾快感层层荡开\",\n          \"after\": 3,\n          \"from\": [\"S06-B4\", \"S07-B2\"],\n          \"bars\": \"40–61\"\n        },\n        {\n          \"text\": \"情色暖意让人失方向，明知卷入仍不想走\",\n          \"after\": 3,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"这一刻再美，也听见时间经过\",\n          \"after\": 4,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"底下的音符越来越密，暗涌不断往上攀\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"低沉的节奏像沉重脉搏一样催促\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"对方依然亲近他想主动回应\",\n          \"accent\": \"主动回应\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-1\"]\n        },\n        {\n          \"text\": \"他开始盼两人能这样好很久\",\n          \"accent\": \"好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"]\n        },\n        {\n          \"text\": \"可他知道以后未必还会这样\",\n          \"accent\": \"未必\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像暂时放下分析，终于能痛快表达\",\n          \"after\": 0,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"阳光和风重新落到身上\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"身体像恢复弹性，带一点玩心\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"像轻快的调情与回应\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"快乐余温还在，心头已泛起怀念\",\n          \"after\": 2,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌句忽然打开，一次次向上舒展\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌声向上散开，随后突然停住\",\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他怕对方不再需要他陪\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"]\n        },\n        {\n          \"text\": \"他一下不敢再往下想\",\n          \"accent\": \"不敢再往下想\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"]\n        },\n        {\n          \"text\": \"对方没退开两人仍亲近\",\n          \"accent\": \"仍亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S09-3\"]\n        },\n        {\n          \"text\": \"也许对方喜欢他在身边\",\n          \"accent\": \"喜欢他在身边\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"也怕对方和他待着不自在\",\n          \"after\": 0,\n          \"from\": [\"S09-1\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"像对视到呼吸都停了，渴望仍悬着\",\n          \"after\": 1,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\"\n        },\n        {\n          \"text\": \"像阳光被薄雾柔化，四周仍有光\",\n          \"after\": 1,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\"\n        },\n        {\n          \"text\": \"像听余响，问刚才是真的吗，接下来呢\",\n          \"after\": 1,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\"\n        },\n        {\n          \"text\": \"抬头看夜空，美好大过愿望，不安暂退\",\n          \"after\": 3,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"前面的推进忽然收住，摇荡退到一旁\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–75\"\n        },\n        {\n          \"text\": \"轻柔的颤动和和弦悬在半空\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"76–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他暂时不再猜往后怎样\",\n          \"accent\": \"不再猜往后怎样\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"]\n        },\n        {\n          \"text\": \"先好好享受眼前的亲近\",\n          \"accent\": \"眼前的亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"]\n        },\n        {\n          \"text\": \"这一刻不必再逼自己控制感受\",\n          \"accent\": \"不必再逼自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-B1\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像绷着肩的人终于长长呼气\",\n          \"after\": 2,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"胸腔打开，眼泪也不必再忍\",\n          \"after\": 2,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"时间像被清风拨开，只短暂有空地\",\n          \"after\": 1,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"灵魂像失了重量，飘在夏夜微风里\",\n          \"after\": 2,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"原先的负担，像再也碰不到自己\",\n          \"after\": 2,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高处细亮的小音符像银丝和细雨\",\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"一串音符像飞瀑从高处倾泻\",\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"80–83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他想到彼此有时都需要对方\",\n          \"accent\": \"彼此都需要\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"]\n        },\n        {\n          \"text\": \"即使对方不需要他仍愿意陪着\",\n          \"accent\": \"仍愿意陪着\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-1\"]\n        },\n        {\n          \"text\": \"他不再把喜欢藏起来\",\n          \"accent\": \"不再藏起来\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\", \"S11-2\"]\n        },\n        {\n          \"text\": \"他不能决定对方以后还要不要他\",\n          \"accent\": \"不能决定\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-3\"]\n        },\n        {\n          \"text\": \"想到未必总亲近他心口发疼\",\n          \"accent\": \"心口发疼\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S11-3\", \"S11-B3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"高兴得连害臊都顾不上\",\n          \"after\": 2,\n          \"from\": [\"S11-2\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"像终于说出：这是我的感情，不再道歉\",\n          \"after\": 2,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"像夕阳烧得血红金亮，刺眼得想哭\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"像多年后走进旧房，熟悉却有新重量\",\n          \"after\": 4,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"悬着的期待像终于得到某种满足\",\n          \"after\": 3,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"约92\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的旋律再现，这次唱得直接有力\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"温柔的摇荡翻成层层惊涛\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"铺开的力量在末尾短暂悬起\",\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"约92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他顾不上对方是否也在乎\",\n          \"accent\": \"顾不上\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"]\n        },\n        {\n          \"text\": \"他只想把能给的都给对方\",\n          \"accent\": \"都给对方\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-1\"]\n        },\n        {\n          \"text\": \"他明知再用心也留不住以后\",\n          \"accent\": \"留不住以后\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"]\n        },\n        {\n          \"text\": \"他还是想多陪对方一会儿\",\n          \"accent\": \"多陪对方\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-2\"]\n        },\n        {\n          \"text\": \"他终于不再强迫自己收着\",\n          \"accent\": \"不再强迫自己\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S12-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像被卷进更大的世界，自己暂时退后\",\n          \"after\": 1,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"这份狂喜像一场高烧\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"像久别重逢，忽然抱紧对方不肯松手\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"喉咙发紧眼眶湿润，分不清笑还是哭\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"像还想要更多，却始终得不到满足\",\n          \"after\": 3,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"那口气一直悬着，直到句尾才松开\",\n          \"after\": 3,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"93–102\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"晴朗的歌被推得开阔而强烈\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"里面的声音彼此拉扯，一浪高过一浪\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"句尾一次次向上伸展，却始终被牵住\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"96–100\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"他更想听对方说以后不变\",\n          \"accent\": \"以后不变\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"]\n        },\n        {\n          \"text\": \"可就算听到他仍怕时间太快\",\n          \"accent\": \"时间太快\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-1\"]\n        },\n        {\n          \"text\": \"他如今更怕对方不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"]\n        },\n        {\n          \"text\": \"他想少露些心意免得太疼\",\n          \"accent\": \"少露些心意\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-2\"]\n        },\n        {\n          \"text\": \"可他已不想把喜欢藏回去\",\n          \"accent\": \"不想藏回去\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"刚到浪峰，身后又有更大的浪推来\",\n          \"after\": 1,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"幸福里已经掺进了难过\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"像把珍贵的东西握住，才知道留不住\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"刚说了是，心里马上问可是呢\",\n          \"after\": 2,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"脚步像钉在地上，胸口却一沉再沉\",\n          \"after\": 3,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的句子反复出现，力度不断推高\",\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"明亮里渐渐混入尖锐暗沉的色彩\",\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"107–110\"\n        },\n        {\n          \"text\": \"下面稳住不动，上面的声音一次次落下\",\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"最初他连喜欢都不敢多露\",\n          \"accent\": \"不敢多露\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-1\"]\n        },\n        {\n          \"text\": \"如今仍亲近他心里又甜又酸\",\n          \"accent\": \"又甜又酸\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S14-1\"]\n        },\n        {\n          \"text\": \"他不后悔让对方看见喜欢\",\n          \"accent\": \"不后悔\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-1\", \"S14-3\"]\n        },\n        {\n          \"text\": \"他不再逼对方保证永远不变\",\n          \"accent\": \"不再逼对方保证\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-2\"]\n        },\n        {\n          \"text\": \"他决定不把喜欢藏回去\",\n          \"accent\": \"不把喜欢藏回去\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S14-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他仍舍不得，也不知道以后怎样\",\n          \"after\": 3,\n          \"from\": [\"S14-2\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"往后会怎样，等真的到了再说\",\n          \"after\": 4,\n          \"from\": [\"S14-3\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"心里仍温热，身体慢慢恢复平静\",\n          \"after\": 2,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111–115\"\n        },\n        {\n          \"text\": \"像从美梦醒来，还记得梦里的光\",\n          \"after\": 2,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111–115\"\n        },\n        {\n          \"text\": \"像经历震荡后站起身，整理衣服关上门\",\n          \"after\": 4,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的歌唱和摇荡幽幽回来\",\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113–115\"\n        },\n        {\n          \"text\": \"低沉的一句像独自沉思\",\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113\"\n        },\n        {\n          \"text\": \"细碎音符像水花溅向夜空\",\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"115\"\n        },\n        {\n          \"text\": \"最后几下声音干脆沉重，船一下定住\",\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\"\n        },\n        {\n          \"text\": \"结尾像接住开头悬着的话\",\n          \"from\": [\"S14-B4\"],\n          \"bars\": \"113–116\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "fbd7e3a0-71b9-