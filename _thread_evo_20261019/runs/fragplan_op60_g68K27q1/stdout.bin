\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S04-3\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S04\", \"type\": \"big\", \"id\": \"B07\"}],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S04-B1\",\n      \"status\": \"keep\",\n      \"dest\": [\n        {\"sec\": \"S04\", \"type\": \"small\", \"id\": \"s12\"},\n        {\"sec\": \"S04\", \"type\": \"notes\", \"id\": \"S04-B1\"}\n      ],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S04-B2\",\n      \"status\": \"keep\",\n      \"dest\": [\n        {\"sec\": \"S04\", \"type\": \"small\", \"id\": \"s13\"},\n        {\"sec\": \"S04\", \"type\": \"notes\", \"id\": \"S04-B2\"}\n      ],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S04-B3\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S04\", \"type\": \"small\", \"id\": \"s14\"}],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S04-B4\",\n      \"status\": \"keep\",\n      \"dest\": [\n        {\"sec\": \"S04\", \"type\": \"small\", \"id\": \"s15\"},\n        {\"sec\": \"S04\", \"type\": \"notes\", \"id\": \"S04-B4\"}\n      ],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S05-1\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S05\", \"type\": \"big\", \"id\": \"B08\"}],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S05-2\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S05\", \"type\": \"big\", \"id\": \"B08\"}],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S05-3\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S05\", \"type\": \"small\", \"id\": \"s16\"}],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S05-B1\",\n      \"status\": \"keep\",\n      \"dest\": [\n        {\"sec\": \"S05\", \"type\": \"small\", \"id\": \"s17\"},\n        {\"sec\": \"S05\", \"type\": \"notes\", \"id\": \"S05-B1\"}\n      ],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S05-B2\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S05\", \"type\": \"small\", \"id\": \"s18\"}],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S05-B3\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S05\", \"type\": \"notes\", \"id\": \"S05-B3\"}],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S06-1\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S06\", \"type\": \"big\", \"id\": \"B09\"}],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S06-2\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S06\", \"type\": \"big\", \"id\": \"B10\"}],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S06-3\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S06\", \"type\": \"big\", \"id\": \"B11\"}],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S06-B1\",\n      \"status\": \"keep\",\n      \"dest\": [\n        {\"sec\": \"S06\", \"type\": \"small\", \"id\": \"s19\"},\n        {\"sec\": \"S06\", \"type\": \"notes\", \"id\": \"S06-B1\"}\n      ],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S06-B2\",\n      \"status\": \"keep\",\n      \"dest\": [\n        {\"sec\": \"S06\", \"type\": \"small\", \"id\": \"s20\"},\n        {\"sec\": \"S06\", \"type\": \"notes\", \"id\": \"S06-B2\"}\n      ],\n      \"duplicate_of\": \"\",\n      \"reason\": \"\"\n    },\n    {\n      \"from\": \"S06-B3\",\n      \"status\": \"keep\",\n      \"dest\": [{\"sec\": \"S06\", \"type\": \"small\", \"id\": \"s21\"}],\n      \"duplicate_of\":