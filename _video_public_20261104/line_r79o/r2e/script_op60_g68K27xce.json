 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然很想靠近对方，心里一下热起来",
       "keys": [
        "很想靠近对方"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像一脚踏上小船，木板微晃，水波荡开时身体有一瞬失重",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕自己的需要添负担，他只敢露一点喜欢",
       "keys": [
        "只敢露一点喜欢"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像想好的话到嘴边又沉默几秒，怕一说出口关系就变了",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这点亲近就很甜，他拿不准下次能不能更坦白",
