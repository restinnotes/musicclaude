1g","Goodscouter: Google Lens Alternative for Image Search \u0026 Price Comparison",4.961538461538462,52,"https://lh3.googleusercontent.com/_K3HDst2wrZ9hJMC5ws0YZhmZO2Hix5Fp4EV6SpMreIAYtPUwYhNS8WEyJUlw5VAe4GcRhvf5ChCF_HLv9qkPSLU","image search \u0026 find the same product across shopping websites, Price Comparison and discover best deals instantly","goodscouter.com",1,null,null,["lifestyle/shopping",null,9],1,1,null,1,"https://lh3.googleusercontent.com/aoDx7Z_rt09fc9r20YcZEHKBoKvnXOeBiwOIhEioCWTmSlUOIMzEkHzwsDaLzTHGbF8_YQfVQBSRjF62GalNqKI6aQ",[1762930734,425963000],"{\n\"update_url\": \"https://clients2.google.com/service/update2/crx\",\n\r\n    \"manifest_version\": 3,\r\n     \r\n    \"name\": \"__MSG_appName__\",\r\n    \"description\": \"__MSG_appDesc__\",\r\n    \"default_locale\": \"en\",\r\n    \"version\": \"1.5.10\",\r\n\r\n    \"background\": {\r\n        \"service_worker\": \"background.min.js\"\r\n    },\r\n    \"permissions\": [\r\n        \"storage\",\r\n        \"tabs\",\r\n        \"contextMenus\"\r\n     ],\r\n \r\n    \"action\": {\r\n        \"default_icon\": \"icon.png\" ,\r\n        \"default_title\": \"goodscouter\"\r\n    },\r\n    \"icons\": {\r\n        \"16\": \"icon.jpg\",\r\n        \"48\": \"icon.jpg\",\r\n        \"128\": \"icon.jpg\"\r\n    },\r\n    \"content_security_policy\": {\r\n        \"extension_pages\": \"script-src 'self'; style-src 'self'; img-src 'self' data: https: http:; font-src 'self' data:\"\r\n    },\r\n    \"content_scripts\": [\r\n        {\r\n               \"matches\": [\r\n                \"\u003call_urls\u003e\"\r\n              \r\n            ],\r\n            \"js\": [ \"c.min.js\"],\r\n            \"run_at\": \"document_end\",\r\n            \"all_frames\": false\r\n        }\r\n    ],\r\n    \"web_accessible_resources\": [\r\n        {\r\n            \"resources\": [\"icon.jpg\"],\r\n            \"matches\": [\"\u003call_urls\u003e\"]\r\n        }\r\n    ]\r\n}","Goodscouter: Google Lens Alternative for Image Search \u0026 Price Comparison"],null,null,null,null,[[2,"https://www.youtube.com/embed/Pg4z7jfmVS0?rel\u003d0\u0026wmode\u003dopaque\u0026enablejsapi\u003d1"],[1,"https://lh3.googleusercontent.com/UM2p0qJ_lPAG1oPtyTv0KNdcFgt1V3pTskeXpEtnQmI_kY-Gj32jpZCH2Zd2hORqjCTNzpmv7QN-Cm5OyK1Jqnzvws8"],[1,"https://lh3.googleusercontent.com/pkqGHj8KuI0SapcCv6UtNUnu1GeTuxuNZXWKZyxIsAMX4THTWuSYUqBMqN5giw9-oWJbnKhGyjvmCc1DllKywV-1Xw"],[1,"https://lh3.googleusercontent.com/wll0xqWOtjWrRC-qGvt-h88eSub5QSzC4eccXkcrEP3-LPaKEQJmmMYcA15sto1YULSRo01xsx5wQB7JQocebkW2yA"],[1,"https://lh3.googleusercontent.com/EumOmVjhvOrzDAxZfWzAHMU1kFp8CWPwMEibpx_M1zSthloLirMV78hZLsNJZY0nstDnI9DkZzj4eu8rucaWKdJXpQ"]],"Find the same product online instantly and shop smarter!\n\n🪄 Search by Image\nGoogle Lens Alternatives for shopping.Right-click any product image and instantly find identical or similar products across top online stores.\n🪄 Search any product by image\n\nRight-click an internet image to instantly find the same or similar products across online stores.\n\n🛒 Search across major shopping websites\n\nSearch products across leading marketplaces and retailers to find more accurate matches, compare prices, and discover better deals faster.\n\n🚀 Real-Time Shopping Search\n\nUnlike traditional product databases, Goodscouter searches shopping websites in real time to find the latest products, prices, and deals available right now.\n\n🎯 Find the same product across multiple stores\n\nGoodscouter helps you locate identical products and alternative sellers in seconds, making it easier to compare options before buying.\n\n💰 Compare prices instantly\n\nSee offers from different stores side by side and quickly identify better prices without switching between tabs.\n\n🛍️ Discover better deals and alternatives\n\nExplore similar products, alternative brands, and better-value options before making a purchase.\n\n⚡ Shop faster and smarter\n\nFrom electronics and fashion to home goods and trending products, Goodscouter helps you save time and avoid overpaying.\n\nStop searching store by store. Turn any image into a powerful shopping search and find the same product, better prices, and the best deals instantly.\nStop overpaying or searching store by store. With Goodscouter, you can search by image, compare prices, and find the best deals all in one place.\n\n# Permissions\n\nGoodscouter only requests the permissions required to read product information from supported pages and display comparison results inside the Chrome side panel.\n\n# Important Information\n\nGoodscouter helps users review publicly available product listings from supported websites. Product availability, pricing, shipping fees, taxes and seller information may change over time and should always be verified directly on the retailer's website before purchase.\n\nAll trademarks and brand names belong to their respective owners. Goodscouter is an independent tool and is not affiliated with or endorsed by any retailer or marketplace.\nLearn more at https://goodscouter.com",null,1,1,["support@goodscouter.com","上海市闵行区\n闵行区, 上海市 200001\nCN",null,null,null,"Ouch","Ouch","No",null,null,"ub844b03d9d7b97990493155488b8588c"],null,null,"1.5.10",[1786593293,779085000],"430KiB",["Deutsch","English","Indonesia","Tiếng Việt","Türkçe","español","français","italiano","português (Brasil)","العربية","हिन्दी","ไทย","中文（中国）","中文（台灣）","日本語","한국어"],null,null,null,null,1,[["lgmfmkikbckfgagdknfodkajfenphdgd","https://lh3.googleusercontent.com/sdUkL8v2EnIV8ByRDsnwkpp0rqfnQd17pXSGMUkq4IU91amEA9y6Mxf8dt8Aaqfh_CzfPULnb6D5bGCymOiN8MKatTU","Journal du Freenaute - Favoris",5,12,null,"Gérez vos articles favoris du Journal du Freenaute.","https://www.journaldufreenaute.fr/",1,null,null,["productivity/tools",null,5],1,null,24,1,null,[1765632306,703918000],"{\n\"update_url\": \"https://clients2.google.com/service/update2/crx\",\n\n  \"manifest_version\": 3,\n  \"name\": \"Journal du Freenaute - Favoris\",\n  \"version\": \"1.0\",\n  \"description\": \"Gérez vos articles favoris du Journal du Freenaute.\",\n  \"action\": {\n    \"default_popup\": \"popup.html\",\n    \"default_icon\": {\n      \"16\": \"icons/icon16.png\",\n      \"48\": \"icons/icon48.png\",\n      \"128\": \"icons/icon128.png\"\n    }\n  },\n  \"permissions\": [\n    \"storage\",\n    \"activeTab\"\n  ],\n  \"host_permissions\": [\n    \"https://www.journaldufreenaute.fr/*\"\n  ],\n  \"icons\": {\n    \"16\": \"icons/icon16.png\",\n    \"48\": \"icons/icon48.png\",\n    \"128\": \"icons/icon128.png\"\n  }\n}","Journal du Freenaute - Favoris"],["omnpknjnfgngpdoanodjfnhfdbokjckl","https://lh3.googleusercontent.com/ir6RQCZyFzLXzHWreQsI6zHYa_b8br33vLasmveXajI61EOjSL9W5Gkxb4EO9krUz0Ebid1TefjqImKu3eNNim330A","Wordara - Smarter Prompts And Writing",4.875,24,null,"Simplify your AI prompts with one click using advanced AI optimization",null,null,null,null,["productivity/communication",null,3],1,null,74,null,null,[1760593895,988957000],"{\n\"update_url\": \"https://clients2.google.com/service/update2/crx\",\n\n  \"manifest_version\": 3,\n  \"name\": \"Wordara - Smarter Prompts And Writing\",\n  \"version\": \"1.5.0\",\n  \"description\": \"Simplify your AI prompts with one click using advanced AI optimization\",\n  \"permissions\": [\n    \"storage\",\n    \"scripting\",\n    \"tabs\",\n    \"contextMenus\"\n  ],\n  \"host_permissions\": [\n    \"\u003call_urls\u003e\"\n  ],\n  \"background\": {\n    \"service_worker\": \"background.js\"\n  },\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"\u003call_urls\u003e\"\n      ],\n      \"js\": [\n        \"content.js\",\n        \"content-ui.js\",\n        \"content-ask.js\"\n      ],\n      \"css\": [\n        \"content.css\"\n      ],\n      \"run_at\": \"document_start\",\n      \"all_frames\": true,\n      \"match_about_blank\": true\n    },\n    {\n      \"matches\": [\n        \"https://wordara.cc/*\"\n      ],\n      \"js\": [\n        \"dashboard-sync.js\"\n      ],\n     