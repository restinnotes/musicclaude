                        <div class="emer-sample-modal__input-wrap">
                            <svg class="emer-sample-modal__input-icon" width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="5" r="2.5" stroke="currentColor" stroke-width="1.2"/><path d="M2 12c0-2.5 2-4 5-4s5 1.5 5 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                            <input type="text" id="emerSampleName" name="name" class="emer-sample-modal__input" placeholder="Sarah Johnson" required>
