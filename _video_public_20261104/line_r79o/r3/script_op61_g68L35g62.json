 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "熟悉的旧日生活已经不能再自然地照旧延续，我和它正渐渐拉开距离",
       "keys": [
        "正渐渐拉开距离"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "心里压着一份郑重的牵挂，却暂时找不到落点",
       "keys": [
        "暂时找不到落点"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "失落和不安还没有清楚的名字，眼前的处境也显得模糊，身体里有一种说不明的紧缩感",
       "keys": [
        "失落和不安还没有清楚的名字"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉中醒来，四周又冷又空，胸口发紧、伸手只摸到空处",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "熟悉的过去偶尔短暂变得鲜明，带来亲近，也同时显出距离",
       "keys": [
        "带来亲近，也同时显出距离"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "脑子还没想清楚，身体先隐约记起了怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "我努力维持体面，不愿为了保留那份亲近而先委屈自己",
       "keys": [
        "不愿为了保留那份亲近而先委屈自己"
       ],
       "from": [
        "S01-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "强撑着提醒自己不能倒下，可心里其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我仍珍惜曾经不必费力就能拥有的归属感",
       "keys": [
        "不必费力就能拥有的归属感"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "想起那种熟悉生活时，亲近和距离感总会一起出现",
       "keys": [
        "亲近和距离感总会一起出现"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我尽量保持端正和自持，可内里的支撑并不稳",
       "keys": [
        "内里的支撑并不稳"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像腿脚发虚的人，还在记忆里勉强挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "呼吸像被催着一样，变得越来越急促",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "像整理好衣服抬起头，不让人看出自己动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "我一再安慰自己还能撑住，不愿就这样被眼前的处境压倒",
       "keys": [
        "不愿就这样被眼前的处境压倒"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "哪怕心里还在难受，也不甘心就这样垮下去",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可这些自我说服并不能真正盖住在意",
       "keys": [
        "并不能真正盖住在意"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "一遍遍对自己说没事，说到后来反倒露出了自己有多在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "熟悉的感觉忽然变得温柔而亲近，我短暂轻松下来",
