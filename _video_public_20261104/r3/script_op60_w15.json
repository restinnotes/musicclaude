 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我忽然发现自己很想靠近对方，心里一热，连自己都意外。",
       "keys": [],
       "from": [
        "S01-1"
       ]
      },
      {
       "text": "",
       "keys": [],
       "from": [
        "S01-2",
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "烟花迸开",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
      },
      {
       "text": "一瞬失重",
       "keys": [],
       "from": [
        "S01-B2-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我怕对方看出我有多需要这份亲近、觉得负担太重，所以只敢露出一点喜欢；可这点亲近已让我觉得甜，我仍拿不准下次能否更坦白。",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "一说出口就变了",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      },
      {
       "text": "越清楚越谨慎",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没因我露出一点在意而退开，仍亲近我，我才渐渐放松下来。",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "呼吸贴在一起",
       "keys": [],
       "from": [
        "S02-B1-p1"
       ],
       "emotion": "亲密"
      },
      {
       "text": "沉默也舒服",
       "keys": [],
       "from": [
        "S02-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我也顺势想靠近些，喜欢几乎藏不住，却怕太急破坏眼下的自在，还是收住了。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "喜欢忽然涌上来",
       "keys": [],
       "from": [
        "S02-B3-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "轻轻吐口气",
       "keys": [],
       "from": [
        "S02-B3-p2"
       ],
       "emotion": "安心"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "和对方待在一起这么好，我却想到这样的时刻总会过去，还没分开就先舍不得。",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "甜得发酸",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ],
       "emotion": "亲密"
      },
      {
       "text": "还没分开就舍不得",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ],
       "emotion": "亲密"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我难得不去想我们以后会怎样，只想舒服地待在这份亲近里。",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体晃着漂着",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "不必赶去哪里",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "中间我忽然想告诉对方多喜欢这样的相处，也想问对方是不是一样，可还没想好怎么开口，念头就淡了。",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急着说一句",
       "keys": [],
       "from": [
        "S03-B2-p1"
       ]
      },
      {
       "text": "又沉回去",
       "keys": [],
       "from": [
        "S03-B2-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "熟悉的亲近又让我欢喜，也让我想起上回明明想告诉对方却没开口。",
       "keys": [],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "耳边低语",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      },
      {
       "text": "忍不住再说一遍",
       "keys": [],
       "from": [
        "S04-B1-p6"
       ]
      }
     ]
    },
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "我几乎想把藏着的话全告诉对方，也盼对方喜欢我不再小心收着的样子。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "话哽在喉咙",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "水波推着往前",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "抱紧不愿松手",
       "keys": [],
       "from": [
        "S04-B3-p3"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我盼着说出来能让眼下的好留久一点，却怕说得太多让对方为难、弄丢原有的自在，最后还是留了些话没说。",
       "keys": [],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "每一秒都在倒数",
       "keys": [],
       "from": [
        "S04-B4-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "前几次我想说又收住，对方却一直愿意亲近我，这回我便不知不觉忘了藏好喜欢，察觉时，对方已看出我有多在乎。",
       "keys": [],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "攥紧的劲退了",
       "keys": [],
       "from": [
        "S05-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "先前藏着时，我还能装作没那么在乎；如今被看出来，我心里空落落，连怎么相处都拿不准，便怕对方嫌我黏，熟悉的亲近也像隔了一层。",
       "keys": [],
       "from": [
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "脚下没了支撑",
       "keys": [],
       "from": [
        "S05-B2-p3"
       ]
      },
      {
       "text": "退回自己心里",
       "keys": [],
       "from": [
        "S05-B3-p2"
       ]
      },
      {
       "text": "这幸福是真的吗？",
       "keys": [],
       "from": [
        "S05-B3-p3"
       ],
       "emotion": "悬着"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这回对方看出我有多在乎，跟我相处却一点没变，我才又能像从前一样自在。",
       "keys": [],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "摇摆又回来",
       "keys": [],
       "from": [
        "S06-B1-p2"
       ]
      },
      {
       "text": "想起第一次心动",
       "keys": [],
       "from": [
        "S06-B1-p5"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "安静下来，我想到对方不知道我刚才有多怕被嫌弃，忽然觉得孤单。",
       "keys": [],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "没人能陪到心底",
       "keys": [],
       "from": [
        "S06-B3-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我忍不住想，对方既然一直没有退开，会不会也有点舍不得结束这份亲近？",
       "keys": [],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的气味",
       "keys": [],
       "from": [
        "S06-B4-p2"
       ]
      },
      {
       "text": "幻想和遗憾混在一起",
       "keys": [],
       "from": [
        "S06-B4-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想到这些日子对方总愿意和我待在一起，我渐渐觉得，对方或许有时也需要我陪着，和我待着也安心些。",
       "keys": [],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "脉搏沉沉地跳",
       "keys": [],
       "from": [
        "S07-B1-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "渴望往上涌",
       "keys": [],
       "from": [
        "S07-B1-p2"
       ],
       "emotion": "炽热"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "这念头让我高兴得收不住，越想着我们这样亲近，越舍不得从欢喜里抽身。",
       "keys": [],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2-p5"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我盼着以后对方想找人陪时还会想到我，我也能一直陪在对方身边。",
       "keys": [],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "这一刻留不住",
       "keys": [],
       "from": [
        "S07-B3-p3"
       ],
       "emotion": "孤单"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到对方也许也需要我陪，上回无意间露了心意，这回见对方仍亲近，我想主动些、大方回应；想着想着，也开始盼我们能这样好很久。",
       "keys": [],
       "from": [
        "S08-1",
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不再防着",
       "keys": [],
       "from": [
        "S08-B1-p2"
       ],
       "emotion": "安心"
      },
      {
       "text": "不再分析",
       "keys": [],
       "from": [
        "S08-B1-p2"
       ],
       "emotion": "安心"
      },
      {
       "text": "身体轻快",
       "keys": [],
       "from": [
        "S08-B2-p2"
       ]
      },
      {
       "text": "你来我往地逗趣",
       "keys": [],
       "from": [
        "S08-B2-p3"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可我又想到，今天这样好不代表以后每天都能这样，心里顿时没了底。",
       "keys": [],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "快乐余温还在",
       "keys": [],
       "from": [
        "S08-B3-p3"
       ],
       "emotion": "欢喜"
      },
      {
       "text": "心里泛起怀念",
       "keys": [],
       "from": [
        "S08-B3-p3"
       ],
       "emotion": "孤单"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "那点没底越来越具体：要是哪天对方不再需要我陪，连跟我待在一起也不愿意呢？想到这儿，我一下安静下来，刚才还敢盼那么远，这会儿却不敢再想。",
       "keys": [],
       "from": [
        "S09-1",
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "对视时屏住呼吸",
       "keys": [],
       "from": [
        "S09-B1-p4"
       ]
      },
      {
       "text": "渴望还在",
       "keys": [],
       "from": [
        "S09-B1-p4"
       ]
      },
      {
       "text": "那股劲还绷着",
       "keys": [],
       "from": [
        "S09-B1-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可我想起对方一直没退开，眼下仍和我亲近，这是真的；也许对方也喜欢我陪着，我还是有点高兴。",
       "keys": [],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "眼前还有别的美好",
       "keys": [],
       "from": [
        "S09-B4-p1"
       ],
       "emotion": "欢喜"
      },
      {
       "text": "不安暂时退到一旁",
       "keys": [],
       "from": [
        "S09-B4-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我怕再猜下去连今天也过不踏实，便先不想以后，享受眼前的亲近；紧绷这才慢慢松开，心里亮堂得几乎想笑，也有点想哭。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "眼泪不用忍",
       "keys": [],
       "from": [
        "S10-B1-p2"
       ]
      },
      {
       "text": "心事还没解决",
       "keys": [],
       "from": [
        "S10-B1-p3"
       ],
       "emotion": "不安"
      },
      {
       "text": "明亮得想哭",
       "keys": [],
       "from": [
        "S10-B1-p4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "轻松过去后，我忽然想，即使以后对方有时不需要我陪，我也还是愿意陪在身边，不想再藏起喜欢；这念头让我高兴得顾不上害臊，也觉得这么在乎对方没什么不好。",
       "keys": [],
       "from": [
        "S11-1",
        "S11-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "这是我的感情",
       "keys": [],
       "from": [
        "S11-B1-p3"
       ]
      },
      {
       "text": "不再为喜欢道歉",
       "keys": [],
       "from": [
        "S11-B1-p3"
       ]
      },
      {
       "text": "熟悉的温柔又回来",
       "keys": [],
       "from": [
        "S11-B2-p3"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可我愿意一直陪着，对方以后愿不愿意却不是我能决定的，一想到这点，刚才的欢喜就压得我心口发疼。",
       "keys": [],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "胸口压得发痛",
       "keys": [],
       "from": [
        "S11-B4-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "我现在只想把能给的都给对方，顾不上想对方会不会同样在乎我。",
       "keys": [],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里的话一下放大",
       "keys": [],
       "from": [
        "S12-B1-p2"
       ]
      },
      {
       "text": "暂时顾不上自己",
       "keys": [],
       "from": [
        "S12-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可我明知再用心也不能保证以后还会这么好，还是嫌这样的日子不够，想多陪对方一会儿。",
