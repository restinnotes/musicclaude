{
 "uniform": true,
 "sections": [
  {
   "sec": "S01",
   "rows": [
    {
     "kind": "line",
     "text": "他终于离开熟悉的生活",
     "keys": [
      "终于离开"
     ],
     "emotion": "安心",
     "from": [
      "S01-1"
     ]
    },
    {
     "kind": "line",
     "text": "起初觉得不用再委屈自己",
     "keys": [
      "不用再委屈自己"
     ],
     "emotion": "安心",
     "from": [
      "S01-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像逼自己挺直背脊，心里却想停下",
       "bead": "S01-B2",
       "from": [
        "S01-B2"
       ],
       "bars": "1–23"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可那份笃定很快散了",
     "keys": [
      "很快散了"
     ],
     "emotion": "不安",
     "from": [
      "S01-2",
      "S01-B2"
     ]
    },
    {
     "kind": "line",
     "text": "他心里空落落的",
     "keys": [
      "空落落"
     ],
     "emotion": "孤单",
     "from": [
      "S01-2",
      "S01-B3",
      "S01-B4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "他分不清是愤怒、遗憾还是怀念",
       "bead": "S01-B3",
       "from": [
        "S01-B3"
       ],
       "bars": "1–23"
      },
      {
       "text": "像从昏沉里醒来，四周冷空，视线模糊",
       "bead": "S01-B4",
       "from": [
        "S01-B4"
       ],
       "bars": "1–23"
      },
      {
       "text": "胸口发紧，伸手却只摸到虚空",
       "bead": "S01-B4",
       "from": [
        "S01-B4"
       ],
       "bars": "1–23"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想往前走却不知靠什么安心",
     "keys": [
      "不知靠什么安心"
     ],
     "emotion": "悬着",
     "from": [
      "S01-3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "旧日声音和光线回来，却回不到现在",
       "bead": "S01-B5",
       "from": [
        "S01-B5"
       ],
       "bars": "9–17"
      },
      {
       "text": "身体仿佛先记起该怎么迈步",
       "bead": "S01-B5",
       "from": [
        "S01-B5"
       ],
       "bars": "18–23"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "重和弦像一次召唤，随后声音向高处散开",
     "bars": "1–6",
     "from": [
      "S01-B1"
     ]
    },
    {
     "text": "短句刚冒出就被长停顿截断",
     "bars": "1–23",
     "from": [
      "S01-B3"
     ]
    },
    {
     "text": "余音在冰冷空气里慢慢散尽",
     "bars": "1–23",
     "from": [
      "S01-B3"
     ]
    },
    {
     "text": "旋律轮廓渐清，波兰舞步逐渐浮现",
     "bars": "9–17；18–23",
     "from": [
      "S01-B5"
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "rows": [
    {
     "kind": "line",
     "text": "他舍不得从前自在的日子",
     "keys": [
      "自在的日子"
     ],
     "emotion": "亲密",
     "from": [
      "S02-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像远处传来一首熟悉的旧歌",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24–65"
      },
      {
       "text": "庄严的舞步里，藏着私下的哼唱",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24–65"
      },
      {
       "text": "珍惜的东西还在，却不能再拥有",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想到以后不能那样过就心慌",
     "keys": [
      "就心慌"
     ],
     "emotion": "不安",
     "from": [
      "S02-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像腿脚发虚的人，在记忆里挪步",
       "bead": "S02-B2",
       "from": [
        "S02-B2"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他赶紧提醒自己受过的气",
     "keys": [
      "受过的气"
     ],
     "emotion": "炽热",
     "from": [
      "S02-2"
     ]
    },
    {
     "kind": "line",
     "text": "他怕一心软就忘了为何离开",
     "keys": [
      "为何离开"
     ],
     "emotion": "不安",
     "from": [
      "S02-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "他抬头说没事，起初真信后来露出在意",
       "bead": "S02-B4",
       "from": [
        "S02-B4"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他不甘心连好日子也要丢掉",
     "keys": [
      "不甘心"
     ],
     "emotion": "炽热",
     "from": [
      "S02-3",
      "S02-B5"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像在说：我不甘心就这样消亡",
       "bead": "S02-B5",
       "from": [
        "S02-B5"
       ],
       "bars": "44–65"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "舞步庄严，歌声脆弱，底下有细碎的不安",
     "bars": "24–65",
     "from": [
      "S02-B2"
     ]
    },
    {
     "text": "声音猛地上推又退下，随后再次聚拢",
     "bars": "38–43；44–65",
     "from": [
      "S02-B3"
     ]
    },
    {
     "text": "后半段的小音符越来越密，呼吸被催急",
     "bars": "52–65",
     "from": [
      "S02-B3"
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "rows": [
    {
     "kind": "line",
     "text": "他心里还憋着一股气",
     "keys": [
      "憋着一股气"
     ],
     "emotion": "炽热",
     "from": [
      "S03-1",
      "S03-B1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "想往前走，却拿不定方向",
       "bead": "S03-B1",
       "from": [
        "S03-B1"
       ],
       "bars": "66–91"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想起被当作自己人他又高兴了",
     "keys": [
      "自己人"
     ],
     "emotion": "亲密",
     "from": [
      "S03-1",
      "S03-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像故乡夏日麦浪，也像微风轻拂",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "80–91"
      },
      {
       "text": "想起从前不必防备，心里又暖又痛",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "80–91"
      }
     ]
    },
    {
     "kind": "line",
     "text": "旧日过不成了离开后会更好吗？",
     "keys": [
      "会更好吗"
     ],
     "emotion": "悬着",
     "from": [
      "S03-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像暂时聊点别的，轻松是真的",
       "bead": "S03-B3",
       "from": [
        "S03-B3"
       ],
       "bars": "66–91"
      },
      {
       "text": "他又问，刚才真的相信那些话吗",
       "bead": "S03-B5",
       "from": [
        "S03-B5"
       ],
       "bars": "66–91"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "重和弦若突出，会像重锤砸下",
     "bars": "66",
     "from": [
      "S03-B1"
     ]
    },
    {
     "text": "前半段焦躁急切，后半段转为柔和田园",
     "bars": "66–91",
     "from": [
      "S03-B2"
     ]
    },
    {
     "text": "多条声音像低声絮语，重心像流沙漂移",
     "bars": "66–91",
     "from": [
      "S03-B4"
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "rows": [
    {
     "kind": "line",
     "text": "他真盼着还能那样亲近",
     "keys": [
      "真盼着"
     ],
     "emotion": "亲密",
     "from": [
      "S04-1",
      "S04-B1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "回忆里有感激、亲近和短暂幸福",
       "bead": "S04-B1",
       "from": [
        "S04-B1"
       ],
       "bars": "92–107"
      },
      {
       "text": "那份坚定，或许只是他想成为的样子",
       "bead": "S04-B1",
       "from": [
        "S04-B1"
       ],
       "bars": "92–107"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可当初受的委屈又翻上来",
     "keys": [
      "委屈又翻上来"
     ],
     "emotion": "不安",
     "from": [
      "S04-2",
      "S04-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "记忆太好了，反而刺痛他",
       "bead": "S04-B2",
       "from": [
        "S04-B2"
       ],
       "bars": "108–115"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他反复问那一步走得对不对",
     "keys": [
      "走得对不对"
     ],
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "他不停往前赶，只为不让自己停下来",
       "bead": "S04-B4",
       "from": [
        "S04-B4"
       ],
       "bars": "94–115"
      }
     ]
    },
    {
     "kind": "line",
     "text": "没走的话如今又会怎样？",
     "keys": [
      "又会怎样"
     ],
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ]
    }
   ],
   "notes": [
    {
     "text": "熟悉的舞曲主题重新出现，变得更抒情",
     "bars": "92–107",
     "from": [
      "S04-B1"
     ]
    },
    {
     "text": "温暖忽然转为风暴般紧绷",
     "bars": "108–115",
     "from": [
      "S04-B2"
     ]
    },
    {
     "text": "下行声音带着撕扯般的后退",
     "bars": "108–115",
     "from": [
      "S04-B2"
     ]
    },
    {
     "text": "细碎声音像急促脚步，心跳也乱了拍",
     "bars": "92–115",
     "from": [
      "S04-B3"
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "rows": [
    {
     "kind": "line",
     "text": "他觉得当初那些气不该忍",
     "keys": [
      "不该忍"
     ],
     "emotion": "炽热",
     "from": [
      "S05-1",
      "S05-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "里面有愤怒和悲伤，也有护住自己的劲",
       "bead": "S05-B2",
       "from": [
        "S05-B2"
       ],
       "bars": "116–127"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可他不想连开心回忆都躲着",
     "keys": [
      "开心回忆"
     ],
     "emotion": "亲密",
     "from": [
      "S05-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像夜色里两个影子，彼此低声说话",
       "bead": "S05-B1",
       "from": [
        "S05-B1"
       ],
       "bars": "116–147"
      }
     ]
    },
    {
     "kind": "line",
     "text": "跟自己争得渐渐没了力气",
     "keys": [
      "没了力气"
     ],
     "emotion": "孤单",
     "from": [
      "S05-2",
      "S05-B5"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像几次深呼吸，紧绷暂时松开",
       "bead": "S05-B5",
       "from": [
        "S05-B5"
       ],
       "bars": "144–147"
      },
      {
       "text": "这一下松动，更像是抵抗累了",
       "bead": "S05-B5",
       "from": [
        "S05-B5"
       ],
       "bars": "144–147"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想到如今不在他们身边就难受",
     "keys": [
      "不在他们身边"
     ],
     "emotion": "孤单",
     "from": [
      "S05-2",
      "S05-B3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像某个人，也像故乡或过去的生活",
       "bead": "S05-B3",
       "from": [
        "S05-B3"
       ],
       "bars": "116–147"
      },
      {
       "text": "像脚下地板忽然不见，只剩一个声音",
       "bead": "S05-B4",
       "from": [
        "S05-B4"
       ],
       "bars": "128–147"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "歌唱忽然柔和亲近，语气仍然克制",
     "bars": "116–147",
     "from": [
      "S05-B1"
     ]
    },
    {
     "text": "快速流动渐渐稀疏，最后只剩疏落和弦",
     "bars": "128–147",
     "from": [
      "S05-B4"
     ]
    },
    {
     "text": "末尾声音变慢变疏，紧绷短暂松开",
     "bars": "144–147",
     "from": [
      "S05-B5"
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "rows": [
    {
     "kind": "line",
     "text": "他不再用受过的气压住想念",
     "keys": [],
     "emotion": "亲密",
     "from": [
      "S06-1",
      "S06-B1",
      "S06-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像隔着透明玻璃，也像母亲轻哼摇篮曲",
       "bead": "S06-B1",
       "from": [
        "S06-B1"
       ],
       "bars": "148–180"
      },
      {
       "text": "这份安宁不代表现实变好，也不能久留",
       "bead": "S06-B1",
       "from": [
        "S06-B1"
       ],
       "bars": "148–180"
      },
      {
       "text": "不用解释难过，也不用硬撑坚强",
       "bead": "S06-B2",
       "from": [
        "S06-B2"
       ],
       "bars": "148–180"
      },
      {
       "text": "压住的愿望和委屈终于浮上来",
       "bead": "S06-B2",
       "from": [
        "S06-B2"
       ],
       "bars": "148–180"
      }
     ]
    },
    {
     "kind": "line",
     "text": "如今才知道有人陪着有多轻松",
     "keys": [
      "有多轻松"
     ],
     "emotion": "安心",
     "from": [
      "S06-2",
      "S06-1"
     ]
    },
    {
     "kind": "line",
     "text": "他很想再过不用多说的亲近日子",
     "keys": [
      "不用多说的亲近"
     ],
     "emotion": "亲密",
     "from": [
      "S06-3"
     ]
    },
    {
     "kind": "line",
     "text": "又怕以后再也没有那样的日子",
     "keys": [
      "再也没有"
     ],
     "emotion": "不安",
     "from": [
      "S06-3",
      "S06-B2"
     ]
    },
    {
     "kind": "line",
     "text": "想起真真切切拥有过心里暖了些",
     "keys": [
      "心里暖了些"
     ],
     "emotion": "安心",
     "from": [
      "S06-4",
      "S06-B4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像向遥远处祈求，却不知会不会有回应",
       "bead": "S06-B2",
       "from": [
        "S06-B2"
       ],
       "bars": "148–180"
      },
      {
       "text": "远去的家园在梦里亮起，只能远远看着",
       "bead": "S06-B2",
       "from": [
        "S06-B2",
        "S06-B4"
       ],
       "bars": "148–180"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "庄严歌唱里像藏着私密念头",
     "bars": "148–180",
     "from": [
      "S06-B2"
     ]
    },
    {
     "text": "歌唱由试探渐渐展开，后段更迫切，末尾像话没说完",
     "bars": "148–180",
     "from": [
      "S06-B3"
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "rows": [
    {
     "kind": "line",
     "text": "甜梦忽然碎了身体先被惊醒",
     "keys": [
      "忽然碎了"
     ],
     "emotion": "不安",
     "from": [
      "S07-B1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像寒风吹开窗，后颈一凉脉搏急跳",
       "bead": "S07-B1",
       "from": [
        "S07-B1"
       ],
       "bars": "182附近"
      },
      {
       "text": "忽然换了场景，心里却未必好转",
       "bead": "S07-B2",
       "from": [
        "S07-B2"
       ],
       "bars": "182–197"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他怕以后遇上难事只能独自扛",
     "keys": [
      "只能独自扛"
     ],
     "emotion": "孤单",
     "from": [
      "S07-1",
      "S07-B3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "思绪不停翻转，想冲出去却找不到出口",
       "bead": "S07-B3",
       "from": [
        "S07-B3"
       ],
       "bars": "198–205"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他没想到离开后会这么孤单",
     "keys": [
      "这么孤单"
     ],
