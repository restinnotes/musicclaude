      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "242–253",
    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "方案已经提出，现在要看对方是否接受；他没有把要求改回原样，也没有退回只有临时参与的安排。",
      "key": "方案已经提出，现",
      "follows": false,
