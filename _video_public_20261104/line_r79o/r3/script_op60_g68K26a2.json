 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然心热，想靠近对方",
       "keys": [],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像烟花光点落下悬水上，也像踏船失重",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕给对方负担，只敢露一点喜欢",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像想很久的话到嘴边，沉默怕关系变样",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "这点亲近很甜，下次能否坦白难说",
       "keys": [],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没退开还愿意亲近，他才慢慢放松",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像贴肩耳语，呼吸和体温都挨在一起",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "熟人静坐也自在，夏末湿热的风黏在皮肤上",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "像心跳和水浪一下一下托着身体",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "放下重力舒服地漂着，水却一直流",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他想顺势靠近，喜欢得快藏不住",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "甜蜜里像有根软刺，眼前还好却已鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "像忍不住说得热切，随后轻轻呼出一口气",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕太急弄坏自在，他最后还是收住",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待得这么好，他还没分开就已舍不得",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他难得不想以后，只想安心待在亲近里",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像说完重要的话，还陶醉得有点走神",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "亲密后的沉默很舒服，心却慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想说有多喜欢，也想问对方是否一样",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像急着表达的念头露头，很快又沉下去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "倒影闪着却被风吹碎，谈话碰上解不开的结",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他没想好怎么开口，念头就淡了",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他欢喜，他想起上回没敢开口",
       "keys": [],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像两个人贴近耳语，越讲越急还忍不住补细节",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "这回他几乎想说出全部心意，也盼对方喜欢",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夕阳切出刺眼金光，亮得让人睁不开眼",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "想说深情却喉咙发颤，话到嘴边哽住",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他想把眼前的好留久些，却怕说太多让对方为难",
       "keys": [],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像握手时越握越紧，越想抱紧船越不稳",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "美好还在，却像每秒都在倒数",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "怕弄丢两人的自在，他最后还是留了些话",
       "keys": [],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "越美越舍不得，真想让这一刻慢些",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他无意露出喜欢，对方看出来后心里空落落",
       "keys": [],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像失去支撑，重要的话悬在雾里",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕被嫌太黏，连相处都没把握",
       "keys": [],
       "from": [
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉亲近忽然像隔层",
       "keys": [],
       "from": [
        "S05-3"
       ],
       "bead": "S05-3"
      },
      {
       "text": "幸福是真的吗，还能维持多久？",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他多在乎却没变，他才自在",
       "keys": [],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "金色水面滑进古桥阴影，像童年初恋的月光",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他还想靠近，却怕自己要得太多",
       "keys": [],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里说算了又放不下，像忘了有人看着",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "对方不知道他刚才多怕被嫌弃",
       "keys": [],
       "from": [
        "S06-2"
       ],
       "bead": "S06-2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他孤单地猜，对方会不会也舍不得结束",
       "keys": [],
       "from": [
        "S06-2",
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "独处放大酸楚，亲近的人也进不了心底",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "美好时光还在，恍惚却像已成回忆",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "欲望没退潮，气味身体幻想遗憾快感混杂得让人迷失",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他觉得对方或许也需要自己陪着",
       "keys": [],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到能互相依靠，他高兴得有点收不住",
       "keys": [],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "安静享受已不够，情欲和执念连着对活着的眷恋一起涌来",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "回想时气味和身体感觉涌进幻想，遗憾也带着快感",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "明知自己正被卷进去，舒服得暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "越舒服越容易失去方向",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "心里忽然一紧，他仍想这样待下去",
       "keys": [],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "美好还在却留不住，时间仍在往前",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他盼对方以后想找人时想到自己，自己也能一直陪着",
       "keys": [],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "上回无意露了心意，这回见对方依然亲近",
       "keys": [],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想主动些，大大方方地回应",
       "keys": [],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像不再分析防备，终于能直接说喜欢",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "像重新晒到阳光和风，身体也恢复弹性",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      },
      {
       "text": "这份轻盈还带一点调情的玩心",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他开始盼着往后，两个人或许还能好很久",
       "keys": [],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可眼下的亲近，未必以后也会有",
       "keys": [],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "快乐余温还在，心头已泛起怀念",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方有天不再需要他",
       "keys": [],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "想到对方或许不自在，他安静了",
       "keys": [],
       "from": [
        "S09-1",
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像对视到呼吸停住，渴望仍绷着",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "阳光隔着薄雾，光还在却暗下来",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      },
      {
       "text": "听着自己的余响，问刚才是真的吗",
       "keys": [],
       "from": [
        "S09-B3"
       ],
       "bead": "S09-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可对方一直没退开，两人仍亲近",
       "keys": [],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "夜空让愿望显小，不安仍在却不再占满心",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "也许对方喜欢他在身边，他高兴了",
       "keys": [],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不再猜往后怎样，先享受眼前亲近",
       "keys": [],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "清风拨开水浪，时间短暂松开",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "只是一口气，不能一直躲进去",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "紧绷慢慢松开，心里亮得想笑又想哭",
       "keys": [],
       "from": [
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "胸口打开，眼泪终于不用忍",
       "keys": [],
       "from": [
