    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不再猜以后，先好好享受眼前的亲近。",
       "keys": [
        "不再猜以后",
        "享受眼前的亲近"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波忽然拨开，时间松出一小块空地",
