       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "以后再遇上难事，要还是只能一个人顶着，他真的撑得住吗？",
