     "from": [
      "S11-B2"
     ],
     "pt": "",
     "bars": "92"
    }
   ]
  },
  {
   "sec": "S12",
   "big": [
    {
     "text": "他顾不上对方是否同样在乎，只想把能给的都给对方",
