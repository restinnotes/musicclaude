": \"\",\n          \"keep\": \"刚有点安心，他却猛然想到\"\n        },\n        {\n          \"text\": \"当初走时他只想着\",\n          \"point\": \"早知道这样，自己还会走吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没料到会这么孤单\"\n        },\n        {\n          \"text\": \"他想找回从前那份亲近\",\n          \"point\": \"连当初走时那股决心也找不着了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又不甘心回去再受那些气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一眼里有温柔，也有不舍。\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只是瞬间的喘息，并不等于整个人重新安顿下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不等于重新安顿\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他暂时把回不回去的事放到一边\",\n          \"point\": \"心里又暖和了一会儿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"暂时把回不回去的事放到一边\"\n        },\n        {\n          \"text\": \"可那点暖意很快就淡了\",\n          \"point\": \"回忆没法陪着他\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"可那点暖意很快就淡了\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"开头沉重的引子从中阴冷地闪现回来，却不再像最初那样郑重召唤。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"开头引子阴冷地回来\"\n        },\n        {\n          \"quote\": \"只是这一次，你已经知道那个过去的自己经历过什么。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"这次已知道他经历过什么\"\n        },\n        {\n  