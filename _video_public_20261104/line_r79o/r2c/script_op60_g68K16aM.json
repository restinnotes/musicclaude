 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近，心里一下热起来。",
       "keys": [
        "那么想靠近",
        "心里一下热起来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夏夜威尼斯上空升起一束烟花",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "光点仿佛缓缓飘落，仍悬在水面上方",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕对方觉得负担太重，他只敢露出一点喜欢；这么一点亲近已很甜，下次能不能更坦白？",
       "keys": [
        "负担太重",
        "更坦白"
       ],
       "from": [
        "S01-2",
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "对方没有因他露出在意就退开，仍愿跟他亲近；两人挨得很近，像耳语时肩膀相贴，连呼吸都贴在一起，体温也仿佛融在一处；沉默也不让人紧张，他才慢慢放松。",
       "keys": [
        "仍愿跟他亲近",
        "肩膀相贴"
       ],
       "from": [
        "S02-1",
        "S02-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "船底仿佛温柔地托着身体",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "暂时不急着靠岸，水却一直在流，时间也一直在走",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "几次柔软的落音，像一根温柔的刺",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "听起来还没失去，就先鼻酸、舍不得",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠近，喜欢得几乎藏不住；可怕太急弄坏眼下的自在，还是收住了。",
       "keys": [
        "喜欢得几乎藏不住",
        "还是收住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "听起来热切得连呼吸都仿佛变了",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "随后又像轻轻呼出一口气",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待在一起这么好，他却想到这样的时刻总会过去，还没分开就先有一点舍不得。",
       "keys": [
        "这样的时刻总会过去",
        "一点舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不琢磨往后怎样，只想舒服地待在亲近里；像说过一句重要的话，还陶醉地停在余韵中，身体仿佛被水波托着。",
       "keys": [
        "不琢磨往后怎样",
        "水波托着"
       ],
       "from": [
        "S03-1",
        "S03-B1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想说有多喜欢，也想问对方是否一样；没想好怎么开口，念头就淡了。",
       "keys": [
        "想说有多喜欢",
        "是否一样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像有个念头急着表达，刚露头就沉回去，没有变成倾诉",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "思绪像被风吹碎的倒影，闪着却拼不完整",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "听起来顺畅里生出阻力，还没到悲剧",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他满心欢喜；他想起上回明明想告诉对方，却没有开口。",
       "keys": [
        "满心欢喜",
        "没有开口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想把藏着的话全说出来，盼着对方也喜欢他不再小心收着的样子。",
       "keys": [
        "全说出来",
        "不再小心收着"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他盼着说出来能把眼下的好留久一点；水波却仿佛每一秒都在倒数，还没失去什么，就已经舍不得了。",
       "keys": [
        "留久一点",
        "每一秒都在倒数"
       ],
       "from": [
        "S04-3",
        "S04-B4"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可他又怕说得太多让对方为难，连两个人原有的自在也弄丢，最后还是留了些话没说。",
       "keys": [
        "对方为难",
        "留了些话没说"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夕阳在水面切出的最后一道金光，亮得几乎刺眼",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "想说出口的情意，仿佛在喉咙口颤抖、哽咽",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "一种触感，像轻轻握着另一个人的手，不知不觉握紧",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "前几次想说又收住，对方一直愿意亲近；这回他无意间露出在乎，等察觉时，对方看出来了。",
       "keys": [
        "无意间露出在乎",
        "对方看出来了"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "先前还能装作没那么在乎，如今心里空落落，连怎么相处都拿不准；怕对方嫌他太黏，熟悉的亲近也像隔了一层；小船仿佛漂进雾里。",
       "keys": [
        "心里空落落",
        "怕对方嫌他太黏"
       ],
       "from": [
        "S05-2",
        "S05-3",
        "S05-B1"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这回对方看出他有多在乎，跟他相处却一点没变，他才又能像从前那样自在。",
       "keys": [
        "看出他有多在乎",
        "像从前那样自在"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "光线仿佛从暖金色水面滑入古桥阴影",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "空气一下凉了，像清凉、空灵的月光",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "安静时，他还想靠近，又怕要得太多；这份低声仿佛有个念头又回来：“算了”“但还是放不下”。",
       "keys": [
        "还想靠近",
        "但还是放不下"
       ],
       "from": [
        "S06-2",
        "S06-B2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "对方不知道他刚才多怕被嫌弃，他有点孤单。",
       "keys": [
        "多怕被嫌弃",
        "有点孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "也像说着说着忘了有人在看",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "不是哭泣或崩溃，只是不再努力显得完整",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "像白天相处得很好，夜里回家后，心头却泛起酸楚",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "仿佛再亲密的人，也没法陪你走进心里的每个角落",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想起这些日子对方总愿意陪他，他渐渐觉得，对方也许有时也需要他陪，跟他在一起也能安心些；这份热度像执念与对生的眷恋，从心底一齐翻涌，推着身体往前。",
       "keys": [
        "也许有时也需要他陪",
        "执念与对生的眷恋"
       ],
       "from": [
        "S07-1",
        "S07-B1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到两个人也许能互相依靠，他高兴得有点收不住，心里忽然一紧，却还想这样待着。",
       "keys": [
        "互相依靠",
        "心里忽然一紧"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "有一点情色性的暖意，像独处时反复回想一段关系",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "像气味、身体感觉、幻想、遗憾和快感混在一起；越舒服越失去方向，明知自己被卷进去，却暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他真盼着往后对方想找人陪时还会想到自己，自己也能一直陪着；眼前再好，也没法让时间停住。",
       "keys": [
        "想找人陪时",
        "没法让时间停住"
       ],
       "from": [
        "S07-3",
        "S07-B3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "上回无意间露了心意，这回见对方依然亲近，他想主动些、大大方方回应；这份心情听起来明亮轻盈，像重新接触阳光和风，身体也仿佛恢复弹性，带一点玩心。",
       "keys": [
        "大大方方回应",
        "重新接触阳光和风"
       ],
       "from": [
        "S08-1",
        "S08-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "听感里没有哲学，没有防卫，没有分析",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "这样想着，他连往后的日子都开始盼，觉得两个人说不定还能好很久；可眼下两人都愿意亲近，以后未必如此，他心里没底。",
       "keys": [
        "往后的日子都开始盼",
        "心里没底"
       ],
       "from": [
        "S08-2",
        "S08-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声仿佛向上散开、蒸发",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      },
      {
       "text": "忽然停住，快乐余温里泛起怀念",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "那点没底越来越具体：要是哪天对方不再需要他陪，连和他待着都不自在了呢？",
       "keys": [
        "越来越具体",
        "不自在了呢"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他一下安静了，刚才还敢盼那么远，现在却不敢再往下想；像在听刚才说过的话的余响，心里仿佛问：“刚才那是真的吗？接下来怎么办？”",
       "keys": [
        "一下安静了",
        "接下来怎么办"
       ],
       "from": [
        "S09-2",
        "S09-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话说到要紧处一下顿住",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "那股渴望还在，却仿佛引而不发",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他想起对方一直没退开，两人眼下还亲近，这些都是真的；也许对方也喜欢他在身边，他有点高兴。",
       "keys": [
        "这些都是真的",
        "有点高兴"
       ],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "再猜下去，连今天也过不踏实；他暂时不管往后怎样，先享受眼前的亲近。这份停歇像清风拨开水波，时间里短暂开出一小块空地，不能永远躲进去。",
       "keys": [
        "连今天也过不踏实",
        "一小块空地"
       ],
       "from": [
        "S10-1",
        "S10-B2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "先前的紧绷慢慢松开，像绷着肩的人终于长长呼出一口气，胸腔打开，眼泪也不必再忍；心里亮得几乎想笑，又有点想哭。",
       "keys": [
        "长长呼出一口气",
        "有点想哭"
       ],
       "from": [
        "S10-2",
        "S10-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "细亮的小音符像晨曦里的银色蛛丝",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      },
      {
       "text": "又像从天上飘下的细雨",
       "keys": [],
       "from": [
        "S10-B4"
       ],
