{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他已经离开熟悉生活",
     "accent": "离开",
     "emotion": "孤单",
     "from": [
      "S01-1"
     ]
    },
    {
     "text": "起初他觉得总算不用再委屈自己",
     "accent": "不用再委屈自己",
     "emotion": "安心",
     "from": [
      "S01-1"
     ]
    },
    {
     "text": "心里空了却说不清舍不得什么",
     "accent": "说不清",
     "emotion": "悬着",
     "from": [
      "S01-2"
     ]
    },
    {
     "text": "他仍想往前过却不知怎样安心",
     "accent": "不知怎样安心",
     "emotion": "不安",
     "from": [
      "S01-3"
     ]
    },
    {
     "text": "像刚醒来四周冷而空",
     "accent": "冷而空",
     "emotion": "孤单",
     "from": [
      "S01-B4"
     ]
    }
   ],
   "small": [
    {
     "text": "像一次召唤，停顿里还等着回声",
     "after": 1,
     "from": [
      "S01-B1"
     ],
     "bars": "1–6"
    },
    {
     "text": "像有人挺直背脊，心里却很想停下",
     "after": 1,
     "from": [
      "S01-B2"
     ],
     "bars": "1–23"
    },
    {
     "text": "听着分不清愤怒、遗憾还是怀念",
     "after": 2,
     "from": [
      "S01-B3"
     ],
     "bars": "1–23"
    },
    {
     "text": "胸口发紧，视线模糊，伸手只摸到虚空",
     "after": 4,
     "from": [
      "S01-B4"
     ],
     "bars": "1–23"
    },
    {
     "text": "旧场景连声音光线都回来，却已成过去",
     "after": 3,
     "from": [
      "S01-B5"
     ],
     "bars": "9–17"
    },
    {
     "text": "身体仿佛先记起该怎样迈步",
     "after": 3,
     "from": [
      "S01-B5"
     ],
     "bars": "18–23"
    }
   ],
   "notes": [
    {
     "text": "沉重和弦之后，一串向上的音像烟雾散开",
     "from": [
      "S01-B1"
     ],
     "bars": "1–6"
    },
    {
     "text": "短句刚冒出，就被长停顿截断",
     "from": [
      "S01-B3"
     ],
     "bars": "1–23"
    },
    {
     "text": "旋律轮廓渐渐清楚，旧场景像要浮现",
     "from": [
      "S01-B5"
     ],
     "bars": "9–17"
    },
    {
     "text": "舞曲步态渐渐露出，主题还没站稳",
     "from": [
      "S01-B5"
     ],
     "bars": "18–23"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "他舍不得从前自在的日子",
     "accent": "舍不得",
     "emotion": "亲密",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "想到以后不能那样过他就慌",
     "accent": "他就慌",
     "emotion": "不安",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "他提醒自己当初受过的气",
     "accent": "受过的气",
     "emotion": "炽热",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "他怕一心软就忘了为何离开",
     "accent": "为何离开",
     "emotion": "不安",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "他不甘心连好日子也得丢掉",
     "accent": "不甘心",
     "emotion": "炽热",
     "from": [
      "S02-3"
     ]
    }
   ],
   "small": [
    {
     "text": "像一首从远处传来的旧歌",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "24–65"
    },
    {
     "text": "舞步带着庄严，歌声像私下哼唱",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "24–65"
    },
    {
     "text": "像腿脚虚浮的人，在记忆里挪舞步",
     "after": 1,
     "from": [
      "S02-B2"
     ],
     "bars": "24–65"
    },
    {
     "text": "像整理衣服抬起头，悲伤还在却不沉下去",
     "after": 2,
     "from": [
      "S02-B4"
     ],
     "bars": "24–65"
    },
    {
     "text": "一遍遍说我没事，反倒露出仍很在意",
     "after": 3,
     "from": [
      "S02-B4"
     ],
     "bars": "24–65"
    },
    {
     "text": "像在说我不甘心就这样消亡",
     "after": 4,
     "from": [
      "S02-B5"
     ],
     "bars": "44–65"
    }
   ],
   "notes": [
    {
     "text": "舞步庄严，旋律却脆弱凄婉",
     "from": [
      "S02-B2"
     ],
     "bars": "24–65"
    },
    {
     "text": "细碎的不安声响一直在底下蠕动",
     "from": [
      "S02-B2"
     ],
     "bars": "24–65"
    },
    {
     "text": "音乐猛地向上推，随后又退下来",
     "from": [
      "S02-B3"
     ],
     "bars": "38–43"
    },
    {
     "text": "第二次聚起力量，气势更强",
     "from": [
      "S02-B3"
     ],
     "bars": "44–65"
    },
    {
     "text": "这一段越发焦灼，始终没有安稳落地",
     "from": [
      "S02-B3"
     ],
     "bars": "52–63"
    },
    {
     "text": "一串接一串的快速音，让呼吸越来越急",
     "from": [
      "S02-B3"
     ],
     "bars": "56–65"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他心里还憋着一股气",
     "accent": "憋着一股气",
     "emotion": "炽热",
     "from": [
      "S03-1"
     ]
    },
    {
     "text": "想起有人把他当作自己人",
     "accent": "自己人",
     "emotion": "亲密",
     "from": [
      "S03-1"
     ]
    },
    {
     "text": "那点高兴很快变成心酸",
     "accent": "心酸",
     "emotion": "孤单",
     "from": [
      "S03-1",
      "S03-2"
     ]
    },
    {
     "text": "从前的日子已经过不成了",
     "accent": "过不成了",
     "emotion": "孤单",
     "from": [
      "S03-2"
     ]
    },
    {
     "text": "离开以后真的会更好过吗？",
     "accent": "更好过吗",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ]
    }
   ],
   "small": [
    {
     "text": "前半焦躁急切地往前赶",
     "after": 0,
     "from": [
      "S03-B2"
     ],
     "bars": "66–79"
    },
    {
     "text": "后半像麦浪微风，也像亲近无防备",
     "after": 2,
     "from": [
      "S03-B2"
     ],
     "bars": "80–91"
    },
    {
     "text": "像聊点别的或出去走走，暂时躲开伤口",
     "after": 2,
     "from": [
      "S03-B3"
     ],
     "bars": "66–91"
    },
    {
     "text": "那会儿的轻松是真的，心里的事仍没答案",
     "after": 2,
     "from": [
      "S03-B3"
     ],
     "bars": "66–91"
    },
    {
     "text": "耳边像多人絮语，脚下却像流沙",
     "after": 2,
     "from": [
      "S03-B4"
     ],
     "bars": "66–91"
    },
    {
     "text": "刚才那些话，我是真的相信吗？",
     "after": 2,
     "from": [
      "S03-B5"
     ],
     "bars": "66–91"
    }
   ],
   "notes": [
    {
     "text": "重击像重锤落下，强弱起伏让舞步不安",
     "from": [
      "S03-B1"
     ],
     "bars": "66"
    },
    {
     "text": "整齐步态转为灵活流动的舞蹈",
     "from": [
      "S03-B1"
     ],
     "bars": "66–91"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "他真盼着还能那样亲近",
     "accent": "真盼着",
     "emotion": "亲密",
     "from": [
      "S04-1"
     ]
    },
    {
     "text": "可当初那些委屈又翻了上来",
     "accent": "委屈",
     "emotion": "不安",
     "from": [
      "S04-2"
     ]
    },
    {
     "text": "姿态仍向前心里却有回声",
     "accent": "心里却有回声",
     "emotion": "悬着",
     "from": [
      "S04-B1"
     ]
    },
    {
     "text": "他开始怀疑那一步走对了吗？",
     "accent": "走对了吗",
     "emotion": "悬着",
     "from": [
      "S04-2"
     ]
    }
   ],
   "small": [
    {
     "text": "回忆里有感激，柔情和短暂幸福",
     "after": 0,
     "from": [
      "S04-B1"
     ],
     "bars": "92–107"
    },
    {
     "text": "那份坚定，或许只是他想成为的样子",
     "after": 2,
     "from": [
      "S04-B1"
     ],
     "bars": "92–107"
    },
    {
     "text": "没走那一步，如今又会怎样？",
     "after": 3,
     "from": [
      "S04-2"
     ],
     "bars": ""
    },
    {
     "text": "回忆太好，过去却回不来了",
     "after": 1,
     "from": [
      "S04-B2"
     ],
     "bars": "92–115"
    },
    {
     "text": "像被时间催着跑，身体也停不下来",
     "after": 2,
     "from": [
      "S04-B3"
     ],
     "bars": "92–115"
    },
    {
     "text": "脑子里反复问如果当时怎样，只怕停下来",
     "after": 3,
     "from": [
      "S04-B4"
     ],
     "bars": "94–115"
    }
   ],
   "notes": [
    {
     "text": "熟悉的舞曲主题回来，旋律变得更抒情",
     "from": [
      "S04-B1"
     ],
     "bars": "92–107"
    },
    {
     "text": "音乐骤然激烈紧绷，随后像被撕扯着后退",
     "from": [
      "S04-B2"
     ],
     "bars": "108–115"
    },
    {
     "text": "细碎音符密集，低处声音一路追赶",
     "from": [
      "S04-B3"
     ],
     "bars": "92–115"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "他仍觉得当初那些气不该忍",
     "accent": "不该忍",
     "emotion": "炽热",
     "from": [
      "S05-1"
     ]
    },
    {
     "text": "可连开心的往事都不敢多想",
     "accent": "不敢多想",
     "emotion": "孤单",
     "from": [
      "S05-1"
     ]
    },
    {
     "text": "跟自己争得他渐渐没了力气",
     "accent": "没了力气",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    },
    {
     "text": "那股不服气慢慢淡了",
     "accent": "慢慢淡了",
     "emotion": "安心",
     "from": [
      "S05-2"
     ]
    },
    {
     "text": "想到不在他们身边他很难受",
     "accent": "很难受",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    }
   ],
   "small": [
    {
     "text": "像夜色里两个影子低声说话",
     "after": 4,
     "from": [
      "S05-B1"
     ],
     "bars": "116–147"
    },
    {
     "text": "柔和歌唱里仍有股不能就此算了的劲",
     "after": 0,
     "from": [
      "S05-B2"
     ],
     "bars": "116–127"
    },
    {
     "text": "可能想起某个人，也可能是故乡旧生活",
     "after": 4,
     "from": [
      "S05-B3"
     ],
     "bars": "116–147"
    },
    {
     "text": "像脚下地板忽然不见，只剩一个声音",
     "after": 2,
     "from": [
      "S05-B4"
     ],
     "bars": "128–147"
    },
    {
     "text": "紧绷最后像几次深呼吸或一声叹息",
     "after": 3,
     "from": [
      "S05-B5"
     ],
     "bars": "144–147"
    },
    {
     "text": "松动只是抵抗累了，心里未必平静",
     "after": 2,
     "from": [
      "S05-B5"
     ],
     "bars": "132–147"
    }
   ],
   "notes": [
    {
     "text": "柔和歌唱仍带着向前宣告的劲",
     "from": [
      "S05-B2"
     ],
     "bars": "116–127"
    },
    {
     "text": "快速音渐渐放慢变稀，最后只剩疏落和弦",
     "from": [
      "S05-B4"
     ],
     "bars": "128–147"
    },
    {
     "text": "旋律几乎单独露出来，周围声音渐渐退去",
     "from": [
      "S05-B4"
     ],
     "bars": "128–129、139–144"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "那阵难受慢慢缓了下来",
     "accent": "缓了下来",
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "他想起有人陪着时多么轻松",
     "accent": "多么轻松",
     "emotion": "亲密",
     "from": [
      "S06-1",
      "S06-2"
     ]
    },
    {
     "text": "这回他没拿委屈压住想念",
     "accent": "没拿委屈压住",
     "emotion": "亲密",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "他想再过那样亲近的日子",
     "accent": "亲近的日子",
     "emotion": "亲密",
     "from": [
      "S06-3"
     ]
    },
    {
     "text": "他怕以后再也遇不到那份亲近",
     "accent": "再也遇不到",
     "emotion": "不安",
     "from": [
      "S06-3"
     ]
    }
   ],
   "small": [
    {
     "text": "玻璃罩里的摇篮曲，现实没变也留不久",
     "after": 0,
     "from": [
      "S06-B1"
     ],
     "bars": "148–180"
    },
    {
     "text": "终于不用解释难过，也不用装坚强",
     "after": 2,
     "from": [
      "S06-B2"
     ],
     "bars": "148–180"
    },
    {
     "text": "压住的愿望、委屈和思念，终于浮上来",
     "after": 2,
     "from": [
      "S06-B2"
     ],
     "bars": "148–180"
    },
    {
     "text": "像向遥远的对象祈求，不知有无回应",
     "after": 3,
     "from": [
      "S06-B2"
     ],
     "bars": "148–180"
    },
    {
     "text": "远方忽然亮起，梦里看见旧家园",
     "after": 3,
     "from": [
      "S06-B2"
     ],
     "bars": "约160"
    },
    {
     "text": "知道挽不回，轻轻看着曾有的暖意",
     "after": 4,
     "from": [
      "S06-B4"
     ],
     "bars": "148–180"
    }
   ],
   "notes": [
    {
     "text": "音乐忽然转入绵长安静的世界",
     "from": [
      "S06-B1"
     ],
     "bars": "148–180"
    },
    {
     "text": "歌唱带着庄严而缓慢的气息",
     "from": [
      "S06-B2"
     ],
     "bars": "148–180"
    },
    {
     "text": "歌唱从含蓄试探逐渐展开",
     "from": [
      "S06-B3"
     ],
     "bars": "148–167"
    },
    {
     "text": "歌唱再次展开，临近结尾像话未说完",
     "from": [
      "S06-B3"
     ],
     "bars": "168–180"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "刚有点安心他又想到以后",
     "accent": "想到以后",
     "emotion": "不安",
     "from": [
      "S07-1"
     ]
    },
    {
     "text": "以后遇上难事他能独自扛吗？",
     "accent": "独自扛吗",
     "emotion": "不安",
     "from": [
      "S07-1"
     ]
    },
    {
     "text": "他没料到离开后会这么孤单",
     "accent": "这么孤单",
     "emotion": "孤单",
     "from": [
      "S07-2"
     ]
    },
    {
     "text": "他想找回亲近却不愿再受委屈",
     "accent": "不愿再受委屈",
     "emotion": "悬着",
     "from": [
      "S07-3"
     ]
    },
    {
     "text": "他连要不要回去都拿不准",
     "accent": "拿不准",
     "emotion": "悬着",
     "from": [
      "S07-3"
     ]
    }
   ],
   "small": [
    {
     "text": "像寒风吹开窗，把人从甜梦拽回严寒",
     "after": 0,
     "from": [
      "S07-B1"
     ],
     "bars": "182附近"
    },
    {
     "text": "后颈一凉，脉搏猛地跳起来",
     "after": 0,
     "from": [
      "S07-B1"
     ],
     "bars": "182附近"
    },
    {
     "text": "像突然换了场景，原先思路被截断",
     "after": 2,
     "from": [
      "S07-B2"
     ],
     "bars": "182–197"
    },
    {
     "text": "像有东西不停翻转，想冲出去却没出口",
     "after": 4,
     "from": [
      "S07-B3"
     ],
     "bars": "198–205"
    },
    {
     "text": "熟悉的舞步闯进来，反倒让人看见失去",
     "after": 2,
     "from": [
      "S07-B4"
     ],
     "bars": "181–205"
    },
    {
     "text": "当初离开时那股决心，也找不着了",
     "after": 4,
     "from": [
      "S07-3"
     ],
     "bars": ""
    }
   ],
   "notes": [
    {
     "text": "高处忽然浮出轻细又刺骨的颤动声",
     "from": [
      "S07-B1"
     ],
     "bars": "182附近"
    },
    {
     "text": "舞蹈段落突然闯入，打断先前的静谧",
     "from": [
      "S07-B2"
     ],
     "bars": "182–197"
    },
    {
     "text": "旧舞曲气息再现，却不再完整鲜明",
     "from": [
      "S07-B5"
     ],
     "bars": "182–197"
    },
    {
     "text": "连续颤动的声音让紧张一层层累积",
     "from": [
      "S07-B3"
     ],
     "bars": "198–205"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "他先把回去的事放一边",
     "accent": "放一边",
     "emotion": "安心",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "想起从前有人把他当自己人",
     "accent": "自己人",
     "emotion": "亲密",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "那点暖意很快就淡了",
     "accent": "很快就淡了",
     "emotion": "悬着",
     "from": [
      "S08-2"
     ]
    },
    {
     "text": "想到以后难事还得自己扛",
     "accent": "自己扛",
     "emotion": "不安",
     "from": [
      "S08-2"
     ]
    }
   ],
   "small": [
    {
     "text": "像心里熟悉的柔软处重新打开",
     "after": 1,
     "from": [
      "S08-B1"
     ],
     "bars": "206–213"
    },
    {
     "text": "像临走前回头看一眼，温柔又不舍",
     "after": 2,
     "from": [
      "S08-B2"
     ],
     "bars": "206–213"
    },
    {
     "text": "胸口仿佛终于吸进一口气",
     "after": 2,
     "from": [
      "S08-B3"
     ],
     "bars": "206–213"
    }
   ],
   "notes": [
    {
     "text": "缓慢宽广的歌唱短暂回来",
     "from": [
      "S08-B1"
     ],
     "bars": "206–213"
    }
   ]
  },
  {
   "sec": "S09",
   "big": [
    {
     "text": "他忽然说不清自己为何想回去",
     "accent": "说不清",
     "emotion": "悬着",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "是舍不得被当作自己人",
     "accent": "自己人",
     "emotion": "亲密",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "还是怕孤单到愿意再受委屈",
     "accent": "愿意再受委屈",
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "他心慌得不敢再往下想",
     "accent": "不敢再往下想",
     "emotion": "不安",
     "from": [
      "S09-2"
     ]
    }
   ],
   "small": [
    {
     "text": "像从另一面，重新看见同一扇门",
     "after": 0,
     "from": [
      "S09-B1"
     ],
     "bars": "214–215"
    },
    {
     "text": "像重新遇见，那个不知怎么办的自己",
     "after": 0,
     "from": [
      "S09-B2"
     ],
     "bars": "214–215"
    },
    {
     "text": "这一次你已知道那个自己经历过什么",
     "after": 1,
     "from": [
      "S09-B2"
     ],
     "bars": "214–215"
    }
   ],
   "notes": [
    {
     "text": "颤动声里，开头引子阴冷闪现又飘远",
     "from": [
      "S09-B1"
     ],
     "bars": "214–215"
    }
   ]
  },
  {
   "sec": "S10",
   "big": [
    {
     "text": "他最舍不得的是被当作自己人",
     "accent": "最舍不得",
     "emotion": "亲密",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "可回去还能找回那份亲近吗？",
     "accent": "找回那份亲近吗",
     "emotion": "悬着",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "光凭舍不得他还是不敢回去",
     "accent": "不敢回去",
     "emotion": "不安",
     "from": [
      "S10-2"
     ]
    },
    {
     "text": "他想得很累眼下也过得不踏实",
     "accent": "过得不踏实",
     "emotion": "孤单",
     "from": [
      "S10-3"
     ]
    }
   ],
   "small": [
    {
     "text": "当初那些委屈也不能当没发生",
     "after": 2,
     "from": [
      "S10-2"
     ],
     "bars": ""
    },
    {
     "text": "像忽然失重，悬在半空，身体没着落",
     "after": 3,
     "from": [
      "S10-B2"
     ],
     "bars": "221–225"
    },
    {
     "text": "他忍不住问自己，以后该怎么过",
     "after": 3,
     "from": [
      "S10-B3"
     ],
     "bars": "216–225"
    },
    {
     "text": "像疲倦的人，想起重要往事却无力重讲",
     "after": 3,
     "from": [
      "S10-B4"
     ],
     "bars": "216–225"
    }
   ],
   "notes": [
    {
     "text": "熟悉旋律断断续续浮现，没能完整展开",
     "from": [
      "S10-B1"
     ],
     "bars": "216–225"
    },
    {
     "text": "摇篮曲的碎片变得格外凄厉哀婉",
     "from": [
      "S10-B1"
     ],
     "bars": "216–225"
    },
    {
     "text": "短句轻弱零碎，彼此之间留着空隙",
     "from": [
      "S10-B2"
     ],
     "bars": "221–225"
    }
   ]
  },
  {
   "sec": "S11",
   "big": [
    {
     "text": "他明知回去未必找回亲近",
     "accent": "未必找回",
     "emotion": "悬着",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "他还是忍不住想万一呢？",
     "accent": "万一呢",
     "emotion": "不安",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "他不愿只凭指望回去继续忍让",
     "accent": "不愿",
     "emotion": "炽热",
     "from": [
      "S11-2"
     ]
    },
    {
     "text": "他先想把眼下日子过稳",
     "accent": "过稳",
     "emotion": "安心",
     "from": [
      "S11-3"
     ]
    },
    {
     "text": "他怕以后独自扛却不改主意",
     "accent": "不改主意",
     "emotion": "不安",
     "from": [
      "S11-4"
     ]
    }
   ],
   "small": [
    {
     "text": "像困兽一次次顶住，停滞终于松开一点",
     "after": 4,
     "from": [
      "S11-B1",
      "S11-B3"
     ],
     "bars": "226–241"
    },
    {
     "text": "祈祷慢慢变成往前的意志",
     "after": 3,
     "from": [
      "S11-B2"
     ],
     "bars": "226–241"
    }
   ],
   "notes": [
    {
     "text": "低处声音翻涌，重重和弦反复砸下",
     "from": [
      "S11-B1"
     ],
     "bars": "226–237"
    },
    {
     "text": "舞步从试探逐渐聚拢，末尾向上推进",
     "from": [
      "S11-B2"
     ],
     "bars": "226–241"
    }
   ]
  },
  {
   "sec": "S12",
   "big": [
    {
     "text": "他承认受过委屈也曾开心",
     "accent": "也曾开心",
     "emotion": "安心",
     "from": [
      "S12-1"
     ]
    },
    {
     "text": "这回他不再逼自己选边",
     "accent": "不再逼自己",
     "emotion": "安心",
     "from": [
      "S12-1"
     ]
    },
    {
     "text": "他不怪自己离开也不为陪伴回头",
     "accent": "不为陪伴回头",
     "emotion": "炽热",
     "from": [
      "S12-2"
     ]
    },
    {
     "text": "他愿意带着想念继续过日子",
     "accent": "继续过日子",
     "emotion": "安心",
     "from": [
      "S12-2"
     ]
    }
   ],
   "small": [
    {
     "text": "这份昂扬像面向众人，也带着集体感",
     "after": 0,
     "from": [
      "S12-B1"
     ],
     "bars": "242–253"
    },
    {
     "text": "他仍能决定怎样站立，不必假装没受伤",
     "after": 2,
     "from": [
      "S12-B2"
     ],
     "bars": ""
    },
    {
     "text": "脚步正往前，地面却像短暂斜了一下",
     "after": 3,
     "from": [
      "S12-B3"
     ],
     "bars": "249–253"
    }
   ],
   "notes": [
    {
     "text": "熟悉的舞曲主题以雷鸣般声势轰然回来",
     "from": [
      "S12-B1"
     ],
     "bars": "242–253"
    },
    {
     "text": "昂扬中忽然换了色彩，随后仍继续向前",
     "from": [
      "S12-B3"
     ],
     "bars": "249–253"
    }
   ]
  },
  {
   "sec": "S13",
   "big": [
    {
     "text": "想起从前亲近他心里又热了",
     "accent": "心里又热了",
     "emotion": "欢喜",
     "from": [
      "S13-1"
     ]
    },
    {
     "text": "他盼着以后还能遇见那样的人",
     "accent": "还能遇见",
     "emotion": "亲密",
     "from": [
      "S13-1"
     ]
    },
    {
     "text": "他有劲头好好过日子不再较劲",
     "accent": "好好过日子",
     "emotion": "炽热",
     "from": [
      "S13-2"
     ]
    },
    {
     "text": "他怕还要等很久才遇到亲近的人",
     "accent": "等很久",
     "emotion": "悬着",
     "from": [
      "S13-3"
     ]
    },
    {
     "text": "没人相伴他也愿意好好过",
     "accent": "好好过",
     "emotion": "安心",
     "from": [
      "S13-4"
     ]
    }
   ],
   "small": [
    {
     "text": "歌像站到明亮处，心跳仿佛冲到极限",
     "after": 0,
     "from": [
      "S13-B1"
     ],
     "bars": "254–270"
    },
    {
     "text": "也让人想到故土、共同记忆和希望",
     "after": 1,
     "from": [
      "S13-B1"
     ],
     "bars": "254–270"
    },
    {
     "text": "像被气流推着跑，兴奋得顾不上喘息",
     "after": 2,
     "from": [
      "S13-B2"
     ],
     "bars": "269–280"
    },
    {
     "text": "平静里还问稳不稳，也像终于能喘口气",
     "after": 3,
     "from": [
      "S13-B3"
     ],
     "bars": "281–287"
    },
    {
     "text": "最后的高音像寒星，也像决定或醒来",
     "after": 4,
     "from": [
      "S13-B4",
      "S13-B5"
     ],
     "bars": "286–288"
    },
    {
     "text": "有人当他自己人，他会珍惜，不为留人忍委屈",
     "after": 4,
     "from": [
      "S13-4"
     ],
     "bars": ""
    }
   ],
   "notes": [
    {
     "text": "柔软歌唱忽然展开成开阔宏大的音响",
     "from": [
      "S13-B1"
     ],
     "bars": "254–270"
    },
    {
     "text": "密集音符像激流般向高处喷涌",
     "from": [
      "S13-B1"
     ],
     "bars": "254–270"
    },
    {
     "text": "快速明亮的音符迅疾向前冲出",
     "from": [
      "S13-B2"
     ],
     "bars": "269–280"
    },
    {
     "text": "冲势收敛，细碎颤动又带来不安",
     "from": [
      "S13-B3"
     ],
     "bars": "281–287"
    },
    {
     "text": "低处两记耳语般和弦后，高处亮起清脆和弦",
     "from": [
      "S13-B4"
     ],
     "bars": "286–288"
    }
   ]
  }
 ]
}