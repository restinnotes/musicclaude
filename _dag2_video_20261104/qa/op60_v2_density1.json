      ],
      "bead_edges": [
        {
          "a": "S02-B1",
          "b": "S02-B2",
          "type": "可同时成立",
          "note": "B1是双音歌唱带来的近距离交谈，B2是左手摇曳带来的身体承托。摇曳先于歌声出现，之后两者同时存在：水波托着歌声，并不是两种竞争性的画面。"
        },
        {
          "a": "S02-B2",
          "b": "S02-B4",
          "type": "重叠但新增",
          "note": "两者都触及时间不能停留。B2的不可停留来自始终向前的水波运动；B4则在柔软落音中增添尚未失去就已经舍不得的心理刺痛。"
        },
        {
          "a": "S02-B1",
          "b": "S02-B4",
          "type": "可同时成立",
          "note": "双音仍可被听作亲密的依偎，而反复落音同时使甜蜜略带惆怅；不需要先发生失去或冲突。"
        },
        {
          "a": "S02-B2",
          "b": "S02-B3",
          "type": "可同时成立",
          "note": "后半段歌声可以短暂升温又回柔，底层的水波仍继续摇曳；B5并不意味着B2的承托已经消失。"
        }
      ],
