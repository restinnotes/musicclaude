  {
   "bars": "51–61",
   "relation": "没在想",
   "items": [
    {
     "id": "I30",
     "text": "这份温柔持续下来，他越来越不急着索取。",
     "key": "不急着索取",
     "kind": ""
    },
    {
     "id": "I31",
     "text": "他有时对这样好的人生出一点疼惜。",
     "key": "生出疼惜",
     "kind": ""
    },
    {
     "id": "I32",
     "text": "对方本身值得珍惜，也渐渐成了他深爱的理由。",
     "key": "本身值得珍惜",
     "kind": "分清"
    },
    {
     "id": "I33",
     "text": "他的满足里添了轻轻的郑重，仿佛欢喜本身也令他动容。",
     "key": "欢喜也动容",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I29",
     "to": "I30",
     "rel": "提供理由"
    },
    {
