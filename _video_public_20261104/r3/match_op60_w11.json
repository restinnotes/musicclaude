   "lost": ""
  },
  {
   "id": "S05-0-0",
   "a": "对上",
   "b": "偏了",
   "lost": "乙把攥紧不放的冲动消退理解成不再隐藏喜欢，原稿重点是想抓紧、舍不得放手的那股劲终于退去。"
  },
  {
   "id": "S05-1-0",
   "a": "对上",
   "b": "偏了",
   "lost": "乙额外加入被对方看出在乎这一触发原因，原稿只表达突然失去支撑、心里失去依靠的感觉。"
  },
  {
   "id": "S05-1-1",
   "a": "对上",
   "b": "对上",
   "lost": ""
  },
  {
   "id": "S05-1-2",
