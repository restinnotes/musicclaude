{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"落下来以后，却还没有真正落稳，仿佛仍悬在水面上方\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没真正落稳\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变，所以格外谨慎\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"正因为太清楚\"\n        },\n        {\n          \"quote\": \"还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没交给规律水浪\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"心里一下热了起来\"\n        },\n        {\n          \"text\": \"怕让对方为难\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"怕让对方为难\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"水却一直在流，时间也一直在走\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"水还在流\"\n        },\n        {\n          \"quote\": \"像一根温柔的刺\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"温柔的刺\"\n        },\n        {\n          \"quote\": \"还没有失去什么，就已经生出一丝舍不得了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没失去，已先舍不得\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"才慢慢放松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没有退开，仍愿意亲近\"\n        },\n        {\n          \"text\": \"他也想靠近