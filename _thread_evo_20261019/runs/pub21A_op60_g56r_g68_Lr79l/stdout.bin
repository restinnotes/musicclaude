{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"连自己也有点意外\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越清楚，越怕关系变\"\n        },\n        {\n          \"quote\": \"落下来以后，却还没有真正落稳\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"怕自己的需要成了负担\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却怕\"\n        },\n        {\n          \"text\": \"他只敢露出一点喜欢\",\n          \"point\": \"不知下次能否坦白\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只敢露出一点喜欢\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"裹在皮肤上有些黏稠\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"没有继续冲向高潮，而像轻轻呼出一口气\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"眼前的好还在，心里却已经有一点鼻酸\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"没有退开\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"他才慢慢放松\"\n        },\n        {\n          \"text\": \"他怕太急弄坏自在\",\n          \"point\": \"怕太急弄坏自在\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"也怕这样的时刻很快过去\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"身体还在这里，心却已经慢慢漂远\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只在水面上露了一下头，没有变成一场真正的倾诉\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"思绪像被风吹碎的倒影，粼粼闪烁却难以拼凑完整\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他难得不想以后\",\n          \"point\": \"舒服地待在这份亲近里\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"难得不想以后\"\n        },\n        {\n          \"text\": \"想说喜欢、想问对方\",\n          \"point\": \"念头就淡了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却还没开口\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"本来一句话已经够了，却忍不住再说一遍，又折回来补上更多细节\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"一句已够，还忍不住补说\"\n        },\n        {\n          \"quote\": \"自己也许还没有意识到在害怕什么，动作已经先透露了出来\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"自己未察觉，手先露怯\"\n        },\n        {\n          \"quote\": \"你越用力，水面的颠簸就越剧烈，船舱内的平衡就越脆弱\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"熟悉的亲近又让他欢喜\",\n          \"point\": \"上回没说的话\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"上回没说的话\"\