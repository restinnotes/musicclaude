       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "亲近回忆一鲜活，当初的委屈也跟着翻上来",
       "keys": [
        "委屈"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "记忆太好又无法原样回来，反而让人心里刺痛",
