{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"他心里就空落落的\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"空落落\"\n        },\n        {\n          \"quote\": \"反而像烟雾往高处散，声音轻了、远了，悬在半空。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"轻了，悬在半空\"\n        },\n        {\n          \"quote\": \"连自己身在何处都还没弄清的恍惚。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开了熟悉的生活\",\n          \"point\": \"不用再一次次委屈自己了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一次次\"\n        },\n        {\n          \"text\": \"可这份笃定没撑多久\",\n          \"point\": \"到底舍不得什么\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这份笃定没撑多久\"\n        },\n        {\n          \"text\": \"想起从前那些熟悉的日子\",\n          \"point\": \"不知道以后靠什么安下心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还是想往前过，却不知道\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"节奏本身庄严、傲慢，旋律却脆弱凄婉\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"旋律却脆弱凄婉\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"说到第三遍，反而露出在意\"\n        },\n        {\n          \"quote\": \"不是轻松恢复自信，而是负隅顽抗。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是自信，是硬撑着不认输\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他舍不得从前那些自在的日子\",\n          \"point\": \"心里就发慌\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"以后不能再那样过\"\n        },\n        {\n          \"text\": \"一觉得舍不得\",\n          \"point\": \"连自己为什么走都忘了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"赶紧想起当初受过的气，怕心一软\"\n        },\n        {\n          \"text\": \"可他还是不甘心\",\n          \"point\": \"把以前的好日子也一起丢掉吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"为了不再受那些气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"温柔得让人心颤，也刺痛得让人绝望\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越温柔，越刺痛\"\n        },\n        {\n          \"quote\": \"那一刻的轻松可以是真的，并非假装；只是它没有替心里的事找到答案。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"轻松是真的，但问题没解开\"\n        },\n        {\n          \"quote\": \"我刚才是真的相信那些话，还是只是在努力让自己相信？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他心里那股气还憋着\",\n          \"point\": \"有人把他当自己人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"心里那股气还憋着\"\n        },\n        {\n          \"text\": \"可那点高兴还没退\",\n          \"point\": \"离开以后就一定会更好吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"那点高兴还没退\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"要是没走，如今会怎样\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"如果没走，如今会怎样\"\n        },\n        {\n          \"quote\": \"不是记忆变坏了，而是它太好了——过去无法原样回来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是变坏，是好得回不去\"\n        },\n        {\n          \"quote\": \"表面上动作越来越多，实际上并没有真正抵达哪里；不停地往前赶，只是为了避免停下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越赶越没抵达，只是不敢停\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他想起那些亲近的时候\",\n          \"point\": \"盼着一切还能像从前那样继续\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"真有一阵\"\n        },\n        {\n          \"text\": \"可越是这么盼着\",\n          \"point\": \"当初是不是走错了\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"却怎么也想不出\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"连过去开心的事都不敢多想\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"过去开心的事\"\n        },\n        {\n          \"quote\": \"音乐仍像被压力推着走，情绪比前面更直接、更有宣告性\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"柔和，却仍被压力推着走\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍不服气\",\n          \"point\": \"当初那些委屈就不该忍\",\n          \"where\": \"中\",\n          \"waste\": \"他仍不服气\",\n          \"keep\": \"连过去开心的事都不敢多想\"\n        },\n        {\n          \"text\": \"他跟自己争到没了力气\",\n          \"point\": \"那股不服气才慢慢淡下去\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"想到已经不在那些人身边\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"不必时时防备的时候\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"时时防备\"\n        },\n        {\n          \"quote\": \"遇上难熬的事\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"难熬的事\"\n        },\n        {\n          \"quote\": \"可这份安宁并不意味着现实已经变好，也不是一个能永远停留的地方。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"安宁不等于现实变好，也不能久留\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"难受慢慢缓下来\",\n          \"point\": \"没再急着拿受过的气压住想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这回没再急着\"\n        },\n        {\n          \"text\": \"离开后遇上难事\",\n          \"point\": \"有人在身边能让自己轻松多少\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"常常只能自己扛\"\n        },\n        {\n          \"text\": \"他真想再过那种\",\n          \"point\": \"又怕以后再也没有了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"不用多说就彼此亲近\"\n        },\n        {\n          \"text\": \"不过，那样的日子\",\n          \"point\": \"心里也暖和了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"毕竟真过过\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"早知道这样，自己还会走吗？\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"早知道这样，还会走吗\"\n        },\n        {\n          \"quote\": \"这种突兀的换向并不等于情绪好转；新出现的舞步可以很鲜明，内心却未必因此安定下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"换了舞步，心却没安定\"\n        },\n        {\n          \"quote\": \"事情表面上仿佛已经过去，身体和情绪却还没有完全相信一切已经结束。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"身体还不相信一切结束\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"刚有点安心\",\n          \"point\": \"自己真的撑得住吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还只能一个人顶着\"\n        },\n        {\n          \"text\": \"他这才发现\",\n          \"point\": \"早知道还会走吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只想着别再受那些气，却没料到会这么孤单\"\n        },\n        {\n          \"text\": \"他想找回以前的亲近\",\n          \"point\": \"连当初离开的决心也找不着了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又不愿回去受那些气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"暂时把回不回去的事放到一边\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"暂时\"\n        },\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"刚认出来，还没安顿就退了\"\n        },\n        {\n          \"quote\": \"它只是瞬间的喘息，并不等于整个人重新安顿下来。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"只是喘息，不是安顿\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他先把回不回去的事\",\n          \"point\": \"心里又暖和了一会儿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"先把回不回去的事放到一边\"\n        },\n        {\n          \"text\": \"可暖意退得太快\",\n          \"point\": \"回忆也不能陪着自己\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"以后遇上难事\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"一阵心慌\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"却不再像最初那样郑重召唤。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"这次不再像召唤\"\n        },\n        {\n          \"quote\": 