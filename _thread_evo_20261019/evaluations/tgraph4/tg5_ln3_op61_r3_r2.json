     "from": "I41",
     "to": "I78",
     "rel": "提供理由"
    }
   ]
  },
  {
   "bars": "254–288",
   "relation": "正在面对",
   "items": [
    {
     "id": "I79",
     "text": "只顾怀念，会让他觉得辜负当年受过的委屈。",
     "key": "只顾怀念",
     "kind": ""
    },
    {
     "id": "I80",
     "text": "只顾骄傲，他又会觉得辜负曾有的幸福。",
     "key": "只顾骄傲",
     "kind": ""
    },
    {
     "id": "I81",
     "text": "怀念再也不会使他怀疑是否该回去。",
     "key": "是否该回去",
     "kind": ""
    },
    {
     "id": "I82",
     "text": "他也不必否定过去，才能确信不该再忍耐。",
     "key": "不必否定过去",
     "kind": ""
    },
    {
     "id": "I83",
     "text": "他如今能同时承认失去的难过与坚持的珍贵。",
     "key": "同时承认",
     "kind": "分清"
    },
    {
     "id": "I84",
     "text": "同时承认这些仍换不回失去的亲近。",
     "key": "换不回",
     "kind": "办法的限度"
    },
    {
     "id": "I85",
     "text": "他仍没有既能放心依赖别人又不必收起自己的生活。",
     "key": "不必收起自己",
     "kind": ""
    },
    {
     "id": "I86",
     "text": "有时，失去的亲近仍令他难过得厉害。",
     "key": "难过得厉害",
     "kind": ""
    },
    {
     "id": "I87",
     "text": "他格外盼望将来亲近时不必再忍委屈。",
     "key": "盼望将来",
     "kind": ""
    },
    {
     "id": "I88",
     "text": "他带着思念继续向前。",
     "key": "继续向前",
     "kind": ""
    },
    {
     "id": "I89",
     "text": "他的怀念里也有了不愿再委屈自己的要求。",
     "key": "委屈自己的要求",
     "kind": ""
    },
    {
     "id": "I90",
     "text": "他虽更能承受这两份感情，渴望却未减。",
     "key": "渴望却未减",
     "kind": ""
    },
    {
     "id": "I91",
     "text": "他仍想在别人身边安心，也能对自己坦然。",
     "key": "对自己坦然",
     "kind": ""
    }
   ],
