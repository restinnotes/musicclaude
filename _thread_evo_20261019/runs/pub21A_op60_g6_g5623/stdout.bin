"原来的温柔再次出现，却有了新的重量；而知道它有多珍贵以后，心里反而更容易发疼。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"觉得自己这么在乎对方也没什么不好。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"在乎对方也没什么不好\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"等那阵轻松过去\",\n          \"point\": \"他仍愿意在旁\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"即使对方有时不需要他陪\"\n        },\n        {\n          \"text\": \"他不想再把喜欢藏起来\",\n          \"point\": \"不想再把喜欢藏起来\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"高兴得连害臊都顾不上\"\n        },\n        {\n          \"text\": \"可他愿意一直陪着\",\n          \"point\": \"对方以后也会这样选择\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"他愿意一直陪着\"\n        },\n        {\n          \"text\": \"想到这里，刚才的欢喜又压得他心口发疼\",\n          \"point\": \"压得他心口发疼\",\n          \"where\": \"后\",\n          \"waste\": \"想到这里\",\n          \"keep\": \"刚才的欢喜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"fine\": [\n        {\n          \"quote\": \"倒不是「我的感情终于变得比一切都伟大」，反而像整个人被卷进一个比自己更大的世界，连「我」都暂时退到了后面。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是我变大，是我退到后面\"\n        },\n        {\n          \"quote\": \"旋律一次次向上伸展，仿佛还想要更多，却始终不能完全满足。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"快乐到连自己想笑还是想哭都分不清。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他这会儿只想把能给的都给对方\",\n          \"point\": \"把能给的都给对方\",\n          \"where\": \"中\",\n       