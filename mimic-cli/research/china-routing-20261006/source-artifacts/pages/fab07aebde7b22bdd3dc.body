            <div class="z-clearfix" id="feed-wrap">

                <!-- 左侧内容 start -->
                <div class="left-wrap" id="feed-main">
                    <!-- 焦点图 start -->
                    <div class="poster-wraper">
                                                                        <div class="detailed_banner">
                            <img src="https://a.zdmimg.com/202606/22/6a38d0357f0252476.jpg_fo742.jpg" alt="尼康鸡头vs凤尾｜Z50Ⅱ对比Z5Ⅱ同镜头实测">
                        </div>
