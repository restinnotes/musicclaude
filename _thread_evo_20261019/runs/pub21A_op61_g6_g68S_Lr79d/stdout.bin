{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"紧接着的自由上行琶音却没把这份重量接住，反而像烟雾往高处散\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"尊严还在，行动的方向和力气却不稳\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"体面还在，力气却不稳\"\n        },\n        {\n          \"quote\": \"过去也不会因此重新变成现在\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"记得再清楚，也回不到现在\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开熟悉的生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初觉得\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"不知怎么安心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想过下去\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"反复说本身就露了馅\"\n        },\n        {\n          \"quote\": \"不是轻松恢复自信，而是负隅顽抗\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到再不能自在地过日子\",\n          \"point\": \"不能自在地过日子\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"想到\"\n        },\n        {\n          \"text\": \"他提醒自己受过的气\",\n          \"point\": \"不甘心连好日子也丢掉\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"提醒自己受过的气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"越怀念，越能感觉它与眼前处境的距离\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一刻的轻松可以是真的，并非假装；只是它没有替心里的事找到答案\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"我刚才是真的相信那些话，还是只是在努力让自己相信？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"我真信了那些话吗？\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他还憋着气\",\n          \"point\": \"有人把他当自己人\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还憋着气\"\n        },\n        {\n          \"text\": \"他刚有点高兴\",\n          \"point\": \"离开后未必更好过\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"刚有点高兴\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"外在的步伐还在向前，里面却有了更多回声\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份坚定也可能是他努力想成为的样子，而不再是一个毫无疑问的事实\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"也可能只是\"\n        },\n        {\n          \"quote\": \"不停地往前赶，只是为了避免停下来\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"忙着赶，只为不敢停下\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起从前的亲近\",\n          \"point\": \"日子还能照旧\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想起从前的亲近\"\n        },\n        {\n          \"text\": \"他也开始怀疑\",\n          \"point\": \"当初离开到底对不对\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"开始怀疑\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"可正因已经过去，眷恋里也带着失落\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"抵抗得累了\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍不服气\",\n          \"point\": \"那些气不该忍\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"仍不服气\"\n        },\n        {\n          \"text\": \"可他不想连开心的过去都避开\",\n          \"point\": \"不想连开心的过去都避开\",\n          \"where\": \"中\",\n          \"waste\": \"心里\",\n          \"keep\": \"连开心的过去都避开\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份安宁并不意味着现实已经变好，也不是一个能永远停留的地方\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开后独自扛难事\",\n          \"point\": \"有人陪着时有多轻松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"独自扛难事\"\n        },\n        {\n          \"text\": \"他想再有默契\",\n          \"point\": \"又怕再也没有\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"想起曾有的默契\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"把人从甜梦里生生拽回严寒\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这种突兀的换向并不等于情绪好转；新出现的舞步可以很鲜明，内心却未必因此安定下来\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他没料到离开后\",\n          \"point\": \"这么孤单\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没料到\"\n        },\n        {\n          \"text\": \"他想找回亲近\",\n          \"point\": \"决心就淡了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一想到回去还要受气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一眼里有温柔，也有不舍\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只是瞬间的喘息，并不等于整个人重新安顿下来\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他先把回去的事放一边\",\n          \"point\": \"曾被当作自己人\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"先把回去的事放一边\"\n        },\n        {\n          \"text\": \"可回忆不能陪他过难关\",\n          \"point\": \"回忆不能陪他过难关\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"很快\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"开头沉重的引子从中阴冷地闪现回来，却不再像最初那样郑重召唤\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"声音短暂落稳，又向高处漂去，刚有的一点稳定感随即散掉\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"最初的问题又浮上来，却没有因此得到一个简单的答案\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他分不清\",\n          \"point\": \"舍不得亲近，还是怕孤单\",\n          \"where\": \"中\",\n          \"waste\": \"他分不清，\",\n          \"keep\": \"还是怕孤单\"\n        },\n        {\n          \"text\": \"这念头让他一阵心慌\",\n          \"point\": \"连往下想都不敢了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一阵心慌\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"fine\": [\n        {\n          \"quote\": \"不再只是尚未开始时的茫然，而是历经许多之后，仍未能获得彻底答案的疲惫\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是初始茫然，是走过后的疲惫\"\n        },\n        {\n          \"quote\": \"明明知道它很重要，却已经没有力气把它重新讲述一遍\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"声音回来了，却没有完整铺开\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他最舍不得的\",\n          \"point\": \"被当作自己人的日子\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"最舍不得\"\n        },\n        {\n          \"text\": \"回去未必能恢复原样\",\n          \"point\": \"受过的气还在\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"回去未必能恢复原样\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"fine\": [\n        {\n          \"quote\": \"每次爆发之后，紧张都没有完全解除，反而又形成新的压力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"祈祷开始变成意志\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"害怕还在，脚却已经往前走了\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他明知回去未必找回亲近\",\n          \"point\": \"忍不住盼一盼\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"明知回去未必找回亲近\"\n        },\n        {\n          \"text\": \"他不愿只凭希望回头\",\n          \"point\": \"先把日子过稳\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"害怕也不改主意\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"fine\": [\n        {\n          \"quote\": \"这份挺立也可以听成经历动摇后的主动选择\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它不要求人假装自己从未受过伤\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"昂扬没有一路直冲