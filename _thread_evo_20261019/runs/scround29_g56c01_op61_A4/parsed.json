      "first_established": "S11-1"
    },
    {
      "claim": "他愿意坦然坚持维护尊严，同时承认自己仍然脆弱、仍然舍不得过去。",
      "first_established": "S12-2"
    },
    {
      "claim": "他最终决定带着对旧日归属的怀念继续维护尊严，不再以怀念为由撤回自己的选择。",
      "first_established": "S13-4"
    }
  ]
}