      "S12-B3"
     ],
     "bars": "93-102",
     "at": 16
    },
    {
     "text": "话到句尾仍被牵住，像一口气迟迟落不下去",
     "after": 1,
     "from": [
      "S12-B3"
     ],
     "bars": "96-100",
     "at": 20
    }
   ],
   "notes": [
