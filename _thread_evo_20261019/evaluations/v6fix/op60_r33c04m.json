      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S05",
    "bars": "35–39",
    "relation": "正在面对",
    "items": [
     {
      "id": "S05-1",
      "text": "他终于不再全数遮掩，让对方感受到此前被自己藏住的那份深切需要。",
      "key": "他终于不再全数遮",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-1",
       "S04-2"
      ]
     },
     {
      "id": "S05-2",
      "text": "真正袒露之后，他反而忽然没了先前的把握，不知道自己是不是已经交出去太多。",
      "key": "真正袒露之后，他",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1",
       "S01-2"
      ]
     },
     {
      "id": "S05-3",
      "text": "他暂时松开了想把结果握稳的心思，不再逼着这一刻立刻变得确定。",
      "key": "他暂时松开了想把",
      "follows": false,
      "explains": [],
