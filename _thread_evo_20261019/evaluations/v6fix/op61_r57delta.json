      "rel": "引用"
     },
     {
      "from": "S08-1",
      "to": "S08-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "他仍留在刚才的怀念里，并没有接着为自己的去留辩解。",
      "key": "他仍留在刚才的怀",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1"
      ]
     },
     {
      "id": "S09-2",
      "text": "熟悉的安心短暂浮现后，眼下的距离又刺得他心里发紧，先前的疑问仍然悬着。",
      "key": "熟悉的安心短暂浮",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S08-2"
      ]
     }
    ],
    "because": [
     {
