     ],
     "emotion": "欢喜",
     "from": [
      "S02-3"
     ],
     "at": 8.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "人在船上舒服地漂着不急着靠岸，水和时间却一直在走",
