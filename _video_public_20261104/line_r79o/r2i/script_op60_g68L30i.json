       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因为他露出在意就退开，还是愿意跟他亲近，他这才慢慢放松下来",
       "keys": [
        "慢慢放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像紧挨着耳语连体温都融在一处，又像夏末微黏的暖风",
