{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"accent\": \"很想靠近\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"怕显得太需要，只敢露一点喜欢\",\n          \"accent\": \"只敢露一点喜欢\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"这点亲近很甜，下次能否更坦白还没把握\",\n          \"accent\": \"很甜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S01-3\"],\n          \"at\": 10\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像夏夜烟花迸开，光点慢慢飘落\",\n          \"after\": 0,\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–3\",\n          \"at\": 2\n        },\n        {\n          \"text\": \"像有话想说，怕一开口关系就会改变\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"像刚踏上船板，身体一瞬失重\",\n          \"after\": 2,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 12\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"开头和弦突然迸响，摇荡尚未成形\",\n          \"from\": [\"S01-B1\", \"S01-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没有因为他露出在意就退开\",\n          \"accent\": \"没有退开\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"仍愿意跟他亲近，他才渐渐放松下来\",\n          \"accent\": \"渐渐放松\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他也想顺势靠近，却怕太急弄坏眼下的自在\",\n          \"accent\": \"怕太急\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"两人待在一起这么好，他却想到这时刻会过去\",\n          \"accent\": \"这时刻会过去\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"还没分开，心里已先有一点舍不得\",\n          \"accent\": \"先有一点舍不得\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S02-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"两条声线贴得很近，像耳语，肩膀也相挨\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"也像老相识安静坐着，沉默不紧张，湿热的风贴着皮肤\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"脚下仿佛不用踩实，身体交给船底温柔托着\",\n          \"after\": 1,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"水一直在流，舒服地漂着，却不急着靠岸\",\n          \"after\": 3,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"柔软落音像温柔的刺，甜蜜里已有一点鼻酸\",\n          \"after\": 4,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7–11\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇荡先起，歌声随后才慢慢浮出\",\n          \"from\": [\"S02-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"4–5\"\n        },\n        {\n          \"text\": \"歌声短暂上涌，随后轻轻收回\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"12–16\"\n        },\n        {\n          \"text\": \"柔软的落音一下一下出现\",\n          \"from\": [\"S02-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"7–11\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不去想两个人以后会怎样\",\n          \"accent\": \"不去想以后\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"只想舒服地待在这份亲近里\",\n          \"accent\": \"舒服地待着\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他想说有多喜欢，也想问对方是否一样\",\n          \"accent\": \"是否一样\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S03-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"可没想好怎么开口，这念头就淡了\",\n          \"accent\": \"念头就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像说过重要的话，还沉在余韵里\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"亲密交谈后沉默很舒服，心却慢慢漂远\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"急着表达的念头冒头，很快又沉下去\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20–21\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"思绪像风吹碎的倒影，谈话仿佛碰到心结\",\n          \"after\": 3,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20–22\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声退后，旋绕的流动留下\",\n          \"from\": [\"S03-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"短促声音冒出，流动又绕远滞留\",\n          \"from\": [\"S03-B2\", \"S03-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"20–22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又让他满心欢喜\",\n          \"accent\": \"满心欢喜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想起上回明明想说，却没有开口\",\n          \"accent\": \"没有开口\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"这次几乎想把藏着的话全说出来\",\n          \"accent\": \"全说出来\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"盼对方喜欢自己不再小心收着的样子\",\n          \"accent\": \"不再小心收着\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"怕说太多让对方为难，连自在也弄丢，最后仍留了些话\",\n          \"accent\": \"仍留了些话\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"两道声线贴耳低语，细密花腔像水面光斑\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"高处像夕阳最后一道金光，亮得刺眼\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"也像深情到了喉咙口，颤抖着说不出\",\n          \"after\": 3,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"像不自觉握紧手，越想抱紧船舱越颠簸\",\n          \"after\": 3,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"美好仍在，水却像倒数，歌声越美越舍不得\",\n          \"after\": 4,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉歌声重返，装饰音更密更急\",\n          \"from\": [\"S04-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"高处长音颤动，亮起后渐渐收弱\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"30–34\"\n        },\n        {\n          \"text\": \"摇荡放慢，余音仍悬在空气里\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"32–34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"几次想说又收住，对方却仍愿意亲近\",\n          \"accent\": \"仍愿意亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"这回没藏住喜欢，对方已经看出他多在乎\",\n          \"accent\": \"看出他多在乎\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"被看出后心里发空，怕被嫌黏，连相处都拿不准\",\n          \"accent\": \"心里发空\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-2\", \"S05-3\"],\n          \"at\": 6\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像小船失去托举，漂进起雾的水域\",\n          \"after\": 2,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"耳语停了，人跌回内心，问幸福能维持多久\",\n          \"after\": 2,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"像松开紧握的手，终于深吸一口气\",\n          \"after\": 2,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"35–39\",\n          \"at\": 15\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"水波退去，只剩单薄旋律\",\n          \"from\": [\"S05-B1\", \"S05-B2\", \"S05-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他多在乎，相处却一点没变\",\n          \"accent\": \"一点没变\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他才又能像从前那样自在地待着\",\n          \"accent\": \"自在地待着\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"安静时仍想靠近，却怕自己要得太多\",\n          \"accent\": \"怕要得太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"对方不知他刚才多怕被嫌，他有点孤单\",\n          \"accent\": \"有点孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"他又猜，对方会不会也舍不得结束亲近\",\n          \"accent\": \"也舍不得结束\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像清凉月光照着水面，也想起童年初恋\",\n          \"after\": 1,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"低声像在说算了，却又忍不住放不下\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"说着说着，也不再努力显得若无其事\",\n          \"after\": 3,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"夜里独处，白天的好忽然泛酸，恍惚已成回忆\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"最亲近的人也进不了心里每个角落\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"气味、身体记忆、幻想、遗憾快感混在一起，舒服得失去方向\",\n          \"after\": 4,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 30\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉摇摆重现，伴奏变薄而细碎\",\n          \"from\": [\"S06-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"新歌清澈舒展，像一支朴素牧歌\",\n          \"from\": [\"S06-B1\", \"S06-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"40–50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"这些日子，对方总愿意跟他待在一起\",\n          \"accent\": \"总愿意\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他渐渐觉得，对方有时也需要他陪着\",\n          \"accent\": \"也需要他\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"跟他在一起，对方或许也能安心些\",\n          \"accent\": \"安心些\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"想到两人或许能互相依靠，他高兴得心口一紧\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"他盼对方需要陪伴时会想到自己，自己也能一直陪着\",\n          \"accent\": \"一直陪着\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"气味和身体感觉涌来，像反复回想一段关系\",\n          \"after\": 3,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"幻想、遗憾和快感混在一起，舒服得失去方向\",\n          \"after\": 3,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"明知正被卷进去，却暂时不想出来\",\n          \"after\": 4,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"美好还在，却听见时间正在经过\",\n          \"after\": 4,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉歌声重返，伴奏渐密，暗流上涌\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"低处沉重脉动，催着声音不断向前\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"上回无意露出心意，这回对方仍然亲近\",\n          \"accent\": \"仍然亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想主动些，大大方方地回应\",\n          \"accent\": \"大大方方\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他开始盼两人往后还能这样好很久\",\n          \"accent\": \"好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"可未来未必如此，他心里还是没底\",\n          \"accent\": \"还是没底\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"歌声像咏叹调般舒展，不必防卫和分析\",\n          \"after\": 1,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像重见阳光和风，身体轻快又有弹性\",\n          \"after\": 2,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"也像轻快的调情与回应\",\n          \"after\": 2,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"快乐的余温还在，心里已泛起怀念\",\n          \"after\": 3,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌句舒展明亮，情绪不断抬高\",\n          \"from\": [\"S08-B1\", \"S08-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"摇荡轻推，歌声上散后忽然停住\",\n          \"from\": [\"S08-B1\", \"S08-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"69–71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他怕对方哪天不再需要自己\",\n          \"accent\": \"不再需要自己\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"甚至连和他待在一起也会不自在\",\n          \"accent\": \"也会不自在\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他一下安静下来，不敢再往下想\",\n          \"accent\": \"不敢再往下想\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"可对方一直没退开，两人眼下仍然亲近\",\n          \"accent\": \"仍然亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S09-3\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"也许对方喜欢他在身边，他有点高兴\",\n          \"accent\": \"也许\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像话到要紧处突然顿住，两人对视屏息\",\n          \"after\": 2,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像阳光隔着薄雾，光还在却柔暗\",\n          \"after\": 2,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"听着自己的余响，问刚才是真的吗\",\n          \"after\": 3,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"望向夜空，美好大过愿望，不安暂时退开\",\n          \"after\": 4,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"前冲势头忽然收住，摇荡退到一旁\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"72–75\"\n        },\n        {\n          \"text\": \"轻颤与和弦悬在半空，声音渐暗\",\n          \"from\": [\"S09-B1\", \"S09-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"76–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他怕再猜下去毁了今天，先享受眼前亲近\",\n          \"accent\": \"先享受眼前亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"紧绷慢慢松开，心里亮得想笑也想哭\",\n          \"accent\": \"想笑也想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 6\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像绷着肩的人终于长呼一口气，胸腔打开\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"心事没解决，眼泪终于不必再忍住\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"清风拨开水浪，时间也短暂松了下来\",\n          \"after\": 1,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"身体失重，像灵魂飘在夏夜微风里，重担也碰不到自己\",\n          \"after\": 1,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"高处细音像银丝细雨，一串又像飞瀑入水\",\n          \"after\": 1,\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"80–83\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇荡忽被清风拨开，旋律短暂舒展\",\n          \"from\": [\"S10-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"高处细音如雨，清亮音流倾泻而下\",\n          \"from\": [\"S10-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"80–83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他需要对方，也觉得对方有时需要他\",\n          \"accent\": \"彼此需要\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"即使对方不需要，他仍愿意陪着\",\n          \"accent\": \"仍愿意陪着\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他不再藏喜欢，也不再觉得在乎有什么不好\",\n          \"accent\": \"不再藏喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\", \"S11-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"高兴得连害臊都顾不上了\",\n          \"accent\": \"顾不上害臊\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S11-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"可对方以后是否还愿他陪，不由他决定\",\n          \"accent\": \"不由他决定\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从梦里落回现实，终于说出自己的感情\",\n          \"after\": 2,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像浪潮将至，久候的期待终于得到满足\",\n          \"after\": 3,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"夕阳血红金亮，刺眼得让人想哭\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"像重返旧房，知道太多，熟悉的温柔更沉\",\n          \"after\": 4,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声不再收弱，厚重和弦托起旋律\",\n          \"from\": [\"S11-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"力量短暂悬起，像等待下一股浪潮\",\n          \"from\": [\"S11-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他顾不上对方是否也在乎，只想把能给的都给\",\n          \"accent\": \"把能给的都给\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"明知再用心也难保证以后仍好，还是想多陪一会儿\",\n          \"accent\": \"想多陪一会儿\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"高兴终于涌出来，他不再强迫自己收着喜欢\",\n          \"accent\": \"不再强迫自己收着\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-3\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像私语放大成天地共振，自己退到了后面\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像高烧般狂喜，也像久别重逢紧紧相拥\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"喉咙发紧，眼眶湿润，分不清想笑还是哭\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"像恳求着还想要更多，却始终不能满足\",\n          \"after\": 2,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"93–102\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉歌声放大，明亮开阔，一浪高过一浪\",\n          \"from\": [\"S12-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"旋律反复上伸，牵扯延迟后才释放\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"96–103\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"高兴过后，他更想听对方保证以后不变\",\n          \"accent\": \"保证以后不变\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可即使听到，时间仍过得快，真能一直这样吗\",\n          \"accent\": \"真能一直这样吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"起初怕自己的需要添负担，如今怕对方不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"连这样的亲近也会失去，少露心意会不会少疼些\",\n          \"accent\": \"会不会少疼些\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"他早装不回不在乎，藏回去反而更难受\",\n          \"accent\": \"反而更难受\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"幸福里渐渐掺进尖锐的苦涩\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像刚说了是，心里马上又问可是呢\",\n          \"after\": 2,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"脚步稳稳踩地，胸口却一沉再沉\",\n          \"after\": 4,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\",\n          \"at\": 15\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"乐句反复渐强，越往后越绷紧\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"明亮里渐添尖锐暗色，上方声音反复下落\",\n          \"from\": [\"S13-B2\", \"S13-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"107–110\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"最初不敢多露喜欢，如今两人仍然亲近\",\n          \"accent\": \"仍然亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"心里甜酸又舍不得，也不知道以后怎样\",\n          \"accent\": \"甜酸又舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-1\", \"S14-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他不再逼自己讨一句永远不变的保证\",\n          \"accent\": \"不再逼自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"喜欢已被对方看见，他就不往回藏\",\n          \"accent\": \"不往回藏\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S14-3\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"往后会怎样，等真的到了那时再说\",\n          \"accent\": \"到了那时再说\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从美梦醒来，还记得梦里的光\",\n          \"after\": 1,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111–115\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像男中音独自沉思，水花在夜空一闪\",\n          \"after\": 1,\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113–115\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"像铁锚落水，小船定住，也像整理衣服关门\",\n          \"after\": 3,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"尾声像隔着很远，回应开头悬着的话\",\n          \"after\": 4,\n          \"from\": [\"S14-B4\"],\n          \"bars\": \"113–116\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"浪头猛推后，终结句渐轻回望\",\n          \"from\": [\"S14-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"111–115\"\n        },\n        {\n          \"text\": \"细碎音符闪过，末尾和弦沉重落定并回应开头\",\n          \"from\": [\"S14-B2\", \"S14-B3\", \"S14-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"113–116\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "947576b1-0e20-46d0-b509-ecbf3a67c15d", "session_revision": 0, "session_ttl_max_hours": 6, "job_d