       "from": [
        "S12-1",
        "S12-B1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "明知再用心也没法保证以后还这么好，他仍嫌日子不够，想多陪对方一会儿。",
       "keys": [
        "没法保证以后还这么好",
        "想多陪对方一会儿"
       ],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "这份狂喜也像久别重逢：仿佛忽然抱紧对方、久久不愿松手；又像喉咙发紧、眼眶湿润，分不清想笑还是想哭。",
       "keys": [
        "久别重逢",
        "分不清想笑还是想哭"
       ],
       "from": [
        "S12-B2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "高兴终于整个涌出来，他不再强迫自己收着，只顾痛快地喜欢对方。",
       "keys": [
        "高兴终于整个涌出来",
        "痛快地喜欢对方"
       ],
       "from": [
        "S12-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声像恳求着还想要更多",
       "keys": [],
       "from": [
        "S12-B3"
       ],
       "bead": "S12-B3"
      },
      {
       "text": "那口气仿佛悬着，直到这里才释放",
       "keys": [],
       "from": [
        "S12-B3"
       ],
       "bead": "S12-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "高兴过后，他更想听对方说以后也不变；可就算听到了，越喜欢跟对方待着，越觉得时间过得快：真能一直这样吗？",
       "keys": [
