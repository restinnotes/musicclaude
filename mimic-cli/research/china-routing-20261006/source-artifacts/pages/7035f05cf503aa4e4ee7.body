    <script>
        window.homeRsaPublicKey = "-----BEGIN PUBLIC KEY-----\r\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAvp2NkeDK\/RZpayPRcXWS\r\nccNcjt6uLflePsPzu7UoNhUH\/+mU3+wMxorluSDjkX+VWOg0+IKeN0zVDPlnt7ze\r\nsZqrNCG\/2KemmSwVKYFz\/E2SvBkmtgprLFPFVjWgpi3\/\/n\/GpF+k6rjZBo9aFtZP\r\n5A+ZlJ92bjH6M+dWj8XGYuZQ+LXR0b0+LNbsJ5bsEBP1AM5L08I6RoGZrtYXuMLL\r\nzlE47n1ph8Tb1Fdrrg5TInRf1abo8NkOQi3C5jvr350O+u9eLD0r\/vZoI6K4eIAQ\r\nnmacThhZ3DdviVa92v94OpJdx2iy0VRLUp2NV\/7RXH+yFX1ZOM01fX0NiYmjD1L4\r\nRwIDAQAB\r\n-----END PUBLIC KEY-----";
        window.homeRsaEncryptor = null;

        window.getHomeRsaEncryptor = function() {
            if (window.homeRsaEncryptor) {
                return window.homeRsaEncryptor;
            }
            if (!window.homeRsaPublicKey || typeof JSEncrypt === 'undefined') {
                return null;
            }

            window.homeRsaEncryptor = new JSEncrypt();
            window.homeRsaEncryptor.setPublicKey(window.homeRsaPublicKey);
            return window.homeRsaEncryptor;
        };

        window.encryptHomeFormValue = function(value) {
            if (typeof value !== 'string' || !value) {
                return Promise.resolve('');
            }

            return Promise.resolve().then(function() {
                var encryptor = window.getHomeRsaEncryptor();
                if (!encryptor) {
                    throw new Error('rsa_encryptor_unavailable');
                }

                var encrypted = encryptor.encrypt(value);
                if (!encrypted) {
                    throw new Error('rsa_encrypt_failed');
                }

                return encrypted;
            });
        };

        $('.agree-cookie').click(function() {
            $(this).parents('.cookie').slideUp();
            localStorage.setItem('userInfo', 1);
        })
        $('.reject-cookie').click(function() {
            $(this).parents('.cookie').slideUp();
        })
        var cookie = 0;
        initCookieSection();
        function initCookieSection(){
            cookie = localStorage.getItem('userInfo');
            if(cookie){
                $('.cookie').hide()
            }
        };
