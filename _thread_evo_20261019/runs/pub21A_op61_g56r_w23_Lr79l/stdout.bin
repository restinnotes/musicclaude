 \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不停地往前赶，只是为了避免停下来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"只是为了不必停下来\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起那些亲近的时候\",\n          \"point\": \"还能照从前那样继续\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"有一阵真盼着\"\n        },\n        {\n          \"text\": \"可这么盼着\",\n          \"point\": \"要是没走，如今会怎样\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可这么盼着\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"只剩一个声音自己说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"只剩一个声音\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍不服气\",\n          \"point\": \"连过去开心的事都不敢多想\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"可连过去开心的事都不敢多想\"\n        },\n        {\n          \"text\": \"跟自己争得没了力气\",\n          \"point\": \"想到自己如今已不在那些人身边\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"跟自己争得没了力气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份安宁并不意味