      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "刚才仿佛近在心里的旧日生活又显得遥远，他想起那个一直答不出的疑问，心里沉了下去。",
      "key": "刚才仿佛近在心里",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-2",
       "S08-1",
       "S08-2"
      ]
     },
     {
      "id": "S09-2",
      "text": "他没力气继续想下去，却猛地有些心慌，过后依然不知道该怎么办。",
      "key": "他没力气继续想下",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-4",
       "S09-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S07-2",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S08-1",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S08-2",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S07-4",
      "to": "S09-2",
      "rel": "引用"
     },
     {
      "from": "S09-1",
      "to": "S09-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "216–225",
    "relation": "正在面对",
    "items": [
     {
      "id": "S10-1",
      "text": "他又记起当初那些忍下去的委屈，心里仍不好受，没法因为舍不得就当它们没有发生。",
      "key": "他又记起当初那些",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S07-3"
      ]
     },
     {
      "id": "S10-2",
      "text": "可旧日的好又零零碎碎地冒出来，让他连“走得对”这几个字都说不痛快。",
      "key": "可旧日的好又零零",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-3",
       "S03-2",
       "S06-2",
       "S10-1"
      ]
     },
     {
      "id": "S10-3",
      "text": "他想把这两边都想明白，想到后来只觉疲惫，不知道往后怎样才算真正安稳。",
      "key": "他想把这两边都想",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-1",
       "S10-2"
      ]
     }
    ],
    "because": [
     {
