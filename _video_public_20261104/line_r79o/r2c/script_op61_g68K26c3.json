        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "几次深呼吸后松了些，并非想通，只是抵抗累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
