{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"先向高处迸发，细碎的光点再缓缓飘落。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"先向高处\"\n        },\n        {\n          \"quote\": \"这里是刚刚踏上船板的感觉，还不是整个人已经安稳地交给规律起伏的水浪。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变，所以格外谨慎。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"正因太清楚\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现，自己竟\",\n          \"point\": \"想靠近这个人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"竟那么想\"\n        },\n        {\n          \"text\": \"他怕对方看出自己\",\n          \"point\": \"负担太重\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"有多需要这份亲近\"\n        },\n        {\n          \"text\": \"所以他只敢露出\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"所以他只敢\"\n        },\n        {\n          \"text\": \"这么一点亲近就\",\n          \"point\": \"下次能否更坦白\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还拿不准\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"沉默也不让人紧张。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"把身体交给船底温柔的托举。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"因为太喜欢眼前的东西，所以还没有失去，就已经生出一丝舍不得。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没失去就先舍不得\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有因他露出\",\n          \"point\": \"才渐渐放松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没有因他露出在意而退开\"\n        },\n        {\n          \"text\": \"他也想顺势靠得\",\n          \"point\": \"喜欢一度几乎藏不住\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一度\"\n        },\n        {\n          \"text\": \"可他怕太急会\",\n          \"point\": \"最后还是收住了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕太急会弄坏眼下的自在\"\n        },\n        {\n          \"text\": \"两个人待在一起\",\n          \"point\": \"这样的时刻总会过去\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"他却想到\"\n        },\n        {\n          \"text\": \"还没有分开，他就\",\n          \"point\": \"有一点舍不得\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"还没有分开，他就已经有一点舍不得\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"像说过一句重要的话以后，人还停留在那句话里面\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"身体还在这里，心却已经慢慢漂远。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"音乐并未走向悲剧，却在那份顺畅之中生出了阻力。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他难得不去琢磨\",\n          \"point\": \"舒服地待在这份亲近里\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"难得不去琢磨两个人往后会怎样\"\n        },\n        {\n          \"text\": \"他忽然想告诉对方\",\n          \"point\": \"有多喜欢这样待在一起\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"忽然\"\n        },\n        {\n          \"text\": \"他也想问对方\",\n          \"point\": \"念头就淡了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却没想好怎么开口\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"本来一句话已经够了，却忍不住再说一遍，又折回来补上更多细节。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这股情绪一瞬间像是完整地打开了，可音乐一边奋力向高处攀升，一边又渐渐收弱，并没有稳稳落下。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"自己也许还没有意识到在害怕什么，动作已经先透露了出来。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"熟悉的亲近再次\",\n          \"point\": \"想起上回没说出口的话\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"上回没说出口\"\n        },\n        {\n          \"text\": \"这回他几乎想\",\n          \"point\": \"把藏着的话全说出来\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"几乎；也盼对方喜欢自己坦白的样子\"\n        },\n        {\n          \"text\": \"他盼着说开能\",\n          \"point\": \"把眼下的好留久一点\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"却怕说得太多让对方为难\"\n        },\n        {\n          \"text\": \"他更怕两人原有\",\n          \"point\": \"留了些话没说\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"两人原有的自在\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"原来一直托着你的水波和摇晃，忽然像被抽掉了。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"人仿佛突然失去了脚下的支撑，连时间也松开了；像小船漂进一片起雾的水域，前路未卜。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"一个人从“我与你”的亲密中抽身，转而跌回自己的内心\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"前几次想说又收住\",\n          \"point\": \"没藏好喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"前几次想说又收住；不知不觉\"\n        },\n        {\n          \"text\": \"等他察觉\",\n          \"point\": \"看出他有多在乎\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"等他察觉\"\n        },\n        {\n          \"text\": \"可他心里空落落\",\n          \"point\": \"怎么跟对方待着都拿不准\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"心里空落落的\"\n        },\n        {\n          \"text\": \"他忍不住怕对方\",\n          \"point\": \"像隔了一层\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"连熟悉的亲近也\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"光线仿佛从暖金色的水面滑入古桥阴影，空气一下凉了\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像一个念头好不容易安静下来，却又回来：“算了”“但还是放不下”。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是哭泣或崩溃，只是不再努力显得完整。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不再努力显得完整\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方看出他有多在乎\",\n          \"point\": \"相处却一点没变\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\"