      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S05",
    "bars": "116–147",
    "relation": "正在面对",
    "items": [
     {
      "id": "S05-1",
      "text": "他舍不得少做那些旧日的讲究，因为其中还有他与从前相连的感觉。",
      "key": "他舍不得少做那些",
      "follows": false,
