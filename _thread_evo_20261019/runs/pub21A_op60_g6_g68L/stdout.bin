{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"有多需要这份亲近\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"太需要这份亲近\"\n        },\n        {\n          \"quote\": \"还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越清楚越小心\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"很想靠近对方\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"连自己都吓了一跳\"\n        },\n        {\n          \"text\": \"怕给对方太大负担\",\n          \"point\": \"只敢露一点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕给对方太大负担\"\n        },\n        {\n          \"text\": \"只是这一点亲近\",\n          \"point\": \"还不敢更坦白\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只是这一点亲近就很甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"没有因为他露出在意就退开\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"看出在意也没退\"\n        },\n        {\n          \"quote\": \"把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"怕太急弄坏眼下的自在而收住了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"怕弄坏眼下的自在\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \