19.936a6.4 6.4 0 0 0 9.28-6.72l-43.52-254.08 184.512-179.904a6.4 6.4 0 0 0-3.52-10.88l-255.104-37.12L517.76 147.904a6.4 6.4 0 0 0-11.52 0L392.192 379.072l-255.104 37.12a6.4 6.4 0 0 0-3.52 10.88L318.08 606.976l-43.584 254.08a6.4 6.4 0 0 0 9.28 6.72z"></path></svg><!--]--><!--v-if--><!--]--></i></span><span class="hh-rate__item"><i class="hh-icon hh-rate__icon is-active" style=""><!--[--><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M283.84 867.84 512 747.776l228.16 119.936a6.4 6.4 0 0 0 9.28-6.72l-43.52-254.08 184.512-179.904a6.4 6.4 0 0 0-3.52-10.88l-255.104-37.12L517.76 147.904a6.4 6.4 0 0 0-11.52 0L392.192 379.072l-255.104 37.12a6.4 6.4 0 0 0-3.52 10.88L318.08 606.976l-43.584 254.08a6.4 6.4 0 0 0 9.28 6.72z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" style="display:none;"><path fill="currentColor" d="M283.84 867.84 512 747.776l228.16 119.936a6.4 6.4 0 0 0 9.28-6.72l-43.52-254.08 184.512-179.904a6.4 6.4 0 0 0-3.52-10.88l-255.104-37.12L517.76 147.904a6.4 6.4 0 0 0-11.52 0L392.192 379.072l-255.104 37.12a6.4 6.4 0 0 0-3.52 10.88L318.08 606.976l-43.584 254.08a6.4 6.4 0 0 0 9.28 6.72z"></path></svg><!--]--><!--v-if--><!--]--></i></span><span class="hh-rate__item"><i class="hh-icon hh-rate__icon is-active" style=""><!--[--><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M283.84 867.84 512 747.776l228.16 119.936a6.4 6.4 0 0 0 9.28-6.72l-43.52-254.08 184.512-179.904a6.4 6.4 0 0 0-3.52-10.88l-255.104-37.12L517.76 147.904a6.4 6.4 0 0 0-11.52 0L392.192 379.072l-255.104 37.12a6.4 6.4 0 0 0-3.52 10.88L318.08 606.976l-43.584 254.08a6.4 6.4 0 0 0 9.28 6.72z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" style="display:none;"><path fill="currentColor" d="M283.84 867.84 512 747.776l228.16 119.936a6.4 6.4 0 0 0 9.28-6.72l-43.52-254.08 184.512-179.904a6.4 6.4 0 0 0-3.52-10.88l-255.104-37.12L517.76 147.904a6.4 6.4 0 0 0-11.52 0L392.192 379.072l-255.104 37.12a6.4 6.4 0 0 0-3.52 10.88L318.08 606.976l-43.584 254.08a6.4 6.4 0 0 0 9.28 6.72z"></path></svg><!--]--><!--v-if--><!--]--></i></span><!--]--><!--v-if--></div><div class="review-content" data-v-e77c4050>A good choice for direct sales, after using it my store profit increased by at least 10%!</div></div><!--]--></div></div></div><div class="component-faq" data-v-e77c4050 data-v-75cdd0e1><div class="content-max-1356" data-v-75cdd0e1><h2 class="component-faq-title" data-v-75cdd0e1>Frequently Asked Questions</h2><div class="hh-collapse component-faq-list" data-v-75cdd0e1><!--[--><!--[--><div class="hh-collapse-item" data-v-75cdd0e1><button id="hh-collapse-head-8" class="hh-collapse-item__header" aria-expanded="false" aria-controls="hh-collapse-content-8" aria-describedby="hh-collapse-content-8" tabindex="0" type="button"><!--[--><h3 data-v-75cdd0e1><!--[-->1、What is HandHunt? <!--]--></h3><!--]--><!--[--><i class="hh-icon hh-collapse-item__arrow" style=""><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M340.864 149.312a30.592 30.592 0 0 0 0 42.752L652.736 512 340.864 831.872a30.592 30.592 0 0 0 0 42.752 29.12 29.12 0 0 0 41.728 0L714.24 534.336a32 32 0 0 0 0-44.672L382.592 149.376a29.12 29.12 0 0 0-41.728 0z"></path></svg><!--]--></i><!--]--></button><div id="hh-collapse-content-8" role="region" class="hh-collapse-item__wrap" aria-hidden="true" aria-labelledby="hh-collapse-head-8" style="display:none;"><div class="hh-collapse-item__content"><!--[--><div style="white-space:pre-line;" data-v-75cdd0e1><!--[--><div data-v-e77c4050><ul data-v-e77c4050><li data-v-e77c4050>HandHunt is a one-stop service platform for Chinese handmade and customized products. You can design, buy and sell any Chinese handmade and customized products here. <ul data-v-e77c4050><li data-v-e77c4050>We provide customized goods services, whether it&#39;s clothing, jewelry, or home furnishings. As long as you have a need, we can try our best to fulfill it. For specific customization details, please feel free to contact our customer service for detailed consultation.</li><li data-v-e77c4050>We also provide customized goods services, whether it&#39;s clothing, jewelry, or home furnishings. As long as you have a need, we can try our best to fulfill it. For specific customization details, please feel free to contact our customer service for detailed consultation.</li><li data-v-e77c4050>One-stop service: covering your favorite products from Taobao, 1688, and more, we can easily purchase them for you. With a deep understanding of the Chinese market, we provide you with more competitive prices. Efficient logistics ensures the safe and timely delivery of goods. We always attach great importance to the needs of every customer and are committed to providing a worry-free shopping experience throughout the process.</li></ul></li><li data-v-e77c4050>HandHunt, giving you more choices and more savings! At the same time, it also allows your creativity and personality to be fully expressed.</li></ul></div><!--]--></div><!--]--></div></div></div><div class="hh-collapse-item" data-v-75cdd0e1><button id="hh-collapse-head-9" class="hh-collapse-item__header" aria-expanded="false" aria-controls="hh-collapse-content-9" aria-describedby="hh-collapse-content-9" tabindex="0" type="button"><!--[--><h3 data-v-75cdd0e1><!--[-->2、Will the goods be delivered to me once I have paid for them? Why do I not need to fill in a shipping address when I make a purchase?<!--]--></h3><!--]--><!--[--><i class="hh-icon hh-collapse-item__arrow" style=""><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M340.864 149.312a30.592 30.592 0 0 0 0 42.752L652.736 512 340.864 831.872a30.592 30.592 0 0 0 0 42.752 29.12 29.12 0 0 0 41.728 0L714.24 534.336a32 32 0 0 0 0-44.672L382.592 149.376a29.12 29.12 0 0 0-41.728 0z"></path></svg><!--]--></i><!--]--></button><div id="hh-collapse-content-9" role="region" class="hh-collapse-item__wrap" aria-hidden="true" aria-labelledby="hh-collapse-head-9" style="display:none;"><div class="hh-collapse-item__content"><!--[--><div style="white-space:pre-line;" data-v-75cdd0e1><!--[--><div data-v-e77c4050>Not all the products on Handhunt.ai are in stock. Our website is an agent website that helps you purchase in China. Therefore, we need to first purchase the goods to our warehouse and help you inspect the goods. After confirming that there are no errors, we will then ask you to fill in the shipping address.
			You will need to pay twice during the process from placing your order to receiving the goods:
			1. Your first payment is for the cost of purchasing the goods and transporting them to our warehouse.
			2. Your second payment is for the cost of international logistics. This includes the logistics costs incurred after we have assisted you in confirming that the quality of the goods is satisfactory, and the goods are sent from our warehouse to your designated address, as well as any customs duties that may be applicable</div><!--]--></div><!--]--></div></div></div><div class="hh-collapse-item" data-v-75cdd0e1><button id="hh-collapse-head-10" class="hh-collapse-item__header" aria-expanded="false" aria-controls="hh-collapse-content-10" aria-describedby="hh-collapse-content-10" tabindex="0" type="button"><!--[--><h3 data-v-75cdd0e1><!--[-->3、Why is the international shipping cost so expensive in the end, exceeding my expectations, even though the goods I bought are cheap?<!--]--></h3><!--]--><!--[--><i class="hh-icon hh-collapse-item__arrow" style=""><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M340.864 149.312a30.592 30.592 0 0 0 0 42.752L652.736 512 340.864 831.872a30.592 30.592 0 0 0 0 42.752 29.12 29.12 0 0 0 41.728 0L714.24 534.336a32 32 0 0 0 0-44.672L382.592 149.376a29.12 29.12 0 0 0-41.728 0z"></path></svg><!--]--></i><!--]--></button><div id="hh-collapse-content-10" role="region" class="hh-collapse-item__wrap" aria-hidden="true" aria-labelledby="hh-collapse-head-10" style="display:none;"><div class="hh-collapse-item__content"><!--[--><div style="white-space:pre-line;" data-v-75cdd0e1><!--[--><div data-v-e77c4050>International logistics fees are calculated based on the weight and size of the goods. Apart from customs duties, the fees are calculated independently of the value of the goods. Therefore, we recommend that you choose goods with a smaller size and weight for air parcels to avoid high shipping costs.
			Due to the large number of categories on our site, the product dimensions and weight automatically filled in by the website are for reference only and are not used as the basis for calculating the final international parcel weight. If you need to obtain detailed weight and size information for the goods, please contact our customer service for a free consultation.
			If you need to send a large-sized (longer side over 45 cm) or heavy (more than 12 kg) package, we also provide shipping, rail and land transport, and the destination can be Amazon&#39;s warehouse or a private address. The price for shipping via these methods is much lower than air freight, but the delivery time will be longer, usually around 30-35 days. The cost calculation for non-air freight is more complicated, so please contact our customer service for advice.</div><!--]--></div><!--]--></div></div></div><div class="hh-collapse-item" data-v-75cdd0e1><button id="hh-collapse-head-11" class="hh-collapse-item__header" aria-expanded="false" aria-controls="hh-collapse-content-11" aria-describedby="hh-collapse-content-11" tabindex="0" type="button"><!--[--><h3 data-v-75cdd0e1><!--[-->4、Are the sellers on Handhunt.ai legit? How can I trust you?<!--]--></h3><!--]--><!--[--><i class="hh-icon hh-collapse-item__arrow" style=""><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M340.864 149.312a30.592 30.592 0 0 0 0 42.752L652.736 512 340.864 831.872a30.592 30.592 0 0 0 0 42.752 29.12 29.12 0 0 0 41.728 0L714.24 534.336a32 32 0 0 0 0-44.672L382.592 149.376a29.12 29.12 0 0 0-41.728 0z"></path></svg><!--]--></i><!--]--></button><div id="hh-collapse-content-11" role="region" class="hh-collapse-item__wrap" aria-hidden="true" aria-labelledby="hh-collapse-head-11" style="display:none;"><div class="hh-collapse-item__content"><!--[--><div style="white-space:pre-line;" data-v-75cdd0e1><!--[--><div data-v-e77c4050>We are an agent platform that helps you make purchases in China. Currently, the two platforms we support, Taobao and 1688, both conduct reviews of the authenticity of sellers, and we also review various merchant ratings before you place an order, so you don&#39;t need to worry about the merchant being an illegal merchant.
			We also verify the quality of the goods. If there are problems with the quality or the merchant fails to deliver, we will help you get a refund as a priority to ensure the safety of your funds from multiple aspects.
			However, you should be aware that due to the particularity of international trade, goods that can be legally sold in China do not mean that they can pass through the customs of China or your shipping destination. Please make your own judgment before placing an order. Handhunt.ai does not assume any responsibility for goods that cannot be delivered or returned due to legal reasons such as seizure by customs.</div><!--]--></div><!--]--></div></div></div><div class="hh-collapse-item" data-v-75cdd0e1><button id="hh-collapse-head-12" class="hh-collapse-item__header" aria-expanded="false" aria-controls="hh-collapse-content-12" aria-describedby="hh-collapse-content-12" tabindex="0" type="button"><!--[--><h3 data-v-75cdd0e1><!--[-->5、What if the product I want to buy cannot be found on your website? Can I purchase it in bulk?<!--]--></h3><!--]--><!--[--><i class="hh-icon hh-collapse-item__arrow" style=""><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M340.864 149.312a30.592 30.592 0 0 0 0 42.752L652.736 512 340.864 831.872a30.592 30.592 0 0 0 0 42.752 29.12 29.12 0 0 0 41.728 0L714.24 534.336a32 32 0 0 0 0-44.672L382.592 149.376a29.12 29.12 0 0 0-41.728 0z"></path></svg><!--]--></i><!--]--></button><div id="hh-collapse-content-12" role="region" class="hh-collapse-item__wrap" aria-hidden="true" aria-labelledby="hh-collapse-head-12" style="display:none;"><div class="hh-collapse-item__content"><!--[--><div style="white-space:pre-line;" data-v-75cdd0e1><!--[--><div data-v-e77c4050>We can help you purchase any product that can be exported within China, as well as custom-made products. Therefore, in addition to Taobao or 1688, we can also help you find or purchase any product. You can rest assured to contact our online customer service, and we will do our best to help you make the purchase.
			If you need to import large quantities of goods to your country, you are also welcome to contact us. In addition to the current small parcel e-commerce model of our site, we can also handle professional customs matters for you. We also support traditional methods of completing transactions such as letters of credit, and can provide pro forma invoices, regular invoices, customs declaration documents, and delivery via DAP, DPP, etc. according to your needs.</div><!--]--></div><!--]--></div></div></div><div class="hh-collapse-item" data-v-75cdd0e1><button id="hh-collapse-head-13" class="hh-collapse-item__header" aria-expanded="false" aria-controls="hh-collapse-content-13" aria-describedby="hh-collapse-content-13" tabindex="0" type="button"><!--[--><h3 data-v-75cdd0e1><!--[-->6、Are the merchant&#39;s photos taken on the spot? <!--]--></h3><!--]--><!--[--><i class="hh-icon hh-collapse-item__arrow" style=""><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M340.864 149.312a30.592 30.592 0 0 0 0 42.752L652.736 512 340.864 831.872a30.592 30.592 0 0 0 0 42.752 29.12 29.12 0 0 0 41.728 0L714.24 534.336a32 32 0 0 0 0-44.672L382.592 149.376a29.12 29.12 0 0 0-41.728 0z"></path></svg><!--]--></i><!--]--></button><div id="hh-collapse-content-13" role="region" class="hh-collapse-item__wrap" aria-hidden="true" aria-labelledby="hh-collapse-head-13" style="display:none;"><div class="hh-collapse-item__content"><!--[--><div style="white-space:pre-line;" data-v-75cdd0e1><!--[--><div data-v-e77c4050>You can directly view the Hot Sellers of different platforms through HandHunt, including the Hot Sellers of Etsy/Temu/Aliexpess/Shopify/Amazon, and you can enter keywords or upload images to search for the sources.</div><!--]--></div><!--]--></div></div></div><div class="hh-collapse-item" data-v-75cdd0e1><button id="hh-collapse-head-14" class="hh-collapse-item__header" aria-expanded="false" aria-controls="hh-collapse-content-14" aria-describedby="hh-collapse-content-14" tabindex="0" type="button"><!--[--><h3 data-v-75cdd0e1><!--[-->7、Does HandHunt offer discount or wholesale? <!--]--></h3><!--]--><!--[--><i class="hh-icon hh-collapse-item__arrow" style=""><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M340.864 149.312a30.592 30.592 0 0 0 0 42.752L652.736 512 340.864 831.872a30.592 30.592 0 0 0 0 42.752 29.12 29.12 0 0 0 41.728 0L714.24 534.336a32 32 0 0 0 0-44.672L382.592 149.376a29.12 29.12 0 0 0-41.728 0z"></path></svg><!--]--></i><!--]--></button><div id="hh-collapse-content-14" role="region" class="hh-collapse-item__wrap" aria-hidden="true" aria-labelledby="hh-collapse-head-14" style="display:none;"><div class="hh-collapse-item__content"><!--[--><div style="white-space:pre-line;" data-v-75cdd0e1><!--[--><div data-v-e77c4050>Some products on the HandHunt platform are set at a range price, and when you buy a certain quantity you can enjoy a special offer or discount, you can see the price corresponding to different purchase quantities on the product details page.</div><!--]--></div><!--]--></div></div></div><div class="hh-collapse-item" data-v-75cdd0e1><button id="hh-collapse-head-15" class="hh-collapse-item__header" aria-expanded="false" aria-controls="hh-collapse-content-15" aria-describedby="hh-collapse-content-15" tabindex="0" type="button"><!--[--><h3 data-v-75cdd0e1><!--[-->8、Does HandHunt have a minimum order quantity? <!--]--></h3><!--]--><!--[--><i class="hh-icon hh-collapse-item__arrow" style=""><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M340.864 149.312a30.592 30.592 0 0 0 0 42.752L652.736 512 340.864 831.872a30.592 30.592 0 0 0 0 42.752 29.12 29.12 0 0 0 41.728 0L714.24 534.336a32 32 0 0 0 0-44.672L382.592 149.376a29.12 29.12 0 0 0-41.728 0z"></path></svg><!--]--></i><!--]--></button><div id="hh-collapse-content-15" role="region" class="hh-collapse-item__wrap" aria-hidden="true" aria-labelledby="hh-collapse-head-15" style="display:none;"><div class="hh-collapse-item__content"><!--[--><div style="white-space:pre-line;" data-v-75cdd0e1><!--[--><div data-v-e77c4050>HandHunt&#39;s POD customised items and AI customised items start from one piece, but if you purchase 1688 and Taobao items, you need to follow the supplier&#39;s MOQ rules, you can see the instructions on the item detail page.</div><!--]--></div><!--]--></div></div></div><div class="hh-collapse-item" data-v-75cdd0e1><button id="hh-collapse-head-16" class="hh-collapse-item__header" aria-expanded="false" aria-controls="hh-collapse-content-16" aria-describedby="hh-collapse-content-16" tabindex="0" type="button"><!--[--><h3 data-v-75cdd0e1><!--[-->9、How long will it take to receive my item? <!--]--></h3><!--]--><!--[--><i class="hh-icon hh-collapse-item__arrow" style=""><!--[--><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path fill="currentColor" d="M340.864 149.312a30.592 30.592 0 0 0 0 42.752L652.736 512 340.864 831.872a30.592 30.592 0 0 0 0 42.752 29.12 29.12 0 0 0 41.728 0L714.24 534.336a32 32 0 0 0 0-44.672L382.592 149.376a29.12 29.12 0 0 0-41.728 0z"></path></svg><!--]--></i><!--]--></button><div id="hh-collapse-content-16" role="region" class="hh-collapse-item__wrap" aria-hidden="true" aria-labelledby="hh-collapse-head-16" style="display:none;"><div class="hh-collapse-item__content"><!--[--><div style="white-space:pre-line;" data-v-75cdd0e1><!--[--><div data-v-e77c4050>· Once you place an order and make the payment, we will purchase the item for you on the next working day. After the seller ships the item, it usually takes 5-7 days for the item to arrive at our warehouse from the seller.
· If you decide to ship the items stored in our warehouse, after you combine the packages, we will provide you with a shipping quote within 2 working days. You can check the shipping calculator for a reference quote on international shipping fees.
· Please note that the above are estimated shipping times only. Shipping times may be extended due to holidays, seller efficiency, force majeure, and other factors. We will strive to provide you with faster and more reliable shipping solutions.</div><!--]--></div><!--]--></div></div></div><!--]--><!--]--></div></div></div><div class="footer-cta-wrap flex flex-col justify-center" data-v-e77c4050><h2 class="title" data-v-e77c4050>Browse Hot Selling Product Source And Start Shipping!</h2><a class="cta-btn" href="/customize/etsy-product" data-v-e77c4050>View Hot Products</a></div></div></div><footer class="layout-footer" data-v-aaad6a58 data-v-219f9cb6><div class="content-max-1356" style="overflow:hidden;" data-v-219f9cb6><div class="hh-row is-justify-space-around" style="margin-left:-15px;margin-right:-15px;" data-v-219f9cb6><!--[--><div class="hh-col hh-col-6 is-guttered" style="padding-right:15px;padding-left:15px;" data-v-219f9cb6><!--[--><div class="layout-footer-sub" data-v-219f9cb6>Customer Service</div><a href="/manual" class="layout-footer-link" data-v-219f9cb6>User Manual</a><a href="/cdn-cgi/l/email-protection#e192849397888284a184858ccf89808f8589948f95cf8088dec7808c91da838e8598dca28984828ac18e9495c195898892c192889584dbc18995959192dbcece89808f8589948f95cf8088ce" class="layout-footer-link" data-v-219f9cb6>Contact Us</a><!--]--></div><div class="hh-col hh-col-6 is-guttered" style="padding-right:15px;padding-left:15px;" data-v-219f9cb6><!--[--><div class="layout-footer-sub" data-v-219f9cb6>Shopping Guide</div><a href="/manual/what-is-purchasing-agent-service-what-is-the-process" class="layout-footer-link" data-v-219f9cb6>Shopping Agent Process</a><a href="/manual/what-is-consolidation-shipping-service" class="layout-footer-link" data-v-219f9cb6>Consol Shipping</a><!--]--></div><div class="hh-col hh-col-6 is-guttered" style="padding-right:15px;padding-left:15px;" data-v-219f9cb6><!--[--><div class="layout-footer-sub" data-v-219f9cb6>Policy</div><a href="/manual/in