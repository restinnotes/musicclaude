{"completed": true, "response": "<escape>{\n  \"status\": \"complete\",\n  \"base_route\": \"R3\",\n  \"segments\": [\n    {\n      \"sec\": \"S01\",\n      \"relation\": \"正在面对\",\n      \"items\": [\n        {\n          \"id\": \"S01-I1\",\n          \"text\": \"他不肯再委屈自己去换取原来的归属，如今已经不在那种熟悉的生活里了。\",\n          \"cite\": [],\n          \"covers\": [\"S01-B5\"]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"relation\": \"正在面对\",\n      \"items\": []\n    },\n    {\n      \"sec\": \"S03\",\n      \"relation\": \"没在想\",\n      \"items\": []\n    },\n    {\n      \"sec\": \"S04\",\n      \"relation\": \"正在面对\",\n      \"items\": []\n    },\n    {\n      \"sec\": \"S05\",\n      \"relation\": \"正在面对\",\n      \"items\": []\n    },\n    {\n      \"sec\": \"S06\",\n      \"relation\": \"正在面对\",\n      \"items\": []\n    },\n    {\n      \"sec\": \"S07\",\n      \"relation\": \"还说不清\",\n      \"items\": [\n        {\n          \"id\": \"S07-I1\",\n          \"text\": \"他开始担心，自己是不是真的能一直承受失去那份归属的代价。\",\n          \"cite\": [\"S01-I1\"],\n          \"covers\": []\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"relation\": \"没在想\",\n      \"items\": []\n    },\n    {\n      \"sec\": \"S09\",\n      \"relation\": \"还说不清\",\n      \"items\": []\n    },\n    {\n      \"sec\": \"S10\",\n      \"relation\": \"正在面对\",\n      \"items\": [\n        {\n          \"id\": \"S10-I1\",\n          \"text\": \"他渐渐分清，自己舍不得的是从前的亲近和安稳，并不是那种要靠委屈自己才能留下来的日子。\",\n          \"cite\": [\"S01-I1\"],\n          \"covers\": []\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"relation\": \"正在面对\",\n      \"items\": [\n        {\n          \"id\": \"S11-I1\",\n          \"text\": \"他开始盼着，以后还能拥有一份亲近和安稳，不必再靠委屈自己换来；只是他不知道这样的生活是不是真的会有。\",\n          \"cite\": [\"S07-I1\", \"S10-I1\"],\n          \"covers\": []\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"relation\": \"正在面对\",\n      \"items\": []\n    },\n    {\n      \"sec