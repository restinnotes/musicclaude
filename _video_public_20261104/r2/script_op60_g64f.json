        "更坦白"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "话还没出口，他先沉默了几秒；越清楚想说什么，越怕关系因此改变",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    }
   ]
  },
  {
