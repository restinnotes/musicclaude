\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"一想到再也不能\",\n          \"point\": \"再也不能像从前那样自在地过日子\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"再也\"\n        },\n        {\n          \"text\": \"舍不得一冒出来\",\n          \"point\": \"提醒自己受过的那些气\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"赶紧\"\n        },\n        {\n          \"text\": \"他怕自己一心软\",\n          \"point\": \"忘了当初为什么要离开\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一心软\"\n        },\n        {\n          \"text\": \"可他还是不甘心\",\n          \"point\": \"连好日子也丢掉\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可他还是不甘心\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"温柔得让人心颤，也刺痛得让人绝望：越怀念，越能感觉它与眼前处境的距离。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越怀念，越被距离刺痛\"\n        },\n        {\n          \"quote\": \"那一刻的轻松可以是真的，并非假装；只是它没有替心里的事找到答案。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像多个人在耳边低声絮语，彼此缠绕，找不到出口\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"心里还憋着气\",\n          \"point\": \"有人把他当自己人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"竟高兴了一会儿\"\n        },\n        {\n          \"text\": \"可那点高兴还没退\",\n          \"point\": \"离开就一定更好吗\",\n    