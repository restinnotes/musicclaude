.cloud.capitalone.com/site/api/consent-banner/global-consent-banner"},"_meta":{"paramsInfo":{"document":"/content/documents/wcm/consent-banner/global-consent-banner"},"params":{"document":"/content/documents/wcm/consent-banner/global-consent-banner","com.onehippo.cms7.targeting.TargetingParameterUtil.hide":"off"},"hidden":false},"_links":{"componentRendering":{"href":""},"self":{"href":"","type":"external"}}}],"xtype":"hst.vbox","_meta":{"params":{}},"_links":{"componentRendering":{"href":""},"self":{"href":"","type":"external"}}}],"_meta":{"definitionId":"hst:pages/article","params":{}},"_links":{"componentRendering":{"href":""},"self":{"href":"","type":"external"}},"pageTestingEnabled":false},"content":{"u59b88a8918364faaae69f4518d88c357":{"id":"59b88a89-1836-4faa-ae69-f4518d88c357","_meta":{},"_links":{"site":{"href":"/site/learn-grow/money-management/capital-one-shopping","type":"internal"}},"name":"capital-one-shopping","displayName":"Meet Capital One Shopping","calculatorCompound":null,"modifiedDate":"2026-03-12T12:00:00Z","openGraphTags":null,"additionalHeroImageStyling":{"name":"wcm:additionalHeroImageStyling","displayName":"wcm:additionalHeroImageStyling","imagePosition":"","contentType":"wcm:ImageStyling"},"eyebrow":"","contentType":"article","metadata":[{"key":"primaryCategory","value":[{"code":"PE8OQJHYP","name":"Money Management"}]},{"key":"primaryTopics","value":[{"code":"PE97R1LPT","name":"Spending"},{"code":"PE9YGE15","name":"Digital Money Management"}]},{"key":"contentType","value":[{"code":"article","name":"Article"}]},{"key":"intent","value":[{"code":"PE8NSZMNI","name":"Conversion"}]},{"key":"strategy","value":[{"code":"PE8N0U4VY","name":"Motivate"}]},{"key":"product","value":[{"code":"capital-one-shopping","name":"Capital One Shopping"}]},{"key":"producer","value":[{"code":"Card","name":"Card"}]},{"key":"audience","value":[{"code":"PEA5GP15","name":"Upmarket Heavy Spender"},{"code":"PEA6N8C4S","name":"New to Credit"},{"code":"Credit Builder","name":"Credit Builder"},{"code":"Near Prime","name":"Near Prime"},{"code":"Affluent","name":"Affluent"}]}],"primaryCategory":"PE8OQJHYP","publishDate":"2026-03-12T12:00:00Z","relatedProducts":null,"relatedArticles":[{"articleImage":{"name":"wcm:articleImage","displayName":"wcm:articleImage","containImage":false,"image":{"$ref":"/content/uca09f2c262d94512bd36153f34486eab"},"altText":"A woman uses Capital One Shopping on her laptop to find the best deal while shopping online.","imageUrl":"","caption":"","backgroundColor":"","compoundType":"wcm:Image","contentType":"wcm:Image"},"headline":"How Capital One makes shopping easier","shortHeadline":"Digital shopping features","publishDate":"2025-10-30T12:00:00Z","readTime":"3","subHeadline":"Get the most for your money, your rewards and your time when you shop with a Capital One credit card.","primaryCategory":"PE8OQJHYP","primaryTopics":["PE9Z90KSY","PE97R1LPT"],"tags":null,"buttons":[],"contentType":"article","featuredArticle":false,"hippoIdentifier":"5483d159-cc9e-40ed-8b30-212b1354b2d7","location":null,"eventDate":null,"hideDate":false,"metadata":[{"key":"primaryCategory","value":[{"code":"PE8OQJHYP","name":"Money Management"}]},{"key":"primaryTopics","value":[{"code":"PE9Z90KSY","name":"Credit"},{"code":"PE97R1LPT","name":"Spending"}]},{"key":"contentType","value":[{"code":"article","name":"Article"}]},{"key":"intent","value":[{"code":"PE8NQ7C4S","name":"Awareness"}]},{"key":"strategy","value":[{"code":"PE8N0U4VY","name":"Motivate"}]},{"key":"product","value":[{"code":"capital-one-shopping","name":"Capital One Shopping"},{"code":"P7P2BJESH","name":"Eno"}]},{"key":"producer","value":[{"code":"Digital","name":"Digital"}]},{"key":"audience","value":[{"code":"PEADZ04VY","name":"All Personas"}]}],"articleUrl":"/site/learn-grow/money-management/capital-one-digital-shopping-features/"},{"articleImage":{"name":"wcm:articleImage","displayName":"wcm:articleImage","containImage":false,"image":{"$ref":"/content/u40ccffca6d284503ac6e7c24c6e18e8b"},"altText":"A person holds a bouquet of flowers outside a flower market.","imageUrl":"","caption":"","backgroundColor":"","compoundType":"wcm:Image","contentType":"wcm:Image"},"headline":"How to redeem Capital One rewards for everyday expenses","shortHeadline":"Redeeming Capital One rewards","publishDate":"2026-02-26T13:00:00Z","readTime":"6","subHeadline":"","primaryCategory":"PE8OQJHYP","primaryTopics":["PE9Z90KSY"],"tags":null,"buttons":[],"contentType":"article","featuredArticle":false,"hippoIdentifier":"94422aa8-5c8e-4f55-a277-4c6347a1d3da","location":null,"eventDate":null,"hideDate":false,"metadata":[{"key":"primaryCategory","value":[{"code":"PE8OQJHYP","name":"Money Management"}]},{"key":"primaryTopics","value":[{"code":"PE9Z90KSY","name":"Credit"}]},{"key":"contentType","value":[{"code":"article","name":"Article"}]},{"key":"intent","value":[{"code":"PE8NS48UU","name":"Consideration"}]},{"key":"strategy","value":[{"code":"PE8N5SKG4","name":"Educate"}]},{"key":"product","value":[{"code":"capital-one-travel","name":"Capital One Travel"},{"code":"P7QTS34VY","name":"Quicksilver"},{"code":"P7E06R15","name":"Savor"},{"code":"P7QVIOKG4","name":"Venture"}]},{"key":"producer","value":[{"code":"Card","name":"Card"}]},{"key":"audience","value":[{"code":"Credit Builder","name":"Credit Builder"},{"code":"Near Prime","name":"Near Prime"}]}],"articleUrl":"/site/learn-grow/money-management/redeem-rewards-for-expenses/"},{"articleImage":{"name":"wcm:articleImage","displayName":"wcm:articleImage","containImage":false,"image":{"$ref":"/content/u94213c2bce104cc68d06f32beed608b4"},"altText":"A person in a living room opens a box from Amazon.com with new shoes inside.","imageUrl":"","caption":"","backgroundColor":"","compoundType":"wcm:Image","contentType":"wcm:Image"},"headline":"Use your Capital One or Discover rewards at Amazon.com","shortHeadline":"Use your rewards at Amazon.com","publishDate":"2026-02-12T13:00:00Z","readTime":"3","subHeadline":"","primaryCategory":"PE8OQJHYP","primaryTopics":["PE9Z90KSY","PE97R1LPT"],"tags":null,"buttons":[],"contentType":"article","featuredArticle":false,"hippoIdentifier":"27e26ac3-6de9-4adc-8b20-b9e499fc7fc9","location":null,"eventDate":null,"hideDate":false,"metadata":[{"key":"primaryCategory","value":[{"code":"PE8OQJHYP","name":"Money Management"}]},{"key":"primaryTopics","value":[{"code":"PE9Z90KSY","name":"Credit"},{"code":"PE97R1LPT","name":"Spending"}]},{"key":"contentType","value":[{"code":"article","name":"Article"}]},{"key":"intent","value":[{"code":"PE8NUZIVK","name":"Education"}]},{"key":"strategy","value":[{"code":"PE8N5SKG4","name":"Educate"}]},{"key":"product","value":[{"code":"capital-one-travel","name":"Capital One Travel"},{"code":"pre-approval","name":"Pre-approval"},{"code":"lto-offers-partnership","name":"LTO Offers/Partnership"}]},{"key":"producer","value":[{"code":"Card","name":"Card"}]},{"key":"audience","value":[{"code":"PEA5GP15","name":"Upmarket Heavy Spender"},{"code":"PEA6N8C4S","name":"New to Credit"},{"code":"Credit Builder","name":"Credit Builder"},{"code":"Near Prime","name":"Near Prime"},{"code":"Affluent","name":"Affluent"}]}],"articleUrl":"/site/learn-grow/money-management/use-capital-one-rewards-at-amazon/"}],"noFollow":false,"noIndex":false,"secondaryCategory":"","secondaryTopics":[],"subHeadline":"","metaKeywords":"","canonicalUrl":"https://www.capitalone.com/learn-grow/money-management/capital-one-shopping/","jsonld":"","video":"","keywordDriven":true,"shortHeadline":"Meet Capital One Shopping","articleImage":{"name":"wcm:articleImage","displayName":"wcm:articleImage","containImage":false,"image":{"$ref":"/content/ub4d72d7b69f0415bb927ef4b7174f426"},"altText":"Child holding a package","imageUrl":"","caption":"","backgroundColor":"","compoundType":"wcm:Image","contentType":"wcm:Image"},"socialMediaImage":{"$ref":"/content/ub4d72d7b69f0415bb927ef4b7174f426"},"ctaBanner":null,"siteCatalyst":{"name":"wcm:siteCatalyst","displayName":"wcm:siteCatalyst","level1":"card","level2":"article","level3":"learn_and_grow","level5":"","level4":"capital_one_shopping","contentType":"wcm:SiteCatalyst"},"articleBody":[{"name":"wcm:articleBody","displayName":"wcm:articleBody","body":{"contentType":"hippostd:html","value":"\u003Cp>Saving money while shopping online is always better when it&#8217;s easy. And Capital One Shopping makes finding great deals online a breeze. It instantly finds and tests coupon codes, searches retailers for better prices and notifies you when prices drop. It even lets you earn rewards to redeem for gift cards.&#160;\u003C/p>\n\n\u003Cp>Plus, Capital One Shopping is free.&#160;\u003C/p>\n\n\u003Cp>\u003Cstrong>What you&#8217;ll learn:\u003C/strong>\u003C/p>\n\n\u003Cul>\n \u003Cli>\n \u003Cp>Capital One Shopping makes it easier to save money while shopping online.\u003C/p>\n \u003C/li>\n \u003Cli>\n \u003Cp>Capital One Shopping works with most major internet browsers, and it&#8217;s free.\u003C/p>\n \u003C/li>\n \u003Cli>\n \u003Cp>You can also use the Capital One Shopping app on most phones.\u003C/p>\n \u003C/li>\n \u003Cli>\n \u003Cp>Capital One Shopping automatically finds and tests coupon and promo codes, gives you instant price comparisons, tells you if prices drop on items you&#8217;ve viewed and lets you earn rewards.\u003C/p>\n \u003C/li>\n\u003C/ul>"},"compoundType":"wcm:Body","contentType":"wcm:Body"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","document":{"$ref":"/content/u5f54a5973bfb44f29a6d56543abd2cc8"},"contentPosition":null,"contentType":"wcm:CTABanner"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","headerStyle":"large-heading","header":"What is Capital One Shopping?","body":{"contentType":"hippostd:html","value":"\u003Cp>\u003Ca href=\"https://capitaloneshopping.com/lp/mobilewebrd?utm_source=c1lp&#38;creative_id=learn_grow_blg_main1\">Capital One Shopping\u003C/a> is a free browser extension and mobile app that automatically searches for online coupons, better prices and rewards at over 100,000 online retailers. That makes it easier to save money when you shop online.\u003C/p>"},"contentCategory":[""],"compoundType":"wcm:HeaderAndBody","contentType":"wcm:HeaderAndBody"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","headerStyle":"small-heading","header":"Is there a fee for Capital One Shopping?","body":{"contentType":"hippostd:html","value":"\u003Cp>There are no fees for using Capital One Shopping. It&#8217;s free for everyone, even people who aren&#8217;t already Capital One customers.\u003C/p>"},"contentCategory":[""],"compoundType":"wcm:HeaderAndBody","contentType":"wcm:HeaderAndBody"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","headerStyle":"large-heading","header":"How does Capital One Shopping work?","body":{"contentType":"hippostd:html","value":"\u003Cp>Using the Capital One Shopping extension is simple. It works with all major browsers, including Google Chrome, Mozilla Firefox, Microsoft Edge and Safari. You can also use the Capital One Shopping app on \u003Ca rel=\"noopener noreferrer\" href=\"https://apps.apple.com/us/app/capital-one-shopping-save-now/id1089294040\" target=\"_blank\">iOS\u003C/a> and \u003Ca rel=\"noopener noreferrer\" href=\"https://play.google.com/store/apps/details?id=com.wikibuy.prod.main\" target=\"_blank\">Android\u003C/a> devices.&#160;\u003C/p>\n\n\u003Cp>Once you install the browser extension or app, you can shop normally. Capital One Shopping works quietly in the background to help you save money. Here&#8217;s how.\u003C/p>"},"contentCategory":[""],"compoundType":"wcm:HeaderAndBody","contentType":"wcm:HeaderAndBody"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","headerStyle":"small-heading","header":"Coupon codes","body":{"contentType":"hippostd:html","value":"\u003Cp>When it&#8217;s time to check out, Capital One Shopping searches for available coupons and promo codes, automatically applying valid ones to your purchase. That can save you money and a lot of time looking for codes that may not work.\u003C/p>"},"contentCategory":[""],"compoundType":"wcm:HeaderAndBody","contentType":"wcm:HeaderAndBody"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","headerStyle":"small-heading","header":"Price comparisons","body":{"contentType":"hippostd:html","value":"\u003Cp>Capital One Shopping automatically compares prices online when you shop at certain retailers. It even checks shipping costs and membership pricing.\u003C/p>\n\n\u003Cp>When it finds a better price, Capital One Shopping shows you the cost difference and provides a link to the retailer with the better deal.\u003C/p>"},"contentCategory":[""],"compoundType":"wcm:HeaderAndBody","contentType":"wcm:HeaderAndBody"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","headerStyle":"small-heading","header":"Price-drop notifications","body":{"contentType":"hippostd:html","value":"\u003Cp>Capital One Shopping keeps track of items you&#8217;ve viewed and may send you a notification when a price drops.\u003C/p>"},"contentCategory":[""],"compoundType":"wcm:HeaderAndBody","contentType":"wcm:HeaderAndBody"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","headerStyle":"small-heading","header":"Rewards","body":{"contentType":"hippostd:html","value":"\u003Cp>Even if discounts or better prices aren&#8217;t available, you could still earn rewards by making eligible purchases through Capital One Shopping partner sites. These rewards are independent of the rewards you might earn with a \u003Ca href=\"https://www.capitalone.com/learn-grow/money-management/what-rewards-credit-card-is-right-for-you/\">Capital One rewards credit card\u003C/a>.\u003C/p>"},"contentCategory":[""],"compoundType":"wcm:HeaderAndBody","contentType":"wcm:HeaderAndBody"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","headerStyle":"large-heading","header":"How to redeem Capital One Shopping Rewards","body":{"contentType":"hippostd:html","value":"\u003Cp>You can \u003Ca href=\"https://capitaloneshopping.com/my-rewards/redeem\">redeem your Capital One Shopping Rewards\u003C/a> for digital gift cards from dozens of retailers. Once you&#8217;ve redeemed your rewards, it can take up to three business days for gift cards to appear in your account.\u003C/p>"},"contentCategory":[""],"compoundType":"wcm:HeaderAndBody","contentType":"wcm:HeaderAndBody"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","headerStyle":"small-heading","header":"Do Capital One Shopping Rewards expire?","body":{"contentType":"hippostd:html","value":"\u003Cp>Capital One Shopping Rewards won&#8217;t expire as long as your account is active and in good standing.\u003C/p>"},"contentCategory":[""],"compoundType":"wcm:HeaderAndBody","contentType":"wcm:HeaderAndBody"},{"name":"wcm:articleBody","displayName":"wcm:articleBody","headerStyle":"large-heading","header":"Key takeaways: Capital One Shopping","body":{"contentType":"hippostd:html","value":"\u003Cp>Saving money with \u003Ca href=\"https://capitaloneshopping.com/lp/mobilewebrd?utm_source=c1lp&#38;creative_id=learn_grow_blg_main1\">Capital One Shopping\u003C/a> is simple. Once you&#8217;re signed up, it starts working immediately, searching for coupons and better prices when you shop online. There&#8217;s nothing you need to do except shop, sit back and enjoy the savings.\u003C/p>"},"contentCategory":[""],"compoundType":"wcm:HeaderAndBody","contentType":"wcm:HeaderAndBody"}],"hideDate":false,"tracking":"3401, 10841","calculator":null,"abTesting":false,"hideArticleTileInGrid":false,"hideFdicFootnoteAndLogo":false,"disclaimers":[{"$ref":"/content/u2641712f65b1486dabef27f08826bf28"},{"$ref":"/content/u12e6b5eab2974bb8a11d9fed9cb0cd67"},{"$ref":"/content/u4eeaa5bcc8004a4fbe6ea8efb0d6fc7c"},{"$ref":"/content/uf8da905c992e444aa81ba2df4c37234f"}],"seoPageTitle":"Capital One Shopping: How It Works | Capital One","metaDescription":"Capital One Shopping is a free browser extension and app you can use to save money wh