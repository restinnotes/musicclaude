     "emotion": "安心",
     "from": [
      "S12-1",
      "S12-2"
     ],
     "at": 5.0
    },
    {
     "text": "他不愿只为有人陪就回头，愿意带着想念继续过日子",
     "accent": "带着想念继续过日子",
     "emotion": "炽热",
     "from": [
      "S12-2",
      "S12-B1",
      "S12-B2"
     ],
     "at": 10.0
    }
   ],
   "small": [
    {
