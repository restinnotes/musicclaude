      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S04",
    "bars": "92–115",
    "relation": "正在面对",
    "items": [
     {
      "id": "S04-1",
      "text": "有时照旧把事情做妥，他心里仍会有一点温暖，也暗暗珍惜自己没有马虎。",
      "key": "有时照旧把事情做",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1"
      ]
     },
     {
      "id": "S04-2",
      "text": "可那些熟悉的做法并没有让他重新属于从前的生活，这一点越做越叫他难受。",
      "key": "可那些熟悉的做法",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S01-2",
       "S03-1"
      ]
     },
     {
      "id": "S04-3",
      "text": "他还是想把每个细节做周全，越较真便越劳累，心里也越来越乱。",
      "key": "他还是想把每个细",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-2",
       "S03-1"
      ]
     }
    ],
    "because": [
     {
