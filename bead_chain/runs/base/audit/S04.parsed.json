   "measures": "mm.32–34",
   "dimensions": [
    "身体与动作",
    "感官质地",
    "动因与心理"
   ],
   "what": "高音区的较长颤音、悬停可成为喉部的生理瞬间：深情几乎说到嘴边，声音先哆嗦、哽住，热切里带柔弱，而非单纯闪亮。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gflash-int-1",
