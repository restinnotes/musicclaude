      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S11",
    "bars": "226–241",
    "relation": "正在面对",
    "items": [
     {
      "id": "S11-1",
      "text": "他终于承认，再多回想几遍，也不能让自己重新拥有那种自然的归属；眼下的日子还得由自己接着过，他开始愿意把心思放回能做的事上。",
      "key": "他终于承认，再多",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-2",
       "S01-1"
      ]
     },
     {
      "id": "S11-2",
      "text": "心里仍会发怵，他却不再等自己完全安稳才肯继续，仍把该守的分寸一点点落实。",
      "key": "心里仍会发怵，他",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-3",
       "S01-3"
      ]
     },
     {
      "id": "S11-3",
      "text": "压力一阵阵回来，每次坚持都费力，刚有的一点松动很快又被压住。",
      "key": "压力一阵阵回来，",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-2",
       "S04-3"
      ]
     }
    ],
    "because": [
