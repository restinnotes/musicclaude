      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S04",
    "bars": "92–115",
    "relation": "正在面对",
    "items": [
     {
      "id": "S04-1",
      "text": "有那么一阵，他真盼着从前那些亲近的日子还能照原来的样子继续。",
      "key": "有那么一阵，他真",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S03-2"
      ]
     },
     {
      "id": "S04-2",
      "text": "这份盼望让他怀疑自己是不是走错了，却也想不出当初若没走，如今会怎样。",
      "key": "这份盼望让他怀疑",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S02-2",
       "S04-1"
      ]
     }
    ],
    "because": [
     {
