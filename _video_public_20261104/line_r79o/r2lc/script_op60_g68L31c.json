     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可心里仍有些地方绕不过去，他说不清自己究竟在顾虑什么",
       "keys": [
        "有些地方绕不过去"
       ],
       "from": [
        "S03-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像谈话碰到了解不开的结，思绪如风吹碎的倒影",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
