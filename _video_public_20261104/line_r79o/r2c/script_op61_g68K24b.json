        "挺直背脊"
       ],
       "from": [
        "S01-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "我不能倒下，可其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可心里很快空了下来",
