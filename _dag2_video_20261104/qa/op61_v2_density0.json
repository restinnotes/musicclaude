      "bead_edges": [
        {
          "a": "S06-B1",
          "b": "S06-B2",
          "type": "可同时成立",
          "note": "B1给出外界退远、身体松下来的空间感；B2是在这个安静空间内部听见私密愿望与祈求。安静不排斥渴望，温柔也不意味着已经获得安慰。"
        },
        {
          "a": "S06-B1",
          "b": "S06-B3",
          "type": "段内先后",
          "note": "B3不是在B1之后才发生，而是补出同一片静谧空间内部从犹疑到展开、再到未完的时间弧线。B1描述的整体安静感贯穿这些变化。"
        },
        {
          "a": "S06-B2",
          "b": "S06-B3",
          "type": "重叠但新增",
          "note": "两者都涉及私密歌唱，但B3新增了可以跟随的具体变化，尤其是168–180小节表达变得更迫切，以及约180小节的未完感。"
        },
        {
          "a": "S06-B2",
          "b": "S06-B4",
          "type": "可同时成立",
          "note": "不急着抓回是对眷恋姿态的另一种聚焦，不否认祈求可能存在。B5不被写成B2之后同一人物必然经历的心理阶段，也不要求听者将两种角度合并成一个故事。"
        }
