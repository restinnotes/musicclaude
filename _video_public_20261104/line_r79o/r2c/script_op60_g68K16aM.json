       "from": [
        "S13-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "阴影也可以听成：刚说了声“是”，心里马上有个声音反问：“可是呢？”",
       "keys": [
        "也可以听成",
        "可是呢"
