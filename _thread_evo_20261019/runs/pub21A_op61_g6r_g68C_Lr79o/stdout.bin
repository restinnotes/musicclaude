{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还不知道自己在失落什么\"\n        },\n        {\n          \"quote\": \"连自己身在何处都还没弄清的恍惚\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"身体先于意识，隐约记起了该如何迈步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开以后，他起初\",\n          \"point\": \"不用再委屈自己了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初总算\"\n        },\n        {\n          \"text\": \"可他很快觉得\",\n          \"point\": \"不知怎么才能安心\",\n          \"where\": \"后\",\n          \"waste\": \"心里\",\n          \"keep\": \"可他很快；想往前走，却\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"更像腿脚虚浮的人，在记忆中挪动舞步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"悲伤还在，只是不愿把自己完全交给悲伤\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"完全\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"舍不得从前的自在\",\n          \"point\": \"怕一心软忘了为何离开\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一心软\"\n        },\n        {\n          \"text\": \"他还是不甘心\",\n          \"point\": \"从前的好日子也