{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"groups\": [\n        {\n          \"label\": \"想靠近，却还不敢把心意说透\",\n          \"points\": [\"S01-B3-p1\", \"S01-B3-p2\"]\n        },\n        {\n          \"label\": \"刚刚踏入亲近，还没有安稳下来\",\n          \"points\": [\"S01-B2-p1\", \"S01-B2-p3\", \"S01-B1-p3\", \"S01-B1-p4\"]\n        },\n        {\n          \"label\": \"突然绽开，又缓缓飘落的惊艳\",\n          \"points\": [\"S01-B1-p1\", \"S01-B1-p2\", \"S01-B2-p2\"]\n        }\n      ],\n      \"tier_a\": [\"S01-B3-p2\"],\n      \"tier_b\": [\"S01-B3-p1\", \"S01-B2-p3\", \"S01-B2-p1\", \"S01-B1-p2\"],\n      \"only_one\": \"S01-B3-p2\",\n      \"line_order\": [\"S01-1\", \"S01-2\", \"S01-3\"],\n      \"line_a\": [\"S01-1\", \"S01-2\"]\n    },\n    {\n      \"sec\": \"S02\",\n      \"groups\": [\n        {\n          \"label\": \"贴得很近、无需说话的安心温存\",\n          \"points\": [\"S02-B1-p1\", \"S02-B1-p2\", \"S02-B1-p3\", \"S02-B1-p4\"]\n        },\n        {\n          \"label\": \"甜蜜还在，心里却已经有了舍不得\",\n          \"points\": [\"S02-B4-p1\", \"S02-B4-p2\", \"S02-B4-p3\"]\n        },\n        {\n          \"label\": \"把身体交给水波，却知道时间仍在流逝\",\n          \"points\": [\"S02-B2-p1\", \"S02-B2-p2\", \"S02-B2-p3\"]\n        },\n        {\n          \"label\": \"喜欢忽然涌上来，又轻轻收回\",\n          \"points\": [\"S02-B3-p1\", \"S02-B3-p2\", \"S02-B3-p3\"]\n        }\n      ],\n      \"tier_a\": [\"S02-B1-p1\", \"S02-B4-p2\"],\n      \"tier_b\": [\"S02-B1-p2\", \"S02-B1-p3\", \"S02-B4-p3\", \"S02-B2-p3\", \"S02-B3-p1\"],\n      \"only_one\": \"S02-B4-p2\",\n      \"line_order\": [\"S02-1\", \"S02-2\", \"S02-3\"],\n      \"line_a\": [\"S02-1\", \"S02-3\"]\n    },\n    {\n      \"sec\": \"S03\",\n      \"groups\": [\n        {\n          \"label\": \"亲密之后的松弛、漂浮和舒服的走神\",\n          \"points\": [\"S03-B1-p1\", \"S03-B1-p2\", \"S03-B1-p3\", \"S03-B1-p4\"]\n        },\n        {\n          \"label\": \"想表达的念头闪现一下，又沉了回去\",\n          \"points\": [\"S03-B2-p1\", \"S03-B2-p2\", \"S03-B2-p3\"]\n        },\n        {\n          \"label\": \"原本顺畅的亲近里，忽然有了说不清的阻力\",\n          \"points\": [\"S03-B3-p1\", \"S03-B3-p2\", \"S03-B3-p3\", \"S03-B3-p4\", \"S03-B3-p5\"]\n        }\n      ],\n      \"tier_a\": [\"S03-B1-p3\", \"S03-B2-p2\", \"S03-B3-p5\"],\n      \"tier_b\": [\"S03-B1-p1\", \"S03-B1-p2\", \"S03-B2-p3\", \"S03-B3-p2\", \"S03-B3-p4\"],\n      \"only_one\": \"S03-B1-p3\",\n      \"line_order\": [\"S03-1\", \"S03-2\"],\n      \"line_a\": [\"S03-1\"]\n    },\n    {\n      \"sec\": \"S04\",\n      \"groups\": [\n        {\n          \"label\": \"喜欢越来越热切，几乎要从喉咙里说出来\",\n          \"points\": [\"S04-B2-p1\", \"S04-B2-p2\", \"S04-B2-p3\", \"S04-B2-p4\"]\n        },\n        {\n          \"label\": \"越想抓紧，越泄露出害怕失去\",\n          \"points\": [\"S04-B3-p1\", \"S04-B3-p2\", \"S04-B3-p3\", \"S04-B3-p4\"]\n        },\n        {\n          \"label\": \"美好尚未结束，心里却已经鼻酸\",\n          \"points\": [\"S04-B4-p1\", \"S04-B4-p2\", \"S04-B4-p3\", \"S04-B4-p4\"]\n        },\n        {\n          \"label\": \"熟悉的亲密重新出现，情绪变得更热闹\",\n          \"points\": [\"S04-B1-p1\", \"S04-B1-p2\", \"S04-B1-p3\", \"S04-B1-p4\", \"S04-B1-p5\", \"S04-B1-p6\"]\n        }\n      ],\n      \"tier_a\": [\"S04-B2-p2\", \"S04-B4-p3\"],\n      \"tier_b\": [\"S04-B3-p2\", \"S04-B2-p3\", \"S04-B4-p2\", \"S04-B1-p3\", \"S04-B1-p5\", \"S04-B1-p6\"],\n      \"only_one\": \"S04-B4-p3\",\n      \"line_order\": [\"S04-2\", \"S04-3\", \"S04-1\"],\n      \"line_a\": [\"S04-2\", \"S04-3\"]\n    },\n    {\n      \"sec\": \"S05\",\n      \"groups\": [\n        {\n          \"label\": \"从两个人的亲密里突然退回一个人\",\n          \"points\": [\"S05-B3-p1\", \"S05-B3-p2\", \"S05-B3-p3\", \"S05-B3-p4\"]\n        },\n        {\n          \"label\": \"失去支撑后的孤零零、失重和茫然\",\n          \"points\": [\"S05-B2-p1\", \"S05-B2-p2\", \"S05-B2-p3\", \"S05-B2-p4\"]\n        },\n        {\n          \"label\": \"原本想紧紧抓住，忽然像泄了气一样松开\",\n          \"points\": [\"S05-B1-p1\", \"S05-B1-p2\", \"S05-B1-p3\"]\n        }\n      ],\n     