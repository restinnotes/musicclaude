   ]
  },
  {
   "bars": "51–61",
   "relation": "正在面对",
   "items": [
    {
     "id": "S07-1",
     "text": "尝到亲近的真切满足后，他更想靠近那个人，心底的依恋也化成更直接的渴望。",
     "key": "渴望更直接",
     "follows": false
    }
   ],
   "because": [
    {
     "from": "S06-1",
