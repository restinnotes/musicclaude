{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然发现自己那么想靠近对方，心里一下热了\",\n          \"accent\": \"心里一下热了\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"怕自己的需要吓着对方，他只敢露出一点喜欢\",\n          \"accent\": \"一点喜欢\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"想了很久的话到了嘴边，他先沉默几秒\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"他知道说出口可能改变两人的关系\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"只靠近一点，他心里已经很甜\",\n          \"after\": 1,\n          \"from\": [\"S01-3\"],\n          \"bars\": \"\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"他还拿不准下次能否更坦白\",\n          \"after\": 1,\n          \"from\": [\"S01-3\"],\n          \"bars\": \"\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"刚踏上小船，木板在脚下微晃\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"水波从脚下荡开，身体一瞬失重\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 13\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"开头两下响亮和弦突然迸开，像夏夜烟花\",\n          \"from\": [\"S01-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"细碎光点缓缓落下，仍悬在水面上方\",\n          \"from\": [\"S01-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"船歌稳定的摇荡感还没真正形成\",\n          \"from\": [\"S01-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"有的演奏先轻摇，有的先让声音悬空\",\n          \"from\": [\"S01-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方看见他的在意仍愿亲近，他才慢慢放松\",\n          \"accent\": \"慢慢放松\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想靠得更近，却怕太急弄坏眼下的自在\",\n          \"accent\": \"怕太急弄坏眼下的自在\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"两个人待得这么好，他还没分开就先舍不得\",\n          \"accent\": \"先舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 36\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像肩挨肩耳语，连呼吸都贴在一起\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 2\n        },\n        {\n          \"text\": \"夏末潮湿温热的风裹着皮肤\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"相识已久，安静坐着也不紧张\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"对方偶尔望来一眼，也不必找话题\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"那阵喜欢几乎已经藏不住\",\n          \"after\": 1,\n          \"from\": [\"S02-2\", \"S02-B3\"],\n          \"bars\": \"12–16\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"他想到这样的时刻总会过去\",\n          \"after\": 2,\n          \"from\": [\"S02-3\", \"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 38\n        },\n        {\n          \"text\": \"船底温柔托着人，脚下不必踩实\",\n          \"after\": 2,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 40\n        },\n        {\n          \"text\": \"舒服地漂着，暂时不急着靠岸\",\n          \"after\": 2,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 42\n        },\n        {\n          \"text\": \"水一直流，时间也一直走\",\n          \"after\": 2,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 44\n        },\n        {\n          \"text\": \"甜蜜确认里藏着一点惆怅\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7–11\",\n          \"at\": 46\n        },\n        {\n          \"text\": \"眼前还好好的，心里已经有点鼻酸\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7–11\",\n          \"at\": 48\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"右手两条旋律线贴得很近\",\n          \"from\": [\"S02-B1\"],\n          \"pt\": \"右手\",\n          \"bars\": \"6–16\"\n        },\n        {\n          \"text\": \"左手一下一下摇着，像心跳也像水浪\",\n          \"from\": [\"S02-B2\"],\n          \"pt\": \"左手\",\n          \"bars\": \"4–5\"\n        },\n        {\n          \"text\": \"歌声短暂上涌，随后轻轻呼出一口气\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"12–16\"\n        },\n        {\n          \"text\": \"柔软落音里带着一点惆怅\",\n          \"from\": [\"S02-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"7–11\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不去想以后，只想舒服地待在亲近里\",\n          \"accent\": \"舒服地待在亲近里\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想说自己有多喜欢，也想问对方是否一样\",\n          \"accent\": \"有多喜欢\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 11\n        },\n        {\n          \"text\": \"没想好怎么开口，念头就淡了\",\n          \"accent\": \"念头就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 22\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"水波一阵阵托着身体，像在原地漂着\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"说过重要的话后，人还停在那句话里\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"有点陶醉，也有点走神\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"亲密交谈后的沉默，反而很舒服\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"身体还在这里，心却慢慢漂远\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"急着表达的念头只露了一下头\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20–21\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"它很快又沉回心里\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20–21\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"平稳的交谈像被水下暗流拖住\",\n          \"after\": 2,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20–22\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"思绪像被风吹碎的倒影，闪烁难拼\",\n          \"after\": 2,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20–22\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"谈话碰到解不开的结，亲近里有了阻力\",\n          \"after\": 2,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"短促急切的声音忽然冒出\",\n          \"from\": [\"S03-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"20–21\"\n        },\n        {\n          \"text\": \"流动忽然绕远、滞留，几处声音悬住\",\n          \"from\": [\"S03-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"20–22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又让他欢喜，他想起上回没能开口\",\n          \"accent\": \"又让他欢喜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他几乎想说尽藏着的话，盼对方喜欢坦白的自己\",\n          \"accent\": \"坦白的自己\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"他怕说太多让对方为难，最后还是留了些话\",\n          \"accent\": \"留了些话\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-3\"],\n          \"at\": 34\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"两道声线贴着耳边，像低声私语\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 2\n        },\n        {\n          \"text\": \"这次的歌声比上回更华丽、更迫切\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"像讲起往事，语速说着说着变了\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"本来一句话够了，他还想补更多细节\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"最深的心意到了喉咙口，像发颤哽住\",\n          \"after\": 1,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"那一刻像终于把心事全打开\",\n          \"after\": 1,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"他盼着说出口，能把眼下的好留久些\",\n          \"after\": 2,\n          \"from\": [\"S04-3\"],\n          \"bars\": \"\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"他不自觉把对方的手握得更紧\",\n          \"after\": 2,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 38\n        },\n        {\n          \"text\": \"越用力抱紧当下，船身仿佛越颠簸\",\n          \"after\": 2,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 40\n        },\n        {\n          \"text\": \"连原有的平衡都变得脆弱\",\n          \"after\": 2,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 42\n        },\n        {\n          \"text\": \"美好还在，心里却像听见时间倒数\",\n          \"after\": 2,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\",\n          \"at\": 44\n        },\n        {\n          \"text\": \"歌声越美，越舍不得这一刻过去\",\n          \"after\": 2,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\",\n          \"at\": 46\n        },\n        {\n          \"text\": \"他怕两人原有的自在也会弄丢\",\n          \"after\": 2,\n          \"from\": [\"S04-3\"],\n          \"bars\": \"\",\n          \"at\": 48\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"细密花腔像水面光斑，晃得人睁不开眼\",\n          \"from\": [\"S04-B1\"],\n          \"pt\": \"右手\",\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"高处长颤音亮得刺眼，像水面最后金光\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"右手\",\n          \"bars\": \"30–34\"\n        },\n        {\n          \"text\": \"右手高处悬停，左手水波仍向前推\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"右手与左手\",\n          \"bars\": \"30–34\"\n        },\n        {\n          \"text\": \"声势攀高后渐渐收弱，摇晃慢下来\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"30–34\"\n        },\n        {\n          \"text\": \"两道声线仍贴得很近，左手水波不停\",\n          \"from\": [\"S04-B4\"],\n          \"pt\": \"左手与右手\",\n          \"bars\": \"24–34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"对方一直愿意亲近，这回他不知不觉露出了在乎\",\n          \"accent\": \"露出了在乎\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"对方看出来后，他心里忽然空落落的\",\n          \"accent\": \"空落落的\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-2\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"前几次想说的话，他总又收了回去\",\n          \"after\": 0,\n          \"from\": [\"S05-1\"],\n          \"bars\": \"\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"他连该怎么跟对方待着都拿不准\",\n          \"after\": 1,\n          \"from\": [\"S05-2\"],\n          \"bars\": \"\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"他担心对方会嫌自己太黏\",\n          \"after\": 1,\n          \"from\": [\"S05-3\"],\n          \"bars\": \"\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"熟悉的亲近忽然像隔了一层\",\n          \"after\": 1,\n          \"from\": [\"S05-3\"],\n          \"bars\": \"\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"脚下忽然没了支撑，时间也松开了\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"像小船漂进起雾的水域，前路未卜\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"这份幸福是真的吗，还能维持多久？\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"刚才想攥紧不放的冲动，终于退下去\",\n          \"after\": 1,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"35–39\",\n          \"at\": 15\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"托着人的水波忽然撤去，只剩单薄旋律\",\n          \"from\": [\"S05-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"35–39\"\n        },\n        {\n          \"text\": \"贴近的交谈忽然戛然而止\",\n          \"from\": [\"S05-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"35–39\"\n        },\n        {\n          \"text\": \"音乐像松开紧握的手，轻轻吸一口气\",\n          \"from\": [\"S05-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他多在乎，待他却和从前一样\",\n          \"accent\": \"和从前一样\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他仍想靠近，却怕自己要得太多\",\n          \"accent\": \"怕自己要得太多\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"他忍不住想，对方会不会也舍不得这份亲近\",\n          \"accent\": \"也舍不得这份亲近\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 26\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"暖金水面滑进古桥阴影，空气凉下来\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"像清冷月光，也让人想起童年初恋\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"心里像在说：算了，可还是放不下\",\n          \"after\": 1,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"不是哭，也不是崩溃，只是不再装完整\",\n          \"after\": 1,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"对方不知道他刚才多怕被嫌弃\",\n          \"after\": 1,\n          \"from\": [\"S06-2\"],\n          \"bars\": \"\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"这份害怕只有他知道，他有一点孤单\",\n          \"after\": 1,\n          \"from\": [\"S06-2\", \"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"白天相处很好，回家后心里却发酸\",\n          \"after\": 1,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"再亲近的人，也进不了心里每个角落\",\n          \"after\": 1,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"美好还在眼前，恍惚间却像成了回忆\",\n          \"after\": 1,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"也有人听见的，是更贴身的沉醉\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"气味和身体感觉，慢慢混进幻想\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 29\n        },\n        {\n          \"text\": \"遗憾与快感也混在一起\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 31\n        },\n        {\n          \"text\": \"舒服得沉进去，反而有些失去方向\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 33\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉摇摆回来，左手波浪变薄变细\",\n          \"from\": [\"S06-B1\"],\n          \"pt\": \"左手\",\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"A大调新旋律清澈舒展，近乎牧歌\",\n          \"from\": [\"S06-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"低声旋律与另一条声线交错回应\",\n          \"from\": [\"S06-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"声音时而靠近，时而退开\",\n          \"from\": [\"S06-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"40–50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他想起对方总愿意陪着自己，也许对方也需要他\",\n          \"accent\": \"也许对方也需要他\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到两人或许能互相依靠，他高兴得心口发紧\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-2\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"他盼着对方以后想找人陪时，还会想到自己\",\n          \"accent\": \"还会想到自己\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-3\"],\n          \"at\": 28\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"光是安静地享受，已经不太够了\",\n          \"after\": 1,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"更深的渴望推着身体往前\",\n          \"after\": 1,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"情欲、执念和对生命的眷恋一齐翻涌\",\n          \"after\": 1,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"记忆慢慢变成气味、身体感觉和幻想\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"遗憾与快感也混在这份回想里\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"明知自己正被卷进去，却暂时不想出来\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"有一点情色的暖意\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"什么都还很好，他却听见时间经过\",\n          \"after\": 2,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 29\n        },\n        {\n          \"text\": \"美没有消失，这一刻却停不住\",\n          \"after\": 2,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 31\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏音符变密，内声部像暗涌攀爬\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"内声部\",\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"低音八度与切分像沉重脉搏催促\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"低音\",\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"对方依然亲近，他想大大方方地回应\",\n          \"accent\": \"大大方方地回应\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他开始盼着两个人能这样好很久\",\n          \"accent\": \"好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"可眼下的亲近未必会一直持续，他心里没底\",\n          \"accent\": \"心里没底\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-3\"],\n          \"at\": 26\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"这一刻只剩直接、敞开的欢喜\",\n          \"after\": 0,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"没有防备，也不再反复分析\",\n          \"after\": 0,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像重新碰到阳光和风，身体恢复弹性\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"心里有点玩心，像轻快的调情回应\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"快乐的余温还在，心头却泛起怀念\",\n          \"after\": 2,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\",\n          \"at\": 28\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旋律直接舒展，像意大利歌剧咏叹调\",\n          \"from\": [\"S08-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌句越唱越开，情绪一再抬高\",\n          \"from\": [\"S08-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌声向上散开，随后忽然停住\",\n          \"from\": [\"S08-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"69–71\"\n        },\n        {\n          \"text\": \"热闹的余音退去，转入片刻静意\",\n          \"from\": [\"S08-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"69–71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他怕对方有一天不再需要他，连相处都不自在\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他一下安静下来，不敢再往远处想\",\n          \"accent\": \"不敢再往远处想\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 11\n        },\n        {\n          \"text\": \"对方一直没退开，他想或许对方也喜欢他在身边\",\n          \"accent\": \"也喜欢他在身边\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S09-3\"],\n          \"at\": 22\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像话说到要紧处，忽然停住\",\n          \"after\": 0,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"两人对视，连呼吸都像停了\",\n          \"after\": 0,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"渴望还在，绷紧的劲却没松开\",\n          \"after\": 0,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"像掉进低气压，阳光隔着薄雾\",\n          \"after\": 1,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"光还在，只是隔着一层薄雾\",\n          \"after\": 1,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"心里反复问：刚才是真的吗，接下来呢？\",\n          \"after\": 1,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"像说了很多话后忽然抬头看夜空\",\n          \"after\": 2,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"眼前的美好比自己的愿望更大\",\n          \"after\": 2,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"不安还在，却暂时不再占满心思\",\n          \"after\": 2,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉摇摆忽然退开，声音停在半空\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"72–77\"\n        },\n        {\n          \"text\": \"轻颤音与柔和和弦悬而不落\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"76–77\"\n        },\n        {\n          \"text\": \"明亮的声音逐层下沉，颜色转暗\",\n          \"from\": [\"S09-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"72–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他怕再猜下去连今天都过不踏实，先享受眼前\",\n          \"accent\": \"先享受眼前\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"紧绷慢慢松开，他心里亮得想笑也想哭\",\n          \"accent\": \"亮得想笑也想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 13\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"一直绷着的肩膀，终于长长松一口气\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"胸口一下打开，眼泪也不必再忍\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"心事没解决，这一刻却不用控制感受\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"这只是一口短暂的气，不是长久避风处\",\n          \"after\": 0,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"身体像失去重量，飘在夏夜微风里\",\n          \"after\": 1,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"沉重负担仿佛碰不到飘起来的自己\",\n          \"after\": 1,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"载船前行的摇荡忽然被清风拨开\",\n          \"from\": [\"S10-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"旋律在时间里开出一小块空地\",\n          \"from\": [\"S10-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"右手高音织出极细极亮的小音符\",\n          \"from\": [\"S10-B4\"],\n          \"pt\": \"右手\",\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"琶音像银丝细雨，又像飞瀑落水\",\n          \"from\": [\"S10-B4\"],\n          \"pt\": \"右手\",\n          \"bars\": \"80–83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他发现自己需要对方，对方有时也需要他\",\n          \"accent\": \"互相需要\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"即使对方不需要他，他仍愿意陪着\",\n          \"accent\": \"仍愿意陪着\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"他高兴得顾不上害臊，也不再藏起喜欢\",\n          \"accent\": \"不再藏起喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"可对方未必一直愿意他陪，他想到这点心口发疼\",\n          \"accent\": \"心口发疼\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-3\"],\n          \"at\": 27\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像压在心底的话终于说出口\",\n          \"after\": 1,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"这是我的感情，我不再为它道歉\",\n          \"after\": 2,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"先前差一点抵达的期待，像终于得到满足\",\n          \"after\": 2,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"这还不是全曲的结束\",\n          \"after\": 2,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"像夕阳沉下前，天空烧得血红金亮\",\n          \"after\": 3,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"灿烂得刺眼，胸口反而被压得发痛\",\n          \"after\": 3,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"喜悦浓烈得几乎承受不住\",\n          \"after\": 3,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"像多年后重新走进一间旧房子\",\n          \"after\": 3,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"家具没变，自己却已经知道太多\",\n          \"after\": 3,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"熟悉的温柔有了新的重量\",\n          \"after\": 3,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 32\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"开头旋律不再一唱出便收弱\",\n          \"from\": [\"S11-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"厚重和弦托起歌声，左手水波翻成惊涛\",\n          \"from\": [\"S11-B1\"],\n          \"pt\": \"左手\",\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"铺开的力量短暂悬在半空，像等下一浪\",\n          \"from\": [\"S11-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"92\"\n        },\n        {\n          \"text\": \"这次悬置像接住先前未落定的期待\",\n          \"from\": [\"S11-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他想把能给的都给对方，只盼对方安心\",\n          \"accent\": \"只盼对方安心\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"明知以后无法保证，他还是想多陪一会儿\",\n          \"accent\": \"想多陪一会儿\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"高兴终于整个涌出来，他不再逼自己收着\",\n          \"accent\": \"不再逼自己收着\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他顾不上对方是否也在乎自己\",\n          \"after\": 0,\n          \"from\": [\"S12-1\"],\n          \"bars\": \"\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"整个人像被卷进比自己更大的世界\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"连“我”都暂时退到了后面\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"狂喜像一场高烧\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"久别重逢般抱紧对方，久久不肯松手\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"喉咙发紧，眼眶湿润\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"快乐得分不清想笑还是想哭\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 19\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"明亮开阔的歌声被推到最大尺度\",\n          \"from\": [\"S12-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"内声部彼此拉扯，声浪一层高过一层\",\n          \"from\": [\"S12-B1\"],\n          \"pt\": \"内声部\",\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"温柔歌声带上近乎恳求的力量\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"旋律一次次向上伸展，却迟迟不落\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"乐句末端牵扯延迟，气息一直悬着\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"96–100\"\n        },\n        {\n          \"text\": \"声浪终于在交界处得到重大释放\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"102–103\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"他想听对方说以后也不变\",\n          \"accent\": \"以后也不变\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"越喜欢和对方待着，他越觉得时间过得快\",\n          \"accent\": \"时间过得快\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"他怕对方不再需要自己，连相处也会失去\",\n          \"accent\": \"不再需要自己\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"他早装不回不在乎，藏起喜欢反而更难受\",\n          \"accent\": \"藏起喜欢反而更难受\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 28\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"就算听见保证，时间也还是过得飞快\",\n          \"after\": 1,\n          \"from\": [\"S13-B1\", \"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"真的能一直这样吗？\",\n          \"after\": 1,\n          \"from\": [\"S13-1\"],\n          \"bars\": \"\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"起初他怕自己的需要给对方添负担\",\n          \"after\": 2,\n          \"from\": [\"S13-2\"],\n          \"bars\": \"\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"少露些心意，会不会少疼一点？\",\n          \"after\": 2,\n          \"from\": [\"S13-2\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"幸福没有消失，悲伤却走进幸福里面\",\n          \"after\": 2,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"终于握住珍贵的东西，才懂得它留不住\",\n          \"after\": 2,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"像刚坚定地说了“是”，心里又问“可是呢？”\",\n          \"after\": 3,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 29\n        },\n        {\n          \"text\": \"怀疑没有证明幸福是假的，只让它更疼\",\n          \"after\": 3,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 31\n        },\n        {\n          \"text\": \"刚才想对对方好，确实是真心\",\n          \"after\": 3,\n          \"from\": [\"S13-3\"],\n          \"bars\": \"\",\n          \"at\": 33\n        },\n        {\n          \"text\": \"脚下站得很稳，胸口却一沉再沉\",\n          \"after\": 3,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旋律反复渐强，持续往前推\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"之后越来越绷紧，逼近更大的冲击\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"106–110\"\n        },\n        {\n          \"text\": \"下方脚步稳稳踩住地面，上方声音反复下落\",\n          \"from\": [\"S13-B4\"],\n          \"pt\": \"上下声部\",\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"上方声部像叹息，反复牵扯\",\n          \"from\": [\"S13-B4\"],\n          \"pt\": \"上方声部\",\n          \"bars\": \"103–110\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"两人还亲近，他心里又甜又酸\",\n          \"accent\": \"又甜又酸\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他仍会舍不得，也不知道以后会怎样\",\n          \"accent\": \"仍会舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-2\"],\n          \"at\": 11\n        },\n        {\n          \"text\": \"他不再逼对方保证永远，也不打算藏回喜欢\",\n          \"accent\": \"不打算藏回喜欢\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-3\"],\n          \"at\": 22\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"从最初不敢多露喜欢，到现在，他并不后悔\",\n          \"after\": 0,\n          \"from\": [\"S14-1\"],\n          \"bars\": \"\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"往后会怎样，等真的到了那时再说\",\n          \"after\": 2,\n          \"from\": [\"S14-3\"],\n          \"bars\": \"\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"像从一场美梦醒来，还记得梦里的光\",\n          \"after\": 1,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111–115\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"低低的一声回望后，还有最后一闪\",\n          \"after\": 1,\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113–115\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"像震荡后站起来，整理衣服，关上门\",\n          \"after\": 2,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 25\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"最后一股浪头猛推一下，随后音乐松开\",\n          \"from\": [\"S14-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"110–115\"\n        },\n        {\n          \"text\": \"终结句渐轻，熟悉的歌声又浮现\",\n          \"from\": [\"S14-B1\", \"S14-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"111–115\"\n        },\n        {\n          \"text\": \"左手内声部幽幽唱出一句，像男中音独白\",\n          \"from\": [\"S14-B2\"],\n          \"pt\": \"左手内声部\",\n          \"bars\": \"113–115\"\n        },\n        {\n          \"text\": \"右手细碎琶音像水花溅向夜空\",\n          \"from\": [\"S14-B2\"],\n          \"pt\": \"右手\",\n          \"bars\": \"115\"\n        },\n        {\n          \"text\": \"最后几下和弦干脆沉重，低音像铁锚落水\",\n          \"from\": [\"S14-B3\"],\n          \"pt\": \"低音\",\n          \"bars\": \"116\"\n        },\n        {\n          \"text\": \"尾声远远回应开头，末和弦接住悬着的话\",\n          \"from\": [\"S14-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"113–116\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "876ad756-80e1-4028-9304-30c9f8847926", "session_revision": 0, "session_ttl_max_hours": 6, "job_directory": "D:\