    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "我几乎想把藏着的话全告诉对方。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      },
      {
       "text": "盼对方喜欢我不再小心收着的样子。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "金光刺眼",
       "keys": [],
       "from": [
        "S04-B2-p1"
       ]
      },
      {
       "text": "话哽在喉咙",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "水波推着往前",
       "keys": [],
