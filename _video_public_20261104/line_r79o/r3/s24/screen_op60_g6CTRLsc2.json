       "from": [
        "S06-B1"
       ],
       "bars": "40-50",
       "at": 15.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "安静时，他还想靠近，怕要得太多",
     "keys": [
      "怕要得太多"
     ],
     "emotion": "不安",
     "from": [
      "S06-2"
     ],
     "at": 4.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像刚静下来的水面，又漾开一圈细纹",
