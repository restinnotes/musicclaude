{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他终于离开熟悉的生活\",\n          \"accent\": \"终于离开\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S01-1\"\n          ]\n        },\n        {\n          \"text\": \"起初觉得不用再委屈自己\",\n          \"accent\": \"不用再委屈自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S01-1\"\n          ]\n        },\n        {\n          \"text\": \"可那份笃定很快散了\",\n          \"accent\": \"很快散了\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S01-2\",\n            \"S01-B2\"\n          ]\n        },\n        {\n          \"text\": \"他心里空落落的\",\n          \"accent\": \"空落落\",\n          \"emotion\": \"孤单\",\n          \"from\": [\n            \"S01-2\",\n            \"S01-B3\",\n            \"S01-B4\"\n          ]\n        },\n        {\n          \"text\": \"想往前走却不知靠什么安心\",\n          \"accent\": \"不知靠什么安心\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S01-3\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像逼自己挺直背脊，心里却想停下\",\n          \"after\": 1,\n          \"from\": [\n            \"S01-B2\"\n          ],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"他分不清是愤怒、遗憾还是怀念\",\n          \"after\": 3,\n          \"from\": [\n            \"S01-B3\"\n          ],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"像从昏沉里醒来，四周冷空，视线模糊\",\n          \"after\": 3,\n          \"from\": [\n            \"S01-B4\"\n          ],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"胸口发紧，伸手却只摸到虚空\",\n          \"after\": 3,\n          \"from\": [\n            \"S01-B4\"\n          ],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"旧日声音和光线回来，却回不到现在\",\n          \"after\": 4,\n          \"from\": [\n            \"S01-B5\"\n          ],\n          \"bars\": \"9–17\"\n        },\n        {\n          \"text\": \"身体仿佛先记起该怎么迈步\",\n          \"after\": 4,\n          \"from\": [\n            \"S01-B5\"\n          ],\n          \"bars\": \"18–23\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"重和弦像一次召唤，随后声音向高处散开\",\n          \"from\": [\n            \"S01-B1\"\n          ],\n          \"bars\": \"1–6\"\n        },\n        {\n          \"text\": \"短句刚冒出就被长停顿截断\",\n          \"from\": [\n            \"S01-B3\"\n          ],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"余音在冰冷空气里慢慢散尽\",\n          \"from\": [\n            \"S01-B3\"\n          ],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"旋律轮廓渐清，波兰舞步逐渐浮现\",\n          \"from\": [\n            \"S01-B5\"\n          ],\n          \"bars\": \"9–17；18–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"他舍不得从前自在的日子\",\n          \"accent\": \"自在的日子\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S02-1\"\n          ]\n        },\n        {\n          \"text\": \"想到以后不能那样过就心慌\",\n          \"accent\": \"就心慌\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S02-1\"\n          ]\n        },\n        {\n          \"text\": \"他赶紧提醒自己受过的气\",\n          \"accent\": \"受过的气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\n            \"S02-2\"\n          ]\n        },\n        {\n          \"text\": \"他怕一心软就忘了为何离开\",\n          \"accent\": \"为何离开\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S02-2\"\n          ]\n        },\n        {\n          \"text\": \"他不甘心连好日子也要丢掉\",\n          \"accent\": \"不甘心\",\n          \"emotion\": \"炽热\",\n          \"from\": [\n            \"S02-3\",\n            \"S02-B5\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像远处传来一首熟悉的旧歌\",\n          \"after\": 0,\n          \"from\": [\n            \"S02-B1\"\n          ],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"像只在心里轻轻哼给自己听\",\n          \"after\": 0,\n          \"from\": [\n            \"S02-B1\"\n          ],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"珍惜的东西仿佛还在，却不能再拥有\",\n          \"after\": 0,\n          \"from\": [\n            \"S02-B1\"\n          ],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"像腿脚发虚的人，在记忆里挪步\",\n          \"after\": 1,\n          \"from\": [\n            \"S02-B2\"\n          ],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"像反复说没事，反倒显出很在意\",\n          \"after\": 3,\n          \"from\": [\n            \"S02-B4\"\n          ],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"像在说：我不甘心连好日子都丢了\",\n          \"after\": 4,\n          \"from\": [\n            \"S02-B5\"\n          ],\n          \"bars\": \"44–65\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"舞步庄严，歌声脆弱，底下有细碎的不安\",\n          \"from\": [\n            \"S02-B2\"\n          ],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"声音猛地上推又退下，随后再次聚拢\",\n          \"from\": [\n            \"S02-B3\"\n          ],\n          \"bars\": \"38–43；44–65\"\n        },\n        {\n          \"text\": \"后半段的小音符越来越密，呼吸被催急\",\n          \"from\": [\n            \"S02-B3\"\n          ],\n          \"bars\": \"52–65\"\n        },\n        {\n          \"text\": \"最后仍没舒舒服服落地，紧张还没解开\",\n          \"from\": [\n            \"S02-B3\"\n          ],\n          \"bars\": \"38–65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他心里还憋着一股气\",\n          \"accent\": \"憋着一股气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\n            \"S03-1\",\n            \"S03-B1\"\n          ]\n        },\n        {\n          \"text\": \"想起被当作自己人他又高兴了\",\n          \"accent\": \"自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S03-1\",\n            \"S03-B2\"\n          ]\n        },\n        {\n          \"text\": \"旧日过不成了离开后会更好吗？\",\n          \"accent\": \"会更好吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S03-2\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"想往前走，却拿不定方向\",\n          \"after\": 0,\n          \"from\": [\n            \"S03-B1\"\n          ],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"像故乡夏日麦浪，也像微风轻拂\",\n          \"after\": 1,\n          \"from\": [\n            \"S03-B2\"\n          ],\n          \"bars\": \"80–91\"\n        },\n        {\n          \"text\": \"想起从前不必防备，心里又暖又痛\",\n          \"after\": 1,\n          \"from\": [\n            \"S03-B2\"\n          ],\n          \"bars\": \"80–91\"\n        },\n        {\n          \"text\": \"先不想离开后会怎样，轻松是真的\",\n          \"after\": 2,\n          \"from\": [\n            \"S03-B3\"\n          ],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"像在自问：刚才是真信，还是劝自己？\",\n          \"after\": 2,\n          \"from\": [\n            \"S03-B5\"\n          ],\n          \"bars\": \"66–91\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"重和弦若突出，会像重锤砸下\",\n          \"from\": [\n            \"S03-B1\"\n          ],\n          \"bars\": \"66\"\n        },\n        {\n          \"text\": \"一种听法：前半段焦躁急切，后半柔和亲切近田园\",\n          \"from\": [\n            \"S03-B2\"\n          ],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"多条声音像低声絮语，重心像流沙漂移\",\n          \"from\": [\n            \"S03-B4\"\n          ],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"暂时离开伤口，并没有解开那件难题\",\n          \"from\": [\n            \"S03-B3\"\n          ],\n          \"bars\": \"66–91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"他真盼着还能那样亲近\",\n          \"accent\": \"真盼着\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S04-1\",\n            \"S04-B1\"\n          ]\n        },\n        {\n          \"text\": \"可当初受的委屈又翻上来\",\n          \"accent\": \"委屈又翻上来\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S04-2\",\n            \"S04-B2\"\n          ]\n        },\n        {\n          \"text\": \"他反复问那一步走得对不对\",\n          \"accent\": \"走得对不对\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S04-2\",\n            \"S04-B4\"\n          ]\n        },\n        {\n          \"text\": \"没走的话如今又会怎样？\",\n          \"accent\": \"又会怎样\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S04-2\",\n            \"S04-B4\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"想起那时被温柔相待，心里暖了一会儿\",\n          \"after\": 0,\n          \"from\": [\n            \"S04-B1\"\n          ],\n          \"bars\": \"92–107\"\n        },\n        {\n          \"text\": \"那份坚定，或许只是他想成为的样子\",\n          \"after\": 0,\n          \"from\": [\n            \"S04-B1\"\n          ],\n          \"bars\": \"92–107\"\n        },\n        {\n          \"text\": \"也许回忆太好，才让人心里发疼\",\n          \"after\": 1,\n          \"from\": [\n            \"S04-B2\"\n          ],\n          \"bars\": \"108–115\"\n        },\n        {\n          \"text\": \"他不停往前赶，只为不让自己停下来\",\n          \"after\": 2,\n          \"from\": [\n            \"S04-B4\"\n          ],\n          \"bars\": \"94–115\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的舞曲主题重新出现，变得更抒情\",\n          \"from\": [\n            \"S04-B1\"\n          ],\n          \"bars\": \"92–107\"\n        },\n        {\n          \"text\": \"温暖忽然转为风暴般紧绷\",\n          \"from\": [\n            \"S04-B2\"\n          ],\n          \"bars\": \"108–115\"\n        },\n        {\n          \"text\": \"下行声音带着撕扯般的后退\",\n          \"from\": [\n            \"S04-B2\"\n          ],\n          \"bars\": \"108–115\"\n        },\n        {\n          \"text\": \"细碎声音像急促脚步或乱拍的心跳\",\n          \"from\": [\n            \"S04-B3\"\n          ],\n          \"bars\": \"92–115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他觉得当初那些气不该忍\",\n          \"accent\": \"不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\n            \"S05-1\",\n            \"S05-B2\"\n          ]\n        },\n        {\n          \"text\": \"可他不想连开心回忆都躲着\",\n          \"accent\": \"开心回忆\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S05-1\"\n          ]\n        },\n        {\n          \"text\": \"跟自己争得渐渐没了力气\",\n          \"accent\": \"没了力气\",\n          \"emotion\": \"孤单\",\n          \"from\": [\n            \"S05-2\",\n            \"S05-B5\"\n          ]\n        },\n        {\n          \"text\": \"想到如今不在他们身边就难受\",\n          \"accent\": \"不在他们身边\",\n          \"emotion\": \"孤单\",\n          \"from\": [\n            \"S05-2\",\n            \"S05-B3\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像夜色里两个影子，彼此低声说话\",\n          \"after\": 1,\n          \"from\": [\n            \"S05-B1\"\n          ],\n          \"bars\": \"116–147\"\n        },\n        {\n          \"text\": \"又气又难过，像在说这事不能算了\",\n          \"after\": 0,\n          \"from\": [\n            \"S05-B2\"\n          ],\n          \"bars\": \"116–127\"\n        },\n        {\n          \"text\": \"像某个人，也像故乡或过去的生活\",\n          \"after\": 3,\n          \"from\": [\n            \"S05-B3\"\n          ],\n          \"bars\": \"116–147\"\n        },\n        {\n          \"text\": \"像脚下地板忽然不见，只剩一个声音\",\n          \"after\": 3,\n          \"from\": [\n            \"S05-B4\"\n          ],\n          \"bars\": \"128–147\"\n        },\n        {\n          \"text\": \"像几次深呼吸，紧绷暂时松开\",\n          \"after\": 2,\n          \"from\": [\n            \"S05-B5\"\n          ],\n          \"bars\": \"144–147\"\n        },\n        {\n          \"text\": \"这一下松动，更像是抵抗累了\",\n          \"after\": 2,\n          \"from\": [\n            \"S05-B5\"\n          ],\n          \"bars\": \"144–147\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌唱忽然柔和亲近，语气仍然克制\",\n          \"from\": [\n            \"S05-B1\"\n          ],\n          \"bars\": \"116–147\"\n        },\n        {\n          \"text\": \"快速流动渐渐稀疏，最后只剩疏落和弦\",\n          \"from\": [\n            \"S05-B4\"\n          ],\n          \"bars\": \"128–147\"\n        },\n        {\n          \"text\": \"末尾声音变慢变疏，紧绷短暂松开\",\n          \"from\": [\n            \"S05-B5\"\n          ],\n          \"bars\": \"144–147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"这回他没急着拿受过的气压想念\",\n          \"accent\": \"没急着拿受过的气\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S06-1\",\n            \"S06-B1\",\n            \"S06-B2\"\n          ]\n        },\n        {\n          \"text\": \"如今才知道有人陪着有多轻松\",\n          \"accent\": \"有多轻松\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S06-2\",\n            \"S06-1\"\n          ]\n        },\n        {\n          \"text\": \"他很想再过不用多说的亲近日子\",\n          \"accent\": \"不用多说的亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S06-3\"\n          ]\n        },\n        {\n          \"text\": \"又怕以后再也没有那样的日子\",\n          \"accent\": \"再也没有\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S06-3\",\n            \"S06-B2\"\n          ]\n        },\n        {\n          \"text\": \"想起真真切切拥有过心里暖了些\",\n          \"accent\": \"心里暖了些\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S06-4\",\n            \"S06-B4\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像隔着透明玻璃，也像母亲轻哼摇篮曲\",\n          \"after\": 0,\n          \"from\": [\n            \"S06-B1\"\n          ],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"这份安宁不代表现实变好，也不能久留\",\n          \"after\": 0,\n          \"from\": [\n            \"S06-B1\"\n          ],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"像向遥远处祈求，却不知会不会有回应\",\n          \"after\": 4,\n          \"from\": [\n            \"S06-B2\"\n          ],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"远去的家园在梦里亮起，只能远远看着\",\n          \"after\": 4,\n          \"from\": [\n            \"S06-B2\",\n            \"S06-B4\"\n          ],\n          \"bars\": \"148–180\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"庄严歌唱里像藏着私密念头\",\n          \"from\": [\n            \"S06-B2\"\n          ],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"歌唱由试探渐渐展开，后段更迫切，末尾像话没说完\",\n          \"from\": [\n            \"S06-B3\"\n          ],\n          \"bars\": \"148–180\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"像甜梦忽然碎了身体先惊醒\",\n          \"accent\": \"忽然碎了\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S07-B1\"\n          ]\n        },\n        {\n          \"text\": \"他怕以后遇上难事只能独自扛\",\n          \"accent\": \"只能独自扛\",\n          \"emotion\": \"孤单\",\n          \"from\": [\n            \"S07-1\",\n            \"S07-B3\"\n          ]\n        },\n        {\n          \"text\": \"他没想到离开后会这么孤单\",\n          \"accent\": \"这么孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\n            \"S07-2\"\n          ]\n        },\n        {\n          \"text\": \"早知道这么孤单他还会走吗？\",\n          \"accent\": \"还会走吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S07-2\"\n          ]\n        },\n        {\n          \"text\": \"他想亲近又不甘心回去受气\",\n          \"accent\": \"不甘心回去受气\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S07-3\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像寒风吹开窗，后颈一凉脉搏急跳\",\n          \"after\": 0,\n          \"from\": [\n            \"S07-B1\"\n          ],\n          \"bars\": \"182附近\"\n        },\n        {\n          \"text\": \"眼前换了场景，刚才的念头还悬着\",\n          \"after\": 0,\n          \"from\": [\n            \"S07-B2\"\n          ],\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"思绪不停翻转，想冲出去却找不到出口\",\n          \"after\": 1,\n          \"from\": [\n            \"S07-B3\"\n          ],\n          \"bars\": \"198–205\"\n        },\n        {\n          \"text\": \"熟悉的动作和舞步，反倒照出失去\",\n          \"after\": 2,\n          \"from\": [\n            \"S07-B4\"\n          ],\n          \"bars\": \"181–205\"\n        },\n        {\n          \"text\": \"连当初离开的决心也找不着了\",\n          \"after\": 4,\n          \"from\": [\n            \"S07-3\"\n          ],\n          \"bars\": \"\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高处忽然浮出一串细长颤音\",\n          \"from\": [\n            \"S07-B1\"\n          ],\n          \"bars\": \"182附近\"\n        },\n        {\n          \"text\": \"静谧突然转入舞步，旧有姿态不再完整\",\n          \"from\": [\n            \"S07-B2\",\n            \"S07-B5\"\n          ],\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"连续颤动层层累积，紧张不断加深\",\n          \"from\": [\n            \"S07-B3\"\n          ],\n          \"bars\": \"198–205\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"他先把回去的事放一边\",\n          \"accent\": \"放一边\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S08-1\"\n          ]\n        },\n        {\n          \"text\": \"想起被当作自己人心里一暖\",\n          \"accent\": \"心里一暖\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S08-1\",\n            \"S08-B1\"\n          ]\n        },\n        {\n          \"text\": \"可这点暖意没让他想回头\",\n          \"accent\": \"没让他想回头\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S08-1\",\n            \"S08-B2\"\n          ]\n        },\n        {\n          \"text\": \"暖意淡了回忆陪不了他\",\n          \"accent\": \"陪不了他\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S08-2\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像临走前回头再看一眼旧地方\",\n          \"after\": 2,\n          \"from\": [\n            \"S08-B2\"\n          ],\n          \"bars\": \"206–213\"\n        },\n        {\n          \"text\": \"胸口像终于吸进一口气，却只是一瞬\",\n          \"after\": 3,\n          \"from\": [\n            \"S08-B3\"\n          ],\n          \"bars\": \"206–213\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"缓慢宽广的歌唱短暂回来\",\n          \"from\": [\n            \"S08-B1\"\n          ],\n          \"bars\": \"206–213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他忽然说不清自己为何想回去\",\n          \"accent\": \"说不清\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S09-1\"\n          ]\n        },\n        {\n          \"text\": \"或许是舍不得被当作自己人\",\n          \"accent\": \"舍不得被当作自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S09-1\"\n          ]\n        },\n        {\n          \"text\": \"也或许怕孤单到愿再受气\",\n          \"accent\": \"怕孤单到愿再受气\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S09-1\"\n          ]\n        },\n        {\n          \"text\": \"这个念头让他一阵心慌\",\n          \"accent\": \"一阵心慌\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S09-2\"\n          ]\n        },\n        {\n          \"text\": \"他连往下想都不敢了\",\n          \"accent\": \"不敢了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S09-2\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从另一面，重新看见同一扇门\",\n          \"after\": 0,\n          \"from\": [\n            \"S09-B1\"\n          ],\n          \"bars\": \"214–215\"\n        },\n        {\n          \"text\": \"像再见从前的自己，想起受气和孤单\",\n          \"after\": 4,\n          \"from\": [\n            \"S09-B2\"\n          ],\n          \"bars\": \"214–215\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"颤音光晕里引子闪现，刚有的稳定又散了\",\n          \"from\": [\n            \"S09-B1\"\n          ],\n          \"bars\": \"214–215\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"可回去还能像从前那样吗？\",\n          \"accent\": \"还能像从前那样吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S10-1\"\n          ]\n        },\n        {\n          \"text\": \"那些委屈不能当作没发生过\",\n          \"accent\": \"不能当作没发生过\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S10-2\"\n          ]\n        },\n        {\n          \"text\": \"光凭舍不得他还是不敢回去\",\n          \"accent\": \"不敢回去\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S10-2\"\n          ]\n        },\n        {\n          \"text\": \"他反复想得心累眼下不踏实\",\n          \"accent\": \"心累\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S10-3\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像忽然失重，整个人悬在半空\",\n          \"after\": 3,\n          \"from\": [\n            \"S10-B2\"\n          ],\n          \"bars\": \"221–225\"\n        },\n        {\n          \"text\": \"像开头那样问：往后怎么生活？\",\n          \"after\": 3,\n          \"from\": [\n            \"S10-B3\"\n          ],\n          \"bars\": \"216–225\"\n        },\n        {\n          \"text\": \"像疲倦的人，连重要往事都说不动\",\n          \"after\": 3,\n          \"from\": [\n            \"S10-B4\"\n          ],\n          \"bars\": \"216–225\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旧歌和舞步只剩碎片，摇篮曲也破碎地回来\",\n          \"from\": [\n            \"S10-B1\"\n          ],\n          \"bars\": \"216–225\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他明知回去未必找回那份亲近\",\n          \"accent\": \"未必找回\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S11-1\"\n          ]\n        },\n        {\n          \"text\": \"可他还是忍不住想万一能呢？\",\n          \"accent\": \"万一能呢\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S11-1\"\n          ]\n        },\n        {\n          \"text\": \"他不愿只凭这点希望就回去忍让\",\n          \"accent\": \"不愿\",\n          \"emotion\": \"炽热\",\n          \"from\": [\n            \"S11-2\"\n          ]\n        },\n        {\n          \"text\": \"他想先把眼下日子过稳些\",\n          \"accent\": \"过稳些\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S11-3\"\n          ]\n        },\n        {\n          \"text\": \"害怕还在他却不想收回打算\",\n          \"accent\": \"不想收回打算\",\n          \"emotion\": \"炽热\",\n          \"from\": [\n            \"S11-4\",\n            \"S11-B3\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像是先试探几步，后来脚步越来越稳\",\n          \"after\": 4,\n          \"from\": [\n            \"S11-B2\"\n          ],\n          \"bars\": \"226–241\"\n        },\n        {\n          \"text\": \"像是还怕着，却还是迈出了一步\",\n          \"after\": 4,\n          \"from\": [\n            \"S11-B3\"\n          ],\n          \"bars\": \"226–241\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"低音一层层涌起，重和弦砸下又添新压力\",\n          \"from\": [\n            \"S11-B1\"\n          ],\n          \"bars\": \"226–241\"\n        },\n        {\n          \"text\": \"舞步由试探渐渐聚拢，向前感越来越强\",\n          \"from\": [\n            \"S11-B2\"\n          ],\n          \"bars\": \"226–241\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他觉得那些气不该忍也开心过\",\n          \"accent\": \"不该忍\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S12-1\"\n          ]\n        },\n        {\n          \"text\": \"这回他不再逼自己选边\",\n          \"accent\": \"不再逼自己选边\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S12-1\",\n            \"S12-B2\"\n          ]\n        },\n        {\n          \"text\": \"他不再怪自己当初离开\",\n          \"accent\": \"不再怪自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S12-2\"\n          ]\n        },\n        {\n          \"text\": \"他愿带着想念继续过日子\",\n          \"accent\": \"带着想念继续\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S12-2\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他怕往后一个人熬，却不愿只为陪伴回头\",\n          \"after\": 3,\n          \"from\": [\n            \"S12-2\"\n          ],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"即使会犹疑疲惫想念，他仍能自己作主\",\n          \"after\": 1,\n          \"from\": [\n            \"S12-B2\"\n          ],\n          \"bars\": \"242–253\"\n        },\n        {\n          \"text\": \"像和许多人一起抬头往前走\",\n          \"after\": 0,\n          \"from\": [\n            \"S12-B1\"\n          ],\n          \"bars\": \"242–253\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"波兰舞曲主题以雷鸣般声势轰然回归\",\n          \"from\": [\n            \"S12-B1\"\n          ],\n          \"bars\": \"242–253\"\n        },\n        {\n          \"text\": \"向前时色彩忽然一变，像脚下短暂一斜\",\n          \"from\": [\n            \"S12-B3\"\n          ],\n          \"bars\": \"249–253\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"想起从前亲近日子心里又热了\",\n          \"accent\": \"心里又热了\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S13-1\"\n          ]\n        },\n        {\n          \"text\": \"他盼着以后还能那样相处\",\n          \"accent\": \"还能那样相处\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S13-1\"\n          ]\n        },\n        {\n          \"text\": \"他有劲头过日子不再跟过去较劲\",\n          \"accent\": \"有劲头过日子\",\n          \"emotion\": \"炽热\",\n          \"from\": [\n            \"S13-2\"\n          ]\n        },\n        {\n          \"text\": \"他怕还要等很久才遇上亲近的人\",\n          \"accent\": \"等很久\",\n          \"emotion\": \"孤单\",\n          \"from\": [\n            \"S13-3\"\n          ]\n        },\n        {\n          \"text\": \"没人把他当自己人他也好好过\",\n          \"accent\": \"好好过\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S13-4\"\n          ]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像故乡和从前熟悉的人都回到眼前\",\n          \"after\": 1,\n          \"from\": [\n            \"S13-B1\"\n          ],\n          \"bars\": \"254–270\"\n        },\n        {\n          \"text\": \"原本藏在心里的想念，忽然放开了\",\n          \"after\": 2,\n          \"from\": [\n            \"S13-B1\"\n          ],\n          \"bars\": \"254–270\"\n        },\n        {\n          \"text\": \"像被气流推着跑，兴奋得喘不过气\",\n          \"after\": 2,\n          \"from\": [\n            \"S13-B2\"\n          ],\n          \"bars\": \"269–280\"\n        },\n        {\n          \"text\": \"刚有的成功感像还不牢靠，心里渐渐静下来\",\n          \"after\": 3,\n          \"from\": [\n            \"S13-B3\",\n            \"S13-3\"\n          ],\n          \"bars\": \"281–287\"\n        },\n        {\n          \"text\": \"有人再当他自己人，他会珍惜，不再咽委屈\",\n          \"after\": 4,\n          \"from\": [\n            \"S13-4\"\n          ],\n          \"bars\": \"\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"柔软歌唱被带进管风琴般宏大的声势\",\n          \"from\": [\n            \"S13-B1\"\n          ],\n          \"bars\": \"254–270\"\n        },\n        {\n          \"text\": \"密集声音像激流向天空喷涌\",\n          \"from\": [\n            \"S13-B1\"\n      