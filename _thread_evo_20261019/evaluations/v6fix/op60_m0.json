      "rel": "动摇",
      "how": ""
     }
    ]
   },
   {
    "sec": "S05",
    "bars": "35–39",
    "relation": "正在面对",
    "items": [
     {
      "id": "I35",
      "text": "那一点舍不得还没完全散去",
      "key": "没完全散去",
      "follows": null
     },
     {
      "id": "I36",
      "text": "稍想亲近不能一直这样，他心里就发酸",
      "key": "心里就发酸",
      "follows": null
     },
     {
      "id": "I37",
      "text": "他还谈不上害怕，只是格外珍惜",
      "key": "格外珍惜",
      "follows": null
     },
     {
      "id": "I38",
      "text": "他的温柔里多了一点不愿松开的心思",
      "key": "不愿松开",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I30",
      "to": "I35",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I24",
      "to": "I36",
      "rel": "提供理由",
      "how": "他已经真切得到过这份幸福"
     },
     {
      "from": "I32",
      "to": "I36",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I34",
      "to": "I37",
      "rel": "提供理由",
      "how": ""
     }
    ]
   },
   {
    "sec": "S06",
    "bars": "40–50",
    "relation": "正在面对",
    "items": [
     {
      "id": "I39",
      "text": "那份酸楚没妨碍他安心地亲近",
      "key": "安心地亲近",
      "follows": null
     },
     {
      "id": "I40",
      "text": "他不因一时的不舍怀疑眼前幸福",
      "key": "怀疑眼前幸福",
      "follows": null
     },
     {
      "id": "I41",
      "text": "他不必时时确认彼此有多亲近",
      "key": "时时确认",
      "follows": null
     },
     {
      "id": "I42",
      "text": "他不必把每一分心意都表达完整",
      "key": "表达完整",
      "follows": null
     },
     {
      "id": "I43",
      "text": "他依然觉得自己被对方放在心上",
      "key": "放在心上",
      "follows": null
     },
     {
      "id": "I44",
      "text": "这样的余地比热烈回应更让他舒服",
      "key": "热烈回应",
      "follows": null
     },
     {
      "id": "I45",
      "text": "他可以安静地享受亲近",
      "key": "安静地享受",
      "follows": null
     },
     {
      "id": "I46",
      "text": "他任凭爱意在心里慢慢生长",
      "key": "慢慢生长",
      "follows": null
     },
     {
      "id": "I47",
      "text": "有时一切都好，他仍轻轻心疼",
      "key": "轻轻心疼",
      "follows": null
     },
     {
      "id": "I48",
      "text": "他也舍不得失去那个不必防备的自己",
      "key": "不必防备的自己",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I7",
      "to": "I40",
      "rel": "提供理由",
      "how": "他对这份温暖已有切身的信任"
     },
     {
      "from": "I14",
      "to": "I44",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I37",
      "to": "I47",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I25",
      "to": "I48",
      "rel": "提供理由",
      "how": ""
     }
    ]
   },
   {
    "sec": "S07",
    "bars": "51–61",
    "relation": "正在面对",
    "items": [
     {
      "id": "I49",
      "text": "这份自在使他想靠近得更深",
      "key": "靠近得更深",
      "follows": null
     },
     {
      "id": "I50",
      "text": "他已不满足于只是感到被爱",
      "key": "只是感到被爱",
      "follows": null
     },
     {
      "id": "I51",
      "text": "他想让最深、最难说的情意被对方领受",
      "key": "被对方领受",
      "follows": null
     },
     {
      "id": "I52",
      "text": "他想把更多爱意给出去",
      "key": "更多爱意",
      "follows": null
     },
     {
      "id": "I53",
      "text": "他想把对方的温柔完整接住",
      "key": "完整接住",
      "follows": null
     },
     {
      "id": "I54",
      "text": "他有一点急切，舍不得心里还有保留",
      "key": "心里还有保留",
      "follows": null
     },
     {
      "id": "I55",
      "text": "失去的担忧反而催他尽情相爱",
      "key": "催他尽情相爱",
      "follows": null
     },
     {
      "id": "I56",
      "text": "他不愿为了将来少痛就眼下少爱",
      "key": "眼下少爱",
      "follows": null
     },
     {
      "id": "I57",
      "text": "平日让他迟疑的顾虑暂时显得很小",
      "key": "暂时显得很小",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I44",
      "to": "I49",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I43",
      "to": "I50",
      "rel": "限制",
      "how": "他还希望自己的情意能抵达对方"
     },
     {
      "from": "I18",
      "to": "I51",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I36",
      "to": "I55",
      "rel": "改写",
      "how": "失去的可能使他更急于把眼下的爱给足"
     },
     {
      "from": "I38",
      "to": "I56",
      "rel": "仍在起作用",
      "how": ""
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "62–71",
    "relation": "还说不清",
    "items": [
     {
      "id": "I58",
      "text": "更深的亲近确实给了他想要的快乐",
      "key": "想要的快乐",
      "follows": null
     },
     {
      "id": "I59",
      "text": "有一阵他几乎顾不上别的",
      "key": "顾不上别的",
      "follows": null
     },
     {
      "id": "I60",
      "text": "他觉得自己从未这样满足过",
      "key": "从未这样满足",
      "follows": null
     },
     {
      "id": "I61",
      "text": "欢喜稍平缓，他心里仍有一处空落",
      "key": "一处空落",
      "follows": null
     },
     {
      "id": "I62",
      "text": "他不愿承认自己仍觉得不够",
      "key": "仍觉得不够",
      "follows": null
     },
     {
      "id": "I63",
      "text": "他为仍然不满足感到一点委屈",
      "key": "一点委屈",
      "follows": null
     },
     {
      "id": "I64",
      "text": "他又有些羞愧，仿佛辜负了幸福",
      "key": "仿佛辜负了幸福",
      "follows": null
     },
     {
      "id": "I65",
      "text": "刚才的亲密仍让他觉得真切",
      "key": "觉得真切",
      "follows": null
     },
     {
      "id": "I66",
      "text": "他难受于那份充盈不能始终保持",
      "key": "不能始终保持",
      "follows": null
     },
     {
      "id": "I67",
      "text": "他仍有一种自己也说不清的渴",
      "key": "说不清的渴",
      "follows": null
     }
    ],
    "because": [
