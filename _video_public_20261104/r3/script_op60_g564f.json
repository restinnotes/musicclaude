 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现很想靠近对方 / 心里一下热起来，连自己都意外",
       "keys": [
        "很想靠近对方",
        "一下热起来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "烟花向高处迸开，光点落下后却还悬在水面上方",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "像刚踩上微晃的船板，脚下水波荡开",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方看出自己有多在乎 / 又怕这份需要让对方觉得负担太重 / 所以只敢露出一点喜欢",
       "keys": [
        "觉得负担太重",
        "一点喜欢"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "话还没出口，先有几秒钟沉默",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这点亲近已经让他觉得甜 / 可他还拿不准，下次能不能更坦白",
       "keys": [
        "觉得甜",
        "更坦白"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因为他露出在意就退开 / 仍愿意跟他亲近，他这才慢慢放松",
       "keys": [
        "没有因为他露出在意就退开",
        "慢慢放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩膀挨着肩膀，连呼吸都贴在一起，沉默也不紧张",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "心跳和水浪一下一下托着身体，脚下仿佛不必踩实",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "舒服地漂着，水却一直在流，时间也一直往前走",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠近 / 一阵子喜欢得几乎藏不住 / 又怕太急弄坏眼下的自在，最后收住",
       "keys": [
        "喜欢得几乎藏不住",
        "最后收住"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声忽然往上涌，像忍不住热切地多说了一点",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "它没有继续冲高，又像轻轻呼出一口气，回到柔和",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待得这么好 / 他却想到这样的时刻总会过去 / 还没分开就先舍不得",
       "keys": [
        "总会过去",
        "先舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "眼前的好还在，心里却已经鼻酸，盼这一刻慢一点",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他难得不去想两个人以后会怎样 / 只想舒服地待在这份亲近里",
       "keys": [
        "不去想两个人以后会怎样",
        "这份亲近"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波托着身体，只管摇晃、漂着，暂时不去哪里",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他忽然想告诉对方自己有多喜欢 / 也想问对方是不是一样 / 可还没想好怎么开口，念头就淡了",
       "keys": [
        "有多喜欢",
        "念头就淡了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急着表达的念头刚露头，很快又沉了下去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水下暗流像拖住谈话，思绪也像被风吹碎的倒影",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又回来了 / 他想起上回明明想说，却没有开口",
       "keys": [
        "熟悉的亲近",
        "没有开口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两道声线仍贴着耳语，这一遍却更华丽、更迫切",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "这回他几乎想把藏着的话全说出来 / 也盼着对方喜欢自己不再小心收着",
