      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S13",
    "bars": "254–288",
    "relation": "正在面对",
    "items": [
     {
      "id": "S13-1",
      "text": "他继续照着那些自己真正看重的要求生活，没有把省掉的旧步骤全数加回来，也仍愿意把手边的事一件件做周全。",
      "key": "他继续照着那些自",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-2",
       "S12-1"
      ]
