 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然很想靠近对方，心里一下热起来，连自己都没想到。",
       "keys": [
        "很想靠近对方",
        "一下热起来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "烟花一下升起，碎光落下来，却还悬在水上。",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他只敢露出一点喜欢，怕对方看出自己有多需要这份亲近，会觉得负担太重。",
       "keys": [
        "只敢露出一点喜欢",
        "负担太重"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话到嘴边又停住，怕说出来关系就变了。",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "只靠近这一点他就觉得甜，却还拿不准下次能不能更坦白。",
       "keys": [
        "觉得甜",
        "拿不准"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚踩上小船，木板微晃，身体还没站稳。",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看见他在意也没有退开，还愿意亲近他，他才慢慢放松下来。",
       "keys": [
        "没有退开",
        "放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声还没出来，像心跳的水波已经一下一下托住身体。",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像挨在一起说悄悄话，不说话也不觉得尴尬。",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想靠得更近，喜欢得快藏不住了，可又怕太急弄坏现在的自在，最后还是收住了。",
       "keys": [
        "想靠得更近",
        "最后还是收住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音忽然往上涌，像心里话一下热切起来，连呼吸都变了。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "又像轻轻吐出一口气，回到柔和，话还没说死。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待在一起这么好，他却想到这一刻总会过去，还没分开就已经舍不得。",
       "keys": [
        "这一刻总会过去",
        "还没分开就已经舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "柔软的落音像温柔的小刺，明明甜，鼻子却有点酸。",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他终于不急着想两个人以后怎样，只想舒服地待在这份亲近里。",
       "keys": [
        "不急着想",
        "舒服地待在这份亲近里"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波轻轻托着身体，摇啊摇，像哪儿也不用去。",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "聊过后静下来也不尴尬，心却走神了。",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他忽然想说自己多喜欢这样，也想问对方是不是一样，可还没想好怎么开口，念头就淡了。",
       "keys": [
        "想问对方是不是一样",
        "念头就淡了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像几句话急着冒出来，又沉回去了。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水还在晃，却像被暗流拖住，话停在半途。",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "再次和对方亲近，他高兴得想起上回那些到了嘴边却没说的话。",
       "keys": [
        "再次和对方亲近",
        "没说的话"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两道声音又像贴着耳语，这次却更急，忍不住多说几句。",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想把藏着的话全说出来，也盼对方喜欢他不再小心收着的样子。",
       "keys": [
        "把藏着的话全说出来",
        "盼对方喜欢"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像原本轻握的手，不知不觉握得更紧了。",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "高处的长音亮得刺眼，像想说话却哽在喉咙里。",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他想多说一些，好让眼下的好留久一点，又怕说太多让对方为难、弄丢原来的自在，所以还是有些话没说出口。",
       "keys": [
        "留久一点",
        "怕说太多让对方为难"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "越想抱紧，船晃得越厉害，反而怕失去平衡。",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "还没失去什么，心里却已经发酸，想让水流得慢一点。",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "前几次他都收住了喜欢，可对方一直愿意亲近，这回他不知不觉露得太多，让对方看出他有多在乎。",
       "keys": [
        "不知不觉露得太多",
        "看出他有多在乎"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像攥着的手忽然松开，深吸了一口气。",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他之前还能装作没那么在乎，现在对方看出来了，他心里空落落的，连怎么相处都没了主意。",
       "keys": [
        "空落落的",
        "没了主意"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波像突然被抽走，只剩一道孤零零的声音，在雾里飘着。",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他担心对方会嫌自己太黏，原来熟悉的亲近一下也像隔了一层。",
       "keys": [
        "嫌自己太黏",
        "像隔了一层"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像刚才还在贴着耳语，声音却忽然停了。",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "心里忍不住问：这样的幸福能维持多久？",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他有多在乎，跟他相处却没变，他这才又能像从前一样自在。",
       "keys": [
        "相处却没变",
        "又能像从前一样自在"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从暖金色的水面滑进桥影，空气凉了，脚下的摇晃也轻了。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "安静下来，他才想到对方根本不知道自己刚才多怕被嫌弃，心里忽然有点孤单。",
       "keys": [
        "不知道自己刚才多怕被嫌弃",
        "有点孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像独处时想起白天的亲近，明明很好却有点鼻酸，仿佛已经成了回忆。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "不过对方一直没退开，他又忍不住猜，对方是不是也舍不得结束这份亲近？",
       "keys": [
        "一直没退开",
        "是不是也舍不得"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "两个声音时近时远，像刚想着“算了”，又忍不住想“还是放不下”。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "那份暖意像一层层水波，越舒服，反而越没方向。",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起这段时间对方总愿意跟他待在一起，他开始觉得，也许对方有时也需要自己，跟自己待着也会安心。",
       "keys": [
        "也需要自己",
        "也会安心"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "清澈还在，底下却像有暗流往上涌，心跳越来越重。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他越想越高兴，想到两个人能这样亲近就舍不得停，连自己都快收不住了。",
       "keys": [
        "越想越高兴",
        "舍不得停"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体像被什么推着往前，光是安静待着已经不够了。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "像气味、触感、幻想、遗憾和快感混在一起，暖得不想抽身。",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他盼着以后对方想找人陪时还会想到自己，让自己能一直陪在身边。",
       "keys": [
        "还会想到自己",
        "一直陪在身边"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "眼前明明还这么好，却仿佛已经听见时间不停地走。",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "上次是不小心露出喜欢，这次看对方还愿意亲近，他想主动一点，大大方方地回应。",
       "keys": [
        "想主动一点",
        "大大方方地回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声一下舒展开，像终于可以痛快地说话了。",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "身体也轻起来，像重新吹到风，还带一点玩心。",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他连以后的日子都开始盼了，觉得两个人说不定还能这样好很久。",
       "keys": [
        "以后的日子都开始盼了",
        "这样好很久"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他一想到今天这样好不代表以后天天都好，心里又有点没底。",
       "keys": [
        "不代表以后天天都好",
        "有点没底"
       ],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声还没落稳就停了，快乐还在，心里却开始怀念。",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他越想越怕：万一以后对方不再需要他陪，连跟他待在一起都不愿意了呢？",
       "keys": [
        "对方不再需要他陪",
        "不愿意了呢"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "阳光像被薄雾遮住，没全暗，心里却沉了下去。",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他一下安静了，刚才还敢盼很久以后，现在却不敢再往下想。",
       "keys": [
        "一下安静了",
        "不敢再往下想"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话说到要紧处突然顿住，连呼吸都屏住了。",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "轻轻的声音悬在半空，绷着的劲还没松。",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "心里还在问：刚才那是真的吗？接下来怎么办？",
       "keys": [],
       "from": [
        "S09-B3"
       ],
       "bead": "S09-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想起对方一直没退开，两人现在也还亲近，于是觉得对方也许喜欢有他陪着，心里又有点高兴。",
       "keys": [
        "一直没退开",
        "又有点高兴"
       ],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像抬头看见夜空，担心还在，却不再占满整个心。",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他怕再猜下去连今天都过不好，就先不想以后，只管享受眼前的亲近。",
       "keys": [
        "先不想以后",
        "享受眼前的亲近"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像清风吹开水波，暂时不用跟着时间往前赶。",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "先前的紧绷慢慢松了，他心里亮得想笑，又有点想哭。",
       "keys": [
        "紧绷慢慢松了",
        "想笑，又有点想哭"
       ],
       "from": [
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩膀终于放下，长出一口气，胸口也打开了。",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "轻得像整个人飘在夏夜的风里。",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      },
      {
       "text": "一串亮亮的音像瀑布从高处落进水里。",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他突然不想再藏喜欢了，即使以后对方有时不需要他陪，他也愿意陪在身边。",
       "keys": [
        "不想再藏喜欢了",
        "愿意陪在身边"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的歌突然变得很直接，轻晃的水波像翻成了大浪。",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到自己可以这样坦白地在乎对方，他高兴得顾不上害羞，也不觉得这有什么不好。",
       "keys": [
        "坦白地在乎对方",
        "顾不上害羞"
       ],
       "from": [
        "S11-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像落日前的天空红得发烫，光太刺眼，胸口也有点疼。",
       "keys": [],
       "from": [
        "S11-B4"
       ],
       "bead": "S11-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他自己愿意一直陪，也不能替对方做决定：以后对方还愿不愿意，他不知道，刚才的欢喜也压得心口发疼。",
       "keys": [
        "不能替对方做决定",
        "心口发疼"
       ],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像多年后重回旧房子，东西没怎么变，心里却多了许多事。",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      },
      {
       "text": "刚涌上来的力量又停在半空，好像还有一股更大的浪要来。",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他只想把能给的都给对方，连对方是否同样在乎自己，也顾不上想了。",
       "keys": [
        "把能给的都给对方",
        "顾不上想了"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像小声说的话突然响遍四周，人都忘了自己。",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "明知道再用心也没法保证以后一直这么好，他还是觉得不够，想再多陪对方一会儿。",
       "keys": [
        "没法保证以后一直这么好",
        "想再多陪对方一会儿"
       ],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声越往上够，末尾越像被拖住，憋着的那口气迟迟不松。",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "那阵高兴终于整个涌出来，他不再逼自己收着，只顾痛痛快快地喜欢对方。",
       "keys": [
        "高兴终于整个涌出来",
        "痛痛快快地喜欢对方"
       ],
       "from": [
        "S12-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像重逢时抱紧对方，喉咙发紧，分不清想笑还是想哭。",
       "keys": [],
       "from": [
        "S12-B3"
       ],
       "bead": "S12-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他高兴过后又想要一句永远不变的保证，可他知道谁也没法答应永远。",
       "keys": [
        "永远不变的保证",
        "没法答应"
       ],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚冲上一道浪峰，后面的浪还在推，想停也停不下。",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他一想到对方以后可能不再需要自己，就想把喜欢藏回一点，免得日后太疼；最初他却是怕说多了给对方添负担。",
       "keys": [
        "把喜欢藏回一点",
        "免得日后太疼"
       ],
       "from": [
        "S13-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像刚坚定地说了“是”，心里就冒出一句“可是呢？”",
       "keys": [],
       "from": [
        "S13-B2"
       ],
       "bead": "S13-B2"
      },
      {
       "text": "声音还亮着，里面却越来越尖、越来越暗，心里也跟着疼。",
       "keys": [],
       "from": [
        "S13-B3"
       ],
       "bead": "S13-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他早就没法装作不在乎了，刚才想对对方好也是真心的，真收回去只会让自己更难受。",
       "keys": [
        "没法装作不在乎了",
        "更难受"
       ],
       "from": [
        "S13-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "脚下像站得很稳，胸口却一沉再沉，像不停叹气。",
       "keys": [],
       "from": [
        "S13-B4"
       ],
       "bead": "S13-B4"
      },
      {
       "text": "像终于握住珍贵的东西，却发现这一刻没法一直留住。",
       "keys": [],
       "from": [
        "S13-B3"
       ],
       "bead": "S13-B3"
      }
     ]
    }
   ]
  },
