                    /* Images are sized, lazy-loaded and given their sample CTA when the
                       body is rendered (View/Helper/ReportBodyHelper.php). This used to
                       strip each src and re-point it through lazysizes on ready, which
                       cancelled loads that were already in flight and forced a fabricated
                       670x350 box onto any image the CMS had not sized - the report
                       snapshot is ~3:2, so that box was ~27% short and everything below
                       it jumped once the real image decoded. */


                $('div#rprt_summary').find("img:first").on("click", function(){

                    let src = $(this).attr("src");
                    $("#modalRdImage").attr("src", src);

                    $("#myModal3").modal("show");

                });

                $('.modal_for_zoom_img').on('click', function () {
                    $("#myModal3").modal("hide");
                });
             

                /* The per-image "Download Free Sample Report" CTA and the source
                   caption are rendered server-side now. Injecting them a second
                   after load pushed every following block down by ~87px each. */
                $('.horizontal_image_ad').after('<div class="report_down_sec"><a href="/research-insights/hormuz-crisis-global-oil-gas-market-reset" rel="nofollow" style="" target="_blank">Learn more</a>&nbsp;about the impact of the ongoing Middle East conflict on the global oil & gas, and energy markets  </div>');

                var sample_url = "/industry-analysis/us-household-vacuum-cleaner-market-report/request/d2";

                
