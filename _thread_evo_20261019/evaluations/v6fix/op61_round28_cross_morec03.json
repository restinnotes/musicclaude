      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "熟悉的沉重又回来了，他才觉得自己似乎能稳住，心里就骤然一紧。",
      "key": "熟悉的沉重又回来",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-2"
      ]
     },
     {
      "id": "S09-2",
      "text": "但这回他没有因慌乱就放下对自己的要求，只是对归属能否再近一点仍没有答案。",
      "key": "但这回他没有因慌",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-2",
       "S09-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S08-2",
