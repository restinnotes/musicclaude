 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开熟悉的生活，起初总算不用再委屈自己",
       "keys": [
        "不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那阵声音像烟雾往高处散，也像一句等不到回声的召唤",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "我不能倒下，可我其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想往前过却说不清舍不得什么，也不知靠什么安下心",
       "keys": [
        "安下心"
       ],
       "from": [
        "S01-2",
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里像有话，却分不清是愤怒、遗憾还是怀念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "他像刚醒来，胸口发紧、眼前模糊，颤抖着伸手却摸到虚空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "旧日的声音和光线忽然回来，身体像先记起怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前自在的日子，想到以后不能再那样过就发慌",
       "keys": [
        "发慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "舞步像给众人看的庄严，旧歌却只能私下模糊哼几句",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "他像腿脚发虚的人，在记忆里勉强挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他赶紧想起受过的气，怕一心软就忘了当初为何离开",
       "keys": [
        "忘了当初为何离开"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他抬头遮住动摇，起初信“我没事”，后来越说越在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他还是不甘心，难道以前的好日子也得一起丢掉吗？",
       "keys": [
        "不甘心"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "那股激昂像在喊：我不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他还憋着气，却因想起被当作自己人而高兴片刻",
       "keys": [
        "高兴片刻"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "若把那一下听得更重，就像重锤砸下，带着怒气和抗拒",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "有人想到夏日故乡麦浪，也有人想起亲近旧时光",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那点高兴很快变酸，他怀疑离开后会更好吗？",
       "keys": [
        "变酸"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他像暂时走开聊别的，轻松却没解开心事",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "耳边像多人低声絮语，脚下却像流沙",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "他怀疑刚才的昂扬是真信还是硬撑",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起亲近的日子，他真盼着还能那样相处",
       "keys": [
        "盼着还能那样相处"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日忽然鲜活，连感激和短暂幸福都回来了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "外表还想坚定向前，心里却柔软得容易受伤",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "亲近越鲜活时委屈越翻上来，他又犹豫了",
       "keys": [
        "委屈越翻上来"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "回忆太好才更刺痛，过去回不来，抵抗也疲惫仓促",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "脚步像乱了拍的心跳，身体被催得停不下来",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "他反复问走得对吗，没走会怎样，脑子停不下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他觉得当初那些气不该忍，可连开心事都不敢想太难受",
       "keys": [
        "不该忍"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两个人像在夜色里低声说话，亲近却克制",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "那句“不能就这样算了”里，仍有愤怒和自护",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "某个人、故乡或旧日生活又有了温度，眷恋里仍有失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争到没力气后，他只剩下离开那些人的难受",
       "keys": [
        "离开那些人的难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "脚下像忽然没了地板，只剩一个声音独自说话",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "像深深呼吸几次，不是想通了，只是抵抗累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "难受慢慢缓下来，他这回没急着用旧委屈压住想念",
       "keys": [
        "没急着用旧委屈压住想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那份安宁像隔着玻璃，也像母亲轻哼的摇篮曲",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "他终于不用解释难过，也不必装作坚强",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "他像向遥远又不确定的对象祈求，却未必有回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "他只是远远看着珍惜的一切，不急着抓回来，心里也暖",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他才懂有人陪着多轻松，也盼亲近重来却怕再没有",
       "keys": [
        "怕再没有"
       ],
       "from": [
        "S06-2",
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "远方的家园像在梦里忽然被照亮",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，他又怕以后遇上难事只能独自硬撑",
       "keys": [
        "独自硬撑"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像寒风猛地吹开窗，后颈一凉，脉搏骤快",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "事情像过去了，身体还在发颤，想冲出去却没出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "当初只想不再受气，早知道会这么孤单还会走吗？",
       "keys": [
        "还会走吗？"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "场景忽然换了，刚才的思绪被截断，却不等于好转",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想找回亲近却不愿再受委屈，连当初的决心也淡了",
       "keys": [
        "决心也淡了"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的动作或舞步闯进来，反而让失去更清楚",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他先把回去放一边，想起被当作自己人心里暖了",
       "keys": [
        "心里暖了"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像临走前回头一看，温柔又不舍",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可回忆陪不了他过难关，心又悬了",
       "keys": [
        "心又悬了"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "胸口像终于吸进一口气，却只一瞬",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他忽然分不清，想回去是舍不得亲近还是怕孤单",
       "keys": [
        "怕孤单"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "想到自己竟愿再受那些气，他心慌得不敢往下想",
       "keys": [
        "不敢往下想"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像重新遇见那个无措的自己，这回却记得他经历过什么",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他最舍不得曾被当作自己人的日子",
       "keys": [
        "最舍不得"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "回去还能亲近如初吗？当初委屈不能当没发生",
       "keys": [
        "当初委屈不能当没发生"
       ],
       "from": [
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音碎成片，像旧歌、舞步残片或破碎摇篮曲，人也像失重悬在半空",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他问往后怎么生活，眼下也不踏实",
       "keys": [
        "眼下也不踏实"
       ],
       "from": [
        "S10-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "他像累坏了，明知往事重要却无力重讲",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "回去未必找回亲近，他却还想万一能呢",
       "keys": [
        "万一能呢"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不肯只凭盼头回去忍让，想先把眼下过稳",
       "keys": [
        "把眼下过稳"
       ],
       "from": [
        "S11-2",
        "S11-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "他像困兽，一次次顶住再用力",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      },
      {
       "text": "他怕以后独自扛，祈求像变成意志，脚仍往前走",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不再逼自己选边，承认当初受的气不该忍",
       "keys": [
        "不再逼自己选边"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他承认从前真开心，也不再怪自己离开",
       "keys": [
        "不再怪自己离开"
       ],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他怕以后独自熬，仍带着想念往前也不为陪伴回头",
       "keys": [
        "带着想念往前"
       ],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "这份昂扬像面向众人的宣告，也带着集体感",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
