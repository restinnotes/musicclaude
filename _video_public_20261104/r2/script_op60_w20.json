       "from": [
        "S03-B1-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我想告诉对方我多喜欢两人相处，也想问对方是否一样，转眼又不想说了。",
