                  document.querySelectorAll('.header__inline-menu').forEach(function(menuItem) {
                    // 对每个menu-item下的submenu-link添加鼠标进入事件
                    menuItem.querySelectorAll('.submenu-link').forEach(function(link, index) {
                      link.addEventListener('mouseenter', function() {
                        var collectionIndex = this.getAttribute('data-collection');

                        // 取消当前menu-item下所有submenu-link的active样式
                        menuItem.querySelectorAll('.submenu-link').forEach(function(sublink) {
                          sublink.classList.remove('active');
                        });

                        // 为当前悬停的submenu-link添加active样式
                        this.classList.add('active');

                        // 只隐藏当前menu-item下的collection-products
                        menuItem.querySelectorAll('.collection-products').forEach(function(collection) {
                          collection.classList.remove('active');
                        });

                        // 显示对应的collection-products
                        var targetCollection = menuItem.querySelector('.collection-products[data-collection="' + collectionIndex + '"]');
                        if (targetCollection) {
                          targetCollection.classList.add('active');
                        }
                      });

                      // 默认显示第一个submenu-link的active样式
                      if (index === 0) {
                        link.classList.add('active');
                      }
                    });

                    // 默认显示当前menu-item下的第一个collection-products
                    var firstCollection = menuItem.querySelector('.collection-products[data-collection="1"]');
                    if (firstCollection) {
                      firstCollection.classList.add('active');
                    }
                  });
                </script><li class="nav--lv1"><a href="/pages/product-info" class="site-nav__link--main" title="支持">支持</a></li><li class="nav--lv1"><a href="/pages/about-miniforums" class="site-nav__link--main" title="关于铭凡">关于铭凡</a></li><li class="nav--lv1"><a href="/news" class="site-nav__link--main" title="新闻中心">新闻中心</a></li><li class="nav--lv1"><a href="/pages/ai-x1-pro" class="site-nav__link--main" title="AI X1 Pro">AI X1 Pro</a></li><li class="nav--lv1"><a href="/products/MS-S1-MAX-P495" class="site-nav__link--main" title="🔥MS-S1 MAX-P495">🔥MS-S1 MAX-P495</a></li><li class="nav--lv1"><a href="/products/MS-02-Ultra" class="site-nav__link--main" title="🔥MS-02 Ultra">🔥MS-02 Ultra</a></li><li class="banner-li nav--lv1 parent--lv1 site-nav--Default buyer-guide-nav"><a href="/zh#" class="site-nav__link--main d-flex align-items-center" title="企业选购指南"><span class="site-nav--title" aaa="">
