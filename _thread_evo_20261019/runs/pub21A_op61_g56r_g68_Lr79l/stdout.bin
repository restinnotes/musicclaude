  \"keep\": \"越想念\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"可正因已经过去，眷恋里也带着失落\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"正因已过去\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是想通了\"\n        },\n        {\n          \"quote\": \"像脚下原有的地板忽然不见了，只剩一个声音自己说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他不服气\",\n          \"point\": \"受过的气不该忍，开心的事也不该抹掉\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"也不该抹掉\"\n        },\n        {\n          \"text\": \"争得没了力气\",\n          \"point\": \"已不在那些人身边\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"争得没了力气，他才发现\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那些压住的愿望、委屈和思念，终于有机会浮现\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"这回想起从前\",\n          \"point\": \"没急着拿受过的气压住想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这回\"\n        },\n        {\n          \"text\": \"独自熬过难处后\",\n          \"point\": \"有人陪着