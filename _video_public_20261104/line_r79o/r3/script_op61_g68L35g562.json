 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他已经不再过那种曾经让他自然感到归属的生活，却仍然想念那份熟悉",
       "keys": [
        "仍然想念那份熟悉"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉中醒来，四周又冷又空，胸口发紧、伸手只摸到空处",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他把这种想念看成自己不够坚强，试着不去承认它，想靠克制自己维持尊严",
       "keys": [
        "想靠克制自己维持尊严"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "强撑着提醒自己不能倒下，可心里其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "脑子还没想清楚，身体先隐约记起了怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他继续压住对旧日生活的怀念，努力让自己相信已经能够独自站稳",
       "keys": [
        "努力让自己相信已经能够独自站稳"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像腿脚发虚的人，还在记忆里勉强挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "呼吸像被催着一样，变得越来越急促",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "像整理好衣服抬起头，不让人看出自己动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "一遍遍对自己说没事，说到后来反倒露出了自己有多在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "哪怕心里还在难受，也不甘心就这样垮下去",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他渐渐发现，压住想念并没有让它消失",
       "keys": [
        "压住想念并没有让它消失"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像回到故乡夏日的麦浪与微风里，温和又轻快",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像出去走走换个心情，轻松是真的，心结却还没解开",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他只是一直不愿正视那份归属感的缺失",
       "keys": [
        "不愿正视那份归属感的缺失"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "耳边像有人低声絮语，脚下像踩着流沙抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "我刚才是真信那些话，还是在勉强自己去信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他终于承认自己确实想念旧日生活和其中的归属感，不再假装已经无所谓",
       "keys": [
        "不再假装已经无所谓"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "表面还撑着从前坚定的样子，心却比以前更容易受伤了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "过去太好又回不去才最刺痛，像在拉扯中疲惫地步步后退",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "像急促的脚步和乱了拍的心跳，被催着往前跑停不下来",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "脑子里还在问怎么会变成这样，不停往前赶只是不敢停下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "承认以后，那份留恋并没有减轻",
       "keys": [
        "那份留恋并没有减轻"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里还憋着那股护住自己的劲：这件事不能就这么算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "让他惦记的像是某个人，又像是故乡或从前的日子",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他仍担心，若完全承认自己有多想念，就像承认自己无法独立站稳",
       "keys": [
        "就像承认自己无法独立站稳"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像脚下的地板忽然空了，只剩一个声音在自言自语",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "像长叹一口气松了下来，其实还没想通，只是争累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他慢慢明白，想念过去并不等于放弃尊严",
       "keys": [
        "想念过去并不等于放弃尊严"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "世界像被透明玻璃罩隔开，像听着母亲哼摇篮曲，连呼吸都放轻",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "终于不用向人解释为什么难过，也不用再硬撑着装坚强",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他仍希望拥有那份归属，却不必再因为这份希望责怪自己",
       "keys": [
        "不必再因为这份希望责怪自己"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像对着远方真切地祈求，却不知道会不会有回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "远去的家园像在梦里被照亮，虽然回不去，却远远看见了它",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "明知有些珍惜的事挽不回，便静静看着，不再急着抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他开始照这个认识对待自己：不再强迫自己表现得已经完全放下",
       "keys": [
        "不再强迫自己表现得已经完全放下"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像寒风猛地吹开窗把人从好梦里拽醒，后颈一凉、脉搏乱跳",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "事情表面上好像过去了，心里却还翻腾着找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "也不把怀念变成必须回到过去的要求",
       "keys": [
        "不把怀念变成必须回到过去的要求"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "一个熟悉的动作或舞步冷不防闯进来，反倒更看清失去了什么",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      },
      {
       "text": "刚才的思绪一下被打断，换了副热闹步子心里却安定不下来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "有一阵，他没有主动想起旧日生活，也没有急着压下或解释自己的怀念",
       "keys": [
        "没有急着压下或解释自己的怀念"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像准备离开的人在最后一刻回头，再看一眼待过的地方",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      },
      {
       "text": "激烈的思绪间胸口像终于吸进一口气，也只是瞬间的喘息",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这段空白里，他没有新的自我判断，也没有作出新的决定",
       "keys": [
        "没有作出新的决定"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从另一面又看见了当初那扇门，往前的步子还没聚起来",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "像又遇见当初不知所措的自己，走过这一路问题还是没答案",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "后来，旧日生活的怀念再次浮上来，那份归属感仍让他舍不得",
       "keys": [
        "那份归属感仍让他舍不得"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "但这一次，他没有因为再次想念而责怪自己不够坚强",
       "keys": [
        "没有因为再次想念而责怪自己不够坚强"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像忽然失重悬在半空，辨不清方向也没了着落",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "心里又浮出那个问题：那么，我究竟要怎么继续过下去？",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      },
      {
       "text": "像疲倦的人回想往事，明知它很重要，却没力气再讲一遍了",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他仍然想念旧日生活，也仍希望自己能够保持尊严",
       "keys": [
        "也仍希望自己能够保持尊严"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "明知回去未必找得回那份亲近，心里还是忍不住想：万一能呢？",
       "keys": [],
       "from": [
        "S11-1"
       ],
       "bead": "S11-1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "这两种心情可以同时留在心里，不必互相取消",
       "keys": [
        "不必互相取消"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像绝境里的困兽一次次顶住重压，心里的祈求化作了迈步的决心",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      },
      {
       "text": "害怕还在，脚却已经往前走了，不再困在原地的停滞里",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他仍然珍惜旧日生活给予自己的归属感，没有逼自己把这段过去忘掉",
       "keys": [
        "没有逼自己把这段过去忘掉"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像沉重的步子终于踏实落地，推着人坦然走出去",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      },
      {
       "text": "想起好时候还是会心软、也怕一个人熬，却仍能决定自己怎么站立",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      },
      {
       "text": "像正往前走时地面短暂斜了一下，随后又继续向前",
       "keys": [],
       "from": [
        "S12-B3"
       ],
       "bead": "S12-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "到这里，他还没有重新拥有旧日的归属，怀念也没有消失",
       "keys": [
        "怀念也没有消失"
       ],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像心里私密的期盼终于站到亮处，让人想起故土",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "心口像被激流冲撞着，心脏以最高负荷剧烈跳动",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "但他不再把这份留恋当成软弱，也没有为了重新得到那份熟悉而否定自己",
       "keys": [
        "不再把这份留恋当成软弱"
       ],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像被一股气流推着往前跑，兴奋得几乎来不及喘气",
       "keys": [],
       "from": [
        "S13-B2"
       ],
       "bead": "S13-B2"
      },
      {
       "text": "像自问这下真稳了吗，又像把话都说完终于能喘口气",
       "keys": [],
       "from": [
