        url_imgSearchDetail:"https://www.aiprice.com/Img/search_detail.html",
        url_getExtensionDetail:"https://www.aiprice.com/index/getExtensionDetail.html",
        text_connect_error:"Connection timed out. Please try again later.",
        domain_api:"https://api.aiprice.com",
        url_setLang:"https://www.aiprice.com/Event/setLang.html",
        url_setCurrency:"https://www.aiprice.com/Event/setCurrency.html",
        url_SearchHistory_getHistory:"https://www.aiprice.com/SearchHistory/getHistory.html",
        url_member_login:"https://www.aiprice.com/member/login.html",
        text_delete:"Delete",
        text_confirm_delete:"Are you sure to delete it?",
        button_no:"No",
        button_yes:"Yes",
        url_SearchHistory_del:"https://www.aiprice.com/SearchHistory/del.html",
        alert_select_image:"Please upload an image to search",
        error_upload_type:"File must be an image",
        error_upload_size:"Image size must not exceed 500KB",
        text_image_notice2:"Image size does not meet requirements",
        url_searchImage:"https://www.aiprice.com/Index/searchImage.html",
        sending_image_error:"Sending image failed, please try again.",
        alert_fav_page_fail:"Failed to bookmark it, please press Ctrl + D to add",
        product_search_error:"Enter product URL"
    }
</script><script type="text/javascript" src="https://cn01.aiprice.com/static/index/js/header.js?v=1858"></script><div class="main grey-bg"><!-- about start --><div class="pt30 pb30"><div class="w1200"><div class="about-box minh500"><div class="about-left"><ul class="about-nav"><li ><a href="https://www.aiprice.com/information/index/page/about">About Us</a></li><li ><a href="https://www.aiprice.com/information/index/page/contact?from=www_info">Contact Us</a></li><li class="current"><a href="https://www.aiprice.com/information/index/page/helps">Help Center</a></li><li><a href="https://www.aiprice.com/resources/install" target="_blank">Extension Install Tutorial</a></li><li><a href="https://www.aiprice.com/resources/operate/doc/video" target="_blank">Extension Usage Tutorial</a></li><li ><a href="https://www.aiprice.com/information/index/page/term_of_use">Terms of Use</a></li><li ><a href="https://www.aiprice.com/information/index/page/privacy">Privacy Policy</a></li><li ><a href="https://www.aiprice.com/information/index/page/statement">Disclaimer</a></li><li ><a href="https://www.aiprice.com/information/index/page/cooperation">Business Cooperation</a></li><li ><a href="https://www.aiprice.com/information/index/page/bulletin">Announcement</a></li></ul></div><div class="about-right"><div class="about-content-layout"><div class="help-title">Help Center</div><div class="help-item"><div class="help-item-header" data-toggle="collapse" data-target="#help-extension-services" aria-expanded="true"><h5 class="title">AiPrice Features & Services FAQ</h5></div><ul class="accordion accordion-flush help-center-accordion list-unstyled fs-14 collapse show" id="help-extension-services"><li class="accordion-item" id="s3"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-0" aria-expanded="true">1. What is AiPrice?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-0"><div class="accordion-body"><div class="help-desc">AiPrice is an intelligent product research and price analysis tool for e-commerce sellers. It helps users quickly find quality suppliers and formulate more reasonable pricing strategies through features such as image search for identical products, multi-platform price comparison, product historical price tracking, price monitoring, and data collection, thereby helping e-commerce sellers efficiently select products and increase profits.</div></div></div></li><li class="accordion-item" id="s4"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-1" aria-expanded="true">2. Which e-commerce platforms does AiPrice support?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-1"><div class="accordion-body"><div class="help-desc">AiPrice supports image search for identical products and price analysis across multiple mainstream e-commerce platforms, including major Chinese platforms as well as Amazon, SHEIN, Ozon, Naver Shopping, eBay, Wildberries, Domeggook, Coupang, Netsea, Ownerclan, Onch3, Mercari and many other international e-commerce platforms. It is a commonly used product sourcing and supplier discovery tool for e-commerce sellers.<br>By comparing data across multiple platforms, users can more accurately assess market prices and sourcing channels.</div></div></div></li><li class="accordion-item" id="s5"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-2" aria-expanded="true">3. What is the purpose of AiPrice's image search function?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-2"><div class="accordion-body"><div class="help-desc">AiPrice offers a search-by-image feature for finding identical products. Users can: click on a product image to search for identical items with one click, upload local images to source products, or use screenshots to search for similar products.<br>The system searches for identical or similar products across multiple platforms, helping sellers quickly find lower-cost suppliers. It is widely used in e-commerce product research, sourcing, and dropshipping operations.</div></div></div></li><li class="accordion-item" id="s6"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-3" aria-expanded="true">4. Can AiPrice perform cross-platform price comparisons?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-3"><div class="accordion-body"><div class="help-desc">Yes.<br>AiPrice can compare the prices of the same product across different platforms or different stores, helping users: find the lowest purchase price, understand market price ranges, evaluate profit margins, and avoid overpaying... This feature is ideal for e-commerce sellers and dropshipping sellers for cost control.</div></div></div></li><li class="accordion-item" id="s7"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-4" aria-expanded="true">5. Does AiPrice provide product historical price queries?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-4"><div class="accordion-body"><div class="help-desc">Yes.<br>AiPrice offers a product historical price feature, supporting the viewing of price trends over 3/6 months. By analyzing historical prices, users can identify genuine promotions, understand price fluctuation patterns, and avoid buying at high prices or misjudging market conditions.</div></div></div></li><li class="accordion-item" id="s8"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-5" aria-expanded="true">6. Can AiPrice monitor product price changes?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-5"><div class="accordion-body"><div class="help-desc">Yes.<br>Users can enable price tracking. When a product's price increases or decreases, the system sends an alert (supporting email notifications), helping users seize the best purchasing or selling opportunities.</div></div></div></li><li class="accordion-item" id="s9"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-6" aria-expanded="true">7. Can AiPrice be used for e-commerce product research?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-6"><div class="accordion-body"><div class="help-desc">Yes.<br>AiPrice is a commonly used e-commerce product research tool that helps sellers: find multiple suppliers for identical products, analyze market price competition, discover price differences between platforms, and uncover potential high-profit products.<br>Suitable for sellers on platforms such as Amazon, SHEIN, Ozon, Naver Shopping, eBay, Wildberries, Domeggook, Coupang, Netsea, Ownerclan, Onch3, Mercari and more.</div></div></div></li><li class="accordion-item" id="s10"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-7" aria-expanded="true">8. Does AiPrice support product data scraping and export?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-7"><div class="accordion-body"><div class="help-desc">Yes.<br>AiPrice can batch scrape and export product information, including: product titles, images, prices, product links, sales data (on some platforms)…<br>Helping sellers improve listing efficiency and data organization efficiency.</div></div></div></li><li class="accordion-item" id="s11"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-8" aria-expanded="true">9. Which browsers does AiPrice support?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-8"><div class="accordion-body"><div class="help-desc">The AiPrice extension supports mainstream browsers, including: Chrome, Edge, Opera, Yandex, 360 Browser, QQ Browser, and other browsers based on the Chromium engine.<br>Installation tutorial: <a href="https://www.aiprice.com/resources/install" target="_blank">https://www.aiprice.com/resources/install</a></div></div></div></li><li class="accordion-item" id="s12"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-9" aria-expanded="true">10. Who is AiPrice suitable for?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-9"><div class="accordion-body"><div class="help-desc">AiPrice is suitable for: e-commerce sellers, dropshipping sellers, procurement and sourcing agents, e-commerce product researchers, and consumers who want to check price history…</div></div></div></li><li class="accordion-item" id="s13"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-10" aria-expanded="true">11. Is AiPrice free?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-10"><div class="accordion-body"><div class="help-desc">Yes. All features of the AiPrice extension are free to use.</div></div></div></li><li class="accordion-item" id="s14"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-11" aria-expanded="true">12. How does AiPrice help sellers increase profits?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-11"><div class="accordion-body"><div class="help-desc">AiPrice helps users discover price differences and supply gaps between platforms through multi-platform price analysis, thereby: reducing procurement costs, formulating more competitive selling prices, avoiding fake discounts and price misjudgments… to increase overall profit margins.</div></div></div></li></ul></div><div class="help-item"><div class="help-item-header" data-toggle="collapse" data-target="#help-extension-accordion" aria-expanded="true"><h5 class="title">Extension Usage Issues</h5></div><ul class="accordion accordion-flush help-center-accordion list-unstyled fs-14 collapse show" id="help-extension-accordion"><li class="accordion-item" id="p1"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-0" aria-expanded="true">1688 image search doesn't work</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-0"><div class="accordion-body"><div class="help-desc">It may be caused by the 1688 official request for verification. Please click the camera icon on the homepage of the 1688 website to upload a picture to search, and then use the extension to search. <br>To learn more about how to improve the success rate of image search, please refer to the blog <a href="https://www.aiprice.com/taobao_tutorials/638_425/How-to-improve-the-success-rate-of-image-search%3F-%281688%29">https://www.aiprice.com/taobao_tutorials/638_425/How-to-improve-the-success-rate-of-image-search%3F-%281688%29</a></div></div></div></li><li class="accordion-item" id="p2"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-1" aria-expanded="true">Taobao image search doesn't work</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-1"><div class="accordion-body"><div class="help-desc">It may be caused by Taobao’s official request for verification. Please click the camera icon on the homepage of Taobao website to upload a picture to search, and then use the extension to search. <br>To learn more about how to improve the success rate of image search, please refer to the blog <a href="https://www.aiprice.com/taobao_tutorials/637_425/How-to-improve-the-success-rate-of-image-search%3F%EF%BC%88Taobao%EF%BC%89">https://www.aiprice.com/taobao_tutorials/637_425/How-to-improve-the-success-rate-of-image-search%3F%EF%BC%88Taobao%EF%BC%89</a></div></div></div></li><li class="accordion-item" id="p3"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-2" aria-expanded="true">Yiwugo image search doesn't work</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-2"><div class="accordion-body"><div class="help-desc">It may be caused by the revision of Yiwugo's official page, we will update it as soon as possible.</div></div></div></li><li class="accordion-item" id="p4"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-3" aria-expanded="true">AliExpress image search doesn't work</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-3"><div class="accordion-body"><div class="help-desc">Please leave the product link, we will test and contact you.</div></div></div></li><li class="accordion-item" id="p5"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-4" aria-expanded="true">How to install the plugin</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-4"><div class="accordion-body"><div class="help-desc">Please choose method 2, download the installation package corresponding to the browser, and install it. There are video tutorials. <a href="https://www.aiprice.com/information/alibabaCnInformation.html">https://www.aiprice.com/information/alibabaCnInformation.html</a></div></div></div></li><li class="accordion-item" id="p6"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-5" aria-expanded="true">Image search results are not displayed</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-5"><div class="accordion-body"><div class="help-desc">Adblock and other plug-ins will affect, need to close such extensions.</div></div></div></li><li class="accordion-item" id="p7"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-6" aria-expanded="true">Price history no data</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-6"><div class="accordion-body"><div class="help-desc">Please leave the product link, we will test and contact you.</div></div></div></li><li class="accordion-item" id="p8"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-7" aria-expanded="true">The results of Alibaba's image search can't jump to the corresponding product page, but to the home page</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-7"><div class="accordion-body"><div class="help-desc">It may be caused by turning on the VPN, turn it off and try again.</div></div></div></li><li class="accordion-item" id="p9"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-8" aria-expanded="true">Why hasn't the price history been updated for a long time?</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-8"><div class="accordion-body"><div class="help-desc">Price history may remain unchanged for an extended period of time due to the following reasons:<br>1.The seller has not changed the price for a long time.<br>2.Server issues occurred during the data collection period for the specific product.<br>3.Price fluctuations are influenced by currency exchange rate fluctuations.</div></div></div></li><li class="accordion-item" id="p10"><div class="accordion-header"><!--展开状态，accordion-button去掉class名：collapsed, 并且aria-expanded="true"--><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-9" aria-expanded="true">Reasons for 1688/Taobao Account Abnormalities or Bans</h5></div><!--展开状态，添加class名：show--><div class="accordion-collapse collapse" id="collapse-extension-9"><div class="accordion-body"><div class="help-desc">If you encounter a pop-up message on 1688/Taobao stating: "您的账户近期访问行为存在异常，涉嫌不当获取使用平台商业信息，包括但不限于爬虫工具、违规浏览器插件、租借账号、共享、出售数据等，可能存在安全风险。系统将限制该账号的部分访问功能……"<br><br>Such issues are not caused by the extension, but rather by system security abnormalities detected when accessing Taobao or 1688 pages. These may be triggered by factors including but not limited to VPNs, other extensions, scripts, or packet capture tools.<br><br>Account abnormalities generally occur when an account logged into 1688 or Taobao accesses relevant pages under an environment flagged as abnormal by the system. These issues are typically not directly related to the use of this extension.<br><br>If the issue persists, please contact the official 1688/Taobao customer support for assistance.</div></div></div></li></ul></div><div class="help-item"><div class="help-item-header" data-toggle="collapse" data-target="#help-ImageTranslate-accordion" aria-expanded="true"><h5 class="title">Image Translation Issues</h5></div><ul class="accordion accordion-flush help-center-accordion list-unstyled fs-14 collapse show" id="help-ImageTranslate-accordion"><li class="accordion-item" id="t1"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-ImageTranslate-0" aria-expanded="false">I recharged the money, how can the number of translations still be zero</h5></div><div class="accordion-collapse collapse" id="collapse-ImageTranslate-0"><div class="accordion-body"><div class="help-desc">The money is charged into the wallet, and the balance needs to be used to purchase the package.</div></div></div></li><li class="accordion-item" id="t2"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-ImageTranslate-1" aria-expanded="false">The picture can't be translated</h5></div><div class="accordion-collapse collapse" id="collapse-ImageTranslate-1"><div class="accordion-body"><div class="help-desc">Please send pictures, we will test and contact you.</div></div></div></li><li class="accordion-item" id="t3"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-ImageTranslate-2" aria-expanded="false">Translate a picture, but deduct a lot of pictures</h5></div><div class="accordion-collapse collapse" id="collapse-ImageTranslate-2"><div class="accordion-body"><div class="help-desc">It may be caused by too many clicks, please contact WeChat customer service.</div></div></div></li><li class="accordion-item" id="t4"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-ImageTranslate-3" aria-expanded="false">Withdraw balance</h5></div><div class="accordion-collapse collapse" id="collapse-ImageTranslate-3"><div class="accordion-body"><div class="help-desc">Please contact WeChat customer service.</div></div></div></li></ul></div><div class="help-item"><div class="help-item-header" data-toggle="collapse" data-target="#help-account-accordion" aria-expanded="true"><h5 class="title">Account Issues</h5></div><ul class="accordion accordion-flush help-center-accordion list-unstyled fs-14 collapse show" id="help-account-accordion"><li class="accordion-item" id="ac1"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-account-0" aria-expanded="false">Can't log in to Facebook</h5></div><div class="accordion-collapse collapse" id="collapse-account-0"><div class="accordion-body"><div class="help-desc">Thanks for the feedback, we will test it and contact you</div></div></div></li><li class="accordion-item" id="ac2"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-account-1" aria-expanded="false">Can't log in to Twitter</h5></div><div class="accordion-collapse collapse" id="collapse-account-1"><div class="accordion-body"><div class="help-desc">Thanks for the feedback, we will test it and contact you</div></div></div></li><li class="accordion-item" id="ac3"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-account-2" aria-expanded="false">Can't log in to VK</h5></div><div class="accordion-collapse collapse" id="collapse-account-2"><div class="accordion-body"><div class="help-desc">Thanks for the feedback, we will test it and contact you</div></div></div></li><li class="accordion-item" id="ac4"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-account-3" aria-expanded="false">How to change the password</h5></div><div class="accordion-collapse collapse" id="collapse-account-3"><div class="accordion-body"><div class="help-desc">On the login page, click Forgot Password to change the password</div></div></div></li></ul></div><div class="help-item"><div class="help-item-header" data-toggle="collapse" data-target="#help-extension-move" aria-expanded="true"><h5 class="title">AliPrice → AiPrice Brand Upgrade FAQ</h5></div><ul class="accordion accordion-flush help-center-accordion list-unstyled fs-14 collapse show" id="help-extension-move"><li class="accordion-item" id="m1"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-0" aria-expanded="true">1. What changed about AiPrice?</h5></div><div class="accordion-collapse collapse" id="collapse-extension-0"><div class="accordion-body"><div class="help-desc">AiPrice (formerly AliPrice) has completed a brand upgrade.<br>This upgrade involves only the brand name and visual identity update. Product features and services remain unchanged.</div></div></div></li><li class="accordion-item" id="m2"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-1" aria-expanded="true">2. Why upgrade to AiPrice?</h5></div><div class="accordion-collapse collapse" id="collapse-extension-1"><div class="accordion-body"><div class="help-desc">As our product continues to evolve, we have grown from a single-platform tool into a global e-commerce service covering multiple platforms and languages.<br>The upgrade to AiPrice reflects our long-term development direction in price intelligence and AI capabilities, and further enhances our global brand recognition.</div></div></div></li><li class="accordion-item" id="m3"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-2" aria-expanded="true">3. Do I need to re-register my account?</h5></div><div class="accordion-collapse collapse" id="collapse-extension-2"><div class="accordion-body"><div class="help-desc">No.<br>Your existing account can be used directly with AiPrice without the need for re-registration.</div></div></div></li><li class="accordion-item" id="m4"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-3" aria-expanded="true">4. Will I lose my data?</h5></div><div class="accordion-collapse collapse" id="collapse-extension-3"><div class="accordion-body"><div class="help-desc">No.<br>All your data, including: favorites, search history, subscription information, usage history… will be fully preserved and unaffected.</div></div></div></li><li class="accordion-item" id="m5"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-4" aria-expanded="true">5. Does the extension need to be reinstalled?</h5></div><div class="accordion-collapse collapse" id="collapse-extension-4"><div class="accordion-body"><div class="help-desc">It is recommended to upgrade to the latest version.<br>If you downloaded the extension from an official browser store online, it will automatically update to the latest version. Please check your version number.<br>If not updated, we recommend manually updating to the latest version for the best experience.<br>Installation tutorial: <a href="https://www.aiprice.com/resources/install" target="_blank">https://www.aiprice.com/resources/install</a></div></div></div></li><li class="accordion-item" id="m6"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-5" aria-expanded="true">6. Will there be changes to features or pricing?</h5></div><div class="accordion-collapse collapse" id="collapse-extension-5"><div class="accordion-body"><div class="help-desc">Current features remain unchanged, including: image search for identical products, cross-platform price comparison, product historical price viewing, price tracking alerts, product data scraping and export, etc. Paid plans for image processing are also unaffected.<br>If there are any new features or adjustments in the future, we will notify users in advance.</div></div></div></li><li class="accordion-item" id="m7"><div class="accordion-header"><h5 class="accordion-button collapsed" data-toggle="collapse" data-target="#collapse-extension-6" aria-expanded="true">7. What's new after the upgrade to AiPrice?</h5></div><div class="accordion-collapse collapse" id="collapse-extension-6"><div class="accordion-body"><div class="help-desc">Following the brand upgrade, we will continue to introduce more capabilities, including: AI-driven product research analysis, smart pricing and profit assistance, more comprehensive cross-platform data support, and continuously optimized user experience.<br>Thank you for the trust and support from our global users.AiPrice will continue to provide efficient and reliable pricing and product research tools for e-commerce sellers.</div></div></div></li></ul></div></div></div></div></div></div><!-- about end --></div><!-- main end --><script>	// 获取当前页面的 URL
	var url = window.location.href;

	// 获取 URL 中的查询字符串部分
	var queryString = url.split('?')[1];

	// 将查询字符串解析为参数对象
	var params = {};
	if (queryString) {
		queryString.split('&').forEach(function(param) {
			var parts = param.split('=');
			var key = parts[0];
			var value = decodeURIComponent(parts[1]);
			params[key] = value;
		});
	}
	var href = params['href'];

	$('#' + href).find('.accordion-collapse').addClass('show');

	if (href) {
		// 获取目标锚点元素的位置
		var targetOffset = $('#' + href).offset().top;

		//符号修改为收缩符号，默认打开
		$('#' + href).find('.accordion-button').removeClass('collapsed');

		// 计算滚动距离，使目标锚点位于页面中间
		var windowHeight = $(window).height();
		var scrollTo = targetOffset - (windowHeight / 2);

		// 执行滚动动画
		$('html, body').animate({
			scrollTop: scrollTo
		}, 1000);
	}
</script><div class="footer"><div class="footer-container d-flex justify-content-between"><div class="ft-left"><div class="ft-logo-new"><img class="ft-logo-img mb-3" src="https://cn01.aiprice.com/static/index/img/footer-logo.png" height="30" alt="AliPrice logo"></div><ul class="ft-list-group"><li class="ft-list-item"><p>Copyright © AiPrice.com – All Rights Reserved</p></li><!-- <li class="ft-list-item"><a class="ft-list-link" href="https://www.aiprice.com/information/index/page/help" target="_blank">How to use?</a></li> --><li class="ft-list-item"><p>Service: Working day 09:00-18:30</p></li><li class="ft-list-item"><p>Beijing CST &nbsp; <span id="beijing_time_footer">2026-10-07 07:12:35</span></p></li><li class="ft-list-item"><p>AiPrice is an independent third-party tool and is not affiliated with the Alibaba Group.</p></li></ul></div><div class="ft-info"><h3 class="ft-title">Information</h3><ul class="ft-list-group"><li class="ft-list-item"><a class="ft-list-link" href="https://www.aiprice.com/information/index/page/about" target="_blank">About Us</a></li><li class="ft-list-item"><a class="ft-list-link" href="https://www.aiprice.com/information/index/page/contact?from=www_footer" target="_blank">Contact Us</a></li><li class="ft-list-item"><a class="ft-list-link" href="https://www.aiprice.com/information/index/page/term_of_use" target="_blank">Terms of Use</a></li><li class="ft-list-item"><a class="ft-list-link" href="https://www.aiprice.com/information/index/page/privacy" target="_blank">Privacy Policy</a></li><li class="ft-list-item"><a class="ft-list-link" href="https://www.aiprice.com/information/index/page/helps" target="_blank">Help</a></li><li class="ft-list-item"><a class="ft-list-link" href="https://www.aiprice.com/resources/operate/doc/video" target="_blank">Usage Tutorial</a></li><li class="ft-list-item"><a class="ft-list-link" href="https://www.aiprice.com/information/index/page/statement" target="_blank">Disclaimer</a></li><li class="ft-list-item"><a cl