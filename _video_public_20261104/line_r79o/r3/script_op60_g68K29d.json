       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话到嘴边，因怕关系改变而沉默",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这一点亲近已很甜，还不知下次能否坦白",
       "keys": [
        "还不知下次能否坦白"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因为他露出在意就退开，他才渐渐放松下来",
       "keys": [
        "渐渐放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "像两个人挨得很近，连沉默也让他觉得自在",
       "keys": [
        "连沉默也让他觉得自在"
       ],
       "from": [
        "S02-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩膀挨着肩膀，连呼吸和体温都贴在一起",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "相识已久的人安静坐着，沉默也不紧张",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "夏末潮湿温热的风裹在皮肤上",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠得更近，喜欢得几乎藏不住",
       "keys": [
        "喜欢得几乎藏不住"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕太急弄坏眼下的自在，他最后还是收住了",
       "keys": [
        "最后还是收住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待在一起这么好，他还没分开就先舍不得",
       "keys": [
        "还没分开就先舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "左手像心跳和水浪，船底托着身体放下重力",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "水一直在流，时间也一直往前走",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "柔软落音甜蜜又惆怅，太喜欢便想让此刻慢些",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不去琢磨以后，只想舒服地待在亲近里",
