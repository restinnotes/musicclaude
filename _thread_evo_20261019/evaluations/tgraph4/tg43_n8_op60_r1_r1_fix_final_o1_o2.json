   "relation": "正在面对",
   "items": [
    {
     "id": "R57",
     "text": "幸福还鲜明着，他就察觉心里仍有一处没有着落。",
     "from": [
      "N67",
      "N68"
     ],
     "key": "满足中的空缺",
     "kind": "",
     "follows": false
    },
    {
     "id": "R58",
     "text": "他能尽情拥有自己的深情，却不能凭这份深情换来对方同样的选择。",
     "from": [
      "N68",
      "N69"
     ],
     "key": "深情不能替人选择",
     "kind": "",
     "follows": true
    },
    {
     "id": "R59",
     "text": "欢喜越真实，酸楚越难忽略；他已知道自己爱得多深，再也不能说对方怎样回应都无所谓。",
     "from": [
      "N69",
      "N70",
      "N71"
     ],
     "key": "满足照出回应的重要",
     "kind": "满足照出未满足",
     "follows": true
    },
    {
     "id": "R60",
     "text": "他不想让对方负责消除自己全部的不安，也不愿因害怕落空，故意削弱曾给他巨大幸福的感情。",
     "from": [
      "N71",
      "N72",
      "N73"
     ],
     "key": "不转嫁不安，也不削弱感情",
     "kind": "",
     "follows": true
    },
    {
     "id": "R61",
     "text": "克制曾让他安心，却没让渴望消失；尽情投入曾让他幸福，也不能保证他不失望。",
     "from": [
      "N74"
     ],
     "key": "两种办法各有局限",
     "kind": "办法的限度",
     "follows": true
    },
    {
     "id": "R62",
     "text": "想靠近的迫切还在，不勉强对方的坚持也在，谁都没有退让。",
     "from": [
      "N74",
      "N75"
     ],
     "key": "两股心思并存",
     "kind": "",
     "follows": true
    },
    {
     "id": "R63",
     "text": "越看清两边的冲突，他越难受，因为如今已经舍不得否认任何一边。",
     "from": [
      "N75",
      "N76"
     ],
     "key": "看得越清，冲突越尖锐",
     "kind": "知道更多反而更尖锐",
     "follows": true
    },
    {
     "id": "R64",
     "text": "他不愿为求轻松就草草丢掉其中一边，宁可不舒服，也不拿自欺换平静。",
     "from": [
      "N76",
      "N77"
     ],
     "key": "不靠自欺换平静",
     "kind": "",
     "follows": true
    }
   ],
   "because": [
    {
     "from": "R56",
     "to": "R57",
     "rel": "动摇",
     "audit": "支持",
     "old": [
      "N67",
