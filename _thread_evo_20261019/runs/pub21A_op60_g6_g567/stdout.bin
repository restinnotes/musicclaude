{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"先向高处迸发，细碎的光点再缓缓飘落。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"细碎的光点\"\n        },\n        {\n          \"quote\": \"还不是整个人已经安稳地交给规律起伏的水浪。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"没了\",\n          \"matter\": \"小\",\n          \"fix\": \"还没进入规律摇荡\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"越清楚，越谨慎\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他突然发现\",\n          \"point\": \"很想靠近对方\",\n          \"where\": \"后\",\n          \"waste\": \"自己\",\n          \"keep\": \"突然发现\"\n        },\n        {\n          \"text\": \"他怕喜欢太明显\",\n          \"point\": \"只敢露出一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕喜欢太明显\"\n        },\n        {\n          \"text\": \"一点亲近就很甜\",\n          \"point\": \"还不敢更坦白\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一点亲近就很甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"对方偶尔望来一眼，沉默也不让人紧张。\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"偶尔望来一眼\"\n        },\n        {\n          \"quote\": \"可以放弃对重力的控制，把身体交给船底温柔的托举。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"把身体交给托举\"\n        },\n        {\n          \"quote\": \"声音短暂落稳，又漂起来一点，没有把心事彻底说死。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"落稳后又漂起一点\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没退开\",\n          \"point\": \"终于慢慢放松了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方没退开\"\n        },\n        {\n          \"text\": \"还没分开\",\n          \"point\": \"已经舍不得了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还没分开\"\n        },\n        {\n          \"text\": \"他想靠得更近\",\n          \"point\": \"怕太急而收住\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又怕太急\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"沉默并不尴尬，反而很舒服\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"反而很舒服\"\n        },\n        {\n          \"quote\": \"它只在水面上露了一下头，没有变成一场真正的倾诉。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"音乐并未走向悲剧，却在那份顺畅之中生出了阻力。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"只是生出阻力，不是悲剧\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他只想待在\",\n          \"point\": \"待在这份亲近里\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"不去想以后\"\n        },\n        {\n          \"text\": \"他想问对方\",\n          \"point\": \"问对方是不是一样\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"又没说出口\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"讲着讲着语速变了\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"没了\",\n          \"matter\": \"小\",\n          \"fix\": \"越讲越快\"\n        },\n        {\n          \"quote\": \"一边奋力向高处攀升，一边又渐渐收弱，并没有稳稳落下。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"越往上，声音却越收弱\"\n        },