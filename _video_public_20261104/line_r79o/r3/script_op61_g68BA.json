       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "切分里拿不定方向",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "想往前却无法平静",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "端正步态散开",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "前半焦躁急切",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "后半忽然柔和",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "故乡夏日麦浪",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
