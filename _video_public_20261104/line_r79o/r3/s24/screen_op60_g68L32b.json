     "bars": "102-103",
     "from": [
      "S12-B3"
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "rows": [
    {
     "kind": "line",
     "text": "他对眼前这份幸福仍然很肯定，悲伤却一点点渗进来，让满足变得沉甸甸的",
