      "from": "S07-1",
      "to": "S07-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "62–71",
    "relation": "正在面对",
    "items": [
     {
      "id": "S08-1",
      "text": "因为对方也会向他寻求依靠，他开始相信两个人能够长久保持这样的亲近，把彼此需要当作这段关系会持续的凭据。",
      "key": "因为对方也会向他",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S07-2"
      ]
     },
     {
      "id": "S08-2",
      "text": "这份把握让他更敢于坦率地投入，心情明朗而轻快，享受两个人自然靠近的自在。",
      "key": "这份把握让他更敢",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S07-1",
      "to": "S08-1",
      "rel": "引用"
     },
     {
      "from": "S07-2",
      "to": "S08-1",
      "rel": "引用"
     },
     {
      "from": "S08-1",
      "to": "S08-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "72–77",
    "relation": "没在想",
    "items": [
     {
      "id": "S09-1",
      "text": "他沉浸在彼此都愿意依靠对方的满足里，明朗的喜悦慢慢沉入安静而幽微的温暖；此刻他更在意自己能带给对方什么。",
      "key": "他沉浸在彼此都愿",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1",
       "S08-2"
      ]
     },
     {
      "id": "S09-2",
      "text": "他没有放下对长久的期待，只是暂时不去衡量这份把握是否可靠，让眼下彼此带来的幸福占据心思。",
      "key": "他没有放下对长久",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-1",
       "S08-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S08-1",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S08-2",
      "to": "S09-1",
