{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"细碎的光点再缓缓飘落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"缓缓\"\n        },\n        {\n          \"quote\": \"还没有真正落稳，仿佛仍悬在水面上方\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现自己那么想靠近这个人\",\n          \"point\": \"那么想靠近这个人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"连自己也有点意外\"\n        },\n        {\n          \"text\": \"他怕对方一看出自己有多需要这份亲近\",\n          \"point\": \"只敢露出一点点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"就会觉得负担太重，所以\"\n        },\n        {\n          \"text\": \"只是这么一点亲近就让他觉得甜\",\n          \"point\": \"能不能更坦白些\",\n          \"where\": \"后\",\n          \"waste\": \"自己\",\n          \"keep\": \"还拿不准\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"夏末水面潮湿、温热的微风，裹在皮肤上有些黏稠\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"潮湿、黏稠\"\n        },\n        {\n          \"quote\": \"可以放弃对重力的控制，把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"放弃重力\"\n        },\n        {\n          \"quote\": \"它没有继续冲向高潮，而像轻轻呼出一口气\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有因为他露出在意就退开\",\n          \"point\": \"仍愿意跟他亲近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"他才渐渐放松下来\"\n        },\n        {\n          \"text\": \"他也想顺势靠得更近\",\n          \"point\": \"怕太急弄坏眼下的自在而收住了\",\n          \"where\": \"后\",\n          \"waste\": \"有一阵子\",\n          \"keep\": \"最后还是怕太急弄坏眼下的自在\"\n        },\n        {\n          \"text\": \"两个人待在一起这么好\",\n          \"point\": \"还没分开就先有一点舍不得\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这样的时刻总会过去\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"身体还在这里，心却已经慢慢漂远\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只在水面上露了一下头，没有变成一场真正的倾诉\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"音乐并未走向悲剧，却在那份顺畅之中生出了阻力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"并非悲剧\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他难得不去琢磨两个人往后会怎样\",\n          \"point\": \"舒舒服服地待在这份亲近里\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"难得不去琢磨两个人往后会怎样\"\n        },\n        {\n          \"text\": \"中间他忽然想告诉对方自己多喜欢这样待着\",\n          \"point\": \"念头就淡了\",\n          \"where\": \"后\",\n          \"waste\": \"中间\",\n          \"keep\": \"可还没想好怎么开口，念头就淡了\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"刚开始还能微笑着讲，讲着讲着语速变了\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"右手在高处悬停，左手的水波却仍推着你往前走\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"声线悬停\"\n        },\n        {\n          \"quote\": \"你越用力，水面的颠簸就越剧烈，船舱内的平衡就越脆弱\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"船舱失衡\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"熟悉的亲近又让他满心欢喜\",\n          \"point\": \"想起上回明明想告诉对方却没有开口\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"上回明明想告诉对方却没有开口\"\n        },\n        {\n          \"text\": \"他几乎想把藏着的话全说出来\",\n          \"point\": \"把藏着的话全说出来\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"盼着对方也喜欢他不再小心收着的样子\"\n        },\n        {\n          \"text\": \"他甚至盼着说出来能把眼下的好留得久一点\",\n          \"point\": \"最后还是留了些话没说\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可又怕一下说得太多让对方为难，连两个人原有的自在也弄丢\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"丰满的声音只剩下一条单薄、孤零零的旋律，在空中漫无目的地游走\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"只剩孤零旋律\"\n        },\n        {\n          \"quote\": \"一个人从「我与你」的亲密中抽身，转而跌回自己的内心\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"从我与你抽身\"\n        },\n        {\n          \"quote\": \"音乐却仿佛自己松开了手，深吸一口气\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"前几次想说又收住\",\n          \"point\": \"对方已经看出他有多在乎\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方却一直愿意跟他亲近\"\n        },\n        {\n          \"text\": \"先前藏着时还能装作没那么在乎\",\n          \"point\": \"连怎么跟对方待着都拿不准\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"先前藏着时还能装作没那么在乎