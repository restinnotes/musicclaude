{
 "uniform": true,
 "sections": [
  {
   "sec": "S01",
   "rows": [
    {
     "kind": "line",
     "text": "他已经离开熟悉的生活",
     "keys": [
      "离开"
     ],
     "emotion": "悬着",
     "from": [
      "S01-1"
     ]
    },
    {
     "kind": "line",
     "text": "起初觉得总算不用再委屈自己",
     "keys": [
      "不用再委屈"
     ],
     "emotion": "安心",
     "from": [
      "S01-1"
     ],
     "at": 4.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "尊严还撑着，方向和力气不稳，其实很想停下来",
       "bead": "S01-B2",
       "from": [
        "S01-B2"
       ],
       "bars": "1-23",
       "at": 20.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "可这份笃定没撑多久，心里空了",
     "keys": [
      "没撑多久"
     ],
     "emotion": "悬着",
     "from": [
      "S01-2"
     ],
     "at": 8.0
    },
    {
     "kind": "line",
     "text": "一时说不清到底舍不得什么",
     "keys": [
      "说不清"
     ],
     "emotion": "孤单",
     "from": [
      "S01-2"
     ],
     "at": 12.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "怒气、遗憾、怀念还分不清",
       "bead": "S01-B3",
       "from": [
        "S01-B3"
       ],
       "bars": "1-23",
       "at": 24.0
      },
      {
       "text": "像刚从漫长昏沉里醒来，四周冷空",
       "bead": "S01-B4",
       "from": [
        "S01-B4"
       ],
       "bars": "1-23",
       "at": 28.0
      },
      {
       "text": "胸口发紧、眼前模糊，恍惚不知身在何处",
       "bead": "S01-B4",
       "from": [
        "S01-B4"
       ],
       "bars": "1-23",
       "at": 32.0
      },
      {
       "text": "颤抖着伸手，只摸到虚空，还没哭出来",
       "bead": "S01-B4",
       "from": [
        "S01-B4"
       ],
       "bars": "1-23",
       "at": 36.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "偶尔想起旧日，仍想往前过，却不知靠什么安下心",
     "keys": [
      "不知靠什么"
     ],
     "emotion": "悬着",
     "from": [
      "S01-3"
     ],
     "at": 16.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "旧日声音、光线和熟悉感回来，却不能变回现在",
       "bead": "S01-B5",
       "from": [
        "S01-B5"
       ],
       "bars": "9-17",
       "at": 40.0
      },
      {
       "text": "身体先于意识，隐约记起怎样迈步",
       "bead": "S01-B5",
       "from": [
        "S01-B5"
       ],
       "bars": "18-23",
       "at": 44.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "开头沉重一响，随后自由的声音向上散开",
     "bars": "1-6",
     "from": [
      "S01-B1"
     ]
    },
    {
     "text": "声音渐轻渐远，停顿像在等回声",
     "bars": "1-6",
     "from": [
      "S01-B1"
     ]
    },
    {
     "text": "短句刚冒出就停住，余音在冷空气里散尽",
     "bars": "1-23",
     "from": [
      "S01-B3"
     ]
    },
    {
     "text": "曲调轮廓短暂清楚，像一幕忽然显影",
     "bars": "9-17",
     "from": [
      "S01-B5"
     ]
    },
    {
     "text": "舞步感渐渐浮现，完整曲调还未站稳",
     "bars": "18-23",
     "from": [
      "S01-B5"
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "rows": [
    {
     "kind": "line",
     "text": "他舍不得从前那些自在日子",
     "keys": [
      "舍不得"
     ],
     "emotion": "亲密",
     "from": [
      "S02-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像远处旧歌，记得却哼不清，舞步下藏私语",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24-65",
       "at": 15.0
      },
      {
       "text": "珍惜的东西仿佛还在，却不能照旧拥有",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24-65",
       "at": 18.0
      },
      {
       "text": "不像士兵，更像腿脚发虚地挪着舞步",
       "bead": "S02-B2",
       "from": [
        "S02-B2"
       ],
       "bars": "24-65",
       "at": 21.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "想到以后不能再那样过，心里发慌",
     "keys": [
      "心里发慌"
     ],
     "emotion": "不安",
     "from": [
      "S02-1"
     ],
     "at": 3.0
    },
    {
     "kind": "line",
     "text": "一想念，就提醒自己受过的气",
     "keys": [
      "受过的气"
     ],
     "emotion": "炽热",
     "from": [
      "S02-2"
     ],
     "at": 6.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像整理衣服抬头，努力藏住心里的动摇",
       "bead": "S02-B4",
       "from": [
        "S02-B4"
       ],
       "bars": "24-65",
       "at": 24.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "怕一心软忘了当初为何离开",
     "keys": [
      "为何离开"
     ],
     "emotion": "不安",
     "from": [
      "S02-2"
     ],
     "at": 9.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "起初还信我没事，后来反复说服自己，第三遍露出在意",
       "bead": "S02-B4",
       "from": [
        "S02-B4"
       ],
       "bars": "44-65",
       "at": 27.0
      },
      {
       "text": "悲伤仍在，却不肯把自己全交给悲伤",
       "bead": "S02-B4",
       "from": [
        "S02-B4"
       ],
       "bars": "24-65",
       "at": 30.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "可他不甘心，好日子也得一起丢掉吗？",
     "keys": [
      "不甘心"
     ],
     "emotion": "悬着",
     "from": [
      "S02-3"
     ],
     "at": 12.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "激昂像喊不甘心就此消亡，负隅顽抗与镇定并存",
       "bead": "S02-B5",
       "from": [
        "S02-B5"
       ],
       "bars": "44-65",
       "at": 33.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "庄严的步伐终于清楚，却不像凯旋",
     "bars": "24-65",
     "from": [
      "S02-B1"
     ]
    },
    {
     "text": "步伐傲慢挺拔，歌声脆弱凄婉，底下细声不安",
     "bars": "24-65",
     "from": [
      "S02-B2"
     ]
    },
    {
     "text": "声音猛然上推又退回，随后再次聚力",
     "bars": "38-65",
     "from": [
      "S02-B3"
     ]
    },
    {
     "text": "细密连续的音流催得呼吸越来越急",
     "bars": "56-65",
     "from": [
      "S02-B3"
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "rows": [
    {
     "kind": "line",
     "text": "他心里还憋着一股气",
     "keys": [
      "憋着一股气"
     ],
     "emotion": "炽热",
     "from": [
      "S03-1"
     ]
    },
    {
     "kind": "line",
     "text": "想起曾被当作自己人",
     "keys": [
      "自己人"
     ],
     "emotion": "亲密",
     "from": [
      "S03-1"
     ],
     "at": 2.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像故乡夏日麦浪和微风",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "80-91",
       "at": 10.0
      },
      {
       "text": "像曾经亲近、无需时时防备",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "80-91",
       "at": 12.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "竟又短暂高兴",
     "keys": [
      "短暂高兴"
     ],
     "emotion": "欢喜",
     "from": [
      "S03-1"
     ],
     "at": 4.0
    },
    {
     "kind": "line",
     "text": "可高兴未退，心里先酸了",
     "keys": [
      "心里先酸了"
     ],
     "emotion": "悬着",
     "from": [
      "S03-2"
     ],
     "at": 6.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "温柔得心颤，也因离眼前太远而绝望",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "80-91",
       "at": 14.0
      },
      {
       "text": "像聊别的、出去走走，暂时绕开伤口",
       "bead": "S03-B3",
       "from": [
        "S03-B3"
       ],
       "bars": "66-91",
       "at": 16.0
      },
      {
       "text": "轻松是真的，却没替心事找到答案",
       "bead": "S03-B3",
       "from": [
        "S03-B3"
       ],
       "bars": "66-91",
       "at": 18.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "从前日子回不去，离开后就一定更好吗？",
     "keys": [
      "一定更好吗"
     ],
     "emotion": "不安",
     "from": [
      "S03-2"
     ],
     "at": 8.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "昂扬退潮后，自问真信了还是努力相信",
       "bead": "S03-B5",
       "from": [
        "S03-B5"
       ],
       "bars": "66-91",
       "at": 20.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "开头一记重响，带出忽强忽弱的摇摆",
     "bars": "66-91",
     "from": [
      "S03-B1"
     ]
    },
    {
     "text": "灵活起伏取代端正步态，方向仍不安",
     "bars": "66-91",
     "from": [
      "S03-B1"
     ]
    },
    {
     "text": "前半焦急，后半忽然柔和轻盈",
     "bars": "66-91",
     "from": [
      "S03-B2"
     ]
    },
    {
     "text": "多层细声像低语缠绕，重心四处漂移",
     "bars": "66-91",
     "from": [
      "S03-B4"
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "rows": [
    {
     "kind": "line",
     "text": "想起从前亲近的日子",
     "keys": [
      "亲近的日子"
     ],
     "emotion": "亲密",
     "from": [
      "S04-1"
     ]
    },
    {
     "kind": "line",
     "text": "一度盼着还能那样相处",
     "keys": [
      "还能那样相处"
     ],
     "emotion": "欢喜",
     "from": [
      "S04-1"
     ],
     "at": 2.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "旧记忆带来感激、亲密、柔情和短暂幸福",
       "bead": "S04-B1",
       "from": [
        "S04-B1"
       ],
       "bars": "92-107",
       "at": 8.0
      },
      {
       "text": "外在仍向前，心里回声更多，坚定也许只是想成为的样子",
       "bead": "S04-B1",
       "from": [
        "S04-B1"
       ],
       "bars": "92-107",
       "at": 10.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "亲近越鲜活，委屈也跟着翻上来",
     "keys": [
      "委屈也跟着翻上来"
     ],
     "emotion": "悬着",
     "from": [
      "S04-2"
     ],
     "at": 4.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "记忆太好却回不来，撕扯着后退，抵抗疲惫仓促",
