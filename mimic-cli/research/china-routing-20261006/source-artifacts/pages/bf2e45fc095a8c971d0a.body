<script>
  (function () {
    let offset = 0;

    async function fetchServerTime() {
      try {
        const startTime = Date.now();
        const response = await fetch(window.location.href, { method: 'HEAD' });
        const finishTime = Date.now();
        
        const serverDate = response.headers.get('Date');
        if (serverDate) {
          const serverMoment = new Date(serverDate); // 服务器返回的是 UTC 时间
          const roundTripDelay = (finishTime - startTime) / 2;
          const adjustedServerTime = new Date(serverMoment.getTime() + roundTripDelay);

          const localTime = new Date();
          offset = adjustedServerTime - localTime;
        }
      } catch (error) {
        console.error('Error fetching server time:', error);
      }
    }

    function updateClock() {
      const now = new Date(Date.now() + offset); // 计算本地同步后的时间
      now.setHours(now.getHours() + 8); // 转换为 UTC+8 时间

      const formattedTime = now.toISOString().replace('T', ' ').substring(0, 19);
      document.getElementById('real-time-clock').innerText = `System Time: ${formattedTime}`;
    }

    document.addEventListener('visibilitychange', fetchServerTime);
    
    fetchServerTime().then(() => {
      updateClock();
      setInterval(updateClock, 1000);
    });
  })();
</script>        </div>
