{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他忽然很想靠近",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S01-1"
     ]
    },
    {
     "text": "怕太需要会让对方有负担",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S01-2"
     ]
    },
    {
     "text": "只敢露一点喜欢",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S01-2"
     ]
    }
   ],
   "small": [
    {
     "text": "这一点亲近很甜，下次敢更坦白吗？",
     "after": 2,
     "from": [
      "S01-3"
     ],
     "bars": ""
    },
    {
     "text": "话早想好了却怕一说关系会变",
     "after": 1,
     "from": [
      "S01-B2"
     ],
     "bars": "1–3"
    },
    {
     "text": "脚刚踏上微晃船板身体一瞬失重",
     "after": 0,
     "from": [
      "S01-B3"
     ],
     "bars": "1–3"
    }
   ],
   "notes": [
    {
     "text": "两下响亮和弦像烟花迸起，光点飘落后仍悬着",
     "from": [
      "S01-B1"
     ],
     "bars": "1–3"
    },
    {
     "text": "船歌的摇荡感还没真正成形",
     "from": [
      "S01-B1"
     ],
     "bars": "1–3"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "对方没因他的在意退开",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "他才慢慢放松下来",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "他喜欢得快藏不住还想靠近",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "怕弄坏眼下自在便收住",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "还没分开就已舍不得这段时光",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S02-3"
     ]
    }
   ],
   "small": [
    {
     "text": "两条声线贴近耳语肩膀呼吸都挨着",
     "after": 1,
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "相识已久不必找话题沉默也舒服",
     "after": 1,
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "体温仿佛融在一处像夏末湿热的风",
     "after": 1,
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "身体交给船底托着水和时间仍不停流",
     "after": 1,
     "from": [
      "S02-B2"
     ],
     "bars": "4–16"
    },
    {
     "text": "眼前的好甜得鼻酸还盼这一刻慢些",
     "after": 4,
     "from": [
      "S02-B4"
     ],
     "bars": "约7–11"
    }
   ],
   "notes": [
    {
     "text": "歌声未浮起，摇荡已先开始",
     "from": [
      "S02-B2"
     ],
     "bars": "4–5"
    },
    {
     "text": "两条旋律线贴得很近",
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "几次柔软的落音带着轻微停顿",
     "from": [
      "S02-B4"
     ],
     "bars": "约7–11"
    },
    {
     "text": "歌声短暂上涌，随后轻轻收回",
     "from": [
      "S02-B3"
     ],
     "bars": "12–16"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他难得不去想以后",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S03-1"
     ]
    },
    {
     "text": "只想舒服地待在亲近里",
     "accent": "",
     "emotion": "亲密",
     "from": [
      "S03-1"
     ]
    },
    {
     "text": "想说喜欢也想问对方是否一样",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S03-2"
     ]
    },
    {
     "text": "没想好怎么开口念头就淡了",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ]
    }
   ],
   "small": [
    {
     "text": "说完重要的话仍在余味里漂着沉默也舒服",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23"
    },
    {
     "text": "急着表达的念头露头又沉下去",
     "after": 2,
     "from": [
      "S03-B2"
     ],
     "bars": "约20–21"
    },
    {
     "text": "暗流拖住水波倒影碎得拼不齐",
     "after": 1,
     "from": [
      "S03-B3"
     ],
     "bars": "约20–22"
    },
    {
     "text": "像亲密谈话碰到解不开的结",
     "after": 1,
     "from": [
      "S03-B3"
     ],
     "bars": "17–23"
    }
   ],
   "notes": [
    {
     "text": "短促声音忽然从持续摇曳中冒出",
     "from": [
      "S03-B2"
     ],
     "bars": "约20–21"
    },
    {
     "text": "流动绕远滞留，声音像挂在半途",
     "from": [
      "S03-B3"
     ],
     "bars": "约20–22"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "熟悉的亲近又让他欢喜",
     "accent": "",
     "emotion": "欢喜",
     "from": [
      "S04-1"
     ]
    },
    {
     "text": "他想起上回想说却没开口",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S04-1"
     ]
    },
    {
     "text": "这回几乎想把藏着的话说尽",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S04-2"
     ]
    },
    {
     "text": "怕说太多让对方为难",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S04-3"
     ]
    },
    {
     "text": "最后还是留了些话没说",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S04-3"
     ]
    }
   ],
   "small": [
    {
     "text": "盼对方喜欢坦白的他也盼好时光久些",
     "after": 2,
     "from": [
      "S04-2",
      "S04-3"
     ],
     "bars": ""
    },
    {
     "text": "花腔像水面光斑晃得睁不开眼",
     "after": 2,
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "像讲往事越讲越急还忍不住补细节",
     "after": 2,
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "长颤音像夕阳金光话哽在喉头",
     "after": 2,
     "from": [
      "S04-B2"
     ],
     "bars": "约30–34"
    },
    {
     "text": "手越握越紧船身越颠簸越难平衡",
     "after": 3,
     "from": [
      "S04-B3"
     ],
     "bars": "24–34"
    },
    {
     "text": "歌声越美越舍不得这一刻过去",
     "after": 4,
     "from": [
      "S04-B4"
     ],
     "bars": "24–34"
    }
   ],
   "notes": [
    {
     "text": "熟悉歌声重返，细密花腔更华丽迫切",
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "高处长颤音悬着，旋律攀升又渐渐收弱",
     "from": [
      "S04-B2"
     ],
     "bars": "约30–34"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "对方一直亲近他便忘了藏喜欢",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S05-1"
     ]
    },
    {
     "text": "对方看出他有多在乎",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S05-1"
     ]
    },
    {
     "text": "他怕被嫌太黏连相处都拿不准",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S05-2",
      "S05-3"
     ]
    }
   ],
   "small": [
    {
     "text": "心里空落落，熟悉的亲近也像隔层雾",
     "after": 2,
     "from": [
      "S05-2",
      "S05-3",
      "S05-B1"
     ],
     "bars": "35–39"
    },
    {
     "text": "耳语停了，心里问幸福真吗能维持多久",
     "after": 2,
     "from": [
      "S05-B2"
     ],
     "bars": "35–39"
    },
    {
     "text": "像松开紧抱的手终于深吸口气",
     "after": 2,
     "from": [
      "S05-B3"
     ],
     "bars": "35–39"
    }
   ],
   "notes": [
    {
     "text": "丰满声音忽然撤去，只剩单薄旋律",
     "from": [
      "S05-B1"
     ],
     "bars": "35–39"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "对方看出他在乎却没变",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "他才又能自在地相处",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "安静时仍想靠近却怕要太多",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S06-2"
     ]
    },
    {
     "text": "对方不知他怕被嫌他有点孤单",
     "accent": "",
     "emotion": "孤单",
     "from": [
      "S06-2"
     ]
    },
    {
     "text": "他猜对方是否也舍不得",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S06-3"
     ]
    }
   ],
   "small": [
    {
     "text": "暖金水面滑进古桥阴影，空气凉了",
     "after": 1,
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "清凉月光让人想起童年初次心动",
     "after": 1,
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "低声说着算了又放不下，不再强装完整",
     "after": 2,
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    },
    {
     "text": "白天相处很好，独处时酸楚像回忆",
     "after": 2,
     "from": [
      "S06-B3"
     ],
     "bars": "40–50"
    },
    {
     "text": "再亲密的人也走不进心里每个角落",
     "after": 2,
     "from": [
      "S06-B3"
     ],
     "bars": "40–50"
    },
    {
     "text": "气味身体幻想遗憾快感交缠成迷",
     "after": 2,
     "from": [
      "S06-B4"
     ],
     "bars": "40–50"
    }
   ],
   "notes": [
    {
     "text": "新旋律清澈舒展，摇荡变轻变碎",
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "低声旋律旁另一条声音不时回应纠缠",
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "他想起对方总愿意陪他",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S07-1"
     ]
    },
    {
     "text": "也许对方有时需要他陪着会安心",
     "accent": "",
     "emotion": "亲密",
     "from": [
      "S07-1"
     ]
    },
    {
     "text": "想到能互相依靠他又欢喜又心紧",
     "accent": "",
     "emotion": "欢喜",
     "from": [
      "S07-2"
     ]
    },
    {
     "text": "盼对方以后想找人时还会想到他",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S07-3"
     ]
    }
   ],
   "small": [
    {
     "text": "身体仿佛被更深的渴望推着往前",
     "after": 2,
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    },
    {
     "text": "情欲执念与生的眷恋带着情色暖意",
     "after": 2,
     "from": [
      "S07-B1",
      "S07-B2"
     ],
     "bars": "51–61"
    },
    {
     "text": "回忆混成气味身体幻想遗憾和快感",
     "after": 2,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61"
    },
    {
     "text": "舒服得失去方向，明知被卷入还不想出来",
     "after": 2,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61"
    },
    {
     "text": "美还在时间却一刻不停地走",
     "after": 3,
     "from": [
      "S07-B3"
     ],
     "bars": "53–61"
    }
   ],
   "notes": [
    {
     "text": "伴奏渐密，内里的声音攀爬，低音沉重催促",
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "上回他无意露了心意",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "这回对方依然愿意亲近",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "他想主动些大方回应",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "他开始盼两人能好很久",
     "accent": "",
     "emotion": "欢喜",
     "from": [
      "S08-2"
     ]
    },
    {
     "text": "可未来未必还会这样亲近",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S08-3"
     ]
    }
   ],
   "small": [
    {
     "text": "歌句越唱越开像毫无防备地倾诉",
     "after": 2,
     "from": [
      "S08-B1"
     ],
     "bars": "62–70"
    },
    {
     "text": "身体恢复弹性像轻快地调情回应",
     "after": 2,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70"
    },
    {
     "text": "快乐余温还在心里已泛起怀念",
     "after": 4,
     "from": [
      "S08-B3"
     ],
     "bars": "69–71"
    }
   ],
   "notes": [
    {
     "text": "歌句舒展打开，情绪一再抬高",
     "from": [
      "S08-B1"
     ],
     "bars": "62–70"
    },
    {
     "text": "歌声向上散开，随后突然停住",
     "from": [
      "S08-B3"
     ],
     "bars": "69–71"
    }
   ]
  },
  {
   "sec": "S09",
   "big": [
    {
     "text": "他怕有天对方不再需要他陪",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "连和他待着都不自在？",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "他一下安静不敢再往后想",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S09-2"
     ]
    },
    {
     "text": "眼下两人仍亲近对方也没退开",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S09-3"
     ]
    },
    {
     "text": "也许对方喜欢他在身边",
     "accent": "",
     "emotion": "欢喜",
     "from": [
      "S09-3"
     ]
    }
   ],
   "small": [
    {
     "text": "明亮像被薄雾隔开一层",
     "after": 2,
     "from": [
      "S09-B2"
     ],
     "bars": "72–77"
    },
    {
     "text": "听着余响问刚才真吗接下来怎么办",
     "after": 2,
     "from": [
      "S09-B3"
     ],
     "bars": "72–77"
    },
    {
     "text": "抬头看夜空眼前美好比愿望更大",
     "after": 3,
     "from": [
      "S09-B4"
     ],
     "bars": "72–77"
    }
   ],
   "notes": [
    {
     "text": "熟悉摇摆退开，颤音和轻和弦悬在半空",
     "from": [
      "S09-B1"
     ],
     "bars": "72–77"
    }
   ]
  },
  {
   "sec": "S10",
   "big": [
    {
     "text": "他不想再猜以后怎样",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "先好好享受眼前的亲近",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "绷紧的心慢慢松下来",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S10-2"
     ]
    },
    {
     "text": "心里亮堂得想笑也有点想哭",
     "accent": "",
     "emotion": "欢喜",
     "from": [
      "S10-2"
     ]
    }
   ],
   "small": [
    {
     "text": "胸口一下打开眼泪也不用再忍",
     "after": 2,
     "from": [
      "S10-B1"
     ],
     "bars": "78–83"
    },
    {
     "text": "时间像被清风拨开只空出一小会儿",
     "after": 1,
     "from": [
      "S10-B2"
     ],
     "bars": "78–83"
    },
    {
     "text": "灵魂飘出身体夏夜风里负担碰不到",
     "after": 2,
     "from": [
      "S10-B3"
     ],
     "bars": "78–83"
    }
   ],
   "notes": [
    {
     "text": "高音区细亮音符织成银丝细雨",
     "from": [
      "S10-B4"
     ],
     "bars": "78–83"
    },
    {
     "text": "下泻琶音清亮地落进水里",
     "from": [
      "S10-B4"
     ],
     "bars": "80–83"
    }
   ]
  },
  {
   "sec": "S11",
   "big": [
    {
     "text": "他需要对方对方有时也需要他",
     "accent": "",
     "emotion": "亲密",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "即使对方不需要他仍愿意陪着",
     "accent": "",
     "emotion": "亲密",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "他不再藏着喜欢",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S11-1",
      "S11-2"
     ]
    },
    {
     "text": "他不能决定对方还让不让他陪",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S11-3"
     ]
    },
    {
     "text": "未必总能亲近欢喜压得心口疼",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S11-3"
     ]
    }
   ],
   "small": [
    {
     "text": "高兴得顾不上害臊觉得在乎没错",
     "after": 2,
     "from": [
      "S11-2"
     ],
     "bars": ""
    },
    {
     "text": "像先前悬着的期待终于得到满足",
     "after": 2,
     "from": [
      "S11-B2"
     ],
     "bars": "约92"
    },
    {
     "text": "夕阳血红金亮刺眼得想哭胸口也发疼",
     "after": 4,
     "from": [
      "S11-B3"
     ],
     "bars": "84–92"
    },
    {
     "text": "像多年后重回旧房熟悉却有新重量",
     "after": 4,
     "from": [
      "S11-B4"
     ],
     "bars": "84–92"
    }
   ],
   "notes": [
    {
     "text": "厚重和弦托起歌声，伴奏柔波翻成惊涛",
     "from": [
      "S11-B1"
     ],
     "bars": "84–92"
    },
    {
     "text": "力量在高处短暂悬起，像等下一股浪潮",
     "from": [
      "S11-B2"
     ],
     "bars": "约92"
    }
   ]
  },
  {
   "sec": "S12",
   "big": [
    {
     "text": "他顾不上对方是否也在乎",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S12-1"
     ]
    },
    {
     "text": "只想把能给的都给对方",
     "accent": "",
     "emotion": "亲密",
     "from": [
      "S12-1"
     ]
    },
    {
     "text": "他明知再用心也不能保证长久",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S12-2"
     ]
    },
    {
     "text": "还是想多陪对方一会儿",
     "accent": "",
     "emotion": "亲密",
     "from": [
      "S12-2"
     ]
    },
    {
     "text": "欢喜终于整个涌出来不再收着",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S12-3"
     ]
    }
   ],
   "small": [
    {
     "text": "整个人像被卷进比自己更大的世界",
     "after": 4,
     "from": [
      "S12-B1"
     ],
     "bars": "94–102"
    },
    {
     "text": "狂喜像高烧喉咙发紧眼眶湿润想笑想哭",
     "after": 4,
     "from": [
      "S12-B2"
     ],
     "bars": "93–102"
    },
    {
     "text": "久别重逢般抱紧对方久久不愿松手",
     "after": 4,
     "from": [
      "S12-B2"
     ],
     "bars": "94–104"
    },
    {
     "text": "歌声像在恳求还想要更多",
     "after": 4,
     "from": [
      "S12-B3"
     ],
     "bars": "93–102"
    }
   ],
   "notes": [
    {
     "text": "乐句末端仍牵扯延迟",
     "from": [
      "S12-B3"
     ],
     "bars": "96–100"
    },
    {
     "text": "悬着的气息在段落交界处释放",
     "from": [
      "S12-B3"
     ],
     "bars": "102–103"
    }
   ]
  },
  {
   "sec": "S13",
   "big": [
    {
     "text": "他更想听对方说以后不变",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S13-1"
     ]
    },
    {
     "text": "喜欢和对方待着总觉时间太快",
     "accent": "",
     "emotion": "欢喜",
     "from": [
      "S13-1"
     ]
    },
    {
     "text": "如今更怕对方不再需要他陪",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S13-2"
     ]
    },
    {
     "text": "少露些喜欢会不会少疼些？",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S13-2"
     ]
    },
    {
     "text": "真心想对他好再藏回去更难受",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S13-3"
     ]
    }
   ],
   "small": [
    {
     "text": "怕一停下刚得到的东西就消失",
     "after": 1,
     "from": [
      "S13-B1"
     ],
     "bars": "103–110"
    },
    {
     "text": "幸福里渐渐掺进尖锐的苦味",
     "after": 1,
     "from": [
      "S13-B2"
     ],
     "bars": "103–110"
    },
    {
     "text": "握住珍贵的东西才知道留不住",
     "after": 1,
     "from": [
      "S13-B2"
     ],
     "bars": "103–110"
    },
    {
     "text": "刚说了是心里又响起可是呢",
     "after": 3,
     "from": [
      "S13-B3"
     ],
     "bars": "103–110"
    },
    {
     "text": "正因真的相信过怀疑才这么疼",
     "after": 3,
     "from": [
      "S13-B3"
     ],
     "bars": "103–110"
    },
    {
     "text": "脚下站得稳胸口却一沉再一沉",
     "after": 4,
     "from": [
      "S13-B4"
     ],
     "bars": "103–110"
    }
   ],
   "notes": [
    {
     "text": "乐句反复渐强，后段越推越紧",
     "from": [
      "S13-B1"
     ],
     "bars": "103–110"
    },
    {
     "text": "下方脚步稳稳踩住，上方声音一再落下",
     "from": [
      "S13-B4"
     ],
     "bars": "103–110"
    }
   ]
  },
  {
   "sec": "S14",
   "big": [
    {
     "text": "最初他连喜欢都不敢多露",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S14-1"
     ]
    },
    {
     "text": "如今仍亲近心里又甜又酸不后悔",
     "accent": "",
     "emotion": "欢喜",
     "from": [
      "S14-1"
     ]
    },
    {
     "text": "舍不得也不逼对方保证永远",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S14-2"
     ]
    },
    {
     "text": "喜欢已被看见他不再往回藏",
     "accent": "",
     "emotion": "炽热",
     "from": [
      "S14-3"
     ]
    },
    {
     "text": "以后怎样等到了再说",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S14-3"
     ]
    }
   ],
   "small": [
    {
     "text": "像从美梦醒来还记得梦里的光",
     "after": 1,
     "from": [
      "S14-B1"
     ],
     "bars": "111–115"
    },
    {
     "text": "低低一声回望后夜空还有最后一闪",
     "after": 1,
     "from": [
      "S14-B2"
     ],
     "bars": "113–115"
    },
    {
     "text": "经历震荡后站起身整理衣服关门",
     "after": 4,
     "from": [
      "S14-B3"
     ],
     "bars": "116"
    }
   ],
   "notes": [
    {
     "text": "左手内声部幽幽唱出一句，右手琶音像水花",
     "from": [
      "S14-B2"
     ],
     "bars": "113–115"
    },
    {
     "text": "最后几下和弦干脆沉重，低音像铁锚落水",
     "from": [
      "S14-B3"
     ],
     "bars": "116"
    },
    {
     "text": "尾声像隔空回应开头，最后和弦接住悬着的话",
     "from": [
      "S14-B4"
     ],
     "bars": "113–116"
    }
   ]
  }
 ]
}