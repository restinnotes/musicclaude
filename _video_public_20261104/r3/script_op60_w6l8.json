       "from": [
        "S05-B2-p4"
       ]
      },
      {
       "text": "退回自己心里",
       "keys": [],
       "from": [
        "S05-B3-p2"
       ]
      },
      {
       "text": "话卡在嘴边",
       "keys": [],
       "from": [
        "S05-B3-p3"
       ]
      },
      {
       "text": "这幸福是真的吗？",
       "keys": [],
       "from": [
        "S05-B3-p3"
       ],
       "emotion": "悬着"
      },
      {
       "text": "能维持多久？",
       "keys": [],
       "from": [
        "S05-B3-p4"
       ],
       "emotion": "悬着"
      }
     ]
    }
   ]
