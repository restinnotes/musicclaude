       ],
       "bead": "S04-B4"
      },
      {
       "text": "仿佛想把每个问题想清楚，却总是绕不出那几句问话。",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
