            $(this).siblings('li.extension-1688__browser-item').removeClass('active');
            $(this).addClass('active');
        });
        $('body').on("click", ".video_btn", function () {
            var href = $(this).attr('href');
            var src = $(href).find('iframe').attr('bak_src');
            $(href).find('iframe').attr('src', src);

        });
        $('body').on('hidden.bs.modal', ".modal-pinduoduo-video", function () {
            if ($('#modal-addons-detail').hasClass('show')) {
                $("body").addClass("modal-open");
            }
        });

    });
</script><script>(function () {
    // 首页「跨境电商平台」区块点击打点，覆盖两部分：
    // 1. 区块顶部导航：5 个分区 tab + 更多，都是跳到跨境电商平台专题页
    // 2. 区块内 24 个平台项：主图链接 + hover 出来的前台/卖家中心链接
    // 站点标识取链接上的 data-station，再按 href 是否是卖家中心/后台登录入口区分 admin(后台) 与 index(买家前台)
    var ADMIN_URL_RE = /(seller|merchant|retailer|dashboard|authenticate|signin|login|global-selling|\/\/marketplace\.|\/\/accounts?\.|\/\/wing\.|\/\/sso\.|\/sh\/landing)/i;

    document.addEventListener('click', function (event) {
        var target = event.target;
        if (!target || !target.closest) {
            return;
        }
        // 只认跨境电商区块内的链接，避免误伤首页其它模块
        var link = target.closest('.index-platforms-header a[data-station], .index-platforms-grid a[data-station]');
        if (!link) {
            return;
        }
        var station = link.getAttribute('data-station');
        if (!station) {
            return;
        }
        var position = ADMIN_URL_RE.test(link.getAttribute('href') || '') ? 'admin' : 'index';
        window._paq = window._paq || [];
        window._paq.push(['trackEvent', 'homepage-crossborder-ecommerce', 'click-' + station + '-' + position]);
    }, true);
})();
