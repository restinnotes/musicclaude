       "from": [
        "S11-1"
       ],
       "bead": "S11-1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "也可以承认自己仍然需要那份归属，不必假装已经不在乎",
