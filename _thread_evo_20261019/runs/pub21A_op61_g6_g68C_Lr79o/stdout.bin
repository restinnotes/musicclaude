n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只是瞬间的喘息，并不等于整个人重新安顿下来。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他暂时不考虑回去\",\n          \"point\": \"回味一会儿从前相处时的暖意\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"暂时不考虑回去\"\n        },\n        {\n          \"text\": \"暖意一淡\",\n          \"point\": \"往后遇事仍得靠自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"暖意一淡\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"声音短暂落稳，又向高处漂去，刚有的一点稳定感随即散掉\",\n          \"carrier\": \"副词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像是从另一面重新看见了同一扇门，真正向前的步伐还没聚起来。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"只是这一次，你已经知道那个过去的自己经历过什么。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然分不清\",\n          \"point\": \"舍不得那份亲近，还是因为怕孤单\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"还是因为怕孤单\"\n        },\n        {\n          \"text\": \"这个念头让他心慌\",\n          \"point\": \"连再往下想都不敢了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这个念头让他心慌\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"fine\": [\n        {\n          \"quote\": \"熟悉的声音只是轻轻地、断断续续地浮现，