      "S07-B3"
     ],
     "pt": "",
     "bars": "198-205"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "他把旧处钥匙寄还，签收通知到了，便再没法随时回去",
     "accent": "再没法随时回去",
     "emotion": "孤单",
     "from": [
      "S08-1"
     ],
     "at": 0
    },
    {
     "text": "可那点暖意很快就淡了",
     "accent": "很快就淡了",
     "emotion": "孤单",
     "from": [
      "S08-2"
     ],
     "at": 4.0
    },
    {
     "text": "想到以后真遇上难事，回忆没法陪着他，心又悬了起来",
     "accent": "心又悬了起来",
     "emotion": "不安",
     "from": [
      "S08-2"
     ],
     "at": 8.0
    }
   ],
   "small": [
    {
     "text": "像远行的人停下脚步，隔着暮色再望一眼亮灯的屋檐",
     "after": 0,
     "from": [
      "S08-B2"
     ],
     "bars": "206-213",
     "at": 7.0
    },
    {
     "text": "紧绷的胸口刚吸进半口暖气，转眼又被冷风堵了回去",
     "after": 2,
     "from": [
      "S08-B3"
     ],
     "bars": "206-213",
     "at": 12.0
    }
   ],
   "notes": [
    {
     "text": "前面缓慢宽广的歌唱短暂回归，刚认出就又退去了",
