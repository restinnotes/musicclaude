     }
    ]
   },
   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "没在想",
    "items": [
     {
      "id": "S08-1",
      "text": "接着我再一次沉进了那种曾经让我满足的亲近感里，只想在这份感觉里多留一会儿。",
      "key": "接着我再一次沉进",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-2",
       "S06-4"
      ]
     },
     {
      "id": "S08-2",
      "text": "哪怕那份亲近感正在一点点退去，我也一直守着心里的喜欢，没有催自己赶快放下这份不舍。",
      "key": "哪怕那份亲近感正",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-3",
       "S06-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S06-2",
