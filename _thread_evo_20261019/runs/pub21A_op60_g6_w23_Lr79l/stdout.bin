": \"大\",\n          \"fix\": \"动作先泄露害怕\"\n        },\n        {\n          \"quote\": \"你越用力，水面的颠簸就越剧烈，船舱内的平衡就越脆弱\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"平衡越发脆弱\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"熟悉的亲近又让他\",\n          \"point\": \"想起上回明明想告诉对方却没有开口\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"上回明明想告诉对方却没有开口\"\n        },\n        {\n          \"text\": \"他几乎想把藏着的话\",\n          \"point\": \"把藏着的话全说出来\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"盼着对方也喜欢他不再小心收着的样子\"\n        },\n        {\n          \"text\": \"他甚至盼着说出来\",\n          \"point\": \"最后还是留了些话没说\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可又怕一下说得太多让对方为难\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"丰满的声音只剩下一条单薄、孤零零的旋律\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"没了\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连时间也松开了\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"刚才那阵想攥紧不放的冲动，终于轻轻退了下去\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"前几次想说又收住\",\n          \"point\": \"对方已经看出他有多在乎\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方却一直愿意跟他亲近\"\n        },\n        {\n          \"text\": \"先前藏着时还能装作\",\n          \"point\": \"连怎么跟对方待着都拿不准\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"先前藏着时还能装作没那么在乎，如今对方看出来了\"\n        },\n        {\n          \"text\": \"他忍不住担心对方\",\n          \"point\": \"忽然隔了一层