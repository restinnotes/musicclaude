{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"落下来以后，却还没有真正落稳\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"身体有一瞬失重\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"一瞬失重\"\n        },\n        {\n          \"quote\": \"心里很清楚自己要说什么，正因为太清楚\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"太清楚，反而不敢说\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现很想\",\n          \"point\": \"很想靠近对方\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"连自己都意外\"\n        },\n        {\n          \"text\": \"他怕对方看出\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又怕这份需要让对方觉得负担太重\"\n        },\n        {\n          \"text\": \"这点亲近已经\",\n          \"point\": \"下次能不能更坦白\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这点亲近已经让他觉得甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"对方偶尔望来一眼，沉默也不让人紧张\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"放心交给水浪\"\n        },\n        {\n          \"quote\": \"还没有失去，就已经生出一丝舍不得\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有因为他\",\n          \"point\": \"他这才慢慢放松\",