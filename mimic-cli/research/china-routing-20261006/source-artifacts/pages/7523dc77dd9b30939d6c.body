<script id="wix-first-paint">
    if (window.ResizeObserver &&
        (!window.PerformanceObserver || !PerformanceObserver.supportedEntryTypes || PerformanceObserver.supportedEntryTypes.indexOf('paint') === -1)) {
        new ResizeObserver(function (entries, observer) {
            entries.some(function (entry) {
                var contentRect = entry.contentRect;
                if (contentRect.width > 0 && contentRect.height > 0) {
                    requestAnimationFrame(function (now) {
                        window.wixFirstPaint = now;
                        dispatchEvent(new CustomEvent('wixFirstPaint'));
                    });
                    observer.disconnect();
                    return true;
                }
            });
        }).observe(document.body);
    }
</script>


<script id="scroll-bar-width-calculation">
    const div = document.createElement('div')
    div.style.overflowY = 'scroll'
    div.style.width = '50px'
    div.style.height = '50px'
    div.style.visibility = 'hidden'
    document.body.appendChild(div)
    const scrollbarWidth= div.offsetWidth - div.clientWidth
    document.body.removeChild(div)
    if(scrollbarWidth > 0){
        document.body.style.setProperty('--scrollbar-width', `${scrollbarWidth}px`)
    }
</script>





    <style id=wix-custom-css>/* Users Custom CSS code */
 #SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-corner-radius {
  border-radius: 14px;
}


#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-box-scroll-x-auto {
    overflow-x: auto;
}

#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-box-pointer {
    cursor: pointer;
}

#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-POPUPS_ROOT {
    left: 100px !important;
}

#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item {
    position: relative;
    padding: 0;
    margin-bottom: 12px;
    border-radius: 100px;
    transition: all 0.2s ease, visibility 0s;
}

#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item:active,
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item:focus,
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item:hover,
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item[aria-current] {
    border-radius: 10px;
    background: rgba(211, 195, 219, 0.53);
    color: #3C0B52 !important;
}

#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    height: 18px;
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    mask-position: center;
} 

#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item:active::before,
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item:focus::before,
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item:hover::before,
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item[aria-current]::before {
    background-color: #3C0B52 !important;
}

/* 
---------- STEPS FOR NEW MENU ICONS ----------
    1. Copy the SVG data (should look like '<svg xmlns="...">...</svg>')
    2. Run it through SVGOMG (https://jakearchibald.github.io/svgomg/) to remove anything unnecessary
    3. Replace all # characters with %23
    4. Paste into mask-image property below, after 'data:image/svg+xml,'
 */

/* resources icon */
