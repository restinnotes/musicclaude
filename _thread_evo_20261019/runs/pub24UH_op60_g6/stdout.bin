{"completed": true, "response": "<escape>{\n  \"units\": [\n    {\"uid\":\"S01-u1\",\"near\":\"S01-u2\",\"rel\":\"不同\",\"adds\":\"带来突然涌现的靠近欲望、内心发热和自我意外。\",\"uniq\":4},\n    {\"uid\":\"S01-u10\",\"near\":\"S01-u9\",\"rel\":\"部分\",\"adds\":\"补出对关系后果的清醒预判：话一出口，关系可能改变。\",\"uniq\":4},\n    {\"uid\":\"S01-u12\",\"near\":\"S01-u8\",\"rel\":\"部分\",\"adds\":\"增加不同演奏之间的听觉差异：开头可以已经摇荡，也可以仍悬在空中。\",\"uniq\":4},\n    {\"uid\":\"S01-u2\",\"near\":\"S01-u3\",\"rel\":\"部分\",\"adds\":\"强调害怕被对方视为负担的心理原因，而不只是外在收敛。\",\"uniq\":3},\n    {\"uid\":\"S01-u3\",\"near\":\"S01-u2\",\"rel\":\"部分\",\"adds\":\"补出恐惧落实为行为后的结果：只敢表达一点点喜欢。\",\"uniq\":3},\n    {\"uid\":\"S01-u4\",\"near\":\"S01-u1\",\"rel\":\"不同\",\"adds\":\"呈现少量亲近已经足以带来的甜蜜满足，而非欲望突然出现。\",\"uniq\":4},\n    {\"uid\":\"S01-u5\",\"near\":\"S01-u10\",\"rel\":\"部分\",\"adds\":\"把谨慎延伸到下一次相处，表现对自己能否更坦白的不确定。\",\"uniq\":3},\n    {\"uid\":\"S01-u6\",\"near\":\"S01-u7\",\"rel\":\"部分\",\"adds\":\"指出开头和弦本身突然闯入的听觉特征。\",\"uniq\":3},\n    {\"uid\":\"S01-u7\",\"near\":\"S01-u6\",\"rel\":\"部分\",\"adds\":\"增加烟花向上迸发、细碎光点向下飘落的完整空间轨迹。\",\"uniq\":4},\n    {\"uid\":\"S01-u8\",\"near\":\"S01-u12\",\"rel\":\"部分\",\"adds\":\"增加刚踏上船板时的身体失重、摇晃和尚未建立稳定节律的触感。\",\"uniq\":4},\n    {\"uid\":\"S01-u9\",\"near\":\"S01-u10\",\"rel\":\"部分\",\"adds\":\"补出开口之前那几秒具体的沉默和等待。\",\"uniq\":3},\n\n    {\"uid\":\"S02-u1\",\"near\":\"S02-u2\",\"rel\":\"部分\",\"adds\":\"交代放松得以发生的外部条件：对方确实没有退开。\",\"uniq\":3},\n    {\"uid\":\"S02-u10\",\"near\":\"S02-u8\",\"rel\":\"部分\",\"adds\":\"增加潮湿、黏稠、温热的皮肤触感，而非单纯身体贴近。\",\"uniq\":4},\n    {\"uid\":\"S02-u11\",\"near\":\"S02-u12\",\"rel\":\"部分\",\"adds\":\"强调心跳般持续、重复的节律，以及歌声尚未出现时左手已经开始摇荡。\",\"uniq\":4},\n    {\"uid\":\"S02-u12\",\"near\":\"S02-u11\",\"rel\":\"部分\",\"adds\":\"补出身体放弃控制重力、被船底托举的被动安适感。\",\"uniq\":4},\n    {\"uid\":\"S02-u13\",\"near\":\"S02-u7\",\"rel\":\"部分\",\"adds\":\"把时间流逝落实为持续运动的水波，即使身体安逸，外部时间仍未停止。\",\"uniq\":4},\n    {\"uid\":\"S02-u14\",\"near\":\"S02-u4\",\"rel\":\"部分\",\"adds\":\"表现收敛的感情突然向上涌动，并具体改变呼吸。\",\"uniq\":4},\n    {\"uid\":\"S02-u15\",\"near\":\"S02-u16\",\"rel\":\"部分\",\"adds\":\"增加热烈情绪主动退回柔和的动态变化，像一次轻轻的呼气。\",\"uniq\":3},\n    {\"uid\":\"S02-u16\",\"near\":\"S02-u15\",\"rel\":\"部分\",\"adds\":\"强调柔和并非最终安定，声音重新漂起，心事仍未定论。\",\"uniq\":3},\n    {\"uid\":\"S02-u17\",\"near\":\"S02-u7\",\"rel\":\"部分\",\"adds\":\"从柔软落音本身听出甜蜜确认与隐约刺痛并存的情绪质地。\",\"uniq\":4},\n    {\"uid\":\"S02-u2\",\"near\":\"S02-u1\",\"rel\":\"部分\",\"adds\":\"补出对方没有退开之后，他内部逐渐放松的心理变化。\",\"uniq\":3},\n    {\"uid\":\"S02-u3\",\"near\":\"S02-u4\",\"rel\":\"部分\",\"adds\":\"突出主动靠近的意愿，而不只是喜欢已经难以隐藏。\",\"uniq\":3},\n    {\"uid\":\"S02-u4\",\"near\":\"S02-u3\",\"rel\":\"部分\",\"adds\":\"补出喜欢逐渐外露、几乎无法继续隐藏的强度。\",\"uniq\":3},\n    {\"uid\":\"S02-u5\",\"near\":\"S02-u3\",\"rel\":\"部分\",\"adds\":\"增加对关系节奏的顾虑，以及最终主动收住自己的选择。\",\"uniq\":4},\n    {\"uid\":\"S02-u6\",\"near\":\"S02-u9\",\"rel\":\"部分\",\"adds\":\"概括两人共同相处的整体舒适与美好，而非某一种具体互动。\",\"uniq\":3},\n    {\"uid\":\"S02-u7\",\"near\":\"S02-u13\",\"rel\":\"部分\",\"adds\":\"增加尚未分别就已经舍不得的预先失落，以及希望时间放慢的愿望。\",\"uniq\":4},\n    {\"uid\":\"S02-u8\",\"near\":\"S02-u10\",\"rel\":\"部分\",\"adds\":\"呈现两条声线贴近所形成的耳语、肩靠肩、呼吸和体温融合的亲密画面。\",\"uniq\":4},\n    {\"uid\":\"S02-u9\",\"near\":\"S02-u6\",\"rel\":\"部分\",\"adds\":\"增加熟悉关系中的从容：沉默不尴尬，不必刻意寻找话题。\",\"uniq\":4},\n\n    {\"uid\":\"S03-u1\",\"near\":\"S03-u7\",\"rel\":\"部分\",\"adds\":\"强调主动放下对未来的思考，把注意力留在眼前的亲近。\",\"uniq\":4},\n    {\"uid\":\"S03-u10\",\"near\":\"S03-u4\",\"rel\":\"部分\",\"adds\":\"把表达冲动描绘成短暂露头又沉回水面的念头，突出它的瞬时性。\",\"uniq\":4},\n    {\"uid\":\"S03-u11\",\"near\":\"S03-u9\",\"rel\":\"部分\",\"adds\":\"增加持续的牵绊、思绪破碎和心结般的阻力，而非只有短促急切的声音。\",\"uniq\":5},\n    {\"uid\":\"S03-u2\",\"near\":\"S03-u3\",\"rel\":\"不同\",\"adds\":\"承担主动表达自己喜欢这份相处的愿望。\",\"uniq\":4},\n    {\"uid\":\"S03-u3\",\"near\":\"S03-u2\",\"rel\":\"不同\",\"adds\":\"承担探询对方是否同样喜欢这份亲近的愿望。\",\"uniq\":4},\n    {\"uid\":\"S03-u4\",\"near\":\"S03-u10\",\"rel\":\"部分\",\"adds\":\"强调念头因为尚未找到开口方式而逐渐淡去的心理过程。\",\"uniq\":3},\n    {\"uid\":\"S03-u5\",\"near\":\"S03-u8\",\"rel\":\"部分\",\"adds\":\"增加身体被水波托着摇晃、漂浮而不前往任何地方的感官状态。\",\"uniq\":4},\n    {\"uid\":\"S03-u6\",\"near\":\"S03-u7\",\"rel\":\"部分\",\"adds\":\"增加说过重要的话以后仍沉浸其中、陶醉而走神的余韵。\",\"uniq\":4},\n    {\"uid\":\"S03-u7\",\"near\":\"S03-u6\",\"rel\":\"部分\",\"adds\":\"强调亲密交谈之后的沉默本身也可以令人舒服，不需要继续说话。\",\"uniq\":4},\n    {\"uid\":\"S03-u8\",\"near\":\"S03-u5\",\"rel\":\"部分\",\"adds\":\"把漂浮从身体层面转向心理层面：身体留在原地，心却逐渐远去。\",\"uniq\":4},\n    {\"uid\":\"S03-u9\",\"near\":\"S03-u10\",\"rel\":\"部分\",\"adds\":\"提供短促、急切的音乐事件本身，为一闪而过的表达冲动提供听觉依据。\",\"uniq\":3},\n\n    {\"uid\":\"S04-u1\",\"near\":\"S04-u9\",\"rel\":\"部分\",\"adds\":\"呈现熟悉的亲近重新出现时，人物内部重新升起的欢喜。\",\"uniq\":3},\n    {\"uid\":\"S04-u10\",\"near\":\"S04-u12\",\"rel\":\"部分\",\"adds\":\"突出歌声较第一次更华丽、更迫切的音乐变化。\",\"uniq\":4},\n    {\"uid\":\"S04-u11\",\"near\":\"S04-u13\",\"rel\":\"部分\",\"adds\":\"增加花腔细碎、闪烁、晃眼的视觉质感，而非单纯强烈明亮。\",\"uniq\":4},\n    {\"uid\":\"S04-u12\",\"near\":\"S04-u10\",\"rel\":\"部分\",\"adds\":\"将音乐的迫切转化为叙述者越讲越快、重复并补充细节的行为。\",\"uniq\":4},\n    {\"uid\":\"S04-u13\",\"near\":\"S04-u11\",\"rel\":\"部分\",\"adds\":\"把高处长颤音塑造成最后一道刺眼金光，突出情绪抵达炽热顶点。\",\"uniq\":4},\n    {\"uid\":\"S04-u14\",\"near\":\"S04-u3\",\"rel\":\"部分\",\"adds\":\"增加开口前喉咙颤抖、哽咽的身体阻滞，以及仍在向前推动的水波。\",\"uniq\":4},\n    {\"uid\":\"S04-u15\",\"near\":\"S04-u16\",\"rel\":\"部分\",\"adds\":\"强调情绪虽已打开，却在上升过程中收弱，始终没有真正落定。\",\"uniq\":4},\n    {\"uid\":\"S04-u16\",\"near\":\"S04-u15\",\"rel\":\"部分\",\"adds\":\"增加情绪释放之后摇晃放慢、话语回荡而人安静下来的余韵。\",\"uniq\":4},\n    {\"uid\":\"S04-u17\",\"near\":\"S04-u5\",\"rel\":\"部分\",\"adds\":\"增加握紧、抱紧的身体动作，以及越想抓牢越容易破坏平衡的恐惧。\",\"uniq\":5},\n    {\"uid\":\"S04-u2\",\"near\":\"S04-u7\",\"rel\":\"部分\",\"adds\":\"补出当前情绪受到过去未能开口的经历影响。\",\"uniq\":3},\n    {\"uid\":\"S04-u21\",\"near\":\"S04-u22\",\"rel\":\"部分\",\"adds\":\"直接呈现甜蜜中夹杂鼻酸、尚未失去就已经舍不得的情绪。\",\"uniq\":4},\n    {\"uid\":\"S04-u22\",\"near\":\"S04-u21\",\"rel\":\"部分\",\"adds\":\"把舍不得落实为音乐中的持续流动和逐秒倒数的时间感。\",\"uniq\":4},\n    {\"uid\":\"S04-u3\",\"near\":\"S04-u4\",\"rel\":\"部分\",\"adds\":\"突出几乎想把全部隐藏心事说出来的主动冲动。\",\"uniq\":3},\n    {\"uid\":\"S04-u4\",\"near\":\"S04-u3\",\"rel\":\"部分\",\"adds\":\"增加对对方反应的期待：希望对方喜欢自己不再遮掩的样子。\",\"uniq\":3},\n    {\"uid\":\"S04-u5\",\"near\":\"S04-u22\",\"rel\":\"部分\",\"adds\":\"赋予表达心意一个留住眼下美好的目的，而不只是表达欲望。\",\"uniq\":4},\n    {\"uid\":\"S04-u6\",\"near\":\"S04-u7\",\"rel\":\"部分\",\"adds\":\"说明没有说完的原因是担心给对方压力、破坏原有自在。\",\"uniq\":4},\n    {\"uid\":\"S04-u7\",\"near\":\"S04-u6\",\"rel\":\"部分\",\"adds\":\"补出顾虑最终落实为保留一部分话语、没有完全坦白的结果。\",\"uniq\":3},\n    {\"uid\":\"S04-u8\",\"near\":\"S04-u10\",\"rel\":\"部分\",\"adds\":\"标记熟悉歌声在第24小节重新出现这一结构事件。\",\"uniq\":3},\n    {\"uid\":\"S04-u9\",\"near\":\"S04-u1\",\"rel\":\"部分\",\"adds\":\"用两道声线和耳语般的呼吸距离具体呈现重新出现的亲密。\",\"uniq\":4},\n\n    {\"uid\":\"S05-u1\",\"near\":\"S05-u2\",\"rel\":\"部分\",\"adds\":\"补出这次坦露之前的关系历史：过去几次收住表达，对方却一直没有退开。\",\"uniq\":4},\n    {\"uid\":\"S05-u11\",\"near\":\"S05-u9\",\"rel\":\"部分\",\"adds\":\"增加失去支撑后的空间迷雾、前路不明和时间松散感。\",\"uniq\":4},\n    {\"uid\":\"S05-u13\",\"near\":\"S05-u14\",\"rel\":\"部分\",\"adds\":\"呈现两个人之间的交谈突然中断这一外部事件。\",\"uniq\":3},\n    {\"uid\":\"S05-u14\",\"near\":\"S05-u13\",\"rel\":\"部分\",\"adds\":\"增加关系视角的变化：从共同的亲密退回一个人的内心。\",\"uniq\":4},\n    {\"uid\":\"S05-u15s1\",\"near\":\"S05-u13\",\"rel\":\"部分\",\"adds\":\"把中断具体化为一句重要的话到了嘴边却没有说出口。\",\"uniq\":4},\n    {\"uid\":\"S05-u15s2\",\"near\":\"S05-u7\",\"rel\":\"部分\",\"adds\":\"增加对幸福真实性和持续时间的怀疑，而不只是担心被嫌黏人。\",\"uniq\":4},\n    {\"uid\":\"S05-u16\",\"near\":\"S05-u17\",\"rel\":\"部分\",\"adds\":\"回指此前想牢牢抓住当下的主动冲动。\",\"uniq\":3},\n    {\"uid\":\"S05-u17\",\"near\":\"S05-u16\",\"rel\":\"部分\",\"adds\":\"增加主动松手、呼吸放松以及抓紧冲动逐渐退去的变化。\",\"uniq\":4},\n    {\"uid\":\"S05-u2\",\"near\":\"S05-u3\",\"rel\":\"部分\",\"adds\":\"强调流露心意是无意间发生的，而不是经过决定后主动坦白。\",\"uniq\":3},\n    {\"uid\":\"S05-u3\",\"near\":\"S05-u2\",\"rel\":\"部分\",\"adds\":\"强调对方已经识别出他的真实在意，形成无法再隐藏的现实。\",\"uniq\":3},\n    {\"uid\":\"S05-u4\",\"near\":\"S05-u3\",\"rel\":\"部分\",\"adds\":\"增加过去还能假装不在乎的对照，以及掩饰被看穿后的暴露感。\",\"uniq\":4},\n    {\"uid\":\"S05-u5\",\"near\":\"S05-u6\",\"rel\":\"部分\",\"adds\":\"突出心意暴露之后突然出现的空落情绪。\",\"uniq\":3},\n    {\"uid\":\"S05-u6\",\"near\":\"S05-u5\",\"rel\":\"部分\",\"adds\":\"增加具体的相处困惑：不知道下一步应该如何与对方相处。\",\"uniq\":4},\n    {\"uid\":\"S05-u7\",\"near\":\"S05-u8\",\"rel\":\"部分\",\"adds\":\"明确指出距离感背后的原因是害怕被认为太黏、太需要。\",\"uniq\":4},\n    {\"uid\":\"S05-u8\",\"near\":\"S05-u7\",\"rel\":\"部分\",\"adds\":\"把担忧表现为亲密感本身发生变化，熟悉关系忽然隔了一层。\",\"uniq\":4},\n    {\"uid\":\"S05-u9\",\"near\":\"S05-u11\",\"rel\":\"部分\",\"adds\":\"突出音乐织体从丰满到单薄、从共同支撑到孤零零旋律的变化。\",\"uniq\":4},\n\n    {\"uid\":\"S06-u1\",\"near\":\"S06-u2\",\"rel\":\"部分\",\"adds\":\"强调对方看见真实心意后，外在态度依然没有改变。\",\"uniq\":3},\n    {\"uid\":\"S06-u10\",\"near\":\"S06-u11\",\"rel\":\"部分\",\"adds\":\"提供新旋律清澈、舒展、朴素牧歌般的音乐性质。\",\"uniq\":4},\n    {\"uid\":\"S06-u11\",\"near\":\"S06-u10\",\"rel\":\"部分\",\"adds\":\"增加清凉月光般的视觉与温度联想，突出空灵纯净。\",\"uniq\":4},\n    {\"uid\":\"S06-u12\",\"near\":\"S06-u11\",\"rel\":\"部分\",\"adds\":\"将纯净的感受转化为童年和初次心动的记忆联想。\",\"uniq\":4},\n    {\"uid\":\"S06-u13\",\"near\":\"S06-u14\",\"rel\":\"部分\",\"adds\":\"先行指出平静表面之下仍有不安分的东西。\",\"uniq\":3},\n    {\"uid\":\"S06-u14\",\"near\":\"S06-u16\",\"rel\":\"部分\",\"adds\":\"补出两条声线之间具体的回应、插话和纠缠关系。\",\"uniq\":4},\n    {\"uid\":\"S06-u15\",\"near\":\"S06-u16\",\"rel\":\"部分\",\"adds\":\"将声音的往复表现为内心放下与无法放下之间反复拉扯的念头。\",\"uniq\":4},\n    {\"uid\":\"S06-u16\",\"near\":\"S06-u14\",\"rel\":\"部分\",\"adds\":\"增加两条声音时近时远、无法稳定靠拢或分离的空间运动。\",\"uniq\":4},\n    {\"uid\":\"S06-u17s1\",\"near\":\"S06-u17s2\",\"rel\":\"部分\",\"adds\":\"增加逐渐忘记他人目光、失去自我监控的过程。\",\"uniq\":4},\n    {\"uid\":\"S06-u17s2\",\"near\":\"S06-u17s1\",\"rel\":\"部分\",\"adds\":\"明确指出这种状态意味着不再努力维持完整、体面的形象。\",\"uniq\":4},\n    {\"uid\":\"S06-u18\",\"near\":\"S06-u5\",\"rel\":\"部分\",\"adds\":\"增加白天相处愉快、夜晚独处后才浮现酸楚的时间与情境。\",\"uniq\":4},\n    {\"uid\":\"S06-u19\",\"near\":\"S06-u18\",\"rel\":\"部分\",\"adds\":\"提出亲密关系的内在边界：最亲近的人也无法进入自己的每一个内心角落。\",\"uniq\":5},\n    {\"uid\":\"S06-u20\",\"near\":\"S06-u18\",\"rel\":\"部分\",\"adds\":\"增加美好时光尚在发生却已经带有回忆感的时间错位。\",\"uniq\":4},\n    {\"uid\":\"S06-u21\",\"near\":\"S06-u22\",\"rel\":\"部分\",\"adds\":\"明确提出与感官欲望退潮不同的另一种听法，即主动而贴身的沉醉。\",\"uniq\":4},\n    {\"uid\":\"S06-u22\",\"near\":\"S06-u21\",\"rel\":\"部分\",\"adds\":\"展开沉醉的具体内容：气味、身体感觉、幻想、遗憾和快感交织。\",\"uniq\":4},\n    {\"uid\":\"S06-u23\",\"near\":\"S06-u22\",\"rel\":\"部分\",\"adds\":\"补出沉浸体验的后果：越舒服，越失去方向。\",\"uniq\":3},\n    {\"uid\":\"S06-u2\",\"near\":\"S06-u1\",\"rel\":\"部分\",\"adds\":\"突出对方没有退开所带来的主观结果：终于恢复以前的自在。\",\"uniq\":3},\n    {\"uid\":\"S06-u3\",\"near\":\"S06-u4\",\"rel\":\"部分\",\"adds\":\"强调他仍有靠近的愿望，却必须克制自己不要索取太多。\",\"uniq\":4},\n    {\"uid\":\"S06-u4\",\"near\":\"S06-u3\",\"rel\":\"部分\",\"adds\":\"增加双方感受的不对称：对方并不知道他刚才经历过怎样的恐惧。\",\"uniq\":4},\n    {\"uid\":\"S06-u5\",\"near\":\"S06-u19\",\"rel\":\"部分\",\"adds\":\"表现这种内在隔阂带来的直接情绪结果：即使亲近仍然孤单。\",\"uniq\":4},\n    {\"uid\":\"S06-u6\",\"near\":\"S06-u1\",\"rel\":\"部分\",\"adds\":\"从对方持续没有退开的事实，进一步猜测对方是否也舍不得结束。\",\"uniq\":4},\n    {\"uid\":\"S06-u7\",\"near\":\"S06-u8\",\"rel\":\"部分\",\"adds\":\"强调音乐重新落下，却进入陌生水域而非恢复原先的熟悉状态。\",\"uniq\":4},\n    {\"uid\":\"S06-u8\",\"near\":\"S06-u7\",\"rel\":\"部分\",\"adds\":\"增加摇荡重新出现后的质地变化：变薄、变碎、变得轻盈。\",\"uniq\":4},\n    {\"uid\":\"S06-u9\",\"near\":\"S06-u11\",\"rel\":\"部分\",\"adds\":\"增加从暖金色到古桥阴影的光线变化，以及空气骤然转凉的感官转折。\",\"uniq\":4},\n\n    {\"uid\":\"S07-u1\",\"near\":\"S07-u2\",\"rel\":\"部分\",\"adds\":\"提供对方持续愿意相处这一事实，作为推测相互需要的依据。\",\"uniq\":3},\n    {\"uid\":\"S07-u10\",\"near\":\"S07-u8\",\"rel\":\"部分\",\"adds\":\"增加执念般的力量，以及不满足于浅层亲近的深度。\",\"uniq\":4},\n    {\"uid\":\"S07-u11\",\"near\":\"S07-u10\",\"rel\":\"部分\",\"adds\":\"把热度进一步理解为对生命本身的眷恋和生命冲动。\",\"uniq\":4},\n    {\"uid\":\"S07-u12\",\"near\":\"S07-u13\",\"rel\":\"部分\",\"adds\":\"突出沉醉本身令人舍不得退出的快感，以及明知被卷入仍不想离开。\",\"uniq\":4},\n    {\"uid\":\"S07-u13\",\"near\":\"S07-u12\",\"rel\":\"部分\",\"adds\":\"增加独处回忆的具体感官内容，使沉醉具有气味、身体和记忆的混合质地。\",\"uniq\":4},\n    {\"uid\":\"S07-u15\",\"near\":\"S07-u6\",\"rel\":\"部分\",\"adds\":\"从音乐中听见时间不可停留的限制，即使完美也无法永久保持。\",\"uniq\":4},\n    {\"uid\":\"S07-u2\",\"near\":\"S07-u1\",\"rel\":\"部分\",\"adds\":\"补出对方持续相处可能意味着相互需要、相处安心的推断。\",\"uniq\":4},\n    {\"uid\":\"S07-u3\",\"near\":\"S07-u4\",\"rel\":\"部分\",\"adds\":\"强调想到互相依靠时涌现的高兴和难以收住的情绪。\",\"uniq\":3},\n    {\"uid\":\"S07-u4\",\"near\":\"S07-u3\",\"rel\":\"部分\",\"adds\":\"增加欢喜中突然出现的身体性紧张和不安。\",\"uniq\":3},\n    {\"uid\":\"S07-u5\",\"near\":\"S07-u3\",\"rel\":\"部分\",\"adds\":\"强调即使产生不安，仍然不愿离开当前亲近状态。\",\"uniq\":3},\n    {\"uid\":\"S07-u6\",\"near\":\"S07-u2\",\"rel\":\"部分\",\"adds\":\"把相互需要的想象延伸成对未来持续陪伴的具体愿望。\",\"uniq\":4},\n    {\"uid\":\"S07-u7\",\"near\":\"S07-u8\",\"rel\":\"部分\",\"adds\":\"提供热烈感情在音乐上的依据：伴奏加密、暗流攀升、低音脉搏催促。\",\"uniq\":4},\n    {\"uid\":\"S07-u8\",\"near\":\"S07-u10\",\"rel\":\"部分\",\"adds\":\"表现压抑感受转化为行动动力，身体被更深渴望推动向前。\",\"uniq\":4},\n    {\"uid\":\"S07-u9\",\"near\":\"S07-u10\",\"rel\":\"部分\",\"adds\":\"增加热度中情色性的暖意这一具体情绪与感官色彩。\",\"uniq\":4},\n\n    {\"uid\":\"S08-u1\",\"near\":\"S08-u2\",\"rel\":\"部分\",\"adds\":\"交代主动回应的前提：上次流露心意后，对方仍然保持亲近。\",\"uniq\":3},\n    {\"uid\":\"S08-u10\",\"near\":\"S08-u9\",\"rel\":\"部分\",\"adds\":\"把身体的玩心进一步落实为两个人之间轻快的调情与回应。\",\"uniq\":4},\n    {\"uid\":\"S08-u11\",\"near\":\"S08-u12s1\",\"rel\":\"部分\",\"adds\":\"增加歌声向上散开、蒸发而不是踏实落定的渐变过程。\",\"uniq\":4},\n    {\"uid\":\"S08-u12s1\",\"near\":\"S08-u11\",\"rel\":\"部分\",\"adds\":\"补出渐渐消散之后突然中止、进入静意的明确断点。\",\"uniq\":4},\n    {\"uid\":\"S08-u12s2\",\"near\":\"S08-u4\",\"rel\":\"部分\",\"adds\":\"增加快乐结束后的回望和怀念，是已经发生的失落感而非对未来的预测。\",\"uniq\":4},\n    {\"uid\":\"S08-u2\",\"near\":\"S08-u1\",\"rel\":\"部分\",\"adds\":\"呈现他从确认对方没有疏远，转向主动回应的行为选择。\",\"uniq\":3},\n    {\"uid\":\"S08-u3\",\"near\":\"S08-u4\",\"rel\":\"部分\",\"adds\":\"表现对未来持续相处的积极期待和乐观想象。\",\"uniq\":3},\n    {\"uid\":\"S08-u4\",\"near\":\"S08-u3\",\"rel\":\"部分\",\"adds\":\"增加乐观想象背后的不确定性：眼下亲近不代表以后也会如此。\",\"uniq\":4},\n    {\"uid\":\"S08-u5\",\"near\":\"S08-u6\",\"rel\":\"部分\",\"adds\":\"提供直接、舒展、咏叹调式的音乐表达形态。\",\"uniq\":4},\n    {\"uid\":\"S08-u6\",\"near\":\"S08-u5\",\"rel\":\"部分\",\"adds\":\"强调这份直接并非仅是旋律舒展，还意味着没有防卫和过度分析。\",\"uniq\":4},\n    {\"uid\":\"S08-u7\",\"near\":\"S08-u5\",\"rel\":\"部分\",\"adds\":\"增加歌句不断展开、情绪逐步升高和摇荡催促的动态过程。\",\"uniq\":4},\n    {\"uid\":\"S08-u8\",\"near\":\"S08-u9\",\"rel\":\"部分\",\"adds\":\"增加阳光、风和空气感，使明亮轻盈成为整体感官状态。\",\"uniq\":4},\n    {\"uid\":\"S08-u9\",\"near\":\"S08-u10\",\"rel\":\"部分\",\"adds\":\"补出轻盈感在身体上的体现：恢复弹性和玩心。\",\"uniq\":4},\n\n    {\"uid\":\"S09-u1\",\"near\":\"S09-u2\",\"rel\":\"部分\",\"adds\":\"突出对方不再需要自己陪伴这一具体的未来恐惧。\",\"uniq\":4},\n    {\"uid\":\"S09-u10\",\"near\":\"S09-u9\",\"rel\":\"部分\",\"adds\":\"补出暗沉之中仍有光的细微状态，而不是彻底陷入黑暗。\",\"uniq\":4},\n    {\"uid\":\"S09-u11\",\"near\":\"S09-u12\",\"rel\":\"部分\",\"adds\":\"增加不急着继续说话、只听自己刚才言语余响的内省状态。\",\"uniq\":4},\n    {\"uid\":\"S09-u12\",\"near\":\"S09-u11\",\"rel\":\"部分\",\"adds\":\"把听余响的状态推进为对真实性和下一步行动的明确追问。\",\"uniq\":4},\n    {\"uid\":\"S09-u13\",\"near\":\"S09-u14\",\"rel\":\"部分\",\"adds\":\"增加仰望夜空后视野突然扩大的体验，使个人愿望暂时退居其次。\",\"uniq\":5},\n    {\"uid\":\"S09-u14\",\"near\":\"S09-u13\",\"rel\":\"部分\",\"adds\":\"明确不安并未解决，只是暂时失去了对全部注意力的控制。\",\"uniq\":4},\n    {\"uid\":\"S09-u2\",\"near\":\"S09-u1\",\"rel\":\"部分\",\"adds\":\"增加对方不仅不再需要陪伴，还可能觉得相处不自在的关系性恐惧。\",\"uniq\":4},\n    {\"uid\":\"S09-u3\",\"near\":\"S09-u6\",\"rel\":\"部分\",\"adds\":\"表现未来畅想突然中止后，人物从外放转向安静的心理变化。\",\"uniq\":3},\n    {\"uid\":\"S09-u4\",\"near\":\"S09-u5\",\"rel\":\"部分\",\"adds\":\"强调对方没有退开、当下仍然亲近是已经发生的事实。\",\"uniq\":3},\n    {\"uid\":\"S09-u5\",\"near\":\"S09-u4\",\"rel\":\"部分\",\"adds\":\"从现实事实进一步产生积极推测，并重新得到一点高兴。\",\"uniq\":3},\n    {\"uid\":\"S09-u6\",\"near\":\"S09-u7\",\"rel\":\"部分\",\"adds\":\"增加音乐突然收住、熟悉摇摆退后的整体运动中断感。\",\"uniq\":4},\n    {\"uid\":\"S09-u7\",\"near\":\"S09-u8\",\"rel\":\"部分\",\"adds\":\"提供颤音和轻柔和弦悬在半空的具体音乐形态。\",\"uniq\":4},\n    {\"uid\":\"S09-u8\",\"near\":\"S09-u7\",\"rel\":\"部分\",\"adds\":\"把悬置解释为渴望仍然强烈、却被压住不表达的身体与关系紧张。\",\"uniq\":4},\n    {\"uid\":\"S09-u9\",\"near\":\"S09-u10\",\"rel\":\"部分\",\"adds\":\"增加声音逐层下沉、变暗和注意力集中的低气压体验。\",\"uniq\":4},\n\n    {\"uid\":\"S10-u1\",\"near\":\"S10-u7\",\"rel\":\"部分\",\"adds\":\"补出主动决定停止猜测未来、回到眼前生活的心理选择。\",\"uniq\":4},\n    {\"uid\":\"S10-u10\",\"near\":\"S10-u9\",\"rel\":\"部分\",\"adds\":\"强调这片时间空地非常短暂，不能成为永久躲避现实的地方。\",\"uniq\":4},\n    {\"uid\":\"S10-u11\",\"near\":\"S10-u8\",\"rel\":\"部分\",\"adds\":\"增加身体与灵魂分离般的失重感，以及肉身负担暂时无法触及自己的体验。\",\"uniq\":5},\n    {\"uid\":\"S10-u12\",\"near\":\"S10-u13\",\"rel\":\"部分\",\"adds\":\"突出高音音符极细、极亮、近乎无重量的蛛丝与细雨质感。\",\"uniq\":4},\n    {\"uid\":\"S10-u13\",\"near\":\"S10-u12\",\"rel\":\"部分\",\"adds\":\"增加琶音从高处倾泻而下、如飞瀑落水般的力度和方向感。\",\"uniq\":4},\n    {\"uid\":\"S10-u2\",\"near\":\"S10-u4\",\"rel\":\"部分\",\"adds\":\"概括紧绷逐渐消失这一心理变化，而非具体的身体动作。\",\"uniq\":3},\n    {\"uid\":\"S10-u3\",\"near\":\"S10-u6\",\"rel\":\"部分\",\"adds\":\"增加明亮与想笑、想哭同时出现的复杂情绪色彩。\",\"uniq\":4},\n    {\"uid\":\"S10-u4\",\"near\":\"S10-u2\",\"rel\":\"部分\",\"adds\":\"把紧张释放具体化为肩膀放松、长呼气和胸腔打开。\",\"uniq\":4},\n    {\"uid\":\"S10-u5\",\"near\":\"S10-u6\",\"rel\":\"部分\",\"adds\":\"强调原本被压住的话语终于有了舒展空间。\",\"uniq\":4},\n    {\"uid\":\"S10-u6\",\"near\":\"S10-u3\",\"rel\":\"部分\",\"adds\":\"增加眼泪不再需要压抑、可以自然流露的具体表现。\",\"uniq\":4},\n    {\"uid\":\"S10-u7\",\"near\":\"S10-u1\",\"rel\":\"部分\",\"adds\":\"强调外部问题并未解决，只是暂时不再强迫自己控制感受。\",\"uniq\":4},\n    {\"uid\":\"S10-u8\",\"near\":\"S10-u9\",\"rel\":\"部分\",\"adds\":\"把原先持续前进的水波和摇荡描绘成被清风暂时拨开的运动变化。\",\"uniq\":4},\n    {\"uid\":\"S10-u9\",\"near\":\"S10-u10\",\"rel\":\"部分\",\"adds\":\"增加时间本身松弛下来、暂时不必继续向前的体验。\",\"uniq\":4},\n\n    {\"uid\":\"S11-a1\",\"near\":\"S11-u9\",\"rel\":\"同一样\",\"adds\":\"无。\",\"uniq\":1},\n    {\"uid\":\"S11-u1\",\"near\":\"S11-u2\",\"rel\":\"部分\",\"adds\":\"明确自己需要对方这一单向的情感认识。\",\"uniq\":3},\n    {\"uid\":\"S11-u10\",\"near\":\"S11-u9\",\"rel\":\"部分\",\"adds\":\"增加厚重和弦与跨八度惊涛骇浪的音乐依据，解释直接感如何形成。\",\"uniq\":4},\n    {\"uid\":\"S11-u11\",\"near\":\"S11-u4\",\"rel\":\"部分\",\"adds\":\"把不再隐藏推进为明确的自我宣告：不再为自己的感情道歉。\",\"uniq\":4},\n    {\"uid\":\"S11-u12\",\"near\":\"S11-u13\",\"rel\":\"部分\",\"adds\":\"增加力量释放之后短暂悬置、等待下一次高潮的过程。\",\"uniq\":4},\n    {\"uid\":\"S11-u13\",\"near\":\"S11-u12\",\"rel\":\"部分\",\"adds\":\"补出与第32小节旧高潮的历史对照，以及这次终于获得满足的意义。\",\"uniq\":5},\n    {\"uid\":\"S11-u14\",\"near\":\"S11-u13\",\"rel\":\"部分\",\"adds\":\"强调当前满足只是阶段性的，并非整首曲子的最终结束。\",\"uniq\":3},\n    {\"uid\":\"S11-u15\",\"near\":\"S11-u17\",\"rel\":\"部分\",\"adds\":\"增加灿烂带来的刺眼、不舒适和夕阳将尽般的感官压迫。\",\"uniq\":4},\n    {\"uid\":\"S11-u17\",\"near\":\"S11-u15\",\"rel\":\"部分\",\"adds\":\"将不舒适落实为胸口受压、疼痛，以及喜悦超过身体承受限度。\",\"uniq\":4},\n    {\"uid\":\"S11-u19\",\"near\":\"S11-u21\",\"rel\":\"部分\",\"adds\":\"提供多年后重回旧房子的时间跨度，以及环境未变而经历已变的画面。\",\"uniq\":4},\n    {\"uid\":\"S11-u21\",\"near\":\"S11-u19\",\"rel\":\"部分\",\"adds\":\"强调经历使原来的温柔获得新重量，并因更加珍贵而变得疼痛。\",\"uniq\":4},\n    {\"uid\":\"S11-u2\",\"near\":\"S11-u1\",\"rel\":\"部分\",\"adds\":\"补出相互需要这一认识中的另一半：对方有时也需要自己。\",\"uniq\":3},\n    {\"uid\":\"S11-u3\",\"near\":\"S11-u1\",\"rel\":\"不同\",\"adds\":\"表达不以得到回应为前提的陪伴意愿，即使对方不需要自己也愿意留下。\",\"uniq\":5},\n    {\"uid\":\"S11-u4\",\"near\":\"S11-u11\",\"rel\":\"部分\",\"adds\":\"把不再隐藏概括为人物已经作出的态度决定。\",\"uniq\":3},\n    {\"uid\":\"S11-u5\",\"near\":\"S11-u6\",\"rel\":\"部分\",\"adds\":\"强调高兴到顾不上害臊的情绪强度和坦率程度。\",\"uniq\":3},\n    {\"uid\":\"S11-u6\",\"near\":\"S11-u5\",\"rel\":\"部分\",\"adds\":\"补出情绪背后的自我接纳：在乎对方本身并没有错。\",\"uniq\":4},\n    {\"uid\":\"S11-u7\",\"near\":\"S11-u8\",\"rel\":\"部分\",\"adds\":\"指出未来能否继续陪伴并不由自己决定，突出关系中的不可控制性。\",\"uniq\":4},\n    {\"uid\":\"S11-u8\",\"near\":\"S11-u7\",\"rel\":\"部分\",\"adds\":\"增加不可控制的未来对当下欢喜的反向影响：欢喜变得沉重、压心。\",\"uniq\":4},\n    {\"uid\":\"S11-u9\",\"near\":\"S11-a1\",\"rel\":\"同一样\",\"adds\":\"无。\",\"uniq\":1},\n\n    {\"uid\":\"S12-u1\",\"near\":\"S12-u2\",\"rel\":\"部分\",\"adds\":\"突出他不再把对方是否同样在乎自己作为付出的前提。\",\"uniq\":4},\n    {\"uid\":\"S12-u10\",\"near\":\"S12-u12\",\"rel\":\"部分\",\"adds\":\"增加高烧般的内在燃烧感，表现狂喜的生理强度。\",\"uniq\":4},\n    {\"uid\":\"S12-u11\",\"near\":\"S12-u12\",\"rel\":\"部分\",\"adds\":\"提供久别重逢、突然紧紧拥抱且久久不愿放手的身体性表达。\",\"uniq\":4},\n    {\"uid\":\"S12-u12\",\"near\":\"S12-u11\",\"rel\":\"部分\",\"adds\":\"增加喉咙发紧、眼眶湿润，以及快乐到无法分辨哭笑的情绪混合。\",\"uniq\":4},\n    {\"uid\":\"S12-u13\",\"near\":\"S12-u15\",\"rel\":\"部分\",\"adds\":\"概括整股声浪始终无法畅通释放、带有恳求而不满足的状态。\",\"uniq\":4},\n    {\"uid\":\"S12-u15\",\"near\":\"S12-u13\",\"rel\":\"部分\",\"adds\":\"具体标出牵扯和延迟持续的时间范围，以及102至103小节交界处的重大释放。\",\"uniq\":4},\n    {\"uid\":\"S12-u2\",\"near\":\"S12-u1\",\"rel\":\"部分\",\"adds\":\"增加付出的具体内容和目的：把能给的都给出去，希望对方安心。\",\"uniq\":4},\n    {\"uid\":\"S12-u3\",\"near\":\"S12-u4\",\"rel\":\"部分\",\"adds\":\"明确他知道再用心也不能保证未来持续美好。\",\"uniq\":3},\n    {\"uid\":\"S12-u4\",\"near\":\"S12-u3\",\"rel\":\"部分\",\"adds\":\"增加即使知道无法保证未来，仍嫌眼下不够、想多陪一会儿的欲望。\",\"uniq\":4},\n    {\"uid\":\"S12-u5\",\"near\":\"S12-u12\",\"rel\":\"部分\",\"adds\":\"突出此前压抑的快乐终于完全涌出，不再控制自己喜欢对方。\",\"uniq\":4},\n    {\"uid\":\"S12-u6\",\"near\":\"S12-u7\",\"rel\":\"部分\",\"adds\":\"突出原先温柔旋律被放大后的英雄式、开阔和明亮尺度。\",\"uniq\":4},\n    {\"uid\":\"S12-u7\",\"near\":\"S12-u6\",\"rel\":\"部分\",\"adds\":\"指出宏大明亮的外表内部仍有声部拉扯和不平顺。\",\"uniq\":4},\n    {\"uid\":\"S12-u8\",\"near\":\"S12-u9\",\"rel\":\"部分\",\"adds\":\"强调体验从梦境般的游离重新聚焦到此时此地，并扩展为天地共振。\",\"uniq\":4},\n    {\"uid\":\"S12-u9\",\"near\":\"S12-u8\",\"rel\":\"部分\",\"adds\":\"增加自我暂时退居后面的体验：不是个人感情变大，而是自己被更大的世界包围。\",\"uniq\":5},\n\n    {\"uid\":\"S13-u1\",\"near\":\"S13-u3\",\"rel\":\"部分\",\"adds\":\"突出希望对方亲口保证未来不变的主动索求。\",\"uniq\":4},\n    {\"uid\":\"S13-u10\",\"near\":\"S13-u11\",\"rel\":\"部分\",\"adds\":\"标记第103小节心愿仿佛已经说出，却没有形成终止的结构转折。\",\"uniq\":4},\n    {\"uid\":\"S13-u11\",\"near\":\"S13-u12\",\"rel\":\"部分\",\"adds\":\"增加反复、渐强和持续绷紧的过程，以及害怕停下来就会失去的心理。\",\"uniq\":4},\n    {\"uid\":\"S13-u12\",\"near\":\"S13-u11\",\"rel\":\"部分\",\"adds\":\"把持续推进描绘成浪峰之后又有更大浪潮逼近的具体运动画面。\",\"uniq\":4},\n    {\"uid\":\"S13-u13\",\"near\":\"S13-u14\",\"rel\":\"部分\",\"adds\":\"指出暗色成分出现之前，音乐仍在坚持和确认先前的幸福。\",\"uniq\":3},\n    {\"uid\":\"S13-u14\",\"near\":\"S13-u15\",\"rel\":\"部分\",\"adds\":\"提供幸福内部出现阴影的音乐依据：明亮逐渐掺入尖锐、暗沉。\",\"uniq\":4},\n    {\"uid\":\"S13-u15\",\"near\":\"S13-u16\",\"rel\":\"部分\",\"adds\":\"明确悲伤并不是取代幸福，而是进入幸福内部与它同时存在。\",\"uniq\":4},\n    {\"uid\":\"S13-u16\",\"near\":\"S13-u19\",\"rel\":\"部分\",\"adds\":\"增加真正拥有珍贵事物之后，才意识到它无法永久保留的痛感。\",\"uniq\":4},\n    {\"uid\":\"S13-u17\",\"near\":\"S13-u18\",\"rel\":\"部分\",\"adds\":\"提供一个肯定之后立即出现反问的内心对话形式。\",\"uniq\":4},\n    {\"uid\":\"S13-u18\",\"near\":\"S13-u17\",\"rel\":\"部分\",\"adds\":\"明确限定反问的意义：它不是对先前幸福真实性的否定。\",\"uniq\":4},\n    {\"uid\":\"S13-u19\",\"near\":\"S13-u16\",\"rel\":\"部分\",\"adds\":\"强调怀疑之所以疼，是因为此前确实相信过、拥有过幸福。\",\"uniq\":4},\n    {\"uid\":\"S13-u2\",\"near\":\"S13-u1\",\"rel\":\"部分\",\"adds\":\"增加越喜欢相处越感到时间飞快、越舍不得流逝的体验。\",\"uniq\":4},\n    {\"uid\":\"S13-u20\",\"near\":\"S13-u21\",\"rel\":\"不同\",\"adds\":\"提供下方声部稳定、坚定、不肯移动的独立音乐形象。\",\"uniq\":5},\n    {\"uid\":\"S13-u21\",\"near\":\"S13-u22\",\"rel\":\"部分\",\"adds\":\"增加上方声音反复下落、像叹息和心事纠缠的音乐运动。\",\"uniq\":4},\n    {\"uid\":\"S13-u22\",\"near\":\"S13-u21\",\"rel\":\"部分\",\"adds\":\"将反复下落的听觉形象转化为胸口一次次下沉的身体感受。\",\"uniq\":4},\n    {\"uid\":\"S13-u3\",\"near\":\"S13-u1\",\"rel\":\"部分\",\"adds\":\"将索取保证背后的不安明确为对关系能否持续的怀疑。\",\"uniq\":3},\n    {\"uid\":\"S13-u4\",\"near\":\"S13-u5\",\"rel\":\"部分\",\"adds\":\"突出害怕对方不再需要自己的情感位置变化。\",\"uniq\":3},\n    {\"uid\":\"S13-u5\",\"near\":\"S13-u4\",\"rel\":\"部分\",\"adds\":\"进一步扩大失去的范围：不仅不再被需要，连相处机会也可能消失。\",\"uniq\":4},\n    {\"uid\":\"S13-u6\",\"near\":\"S13-u9\",\"rel\":\"部分\",\"adds\":\"提出减少表达、重新隐藏心意以减轻未来伤害的防御策略。\",\"uniq\":4},\n    {\"uid\":\"S13-u7\",\"near\":\"S13-u8\",\"rel\":\"部分\",\"adds\":\"强调他已经失去最初那种假装不在乎的能力。\",\"uniq\":4},\n    {\"uid\":\"S13-u8\",\"near\":\"S13-u7\",\"rel\":\"部分\",\"adds\":\"确认刚才表达喜欢、想对对方好的行为确实出自真实心意。\",\"uniq\":4},\n    {\"uid\":\"S13-u9\",\"near\":\"S13-u6\",\"rel\":\"部分\",\"adds\":\"增加重新隐藏心意的反作用：这样做反而会使自己更难受。\",\"uniq\":4},\n\n    {\"uid\":\"S14-u1\",\"near\":\"S14-u2\",\"rel\":\"部分\",\"adds\":\"强调从最初不敢表达走到现在，人物已经不再后悔自己的心意。\",\"uniq\":4},\n    {\"uid\":\"S14-u10\",\"near\":\"S14-u9\",\"rel\":\"部分\",\"adds\":\"增加梦醒之后仍然记得梦中光亮的回忆感。\",\"uniq\":4},\n    {\"uid\":\"S14-u11\",\"near\":\"S14-u12\",\"rel\":\"部分\",\"adds\":\"指出渐轻过程中出现的独立内声部，以及男中音式的沉思气质。\",\"uniq\":4},\n    {\"uid\":\"S14-u12\",\"near\":\"S14-u17\",\"rel\":\"部分\",\"adds\":\"强调熟悉的歌唱与摇荡重新出现，形成对先前音乐的回望。\",\"uniq\":4},\n    {\"uid\":\"S14-u13\",\"near\":\"\",\"rel\":\"不同\",\"adds\":\"独有最后琶音如水花溅向夜空的细碎闪光画面。\",\"uniq\":5},\n    {\"uid\":\"S14-u14\",\"near\":\"S14-u15\",\"rel\":\"部分\",\"adds\":\"强调结尾没有采用梦境般逐渐消散的处理，而是明确结束。\",\"uniq\":4},\n    {\"uid\":\"S14-u15\",\"near\":\"S14-u16\",\"rel\":\"部分\",\"adds\":\"增加铁锚落水般的沉重定点感，以及小船摇荡被突然固定的音乐形象。\",\"uniq\":4},\n    {\"uid\":\"S14-u16\",\"near\":\"S14-u15\",\"rel\":\"部分\",\"adds\":\"将音乐的明确结束转化为一个人整理衣服、关门、重新站定的现实动作。\",\"uniq\":4},\n    {\"uid\":\"S14-u17\",\"near\":\"S14-u19\",\"rel\":\"部分\",\"adds\":\"突出尾声与开头之间的遥远回应和首尾呼应关系。\",\"uniq\":4},\n    {\"uid\":\"S14-u19\",\"near\":\"S14-u17\",\"rel\":\"部分\",\"adds\":\"进一步明确结尾接住了开头悬而未决的话，使音乐获得完整的收束。\",\"uniq\":4},\n    {\"uid\":\"S14-u2\",\"near\":\"S14-u1\",\"rel\":\"部分\",\"adds\":\"直接呈现当下甜蜜与酸楚同时存在的情绪构成。\",\"uniq\":4},\n    {\"uid\":\"S14-u3\",\"near\":\"S14-u4\",\"rel\":\"部分\",\"adds\":\"保留对未来的不确定和仍然存在的舍不得。\",\"uniq\":3},\n    {\"uid\":\"S14-u4\",\"near\":\"S14-u6\",\"rel\":\"部分\",\"adds\":\"明确不再要求对方提供永远不变的保证。\",\"uniq\":4},\n    {\"uid\":\"S14-u5\",\"near\":\"S14-u6\",\"rel\":\"部分\",\"adds\":\"强调已经被看见的喜欢不再重新藏回去，是对自身表达的坚持。\",\"uniq\":4},\n    {\"uid\":\"S14-u6\",\"near\":\"S14-u4\",\"rel\":\"部分\",\"adds\":\"增加面向未来的态度：不提前追问答案，等事情真正发生再面对。\",\"uniq\":4},\n    {\"uid\":\"S14-u7\",\"near\":\"S14-u8\",\"rel\":\"部分\",\"adds\":\"指出进入终结句之前还有最后一次向前猛推的浪潮。\",\"uniq\":3},\n    {\"uid\":\"S14-u8\",\"near\":\"S14-u7\",\"rel\":\"部分\",\"adds\":\"明确进入终结句之后，音乐才真正松弛、轻柔下来。\",\"uniq\":3},\n    {\"uid\":\"S14-u9\",\"near\":\"S14-u10\",\"rel\":\"部分\",\"adds\":\"补出结束之后仍然留在心里的温热，以及身体逐渐平静的状态。\",\"uniq\":4}\n  ]\n}</escape>", "metadata": {"session_handle": "9bacc8dc-6753-420d-a89d-53ad8dd94e33", "session_revision": 0, "session_ttl_max_hours": 6, "job_directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt3\\pro-bridge-20261110T223501840198Z", "elapsed_seconds": 237.093, "completed_utc": "2026-11-10T22:38:58.947116+00:00", "model": "gpt-6-thinking", "thinking_effort": "max", "temporary": true, "unpersonalized": true, "generation_policy_verified": true, "request_policy": {"model": "gpt-6-thinking", "thinking_effort": "max", "history_and_training_disabled": true, "temporary_chat_requests_personalization": false, "is_do_not_remember": false, "continuation": false, "unpersonalized_inherited_verified": false, "body_sha256": "d578e71a23208adafa58a9f4aa0d79b3e3154ab26dc2025c82019a59eddf156a", "attachment_count": 0}, "stream_completion": {"sse_done": true, "message_completed": true, "independent_terminal_verified": true}, "profile": "yi/local-codex-auth", "account_sha256": "b3efb6361563c139233ed7b7ef61a7c9afe0bd48d4eb3525dbe31956b024d6da", "transport": "probridge-pure-http", "resume_requests": 0, "topic_connections": 0, "browser_started": false, "Docker_used": false, "automatic_retry": false, "initializer_pss_limit_mib": "not_applicable_no_browser", "attachment_count": 0, "code_sha256": {"tools\\chatgpt_web\\gpt3_cli.py": "96a4cdb6cd5d982f4d1de5b6ba8fae0cf23ee44aa3e41d7fdf6968e3fb590e48", "tools\\chatgpt_web\\gpt3_sessions.py": "83a3ed4ae1efa9f1a2b8ee3f144cc0dc9f668f995a33cc4222308cb3fa31f683", "tools\\chatgpt_web\\gpt3_attachments.py": "eedfa23885000025700f6306b1d1f4582896a7370734be506c156dee532fd7d7"}}, "screenshot_evidence": {"complete": true, "kind": "offline_actual_HTTP_response", "directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt3\\pro-bridge-20261110T223501840198Z", "files": ["proof-offline.png"], "sha256": {"proof-offline.png": "c8c906552546fa0e224d2647c8bfb092931b35407b5fab5cc60013fffb141733"}}}
