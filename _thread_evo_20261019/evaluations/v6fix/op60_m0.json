   {
    "sec": "S11",
    "bars": "84–92",
    "relation": "没在想",
    "items": [
     {
      "id": "I85",
      "text": "重新沉浸在亲近里，他又被欢喜充满",
      "key": "欢喜充满",
      "follows": null
     },
     {
      "id": "I86",
      "text": "难受没使他减少对亲近的向往",
      "key": "亲近的向往",
      "follows": null
     },
     {
      "id": "I87",
      "text": "他如今知道那个人真的能让他这样快乐",
      "key": "这样快乐",
      "follows": null
     },
     {
      "id": "I88",
      "text": "先前的疼惜仍在，他却愿继续敞开",
      "key": "愿继续敞开",
      "follows": null
     },
     {
      "id": "I89",
      "text": "熟悉的温暖让他想交出整个自己",
      "key": "整个自己",
      "follows": null
     },
     {
      "id": "I90",
      "text": "他不想再藏起最容易受伤的地方",
      "key": "最容易受伤",
      "follows": null
     },
     {
      "id": "I91",
      "text": "快乐重新涌满，他仍愿意领受",
      "key": "仍愿意领受",
      "follows": null
     },
     {
      "id": "I92",
      "text": "他仿佛觉得此刻只有爱值得保留",
      "key": "只有爱值得保留",
      "follows": null
     }
    ],
    "because": [
     {
