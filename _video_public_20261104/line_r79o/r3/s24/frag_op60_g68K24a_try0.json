     "emotion": "不安",
     "from": [
      "S11-3"
     ],
     "at": 29
    }
   ],
   "small": [
    {
     "text": "这就是我的感情，我不再为它道歉",
     "after": 3,
     "from": [
      "S11-B1"
     ],
     "bars": "84–92",
     "at": 22
    },
    {
     "text": "力量短暂悬住，像期待终于得到满足",
     "after": 3,
     "from": [
      "S11-B2"
     ],
     "bars": "约92",
     "at": 30
    },
    {
     "text": "像夕阳最后两分钟，血红金亮刺眼",
