     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "心里亮堂得几乎想笑，也有点想哭。",
       "keys": [
        "亮堂得几乎想笑",
        "也有点想哭"
       ],
       "from": [
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "时间也松了",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "不是能永远躲进去的避风处",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "灵魂从躯壳里飘出来",
