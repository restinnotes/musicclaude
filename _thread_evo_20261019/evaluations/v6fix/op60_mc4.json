     {
      "from": "S12-3",
      "to": "S13-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S14",
    "bars": "111–116",
    "relation": "正在面对",
    "items": [
     {
      "id": "S14-1",
      "text": "欢喜平缓仍依恋，难像起初只顾眼前轻松。",
      "key": "欢喜平缓仍依恋，",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2",
       "S13-2"
      ]
     },
     {
      "id": "S14-2",
      "text": "确实尝过快乐，想起来仍欢喜，也不悔交出自己。",
      "key": "确实尝过快乐，想",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-2"
      ]
     },
     {
      "id": "S14-3",
      "text": "他更爱对方，不知美好能留多久。他不追问，仍决意全心去爱。",
      "key": "他更爱对方，不知",
