    "relation": "正在面对",
    "items": [
     {
      "id": "I68",
      "text": "那种渴渐渐让他更难受",
      "key": "更难受",
      "follows": null
     },
     {
      "id": "I69",
      "text": "他似乎已不只想要更多温柔和亲近",
      "key": "似乎已不只想要",
      "follows": null
     },
     {
      "id": "I70",
      "text": "他得到过那些，不安却没有消失",
      "key": "不安却没有消失",
      "follows": null
     },
     {
      "id": "I71",
      "text": "他想幸福时不必想到它终会过去",
      "key": "终会过去",
      "follows": null
     },
     {
      "id": "I72",
      "text": "他知道对方多爱他也给不了这一点",
      "key": "给不了这一点",
      "follows": null
     },
     {
      "id": "I73",
      "text": "他知道自己的在乎留不住最好的时候",
      "key": "最好的时候",
      "follows": null
     },
     {
      "id": "I74",
      "text": "他有些无措",
      "key": "有些无措",
      "follows": null
     },
     {
      "id": "I75",
      "text": "他没有理由责怪谁",
      "key": "没有理由责怪",
      "follows": null
     },
     {
      "id": "I76",
      "text": "他胸口的舍不得比先前更清晰",
      "key": "比先前更清晰",
      "follows": null
     }
    ],
