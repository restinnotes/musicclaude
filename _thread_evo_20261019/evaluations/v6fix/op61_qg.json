      "rel": "引用"
     },
     {
      "from": "S10-3",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S07-1",
      "to": "S11-2",
      "rel": "引用"
     },
     {
      "from": "S10-3",
      "to": "S11-2",
      "rel": "引用"
     },
     {
      "from": "S06-3",
      "to": "S11-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "242–253",
    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "他现在能大大方方承认，自己就是很想念从前被人接纳的日子，不必一想起那些好处就赶紧为离开找理由。",
      "key": "他现在能大大方方",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-2",
       "S07-1",
       "S11-3"
      ]
     },
     {
      "id": "S12-2",
      "text": "他也没因此决定回去；如今舍不得旧日，却仍记得为什么非走不可，他愿意带着这份舍不得继续把眼前的生活过好。",
      "key": "他也没因此决定回",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S10-2",
       "S11-3"
      ]
     },
     {
      "id": "S12-3",
      "text": "偶尔那股熟悉的迟疑又冒出来，让他短暂地没那么踏实，但已经不至于让他马上把自己的想念往回藏。",
      "key": "偶尔那股熟悉的迟",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S04-2",
      "to": "S12-1",
      "rel": "引用"
     },
     {
      "from": "S07-1",
      "to": "S12-1",
      "rel": "引用"
     },
     {
      "from": "S11-3",
      "to": "S12-1",
      "rel": "引用"
     },
     {
