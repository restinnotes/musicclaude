          \"keep\": \"上次没说出口\"\n        },\n        {\n          \"text\": \"他想说出心意\",\n          \"point\": \"喜欢他坦白时的样子\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"也盼\"\n        },\n        {\n          \"text\": \"说得太多会让对方为难\",\n          \"point\": \"让对方为难\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"说得太多；两人也不再自在\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"原来一直托着你的水波和摇晃，忽然像被抽掉了\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份幸福是真实的吗？它能维持多久？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方一直没退开\",\n          \"point\": \"终于没藏住喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一直没退开；终于\"\n        },\n        {\n          \"text\": \"对方看出他在乎\",\n          \"point\": \"心里却空落落\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"却；怕太黏\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"左手的波浪变薄、碎成细密的小纹\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"忽然觉得有点孤单\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"忽然有点孤单\"\n        },\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方看出他的在乎\",\n          \"point\": \"像从前一样亲近\",\n          \"w