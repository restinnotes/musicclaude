        {
          "id": "S02-C01",
          "kind": "facets",
          "label": "摇荡",
          "text": "4–5小节，左手12/8摇起：心跳、无止境的水浪，水流在呼吸。\n放弃重力控制，全身交给深不可测、温热而规律起伏的水；陆地的病痛、琐事、沉重被隔开。\n水波托举，催眠般安全，抚平惊悸；音乐流动，绷紧的身体慢慢松开。\n疲惫卸下戒备，“偷来的安宁”。",
          "meaning_ids": [
            "S02-A002",
            "S02-A085",
            "S02-A010",
            "S02-A011",
            "S02-A020",
            "S02-A042",
            "S02-A001"
          ],
          "evidence": [
            {
              "uid": "SRC-gflash-int-1-U03",
              "quote": "像心跳，也像无止境的水浪。"
            },
            {
              "uid": "SRC-gflash-int-2-U03",
              "quote": "像水流的呼吸"
            },
            {
              "uid": "SRC-gflash-int-3-U03",
              "quote": "把整个身体的重量完全交托给身下那片深不可测、温热且规律起伏的水体。"
            },
            {
              "uid": "SRC-gflash-int-3-U03",
              "quote": "陆地上的病痛、琐事与沉重，在这一刻被物理隔绝了。"
            },
            {
              "uid": "SRC-gflash-web-3-U02",
              "quote": "催眠般的安全感"
            },
            {
              "uid": "SRC-gpt6w-int-2-U02",
              "quote": "仿佛原来绷着的身体终于慢慢松开。"
            },
            {
              "uid": "SRC-gflash-int-1-U02",
              "quote": "卸下戒备的疲惫感，夹杂着“偷来的安宁”。"
            }
          ],
