       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      },
      {
       "text": "也许对方也喜欢他在身边，想到这儿他有点高兴",
       "keys": [],
       "from": [
        ""
       ],
       "bead": ""
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
