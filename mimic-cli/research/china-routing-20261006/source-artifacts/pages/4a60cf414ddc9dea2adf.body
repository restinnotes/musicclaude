<style>
/* research.css paints the page banner with .inner_bg:after - a 700px absolutely
   positioned overlay. This moves the gradient onto .inner_bg itself at 400px and
   retires the overlay, which would otherwise paint straight over it. This element
   loads after research.css, so an equal-specificity rule here wins. */
.inner_bg {
    position: relative;
    margin-bottom: 50px;
    background: linear-gradient(0deg, rgba(43,109,127,1) 3%, rgba(43,109,127,1) 40%, rgba(53,18,73,1) 76%) no-repeat;
    background-size: 100% 600px;
}
.inner_bg:after { content: none; }

