      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S13",
    "bars": "254–288",
    "relation": "正在面对",
    "items": [
     {
      "id": "S13-1",
      "text": "他真心投入眼下之后，心里生出久违的热切，想到从前那些珍贵的日子，也不再只是难过。",
      "key": "他真心投入眼下之",
      "follows": false,
      "explains": [],
      "cite": [
       "S12-1",
       "S10-3"
      ]
     },
     {
      "id": "S13-2",
      "text": "他不想再收着力气，愿意把能给眼下生活的热情都拿出来。",
      "key": "他不想再收着力气",
      "follows": false,
