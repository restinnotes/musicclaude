        "弄丢自在"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "手越握越紧，像想抱住当下，船舱也跟着晃",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "左手水波仍向前，像每一秒都在倒数",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "歌声越美越舍不得，明明还没失去却先鼻酸",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "最后还是把一部分话留在心里",
       "keys": [],
       "from": [
        "S04-3"
       ],
       "bead": "S04-3"
      }
     ]
    }
   ]
