   ]
  },
  {
   "bars": "62–71",
   "relation": "正在面对",
   "items": [
    {
     "id": "S08-1",
     "text": "眼前的亲近让他心里舒畅，靠近的念头也添了玩心，享受当下便已满足。",
     "key": "渴望带上玩心",
     "follows": false
    },
