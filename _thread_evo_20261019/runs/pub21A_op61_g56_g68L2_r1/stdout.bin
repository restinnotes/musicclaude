{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"我不能倒下，可我其实很想停下来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"可其实\"\n        },\n        {\n          \"quote\": \"像烟雾往高处散，声音轻了、远了，悬在半空。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"胸口有些发紧，视线还模糊着；伸出颤抖的手去摸，摸到的却只有虚空。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开了熟悉的生活\",\n          \"point\": \"终于不用再受委屈\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"终于\"\n        },\n        {\n          \"text\": \"没多久，他心里空落落的\",\n          \"point\": \"不知舍不得什么\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没多久\"\n        },\n        {\n          \"text\": \"想继续往前走，只是不知道\",\n          \"point\": \"不知道以后怎么安心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只是\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句。\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"节奏本身庄严、傲慢，旋律却脆弱凄婉\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他舍不得过去的自在\",\n          \"point\": \"心里就有些慌\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一想到回不去\"\n        },\n        {\n          \"text\": \"怕一心软就忘了为什么走\",\n          \"point\": \"为什么走\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"怕一心软\"\n        },\n        {\n          \"text\": \"可他不甘心，难道离开\",\n          \"point\": \"把好日子也丢了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可他不甘心\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"温柔得让人心颤，也刺痛得让人绝望：越怀念，越能感觉它与眼前处境的距离。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越怀念，越觉遥远\"\n        },\n        {\n          \"quote\": \"那一刻的轻松可以是真的，并非假装；只是它没有替心里的事找到答案。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"我刚才是真的相信那些话，还是只是在努力让自己相信？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"心里还憋着气，他想起\",\n          \"point\": \"有人曾把他当作自己人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"竟又高兴了一小会儿\"\n        },\n        {\n          \"text\": \"高兴才一会儿，他又心酸\",\n          \"point\": \"离开就一定会更好过吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"高兴才一会儿\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"这份坚定也可能是他努力想成为的样子，而不再是一个毫无疑问的事实。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"想成为的样子\"\n        },\n        {\n          \"quote\": \"不是记忆变坏了，而是它太好了——过去无法原样回来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是变坏，是太好了\"\n        },\n        {\n          \"quote\": \"像被时间催着往前跑，连身体都仿佛已经被这节奏逼得无法停下。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他真盼着彼此还能\",\n          \"point\": \"还能照从前那样继续\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"真盼着\"\n        },\n        {\n          \"text\": \"可他也想不出\",\n          \"point\": \"要是当初没走，如今会怎样\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可他也想不出\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"里面可以同时有愤怒、悲伤，也有想维护自己的那股劲。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍觉得自己不该忍\",\n          \"point\": \"不该忍那些委屈\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"从前开心的事也舍不得忘\"\n        },\n        {\n          \"text\": \"跟自己较劲到没力气\",\n          \"point\": \"离开那些人很难受\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"跟自己较劲到没力气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应