         \"waste\": \"\",\n          \"keep\": \"熟悉的亲近又让他欢喜\"\n        },\n        {\n          \"text\": \"他想把话全说出来\",\n          \"point\": \"怕让对方为难\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"也怕两人因此不自在\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"原来一直托着你的水波和摇晃，忽然像被抽掉了\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"一个人从“我与你”的亲密中抽身，转而跌回自己的内心\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份幸福是真实的吗？它能维持多久？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"前几次他都把话咽回去\",\n          \"point\": \"没藏住喜欢\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"前几次他都把话咽回去\"\n        },\n        {\n          \"text\": \"这下他心里空落落的\",\n          \"point\": \"不知道该怎么相处\",\n          \"where\": \"后\",\n          \"waste\": \"这下\",\n          \"keep\": \"也有些害怕\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"心里的每一个角落\"\n        },\n        {\n          \"quote\": \"独处把幽微的感受放大了\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"美好的时光仍在眼前流淌时，恍惚间却像已经成了回忆\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方看出了他的在乎\",\n          \"point\": \"没有因此疏远\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"他这才放松下来\"\n        },\n        {\n          \"text\": \"他怕要得太多\",\n          \"point\": \"舍不舍得这份亲近\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方没看出他不安\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"原先压着的感受反而变成了动力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它有一点情色性的暖意；越舒服，越让人失去方向\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"音乐并没有彻底变暗，美也没有消失；只是这一刻纵然完美，你也没有办法让它停住\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方总愿意跟他待着\",\n          \"point\": \"需要他的陪伴\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"他渐渐觉得\"\n        },\n        {\n          \"text\": \"想到能互相依靠\",\n          \"point\": \"盼着对方能想起他\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想到能互相依靠\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"没有哲学，没有防卫，没有分析\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连身体也像恢复了弹性，甚至带一点玩心\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正当你以为它还会继续唱下去，它却戛然而止\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"以为还会