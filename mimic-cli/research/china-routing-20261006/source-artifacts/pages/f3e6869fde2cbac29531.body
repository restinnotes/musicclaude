g","product_ace_pro2.meta.keywords":"","product_ace_pro2.asset.new_img_chip":"https://wassets.insta360.com/common/1fd2c6ba3de549379916e5961470ae25/SC.jpg","product_ace_pro2.specs.foot_note":"注：产品请以实物为准，不同生产批次/版本的产品在外观或规格可能存在差异，不影响产品功能及正常使用。\n\n自 2026 年 7 月起，本产品进行技术升级，本次升级包含以下内容：\n\n通过算法迭代及软件升级，麦克风数量由 3 个调整为 2 个。经测试验证，本次配置调整不影响产品功能及正常使用。产品实际表现可能因使用环境、使用方式及其他客观条件有所差异。\n\n产品配置切换期间，新旧版本将同时在售，订单根据实际库存随机发出，暂不支持指定版本。两版本的质保服务相同，具体配置与参数请以官方详情页为准。","product_ace_pro2.asset.acepro2_white_videography_bundles.banner_logo_src_pc":"https://wassets.insta360.com/common/139e74d10d094ea79a6c9cbd4626edc4/PC_Slogan_SC.svg","product_ace_pro2.asset.acepro2_white_videography_bundles.banner_logo_src_mo":"https://wassets.insta360.com/common/963596566a6a4d598fbff83e08a5255d/MO_Slogan_SC.svg","product_ace_pro2.asset.acepro2_white_videography_bundles.co_branded.videography_bundles_mo":"https://wassets.insta360.com/common/b6818559bd984a9ba43cb974f38cbb4e/MO_videography_bundles_SC.jpg","product_ace_pro2.asset.acepro2_white_videography_bundles.co_branded.xplorer_mo":"https://wassets.insta360.com/common/90df17a0c9274588b20a6ef30cf6ca21/MO_xplorer_SC.jpg","product_ace_pro2.asset.acepro2_white_videography_bundles.co_branded.mm93_mo":"https://wassets.insta360.com/common/d7d894c04d594ad4828801664d5299fe/MO_mm93_SC.jpg","product_ace_pro2.asset.acepro2_white_videography_bundles.co_branded.videography_bundles_pc":"https://wassets.insta360.com/common/bdbe1ff2532d4976afed2d5e51d91b05/PC_videography_bundles_SC.jpg","product_ace_pro2.asset.acepro2_white_videography_bundles.co_branded.xplorer_pc":"https://wassets.insta360.com/common/151d6cb06b374b13abb9097847fcb997/PC_xplorer_SC.jpg","product_ace_pro2.asset.acepro2_white_videography_bundles.co_branded.mm93_pc":"https://wassets.insta360.com/common/f5815c64cf72408babccf5578652c3b4/PC_mm93_SC.jpg","product_ace_pro2.asset.video_white_videography":"https://wassets.insta360.com/common/3ac3209f700844eaa5f999e71a0d2bac/Insta360_acepro2_White_Videography_1080P%20SC.mp4"