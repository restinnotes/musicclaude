{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还不知道在失落什么\"\n        },\n        {\n          \"quote\": \"像身体先于意识，隐约记起了该如何迈步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"记忆再清晰，过去也不会因此重新变成现在\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开以后，他起初总算\",\n          \"point\": \"不用再委屈自己了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初总算\"\n        },\n        {\n          \"text\": \"可他很快空落下来\",\n          \"point\": \"不知靠什么安心\",\n          \"where\": \"后\",\n          \"waste\": \"他\",\n          \"keep\": \"想往前走却\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"模糊地\"\n        },\n        {\n          \"quote\": \"第一次还有几分相信\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还信几分\"\n        },\n        {\n          \"quote\": \"不愿把自己完全交给悲伤\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不肯全交给悲伤\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"舍不得从前的自在\",\n          \"point\": \"一心软忘了为何离开\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一心软\"\n        },\n        {\n          \"text\": \"可他不甘心\",\n          \"point\": \"好日子也得丢掉\",\n          \"where\": \"后\",\n          \"waste\": \"他\",\n          \"keep\": \"难道连\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"温柔得让人心颤，也刺痛得让人绝望\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"也刺痛得绝望\"\n        },\n        {\n          \"quote\": \"那一刻的轻松可以是真的，并非假装；只是它没有替心里的事找到答案\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不像重新获得活力，更像前一段的昂扬正在慢慢退潮\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是恢复活力\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他还憋着气\",\n          \"point\": \"因想起旧日亲近而高兴片刻\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"还憋着气\"\n        },\n        {\n          \"text\": \"可那点高兴很快变酸\",\n          \"point\": \"日子真会更好吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"很快变酸\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"外在的步伐还在向前，里面却有了更多回声\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"外在步伐仍向前\"\n        },\n        {\n          \"quote\": \"不是记忆变坏了，而是它太好了——过去无法原样回来\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"原样\"\n        },\n        {\n          \"quote\": \"表面上动作越来越多，实际上并没有真正抵达哪里；不停地往前赶，只是为了避免停下来\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起从前亲近的日子\",\n          \"point\": \"还能那样相处\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一度\"\n        },\n        {\n          \"text\": \"可当初的委屈也翻上来\",\n          \"point\": \"走得对不对\",\n          \"where\": \"后\",\n          \"waste\": \"他\",\n          \"keep\": \"委屈也翻上来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"旋律几乎单独露出来，像脚下原有的地板忽然不见了，只剩一个声音自己说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"自己说话\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍觉得当初那些气不该忍\",\n          \"point\": \"当初那些气不该忍\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"却不敢多想\"\n        },\n        {\n          \"text\": \"跟自己争得没了力气\",\n          \"point\": \"只剩离开后的难受\",\n          \"where\": \"后\",\n          \"waste\": \"他\",\n          \"keep\": \"跟自己争得没了力气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"明知有些事已经挽不回，便放轻声音，好好看着它\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"难受慢慢缓下来\",\n          \"point\": \"没再