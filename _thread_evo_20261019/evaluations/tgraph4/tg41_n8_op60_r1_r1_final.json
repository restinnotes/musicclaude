{
 "center": "对亲密的投入与自我克制始终相互牵制。",
 "segments": [
  {
   "bars": "1–3",
   "relation": "还说不清",
   "items": [
    {
     "id": "I1",
     "text": "他还说不清自己究竟盼什么，只知道心里有一个格外想亲近的人。",
     "key": "心里有想亲近的人",
     "kind": "",
     "key_model": "说不清"
    },
    {
     "id": "I2",
     "text": "想到对方，他便不由自主地柔软，想让这份感觉多停留一会儿。",
     "key": "想让心中柔软多停留",
     "kind": "",
     "key_model": "多停留"
    },
    {
     "id": "I3",
     "text": "明明没有事需要他立刻决定，他却本能地收住喜欢，不明白自己为何这样谨慎。",
     "key": "本能地收住喜欢",
     "kind": "",
     "key_model": "本能地收住"
    },
    {
     "id": "I4",
     "text": "那点喜欢似乎随时都能放下，他却偏偏舍不得放下。",
     "key": "舍不得放下那点喜欢",
     "kind": "",
     "key_model": "舍不得放下"
    }
   ],
   "because": [],
   "relation_votes": {
    "还说不清": 6
   },
   "relation_model": "还说不清"
  },
  {
   "bars": "4–16",
   "relation": "没在想",
   "items": [
    {
     "id": "I5",
     "text": "因为还不知道自己怕什么，他决定先不替这份喜欢安排去向。",
     "key": "暂不安排喜欢的去向",
     "kind": "",
     "key_model": "安排去向"
    },
    {
     "id": "I6",
     "text": "他允许自己亲近对方，暂时不问两人会怎样，也不急着向对方期待什么。",
     "key": "亲近对方却不急问以后",
     "kind": "",
     "key_model": "暂时不问"
    },
    {
     "id": "I7",
     "text": "他能自由地给予温柔，无须时时确认对方是否领受，反而觉得亲近很自在。",
     "key": "自在地给予对方温柔",
     "kind": "分清",
     "key_model": "自由地给予"
    },
    {
     "id": "I8",
     "text": "他渐渐不再提防自己的喜欢，甚至为能够如此宽和而有些满意。",
     "key": "不再提防自己的喜欢",
     "kind": "",
     "key_model": "不再提防"
    },
    {
     "id": "I9",
     "text": "当时他觉得，若亲近能一直自然发生，不必追问计较，这样已经足够。",
     "key": "满足于自然发生的亲近",
     "kind": "",
     "key_model": "已经足够"
    }
   ],
   "because": [
    {
     "from": "I3",
     "to": "I5",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I4",
     "to": "I6",
     "rel": "唤起",
     "audit": "勉强"
    },
    {
     "from": "I2",
     "to": "I7",
     "rel": "唤起",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "没在想": 3,
    "正在面对": 2,
    "还说不清": 1
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "17–23",
   "relation": "正在面对",
   "items": [
    {
     "id": "I10",
     "text": "尝到这份亲近的幸福后，他开始希望喜欢能持续下去，不只属于眼前。",
     "key": "盼望喜欢持续下去",
     "kind": "满足照出未满足",
     "key_model": "持续下去"
    },
    {
     "id": "I11",
     "text": "一想到长久，他就意识到自己能决定怎样珍惜，却不能决定对方会不会同样珍惜。",
     "key": "明白珍惜不能强求",
     "kind": "分清",
     "key_model": "不能决定"
    },
    {
     "id": "I12",
     "text": "他偶尔忍不住想，自己在对方心里是否也有特别的位置，却还没打算索取什么。",
     "key": "想知自己是否也很特别",
     "kind": "",
     "key_model": "特别的位置"
    },
    {
     "id": "I13",
     "text": "这点期待原本不强烈，却已使他不如先前安稳，他对此有些意外。",
     "key": "期待打破原有安稳",
     "kind": "",
     "key_model": "不如先前安稳"
    }
   ],
   "because": [
    {
     "from": "I6",
     "to": "I12",
     "rel": "改写",
     "audit": "支持"
    },
    {
     "from": "I7",
     "to": "I13",
     "rel": "改写",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 5,
    "还说不清": 1
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "24–34",
   "relation": "正在面对",
   "items": [
    {
     "id": "I14",
     "text": "他怕新添的紧张损坏先前的快乐，也不愿让没作过承诺的对方感到催促。",
     "key": "怕紧张破坏先前快乐",
     "kind": "",
     "key_model": "感到催促"
    },
    {
     "id": "I15",
     "text": "他试着放宽心，觉得关心、给予和为对方高兴本来就有快乐，不必索取保证。",
     "key": "从关心给予中找到快乐",
     "kind": "",
     "key_model": "索取保证"
    },
    {
     "id": "I16",
     "text": "这样想让他确实轻松起来，想确认的紧张退去，反而更愿意付出。",
     "key": "放宽心后更愿付出",
     "kind": "",
     "key_model": "更愿意付出"
    },
    {
     "id": "I17",
     "text": "他不再衡量给出去多少，也不怕多给一点会显得自己更在乎。",
     "key": "不再衡量付出多少",
     "kind": "",
     "key_model": "多给一点"
    },
    {
     "id": "I18",
     "text": "毫不勉强的热切让他幸福，仿佛谨慎珍藏的温柔终于可以尽情给予。",
     "key": "尽情给予珍藏的温柔",
     "kind": "",
     "key_model": "尽情给予"
    },
    {
     "id": "I19",
     "text": "那一阵他甚至相信，只要不提出要求，就能尽情爱着，也不会失去什么。",
     "key": "以为不索求就不会失去",
     "kind": "",
     "key_model": "不会失去什么"
    }
   ],
   "because": [
    {
     "from": "I13",
     "to": "I14",
     "rel": "唤起",
     "audit": "支持"
    },
    {
     "from": "I11",
