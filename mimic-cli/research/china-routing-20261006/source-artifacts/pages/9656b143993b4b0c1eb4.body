<script type="text/javascript">
digitalData.page.pageInfo.pageTrack = "product detail";
digitalData.product.model_code = "MZ\u002DV9S2T0BW".replace(/&/g, ' and ').replace(/  /g,' ');
digitalData.product.displayName = "990 EVO Plus PCIe 4.0×4| 5.0×2 NVMe M.2 固态硬盘".replace(/(<([^>]+)>)/gi, "").replace(/&/g, ' and ').replace(/  /g,' ');
