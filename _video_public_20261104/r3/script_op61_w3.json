       ],
       "keys": []
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "我舍不得从前自在的日子，一想到以后不能再那样过就慌。",
