      "微许喜欢"
     ],
     "emotion": "不安",
     "from": [
      "S01-2"
     ],
     "at": 4.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "此等亲近，甜意已足",
       "bead": "S01-3",
       "from": [
        "S01-3"
       ],
       "bars": "",
       "at": 7.0
      },
      {
