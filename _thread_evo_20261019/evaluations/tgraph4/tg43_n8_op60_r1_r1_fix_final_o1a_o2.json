     "to": "R50",
     "rel": "提供理由",
     "audit": "支持",
     "old": [
      "N49",
      "N51"
     ]
    }
   ],
   "items_before_fix": [
    {
     "id": "I58",
     "text": "他不再遮掩渴望后，更清楚地感到自己多么想亲近这个人。",
     "key": "更清楚想要亲近",
     "kind": ""
    },
    {
     "id": "I59",
     "text": "他想把积攒的温柔都给对方，也想让珍贵的亲密不只停在自己的愿望里。",
     "key": "想把积攒温柔给出",
     "kind": "",
     "follows": true
    },
    {
     "id": "I60",
     "text": "他想被同样深切地珍惜，也想知道两人共同的幸福能有多丰盛。",
     "key": "想被同样深切珍惜",
     "kind": "",
     "follows": true
    },
    {
     "id": "I61",
     "text": "这些愿望曾让他紧张、难堪并不得不克制，如今仍在，却暂时不再折磨他。",
     "key": "愿望暂时不再折磨",
     "kind": "",
     "follows": true
    },
    {
     "id": "I62",
     "text": "他觉得自己有许多感情可以给予，也有许多值得珍惜的东西，仿佛无需再增加什么。",
     "key": "觉得已有许多可珍惜",
     "kind": "",
     "follows": true
    },
    {
     "id": "I63",
     "text": "那一刻，他仿佛觉得所有心愿都已得到抒发，尽管没有任何新的保证。",
     "key": "仿佛心愿同时抒发",
     "kind": "",
     "follows": true
    },
    {
     "id": "I64",
     "text": "他一时顾不上以后会怎样，只愿让这份幸福完整地留在此刻。",
     "key": "只愿幸福留在此刻",
     "kind": "",
     "follows": true
    }
   ],
