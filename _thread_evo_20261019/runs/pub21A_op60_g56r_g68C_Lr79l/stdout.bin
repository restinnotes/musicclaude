aste\": \"\",\n          \"keep\": \"上回没说的话\"\n        },\n        {\n          \"text\": \"他想把话全说出来\",\n          \"point\": \"怕对方为难\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"两人也会不自在\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"只剩下一条单薄、孤零零的旋律，在空中漫无目的地游走\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"一个人从“我与你”的亲密中抽身，转而跌回自己的内心\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份幸福是真实的吗？它能维持多久？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方一直没退开\",\n          \"point\": \"让对方看出他的在乎\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方一直没退开\"\n        },\n        {\n          \"text\": \"被看见以后\",\n          \"point\": \"不知怎么相处\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"被看见以后\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"左手的波浪变薄、碎成细密的小纹\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那份纯净像清凉、空灵的月光，又让人忽然想起童年，或年少时第一次心动的下午\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"心里的每个角落\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方看出了