 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "离开熟悉的生活后，他起初觉得总算不用再委屈自己。",
       "keys": [
        "离开熟悉的生活",
        "不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "背脊硬撑着挺直，心里却很想停下来",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "沉重的和弦像郑重宣告，随后却像烟雾向高处散开",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里很快空落下来。",
       "keys": [
        "笃定没撑多久",
        "空落下来"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "短句刚像叹息，长停顿便截断它，余音散在冷空气里",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "心里明明有东西，却分不清是愤怒、遗憾还是怀念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "刚从昏沉中醒来，四周冷而空，胸口发紧",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "伸出颤抖的手，摸到的却只有虚空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他仍想往前过，却不知道以后靠什么安下心。",
       "keys": [
        "仍想往前过",
        "靠什么安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日的声音、光线和熟悉感觉忽然都回来了",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "身体先于意识，隐约记起该怎样迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想到以后不能再自在地过日子，他心里有些慌。",
       "keys": [
        "不能再自在地过日子",
        "心里有些慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从远处传来的旧歌，依稀认得，却只能模糊哼几句",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "不像士兵整齐前进，更像腿脚虚浮的人挪动舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "一舍不得，他就提醒自己：当初为什么要走。",
       "keys": [
        "提醒自己",
        "为什么要走"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "一遍遍说“我没事”，越说越显得其实很在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可他不甘心，连从前的好日子也要一起丢掉吗？",
       "keys": [
        "不甘心",
        "好日子也要一起丢掉"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "连绵的音流把呼吸催得越来越急",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "那股激昂不是轻松恢复自信，更像不甘心就此消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起从前有人把他当作自己人，他竟高兴了一会儿。",
       "keys": [
        "当作自己人",
        "高兴了一会儿"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像故乡夏日的麦浪与微风，温柔得让人心颤",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可那点高兴很快变酸：离开以后，就一定更好过吗？",
       "keys": [
        "很快变酸",
        "一定更好过吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像许多人在耳边低声絮语，彼此缠绕，找不到出口",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起那些亲近的时候，他真盼一切还能照从前继续。",
       "keys": [
        "亲近的时候",
        "照从前继续"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日的亲密忽然鲜活，带回感激、柔情和短暂幸福",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可越是盼着，他越怀疑当初是否走错，却想不出没走会怎样。",
       "keys": [
        "怀疑当初是否走错",
        "想不出没走会怎样"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不是记忆变坏了，是它太好，才更刺痛",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "细碎的声音像急促脚步，心跳也乱了拍",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他仍觉得当初那些委屈不该忍，也不想抹掉快乐。",
       "keys": [
        "委屈不该忍",
        "不想抹掉快乐"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夜色里两个影子，彼此低声说话，亲近却克制",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "柔和的歌唱里，仍有“不能就这样算了”的劲",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "旧日记忆重新有了温度，眷恋里却带着失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可争得没了力气，那股不服气也渐渐淡了。",
       "keys": [
        "没了力气",
        "不服气也渐渐淡了"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "旋律几乎单独露出来，像脚下地板忽然不见",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "几次深呼吸般的叹息，紧绷才短暂松开",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "想到如今已不在那些人身边，他只觉得难受。",
       "keys": [
        "不在那些人身边",
        "只觉得难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不再拿受过的气，压住对从前的想念。",
       "keys": [
        "不再拿受过的气",
        "压住对从前的想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像隔着透明玻璃，连呼吸都不愿惊动这片安静",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "终于不用向别人解释，自己为什么难过",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "离开以后，难熬的事常常只能由他自己扛。",
       "keys": [
        "难熬的事",
        "自己扛"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想再过那种不用多说的亲近日子，又怕以后没有。",
       "keys": [
        "不用多说的亲近",
        "怕以后没有"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌唱慢慢展开，像终于鼓起勇气说出心里话",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "歌声更迫切，末尾却像停在一句没说完的话上",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "明知有些事挽不回，也只想放轻声音好好看着它",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "不过，那样的日子毕竟真真切切有过，想起也暖和。",
       "keys": [
        "真真切切有过",
        "想起也暖和"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "远方忽然被照亮，梦里看见已经远去的家园",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "离开后才知这么孤单，他怕以后还得独自扛难事。",
       "keys": [
        "这么孤单",
        "独自扛难事"
       ],
       "from": [
        "S07-1",
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "寒风猛地吹开窗，后颈一凉，脉搏骤然跳动",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "舞步忽然闯入，像换了场景，心里却没安定",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想找回从前的亲近，却不甘心回去再受那些气。",
       "keys": [
        "找回从前的亲近",
        "不甘心回去"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的动作和舞蹈，反而让失去更清楚",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      },
      {
       "text": "紧张一层层累积，思绪翻来覆去，想停也停不下",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "连当初离开时的那股决心，也已经找不着了。",
       "keys": [
        "那股决心",
        "找不着了"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他暂且放下回不回去，只让从前的亲近暖一会儿。",
       "keys": [
        "放下回不回去",
        "亲近暖一会儿"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像已经要离开，却忍不住回头再看一眼",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      },
      {
       "text": "胸口忽然吸进一口气，却只是短暂喘息",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可暖意很快淡了，回忆没法陪他熬过难事。",
       "keys": [
        "暖意很快淡了",
        "没法陪他熬过难事"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他忽然分不清，想回去是舍不得日子，还是想有人陪。",
       "keys": [
        "分不清",
        "想有人陪"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头沉重的引子从颤音光晕里阴冷地闪回",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "这个念头让他心慌，连往下想都不敢了。",
       "keys": [
        "心慌",
        "不敢了"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像重新遇见那个不知怎么办的自己",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他慢慢明白，最舍不得的是从前被当作自己人的日子。",
       "keys": [
        "最舍不得",
        "自己人的日子"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的声音轻轻浮现，却只剩断续的几块碎片",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可就算回去，还能像从前吗？那些委屈也不能抹掉。",
       "keys": [
        "就算回去",
        "委屈也不能抹掉"
       ],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "忽然失重，整个人悬在半空，辨不清方向",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他翻来覆去想得很累，眼下的日子也过得不踏实。",
       "keys": [
        "想得很累",
        "过得不踏实"
       ],
       "from": [
        "S10-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
