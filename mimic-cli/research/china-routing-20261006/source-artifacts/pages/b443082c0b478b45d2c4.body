<script type="text/babel">
    $(function () {
        /*
        let length = $('.hot_box ul li').length;


       for(var i=9;i<=length;i++){
           $('.hot_box ul li')[i].remove()
       }
        */

        let url = window.location.pathname

        window.Ele = 1;

        if (url === '/blog/') {
            $('.tag_list .container a')[0].style.color = '#000'
        }
        if (/\/*.\/([a-z-]+)\//g.test(url)) {
            $('.tag_list .container a').map((key, item) => {
                let text = item.innerHTML.toLowerCase()
                if (text.indexOf(' ') === -1) {
                    if (RegExp.$1 == item.innerHTML.toLowerCase()) {
                        item.style.color = '#000'
                    }
                } else {
                    if (RegExp.$1 === text.replace(' ', '-')) {
                        item.style.color = '#000'
                    }
                }
            })
        }

        $('.input_box .btn').on('click', function () {
            if (!$('.input_box input').val()) {
                $('.input_box input').focus()
                return
            }
            console.log('cccc-2')

            eventCollect({
      module: 'help_center',
      name: 'click',
      action: 'help_center_search',
      params: {
        keyword: $('.input_box input').val().toLowerCase(),
        ts: Math.floor(Date.now() / 1000)
      },
    });
            window.location.href = `/blog/search/?search_text=${$('.input_box input').val().toLowerCase()}`
        })
    })

    $('img').map((item, item2) => {
        if (!$(item2).attr('src').includes('https')) {
            $(item2).attr('src', $(item2).attr('src').replace(/http/g, 'https'))
        }
        if ($(item2).attr('srcset')) {
            if (!$(item2).attr('srcset').includes('https')) {
                $(item2).attr('srcset', $(item2).attr('srcset').replace(/http/g, 'https'))
            }
        }
    })

    $(".tag_item").click((e) => {
        if ($(e.target).attr('displayUrl') === '/tag/troubleshooting/') {
            localStorage.setItem('tags_name', 'troubleshooting')
            localStorage.setItem('main_tag', 'troubleshooting')
            location.href = "/tag/troubleshooting";
        }

        if ($(e.currentTarget).attr('data-value') === 'SHOPIFY' || $(e.currentTarget).attr('data-value') === 'WIX' || $(e.currentTarget).attr('data-value') === 'WOOCOMMERCE') {
            localStorage.setItem('main_tag', $(e.currentTarget).attr('data-value'))
            //$('#product-banner').css({"background-image": `url(./assets/${localStorage.getItem('main_tag')}.png)`});
        } else {
            localStorage.setItem('main_tag', 'SHOPIFY')
            //$('#product-banner').css({"background-image": `url(./assets/${localStorage.getItem('main_tag')}.png)`});
        }

        $(".category-skip").attr('href', `${$(e.currentTarget).attr('displayUrl')}`);
    })

    $("#account_tag").click(() => {
        window.localStorage.setItem('tags_name', 'account');
    })

    $("#orders_tag").click(() => {
