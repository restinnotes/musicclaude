 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他已经离开那段熟悉的生活",
       "keys": [
        "离开"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "起初他觉得，总算不用再委屈自己了",
       "keys": [
        "不用再委屈自己"
       ],
       "from": [
        "S01-1",
        "S01-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他提醒自己不能倒下，心里却很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可这份笃定没撑多久，心里就空落落的",
       "keys": [
        "空落落的"
       ],
       "from": [
        "S01-2",
        "S01-B2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他一时说不清自己到底舍不得什么",
       "keys": [
        "舍不得什么"
       ],
       "from": [
        "S01-2",
        "S01-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里明明堵着事，却分不清是气愤、遗憾还是想念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "像刚从昏沉里醒来，胸口发紧，伸手只摸到冰冷的虚空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "旧场景忽然清晰，声音和光线都熟悉，可过去回不来",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他想往前过，却不知道以后靠什么安心",
       "keys": [
        "靠什么安心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像身体先于意识，隐约记起该怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他舍不得从前那些自在的日子",
       "keys": [
        "自在的日子"
       ],
       "from": [
        "S02-1",
        "S02-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "珍惜的东西仿佛还在，却不能像从前那样拥有",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "想到以后不能再那样过，他心里发慌",
       "keys": [
        "不能再那样过"
       ],
       "from": [
        "S02-1",
        "S02-B1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他赶紧想起受过的气，提醒自己为什么离开",
       "keys": [
        "受过的气"
       ],
       "from": [
        "S02-2",
        "S02-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像整理好衣服、抬起头，不让人看出动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕一心软，就忘了当初为什么要走",
       "keys": [
        "为什么要走"
       ],
       "from": [
        "S02-2",
        "S02-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "第一次还信“我没事”，第二次努力信，第三次已露出在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "他心里仍难过，却不肯把自己完全交给悲伤",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "难道不想再受气，就得把好日子也丢掉吗？",
       "keys": [
        "好日子"
       ],
       "from": [
        "S02-3",
        "S02-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "也像在说：“我不甘心就这样消沉下去”",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他心里还憋着一股气",
       "keys": [
        "憋着一股气"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像暂时出去走走，轻松是真的，却没解开心结",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "可想起曾被人当作自己人，他又高兴了一小会儿",
       "keys": [
        "高兴了一小会儿"
       ],
       "from": [
        "S03-1",
        "S03-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像回到夏日麦浪和微风里，亲近得让人心颤",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "那点高兴还没退，他就为从前的日子回不去而心酸",
       "keys": [
        "回不去"
       ],
       "from": [
        "S03-2",
        "S03-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那份温柔太熟悉，可离眼前太远，反而刺痛",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "离开以后，日子就一定会更好过吗？",
       "keys": [
        "更好过吗"
       ],
       "from": [
        "S03-2",
        "S03-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "耳边像多人低声絮语，脚下却像踩着流沙",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "我刚才是真的相信那些话，还是只是在努力相信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他真盼着还能那样相处",
       "keys": [
        "还能那样相处"
       ],
       "from": [
        "S04-1",
        "S04-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "亲近里有感激和短暂幸福，心也因此软了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "原来的姿态还在，那份坚定却像他努力想成为的样子",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可当初那些委屈也跟着翻了上来",
       "keys": [
        "委屈"
       ],
       "from": [
        "S04-2",
        "S04-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "回忆太好反而刺痛，抵抗也显得疲惫仓促",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他反复问自己，当初那一步走对了吗？",
       "keys": [
        "走对了吗"
       ],
       "from": [
        "S04-2",
        "S04-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "脚步急得停不下来，心跳也像乱了拍",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "要是当初没走，如今又会是什么样？",
       "keys": [
        "又会是什么样"
       ],
       "from": [
        "S04-2",
        "S04-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "他不停地想“如果当时……”，像怕一停下来就要面对这一切",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他还是觉得，当初那些气真不该忍",
       "keys": [
        "不该忍"
       ],
       "from": [
        "S05-1",
        "S05-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里又气又难过，想护住自己：这事不能算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他连开心的回忆都不敢想，也太为难自己",
       "keys": [
        "开心的回忆"
       ],
       "from": [
        "S05-1",
        "S05-B3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他跟自己争得没了力气",
       "keys": [
        "没了力气"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "那股不服气慢慢淡了",
       "keys": [
        "慢慢淡了"
       ],
       "from": [
        "S05-2",
        "S05-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "几次深呼吸像松了口气，其实只是抵抗得累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "想到自己已不在那些人身边，他只觉得难受",
       "keys": [
        "不在那些人身边"
       ],
       "from": [
        "S05-2",
        "S05-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "想起的可能是某个人，也可能是故乡或从前的生活",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "旧日记忆重新有了温度，留恋里却带着失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "心里那阵难受慢慢缓下来，他没再压住想念",
       "keys": [
        "没再压住想念"
       ],
       "from": [
        "S06-1",
        "S06-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像隔着透明玻璃听母亲哼摇篮曲，现实没变好，安宁也留不住",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想起从前和人相处时，自己不必时时防备",
       "keys": [
        "不必时时防备"
       ],
       "from": [
        "S06-1",
        "S06-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不用再解释难过，也不用装坚强，压住的愿望、委屈和想念浮上来",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "如今身边少了那些人，他才知道有人陪着多轻松",
       "keys": [
        "有人陪着多轻松"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他很想再过那种不用多说也彼此亲近的日子",
       "keys": [
        "彼此亲近的日子"
       ],
       "from": [
        "S06-3",
        "S06-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像朝远方祈求，愿望很真，却不知会不会有回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "梦里的家园忽然亮起，他只能远远看着",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可他怕以后再也没有这样的亲近",
       "keys": [
        "再也没有"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "那样的日子他真真切切过过，想起时心里暖，只轻轻看着",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他刚有点安心，又想到以后遇上难事怎么办",
       "keys": [
        "遇上难事怎么办"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像寒风猛地吹开窗，后颈一凉，心跳骤然加快",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "沉静的思绪像被截断，换了场景，心里却没安定",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "要是还得一个人顶着，他真撑得住吗？",
       "keys": [
        "撑得住吗"
       ],
       "from": [
        "S07-1",
        "S07-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "事情表面像过去了，身体和心里却还在发颤，想冲出去又找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "当初离开时，他只想着别再受那些气",
       "keys": [
        "别再受那些气"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他没想到会这么孤单，早知道这样还会走吗？",
       "keys": [
        "还会走吗"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的动作和舞步突然闯进脑海，反而更看清失去了什么",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他想找回从前的亲近，却不甘心回去受气",
       "keys": [
        "不甘心回去受气"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "连当初离开时那股决心，如今也找不着了",
       "keys": [],
       "from": [
        "S07-3"
       ],
       "bead": "S07-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他先把回去的事放一边",
