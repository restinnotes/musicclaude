{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"落下来以后，却还没有真正落稳\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近对方\",\n          \"point\": \"很想靠近对方\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"连自己都没想到\"\n        },\n        {\n          \"text\": \"他只敢露出一点喜欢\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"怕对方看出自己有多需要这份亲近\"\n        },\n        {\n          \"text\": \"只靠近这一点他就觉得甜\",\n          \"point\": \"拿不准下次能不能更坦白\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只靠近这一点他就觉得甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"肩膀挨着肩膀，连呼吸都贴在一起，体温也仿佛融在了一处。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"连呼吸、体温也贴近\"\n        },\n        {\n          \"quote\": \"水却一直在流，时间也一直在走。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它没有继续冲向高潮，而像轻轻呼出一口气，重新回到柔和。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\":