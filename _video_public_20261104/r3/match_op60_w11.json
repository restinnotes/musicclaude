   "lost": ""
  },
  {
   "id": "S06-0-0",
   "a": "偏了",
   "b": "对上",
   "lost": "甲把摇摆重新出现归因于对方恢复亲近，原稿重点是熟悉的摇荡感以更轻、更细碎的状态回来。"
  },
  {
   "id": "S06-0-1",
   "a": "对上",
   "b": "对上",
   "lost": ""
