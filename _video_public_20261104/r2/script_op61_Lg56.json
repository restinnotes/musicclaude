       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "故乡夏日的麦浪",
       "keys": [],
       "from": [
        "S03-B2-p2"
       ]
      },
      {
       "text": "温柔得让人心颤",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ]
      },
      {
       "text": "心里一悬",
       "keys": [],
       "from": [
        "S03-B1-p2"
       ]
      },
      {
       "text": "低声絮语 找不到出口",
       "keys": [],
       "from": [
        "S03-B3-p1"
       ]
      },
      {
       "text": "越怀念越觉得远",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ]
      },
      {
       "text": "想往前却拿不定方向",
       "keys": [],
       "from": [
        "S03-B1-p3"
       ]
      },
      {
       "text": "出去走走透口气",
       "keys": [],
       "from": [
        "S03-B4-p1"
       ]
      },
      {
       "text": "刚才真的相信了吗？",
       "keys": [],
       "from": [
        "S03-B5-p2"
       ]
      },
      {
       "text": "轻松过后还是心酸",
       "keys": [],
       "from": [
        "S03-B4-p2",
        "S03-B4-p3"
       ]
      },
      {
       "text": "愤怒与抗拒",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "焦躁急切",
       "keys": [],
       "from": [
        "S03-B2-p1"
       ]
      },
      {
       "text": "轻松亲近",
       "keys": [],
       "from": [
        "S03-B2-p3"
       ]
      },
      {
       "text": "刺痛得让人绝望",
