 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "离开熟悉的生活，终于不用再委屈自己",
       "keys": [
        "离开熟悉的生活",
        "不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像强撑着挺直背脊：我不能倒下，却想停一停",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "笃定没撑多久，心里空了却说不清舍不得什么",
       "keys": [
        "笃定没撑多久",
        "舍不得什么"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "短句像叹息，刚冒出就被长停顿截断",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "像刚从昏沉里醒来，胸口发紧，视线模糊",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "还想往前过，却不知怎样让自己安心",
       "keys": [
        "还想往前过",
        "让自己安心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧场景忽然清晰，身体也隐约记起怎样迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "想到以后不能再那样自在，他心里发慌",
       "keys": [
        "不能再那样自在",
        "心里发慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从远处传来的旧歌，记得却哼不完整",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "腿脚发虚，却还在挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "一舍不得，他就提醒自己受过的气，别忘了为何离开",
       "keys": [
        "提醒自己受过的气",
        "为何离开"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像把衣服理整齐，硬撑着说我没事",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他不甘心，难道连以前的好日子也要丢掉？",
       "keys": [
        "不甘心",
        "好日子也要丢掉"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "我不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "憋着气想起曾被当自己人，刚高兴又问离开后会更好吗？",
       "keys": [
        "憋着气",
        "离开后会更好吗"
       ],
       "from": [
        "S03-1",
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像暂时绕开沉重的问题，轻松是真的，却没答案",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "昂扬慢慢退去，像又在问：刚才真相信了吗",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起那段亲近，他真盼着还能那样相处",
       "keys": [
        "真盼着",
        "那样相处"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的旋律又回来，像在独自说话",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "一想起那份亲近，旧委屈就翻上来：走对了吗？没走呢？",
       "keys": [
        "旧委屈就翻上来",
        "走对了吗"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "记忆太美好，反倒刺得心里发疼",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "觉得当初那些气不该忍，却不敢多想好事",
       "keys": [
        "那些气不该忍",
        "不敢多想好事"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两只手像夜色里的影子，彼此低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "这事不能就这样算了，还想替自己争口气",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "争得没了力气，想到如今不在他们身边，只剩难受",
       "keys": [
        "争得没了力气",
        "只剩难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日记忆又有温度，眷恋里仍带着失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "难受缓下来，他终于肯想念那段亲近",
       "keys": [
        "难受缓下来",
        "终于肯想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像隔着透明玻璃罩，连呼吸都不敢惊动",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "像终于不用装坚强，向远方轻声祈求，却没人保证会有回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "如今遇事只能独自扛，才知有人在身边多轻松",
       "keys": [
        "只能独自扛",
        "多轻松"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音慢慢舒展开来，像终于鼓起勇气说心里话",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "还想再有亲近，又怕再也没有，想起曾真切拥有心里暖一点",
       "keys": [
        "怕再也没有",
        "心里暖一点"
       ],
       "from": [
        "S06-3",
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "放轻声音，好好看着珍惜的东西，不急着抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "想到以后遇事还得独自扛，他真撑得住吗？",
