{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"自由上行琶音却没把这份重量接住\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"却没接住重量\"\n        },\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"过去也不会因此重新变成现在\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"记忆清晰，过去仍回不来\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开熟悉的生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"总算\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"不知如何安顿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想往前走又不知如何安顿\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"副词\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"第一次还有几分相信，第二次开始努力让自己相信\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"第一遍还有几分相信，第二遍才硬让自己信\"\n        },\n        {\n          \"quote\": \"连反复说这句话本身都暴露出：其实还是很在意\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"反复说这句话，本身就露出在意\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到以后再没有\",\n          \"point\": \"心慌\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想到以后再没有那样的日子\"\n        },\n        {\n          \"text\": \"他提醒自己受过\",\