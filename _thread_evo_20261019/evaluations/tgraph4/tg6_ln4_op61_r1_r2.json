     "rel": "动摇",
     "how": "曾推动他抗拒的怒气暂时退到心后。"
    }
   ]
  },
  {
   "bars": "181–205",
   "relation": "正在面对",
   "items": [
    {
     "id": "I75",
     "text": "刚才的满足使眼下的空缺渐渐清楚。",
     "key": "眼下的空缺",
     "kind": "满足照出未满足"
    },
    {
     "id": "I76",
     "text": "如今他仍想亲近别人。",
     "key": "仍想亲近别人",
     "kind": ""
    },
    {
     "id": "I77",
     "text": "可他无法再像从前那样毫无顾虑。",
     "key": "毫无顾虑",
     "kind": ""
    },
    {
     "id": "I78",
     "text": "旧日的美好感受还留在心里。",
     "key": "还留在心里",
     "kind": ""
    },
    {
     "id": "I79",
     "text": "他如今没有地方可以安心付出和接受。",
     "key": "没有地方",
     "kind": ""
    },
    {
     "id": "I80",
     "text": "他尤其怀念那个不用处处保护自己的自己。",
     "key": "不用处处保护",
     "kind": ""
    },
    {
     "id": "I81",
     "text": "如今的孤单开始令他难以承受。",
     "key": "如今的孤单",
     "kind": "知道更多反而更尖锐"
    },
    {
     "id": "I82",
     "text": "回忆仍能给他温暖。",
     "key": "给他温暖",
     "kind": ""
    },
    {
     "id": "I83",
     "text": "这温暖却不能让旧日生活回来。",
     "key": "旧日生活回来",
     "kind": "办法的限度"
    },
    {
     "id": "I84",
     "text": "温暖里添了沉甸甸的无奈。",
     "key": "沉甸甸的无奈",
     "kind": ""
    },
    {
     "id": "I85",
     "text": "他舍不得结束那份满足。",
     "key": "舍不得结束",
     "kind": ""
    },
    {
     "id": "I86",
     "text": "他无法再忘记自己已失去它。",
     "key": "无法再忘记",
     "kind": ""
    }
   ],
