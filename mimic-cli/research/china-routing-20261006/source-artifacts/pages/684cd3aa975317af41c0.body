			})(window, document, 'script', 'dataLayer', 'GTM-WX4RFM');</script> <!-- End Google Tag Manager --> <meta property="og:title" content="Auto Care - Joint E-commerce Trends and Outlook Forecast Report" /><meta property="og:description" content="This report provides insights into how e-commerce may impact your business." /><meta property="og:image" content="https://www.autocare.org/images/default-source/market-research/2023-joint-ev-study-tizra-tile-600x460.png?sfvrsn=abc4274a_2" /><meta property="og:url" content="https://www.autocare.org/data-and-information/market-research/joint-e-commerce-trends-and-outlook-forecast" /><meta property="og:type" content="website" /><meta property="og:site_name" content="Auto Care" /><script type="text/javascript">
/*
  Testimonials carousel — pairs with Testimonials-AutoCareMain.css.
  Add once per page (Sitefinity JavaScript widget, head or bottom).
  Enhances every <section data-ac-testimonials>: arrows, page dots,
  initials avatars and "Read more" toggles for clamped quotes.
*/
(function () {
  var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function init(root) {
    if (root.getAttribute("data-ac-testimonials-ready")) return;

    var viewport = root.querySelector(".ac-testimonials__viewport");
    var slides = root.querySelectorAll(".ac-testimonials__slide");
    var controls = root.querySelector(".ac-testimonials__controls");
    var prevBtn = root.querySelector("[data-ac-testimonials-prev]");
    var nextBtn = root.querySelector("[data-ac-testimonials-next]");
    var dotsWrap = root.querySelector(".ac-testimonials__dots");
    if (!viewport || !slides.length || !controls || !prevBtn || !nextBtn || !dotsWrap) return;

    root.setAttribute("data-ac-testimonials-ready", "1");

    function perView() {
      var w = slides[0].getBoundingClientRect().width;
      return w ? Math.max(1, Math.floor((viewport.clientWidth + 4) / w)) : 1;
    }

    function offsetOf(i) {
      return slides[i].offsetLeft - slides[0].offsetLeft;
    }

    function currentIndex() {
      var best = 0;
      var bestDist = Infinity;
      for (var i = 0; i < slides.length; i++) {
        var d = Math.abs(offsetOf(i) - viewport.scrollLeft);
        if (d < bestDist) { bestDist = d; best = i; }
      }
      return best;
    }

    function atEnd() {
      return viewport.scrollLeft >= viewport.scrollWidth - viewport.clientWidth - 2;
    }

    function goTo(i) {
      i = Math.max(0, Math.min(slides.length - 1, i));
      viewport.scrollTo({ left: offsetOf(i), behavior: reduceMotion.matches ? "auto" : "smooth" });
    }

    var dotCount = 0;
    function buildDots() {
      var pages = Math.ceil(slides.length / perView());
      if (pages === dotCount) return;
      dotCount = pages;
      dotsWrap.innerHTML = "";
      for (var p = 0; p < pages; p++) {
        var dot = document.createElement("button");
        dot.type = "button";
        dot.className = "ac-testimonials__dot";
        dot.setAttribute("aria-label", "Show testimonials page " + (p + 1) + " of " + pages);
        dot.addEventListener("click", (function (page) {
          return function () { goTo(page * perView()); };
        })(p));
        dotsWrap.appendChild(dot);
      }
      dotsWrap.hidden = pages < 2;
      controls.hidden = pages < 2;
    }

    function update() {
      var page = atEnd() ? dotCount - 1 : Math.floor(currentIndex() / perView());
      var dots = dotsWrap.children;
      for (var d = 0; d < dots.length; d++) {
        if (d === page) dots[d].setAttribute("aria-current", "true");
        else dots[d].removeAttribute("aria-current");
      }
      prevBtn.disabled = viewport.scrollLeft <= 2;
      nextBtn.disabled = atEnd();
    }

    function setupReadMore() {
      var cards = root.querySelectorAll(".ac-testimonials__card");
      Array.prototype.forEach.call(cards, function (card) {
        var quote = card.querySelector(".ac-testimonials__quote");
        var text = quote && quote.querySelector("p");
        if (!text) return;
        var btn = card.querySelector(".ac-testimonials__more");
        if (!btn) {
          btn = document.createElement("button");
          btn.type = "button";
          btn.className = "ac-testimonials__more";
          btn.textContent = "Read more";
          btn.setAttribute("aria-expanded", "false");
          btn.addEventListener("click", function () {
            var open = card.classList.toggle("is-expanded");
            btn.textContent = open ? "Show less" : "Read more";
            btn.setAttribute("aria-expanded", open ? "true" : "false");
          });
          quote.parentNode.insertBefore(btn, quote.nextSibling);
        }
        if (card.classList.contains("is-expanded")) return;
        btn.hidden = text.scrollHeight <= text.clientHeight + 1;
      });
    }

    function setupAvatars() {
      var cites = root.querySelectorAll(".ac-testimonials__cite");
      Array.prototype.forEach.call(cites, function (cite) {
        if (cite.querySelector(".ac-testimonials__avatar")) return;
        var name = cite.querySelector(".ac-testimonials__name");
        var words = name ? name.textContent.trim().split(/\s+/) : [];
        if (!words.length) return;
        var initials = words[0].charAt(0);
        if (words.length > 1) initials += words[words.length - 1].charAt(0);
        var avatar = document.createElement("span");
        avatar.className = "ac-testimonials__avatar";
        avatar.setAttribute("aria-hidden", "true");
        avatar.textContent = initials.toUpperCase();
        cite.insertBefore(avatar, cite.firstChild);
      });
    }

    prevBtn.addEventListener("click", function () { goTo(currentIndex() - perView()); });
    nextBtn.addEventListener("click", function () { goTo(currentIndex() + perView()); });

    var ticking = false;
    viewport.addEventListener("scroll", function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () { ticking = false; update(); });
    }, { passive: true });

    var resizeTimer;
    window.addEventListener("resize", function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        viewport.scrollTo({ left: offsetOf(currentIndex()), behavior: "auto" });
        buildDots();
        setupReadMore();
        update();
      }, 150);
    });

    setupAvatars();
    buildDots();
    setupReadMore();
    update();
  }

  function initAll() {
    Array.prototype.forEach.call(document.querySelectorAll("[data-ac-testimonials]"), init);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll);
  } else {
    initAll();
  }
})();

</script><link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&amp;display=swap" media="all" rel="stylesheet" type="text/css" /><meta name="Generator" content="Sitefinity 15.0.8234.0 DX" /><link rel="canonical" href="https://www.autocare.org/data-and-information/market-research/joint-e-commerce-trends-and-outlook-forecast" /><!-- Start of HubSpot Embed Code -->
