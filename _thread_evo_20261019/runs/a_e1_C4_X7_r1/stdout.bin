{"completed": true, "response": "```json\n{\n  \"segments\": [\n    {\n      \"segment\": \"S01\",\n      \"links\": [\n        {\n          \"thread_quote\": \"开头的和弦骤然亮起，像一句话已经冲到唇边。\",\n          \"bead\": \"S01/B1\",\n          \"bead_quote\": \"开头那两下响亮的和弦，有一点突然。\",\n          \"type\": \"承接\",\n          \"note\": \"将突发的声响转成即将出口的表达冲动，建立开场的悬置感。\"\n        },\n        {\n          \"thread_quote\": \"也知道说出口可能改变关系，才不敢顺势说完。\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"有些话一旦说出来，关系就会改变\",\n          \"type\": \"承接\",\n          \"note\": \"明确说明谨慎来自对表达后果的预知，而非不知道自己想说什么。\"\n        },\n        {\n          \"thread_quote\": \"声音渐渐散去，心意仍悬在那里\",\n          \"bead\": \"S01/B1\",\n          \"bead_quote\": \"落下来以后，却还没有真正落稳\",\n          \"type\": \"承接\",\n          \"note\": \"声音消散却没有真正落定，将烟花余光般的悬置感保留下来。\"\n        },\n        {\n          \"thread_quote\": \"心意仍悬在那里\",\n          \"bead\": \"S14/B4\",\n          \"bead_quote\": \"接住开头悬着的话，终于把它说完\",\n          \"type\": \"铺垫\",\n          \"note\": \"开头未落定的心意成为终段重新接续并完成表达的对象。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [\n        \"S01/B3\"\n      ],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S02\",\n      \"links\": [\n        {\n          \"thread_quote\": \"水波托住身体，两条歌声贴近，终于有了低声倾诉的余地。\",\n          \"bead\": \"S02/B1\",\n          \"bead_quote\": \"两个紧挨在一起的人耳语\",\n          \"type\": \"承接\",\n          \"note\": \"开头的悬置过后，贴近的歌声终于建立了亲密而不紧张的低语状态。\"\n        },\n        {\n          \"thread_quote\": \"水波托住身体\",\n          \"bead\": \"S02/B2\",\n          \"bead_quote\": \"把身体交给船底温柔的托举\",\n          \"type\": \"承接\",\n          \"note\": \"身体被托举的感觉对应此段重新建立的摇荡与支撑。\"\n        },\n        {\n          \"thread_quote\": \"水波托住身体\",\n          \"bead\": \"S01/B3\",\n          \"bead_quote\": \"刚刚踏上船板的感觉\",\n          \"type\": \"回指\",\n          \"note\": \"开头刚踏上船板时尚未安稳的身体感，在这里发展成被水波托住的状态。\"\n        },\n        {\n          \"thread_quote\": \"情意短暂上涌，又在渐弱中收住\