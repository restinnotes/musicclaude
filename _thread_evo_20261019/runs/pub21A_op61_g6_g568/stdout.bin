{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"强迫自己挺直背脊\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"强迫自己\"\n        },\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还说不清\"\n        },\n        {\n          \"quote\": \"身体先于意识，隐约记起了该如何迈步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"身体先于意识\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开了熟悉的日子\",\n          \"point\": \"不用再受委屈\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"以为\"\n        },\n        {\n          \"text\": \"可心里忽然空了\",\n          \"point\": \"没法安心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想往前过却\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"细碎、不安的半音在蠕动\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连反复说这句话本身都暴露出\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越说越露怯\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他越想从前的好日子\",\n          \"point\": \"越怕忘了受过的气\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"越想从前的好日子，越怕\"\n        },\n        {\n          \"text\": \"可他还是不甘心\",\n          \"point\": \"连从前的好也得丢\",\n         