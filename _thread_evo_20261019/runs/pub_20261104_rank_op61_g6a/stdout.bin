{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"groups\": [\n        {\n          \"label\": \"重和弦落下，琶音随即散开悬空\",\n          \"points\": [\"S01-B1-p1\", \"S01-B1-p2\"]\n        },\n        {\n          \"label\": \"短促叹息与说不清的失落\",\n          \"points\": [\"S01-B3-p3\", \"S01-B3-p1\", \"S01-B3-p2\"]\n        },\n        {\n          \"label\": \"挺直姿态很快滑回内心游移\",\n          \"points\": [\"S01-B2-p3\", \"S01-B2-p1\", \"S01-B2-p2\"]\n        },\n        {\n          \"label\": \"冷空、恍惚、伸手落空的身体感\",\n          \"points\": [\"S01-B4-p3\", \"S01-B4-p1\", \"S01-B4-p2\"]\n        },\n        {\n          \"label\": \"旧场景闪回，却不能重新拥有\",\n          \"points\": [\"S01-B5-p2\", \"S01-B5-p1\"]\n        },\n        {\n          \"label\": \"波兰舞曲步态逐渐浮现\",\n          \"points\": [\"S01-B5-p3\", \"S01-B5-p4\"]\n        }\n      ],\n      \"tier_a\": [\"S01-B1-p1\", \"S01-B3-p3\"],\n      \"tier_b\": [\n        \"S01-B2-p3\",\n        \"S01-B3-p1\",\n        \"S01-B4-p3\",\n        \"S01-B5-p2\",\n        \"S01-B5-p3\"\n      ],\n      \"only_one\": \"S01-B1-p1\",\n      \"line_order\": [\"S01-2\", \"S01-1\", \"S01-3\"],\n      \"line_a\": [\"S01-1\", \"S01-2\"]\n    },\n    {\n      \"sec\": \"S02\",\n      \"groups\": [\n        {\n          \"label\": \"远处传来的旧歌，珍惜却无法重拥\",\n          \"points\": [\"S02-B1-p2\", \"S02-B1-p4\", \"S02-B1-p1\", \"S02-B2-p1\"]\n        },\n        {\n          \"label\": \"庄严节奏与脆弱旋律的反差\",\n          \"points\": [\"S02-B2-p2\", \"S02-B2-p3\", \"S02-B1-p3\"]\n        },\n        {\n          \"label\": \"挺直外表下反复进行自我控制\",\n          \"points\": [\"S02-B4-p3\", \"S02-B4-p4\", \"S02-B4-p1\", \"S02-B4-p2\"]\n        },\n        {\n          \"label\": \"力量反复聚起，却始终不能安稳落地\",\n          \"points\": [\"S02-B3-p2\", \"S02-B3-p3\", \"S02-B3-p1\"]\n        },\n        {\n          \"label\": \"不甘心就此消亡的负隅顽抗\",\n          \"points\": [\"S02-B5-p1\", \"S02-B5-p2\"]\n        }\n      ],\n      \"tier_a\": [\"S02-B1-p2\", \"