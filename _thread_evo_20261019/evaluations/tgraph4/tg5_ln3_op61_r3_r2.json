     "kind": ""
    },
    {
     "id": "I71",
     "text": "他也不愿为表面的安稳藏起痛苦。",
     "key": "藏起痛苦",
     "kind": ""
    },
    {
     "id": "I72",
     "text": "他仍为坚持骄傲，却不再觉得无所不能。",
     "key": "无所不能",
     "kind": ""
