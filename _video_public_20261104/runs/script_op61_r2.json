{
 "phases": [
  {
   "label": "离开后的失重",
   "sections": [
    "S01",
    "S02"
   ]
  },
  {
   "label": "旧日亲近回潮",
   "sections": [
    "S03",
    "S04",
    "S05"
   ]
  },
  {
   "label": "短暂安宁与惊醒",
   "sections": [
    "S06",
    "S07",
    "S08"
   ]
  },
  {
   "label": "回头仍无答案",
   "sections": [
    "S09",
    "S10"
   ]
  },
  {
   "label": "害怕中重新迈步",
   "sections": [
    "S11",
    "S12"
   ]
  },
  {
   "label": "带着记忆向前",
   "sections": [
    "S13"
   ]
  }
 ],
 "sections": [
  {
   "sec": "S01",
   "beats": [
    {
     "beads": [
      {
       "text": "开头和弦沉重而郑重",
       "from": [
        "S01-B1-p1"
       ]
      },
      {
       "text": "上行琶音没接住重量，轻远地悬在半空",
       "from": [
        "S01-B1-p1"
       ]
      },
      {
       "text": "停顿里还等着回声",
       "from": [
        "S01-B1-p2"
       ]
      }
     ],
     "line": {
      "text": "他离开熟悉的生活，起初觉得不用再委屈自己。",
      "key": "不用再委屈自己",
      "from": [
       "S01-1"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "短句刚冒出，就被长停顿截断",
       "from": [
        "S01-B3-p1"
       ]
      },
      {
       "text": "余音在冷空气里慢慢散尽",
       "from": [
        "S01-B3-p2"
       ]
      },
      {
       "text": "分不清是愤怒、遗憾还是怀念",
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "失落还没找到对象，也没找到语言",
       "from": [
        "S01-B3-p3"
       ]
      }
     ],
     "line": {
      "text": "他刚有的笃定很快散了，连舍不得什么也说不清。",
      "key": "舍不得什么也说不清",
      "from": [
       "S01-2"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "旧日场景忽然回来，声音光线也清晰",
       "from": [
        "S01-B5-p1"
       ]
      },
      {
       "text": "记忆再清晰，过去也不会变回现在",
       "from": [
        "S01-B5-p2"
       ]
      },
      {
       "text": "波兰舞曲步态渐渐浮现",
       "from": [
        "S01-B5-p3"
       ]
      },
      {
       "text": "向前的牵引还没真正站稳",
       "from": [
        "S01-B5-p4"
       ]
      }
     ],
     "line": {
      "text": "他还想往前过，却不知道以后靠什么安下心。",
      "key": "靠什么安下心",
      "from": [
       "S01-3"
      ]
     }
    }
   ]
  },
  {
   "sec": "S02",
   "beats": [
    {
     "beads": [
      {
       "text": "波兰舞曲步态终于清楚，却不像凯旋",
       "from": [
        "S02-B1-p1"
       ]
      },
      {
       "text": "主旋律像远处旧歌，只能模糊哼几句",
       "from": [
        "S02-B1-p2"
       ]
      },
      {
       "text": "珍惜的东西仿佛还在，却不能照旧拥有",
       "from": [
        "S02-B1-p4"
       ]
      }
     ],
     "line": {
      "text": "他舍不得从前的自在，想到以后不能那样过就心慌。",
      "key": "不能那样过",
      "from": [
       "S02-1"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "腿脚虚浮，像在记忆里挪动舞步",
       "from": [
        "S02-B2-p1"
       ]
      },
      {
       "text": "节奏庄严傲慢，旋律却脆弱凄婉",
       "from": [
        "S02-B2-p2"
       ]
      },
      {
       "text": "伴奏底下细碎半音不安地蠕动",
       "from": [
        "S02-B2-p3"
       ]
      }
     ],
     "line": {
      "text": "他怕一心软就忘了为何离开，便想起受过的难堪。",
      "key": "受过的难堪",
      "from": [
       "S02-2"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "音乐猛地往上推，又退了下来",
       "from": [
        "S02-B3-p1"
       ]
      },
      {
       "text": "力量再次聚拢，最后仍没落稳",
       "from": [
        "S02-B3-p2"
       ]
      },
      {
       "text": "反复说自己没事，越说越显得在意",
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "三连音催得呼吸越来越急",
       "from": [
        "S02-B3-p3"
       ]
      }
     ],
     "line": {
      "text": "可他不甘心，难道连以前的好日子也得丢掉？",
      "key": "好日子也得丢掉",
      "from": [
       "S02-3"
      ]
     }
    }
   ]
  },
  {
   "sec": "S03",
   "beats": [
    {
     "beads": [
      {
       "text": "和弦重重砸下，带着愤怒和抗拒",
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "忽强忽弱、切分节奏让人心里一悬",
       "from": [
        "S03-B1-p2"
       ]
      }
     ],
     "line": {
      "text": "他还憋着气，却想起从前被当作自己人时的高兴。",
      "key": "当作自己人",
      "from": [
       "S03-1"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "前半焦躁，后半忽然柔和亲切",
       "from": [
        "S03-B2-p1"
       ]
      },
      {
       "text": "越怀念，越能感到它离眼前很远",
       "from": [
        "S03-B2-p4"
       ]
      }
     ],
     "line": {
      "text": "可那点高兴很快变成刺痛，他已不能照旧过日子。",
      "key": "变成刺痛",
      "from": [
       "S03-2"
      ]
     }
    }
   ]
  },
  {
   "sec": "S04",
   "beats": [
    {
     "beads": [
      {
       "text": "波兰舞曲主题回来，旋律更抒情",
       "from": [
        "S04-B1-p1"
       ]
      },
      {
       "text": "旧记忆带来感激、亲密和短暂幸福",
       "from": [
        "S04-B1-p2"
       ]
      }
     ],
     "line": {
      "text": "他一度真盼着，那些亲近的日子还能接着过。",
      "key": "还能接着过",
      "from": [
       "S04-1"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "温暖没持续，音乐忽然激烈而紧绷",
       "from": [
        "S04-B2-p1"
       ]
      },
      {
       "text": "过去太好，回想反而刺痛",
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "半音阶下行带着步步后退的力量",
       "from": [
        "S04-B2-p3"
       ]
      }
     ],
     "line": {
      "text": "没走的话日子会怎样，他说不准自己后不后悔。",
      "key": "后不后悔",
      "from": [
       "S04-2"
      ]
     }
    }
   ]
  },
  {
   "sec": "S05",
   "beats": [
    {
     "beads": [
      {
       "text": "歌唱变得柔和亲近，却仍克制",
       "from": [
        "S05-B1-p1"
       ]
      },
      {
       "text": "柔和歌唱仍被压力推着向前",
       "from": [
        "S05-B2-p1"
       ]
      },
      {
       "text": "两只手像在夜色里低声说话",
       "from": [
        "S05-B1-p2"
       ]
      },
      {
       "text": "里面有愤怒、悲伤和维护自己的劲",
       "from": [
        "S05-B2-p2"
       ]
      }
     ],
     "line": {
      "text": "他还是不服气，可连开心的旧事都不敢想，实在太委屈自己。",
      "key": "太委屈自己",
      "from": [
       "S05-1"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "快速音型渐渐放缓、变稀",
       "from": [
        "S05-B4-p1"
       ]
      },
      {
       "text": "旋律几乎单独露出来",
       "from": [
        "S05-B4-p2"
       ]
      },
      {
       "text": "躁动和不安又加深",
       "from": [
        "S05-B5-p1"
       ]
      },
      {
       "text": "声音稀疏了，心里未必平静，只是抵抗累了",
       "from": [
        "S05-B5-p2",
        "S05-B5-p3"
       ]
      }
     ],
     "line": {
      "text": "他想得没了力气，想到曾在身边的人如今不在，心里难受。",
      "key": "心里难受",
      "from": [
       "S05-2"
      ]
     }
    }
   ]
  },
  {
   "sec": "S06",
   "beats": [
    {
     "beads": [
      {
       "text": "音乐忽然滑进与此前世界隔开的静谧",
       "from": [
        "S06-B1-p1"
       ]
      },
      {
       "text": "声音绵长从容，近乎停驻",
       "from": [
        "S06-B1-p2"
       ]
      },
      {
       "text": "旋律起初含蓄、试探",
       "from": [
        "S06-B3-p1"
       ]
      }
     ],
     "line": {
      "text": "他想起从前不必时时防备的日子，没有急着打断回忆。",
      "key": "不必时时防备",
      "from": [
       "S06-1"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "歌唱逐渐展开，像终于说出心里话",
       "from": [
        "S06-B3-p1"
       ]
      },
      {
       "text": "压住的愿望、委屈和思念浮现",
       "from": [
        "S06-B2-p3"
       ]
      },
      {
       "text": "歌唱像向远方祈求，却没有回应保证",
       "from": [
        "S06-B2-p4"
       ]
      },
      {
       "text": "远方忽然被照亮，梦里显出远去的家园",
       "from": [
        "S06-B2-p5"
       ]
      }
     ],
     "line": {
      "text": "离开后他常独自熬难事，才懂有人陪多轻松。",
      "key": "独自熬难事",
      "from": [
       "S06-2"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "歌唱再次展开，情感更充实迫切",
       "from": [
        "S06-B3-p2"
       ]
      },
      {
       "text": "这份安宁不等于现实已经变好",
       "from": [
        "S06-B1-p5"
       ]
      }
     ],
     "line": {
      "text": "他还想再有那种亲近，却怕以后再也找不到。",
      "key": "再也找不到",
      "from": [
       "S06-3"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "看着珍惜的东西，不必立刻抓回来",
       "from": [
        "S06-B4-p1",
        "S06-B4-p2"
       ]
      },
      {
       "text": "临近结尾，歌唱停在没说完的话上",
       "from": [
        "S06-B3-p3"
       ]
      }
     ],
     "line": {
      "text": "那样的日子他也过过，想起来心里暖和一点。",
      "key": "心里暖和一点",
      "from": [
       "S06-4"
      ]
     }
    }
   ]
  },
  {
   "sec": "S07",
   "beats": [
    {
     "beads": [
      {
       "text": "波兰舞曲气息又现，却不再完整鲜明",
       "from": [
        "S07-B5-p1",
        "S07-B5-p2"
       ]
      },
      {
       "text": "高音区忽然浮出刺骨寒意的长颤音",
       "from": [
        "S07-B1-p1"
       ]
      },
      {
       "text": "寒风吹开紧闭的窗，把人从甜梦里惊醒",
       "from": [
        "S07-B1-p2",
        "S07-B1-p4"
       ]
      }
     ],
     "line": {
      "text": "刚安下些心，他又怕以后遇上难事只能独自硬撑。",
      "key": "独自硬撑",
      "from": [
       "S07-1"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "马祖卡舞步突然闯入，打断先前静谧",
       "from": [
        "S07-B2-p1",
        "S07-B2-p2"
       ]
      },
      {
       "text": "舞步鲜明，内心却未必安定",
       "from": [
        "S07-B2-p3",
        "S07-B2-p4"
       ]
      }
     ],
     "line": {
      "text": "当初只顾着躲开难堪，他没料到离开后会这么孤单。",
      "key": "这么孤单",
      "from": [
       "S07-2"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "连续颤音让紧张一层层累积",
       "from": [
        "S07-B3-p1"
       ]
      },
      {
       "text": "事情像过去了，身体却还没放松",
       "from": [
        "S07-B3-p2"
       ]
      },
      {
       "text": "心里想冲出去，却始终找不到出口",
       "from": [
        "S07-B3-p3"
       ]
      }
     ],
     "line": {
      "text": "他想找回亲近，又不甘再受气，离开时的决心也淡了。",
      "key": "决心也淡了",
      "from": [
       "S07-3"
      ]
     }
    }
   ]
  },
  {
   "sec": "S08",
   "beats": [
    {
     "beads": [
      {
       "text": "缓慢宽广的歌唱短暂回来",
       "from": [
        "S08-B1-p1"
       ]
      },
      {
       "text": "刚认出这份安静，还没安顿下来它就退去",
       "from": [
        "S08-B2-p1"
       ]
      }
     ],
     "line": {
      "text": "想起从前有人陪，他安心片刻，可心里仍不安定。",
      "key": "心里仍不安定",
      "from": [
       "S08-1",
       "S08-2"
      ]
     }
    }
   ]
  },
  {
   "sec": "S09",
   "beats": [
    {
     "beads": [
      {
       "text": "双手铺开巨大颤音光晕，开头引子阴冷闪回",
       "from": [
        "S09-B1-p1"
       ]
      },
      {
       "text": "引子不再郑重召唤，声音刚稳又向上漂",
       "from": [
        "S09-B1-p1",
        "S09-B1-p2"
       ]
      }
     ],
     "line": {
      "text": "他又想回去，从前的日子和有人陪的感觉全涌上来。",
      "key": "有人陪的感觉",
      "from": [
       "S09-1"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "最初的问题又浮上来，这次仍没有简单答案",
       "from": [
        "S09-B2-p2"
       ]
      }
     ],
     "line": {
      "text": "他答不出自己究竟想回什么，心里发慌，不敢再想。",
      "key": "想回什么",
      "from": [
       "S09-2"
      ]
     }
    }
   ]
  },
  {
   "sec": "S10",
   "beats": [
    {
     "beads": [
      {
       "text": "开头自由试探的姿态一闪而过",
       "from": [
        "S10-B1-p1"
       ]
      },
      {
       "text": "熟悉的声音断断续续浮现，只剩几块碎片",
       "from": [
        "S10-B1-p2",
        "S10-B1-p5"
       ]
      }
     ],
     "line": {
      "text": "旧日难堪还在，就算回去也未必找得回亲近。",
      "key": "找得回亲近",
      "from": [
       "S10-1",
       "S10-2"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "声音零碎飘忽，整个人像失去着落",
       "from": [
        "S10-B3-p1",
        "S10-B3-p2"
       ]
      }
     ],
     "line": {
      "text": "想得累了，光凭舍不得，他也不敢回去，眼下更不踏实。",
      "key": "不敢回去",
      "from": [
       "S10-2",
       "S10-3"
      ]
     }
    }
   ]
  },
  {
   "sec": "S11",
   "beats": [
    {
     "beads": [
      {
       "text": "波兰舞曲步子先试探，随后渐渐聚拢",
       "from": [
        "S11-B2-p1"
       ]
      },
      {
       "text": "近乎祈祷的柔软声音，被带回行进节奏",
       "from": [
        "S11-B2-p2"
       ]
      },
      {
       "text": "害怕还在，脚却已经往前走",
       "from": [
        "S11-B3-p1"
       ]
      }
     ],
     "line": {
      "text": "他盼着还能找回亲近，却不愿再忍让，先把日子过稳。",
      "key": "先把日子过稳",
      "from": [
       "S11-1",
       "S11-2",
       "S11-3"
      ]
     }
    }
   ]
  },
  {
   "sec": "S12",
   "beats": [
    {
     "beads": [
      {
       "text": "全键盘雷鸣般的波兰舞曲主题轰然回归",
       "from": [
        "S12-B1-p1"
       ]
      },
      {
       "text": "沉重步子终于踏实落地，声势推着人向前",
       "from": [
        "S12-B1-p1"
       ]
      },
      {
       "text": "经历动摇后仍选择挺立，不必假装没受伤",
       "from": [
        "S12-B2-p1",
        "S12-B2-p2"
       ]
      }
     ],
     "line": {
      "text": "他知道当初的委屈不该忍，也不必抹掉从前的开心。",
      "key": "委屈不该忍",
      "from": [
       "S12-1",
       "S12-2"
      ]
     }
    }
   ]
  },
  {
   "sec": "S13",
   "beats": [
    {
     "beads": [
      {
       "text": "柔软歌唱进入开阔宏大的音响",
       "from": [
        "S13-B1-p1",
        "S13-B1-p3"
       ]
      },
      {
       "text": "密集音符像激流向上喷涌",
       "from": [
        "S13-B1-p2"
       ]
      }
     ],
     "line": {
      "text": "他想起从前亲近的日子，也盼着以后还能这样相处。",
      "key": "还能这样相处",
      "from": [
       "S13-1"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "快速八度明亮迅疾，积累的能量一下释放",
       "from": [
        "S13-B2-p1"
       ]
      },
      {
       "text": "身体像被气流推着向前跑",
       "from": [
        "S13-B2-p2"
       ]
      }
     ],
     "line": {
      "text": "他想把日子过好，不再为留住谁把委屈咽下去。",
      "key": "把委屈咽下去",
      "from": [
       "S13-2",
       "S13-4"
      ]
     }
    },
    {
     "beads": [
      {
       "text": "冲势收敛，颤动装饰音又带来不安",
       "from": [
        "S13-B4-p1",
        "S13-B4-p2"
       ]
      },
      {
       "text": "低音区吐出两记耳语般的和弦",
       "from": [
        "S13-B5-p2"
       ]
      },
      {
       "text": "最高音区亮起寒星般透明和弦，清脆如钟",
       "from": [
        "S13-B5-p3",
        "S13-B5-p4"
       ]
      }
     ],
     "line": {
      "text": "他知道还会孤单，有人亲近就珍惜，没有也能自己过。",
      "key": "没有也能自己过",
      "from": [
       "S13-3",
       "S13-4"
      ]
     }
    }
   ]
  }
 ]
}