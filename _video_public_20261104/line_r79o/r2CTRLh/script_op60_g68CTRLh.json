       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他真盼着，往后对方想找人作伴了还会想起他，他也能一直陪在人身边",
