      "rel": "引用"
     },
     {
      "from": "S12-2",
      "to": "S13-2",
      "rel": "引用"
     },
     {
      "from": "S13-1",
      "to": "S13-2",
      "rel": "引用"
     },
     {
      "from": "S11-1",
      "to": "S13-3",
      "rel": "引用"
     },
     {
      "from": "S13-1",
      "to": "S13-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S14",
    "bars": "111–116",
    "relation": "正在面对",
    "items": [
     {
      "id": "S14-1",
      "text": "强烈的起伏终于停住，我慢慢松下来，心里还留着一点温热的回味。",
      "key": "强烈的起伏终于停",
