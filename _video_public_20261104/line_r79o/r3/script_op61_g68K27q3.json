 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开了熟悉的生活，起初觉得总算不用再委屈自己",
       "keys": [
        "不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他提醒自己不能倒下，心里却真想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "尊严还在，方向和力气却不稳",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里很快空了下来",
       "keys": [
        "空了下来"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那份失落还没找到名字",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "他分不清是愤怒、遗憾还是怀念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "像刚从漫长昏沉里醒来",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "四周冷而空，胸口有些发紧",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "眼前还模糊，伸出颤手只摸到虚空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "他还没哭出来，只觉得身在何处都恍惚",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他还想往前走，却不知道以后靠什么安下心",
       "keys": [
        "安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日的声音和光线忽然浮上来",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "过去再清晰，也不会重新成为现在",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "身体隐约记起该怎样迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前的自在，一想到以后不能再那样过就发慌",
       "keys": [
        "发慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那些日子像远处传来的旧歌",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "珍惜的东西仿佛还在，却不能照旧拥有",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "像腿脚发虚的人，在记忆里挪舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他一心软就赶紧想起受过的气，提醒自己当初为什么要走",
       "keys": [
        "为什么要走"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他理好衣服抬起头，不想露出动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "他一遍遍对自己说没事",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "起初他还信几分，后来连重复都显得在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "悲伤还在，他不愿任由它淹没自己",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他还是不甘心，难道以前的好日子也得一起丢掉吗",
       "keys": [
        "不甘心"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "那股激昂像在说：我不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      },
      {
       "text": "反抗和自我控制在他心里同时存在",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他还憋着气，想起曾被当作自己人又高兴了一会儿",
       "keys": [
        "高兴了一会儿"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "有人会想到故乡夏日的麦浪和微风",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "也会想起从前不必时时防备的日子",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可那点高兴很快变酸，从前的日子已经回不去",
       "keys": [
        "变酸"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那份亲切反倒让眼前的距离更刺心",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "暂时离开难题时，那点轻松是真的",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "可心里的事还没找到答案",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "耳边像有许多人低声絮语，彼此缠绕",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "脚下像流沙，怎么也抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他又忍不住问，离开以后就一定会更好吗",
       "keys": [
        "更好吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他问自己：刚才那些话真信了吗？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      },
      {
       "text": "昂扬的劲头正在慢慢退下去",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他真盼着还能那样相处",
       "keys": [
        "还能那样相处"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那份亲近里，还有感激、柔情和短暂幸福",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "他想成为的坚定样子，也没那么确定",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可当初受的委屈也翻上来，他开始怀疑那一步",
       "keys": [
        "委屈也翻上来"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "正因为那段日子太好，想起来才会刺痛",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "那股抵抗已经疲惫又仓促",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "他反复想：如果当时没走，如今会怎样？",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "是不是还有别的可能？",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "究竟为什么会变成这样？",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "不停往前赶，像是为了不让自己停下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他觉得当初那些气不该忍，也不想连开心的事都不敢想",
       "keys": [
        "不该忍"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "柔和歌声里，仍有一股不肯退的劲",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "他心里像在说：这件事不能就这样算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "愤怒、悲伤和想维护自己的劲同时在",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "跟自己争得没了力气，那股不服气渐渐淡了",
       "keys": [
        "渐渐淡了"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像脚下地板忽然不见，只剩一个声音",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "那几口深呼吸让紧绷短暂松开",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      },
      {
       "text": "他只是抵抗得累了，心里未必平静",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "想到自己已不在那些人身边，他只觉得难受",
       "keys": [
        "只觉得难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声让旧日记忆重新有了温度",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "那可能是某个人，也可能是故乡或旧生活",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "正因还暖，想起来才更失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "心里的难受慢慢缓下来，他又想起从前的亲近",
       "keys": [
        "从前的亲近"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "这回他没拿受过的气压住想念",
       "keys": [],
       "from": [
        "S06-1"
       ],
       "bead": "S06-1"
      },
      {
       "text": "那份安宁让他暂时松开戒备",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "像隔着透明玻璃罩，连呼吸都不愿惊动",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "像母亲在耳边轻轻哼着摇篮曲",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "安静不代表现实变好，也不能永远停留",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "他终于不用解释自己为什么难过",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "也不必再硬撑着说我应该坚强",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "压住的愿望、委屈和思念终于浮出来",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "远方的家园忽然在梦里亮起来",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "他知道回不去，只能远远看着",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "那时有人在身边，他原来可以这么轻松",
       "keys": [
        "这么轻松"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他很想再有那样的亲近，又怕以后再也没有",
       "keys": [
        "怕以后再也没有"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "他像向远方某个不确定的人祈求",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "这份祈求真切，却没有回应的保证",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可那段日子他真真切切拥有过，想起来心里暖了一点",
       "keys": [
        "心里暖了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "他不急着抓回来，只想好好看着它",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，他就想到以后难事还得一个人扛",
       "keys": [
        "一个人扛"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "一阵寒风像猛地吹开紧闭的窗",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "后颈发凉，脉搏一下剧烈跳起来",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "像从甜梦里被生生拽回严寒",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "当初只想着不再受气，没想到离开后这么孤单",
       "keys": [
        "这么孤单"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "早知道会这么孤单，他还会走吗？",
       "keys": [],
       "from": [
        "S07-2"
       ],
       "bead": "S07-2"
