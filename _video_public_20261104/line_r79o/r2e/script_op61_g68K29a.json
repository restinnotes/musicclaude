       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      },
      {
       "text": "心里有东西不停翻腾想冲出去，却始终找不到真正的出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
