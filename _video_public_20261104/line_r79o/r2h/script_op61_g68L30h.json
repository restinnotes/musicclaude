 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开熟悉的生活，觉得总算不用再委屈自己，可心里仍像在等一个回声",
       "keys": [
        "不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "强撑着提醒自己不能倒下，可心里其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可他心里空落落的，他也分不清这是愤怒、遗憾还是怀念",
       "keys": [
        "心里空落落的"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉中醒来，四周又冷又空，胸口发紧、伸手只摸到空处",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "偶尔从前熟悉的日子又浮现，他仍想往前过，还不知道靠什么让自己安下心",
       "keys": [
        "不知道靠什么让自己安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "脑子还没想清楚，身体先隐约记起了怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "从前自在的日子像远处传来的旧歌，熟悉却已哼不完整",
       "keys": [
        "熟悉却已哼不完整"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得也怕以后再不能那样过，心里一阵阵冲上去又退下来",
       "keys": [
        "怕以后再不能那样过"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像腿脚发虚的人，还在记忆里勉强挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "呼吸像被催着一样，变得越来越急促",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "那份舍不得一冒头，他就赶紧把受过的气重新想一遍，像反复提醒自己没事、不能心软",
       "keys": [
        "把受过的气重新想一遍"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像整理好衣服抬起头，不让人看出自己动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可说得越多，越说明他其实仍很在意",
       "keys": [
        "其实仍很在意"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他还是不甘心：难道为了不再受那些气，就非得把从前那些好日子也一并丢掉？",
       "keys": [
        "好日子也一并丢掉"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "哪怕心里还在难受，也不甘心就这样垮下去",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他心里那股气还没消，思绪却暂时从委屈上移开",
       "keys": [
        "那股气还没消"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想起从前有人把他当作自己人，竟又轻快了一小会儿",
       "keys": [
        "轻快了一小会儿"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像回到故乡夏日的麦浪与微风里，温和又轻快",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像出去走走换个心情，轻松是真的，心结却还没解开",
