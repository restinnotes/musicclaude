  <!--<div class="row enews-author-social">
    <div class="col-sm-12 col-md-7">
              <div class="author">
          <img class="editor-icon" src="/themes/custom/sema/src/img/SEMA-SVG/SEMAEditorIcon.svg" role="presentation" style="display: none;" />
          
        </div>
          </div>
    <div class="col-sm-12 col-md-5">
      
  <div class="block">

  
    

      <span class="a2a_kit a2a_kit_size_32 addtoany_list" data-a2a-url="https://www.sema.org/news-media/enews/2026/29/want-grow-your-aftermarket-business-start-2026-sema-market-report" data-a2a-title="Want to Grow Your Aftermarket Business? Start With the 2026 SEMA Market Report"><a class="a2a_button_facebook"></a><a class="a2a_button_twitter"></a><a class="a2a_button_linkedin"></a><a class="a2a_button_email"></a></span>
  
  </div>

