       "bead": "S07-B2",
       "from": [
        "S07-B2",
        "S07-B4"
       ],
       "bars": "181-205",
       "at": 15.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "他想找回亲近却不甘再受气，离开的决心也淡了",
     "keys": [
      "不甘再受气"
     ],
     "emotion": "悬着",
     "from": [
      "S07-3"
     ],
     "at": 40.0
    }
   ],
   "notes": [
