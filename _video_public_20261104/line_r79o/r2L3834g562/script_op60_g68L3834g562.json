     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "原本的享受里多了一点小心",
       "keys": [
        "多了一点小心"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "先前还能装作没那么在乎，如今连怎么待着都拿不准",
       "keys": [],
       "from": [
        ""
       ],
       "bead": ""
      },
      {
       "text": "像突然失去支撑漂进雾里，刚才想攥紧的手也松开了",
