 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他已经离开那段熟悉的生活，起初还觉得自己总算不用再一次次委屈自己，像是强迫自己挺直背脊。",
       "keys": [
        "挺直背脊"
       ],
       "from": [
        "S01-1",
        "S01-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "尊严还在",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "方向和力气不稳",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "不能倒下",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "沉重又郑重",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "像要宣告什么",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "烟雾往高处散",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "轻了远了悬半空",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "停顿里还等回声",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里就空落落的，像刚从昏沉中醒来，四周冷而空，一时还说不清到底舍不得什么。",
       "keys": [
        "空落落"
       ],
       "from": [
        "S01-2",
        "S01-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "短句像一声叹息",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "刚冒出就被截断",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "余音散在冷空气",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "愤怒遗憾怀念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "还没找到对象",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "也还没有语言",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "胸口有些发紧",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "视线还模糊",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "伸手却摸到虚空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "还没哭出来",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "偶尔想起从前熟悉的日子，他还是想往前过，却不知道以后靠什么让自己安下心。",
       "keys": [
        "安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧场景忽然回来",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "熟悉声音和光线",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "记忆清楚也回不去",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "身体先记得迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "向前牵引还没站稳",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前那些自在的时候，光想到以后不能再像那样过日子，心里就有些慌，仿佛又听见远处传来的旧歌，熟悉却只能模糊地哼出几句。",
       "keys": [
        "有些慌"
       ],
       "from": [
        "S02-1",
        "S02-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "珍惜的东西还在",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "却不能像从前拥有",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "腿脚虚浮地挪步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "不像士兵的步伐",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "庄严又傲慢",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "脆弱而凄婉",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "细碎不安地蠕动",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "那份舍不得一上来，他就赶紧提醒自己受过的那些气，怕一心软，连当初为什么要走都忘了。",
       "keys": [
        "受过的那些气"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "猛地往上又退下",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "再次聚拢力量",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "越发焦灼",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "呼吸越来越急",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "第一次还有几分相信",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "第二次努力去相信",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "说到第三次更在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "悲伤还在",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "不把自己交给悲伤",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "可他还是不甘心，难道为了不再受那些气，就得把以前的好日子也一起丢掉吗？",
       "keys": [
        "不甘心"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他心里还憋着一股气，可想起从前和人在一起时，有人把他当作自己人，竟又高兴了一小会儿。",
       "keys": [
        "高兴了一小会儿"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那点高兴还没退，他心里就酸了：从前那样的日子过不成了，可离开以后就一定会更好过吗？",
       "keys": [
        "一定会更好过吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "若那一下重击突出",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "忽强忽弱心里一悬",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "前半焦躁急切",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "麦浪和夏日微风",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "温柔得心颤刺痛",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "越怀念越觉遥远",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "暂时绕开伤口",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "轻松是真的",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "多人耳边低声絮语",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "重心像流沙漂移",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "昂扬正在慢慢退潮",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      },
      {
       "text": "我真信那些话吗",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他一度真盼着还能那样相处。",
       "keys": [
        "亲近的日子"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那份亲近越鲜活，当初那些委屈也跟着翻上来：那一步走得对不对，后不后悔？没走的话，如今又会怎样？",
       "keys": [
        "后不后悔"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日温柔又鲜活",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "感激亲密短暂幸福",
