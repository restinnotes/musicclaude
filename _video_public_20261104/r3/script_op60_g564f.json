        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "算了的念头刚安静，另一个“还是放不下”又回来了",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "白天相处得很好，独自回家后心头却泛起酸楚",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
