       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "我终于分清，自己怀念的是旧日生活本身和曾经自然拥有的归属感",
