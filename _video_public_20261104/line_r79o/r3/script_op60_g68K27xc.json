       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "哪怕对方不需要他，他也愿意一直陪着并不再藏着喜欢",
