0encoding=&#x27;UTF-8&#x27;?%3e%3csvg%20width=&#x27;600&#x27;%20height=&#x27;530&#x27;%20version=&#x27;1.1&#x27;%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%3e%3cpath%20d=&#x27;m135.72%2044.03c66.496%2049.921%20138.02%20151.14%20164.28%20205.46%2026.262-54.316%2097.782-155.54%20164.28-205.46%2047.98-36.021%20125.72-63.892%20125.72%2024.795%200%2017.712-10.155%20148.79-16.111%20170.07-20.703%2073.984-96.144%2092.854-163.25%2081.433%20117.3%2019.964%20147.14%2086.092%2082.697%20152.22-122.39%20125.59-175.91-31.511-189.63-71.766-2.514-7.3797-3.6904-10.832-3.7077-7.8964-0.0174-2.9357-1.1937%200.51669-3.7077%207.8964-13.714%2040.255-67.233%20197.36-189.63%2071.766-64.444-66.128-34.605-132.26%2082.697-152.22-67.108%2011.421-142.55-7.4491-163.25-81.433-5.9562-21.282-16.111-152.36-16.111-170.07%200-88.687%2077.742-60.816%20125.72-24.795z&#x27;%20fill=&#x27;%23000000&#x27;/%3e%3c/svg%3e&quot;);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;-webkit-mask-size:contain" data-name="Bluesky" class="SocialShare-Icon SocialShare-Icon_variant_button SocialShare-Icon_type_bluesky DefaultIcon"></span></span></a><a target="_blank" rel="noreferrer" aria-label="Email" href="/cdn-cgi/l/email-protection#"><span class="SocialShare-IconWrapper SocialShare-IconWrapper_variant_button"><span data-component="icon" style="mask-image:url(&quot;data:image/svg+xml,%3csvg%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20fill=&#x27;currentColor&#x27;%20width=&#x27;33.333&#x27;%20height=&#x27;25&#x27;%20viewBox=&#x27;0%200%2033.333%2025&#x27;%3e%3cpath%20id=&#x27;Icon_awesome-envelope&#x27;%20data-name=&#x27;Icon%20awesome-envelope&#x27;%20d=&#x27;M32.7,12.755a.392.392,0,0,1,.632.306V26.375A3.126,3.126,0,0,1,30.208,29.5H3.125A3.126,3.126,0,0,1,0,26.375V13.068a.389.389,0,0,1,.632-.306c1.458,1.133,3.392,2.572,10.033,7.4,1.374,1,3.691,3.112,6,3.1,2.324.02,4.688-2.135,6.009-3.1C29.316,15.333,31.243,13.888,32.7,12.755ZM16.667,21.167c1.51.026,3.685-1.9,4.779-2.7,8.639-6.27,9.3-6.816,11.289-8.379a1.558,1.558,0,0,0,.6-1.23V7.625A3.126,3.126,0,0,0,30.208,4.5H3.125A3.126,3.126,0,0,0,0,7.625V8.862a1.567,1.567,0,0,0,.6,1.23c1.992,1.556,2.65,2.109,11.289,8.379C12.982,19.266,15.156,21.193,16.667,21.167Z&#x27;%20transform=&#x27;translate(0%20-4.5)&#x27;/%3e%3c/svg%3e&quot;);-webkit-mask-image:url(&quot;data:image/svg+xml,%3csvg%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20fill=&#x27;currentColor&#x27;%20width=&#x27;33.333&#x27;%20height=&#x27;25&#x27;%20viewBox=&#x27;0%200%2033.333%2025&#x27;%3e%3cpath%20id=&#x27;Icon_awesome-envelope&#x27;%20data-name=&#x27;Icon%20awesome-envelope&#x27;%20d=&#x27;M32.7,12.755a.392.392,0,0,1,.632.306V26.375A3.126,3.126,0,0,1,30.208,29.5H3.125A3.126,3.126,0,0,1,0,26.375V13.068a.389.389,0,0,1,.632-.306c1.458,1.133,3.392,2.572,10.033,7.4,1.374,1,3.691,3.112,6,3.1,2.324.02,4.688-2.135,6.009-3.1C29.316,15.333,31.243,13.888,32.7,12.755ZM16.667,21.167c1.51.026,3.685-1.9,4.779-2.7,8.639-6.27,9.3-6.816,11.289-8.379a1.558,1.558,0,0,0,.6-1.23V7.625A3.126,3.126,0,0,0,30.208,4.5H3.125A3.126,3.126,0,0,0,0,7.625V8.862a1.567,1.567,0,0,0,.6,1.23c1.992,1.556,2.65,2.109,11.289,8.379C12.982,19.266,15.156,21.193,16.667,21.167Z&#x27;%20transform=&#x27;translate(0%20-4.5)&#x27;/%3e%3c/svg%3e&quot;);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;-webkit-mask-size:contain" data-name="Email" class="SocialShare-Icon SocialShare-Icon_variant_button SocialShare-Icon_type_email DefaultIcon"></span></span></a></div><div class="ArticleBase-BodyContent ArticleBase-BodyContent_Article" data-testid="article-base-body-content"><div data-module="content" class="ContentModule-Wrapper"><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Wireless carriers&#x27; promotions have boosted Q2 sales in the US smartphone market, according to </span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"><a class="ContentText-BodyTextChunk ContentText-BodyTextChunk_link" rel="noreferrer" target="_blank" href="https://www.counterpointresearch.com/en/insights/us-smartphone-sell-through-up-9-yoy-in-q2-2025">a new report by Counterpoint Research</a></span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Wireless carriers are a &quot;very large channel&quot; for selling smartphones to end users, Jason Leigh, senior research manager for IDC, </span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"><a class="ContentText-BodyTextChunk ContentText-BodyTextChunk_link" href="/smartphones-devices/smartphone-and-wireless-service-bundles-will-bend-not-break-under-trump-tariffs" target="_self" data-discover="true">told Light Reading</a></span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"> earlier this year.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">&quot;The phone bundles are the biggest carrot that the carriers can offer, and they&#x27;ve been willing over the last five years or so to really lean into that to either retain customers or gain new ones,&quot; Leigh said.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Smartphone sell-through for AT&amp;T, T-Mobile and Verizon stores increased by 16%, 20% and 12%, respectively, year-over-year (YoY) in Q2, boosted by summer device promotions, according to Counterpoint Research.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Upgrade rates were also strong for the Big Three carriers, and sell-through in the premium device segment increased 11% YoY. The average selling price (ASP) of a US smartphone in Q2 increased by about $15 to $647.53, up from $632.59 last year.</span></p><p data-component="related-article" class="RelatedArticle"><span data-testid="related-article-title" class="RelatedArticle-Title">Related:</span><a class="RelatedArticle-RelatedContent" href="/smartphones-devices/nothing-is-onto-something" target="_self" data-discover="true">Nothing is onto something</a></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">However, demand for handsets in the mid-range price segment of $300-$599, such as the iPhone 16e and Google Pixel 9a, has increased 48%.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Overall, the US smartphone market increased 9% YoY in Q2. In addition, smartphone revenue reached $17.5 billion for the quarter, up 11% YoY.</span></p><h5 class="ContentText ContentText_variant_h5 ContentText_align_left" data-testid="content-text" id="Apple-and-Samsung-perform-well-in-Q2" style="scroll-margin-top:10rem">Apple and Samsung perform well in Q2</h5><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Sales of the iPhone 16e, plus successful device marketing and carrier promotions, supported Apple&#x27;s sell-through increase of 10% YoY in Q2, according to Counterpoint Research. The firm noted that Verizon&#x27;s Red Hot Deal Days and T-Mobile&#x27;s switcher deal, offering a free iPhone 16 Pro without a trade-in, were among the standout promotions.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Verizon said its &quot;</span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"><a class="ContentText-BodyTextChunk ContentText-BodyTextChunk_link" rel="noreferrer" target="_blank" href="https://www.verizon.com/about/news/accelerating-customer-first-strategy-3-year-price-lock-and-free-phone">Best Value Guarantee</a></span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">&quot; has also been important in boosting handset upgrades and customer satisfaction. The guarantee includes a three-year price lock on all myPlan and MyHome network plans; a free phone with any trade-in from Apple, Google or Samsung; free satellite text messaging; and additional discount and streaming service options.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">A recent example of strong carrier promotions was during the </span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"><a class="ContentText-BodyTextChunk ContentText-BodyTextChunk_link" href="/smartphones-devices/carriers-flip-out-over-foldables-during-samsung-unpacked" target="_self" data-discover="true">launch</a></span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"> of Samsung&#x27;s Galaxy Z Fold7 and Flip 7 handsets, which are new, thinner foldable handsets from the device maker. The Big Three carriers, plus Boost Mobile, Xfinity Mobile and Comcast Business Mobile, all offered $1,100 off the Z Fold 7 with an eligible device trade-in and/or new line.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Indeed, Samsung experienced a solid sell-through increase of 16% YoY, which Counterpoint said was a result of increased demand for its flagship models and device promotions from service providers. The S25 Edge, </span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"><a class="ContentText-BodyTextChunk ContentText-BodyTextChunk_link" href="/smartphones-devices/Samsung-flips-the-script-on-device-upgrades-with-Galaxy-S25-Edge" target="_self" data-discover="true">launched in May</a></span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">, also contributed slightly to the increase in sales.</span></p><p data-component="related-article" class="RelatedArticle"><span data-testid="related-article-title" class="RelatedArticle-Title">Related:</span><a class="RelatedArticle-RelatedContent" href="/smartphones-devices/Samsung-flips-the-script-on-device-upgrades-with-Galaxy-S25-Edge" target="_self" data-discover="true">Samsung flips the script on device upgrades with Galaxy S25 Edge</a></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">During the launch of the S25, Samsung ramped up promotion of its Galaxy Club program in addition to offering other promotions such as free streaming services with a direct purchase of the S25 from Samsung. The Galaxy Club is an add-on subscription program for customers to obtain future discounts and device credits.</span></p><h5 class="ContentText ContentText_variant_h5 ContentText_align_left" data-testid="content-text" id="Some-smaller-players-can-t-take-the-heat" style="scroll-margin-top:10rem">Some smaller players can&#x27;t take the heat</h5><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Market domination by larger OEMs is partly a result of how many smartphones are sold in the US through the service provider channel, Runar Bjørhovde, senior analyst at Canalys, </span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"><a class="ContentText-BodyTextChunk ContentText-BodyTextChunk_link" href="/smartphones-devices/economic-uncertainty-flattens-smartphone-market-reports" target="_self" data-discover="true">told Light Reading recently</a></span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">. Smaller players don&#x27;t have the same financial backing to take part in the service provider channel or open their own brick-and-mortar stores to sell directly to consumers, he explained.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Smaller players like </span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"><a class="ContentText-BodyTextChunk ContentText-BodyTextChunk_link" href="/smartphones-devices/nothing-is-onto-something" target="_self" data-discover="true">Nothing</a></span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"> are starting to scale up in retail stores such as Best Buy, but making headway in the US hinges on selling smartphones through the carrier channel, said Bjørhovde. Nothing has also focused on selling directly to consumers via the company&#x27;s website, in addition to sales through Amazon and Walmart.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Meanwhile, Nothing is performing well in other markets such as India and China – the company&#x27;s manufacturing base is split between those countries, with slightly more manufacturing in India.</span></p><p data-component="related-article" class="RelatedArticle"><span data-testid="related-article-title" class="RelatedArticle-Title">Related:</span><a class="RelatedArticle-RelatedContent" href="/smartphones-devices/iphone-16e-outperforms-iphone-16-for-at-t-verizon-users-ookla" target="_self" data-discover="true">iPhone 16e outperforms iPhone 16 for AT&amp;T, Verizon users – Ookla</a></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Other small smartphone players have been less fortunate. HMD recently exited the US market, and the company&#x27;s sell-through dropped 41% YoY, according to Counterpoint. HMD, which licenses the Nokia brand for new phones and tablets, initially announced plans to </span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text"><a class="ContentText-BodyTextChunk ContentText-BodyTextChunk_link" rel="noreferrer" target="_blank" href="https://www.theverge.com/news/705046/hmd-global-nokia-scaling-back-us-market">scale back its US operations in July</a></span><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">.</span></p><p class="ContentParagraph ContentParagraph_align_left" data-testid="content-paragraph"><span class="ContentText ContentText_variant_bodyNormal" data-testid="content-text">Research Director Jeff Fieldhack said that HMD&#x27;s exit presents an opportunity for other smartphone vendors to fill the gap in the low-end smartphone market, and Motorola and TCL are among the brands well-positioned to step in.</span></p></div></div><div class="SocialShare"><div data-component="social-share" class="SocialShare SocialShare_variant_button ArticleBase-SocialShare ArticleBase-SocialShare_second"><a target="_blank" rel="noreferrer" aria-label="Facebook" href="http://www.facebook.com/sharer/sharer.php?u=https://www.lightreading.com/smartphones-devices/at-t-t-mobile-and-verizon-s-smartphone-promotions-push-q2-sales-performance-report"><span class="SocialShare-IconWrapper SocialShare-IconWrapper_variant_button"><span data-component="icon" style="mask-image:url(&quot;data:image/svg+xml,%3csvg%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20fill=&#x27;currentColor&#x27;%20viewBox=&#x27;0%200%20320%20512&#x27;%3e%3cpath%20d=&#x27;M279.14%20288l14.22-92.66h-88.91v-60.13c0-25.35%2012.42-50.06%2052.24-50.06h40.42V6.26S260.43%200%20225.36%200c-73.22%200-121.08%2044.38-121.08%20124.72v70.62H22.89V288h81.39v224h100.17V288z&#x27;/%3e%3c/svg%3e&quot;);-webkit-mask-image:url(&quot;data:image/svg+xml,%3csvg%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20fill=&#x27;currentColor&#x27;%20viewBox=&#x27;0%200%20320%20512&#x27;%3e%3cpath%20d=&#x27;M279.14%20288l14.22-92.66h-88.91v-60.13c0-25.35%2012.42-50.06%2052.24-50.06h40.42V6.26S260.43%200%20225.36%200c-73.22%200-121.08%2044.38-121.08%20124.72v70.62H22.89V288h81.39v224h100.17V288z&#x27;/%3e%3c/svg%3e&quot;);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;-webkit-mask-size:contain" data-name="Facebook" class="SocialShare-Icon SocialShare-Icon_variant_button SocialShare-Icon_type_facebook DefaultIcon"></span></span></a><a target="_blank" rel="noreferrer" aria-label="Linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url=https://www.lightreading.com/smartphones-devices/at-t-t-mobile-and-verizon-s-smartphone-promotions-push-q2-sales-performance-report"><span class="SocialShare-IconWrapper SocialShare-IconWrapper_variant_button"><span data-component="icon" style="mask-image:url(&quot;data:image/svg+xml,%3csvg%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20fill=&#x27;currentColor&#x27;%20viewBox=&#x27;0%200%20448%20512&#x27;%3e%3cpath%20d=&#x27;M100.28%20448H7.4V148.9h92.88zM53.79%20108.1C24.09%20108.1%200%2083.5%200%2053.8a53.79%2053.79%200%200%201%20107.58%200c0%2029.7-24.1%