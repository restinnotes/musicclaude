        "S04-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "以前的日子忽然显得格外亲近，他心里暖了一下，也觉得那些熟悉的东西仍然很珍贵",
       "keys": [
        "格外亲近"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "表面还撑着从前坚定的样子，心却比以前更容易受伤了",
