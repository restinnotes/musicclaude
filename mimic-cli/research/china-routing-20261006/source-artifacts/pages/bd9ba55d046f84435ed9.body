qh6fx/product/23/lang-CN-sm.jpg"},"h2c":{"revolutionize":{"pc":"https://portal.bblmw.com/h2c/h2e4s63566c/revolutionize/zh.png","mo":"https://portal.bblmw.com/h2c/h2e4s63566c/revolutionize/zh-sm.png"},"notAToy":{"pc":"https://portal.bblmw.com/h2c/h2e4s63566c/notAToy/zh.png","mo":"https://portal.bblmw.com/h2c/h2e4s63566c/notAToy/zh-sm.png"}},"h2d":{"banner":{"video":"https://portal.bblmw.com/h2d/a25d4edaccfbe/19update/video/video-zh.mp4"}},"support":{"defaultPcBanner":"https://portal.bblmw.com/support/support-header-bg.png","defaultMBanner":"https://portal.bblmw.com/support/support-header-bg-sm.png","searchEmpty":"https://portal.bblmw.com/support/search-empty.png","bilibiliPlay":"https://portal.bblmw.com/support/bilibili-play-20240122.svg"}},"head":{"default":"Bambu Lab 拓竹科技","mwStoreSignIn":{"title":"登录/注册 | MakerMarket 联盟"},"developer":{"fleetHub":{"developerAgreement":{"title":"拓竹 Fleet Hub 开发者协议"},"privacyStatement":{"title":"拓竹 Fleet Hub 隐私声明"},"index":{"title":"拓竹 Fleet Hub 开发者中心"}}},"product":{"fleetHub":{"index":{"title":"拓竹 Fleet Hub","description":"离线集群管控，无缝企业流程。"},"specs":{"title":"拓竹 Fleet Hub 技术规格","description":"拓竹 Fleet Hub 与所属附件的技术参数"}}},"index":{"title":"Bambu Lab 拓竹3D打印机","description":"Bambu Lab 拓竹科技专注于 台式 3D打印机的创新研发和制造。从 X1 系列开始，Bambu Lab制造了领先水平的 3D打印机，打破了数字世界和物理世界之间的障碍，助你释放创造潜能。"},"a1":{"title":"Bambu Lab A1 mini | 桌面级3D打印机 |  A1 系列","description":"Bambu Lab A1 mini 以紧凑机身演绎极致性能，为初学者提供了曾经只存在于高端机型的易用功能。"},"a1TechSpecs":{"title":"Bambu Lab A1 mini - 技术参数","description":"技术参数 机身 打印尺寸: 180mm*180mm*180mm 框架: 钢材+铝型材 工具头 热端: 全金属 挤出机齿轮: 钢材"},"a1Printer":{"title":"Bambu Lab A1 | 桌面级3D打印机 |  A1 系列","description":"全尺寸 Bambu Lab A1 搭载全自动化配置及多色打印能力，使3D打印更适合初学者和爱好者。"},"a1PrinterTechSpecs":{"title":"Bambu Lab A1 - 技术参数","description":"技术参数 机身 打印尺寸: 256mm*256mm*256mm 框架: 钢材+铝型材 工具头 热端: 全金属 挤出机齿轮: 钢材"},"x1":{"title":"Bambu Lab X1 系列 | 桌面级3D打印机 | X1C","description":"Bambu Lab 拓竹科技专注于 台式 3D打印机的创新研发和制造。X1系列支持多色高速3D打印，领先行业水平。"},"x1e":{"title":"Bambu Lab X1E 3D打印机","description":"X1E 继承了 X1 系列卓越的稳定性和可靠性，为专业用户和工程应用提供了进阶的网络安全及应用可能性。"},"p1":{"title":"Bambu Lab P1 系列 | 可靠性能，开箱即用","description":"凭借 CoreXY 结构设计，日臻完善的可靠性能，P1 系列 3D 打印机提供了开箱即用的舒爽打印体验，极具性价比。"},"h2s":{"title":"Bambu Lab H2S | 多合一 3D 打印机","description":"Bambu Lab H2S，终极单头 3D 打印机，融合激光切割、激光雕刻、数字刀切、绘图功能。高精度、快速、多合一。"},"h2sTechSpecs":{"title":"Bambu Lab H2S - 技术参数","description":"H2S 与相关附加功能模块的技术参数"},"h2sFAQ":{"title":"Bambu Lab H2S - FAQ"},"h2c":{"warming":{"title":"拓竹 H2C：多色多材料 3D 打印，无需妥协","description":"更少废料。多色多材料。Vortek 系统技术。11 月 18 日见。"},"index":{"title":"拓竹 H2C：多色多材料 3D 打印，无需妥协","description":"探索拓竹 H2C，一款用于节省耗材、全自动多材料和多色打印的工具更换式 3D 打印机，配备 Vortek 系统——快速、精确、可靠。"},"techSpecs":{"title":"Bambu Lab H2C - 技术参数","description":"H2C与相关附加功能模块的技术参数"},"FAQ":{"title":"Bambu Lab H2D - FAQ"},"showcase":{"title":"拓竹 H2C 案例展示：多材料、多色 3D 打印的实际应用","desc":"栩栩如生的多色多材料 3D 打印模型，充分展现你未来 3D 打印项目的可能性。"}},"h2d":{"title":"Bambu Lab H2D|3D打印|激光雕刻切割|数控刀切|多合一","description":"Bambu Lab H2D重新定义个人智造，将复合加工工艺（3D打印、激光、数控刀切）带入你的个人工作室，释放更多创作可能性"},"h2dTechSpecs":{"title":"Bambu Lab H2D - 技术参数","description":"H2D与相关附加功能模块的技术参数"},"h2dFAQ":{"title":"拓竹 H2D - FAQ"},"h2dPro":{"title":"Bambu Lab H2D Pro|3D 打印机","description":"专业级双头3D打印解决方案"},"h2dProTechSpecs":{"title":"Bambu Lab H2D Pro - 技术参数","description":"H2D Pro 与相关附加功能模块的技术参数"},"h2dProFAQ":{"title":"拓竹 H2D Pro - FAQ"},"warming":{"title":"拓竹 | 重新定义个人智造 | 3 月 25 日"},"series":{"h2":{"title":"Bambu Lab H2 系列：四合一 3D 打印机，集 3D 打印、激光雕刻、数字刀切和绘图为一体","desc":"探索 H2D、H2S 和最新的 H2C，它们可用于多色 3D 打印、激光雕刻、数字切割和绘画。解锁涵盖所有功能的多功能项目。"}},"p2s":{"index":{"title":"拓竹 P2S：更简单、更可靠的多色 3D 打印","description":"遇见全新 P2S 3D打印机 —— 全新设计、更智能的控制、更强的性能和多材料、多色自由度。可靠，历久弥坚。"},"techSpecs":{"title":"Bambu Lab P2S - 技术参数","description":"P2S 与相关附加功能模块的技术参数"},"FAQ":{"title":"Bambu Lab P2S - FAQ"},"showcase":{"title":"拓竹 P2S 展示 | 精致设计，优质打印","desc":"在展示中近距离看看拓竹 P2S —— 精心设计的细节和优质的打印模型，给创作更添信心。"}},"x2d":{"index":{"title":"拓竹 X2D：人人可得的双喷嘴 3D 打印机，高效高质量易拆支撑打印","description":"拓竹 X2D 登场，更易入手的双喷嘴 3D 打印机。它有着辅助喷嘴，方便打印易拆支撑、也支持高效的多色多材料打印，带来卓越拓竹式体验。"},"techSpecs":{"title":"拓竹 X2D - 技术参数","description":"X2D 与相关附加功能模块的技术参数"},"FAQ":{"title":"拓竹 X2D - FAQ"},"showcase":{"title":"拓竹 X2D：深入了解双喷嘴系统","desc":"近距离看看 X2D 的每一处细节，了解其打印表现，并探索双挤出系统、Bambu Studio 与 MakerWorld 如何协同提升 FDM 3D 打印体验。"}},"a2l":{"index":{"title":"拓竹 A2L：大尺寸超稳打印机","description":"超大尺寸家用打印机，告别拆件，轻松一体成型。"},"techSpecs":{"title":"拓竹 A2L - 技术规格","description":"拓竹 A2L 及其扩展模块的规格参数"},"FAQ":{"title":"拓竹 A2L - FAQ"}},"r1":{"index":{"title":"拓竹 R1 激光切割机：55W 专业级桌面 CO2 激光切割机","description":"拓竹首款消费级激光产品，将复杂工序简化，大幅提升易用性，木材、皮革、亚克力、布料等材料皆可高效加工，轻松好上手，利落更称手。"},"techSpecs":{"title":"拓竹 R1 - 技术参数","description":"R1 与相关附加功能模块的技术参数"},"FAQ":{"title":"拓竹 R1 - FAQ"},"warming":{"title":"拓竹 R1 激光切割机：轻松上手 利落称手","description":"拓竹首款消费级激光产品，革新激光加工体验，更快、更准、更智能。把复杂的操作交给拓竹，把创造的自由留给你，9月22日见！","description-AU-JP":"Meet Bambu Lab R1, our first CO2 laser engraver and cutter. From 3D printing to laser, we make it easier to create with more materials. Coming September 23.","description-KR-BR-MX":"Meet Bambu Lab R1, our first CO2 laser engraver and cutter. From 3D printing to laser, we make it easier to create with more materials. Coming soon."}},"compare":{"title":"机型及参数比较 - Bambu Lab桌面级3D打印机","description":"对比拓竹 3D 打印机的功能和技术规格：{{printerList}}。"},"aboutUs":{"title":"关于我们"},"contactUs":{"title":"联系我们"},"download":{"title":"软件"},"euroCompliance":{"title":"欧洲合规文件"},"joinUs":{"title":"加入我们"},"support":{"title":"支持"},"activateSN":{"title":"注册新序列号"},"myServicePortal":{"title":"服务记录"},"buySpareParts":{"title":"购买备件"},"forgotPassword":{"title":"重置密码"},"changeAccount":{"title":"绑定新邮箱"},"designsFollowing":{"title":"模型"},"designs":{"title":"模型"},"downloadApp":{"title":"软件下载 - Bambu Handy"},"downloadStudio":{"title":"软件下载 - Bambu Studio"},"downloadSuite":{"title":"软件下载 - Bambu Suite"},"downloadCyberbrick":{"title":"软件下载 - CyberBrick 应用程序"},"ticket":{"title":"工单"},"newTicket":{"title":"创建工单"},"tickets":{"title":"服务工单"},"ticketUpload":{"title":"创建工单"},"privacy":{"title":"隐私声明"},"warranty