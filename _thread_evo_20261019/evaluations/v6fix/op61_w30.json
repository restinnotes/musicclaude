     },
     {
      "from": "S11-1",
      "to": "S13-2",
      "rel": "限制"
     }
    ]
   },
   "plan": {
    "causes": [
     {
      "id": "c1",
      "cause": "他发现眼前承担的事也在替那种生活争取，责任与依恋不再互相排斥；当初相信那种生活时的快乐也重新得到确认，虽未实现，却仍值得珍惜和追求。",
      "from": [
       "S12-3",
       "S13-2",
