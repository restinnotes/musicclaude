      "bead_edges": [
        {
          "a": "S04-B1",
          "b": "S04-B2",
          "type": "段内先后",
          "note": "92–107的主题回归带着流动、歌唱和记忆的温度；到108–115，音乐明显转向风暴般的激烈与紧绷。温暖转为刺痛是有原稿依据的一种聆听解释，而不是唯一的客观因果。"
        },
        {
          "a": "S04-B2",
          "b": "S04-B3",
          "type": "重叠但新增",
          "note": "两者都涉及紧迫和躁动。B2呈现音乐从温暖到风暴、以及下行线条中的后退感；B3进一步把紧张转成心跳、追赶和左右手挣扎的身体经验。"
        },
        {
          "a": "S04-B2",
          "b": "S04-B4",
          "type": "重叠但新增",
          "note": "B2抓住紧迫感及其段内变化，B4增加反复自问和无法停下来的心理动因，不只是把焦虑换一个比喻。"
        },
        {
          "a": "S04-B3",
          "b": "S04-B4",
          "type": "可同时成立",
          "note": "身体被节奏催赶的恐慌，与思绪反复盘旋、无法停下来的内耗是两个不同层面，可以在同一段音乐中同时感到。"
        },
        {
          "a": "S04-B1",
          "b": "S04-B4",
          "type": "可同时成立",
          "note": "主题回归时的温暖、姿态的脆弱与反复自问并不互相排斥；不必把它们串成记忆导致焦虑的单一心理故事。"
        }
      ],
