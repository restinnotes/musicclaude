 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我忽然发现自己想靠近对方，心里一热，自己也意外。",
       "keys": [],
       "from": [
        "S01-1"
       ]
      },
      {
       "text": "这点亲近已让我觉得甜，却不知道下次能不能更坦白。",
       "keys": [],
       "from": [
        "S01-2",
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "烟花迸开",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
      },
      {
       "text": "细光飘落",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
      },
      {
       "text": "还悬在水面",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ],
       "emotion": "悬着"
      },
      {
       "text": "脚下一晃",
       "keys": [],
       "from": [
        "S01-B2-p1"
       ]
      },
      {
       "text": "一瞬失重",
       "keys": [],
       "from": [
        "S01-B2-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我怕对方看出我有多需要这份亲近、觉得负担太重，所以只敢露出一点喜欢。",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "话还没出口",
       "keys": [],
       "from": [
        "S01-B3-p1"
       ]
      },
      {
       "text": "沉默几秒",
       "keys": [],
       "from": [
        "S01-B3-p1"
       ]
      },
      {
       "text": "一说出口就变了",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      },
      {
       "text": "越清楚越谨慎",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没因为我露出在意而退开，仍愿意亲近我。",
       "keys": [],
       "from": [
        "S02-1"
       ]
      },
      {
       "text": "我才渐渐放松下来。",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩挨着肩",
       "keys": [],
       "from": [
        "S02-B1-p1"
       ],
       "emotion": "亲密"
      },
      {
       "text": "呼吸贴在一起",
       "keys": [],
       "from": [
        "S02-B1-p1"
       ],
       "emotion": "亲密"
      },
      {
       "text": "体温融在一起",
       "keys": [],
       "from": [
        "S02-B1-p1"
       ],
       "emotion": "亲密"
      },
      {
       "text": "不用找话题",
       "keys": [],
       "from": [
        "S02-B1-p2"
       ]
      },
      {
       "text": "沉默也舒服",
       "keys": [],
       "from": [
        "S02-B1-p3"
       ]
      },
      {
       "text": "温风贴着皮肤",
       "keys": [],
       "from": [
        "S02-B1-p4"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我也想再靠近些，喜欢几乎藏不住。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      },
      {
       "text": "可我怕太急破坏眼下的自在，还是收住了。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "喜欢忽然涌上来",
       "keys": [],
       "from": [
        "S02-B3-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "呼吸跟着乱了",
       "keys": [],
       "from": [
        "S02-B3-p1"
       ]
      },
      {
       "text": "轻轻吐口气",
       "keys": [],
       "from": [
        "S02-B3-p2"
       ],
       "emotion": "安心"
      },
      {
       "text": "还没真正落定",
       "keys": [],
       "from": [
        "S02-B3-p3"
       ],
       "emotion": "悬着"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "和对方待在一起这么好，我却想到这样的时刻总会过去，还没分开就先舍不得。",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "甜得发酸",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ],
       "emotion": "亲密"
      },
      {
       "text": "鼻尖发酸",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      },
      {
       "text": "还没分开就舍不得",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ],
       "emotion": "亲密"
      },
      {
       "text": "想让这一刻慢点",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ],
       "emotion": "亲密"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我难得不去想我们以后会怎样，只想舒服地待在这份亲近里。",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波轻轻摇",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "身体晃着漂着",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "不必赶去哪里",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "有点陶醉",
       "keys": [],
       "from": [
        "S03-B1-p2"
       ]
      },
      {
       "text": "沉默也舒服",
       "keys": [],
       "from": [
        "S03-B1-p3"
       ]
      },
      {
       "text": "心慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我一度想告诉对方，我多喜欢这样的相处。",
       "keys": [],
       "from": [
        "S03-2"
       ]
      },
      {
       "text": "我也想问对方是不是一样。",
       "keys": [],
       "from": [
        "S03-2"
       ]
      },
      {
       "text": "可还没想好怎么开口，念头就淡了。",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急着说一句",
       "keys": [],
       "from": [
        "S03-B2-p1"
       ]
      },
      {
       "text": "念头刚冒头",
       "keys": [],
       "from": [
        "S03-B2-p2"
       ]
      },
      {
       "text": "又沉回去",
       "keys": [],
       "from": [
        "S03-B2-p2"
       ]
      },
      {
       "text": "只露一下头",
       "keys": [],
       "from": [
        "S03-B2-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "熟悉的亲近又让我满心欢喜。",
       "keys": [],
       "from": [
        "S04-1"
       ]
      },
      {
       "text": "我想起上回想告诉对方，却没有开口。",
       "keys": [],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "耳边低语",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      },
      {
       "text": "呼吸挨得近",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      },
      {
       "text": "亮斑晃眼",
