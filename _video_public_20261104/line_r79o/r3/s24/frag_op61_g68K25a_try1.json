{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他离开了熟悉的生活",
     "accent": "离开",
     "emotion": "不安",
     "from": [
      "S01-1"
     ],
     "at": 0
    },
    {
     "text": "起初总算不用再反复委屈自己",
     "accent": "不用再反复委屈自己",
     "emotion": "安心",
     "from": [
      "S01-1"
     ],
     "at": 12
    },
    {
     "text": "像硬撑着不倒下却很想停",
     "accent": "很想停",
     "emotion": "悬着",
     "from": [
      "S01-B2"
     ],
     "at": 24
    },
    {
     "text": "心里空落落说不清舍不得什么",
     "accent": "空落落",
     "emotion": "孤单",
     "from": [
      "S01-2"
     ],
     "at": 40
    },
    {
     "text": "他想往前走却不知怎样安心",
     "accent": "不知怎样安心",
     "emotion": "悬着",
     "from": [
      "S01-3"
     ],
     "at": 56
    }
   ],
   "small": [
    {
     "text": "尊严还在，方向和力气却不稳",
     "after": 2,
     "from": [
      "S01-B2"
     ],
     "bars": "",
     "at": 29
    },
    {
     "text": "分不清是愤怒遗憾还是怀念",
     "after": 3,
     "from": [
      "S01-B3"
     ],
     "bars": "",
     "at": 45
    },
    {
     "text": "刚醒来般恍惚，四周冷空胸口发紧",
     "after": 3,
     "from": [
      "S01-B4"
     ],
     "bars": "1-23",
     "at": 62
    },
    {
     "text": "眼前模糊，颤手摸空，还没哭出来",
     "after": 3,
     "from": [
      "S01-B4"
     ],
     "bars": "1-23",
     "at": 74
    },
    {
     "text": "旧日声音光线回来，却回不到从前",
     "after": 4,
     "from": [
      "S01-B5"
     ],
     "bars": "9-17",
     "at": 82
    },
    {
     "text": "身体先于意识，隐约记起舞步",
     "after": 4,
     "from": [
      "S01-B5"
     ],
     "bars": "18-23",
     "at": 88
    }
   ],
   "notes": [
    {
     "text": "沉重和弦后琶音散开，停顿像还等回声",
     "from": [
      "S01-B1"
     ],
     "bars": "1-6"
    },
    {
     "text": "短句刚冒出就被长停顿截断",
     "from": [
      "S01-B3"
     ],
     "bars": "1-23"
    },
    {
     "text": "旋律渐清，波兰舞曲步态逐渐浮现",
     "from": [
      "S01-B5"
     ],
     "bars": "9-23"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "他舍不得从前自在的日子",
     "accent": "舍不得",
     "emotion": "亲密",
     "from": [
      "S02-1"
     ],
     "at": 0
    },
    {
     "text": "想到以后不能那样过就心慌",
     "accent": "心慌",
     "emotion": "不安",
     "from": [
      "S02-1"
     ],
     "at": 10
    },
    {
     "text": "他提醒自己受过的气",
     "accent": "受过的气",
     "emotion": "不安",
     "from": [
      "S02-2"
     ],
     "at": 22
    },
    {
     "text": "怕一心软就忘了为何离开",
     "accent": "为何离开",
     "emotion": "不安",
     "from": [
      "S02-2"
     ],
     "at": 34
    },
    {
     "text": "不受那些气就得丢掉好日子？",
     "accent": "丢掉好日子",
     "emotion": "炽热",
     "from": [
      "S02-3"
     ],
     "at": 46
    }
   ],
   "small": [
    {
     "text": "远处旧歌般熟悉，只能模糊哼几句",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "24-65",
     "at": 5
    },
    {
     "text": "珍惜的东西还在，却不能照旧拥有",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "24-65",
     "at": 14
    },
    {
     "text": "舞步庄严，歌声像私下哼唱",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "24-65",
     "at": 18
    },
    {
     "text": "腿脚虚浮，像在记忆里挪舞步",
     "after": 1,
     "from": [
      "S02-B2"
     ],
     "bars": "24-65",
     "at": 28
    },
    {
     "text": "呼吸被连绵音符催得越来越急",
     "after": 1,
     "from": [
      "S02-B3"
     ],
     "bars": "56-65",
     "at": 40
    },
    {
     "text": "第三遍说没事，露出在意仍不甘消亡",
     "after": 4,
     "from": [
      "S02-B4",
      "S02-B5"
     ],
     "bars": "44-65",
     "at": 52
    }
   ],
   "notes": [
    {
     "text": "节奏庄严傲慢，旋律却脆弱凄婉",
     "from": [
      "S02-B2"
     ],
     "bars": "24-65"
    },
    {
     "text": "伴奏底下细碎声音不安地蠕动",
     "from": [
      "S02-B2"
     ],
     "bars": "24-65"
    },
    {
     "text": "旋律先上推又退下，随后再次聚拢",
     "from": [
      "S02-B3"
     ],
     "bars": "38-65"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他还憋着一股气",
     "accent": "一股气",
     "emotion": "炽热",
     "from": [
      "S03-1"
     ],
     "at": 0
    },
    {
     "text": "想起有人把他当自己人",
     "accent": "当自己人",
     "emotion": "亲密",
     "from": [
      "S03-1"
     ],
     "at": 3
    },
    {
     "text": "他短暂高兴又很快心酸",
     "accent": "短暂高兴",
     "emotion": "悬着",
     "from": [
      "S03-1",
      "S03-2"
     ],
     "at": 6
    },
    {
     "text": "从前那样的日子回不去了",
     "accent": "回不去了",
     "emotion": "孤单",
     "from": [
      "S03-2"
     ],
     "at": 9
    },
    {
     "text": "离开以后就一定更好过吗？",
     "accent": "一定更好过吗",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ],
     "at": 12
    }
   ],
   "small": [
    {
     "text": "像故乡麦浪微风，也像从前自在亲近",
     "after": 2,
     "from": [
      "S03-B2"
     ],
     "bars": "80-91",
     "at": 14
    },
    {
     "text": "温柔得心颤，偏偏又刺痛绝望",
     "after": 2,
     "from": [
      "S03-B2"
     ],
     "bars": "80-91",
     "at": 17
    },
    {
     "text": "像出去走走，轻松是真的，心事仍没答案",
     "after": 4,
     "from": [
      "S03-B3"
     ],
     "bars": "66-91",
     "at": 20
    },
    {
     "text": "耳边像多人低声絮语，脚下像流沙",
     "after": 3,
     "from": [
      "S03-B4"
     ],
     "bars": "66-91",
     "at": 23
    },
    {
     "text": "刚才那股昂扬，我真信了还是硬撑？",
     "after": 4,
     "from": [
      "S03-B5"
     ],
     "bars": "66-91",
     "at": 25
    }
   ],
   "notes": [
    {
     "text": "第66小节和弦若突出，会像重锤砸下",
     "from": [
      "S03-B1"
     ],
     "bars": "66"
    },
    {
     "text": "忽强忽弱的起伏让节奏忽然悬起来",
     "from": [
      "S03-B1"
     ],
     "bars": "66-91"
    },
    {
     "text": "前半急切，后半旋律转柔和轻盈",
     "from": [
      "S03-B2"
     ],
     "bars": "66-91"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "想起从前亲近的日子",
     "accent": "亲近",
     "emotion": "亲密",
     "from": [
      "S04-1"
     ],
     "at": 0
    },
    {
     "text": "他一度真盼着还能那样相处",
     "accent": "真盼着",
     "emotion": "欢喜",
     "from": [
      "S04-1"
     ],
     "at": 4
    },
    {
     "text": "可当初受过的委屈也翻上来",
     "accent": "委屈",
     "emotion": "不安",
     "from": [
      "S04-2"
     ],
     "at": 8
    },
    {
     "text": "他反复问那一步走对了吗？",
     "accent": "走对了吗",
     "emotion": "悬着",
     "from": [
      "S04-2"
     ],
     "at": 12
    },
    {
     "text": "没走的话如今又会怎样？",
     "accent": "又会怎样",
     "emotion": "悬着",
     "from": [
      "S04-2"
     ],
     "at": 16
    }
   ],
   "small": [
    {
     "text": "感激亲密和短暂幸福都涌回来",
     "after": 1,
     "from": [
      "S04-B1"
     ],
     "bars": "92-107",
     "at": 18
    },
    {
     "text": "步子还向前，心里却有更多回声",
     "after": 1,
     "from": [
      "S04-B1"
     ],
     "bars": "92-107",
     "at": 20
    },
    {
     "text": "那份坚定或许只是他想成为的样子",
     "after": 1,
     "from": [
      "S04-B1"
     ],
     "bars": "92-107",
     "at": 22
    },
    {
     "text": "过去太好，想到它反而刺痛",
     "after": 2,
     "from": [
      "S04-B2"
     ],
     "bars": "108-115",
     "at": 24
    },
    {
     "text": "脚步心跳乱了，脑子不停问如果当时",
     "after": 3,
     "from": [
      "S04-B3",
      "S04-B4"
     ],
     "bars": "92-115",
     "at": 26
    },
    {
     "text": "不停往前赶，只为不让自己停下来",
     "after": 4,
     "from": [
      "S04-B4"
     ],
     "bars": "94-115",
     "at": 28
    }
   ],
   "notes": [
    {
     "text": "温柔旋律忽然转为风暴般紧绷",
     "from": [
      "S04-B2"
     ],
     "bars": "108-115"
    },
    {
     "text": "旋律一路向下，像被撕扯着后退",
     "from": [
      "S04-B2"
     ],
     "bars": "108-115"
    },
    {
     "text": "低音不断追赶，旋律急促挣扎",
     "from": [
      "S04-B3"
     ],
     "bars": "92-115"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "他仍觉得当初那些气不该忍",
     "accent": "不该忍",
     "emotion": "炽热",
     "from": [
      "S05-1"
     ],
     "at": 0
    },
    {
     "text": "可他连过去开心的事都不敢多想",
     "accent": "不敢多想",
     "emotion": "不安",
     "from": [
      "S05-1"
     ],
     "at": 6
    },
    {
     "text": "他跟自己争得渐渐没了力气",
     "accent": "没了力气",
     "emotion": "疲惫",
     "from": [
      "S05-2"
     ],
     "at": 12
    },
    {
     "text": "那股不服气慢慢淡了",
     "accent": "慢慢淡了",
     "emotion": "悬着",
     "from": [
      "S05-2"
     ],
     "at": 18
    },
    {
     "text": "想到已不在那些人身边他难受",
     "accent": "不在那些人身边",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ],
     "at": 24
    }
   ],
   "small": [
    {
     "text": "夜色里两个影子低声私语",
     "after": 4,
     "from": [
      "S05-B1"
     ],
     "bars": "116-147",
     "at": 27
    },
    {
     "text": "柔和歌唱里仍有句不能就此算了",
     "after": 0,
     "from": [
      "S05-B2"
     ],
     "bars": "116-127",
     "at": 30
    },
    {
     "text": "愤怒悲伤里还想维护自己",
     "after": 0,
     "from": [
      "S05-B2"
     ],
     "bars": "116-127",
     "at": 33
    },
    {
     "text": "某个人或故乡旧生活，眷恋里有失落",
     "after": 4,
     "from": [
      "S05-B3"
     ],
     "bars": "116-147",
     "at": 36
    },
    {
     "text": "脚下像没了地板，只剩一个声音",
     "after": 4,
     "from": [
      "S05-B4"
     ],
     "bars": "128-129,139-144",
     "at": 39
    },
    {
     "text": "深呼吸般松了一下，其实只是累了",
     "after": 3,
     "from": [
      "S05-B5"
     ],
     "bars": "144-147",
     "at": 42
    }
   ],
   "notes": [
    {
     "text": "快速音流渐渐放慢变稀，最后化成疏落和弦",
     "from": [
      "S05-B4"
     ],
     "bars": "128-147"
    },
    {
     "text": "旋律几乎单独露出来",
     "from": [
      "S05-B4"
     ],
     "bars": "128-129,139-144"
    },
    {
     "text": "躁动之后声音逐渐稀疏下来",
     "from": [
      "S05-B5"
     ],
     "bars": "132-147"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "他想起从前无需时时防备",
     "accent": "无需时时防备",
     "emotion": "亲密",
     "from": [
      "S06-1"
     ],
     "at": 0
    },
    {
     "text": "他很想再有那种默契的亲近",
     "accent": "默契的亲近",
     "emotion": "亲密",
     "from": [
      "S06-3"
     ],
     "at": 7
    },
    {
     "text": "可他怕以后再也没有",
     "accent": "再也没有",
     "emotion": "不安",
     "from": [
      "S06-3"
     ],
     "at": 14
    },
    {
     "text": "想起真有过的日子心里暖了",
     "accent": "心里暖了",
     "emotion": "安心",
     "from": [
      "S06-4"
     ],
     "at": 21
    },
    {
     "text": "安宁短暂现实并没有变好",
     "accent": "现实并没有变好",
     "emotion": "悬着",
     "from": [
      "S06-B1"
     ],
     "at": 28
    }
   ],
   "small": [
    {
     "text": "身边少了他们，才知从前多轻松",
     "after": 0,
     "from": [
      "S06-2"
     ],
     "bars": "",
     "at": 32
    },
    {
     "text": "这回没拿受过的气压住想念",
     "after": 0,
     "from": [
      "S06-1"
     ],
     "bars": "",
     "at": 36
    },
    {
     "text": "玻璃罩般静谧，像母亲轻哼摇篮曲",
     "after": 4,
     "from": [
      "S06-B1"
     ],
     "bars": "148-180",
     "at": 40
    },
    {
     "text": "圣咏般庄严，藏着心事也不必装坚强",
     "after": 4,
     "from": [
      "S06-B2"
     ],
     "bars": "148-180",
     "at": 44
    },
    {
     "text": "委屈愿望思念浮起，祈求未必有回应",
     "after": 4,
     "from": [
      "S06-B2"
     ],
     "bars": "148-180",
     "at": 48
    },
    {
     "text": "远去家园梦里亮起，只远远看着不去抓",
     "after": 3,
     "from": [
      "S06-B2",
      "S06-B4"
     ],
     "bars": "160",
     "at": 52
    }
   ],
   "notes": [
    {
     "text": "绵长的歌唱让周围忽然安静下来",
     "from": [
      "S06-B1"
     ],
     "bars": "148-180"
    },
    {
     "text": "歌唱由试探渐渐展开，临近结尾仍未收住",
     "from": [
      "S06-B3"
     ],
     "bars": "148-180"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "他刚有点安心",
     "accent": "安心",
     "emotion": "安心",
     "from": [
      "S07-1"
     ],
     "at": 0
    },
    {
     "text": "以后难事还得独自扛吗？",
     "accent": "独自扛吗",
     "emotion": "不安",
     "from": [
      "S07-1"
     ],
     "at": 5
    },
    {
     "text": "当初只想不再受那些气",
     "accent": "不再受那些气",
     "emotion": "炽热",
     "from": [
      "S07-2"
     ],
     "at": 10
    },
    {
     "text": "他没料到离开后这么孤单",
     "accent": "这么孤单",
     "emotion": "孤单",
     "from": [
      "S07-2"
     ],
     "at": 15
    },
    {
     "text": "他想找回亲近却不愿再受气",
     "accent": "不愿再受气",
     "emotion": "悬着",
     "from": [
      "S07-3"
     ],
     "at": 20
    }
   ],
   "small": [
    {
     "text": "早知道会这么孤单，他还会走吗？",
     "after": 3,
     "from": [
      "S07-2"
     ],
     "bars": "",
     "at": 23
    },
    {
     "text": "寒风猛地吹开窗，后颈发凉脉搏急跳",
     "after": 1,
     "from": [
      "S07-B1"
     ],
     "bars": "182",
     "at": 27
    },
    {
     "text": "忽然换了场景，心里却未必好转",
     "after": 3,
     "from": [
      "S07-B2"
     ],
     "bars": "182-197",
     "at": 31
    },
    {
     "text": "事像过去了，心里翻转想冲却无出口",
     "after": 4,
     "from": [
      "S07-B3"
     ],
     "bars": "198-205",
     "at": 35
    },
    {
     "text": "离开时的决心也找不着了",
     "after": 4,
     "from": [
      "S07-3"
     ],
     "bars": "",
     "at": 39
    },
    {
     "text": "熟悉动作和舞蹈闯进来，反而照出失去",
     "after": 4,
     "from": [
      "S07-B4"
     ],
     "bars": "181-205",
     "at": 43
    }
   ],
   "notes": [
    {
     "text": "高处忽然响起一串细长的颤动声",
     "from": [
      "S07-B1"
     ],
     "bars": "182"
    },
    {
     "text": "舞步突然闯入，熟悉的舞曲气息却不再完整",
     "from": [
      "S07-B2",
      "S07-B5"
     ],
