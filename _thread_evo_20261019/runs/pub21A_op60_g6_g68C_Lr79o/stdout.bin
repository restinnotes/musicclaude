        \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"还没有失去什么，就已经舍不得了；歌声越美，越让人想多留在这一刻。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"熟悉的亲近又回来\",\n          \"point\": \"上次没说出口的话\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"熟悉的亲近又回来\"\n        },\n        {\n          \"text\": \"这回他几乎想把心意\",\n          \"point\": \"把心意全说出来\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"几乎；也盼对方回应\"\n        },\n        {\n          \"text\": \"可他怕说得太多\",\n          \"point\": \"怕说得太多\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"让对方为难；失去两人原本的自在\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"丰满的声音只剩下一条单薄、孤零零的旋律，在空中漫无目的地游走。\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"一个人从“我与你”的亲密中抽身，转而跌回自己的内心。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份幸福是真实的吗？它能维持多久？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"这回他忘了把喜欢藏起来\",\n          \"point\": \"对方终于看出他有多在乎\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"忘了把喜欢藏起来；终于\"\n        },\n        {\n          \"text\": \"被看出来后\",\n          \"point\": \"怕对方嫌自己太黏\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"被看出来后\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"那份纯净像清凉、空灵的月光，又让人忽然想起童年，或年少时第一次心动的下午。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"年少时第一次心动\"\n        },\n        {\n          \"quote\": \"不是哭泣或崩溃，只是不再努力显得完整。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"也没法陪你走进\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方看出他有多在乎\",\n          \"point\": \"仍像从前一样亲近\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却；像从前一样\"\n        },\n        {\n          \"text\": \"安静时，他想靠近\",\n          \"point\": \"他有点孤单\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方不知道他怕被嫌弃\"\n        },\n        {\n          \"text\": \"他又想\",\n          \"point\": \"会不会也舍不得\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又想；和自己这样相处\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"原先压着的感受反而变成了动力。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"压着的感受变成动力\"\n        },\n        {\n          \"quote\": \"你明知道自己正在被卷进去，却暂时不想出来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这一刻纵然完美，你也没有办法让它停住。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方总愿意陪他\",\n          \"point\": \"或许也被需要\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方总愿意陪他；或许