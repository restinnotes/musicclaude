      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "刚才那点熟悉的暖意转眼远了；他忽然拿不准，自己是想回去，还是只想在难过时有人陪着。",
      "key": "刚才那点熟悉的暖",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-2",
       "S08-1",
       "S08-2"
      ]
     },
     {
      "id": "S09-2",
      "text": "他胸口一紧，刚要继续想，脑子却一下空了。",
      "key": "他胸口一紧，刚要",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S07-2",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S08-1",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S08-2",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S09-1",
      "to": "S09-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "216–225",
    "relation": "正在面对",
    "items": [
     {
      "id": "S10-1",
      "text": "他又记起当初那些忍下去的委屈，心里仍不好受，没法因为舍不得就当它们没有发生。",
      "key": "他又记起当初那些",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1"
      ]
     },
     {
      "id": "S10-2",
      "text": "他舍不得的是从前有人把他当自己人的日子，可回去以后还能不能那样，他心里没底。",
      "key": "他舍不得的是从前",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-3",
       "S03-2",
       "S06-2",
       "S10-1"
      ]
     },
     {
      "id": "S10-3",
      "text": "他想了半天，还是不知道该不该回去；再这么耗下去，眼下的日子也过不好。",
      "key": "他想了半天，还是",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-1",
       "S10-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S01-1",
      "to": "S10-1",
      "rel": "引用"
