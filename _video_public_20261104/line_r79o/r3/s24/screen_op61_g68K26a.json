       "from": [
        "S04-B3",
        "S04-B4"
       ],
       "bars": "92-115",
       "at": 27.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "没走的话，如今又会怎样？",
     "keys": [
      "又会怎样"
     ],
     "emotion": "悬着",
     "from": [
      "S04-2"
     ],
     "at": 22.0
    }
   ],
   "notes": [
    {
     "text": "熟悉的波兰舞曲主题重新出现，伴奏更流动",
     "bars": "92-107",
     "from": [
      "S04-B1"
     ]
    },
    {
     "text": "音乐忽然激烈紧绷，半音阶一路向下",
     "bars": "108-115",
     "from": [
      "S04-B2"
     ]
    },
    {
     "text": "左手低音追赶，右手细碎音符急促翻涌",
     "bars": "92-115",
     "from": [
      "S04-B3"
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "rows": [
    {
     "kind": "line",
     "text": "他仍觉得当初那些气不该忍，却也不敢多想开心的事",
     "keys": [
      "那些气不该忍"
     ],
     "emotion": "炽热",
     "from": [
      "S05-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "两只手像夜色里的两个影子，彼此低声说话",
       "bead": "S05-B1",
       "from": [
        "S05-B1"
       ],
       "bars": "116-147",
       "at": 7.0
      },
      {
       "text": "柔和歌唱里仍有股劲，像在说这事不能算了",
       "bead": "S05-B2",
       "from": [
        "S05-B2"
       ],
       "bars": "116-127",
       "at": 15.0
      },
      {
       "text": "旧日记忆又有了温度，可能是某个人、故乡或过去的生活",
       "bead": "S05-B3",
       "from": [
        "S05-B3"
       ],
       "bars": "116-147",
       "at": 35.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "争到没力气后不服气淡了，只剩离开他们的难受",
