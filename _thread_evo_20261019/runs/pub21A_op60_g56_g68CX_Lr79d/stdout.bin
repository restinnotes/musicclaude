{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"先向高处迸发，细碎的光点再缓缓飘落。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这里是刚刚踏上船板的感觉，还不是整个人已经安稳地交给规律起伏的水浪。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"忽然\"\n        },\n        {\n          \"text\": \"怕让对方为难\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"怕让对方为难\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"裹在皮肤上有些黏稠。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它没有继续冲向高潮，而像轻轻呼出一口气，重新回到柔和。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"因为太喜欢眼前的东西，所以还没有失去，就已经生出一丝舍不得\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没失去，就已舍不得\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"慢慢放松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没有退开，仍愿意亲近\"\n        },\n        {\n          \"text\": \"他也想靠近些\",\n      