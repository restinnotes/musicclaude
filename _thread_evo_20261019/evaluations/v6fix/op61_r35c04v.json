      "rel": "引用"
     },
     {
      "from": "S01-1",
      "to": "S10-2",
      "rel": "引用"
     },
     {
      "from": "S06-2",
      "to": "S10-2",
      "rel": "引用"
     },
     {
      "from": "S02-2",
