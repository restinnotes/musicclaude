   },
   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "正在面对",
    "items": [
     {
      "id": "S08-1",
      "text": "他又想起从前那种不用顾虑的亲近，心里短短地柔和了一下。",
      "key": "他又想起从前那种",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2",
       "S07-4"
      ]
     },
     {
      "id": "S08-2",
      "text": "可那份踏实还没留住，他又意识到自己与旧日早有距离，心里满是不舍。",
      "key": "可那份踏实还没留",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1",
       "S01-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-2",
      "to": "S08-1",
      "rel": "引用"
     },
     {
      "from": "S07-4",
