    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "只敢藏起一点喜欢",
       "detail": "怕自己的需要变成负担；这点亲近已够甜，他还不知下次能否坦白。",
       "keys": [],
       "from": [
        "S01-2",
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "一说出口就变了",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      },
      {
       "text": "越清楚越谨慎",
