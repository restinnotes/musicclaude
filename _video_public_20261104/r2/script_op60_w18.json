 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我忽然想靠近对方，连自己也意外，心里一热。",
       "keys": [],
       "from": [
        "S01-1",
        "S01-2",
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "烟花迸开",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
      },
      {
       "text": "一瞬失重",
       "keys": [],
       "from": [
        "S01-B2-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕给对方添负担，只敢露一点喜欢；这点亲近已很甜，还不知下次能否更坦白。",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "一说出口就变了",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      },
      {
       "text": "越清楚越谨慎",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没因我露出在意而退开，我才慢慢放松。",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "呼吸贴在一起",
       "keys": [],
       "from": [
        "S02-B1-p1"
       ],
       "emotion": "亲密"
      },
      {
       "text": "沉默也舒服",
       "keys": [],
       "from": [
        "S02-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我也想顺势靠近，喜欢几乎藏不住，却怕太急坏了自在，便收住。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "喜欢忽然涌上来",
       "keys": [],
       "from": [
        "S02-B3-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "轻轻吐口气",
       "keys": [],
       "from": [
        "S02-B3-p2"
       ],
       "emotion": "安心"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "相处越好，越怕时刻过去，未分开已先舍不得。",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "甜得发酸",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ],
       "emotion": "亲密"
      },
      {
       "text": "还没分开就舍不得",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ],
       "emotion": "亲密"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "可我难得不想以后，只想安心待在这份亲近里。",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体晃着漂着",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "不必赶去哪里",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "相处中我忽然想说喜欢这样，也想问对方是否一样；没想好怎么开口，念头便淡了。",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急着说一句",
       "keys": [],
       "from": [
        "S03-B2-p1"
       ]
      },
      {
       "text": "又沉回去",
       "keys": [],
       "from": [
        "S03-B2-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "熟悉的亲近让我欢喜，也让我想起上回没说出口的话。",
       "keys": [],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "耳边低语",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      },
      {
       "text": "忍不住再说一遍",
       "keys": [],
       "from": [
        "S04-B1-p6"
       ]
      }
     ]
    },
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "我几乎想把藏着的话都说出来，盼对方也喜欢我坦然的样子。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "话哽在喉咙",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "水波推着往前",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "抱紧不愿松手",
       "keys": [],
       "from": [
        "S04-B3-p3"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我盼说出口能留住眼下的好，却怕一下说多了让对方为难、弄丢原有自在，还是留了些话。",
       "keys": [],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "每一秒都在倒数",
       "keys": [],
       "from": [
        "S04-B4-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "前几次忍住，对方仍愿亲近我，这回我便不知不觉忘了藏喜欢。",
       "keys": [],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "攥紧的劲退了",
       "keys": [],
       "from": [
        "S05-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "藏着还能装不在乎；被看穿后心里空落，连相处都没把握，怕对方嫌我黏，亲近也像隔层。",
       "keys": [],
       "from": [
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "脚下没了支撑",
       "keys": [],
       "from": [
        "S05-B2-p3"
       ]
      },
      {
       "text": "退回自己心里",
       "keys": [],
       "from": [
        "S05-B3-p2"
       ]
      },
      {
       "text": "这幸福是真的吗？",
       "keys": [],
       "from": [
        "S05-B3-p3"
       ],
       "emotion": "悬着"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这回对方看出我有多在乎，却待我如常，我才又自在起来。",
       "keys": [],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "摇摆又回来",
       "keys": [],
       "from": [
        "S06-B1-p2"
       ]
      },
      {
       "text": "想起第一次心动",
       "keys": [],
       "from": [
        "S06-B1-p5"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "安静下来后，我想到对方根本不知道我刚才有多怕被嫌弃，忽然觉得孤单。",
       "keys": [],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "没人能陪到心底",
       "keys": [],
       "from": [
        "S06-B3-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我又想：对方一直没退开，会不会也舍不得这份亲近？",
       "keys": [],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的气味",
       "keys": [],
       "from": [
        "S06-B4-p2"
       ]
      },
      {
       "text": "幻想和遗憾混在一起",
       "keys": [],
       "from": [
        "S06-B4-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起这些日子对方总愿和我待着，我渐渐觉得，对方也许需要我陪，和我在一起也安心。",
       "keys": [],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "脉搏沉沉地跳",
       "keys": [],
       "from": [
        "S07-B1-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "渴望往上涌",
       "keys": [],
       "from": [
        "S07-B1-p2"
       ],
       "emotion": "炽热"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到这点，我高兴得舍不得抽身。",
       "keys": [],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2-p5"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "盼对方以后想找人陪还会想到我，也盼自己能一直陪在对方身边。",
       "keys": [],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "这一刻留不住",
       "keys": [],
       "from": [
        "S07-B3-p3"
       ],
       "emotion": "孤单"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "上回无意露了心意，对方仍愿亲近；这回我才想主动些、坦然回应，也盼我们或许还能好很久。",
       "keys": [],
       "from": [
        "S08-1",
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不再防着",
       "keys": [],
       "from": [
        "S08-B1-p2"
       ],
       "emotion": "安心"
      },
      {
       "text": "不再分析",
       "keys": [],
       "from": [
        "S08-B1-p2"
       ],
       "emotion": "安心"
      },
      {
       "text": "身体轻快",
       "keys": [],
       "from": [
        "S08-B2-p2"
       ]
      },
      {
       "text": "你来我往地逗趣",
       "keys": [],
       "from": [
        "S08-B2-p3"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可今天再好，也不代表以后每天都如此。",
       "keys": [],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "快乐余温还在",
       "keys": [],
       "from": [
        "S08-B3-p3"
       ],
       "emotion": "欢喜"
      },
      {
       "text": "心里泛起怀念",
       "keys": [],
       "from": [
        "S08-B3-p3"
       ],
       "emotion": "孤单"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "没底渐成担心：有天对方不再需要我，甚至不愿与我待着；刚才还敢盼那么远，此刻却安静下来，不敢再想。",
       "keys": [],
       "from": [
        "S09-1",
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "对视时屏住呼吸",
       "keys": [],
       "from": [
        "S09-B1-p4"
       ]
      },
      {
       "text": "渴望还在",
       "keys": [],
       "from": [
        "S09-B1-p4"
       ]
      },
      {
       "text": "那股劲还绷着",
       "keys": [],
       "from": [
        "S09-B1-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可对方一直没退开，眼下仍亲近；也许喜欢我陪着，我还是有点高兴。",
       "keys": [],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "眼前还有别的美好",
       "keys": [],
       "from": [
        "S09-B4-p1"
       ],
       "emotion": "欢喜"
      },
      {
       "text": "不安暂时退到一旁",
       "keys": [],
       "from": [
        "S09-B4-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "怕再猜下去连今天也过不踏实，我便先享受眼前亲近；紧绷渐松，心里亮堂得几乎想笑，又有点想哭。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "眼泪不用忍",
       "keys": [],
       "from": [
        "S10-B1-p2"
       ]
      },
      {
       "text": "心事还没解决",
       "keys": [],
       "from": [
        "S10-B1-p3"
       ],
       "emotion": "不安"
      },
      {
       "text": "明亮得想哭",
       "keys": [],
       "from": [
        "S10-B1-p4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "轻松过去后，我想：即使对方以后不需要我，我也愿陪着，不再藏喜欢；我高兴得顾不上害臊，觉得这么在乎也没什么不好。",
       "keys": [],
       "from": [
        "S11-1",
        "S11-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "这是我的感情",
       "keys": [],
       "from": [
        "S11-B1-p3"
       ]
      },
      {
       "text": "不再为喜欢道歉",
       "keys": [],
       "from": [
        "S11-B1-p3"
       ]
      },
      {
       "text": "熟悉的温柔又回来",
       "keys": [],
       "from": [
        "S11-B2-p3"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可对方以后愿不愿意，不由我决定；想到这点，刚才的欢喜便压得我心口发疼。",
       "keys": [],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "胸口压得发痛",
       "keys": [],
       "from": [
        "S11-B4-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "可我这会儿只想把能给的都给对方，连对方是否同样在乎我也顾不上。",
       "keys": [],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里的话一下放大",
       "keys": [],
       "from": [
        "S12-B1-p2"
       ]
      },
      {
       "text": "暂时顾不上自己",
       "keys": [],
       "from": [
        "S12-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "明知再用心也不能保证以后仍这么好，我还是嫌眼下不够，想多陪一会儿。",
       "keys": [],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "还想要更多",
       "keys": [],
       "from": [
        "S12-B2-p2"
       ],
       "emotion": "炽热"
      },
      {
       "text": "那口气一直悬着",
       "keys": [],
       "from": [
        "S12-B2-p3"
       ],
       "emotion": "悬着"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "那阵高兴终于涌出来，我不再收着，只管尽情喜欢。",
       "keys": [],
       "from": [
        "S12-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "喉咙发紧",
       "keys": [],
       "from": [
        "S12-B3-p3"
       ]
      },
      {
