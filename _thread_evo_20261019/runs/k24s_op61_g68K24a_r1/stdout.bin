"],\n          \"at\": 56\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"珍惜的东西仿佛还在却难拥有\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\",\n          \"at\": 0\n        },\n        {\n          \"text\": \"他整理衣服抬头藏起动摇\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"24–65\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"第一遍还信第二遍开始劝自己\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"44–65\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"说到第三遍才露出在意\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"44–65\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"不甘心就这样消亡\",\n          \"after\": 4,\n          \"from\": [\"S02-B5\"],\n          \"bars\": \"44–65\",\n          \"at\": 56\n        },\n        {\n          \"text\": \"怕一心软就忘了当初为何离开\",\n          \"after\": 3,\n          \"from\": [\"S02-2\"],\n          \"bars\": \"\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"庄严的舞步带着面向众人的气势\",\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"旋律像远处旧歌只能哼出几句\",\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"听来没有英雄凯旋的痛快劲\",\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"舞步不像士兵更像腿脚虚浮地挪动\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"底下细碎不安的声音一直在动\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"旋律猛地往上推又退回来\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"38–43\"\n        },\n        {\n          \"text\": \"后半段力量聚拢却始终没落稳\",\n          \"from\": [\"S02-B3\"],