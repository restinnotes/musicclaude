        "更孤单"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他已经能靠自己的劳动把外面的日子维持起来，回去却会牵动现在的谋生安排和独立性",
