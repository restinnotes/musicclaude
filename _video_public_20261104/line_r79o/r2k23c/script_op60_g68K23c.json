 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然想靠近，连自己都觉得意外。",
       "keys": [
        "想靠近",
        "觉得意外"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "怕自己的需要太重，话到嘴边先沉默",
       "keys": [],
       "from": [
        "S01-2"
       ],
       "bead": "S01-2"
      },
      {
       "text": "只敢露出一点喜欢",
       "keys": [],
       "from": [
        "S01-2"
       ],
       "bead": "S01-2"
      },
      {
       "text": "这点亲近已很甜，下次能否更坦白",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方仍愿亲近，他才渐渐放松。",
       "keys": [
        "仍愿亲近",
        "渐渐放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩膀挨着肩膀，连呼吸都贴近",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "身体交给船底托举，水却一直流",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "喜欢几乎藏不住，怕太急，还是收住了",
       "keys": [],
       "from": [
        "S02-2"
       ],
       "bead": "S02-2"
      },
      {
       "text": "还没分开，心里已先鼻酸",
       "keys": [],
       "from": [
        "S02-3"
       ],
       "bead": "S02-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他暂且不想以后，只想安稳待在亲近里。",
       "keys": [
        "不想以后",
        "安稳待在亲近里"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "沉默也舒服，心却慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "想说喜欢，也想问对方是否一样",
       "keys": [],
       "from": [
        "S03-2"
       ],
       "bead": "S03-2"
      },
      {
       "text": "没想好怎么开口，念头便淡了",
       "keys": [],
       "from": [
        "S03-2"
       ],
       "bead": "S03-2"
      },
      {
       "text": "思绪像风吹碎的倒影，闪烁难拼",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他想把心里话说尽，也盼对方喜欢坦白的自己。",
       "keys": [
        "把心里话说尽",
        "喜欢坦白的自己"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的亲近回来，又想起上回没开口",
       "keys": [],
       "from": [
        "S04-1"
       ],
       "bead": "S04-1"
      },
      {
       "text": "想抱紧当下，水面反而颠簸起来",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "还没失去什么，心里已先舍不得",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "怕说太多让对方为难，最后仍留了话",
       "keys": [],
       "from": [
        "S04-3"
       ],
       "bead": "S04-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "几次收住后，对方仍亲近，这回他却没藏住在乎。",
       "keys": [
        "对方仍亲近",
        "没藏住在乎"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里空落落的，不知怎么相处",
       "keys": [],
       "from": [
        "S05-2"
       ],
       "bead": "S05-2"
      },
      {
       "text": "怕对方嫌他太黏，亲近像隔了一层",
       "keys": [],
       "from": [
        "S05-3"
       ],
       "bead": "S05-3"
      },
      {
       "text": "像终于能深吸一口气",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他的在乎，仍照常亲近，他才自在。",
       "keys": [
        "看出他的在乎",
        "仍照常亲近"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "还想靠近却怕要太多，算了又放不下",
       "keys": [],
       "from": [
        "S06-2"
       ],
       "bead": "S06-2"
      },
      {
       "text": "白天相处得好，独处时心头却泛酸",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "气味、身体感觉、幻想、遗憾和快感交织",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      },
      {
       "text": "对方始终没退开，他猜对方是否也舍不得",
       "keys": [],
       "from": [
        "S06-3"
       ],
       "bead": "S06-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他觉得对方或许也需要自己，跟他在一起能安心。",
       "keys": [
        "或许也需要自己",
        "能安心"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "想到或许能互相依靠，高兴得收不住",
       "keys": [],
       "from": [
        "S07-2"
       ],
       "bead": "S07-2"
      },
      {
       "text": "心里忽然一紧，却仍想这样待着",
       "keys": [],
       "from": [
        "S07-2"
       ],
       "bead": "S07-2"
      },
      {
       "text": "盼对方需要陪伴时，还会想到自己",
       "keys": [],
       "from": [
        "S07-3"
       ],
       "bead": "S07-3"
      },
      {
       "text": "美好还在，时间却已经往前走",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他见对方依旧亲近，想大方回应这份心意。",
       "keys": [
        "依旧亲近",
        "大方回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体恢复弹性，带着调情般的玩心",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      },
      {
       "text": "他开始盼以后，觉得还能好很久",
       "keys": [],
       "from": [
        "S08-2"
       ],
       "bead": "S08-2"
      },
      {
       "text": "眼下亲近未必长久，他心里仍没底",
       "keys": [],
       "from": [
        "S08-3"
       ],
       "bead": "S08-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方有天不再需要他陪，连相处都不愿。",
       "keys": [
        "不再需要他陪",
        "连相处都不愿"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他一下安静下来，不敢再往远处想",
       "keys": [],
       "from": [
        "S09-2"
       ],
       "bead": "S09-2"
      },
      {
       "text": "刚才那是真的吗？接下来怎么办",
       "keys": [],
       "from": [
        "S09-B3"
       ],
       "bead": "S09-B3"
      },
      {
       "text": "抬头看夜空，美好比自己的愿望更大",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      },
      {
       "text": "对方没退开，也许也喜欢他在身边",
       "keys": [],
       "from": [
        "S09-3"
       ],
       "bead": "S09-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "再猜下去连今天也难安心，他先享受眼前亲近。",
       "keys": [
        "连今天也难安心",
        "享受眼前亲近"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩膀终于松开，心里亮得想笑也想哭",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "时间松开，像忽然有了一小块空地",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "身体失去重量，悬在夏夜微风里",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "即使对方不需要，他仍愿陪着，不再藏爱，也不为爱道歉。",
       "keys": [
        "仍愿陪着",
        "不再藏爱"
       ],
       "from": [
        "S11-1",
        "S11-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "想到彼此有时都需要对方，高兴得顾不上害臊",
       "keys": [],
       "from": [
        "S11-1"
       ],
       "bead": "S11-1"
      },
      {
       "text": "以后对方还愿不愿让他陪，他说了不算",
       "keys": [],
       "from": [
        "S11-3"
       ],
       "bead": "S11-3"
      },
      {
       "text": "灿烂像血红金亮的夕阳，刺眼得想流泪",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      },
      {
       "text": "多年后走进旧房子，熟悉的温柔反而心疼",
       "keys": [],
       "from": [
        "S11-B4"
       ],
       "bead": "S11-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "高兴终于涌出来，他不再压着喜欢。",
       "keys": [
        "高兴终于涌出来",
        "不再压着喜欢"
       ],
       "from": [
        "S12-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "只想把能给的都给对方，让他安心",
       "keys": [],
       "from": [
        "S12-1"
       ],
       "bead": "S12-1"
      },
      {
       "text": "整个人像被卷进比自己更大的世界",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      },
      {
       "text": "像久别重逢，抱紧对方久久不松手",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      },
      {
       "text": "再用心也无法保证以后，他仍想多陪一会儿",
       "keys": [],
       "from": [
        "S12-2"
       ],
       "bead": "S12-2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方不再需要自己，连相处也会失去。",
       "keys": [
        "不再需要自己",
        "连相处也会失去"
       ],
       "from": [
        "S13-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "想听他说以后不变，相处时光却飞快：真能一直吗",
       "keys": [],
       "from": [
        "S13-1"
       ],
       "bead": "S13-1"
      },
      {
       "text": "幸福没消失，悲伤却进了幸福里面",
       "keys": [],
       "from": [
        "S13-B2"
       ],
       "bead": "S13-B2"
      },
      {
       "text": "刚说了「是」，心里马上追问：「可是呢？」",
       "keys": [],
       "from": [
        "S13-B3"
       ],
       "bead": "S13-B3"
      },
      {
       "text": "想少露心意，盼着少疼些；可真心藏回去更难受",
       "keys": [],
       "from": [
        "S13-2"
       ],
       "bead": "S13-2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S14",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他仍舍不得，也不知以后怎样，却不再逼自己讨永远不变的保证。",
       "keys": [
        "仍舍不得",
        "不再逼自己讨"
       ],
       "from": [
        "S14-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "如今仍亲近，心里又甜又酸，却不后悔",
       "keys": [],
       "from": [
        "S14-1"
       ],
       "bead": "S14-1"
      },
      {
       "text": "心意已被看见，他不再藏，往后到了再说",
       "keys": [],
       "from": [
        "S14-3"
       ],
       "bead": "S14-3"
      },
      {
       "text": "像低沉男声独自沉思",
       "keys": [],
       "from": [
        "S14-B2"
       ],
       "bead": "S14-B2"
      },
      {
       "text": "像从美梦醒来，心里还留着光",
       "keys": [],
       "from": [
        "S14-B1"
       ],
       "bead": "S14-B1"
      }
     ]
    }
   ]
  }
 ]
}