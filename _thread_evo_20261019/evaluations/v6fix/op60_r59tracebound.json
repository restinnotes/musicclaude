      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "78–83",
    "relation": "没在想",
    "items": [
     {
      "id": "S10-1",
      "text": "他终于愿意暂时不去猜那一天会不会到来，而是先享受眼前两个人仍然能够亲近的欢喜。",
      "key": "他终于愿意暂时不",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-1",
       "S09-3"
      ]
     },
     {
      "id": "S10-2",
      "text": "此前的紧绷慢慢松开，他心里重新亮起来，几乎既想笑又想哭。",
      "key": "此前的紧绷慢慢松",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-1"
      ]
     }
    ],
    "because": [
     {
