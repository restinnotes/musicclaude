  {\n          \"text\": \"他怕对方嫌自己太黏\",\n          \"point\": \"亲近在心里也像隔了一层\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕对方嫌自己太黏\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"空气一下凉了。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"没了\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是哭泣或崩溃，只是不再努力显得完整。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是哭泣或崩溃\"\n        },\n        {\n          \"quote\": \"恍惚间却像已经成了回忆。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"眼前却已像回忆\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方看出他有多在乎\",\n          \"point\": \"他又自在起来\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"相处却一点没变\"\n        },\n        {\n          \"text\": \"他想到对方不知道\",\n          \"point\": \"忽然有点孤单\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"自己刚才有多怕被嫌弃\"\n        },\n        {\n          \"text\": \"对方一直没退开\",\n          \"point\": \"对方会不会也舍不得结束\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方一直没退开\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"那热度甚至像情欲、执念与对生的眷恋，从心底一齐翻涌上来。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"情欲、执念与对生的眷恋\"\n        },\n        {\n          \"quote\": \"你明知道自己正在被卷进去，却暂时不想出来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"明知正被卷进去\"\n        },\n        {\n          \"quote\": \"这一刻纵然完美，你也没有办法让它停住。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n    