#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-main-menu .wixui-vertical-menu__item-label {
   padding: 34px 0 6px;
   color: inherit;
}

 #SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-selection-tags {
   padding-left: 0;
} 

#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-close-button {
    cursor: pointer;
}

#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-circana-close-button-default {
    cursor: default;
}




/* Start linkedinFeedContainer */
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-feedItem {
    border: 1px solid #ddd;
    padding: 10px;
    margin-bottom: 15px;
    border-radius: 5px;
}

#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-feedItem img {
    max-width: 100%;
    height: auto;
    border-radius: 5px;
}

#SITE_CONTAINER #main_MF#main_MF .css-editing-scope #wixui-feedContainer {
    display: flex;
    flex-direction: column;
    gap: 20px;
}
  /* End linkedinFeedContainer */

   /* Start Post Lead form*/

   #SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-lead-form-box {
    background: #4E106F;
    color: #fff;
    padding: 30px;
    border-radius: 10px;
    font-family: "Roboto Condensed", serif;
    
}
   /* End Post Lead form*/

/** Start: Fixes for Web5 popover to not being seen through over web5 */
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-search-results-container, 
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-resource-menu, 
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-company-menu, 
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-solutions-menu, 
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-industries-menu {
    background-color: #fff;
}
/** End: Fixes for Web5 popover to not being seen through over web5 */


</style>


