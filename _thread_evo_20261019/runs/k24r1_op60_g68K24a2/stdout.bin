{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然很想靠近这个人\",\n          \"accent\": \"很想靠近\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"怕自己太需要这份亲近\",\n          \"accent\": \"太需要\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"只敢露出一点喜欢\",\n          \"accent\": \"\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"这一点亲近已经很甜\",\n          \"accent\": \"很甜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S01-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"下次能否更坦白些，他还拿不准\",\n          \"after\": 3,\n          \"from\": [\"S01-3\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"话到嘴边沉默几秒，怕关系因此改变\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"刚踏上船板，木板微晃，身体一轻\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 14\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"和弦像烟花迸起，落下仍悬着，摇荡未成形\",\n          \"from\": [\"S01-B1\", \"S01-B3\"],\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没因他的在意退开\",\n          \"accent\": \"没退开\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他这才慢慢放松下来\",\n          \"accent\": \"放松\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"喜欢几乎藏不住他还是收住了\",\n          \"accent\": \"藏不住\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"眼下这么好他已先有些舍不得\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 32\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"肩膀挨着肩膀，呼吸和体温都贴近\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"像熟人安静坐着，沉默也不紧张\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"夏末温热潮湿的风裹在皮肤上\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"身体交给船底托着，水和时间仍在流\",\n          \"after\": 1,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"喜欢忽然涌上来，连呼吸都变了\",\n          \"after\": 2,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"甜蜜像根温柔的刺，鼻酸又想慢些\",\n          \"after\": 3,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7–11\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声未起，左手已一下一下摇着\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–5\"\n        },\n        {\n          \"text\": \"两条旋律贴得很近，像耳边低语\",\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\"\n        },\n        {\n          \"text\": \"歌声上涌后又轻轻收回\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不去想两个人的以后\",\n          \"accent\": \"不去想\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"只想舒服地待在这份亲近里\",\n          \"accent\": \"舒服地\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"想说喜欢也想问对方是否一样\",\n          \"accent\": \"是否一样\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"没想好怎么开口念头就淡了\",\n          \"accent\": \"\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 23\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"亲密交谈后安静下来，沉默很舒服\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"水波托着身体，摇晃漂浮不去哪里\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"身体还在这里，心却慢慢漂远\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"急着表达的念头露头又沉回去\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20–21\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"思绪像被风吹碎的倒影，粼粼难拼\",\n          \"after\": 3,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"谈话碰到解不开的结，顺畅里生阻力\",\n          \"after\": 3,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声渐退，只剩流动盘旋\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"摇曳中冒出几句短促急切的声音\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20–21\"\n        },\n        {\n          \"text\": \"流动忽然受阻，声音绕远滞留\",\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20–22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又让他满心欢喜\",\n          \"accent\": \"满心欢喜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\", \"S04-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"上回没说的话这次几乎冲出口\",\n          \"accent\": \"冲出口\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-1\", \"S04-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"他盼对方也喜欢他坦白些\",\n          \"accent\": \"坦白些\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-2\"],\n          \"at\": 15\n        },\n        {\n          \"text\": \"又怕说太多让对方为难\",\n          \"accent\": \"为难\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 24\n        },\n        {\n          \"text\": \"怕失去自在最后还是留了话\",\n          \"accent\": \"留了话\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-3\"],\n          \"at\": 34\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"两道声线贴耳低语，呼吸挨得很近\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"像讲往事越说越快，忍不住补细节\",\n          \"after\": 1,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"最后一道夕阳金光亮得几乎刺眼\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"话到喉咙口，颤着声几乎哽咽\",\n          \"after\": 3,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"手越握越紧，越想抱住当下越失衡\",\n          \"after\": 3,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"美好还在，水波像倒数，越美越鼻酸\",\n          \"after\": 4,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉歌声重现，花腔更华丽急切\",\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"高处长颤音悬住，随后渐渐收弱\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\"\n        },\n        {\n          \"text\": \"左手水波不停向前，摇荡渐渐放慢\",\n          \"from\": [\"S04-B2\", \"S04-B4\"],\n          \"bars\": \"24–34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"喜欢没藏住对方看出他在乎\",\n          \"accent\": \"看出他在乎\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"心里空落落连相处都拿不准\",\n          \"accent\": \"空落落\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"怕对方嫌太黏亲近像隔层\",\n          \"accent\": \"像隔层\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-3\"],\n          \"at\": 6\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"小船像漂进起雾的水域\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"交谈停了，他跌回自己的心里\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"幸福是真的吗？能维持多久？\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 12\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"饱满摇荡忽然抽空，只剩单线旋律\",\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\"\n        },\n        {\n          \"text\": \"贴近的耳语像突然中断\",\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\"\n        },\n        {\n          \"text\": \"旋律像松开紧握的手，终于深吸气\",\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他的在乎却一点没变\",\n          \"accent\": \"一点没变\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他终于又能像从前那样自在\",\n          \"accent\": \"自在\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"安静时还想靠近又怕要太多\",\n          \"accent\": \"怕要太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他孤单地猜对方会不会舍不得\",\n          \"accent\": \"会不会舍不得\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\", \"S06-3\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"这份沉醉越舒服越失去方向\",\n          \"accent\": \"失去方向\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S06-B4\"],\n          \"at\": 28\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"暖金水面滑入古桥阴影，空气凉了\",\n          \"after\": 1,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"清凉月光般纯净，想起童年初恋\",\n          \"after\": 1,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"心里反复说算了，可还是放不下\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"说着说着，不再努力显得完整\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"白天很好，夜里泛酸，时光恍惚像回忆\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 29\n        },\n        {\n          \"text\": \"气味身体幻想遗憾快感混在一起\",\n          \"after\": 4,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 30\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇摆变轻，伴奏碎成细密水纹\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"旋律压低，另一条声线不时回应\",\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他开始觉得对方有时也需要他\",\n          \"accent\": \"也需要他\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到能互相依靠他高兴又心紧\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他盼着对方以后还会想到自己\",\n          \"accent\": \"想到自己\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-3\"],\n          \"at\": 15\n        },\n        {\n          \"text\": \"自己也想一直陪在对方身边\",\n          \"accent\": \"一直陪\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-3\"],\n          \"at\": 25\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"安静享受已不够，深处渴望推着往前\",\n          \"after\": 1,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"情欲执念和对生命的眷恋一齐翻涌\",\n          \"after\": 1,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"气味身体感觉幻想遗憾快感混在一起\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"带着情色暖意，明知被卷入却不想出来\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"越舒服越失去方向\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"这一刻仍然很美，时间却一直经过\",\n          \"after\": 3,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 32\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏变密，低音像沉重脉搏，暗涌攀爬\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"对方依然亲近他想大方回应\",\n          \"accent\": \"大方回应\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他开始盼着两个人能好很久\",\n          \"accent\": \"好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"眼下亲近不等于以后也会这样\",\n          \"accent\": \"不等于\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-3\"],\n          \"at\": 22\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"歌声像重新接触阳光和风\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"身体恢复弹性，带着一点玩心\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"像轻快的调情和回应\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"快乐余温还在，心里先泛起怀念\",\n          \"after\": 2,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\",\n          \"at\": 26\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌句舒展直接，情绪一再抬高\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌声向上散开，随后戛然而止\",\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他忽然怕对方有天不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"连和他待着都不自在了呢？\",\n          \"accent\": \"不自在\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"他一下安静下来不敢再想以后\",\n          \"accent\": \"不敢再想\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"可眼下对方没退开亲近是真的\",\n          \"accent\": \"亲近是真的\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S09-3\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"也许对方也喜欢他在身边\",\n          \"accent\": \"也许\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"],\n          \"at\": 23\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像话到要紧处顿住，两人对视屏息\",\n          \"after\": 2,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"强烈渴望还在，却引而不发\",\n          \"after\": 2,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"阳光隔着薄雾，注意力反而集中\",\n          \"after\": 2,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"他反复听着余响：刚才是真的吗？\",\n          \"after\": 2,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"抬头看夜空，美好比自己的愿望更大\",\n          \"after\": 3,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"不安还没得到回答，却暂时没占满心思\",\n          \"after\": 4,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇摆退开，颤音与轻和弦悬在半空\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\"\n        },\n        {\n          \"text\": \"声音一层层下沉，明亮渐被薄雾遮住\",\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他不再猜以后先享受眼前亲近\",\n          \"accent\": \"享受眼前\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"绷紧的肩终于松开胸腔打开\",\n          \"accent\": \"终于松开\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-B1\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"心里亮得几乎想笑也想哭\",\n          \"accent\": \"想笑也想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\", \"S10-B1\"],\n          \"at\": 14\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"心事没解决，这一刻不必再忍着\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"时间像空出一小块地方，暂时不用往前\",\n          \"after\": 0,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"这片空地很短，像终于呼出一口气\",\n          \"after\": 1,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"身体轻得像灵魂飘在夏夜微风里\",\n          \"after\": 2,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\",\n          \"at\": 20\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高音细亮如银色蛛丝和细雨\",\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"一串琶音像飞瀑清亮落进水里\",\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"80–83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近忽然变得异常真实\",\n          \"accent\": \"异常真实\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他需要对方对方有时也需要自己\",\n          \"accent\": \"也需要自己\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"对方不需要他他也愿意陪着\",\n          \"accent\": \"也愿意陪着\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 11\n        },\n        {\n          \"text\": \"他不再藏着喜欢\",\n          \"accent\": \"不再藏着\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\", \"S11-2\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"往后还让不让他陪他做不了主\",\n          \"accent\": \"做不了主\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"想到未必总能这样亲近，欢喜压得心口疼\",\n          \"after\": 4,\n          \"from\": [\"S11-3\", \"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"像血红金亮的夕阳，刺得人想流泪\",\n          \"after\": 0,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"多年后重回旧房子，熟悉却有新重量\",\n          \"after\": 0,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"知道它多珍贵，心里反而更容易疼\",\n          \"after\": 0,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"等了很久的期待，像终于得到回应\",\n          \"after\": 0,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\",\n          \"at\": 26\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"厚重和弦托起歌声，水波翻成巨浪\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"铺开的力量短暂悬在半空\",\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他只想把能给的都给对方\",\n          \"accent\": \"都给对方\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他像被更大的世界整个卷进去\",\n          \"accent\": \"更大的世界\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-B1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"明知用心也留不住以后的好\",\n          \"accent\": \"留不住\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"还是想多陪对方一会儿\",\n          \"accent\": \"多陪一会儿\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-2\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"高兴终于涌出来他不再收着\",\n          \"accent\": \"不再收着\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S12-3\"],\n          \"at\": 27\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他顾不上对方是否同样在乎\",\n          \"after\": 0,\n          \"from\": [\"S12-1\"],\n          \"bars\": \"\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"连自己都暂时退到后面\",\n          \"after\": 1,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"狂喜像高烧，忽然抱紧久久不松手\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"喉咙发紧眼眶湿润，分不清笑还是哭\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"还想要更多，却始终不能完全满足\",\n          \"after\": 3,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"93–102\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"晴朗歌声放大，内声部彼此拉扯\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"旋律一次次向上伸展，迟迟不落定\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"96–100\"\n        },\n        {\n          \"text\": \"悬着的气在最后交界处得到释放\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"102–103\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"他更想听对方说以后也不变\",\n          \"accent\": \"以后也不变\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"就算听到保证时间仍过得太快\",\n          \"accent\": \"时间仍过得太快\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"他怕对方哪天不再需要自己\",\n          \"accent\": \"不再需要自己\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"少露些喜欢会不会少疼点？\",\n          \"accent\": \"少疼点\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 21\n        },\n        {\n          \"text\": \"藏回去更难受他还是想对他好\",\n          \"accent\": \"更难受\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 28\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"刚说出口的愿望，还怕一停下就消失\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"幸福没消失，难过却进了幸福里面\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"终于握住珍贵的东西，才知道留不住\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"心里刚说了是，马上又冒出可是呢？\",\n          \"after\": 2,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"这个可是没有推翻刚才的幸福\",\n          \"after\": 2,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"脚步站得很稳，胸口却一沉再沉\",\n          \"after\": 4,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\",\n          \"at\": 30\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"反复渐强，106小节后越绷越紧\",\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"明亮里渐渐掺进尖锐暗沉\",\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"107–110\"\n        },\n        {\n          \"text\": \"下方脚步稳住，上方声音一次次下落\",\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"最初他连喜欢都不敢多露\",\n          \"accent\": \"不敢多露\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"仍然亲近又甜又酸他不后悔\",\n          \"accent\": \"不后悔\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S14-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"他舍不得却不再讨永远的保证\",\n          \"accent\": \"不再讨\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"喜欢既已被看见他就不再藏\",\n          \"accent\": \"不再藏\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S14-3\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"以后怎样等到了那时再说\",\n          \"accent\": \"再说\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-3\"],\n          \"at\": 26\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从美梦醒来，还记得梦里的光\",\n          \"after\": 1,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111–115\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"心里仍温热，身体慢慢恢复平静\",\n          \"after\": 1,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111–115\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"低低一声回望后，夜空还有一闪\",\n          \"after\": 2,\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113–115\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"最后像铁锚落水，把小船一下定住\",\n          \"after\": 3,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"像整理衣服关上门，重新站稳\",\n          \"after\": 3,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"尾声像接住开头那句悬着的话\",\n          \"after\": 4,\n          \"from\": [\"S14-B4\"],\n          \"bars\": \"113–116\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"低声歌唱与熟悉的摇荡短暂回来\",\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113–115\"\n        },\n        {\n          \"text\": \"细碎琶音像水花溅向夜空\",\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"115\"\n        },\n        {\n          \"text\": \"最后几下和弦沉重落定\",\n          \"from\": [\"S14-B3\", \"S14-B4\"],\n          \"bars\": \"116\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "6ee78667-b051-4296-afec-8fbcc