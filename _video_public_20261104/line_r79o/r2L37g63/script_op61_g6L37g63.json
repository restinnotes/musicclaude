       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可过去那种熟悉、亲近的安稳一浮上来，眼前的落差又更明显",
