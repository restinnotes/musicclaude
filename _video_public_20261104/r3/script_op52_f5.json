        "S12-B2-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "一阵沉重忽然压下来，他几乎觉得撑不住，随后心里又有一点支撑自己的力量，让他缓过来。",
       "keys": [],
       "from": [
        "S12-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "沉重突然压下来",
