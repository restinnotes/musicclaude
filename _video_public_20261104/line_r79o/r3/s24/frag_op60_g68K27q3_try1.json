     "emotion": "不安",
     "from": [
      "S11-3"
     ],
     "at": 31
    }
   ],
   "small": [
    {
     "text": "这是我的感情，我不再为它道歉",
     "after": 1,
     "from": [
      "S11-B1"
     ],
     "bars": "84-92",
     "at": 11
    },
    {
     "text": "悬在半空的力量，像在等下一阵浪",
