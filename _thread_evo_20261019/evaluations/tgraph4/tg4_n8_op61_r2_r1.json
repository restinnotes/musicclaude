  {
   "bars": "254–288",
   "relation": "正在面对",
   "items": [
    {
     "id": "I142",
     "text": "他意外发现重新向前后，旧愿似乎更亲近了。",
     "key": "似乎更亲近",
     "kind": ""
    },
    {
     "id": "I143",
     "text": "他仍怀念付出不会耗尽自己的生活。",
     "key": "不会耗尽",
     "kind": ""
    },
    {
     "id": "I144",
     "text": "他仍盼信任不用反复经受考验。",
     "key": "经受考验",
     "kind": ""
    },
    {
     "id": "I145",
     "text": "他如今因那种生活可贵，更不愿任它受损。",
     "key": "不愿任它受损",
     "kind": ""
    },
    {
     "id": "I146",
     "text": "他第一次真切觉得温柔也能催他向前。",
     "key": "催他向前",
     "kind": ""
    },
    {
     "id": "I147",
     "text": "他如今愿意承认，有时得离开旧愿带来的安宁。",
     "key": "有时得离开",
     "kind": ""
    },
    {
     "id": "I148",
     "text": "他不认为投入更多就必定更接近旧梦。",
     "key": "更接近旧梦",
     "kind": "办法的限度"
    },
    {
     "id": "I149",
     "text": "他也不认为有好愿望就能让每份付出值得。",
     "key": "每份付出值得",
     "kind": "办法的限度"
    },
    {
     "id": "I150",
     "text": "他仍留心争取会不会损伤想守护的东西。",
     "key": "损伤想守护的",
     "kind": ""
    },
    {
     "id": "I151",
     "text": "他如今让这份顾虑提醒自己怎样坚持。",
     "key": "提醒自己怎样坚持",
     "kind": ""
    },
    {
     "id": "I152",
     "text": "他因此感到比先前更大的喜悦。",
     "key": "更大的喜悦",
     "kind": ""
    },
    {
     "id": "I153",
     "text": "他发觉两份心意竟能共同支持自己。",
     "key": "共同支持",
     "kind": ""
    },
    {
     "id": "I154",
     "text": "他不再因为怀念安宁就厌倦责任。",
     "key": "厌倦责任",
     "kind": ""
    },
    {
     "id": "I155",
     "text": "他重新尝到曾经相信生活时的快乐。",
     "key": "重新尝到",
     "kind": ""
    },
    {
     "id": "I156",
     "text": "经历怀疑和疲惫后，他不再觉得这种快乐理所当然。",
     "key": "快乐理所当然",
     "kind": ""
    },
    {
     "id": "I157",
     "text": "他仍无法保证自己的承担能改变什么。",
     "key": "无法保证",
     "kind": ""
    },
    {
     "id": "I158",
     "text": "他还没回到不必防备的生活。",
     "key": "还没回到",
     "kind": ""
    },
    {
     "id": "I159",
     "text": "他知道往后仍可能疲惫。",
     "key": "仍可能疲惫",
     "kind": ""
    },
    {
     "id": "I160",
     "text": "他也可能因不得不付出的代价动摇。",
     "key": "代价动摇",
     "kind": ""
    },
    {
     "id": "I161",
     "text": "他明白两份心意往后仍可能相互牵制。",
     "key": "可能相互牵制",
     "kind": ""
    },
    {
     "id": "I162",
     "text": "他不再用一种满足遮住另一份需要。",
     "key": "遮住另一份",
     "kind": ""
    },
    {
     "id": "I163",
     "text": "他也不因尚未满足的愿望就否定所得。",
     "key": "否定所得",
     "kind": ""
    },
    {
     "id": "I164",
     "text": "他不知道最终能留下多少珍贵的东西。",
     "key": "留下多少",
     "kind": ""
    },
    {
     "id": "I165",
     "text": "他不愿靠忘掉其中一边来求得安心。",
     "key": "忘掉其中一边",
     "kind": ""
    },
    {
     "id": "I166",
     "text": "他可以带着不舍继续向前。",
     "key": "继续向前",
     "kind": ""
    },
    {
     "id": "I167",
     "text": "他不再需要为自己的愿意寻找更多证明。",
     "key": "更多证明",
     "kind": ""
    }
   ],
