      "S12-B1"
     ],
     "pt": "",
     "bars": "93-102"
    },
    {
     "text": "旋律一次次向上伸展，句尾仍有牵扯与延迟",
     "from": [
      "S12-B3"
     ],
     "pt": "",
     "bars": "96-100"
    },
    {
     "text": "悬着的那口气在交界处得到重大释放",
     "from": [
      "S12-B3"
     ],
     "pt": "",
     "bars": "102-103"
    }
   ]
  },
  {
   "sec": "S13",
   "big": [
    {
     "text": "可紧接着，想把眼前状态维持住的冲动又强了起来",
