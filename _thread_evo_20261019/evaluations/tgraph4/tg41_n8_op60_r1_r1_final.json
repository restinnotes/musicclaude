   "relation_model": "正在面对"
  },
  {
   "bars": "35–39",
   "relation": "正在面对",
   "items": [
    {
     "id": "I20",
     "text": "等这阵欢喜平息一点，他仍想知道，自己是否也被对方那样放在心上。",
     "key": "想知道自己是否被珍惜",
     "kind": "办法的限度",
     "key_model": "仍想知道"
    },
    {
     "id": "I21",
     "text": "他因又盼望被看见而难堪，怀疑自己的体贴里是否一直藏着期待。",
     "key": "因盼被看见而难堪",
     "kind": "",
     "key_model": "盼望被看见"
    },
    {
     "id": "I22",
     "text": "他觉得说自己毫无所求似乎不够诚实，但先前的快乐确实没有用来换回应。",
     "key": "不索求的说法不够诚实",
     "kind": "分清",
     "key_model": "不够诚实"
    },
    {
     "id": "I23",
     "text": "这个疑问他一时答不上来，只愿留着不自在，不替自己辩解，也不靠热烈遮掩。",
     "key": "暂留疑问与不自在",
     "kind": "",
     "key_model": "答不上来"
    }
   ],
   "because": [
