{"completed": true, "response": "<escape>{\n  \"phases\": [\n    {\n      \"label\": \"离开后才发现心里空了\",\n      \"emotion\": \"孤单\",\n      \"sections\": [\"S01\", \"S02\", \"S03\"]\n    },\n    {\n      \"label\": \"越想念越被现实刺痛\",\n      \"emotion\": \"不安\",\n      \"sections\": [\"S04\", \"S05\", \"S06\", \"S07\"]\n    },\n    {\n      \"label\": \"暖意退去答案仍悬着\",\n      \"emotion\": \"悬着\",\n      \"sections\": [\"S08\", \"S09\", \"S10\"]\n    },\n    {\n      \"label\": \"不急着回头先把日子过好\",\n      \"emotion\": \"安心\",\n      \"sections\": [\"S11\", \"S12\", \"S13\"]\n    }\n  ],\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"我心里空落落的，却说不清舍不得什么。\",\n              \"from\": [\"S01-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"怅然\",\n              \"from\": [\"S01-B3-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"离开熟悉的生活后，我终于不用再委屈自己。\",\n              \"from\": [\"S01-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"无措\",\n              \"from\": [\"S01-B1-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"悬着\",\n          \"lines\": [\n            {\n              \"text\": \"我想往前走，却不知道怎么安心。\",\n              \"from\": [\"S01-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"旧景\",\n              \"from\": [\"S01-B5-p1\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"我舍不得从前自在的日子，一想到以后不能再那样过就慌。\",\n              \"from\": [\"S02-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"朦胧\",\n              \"from\": [\"S02-B1-p2\"]\n            },\n            {\n              \"text\": \"缺憾\",\n              \"from\": [\"S02-B1-p4\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我一舍不得，就会想起受过的委屈。\",\n              \"from\": [\"S02-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"逞强\",\n              \"from\": [\"S02-B4-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"炽热\",\n          \"lines\": [\n            {\n              \"text\": \"我难道要为了不再受委屈，连从前的好日子也一起丢掉？\",\n              \"from\": [\"S02-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"不甘\",\n              \"from\": [\"S02-B5-p1\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我心里还憋着气，却还是为从前有人把我当自己人而高兴。\",\n              \"from\": [\"S03-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"抗拒\",\n              \"emotion\": \"炽热\",\n              \"from\": [\"S03-B1-p1\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"我心里发酸，离开以后真的会更好吗？\",\n              \"from\": [\"S03-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"遥远\",\n              \"from\": [\"S03-B2-p4\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"亲密\",\n          \"lines\": [\n            {\n              \"text\": \"我盼着从前那样的亲近还能继续。\",\n              \"from\": [\"S04-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"鲜活\",\n              \"from\": [\"S04-B1-p2\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我越盼，越怀疑当初是不是走错了。\",\n              \"from\": [\"S04-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"珍贵\",\n              \"from\": [\"S04-B2-p2\"]\n            },\n            {\n              \"text\": \"逃避\",\n              \"from\": [\"S04-B4-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"亲密\",\n          \"lines\": [\n            {\n              \"text\": \"我还是不服气，当初那些委屈本不该忍。\",\n              \"from\": [\"S05-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"耳语\",\n              \"from\": [\"S05-B1-p2\"]\n            },\n            {\n              \"text\": \"执拗\",\n              \"emotion\": \"炽热\",\n              \"from\": [\"S05-B2-p1\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"我跟自己争得筋疲力尽。\",\n              \"from\": [\"S05-2\"]\n            },\n            {\n              \"text\": \"我想到已经离开从前亲近的人，心里很难受。\",\n              \"from\": [\"S05-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"孤身\",\n              \"from\": [\"S05-B4-p2\"]\n            },\n            {\n              \"text\": \"疲惫\",\n              \"from\": [\"S05-B5-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"亲密\",\n          \"lines\": [\n            {\n              \"text\": \"我不再拿受过的委屈压住对从前的想念。\",\n              \"from\": [\"S06-1\"]\n            },\n            {\n              \"text\": \"我独自扛事时，才懂得身边有人陪着有多轻松。\",\n              \"from\": [\"S06-2\"]\n            },\n            {\n              \"text\": \"我想起那些真实的好日子，心里也暖了一点。\",\n              \"from\": [\"S06-4\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"松弛\",\n              \"emotion\": \"安心\",\n              \"from\": [\"S06-B1-p4\"]\n            },\n            {\n              \"text\": \"思念\",\n              \"from\": [\"S06-B2-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我很想再过上那种默契亲近的日子，又怕再也没有。\",\n              \"from\": [\"S06-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"未尽\",\n              \"emotion\": \"悬着\",\n              \"from\": [\"S06-B3-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我一想到以后还得独自扛事，就担心撑不住。\",\n              \"from\": [\"S07-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"寒意\",\n              \"from\": [\"S07-B1-p2\"]\n            },\n            {\n              \"text\": \"反差\",\n              \"from\": [\"S07-B2-p4\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我还会选择离开吗？\",\n              \"from\": [\"S07-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"躁动\",\n              \"from\": [\"S07-B3-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"我想找回从前的亲近，却不甘心回去受委屈。\",\n              \"from\": [\"S07-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"落差\",\n              \"from\": [\"S07-B4-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"亲密\",\n          \"lines\": [\n            {\n              \"text\": \"我想起从前的亲近，心里又暖了一会儿。\",\n              \"from\": [\"S08-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"柔软\",\n              \"from\": [\"S08-B1-p1\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"悬着\",\n          \"lines\": [\n            {\n              \"text\": \"我想到回忆不能陪我面对难事，心又悬起来。\",\n              \"from\": [\"S08-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"消散\",\n              \"from\": [\"S08-B2-p1\"]\n            },\n            {\n              \"text\": \"喘息\",\n              \"from\": [\"S08-B3-p2\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我忽然分不清，想回去是舍不得从前，还是想有人陪。\",\n              \"from\": [\"S09-1\"]\n            },\n            {\n              \"text\": \"我一想到回去的念头，就心慌得不敢再想。\",\n              \"from\": [\"S09-2\"]\n            }\n          ],\n          \"beads\": 