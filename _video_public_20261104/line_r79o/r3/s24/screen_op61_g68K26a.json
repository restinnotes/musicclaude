     "emotion": "不安",
     "from": [
      "S10-1",
      "S10-2"
     ],
     "at": 4.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像失重般悬在半空",
       "bead": "S10-B2",
       "from": [
        "S10-B2"
       ],
       "bars": "221-225",
       "at": 9.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "他想得很累，仍不知往后怎么过",
     "keys": [
      "很累"
