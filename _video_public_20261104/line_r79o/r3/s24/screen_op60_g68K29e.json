       "from": [
        "S09-B3"
       ],
       "bars": "72-77",
       "at": 18.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "他想起对方一直没退开，两人眼下还亲近，这些都是真的",
     "keys": [
      "这些都是真的"
