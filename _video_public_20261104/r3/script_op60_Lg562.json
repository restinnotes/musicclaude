 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他忽然发现自己竟那么想靠近对方，连这份心动都让他意外。",
       "detail": "",
       "keys": [],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "烟花迸开",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
      },
      {
       "text": "一瞬失重",
       "keys": [],
       "from": [
        "S01-B2-p1"
       ]
      },
      {
       "text": "细光飘落",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
      },
      {
       "text": "还悬在水面",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ]
      },
      {
       "text": "脚下一晃",
