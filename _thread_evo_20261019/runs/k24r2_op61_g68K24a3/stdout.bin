{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他终于离开了熟悉生活\",\n          \"accent\": \"终于离开\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"起初他觉得不用再委屈自己\",\n          \"accent\": \"不用再委屈自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\", \"S01-B2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"可他心里很快空了下来\",\n          \"accent\": \"空了下来\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S01-2\", \"S01-B3\", \"S01-B4\"],\n          \"at\": 36\n        },\n        {\n          \"text\": \"想往前走却不知怎样安定\",\n          \"accent\": \"不知怎样安定\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-3\", \"S01-B5\"],\n          \"at\": 68\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像烟雾散开，像一次召唤等着回声\",\n          \"after\": 0,\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–6\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"我不能倒下，可我其实很想停下来\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"分不清心里是愤怒遗憾还是怀念\",\n          \"after\": 2,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"\",\n          \"at\": 42\n        },\n        {\n          \"text\": \"冷空中胸口发紧，视线模糊伸手摸空\",\n          \"after\": 2,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"\",\n          \"at\": 50\n        },\n        {\n          \"text\": \"旧日声音和光线回来，却回不到现在\",\n          \"after\": 3,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"9–17\",\n          \"at\": 76\n        },\n        {\n          \"text\": \"身体先于意识记起怎样迈步\",\n          \"after\": 3,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"18–23\",\n          \"at\": 86\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"重和弦之后，声音轻轻往高处散开\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–6\"\n        },\n        {\n          \"text\": \"短句被停顿截断，余音在冷空气里散尽\",\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"旋律轮廓渐渐清楚\",\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"9–17\"\n        },\n        {\n          \"text\": \"波兰舞步逐渐浮现\",\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"18–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"他舍不得从前自在的日子\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-1\", \"S02-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到以后不能那样过他就心慌\",\n          \"accent\": \"心慌\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-1\", \"S02-B1\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他赶紧提醒自己别忘了受过的气\",\n          \"accent\": \"受过的气\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\", \"S02-B4\"],\n          \"at\": 31\n        },\n        {\n          \"text\": \"他不甘心连以前的好日子也丢掉\",\n          \"accent\": \"不甘心\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-3\", \"S02-B5\"],\n          \"at\": 51\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"庄严舞步下，旋律像远处旧歌只能模糊哼\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"腿脚虚浮地挪着舞步\",\n          \"after\": 0,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"呼吸被连绵音流催得越来越急\",\n          \"after\": 1,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"56–65\",\n          \"at\": 58\n        },\n        {\n          \"text\": \"他抬头整理衣服，不让人看出动摇\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"先信几分，再逼自己信，越说越显在意\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"44–65\",\n          \"at\": 43\n        },\n        {\n          \"text\": \"我不甘心就这样消亡\",\n          \"after\": 3,\n          \"from\": [\"S02-B5\"],\n          \"bars\": \"44–65\",\n          \"at\": 56\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏里细碎的音符不安地蠕动\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"音乐猛地上冲又退下，随后再次聚起\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"38–65\"\n        },\n        {\n          \"text\": \"急促的声音连成一片持续滚动\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"56–65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他心里还憋着一股气\",\n          \"accent\": \"憋着一股气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S03-1\", \"S03-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起曾被当作自己人他短暂高兴\",\n          \"accent\": \"短暂高兴\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S03-1\", \"S03-B2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"可那点高兴很快变酸\",\n          \"accent\": \"变酸\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S03-2\", \"S03-B2\"],\n          \"at\": 15\n        },\n        {\n          \"text\": \"离开以后真的会更好吗？\",\n          \"accent\": \"更好吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\", \"S03-B5\"],\n          \"at\": 22\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"麦浪微风般亲切，越发觉与眼前隔得远\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"80–91\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"像出去走走暂避伤口，轻松却没答案\",\n          \"after\": 2,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"耳边多人低语缠绕，脚下如流沙\",\n          \"after\": 2,\n          \"from\": [\"S03-B4\"],\n          \"bars\": \"\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"刚才那股昂扬，他真信了吗？\",\n          \"after\": 3,\n          \"from\": [\"S03-B5\"],\n          \"bars\": \"\",\n          \"at\": 25\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"重重一击落下，声音忽强忽弱\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"前半急切，后半忽然柔和轻盈\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"66–91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"他真盼着还能那样亲近\",\n          \"accent\": \"真盼着\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-1\", \"S04-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可当初受的委屈又翻上来\",\n          \"accent\": \"委屈又翻上来\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\", \"S04-B2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"他反复问那一步走对了吗？\",\n          \"accent\": \"走对了吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\", \"S04-B4\"],\n          \"at\": 22\n        },\n        {\n          \"text\": \"没走的话如今会怎样？\",\n          \"accent\": \"会怎样\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\", \"S04-B4\"],\n          \"at\": 29\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"旧日温暖带回感激和短暂幸福\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"那份坚定更像他努力想成为的样子\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"过去太好，越想越觉得回不去了\",\n          \"after\": 1,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108–115\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"脚步急了，心跳乱了，像被时间催着跑\",\n          \"after\": 2,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"他不停往前赶，只为不让自己停下来\",\n          \"after\": 3,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94–115\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"后段骤然紧绷，旋律又一步步往下退\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108–115\"\n        },\n        {\n          \"text\": \"细碎声音急促，低处的声音一路追赶\",\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92–115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他仍觉得当初那些气不该忍\",\n          \"accent\": \"不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\", \"S05-B2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他也不愿连开心回忆都不敢想\",\n          \"accent\": \"开心回忆\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-1\", \"S05-B2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"跟自己争久了他渐渐没力气\",\n          \"accent\": \"没力气\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\", \"S05-B5\"],\n          \"at\": 26\n        },\n        {\n          \"text\": \"想到已不在那些人身边他难受\",\n          \"accent\": \"不在那些人身边\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\", \"S05-B3\"],\n          \"at\": 39\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"柔声里仍有股劲：这事不能就这样算了\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116–127\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"旧日记忆有了温度，可能是某个人或故乡\",\n          \"after\": 2,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"\",\n          \"at\": 31\n        },\n        {\n          \"text\": \"两只手像夜色里的影子，彼此低声说话\",\n          \"after\": 3,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"\",\n          \"at\": 42\n        },\n        {\n          \"text\": \"脚下像突然没了地板，只剩一个声音\",\n          \"after\": 3,\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128–147\",\n          \"at\": 46\n        },\n        {\n          \"text\": \"几次深呼吸后松开一点，却只是累了\",\n          \"after\": 3,\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"144–147\",\n          \"at\": 50\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"快速流动的声音渐渐放慢，最后稀疏下来\",\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128–147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"难受缓下来他没再压住想念\",\n          \"accent\": \"没再压住想念\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-1\", \"S06-B1\", \"S06-B2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他才懂从前有人陪着多轻松\",\n          \"accent\": \"多轻松\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-2\", \"S06-B2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"他很想再有那种自然亲近\",\n          \"accent\": \"很想再有\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-3\", \"S06-B3\"],\n          \"at\": 27\n        },\n        {\n          \"text\": \"可他怕以后再也遇不到\",\n          \"accent\": \"再也遇不到\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-3\", \"S06-B3\"],\n          \"at\": 41\n        },\n        {\n          \"text\": \"想起真切拥有过他心里暖了\",\n          \"accent\": \"心里暖了\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-4\", \"S06-B4\"],\n          \"at\": 58\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像隔着玻璃听母亲哼摇篮曲\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"安宁难久留，现实也没有变好\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"不用解释难过，也不用装坚强\",\n          \"after\": 1,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"像向某个遥远又不确定的对象祈求\",\n          \"after\": 3,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"远去的家园在梦里忽然被照亮\",\n          \"after\": 3,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"约160\",\n          \"at\": 43\n        },\n        {\n          \"text\": \"终于敢说心里话，也轻轻看着挽不回的事\",\n          \"after\": 4,\n          \"from\": [\"S06-B3\", \"S06-B4\"],\n          \"bars\": \"\",\n          \"at\": 63\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"绵长的声音让四周近乎停驻\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"歌声带着近乎祈祷的庄严\",\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"先含蓄试探，随后展开得更迫切，末尾停在未完处\",\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"148–180\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"以后遇上难事还得独自扛吗？\",\n          \"accent\": \"独自扛吗\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-1\", \"S07-B1\", \"S07-B3\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"当初只想着不再受气\",\n          \"accent\": \"不再受气\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"早知道这么孤单还会走吗？\",\n          \"accent\": \"还会走吗\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-2\", \"S07-B4\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"他想找回亲近又不愿再受气\",\n          \"accent\": \"不愿再受气\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\", \"S07-B2\", \"S07-B5\"],\n          \"at\": 32\n        },\n        {\n          \"text\": \"连当初离开的决心也找不回\",\n          \"accent\": \"找不回\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-3\", \"S07-B5\"],\n          \"at\": 43\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"寒风猛地吹开窗，后颈一凉心跳加快\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"舞步突然闯进来，场景换了心里却没安定\",\n          \"after\": 3,\n          \"from\": [\"S07-B2\", \"S07-B5\"],\n          \"bars\": \"182–197\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"心里发颤想冲出去却找不到出口\",\n          \"after\": 4,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\",\n          \"at\": 39\n        },\n        {\n          \"text\": \"熟悉动作和舞蹈闯进来，反而更觉失去\",\n          \"after\": 4,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181–205\",\n          \"at\": 46\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高音区忽然响起一串细长颤动的声音\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\"\n        },\n        {\n          \"text\": \"舞蹈节奏突然闯入，步态不再完整\",\n          \"from\": [\"S07-B2\", \"S07-B5\"],\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"连续的颤动声越积越紧\",\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"他暂且把回去放一边\",\n          \"accent\": \"放一边\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起曾被当作自己人心里一暖\",\n          \"accent\": \"心里一暖\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\", \"S08-B1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"这点暖意没让他回头\",\n          \"accent\": \"没让他回头\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-1\", \"S08-B2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"想到以后难处回忆陪不了他\",\n          \"accent\": \"回忆陪不了他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-2\", \"S08-B2\", \"S08-B3\"],\n          \"at\": 11\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"只短暂回头一眼，胸口终于吸进一口气\",\n          \"after\": 3,\n          \"from\": [\"S08-B2\", \"S08-B3\"],\n          \"bars\": \"\",\n          \"at\": 14\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"缓慢宽广的歌唱短暂回来\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"206–213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他忽然说不清自己为何想回去\",\n          \"accent\": \"说不清\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-1\", \"S09-B2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"是舍不得被当作自己人\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S09-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"还是怕孤单到愿意再受那些气\",\n          \"accent\": \"愿意再受那些气\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\", \"S09-B2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"这念头让他心慌得不敢往下想\",\n          \"accent\": \"不敢往下想\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-2\", \"S09-B2\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"刚有点稳定又散开，像从另一面看见门\",\n          \"after\": 0,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"又遇见那个自己，这回知道他经历过什么\",\n          \"after\": 3,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–215\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"颤动的声音里，开头的引子阴冷闪现\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他最舍不得被当作自己人\",\n          \"accent\": \"最舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\", \"S10-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可回去还能像从前那样吗？\",\n          \"accent\": \"还能像从前那样吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-1\", \"S10-B1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"受过的委屈让他不敢放心回去\",\n          \"accent\": \"不敢放心回去\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"走过许多仍想不出怎样生活\",\n          \"accent\": \"想不出怎样生活\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-3\", \"S10-B3\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"眼下日子也过得不踏实\",\n          \"accent\": \"不踏实\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他像悬在半空，辨不清方向\",\n          \"after\": 4,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"221–225\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"往事明明重要，他却没力气再讲\",\n          \"after\": 3,\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"216–225\",\n          \"at\": 20\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉旋律断断续续，只剩零碎片段\",\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216–225\"\n        },\n        {\n          \"text\": \"摇篮曲般的声音破碎重现，更显凄厉\",\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216–225\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"明知未必找回亲近他仍盼万一\",\n          \"accent\": \"仍盼万一\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-1\", \"S11-B2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他不愿只凭指望回去忍让\",\n          \"accent\": \"不愿\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他想先把眼下日子过稳\",\n          \"accent\": \"先把眼下日子过稳\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-3\", \"S11-B2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"怕以后独自扛他仍不改主意\",\n          \"accent\": \"仍不改主意\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-4\", \"S11-B1\", \"S11-B3\"],\n          \"at\": 14\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像困兽一次次顶住，爆发后压力又来\",\n          \"after\": 1,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226–237\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"祈祷变成意志，紧张未解却不再停住\",\n          \"after\": 3,\n          \"from\": [\"S11-B2\", \"S11-B3\"],\n          \"bars\": \"\",\n          \"at\": 16\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"低沉声音翻涌，重重的音响一次次砸下\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226–241\"\n        },\n        {\n          \"text\": \"波兰舞步从试探渐渐聚拢\",\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"226–241\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"委屈不该忍从前也开心过\",\n          \"accent\": \"不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\", \"S12-B2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他不再逼自己选边\",\n          \"accent\": \"不再逼自己选边\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"他不怪离开也不为陪伴回头\",\n          \"accent\": \"不为陪伴回头\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-2\", \"S12-B2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"他愿带着想念继续过日子\",\n          \"accent\": \"带着想念\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-2\", \"S12-B2\"],\n          \"at\": 15\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"步子沉沉落地，像带着集体感的昂扬\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"经历动摇后仍能站稳，不必装作没受过伤\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"脚步向前时，地面忽然斜了一下\",\n          \"after\": 3,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"249–253\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的舞步以雷鸣般声势轰然回来\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"242–253\"\n        },\n        {\n          \"text\": \"昂扬步伐中途忽然换了色彩\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"249–253\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"想起从前亲近他心里又热了\",\n          \"accent\": \"心里又热了\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S13-1\", \"S13-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他盼以后再有那样的亲近\",\n          \"accent\": \"盼以后再有\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-1\", \"S13-B1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他想好好过日子不再较劲\",\n          \"accent\": \"好好过日子\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-2\", \"S13-B1\", \"S13-B2\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"再有人当他自己人他会珍惜\",\n          \"accent\": \"他会珍惜\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-4\"],\n          \"at\": 32\n        },\n        {\n          \"text\": \"即使没有他也好好过不咽委屈\",\n          \"accent\": \"不咽委屈\",\n          \"emotion\": \"安心