   "notes": [],
   "revised": false
  },
  "S05": {
   "edit": {
    "items": [
     {
      "id": "S05-1",
      "text": "他仍觉得当初那一步不能辜负，怕承认失望就是变心，也怕顺着那份依恋便会停下。",
      "key": "不能辜负",
      "follows": true,
      "causes": [
       "c1"
      ]
     },
     {
      "id": "S05-2",
      "text": "他发现自己把行动中得到的力量变成必须一直坚强的要求，连受苦也当成迟疑尚未克服的证据；意识到自己正在逼一个已经疲惫的自己后，他不再想证明坚强。",
      "key": "必须一直坚强",
      "follows": true,
      "causes": [
       "c2"
      ]
     },
     {
      "id": "S05-3",
      "text": "他发现不再催逼自己也不能消除心里的不确定，直到继续抵抗的意愿耗尽，才暂时松开。",
      "key": "暂时松开",
      "follows": true,
      "causes": [
       "c3"
      ]
     }
    ],
    "because": [
     {
      "from": "S02-1",
