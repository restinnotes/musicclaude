     }
    ]
   },
   {
    "sec": "S11",
    "bars": "226–241",
    "relation": "正在面对",
    "items": [
     {
      "id": "S11-1",
      "text": "他照着这个想法继续过眼前的日子：该守的分寸仍然守着，想起过去时却不再立刻把那份感觉按下去。",
      "key": "他照着这个想法继",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-2"
      ]
     },
     {
      "id": "S11-2",
      "text": "有时那份想念一下子变得很重，他仍会感到紧张，却不必再额外花力气把怀念藏起来。",
      "key": "有时那份想念一下",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S10-2",
      "to": "S11-1",
      "rel": "引用"
