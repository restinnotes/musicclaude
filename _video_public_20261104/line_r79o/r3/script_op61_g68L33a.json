       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可两样都不完整，反而让缺憾更清楚",
