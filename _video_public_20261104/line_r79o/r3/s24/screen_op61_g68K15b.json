     "emotion": "安心",
     "from": [
      "S06-4"
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "rows": [
    {
     "kind": "line",
     "text": "刚有点安心，他却猛然想到：以后再遇上难事，要还是只能一个人顶着，他真的撑得住吗？",
     "keys": [
      "以后再遇上难事",
      "他真的撑得住吗"
     ],
     "emotion": "不安",
     "from": [
      "S07-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "高音区一串长颤音",
       "bead": "S07-B1",
       "from": [
        "S07-B1"
       ],
       "bars": "182附近"
      },
      {
       "text": "轻得像游丝",
       "bead": "S07-B1",
       "from": [
        "S07-B1"
       ],
       "bars": "182附近"
      },
