": [\n        {\n          \"quote\": \"声音只是轻轻地、断断续续地浮现，像几块碎片\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"更凄厉哀婉的听法\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"凄厉哀婉地碎裂重现\"\n        },\n        {\n          \"quote\": \"明明知道它很重要，却已经没有力气把它重新讲述一遍\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他渐渐明白\",\n          \"point\": \"被当作自己人的感觉\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"渐渐明白；最舍不得\"\n        },\n        {\n          \"text\": \"可那些委屈没有消失\",\n          \"point\": \"回去也未必能回到从前\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"那些委屈没有消失；就算；也未必\"\n        },\n        {\n          \"text\": \"他想来想去\",\n          \"point\": \"连眼下的日子也过得不踏实\",\n          \"where\": \"后\",\n          \"waste\": \"他想来想去，\",\n          \"keep\": \"越想越累；连眼下的日子也过得不踏实\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"fine\": [\n        {\n          \"quote\": \"每次爆发之后，紧张都没有完全解除，反而又形成新的压力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"祈祷开始变成意志\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"紧张并没有解除，却有一丝奇特的解脱：不是问题解决了，而是停滞本身松开了一点\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"明知回去未必能找回\",\n          \"point\": \"万一能呢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n