       "bead": "S11-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他顾不上对方是否一样在乎，只想把能给的都给出去让对方安心",
