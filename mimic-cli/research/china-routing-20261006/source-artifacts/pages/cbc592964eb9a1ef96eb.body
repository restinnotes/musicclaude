  .rd-sidebar-sample {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 0;
    border: 1px solid #d7e3ef;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 18px 40px rgba(16, 58, 92, 0.12);
  }
  .rd-sidebar-sample__media {
    position: relative;
    min-height: 88px;
    padding: 18px 20px 16px;
    color: #ffffff;
    background: #123f63;
  }
  .rd-sidebar-sample__eyebrow {
    display: inline-block;
    margin: 0 0 8px;
    color: #66d8ea;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.22em;
    line-height: 1.25;
    text-transform: uppercase;
  }
  .rd-sidebar-sample__code {
    position: absolute;
    top: 18px;
    right: 16px;
    padding: 4px 8px;
    border-radius: 4px;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.13);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .rd-sidebar-sample__body {
    padding: 16px 18px 18px;
  }
  .rd-sidebar-sample__title {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.18;
    text-align: left;
  }
  .rd-sidebar-sample__title svg {
    width: 18px;
    height: 18px;
    color: #ffd34d;
  }
  .rd-sidebar-sample__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    margin-bottom: 16px;
    padding: 4px;
    border-radius: 8px;
    background: #eef4fb;
  }
  .rd-sidebar-sample__tab {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 6px;
    color: #3c5870;
    background: transparent;
    font-size: 11px;
    font-weight: 800;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .rd-sidebar-sample__tab:hover {
    color: #08253d;
  }
  .rd-sidebar-sample__tab.is-active {
    color: #08253d;
    background: #ffffff;
    box-shadow: 0 1px 4px rgba(16, 58, 92, 0.12);
  }
  .rd-sidebar-sample__intro {
