{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"groups\": [\n        {\n          \"idx\": 0,\n          \"beads\": [\n            {\n              \"text\": \"有东西在心里 却说不清愤怒遗憾还是怀念\",\n              \"emotion\": \"悬着\",\n              \"from\": [\"S01-B3-p3\"]\n            }\n          ]\n        },\n        {\n          \"idx\": 1,\n          \"beads\": [\n            {\n              \"text\": \"尊严还在 不能倒下 却很想停下来\",\n              \"from\": [\"S01-B1-p3\"]\n            }\n          ]\n        },\n        {\n          \"idx\": 2,\n          \"beads\": [\n            {\n              \"text\": \"记忆再清晰 过去也不会重新变成现在\",\n              \"emotion\": \"孤单\",\n              \"from\": [\"S01-B5-p2\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"groups\": [\n        {\n          \"idx\": 0,\n          \"beads\": [\n            {\n              \"text\": \"珍惜的东西还在 却不能像从前那样拥有\",\n              \"from\": [\"S02-B1-p4\"]\n            }\n          ]\n        },\n        {\n          \"idx\": 1,\n          \"beads\": [\n            {\n              \"text\": \"反复说我没事 越说越显得在意\",\n              \"from\": [\"S02-B4-p3\"]\n            }\n          ]\n        },\n        {\n          \"idx\": 2,\n          \"beads\": [\n            {\n              \"text\": \"不甘心就这样消亡\",\n              \"from\": [\"S02-B5-p1\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"groups\": [\n        {\n          \"idx\": 0,\n          \"beads\": [\n            {\n              \"text\": \"愤怒与抗拒\",\n              \"emotion\": \"炽热\",\n              \"from\": [\"S03-B1-p1\"]\n            },\n            {\n              \"text\": \"曾经轻松亲近 不必时时防备\",\n              \"emotion\": \"亲密\",\n              \"from\": [\"S03-B2-p3\"]\n            }\n          ]\n        },\n        {\n          \"idx\": 1,\n          \"beads\": [\n            {\n              \"text\": \"从前亲近的日子 越怀念越觉离眼前很远\",\n              \"from\": [\"S03-B2-p4\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"groups\": [\n        {\n          \"idx\": 0,\n          \"beads\": [\n            {\n              \"text\": \"感激亲密柔情 短暂幸福\",\n              \"from\": [\"S04-B1-p2\"]\n            }\n          ]\n        },\n        {\n          \"idx\": 1,\n          \"beads\": [\n            {\n              \"text\": \"记忆太好 过去无法原样回来\",\n              \"emotion\": \"孤单\",\n              \"from\": [\"S04-B2-p2\"]\n            },\n            {\n              \"text\": \"不停往前赶 只是为了避免停下来\",\n              \"from\": [\"S04-B4-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"groups\": [\n        {\n          \"idx\": 0,\n          \"beads\": [\n            {\n              \"text\": \"这件事不能就这样算了\",\n              \"emotion\": \"炽热\",\n              \"from\": [\"S05-B2-p1\"]\n            },\n            {\n              \"text\": \"眷恋里也带着失落\",\n              \"emotion\": \"孤单\",\n              \"from\": [\"S05-B3-p3\"]\n            }\n          ]\n        },\n        {\n          \"idx\": 1,\n          \"beads\": [\n            {\n              \"text\": \"不是已经想通 而是抵抗得累了\",\n              \"emotion\": \"不安\",\n              \"from\": [\"S05-B5-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"groups\": [\n        {\n          \"idx\": 0,\n          \"beads\": [\n            {\n              \"text\": \"压住的愿望委屈和思念 终于有机会浮现\",\n              \"from\": [\"S06-B2-p3\"]\n            },\n            {\n              \"text\": \"不用解释难过 不必维持坚强\",\n              \"emotion\": \"安心\",\n              \"from\": [\"S06-B2-p2\"]\n            },\n            {\n              \"text\": \"远去的家园还在梦里 却无法回去\",\n              \"emotion\": \"孤单\",\n              \"from\": [\"S06-B2-p5\"]\n            }\n          ]\n        },\n        {\n   