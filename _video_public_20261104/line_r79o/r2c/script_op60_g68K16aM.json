       "from": [
        "S13-B3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "那句“可是呢”不证明幸福是假的；只有真信过，怀疑才疼。",
       "keys": [
        "不证明幸福是假的",
        "怀疑才疼"
       ],
       "from": [
        "S13-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "胸口仿佛一沉再沉",
       "keys": [],
       "from": [
        "S13-B4"
       ],
       "bead": "S13-B4"
      }
     ]
    }
   ]
  },
