      "to": "S05-2",
      "rel": "引用"
     },
     {
      "from": "S04-1",
      "to": "S05-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S06",
    "bars": "148–180",
    "relation": "正在面对",
    "items": [
     {
      "id": "S06-1",
      "text": "这阵安静里，他暂时不必一直强撑，想念旧日的亲近也没有那么难承认。",
      "key": "这阵安静里，他暂",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S05-1"
      ]
     },
     {
      "id": "S06-2",
      "text": "只是离开以后，以前可以自然找人分担的日常不安，如今经常要靠他一个人消化。",
      "key": "只是离开以后，以",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S03-1"
      ]
     },
     {
      "id": "S06-3",
      "text": "这份思念从一点温柔慢慢变得迫切，他却不能只靠想念就重新拥有过去那种依靠。",
      "key": "这份思念从一点温",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1",
       "S06-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-1",
      "to": "S06-1",
      "rel": "引用"
     },
     {
      "from": "S05-1",
      "to": "S06-1",
      "rel": "引用"
     },
     {
      "from": "S01-1",
      "to": "S06-2",
      "rel": "引用"
     },
     {
      "from": "S03-1",
      "to": "S06-2",
      "rel": "引用"
     },
     {
      "from": "S06-1",
      "to": "S06-3",
      "rel": "引用"
     },
     {
      "from": "S06-2",
      "to": "S06-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S07",
    "bars": "181–205",
    "relation": "正在面对",
    "items": [
     {
      "id": "S07-1",
      "text": "他忽然想，如果早知道离开后要这样长久地独自撑着，当初还会走吗？",
      "key": "他忽然想，如果早",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-2"
      ]
     },
     {
      "id": "S07-2",
      "text": "这个疑问让他心里猛地发紧，刚才尚能安静想起的亲近，如今越想越刺痛。",
      "key": "这个疑问让他心里",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1",
       "S07-1"
      ]
     },
     {
      "id": "S07-3",
      "text": "即使这样，他也没法把当初必须维护的尊严当作无关紧要的事。",
      "key": "即使这样，他也没",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2",
       "S07-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S06-2",
      "to": "S07-1",
      "rel": "引用"
     },
     {
      "from": "S06-1",
      "to": "S07-2",
      "rel": "引用"
     },
     {
      "from": "S07-1",
      "to": "S07-2",
      "rel": "引用"
     },
     {
      "from": "S01-2",
      "to": "S07-3",
      "rel": "引用"
     },
     {
      "from": "S07-1",
      "to": "S07-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "正在面对",
    "items": [
     {
      "id": "S08-1",
      "text": "他暂时不追问那一次离开究竟值不值，只愿在心里靠近从前被自然接纳的感觉。",
      "key": "他暂时不追问那一",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S07-1"
      ]
     },
     {
      "id": "S08-2",
      "text": "那份柔和让他短暂放松，却也因眼下已经不在那里而格外不舍。",
      "key": "那份柔和让他短暂",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S08-1"
      ]
     }
    ],
    "because": [
     {
