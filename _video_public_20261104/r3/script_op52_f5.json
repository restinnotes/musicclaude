     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "圆满感突然断开，旧日忧伤猛地压回来，他一下失去支撑，急着把刚才的安宁找回来，却怎么也接不上。",
       "keys": [],
       "from": [
        "S13-3"
       ]
