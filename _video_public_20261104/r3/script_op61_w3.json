 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "我心里空落落的，却说不清舍不得什么。",
       "from": [
        "S01-2"
