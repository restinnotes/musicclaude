 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他离开那段熟悉的生活，起初觉得总算不用再委屈自己，可还是强迫自己挺直背脊，提醒自己不能倒下，心里却很想停下来。",
