<script>
    var cookie_user = '';
    var temp, reg = new RegExp("(^| )user=([^;]*)(;|$)");
    if (temp = document.cookie.match(reg)) {
        cookie_user = unescape(temp[2]);
    }
    var arr = cookie_user.split('|');
    if (arr[1]) {
        var user_id = arr[1];
    } else {
        var user_id = "";
    }

    
    var current_url = window.location.href;
    var dimension64 = 'yuanchuang';
    if(current_url.indexOf("post.smzdm.com/p/")!=-1){
        var pre_url = window.document.referrer;
        var reg = /^https:\/\/www.smzdm.com\/?(p\d+\/?)?$/
        if(reg.test(pre_url)){
            dimension64 = "shouye";
        }
    }
    
    var zdm_ga_article = {
        'channel':'yuanchuang',
        'id':'avvow5w9', // 文章id
        'article_id':'118915456', // 文章id
        'title':'新版梵想S790评测：升级英韧IG5222主控，功耗降低性能提升', // 文章标题
        'zhuanzai_title':'', // 转载标题
        'channel_name_cn':'',
        'article_url':'',
        'brand_name':'',
        'cate1_name':'电脑数码',
        
    };

    // dataLayer事件
    dataLayer = [{
        'userId':user_id,
        'UserAgent':'Mozilla/5.0 (compatible; local-research-source-archive)',
        '1级分类':'电脑数码',
        '频道':'yuanchuang',
        '文章id':'avvow5w9', // 文章id
        '文章标题':'新版梵想S790评测：升级英韧IG5222主控，功耗降低性能提升', // 文章标题

    }];

    // 购物车事件
    function gtmAddToCart(data){
        if (dimension64 === "shouye" && location.hash === '#hfeeds' ) {
            dimension64 = '首页_精选_feed流_'+'';
        }
        if(typeof(data)=='undefined' || typeof(data.name)=='undefined'){
            return true ;
        }
        data.dimension64 = dimension64;
        dataLayer.push({
            'event': 'addToCart',
            'ecommerce': {
                'currencyCode': 'CNY',
                'add': {
                    'products': [{
                        'name': data.name,
                        'id':  data.id,
                        'price': data.price,
                        'brand': data.brand,
                        'category': data.category,
                        'dimension12':data.mall,
                        'metric1': data.metric1,
                        'dimension10': data.dimension10,
                        'dimension9': data.dimension9,
                        'dimension11': data.dimension11,
                        'dimension20': data.dimension20,
                        'dimension25': data.dimension25,
                        'dimension64': data.dimension64,
                        'dimension49': '',
                        'dimension16':data.dimension16,  // userid
                        'dimension19':data.dimension19,  // 设备id
                        'quantity': 1
                    }]
                }
            }
        });
    }
    // 神策埋点，需要获取输入框值，所以跟其他处理方式不同
    function searchButtonClick () {
        var search_word = $("#J_search_input").val();
        var search_method = '';
        if (search_word === '') {
            search_method = '默认搜索';
            search_word = document.getElementsByName('default_keywords')[0].value;
        } else {
            search_word = search_word;
            search_method = '输入搜索';
        }
        sensors.track('SearchButtonClick', {
            business: "搜索",
            sub_business: "社区",
            search_keyword: search_word,
            search_method: search_method
        });


    }
</script>

