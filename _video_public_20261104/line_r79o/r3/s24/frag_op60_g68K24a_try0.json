     "from": [
      "S13-B2"
     ],
     "bars": "103–110",
     "at": 15
    },
    {
     "text": "握住珍贵的东西，才知道留不住",
     "after": 2,
     "from": [
      "S13-B2"
     ],
     "bars": "103–110",
     "at": 17
    },
