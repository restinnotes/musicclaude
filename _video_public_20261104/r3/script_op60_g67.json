 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现，自己比想象中更想靠近对方。",
       "keys": [
        "更想靠近"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头那两下，像夜空里突然亮起烟花",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "光点慢慢落下，声音却还悬在半空",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕自己的需要让对方有负担，他只敢露出一点喜欢。",
       "keys": [
        "有负担",
        "一点喜欢"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚踏上小船，脚下木板轻轻一晃",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "身体忽然失了重，还没适应水上的摇荡",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这点亲近已经让他觉得甜，他还不敢更坦白。",
       "keys": [
        "觉得甜",
        "更坦白"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "话还没出口，他先沉默了好几秒",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "有些话一说出口，两个人就会不一样",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有退开，仍愿意亲近，他才慢慢放松。",
       "keys": [
        "没有退开",
        "慢慢放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两条声音贴得像挨着耳朵说悄悄话",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "熟人安静坐着，不找话题也不尴尬",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "夏末的风又湿又热，贴在皮肤上",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "左手一下一下摇着，像贴着心跳",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "人舒服地漂着，暂时不急着靠岸",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他也想再靠近些，可怕太急弄坏自在，还是收住了。",
       "keys": [
        "再靠近些",
        "还是收住"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声忽然往上涌，喜欢一下变得热切",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "刚热切起来，又像轻轻呼出一口气",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "两个人待得越好，他越早想到这一天会过去。",
       "keys": [
        "越早想到",
        "会过去"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "柔软的落音像甜蜜确认，心里却鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不想以后，只想舒服地待在这份亲近里。",
       "keys": [
        "不想以后",
        "这份亲近"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "说过重要的话，人还沉在那句话里",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "两个人安静下来，沉默也很舒服",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他一度想把喜欢说出来，可念头很快又淡了。",
       "keys": [
        "把喜欢说出来",
        "又淡了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "想问对方是不是也一样，话却没出口",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水波还在晃，流动却像被暗流拖住",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "思绪像被风吹碎的倒影，怎么也拼不齐",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又回来了，他想起上次没说出口的话。",
       "keys": [
        "亲近又回来了",
        "没说出口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两条声音又贴近耳边，像继续说悄悄话",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "这次说得更急，细节也忍不住越讲越多",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想把心里话全说出来，也盼对方喜欢这样的自己。",
       "keys": [
        "全说出来",
        "喜欢这样的自己"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "高处的颤音亮得让人几乎睁不开眼",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "想说出口的话到了喉咙口，激动得发颤",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "最后摇晃慢下来，刚说的话还在回荡",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可他怕说得太多让对方为难，连原有的自在也丢了。",
       "keys": [
        "为难",
        "原有的自在"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "握着对方的手，不知不觉越攥越紧",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "越想抱紧当下，船里的平衡越脆弱",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "左手的水波一直向前，像每秒都在倒数",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "还没失去什么，心里已经有点舍不得",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "对方一直没退开，这回他不知不觉没藏住喜欢。",
       "keys": [
        "没退开",
        "没藏住喜欢"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "想攥紧不放的冲动，终于轻轻退下去",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "对方看出来后，他反而空落落，不知怎么相处。",
       "keys": [
        "空落落",
        "不知怎么相处"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "原来托着小船的摇荡，忽然像被抽走",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "只剩一条旋律，在空中没着没落",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他怕自己太黏人，连原来的亲近也像隔了一层。",
       "keys": [
        "太黏人",
        "隔了一层"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚才还在耳边的交谈，忽然一下停了",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "他甚至怀疑，这份幸福能维持多久",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他的在乎却没变，他才又自在起来。",
       "keys": [
        "看出他的在乎",
        "自在起来"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "摇荡回来了，却轻得像水面细纹",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "新旋律清澈得像一支朴素的牧歌",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "像年少时第一次心动的清凉下午",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他想到对方不知道自己刚才多怕被嫌弃，忽然有点孤单。",
       "keys": [
        "不知道",
        "怕被嫌弃"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里那个念头又回来：算了，还是放不下",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "他不再费力装作自己一点事也没有",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "再亲近的人，也走不进心里每个角落",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "明明还在眼前，却恍惚像已经成了回忆",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他又想，对方会不会也舍不得这份亲近？",
       "keys": [
        "也舍不得",
        "这份亲近"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "气味、身体感觉和遗憾混在一起",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      },
      {
       "text": "越沉进去，越有点找不着方向",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他开始觉得，对方也许有时需要自己陪着。",
       "keys": [
        "需要自己陪着"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "安静地享受已经不够了",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "水底像有暗流，一直往上翻",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "低音像沉重的脉搏，一下一下催促",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "这个念头让他高兴得收不住，越来越舍不得抽身。",
       "keys": [
        "高兴得收不住",
        "舍不得抽身"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "回忆慢慢变成气味和身体的感觉",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "明知道自己被卷进去，却暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他盼着对方以后想找人陪时，还会想到自己。",
       "keys": [
        "想找人陪",
        "想到自己"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "美好没有消失，他却已经听见时间经过",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "对方依然亲近，他想主动些，大大方方回应。",
       "keys": [
        "主动些",
        "大大方方回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌句越唱越开，像终于不再防备",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "熟悉的摇荡也像在轻轻催促",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他开始盼着往后，两个人也许还能一直这么好。",
       "keys": [
        "盼着往后",
        "一直这么好"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像重新碰到阳光和风，整个人轻快起来",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      },
      {
       "text": "这份灵动里，还有一点调情的玩心",
       "keys": [],
       "from": [
