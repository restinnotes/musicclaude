       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急着说一句",
       "keys": [],
       "from": [
        "S03-B2-p1"
       ]
      },
      {
       "text": "又沉回去",
       "keys": [],
       "from": [
        "S03-B2-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我又和对方亲近起来，心里欢喜，也想起上回没说出口的话。",
