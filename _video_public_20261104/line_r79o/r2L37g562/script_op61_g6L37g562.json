       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他有时觉得自己在外面更孤单，偶尔松下来也只是累了，并不是真的想开了",
