       "from": [
        "S01-B2-p1"
       ]
      },
      {
       "text": "有一点突然",
       "keys": [],
       "from": [
        "S01-B1-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他因怕自己的需要成为对方的负担而只敢露出一点喜欢。",
       "detail": "",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "一说出口就变了",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      },
      {
       "text": "越清楚越谨慎",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      },
      {
       "text": "话还没出口",
