    "bars": "40–50",
    "relation": "正在面对",
    "items": [
     {
      "id": "S06-1",
      "text": "他意识到记忆可能不完整，但不完整并不等于当时的幸福是假的。",
      "key": "他意识到记忆可能",
      "follows": false,
