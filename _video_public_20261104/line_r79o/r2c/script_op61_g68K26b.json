 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开熟悉的生活，起初觉得终于不用再委屈自己",
       "keys": [
        "不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "沉重和弦像召唤，他挺直背脊却很想停下来",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可笃定很快散了，他空落落地想往前却不知靠什么安下心",
       "keys": [
        "空落落地"
       ],
       "from": [
        "S01-2",
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "一时说不清舍不得什么，心里分不清愤怒遗憾还是怀念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "冷空里醒来时视线模糊胸口发紧，伸手只摸到虚空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "旧日声光忽然回来，过去却不会变成现在",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前的自在，想到以后不能再那样过就心慌",
       "keys": [
        "心慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他赶紧想起受过的气，怕一心软就忘了为何离开",
       "keys": [],
       "from": [
        "S02-2"
       ],
       "bead": "S02-2"
      },
      {
       "text": "难道不再受气，就得连从前的好日子也丢掉？",
       "keys": [],
       "from": [
        "S02-3"
       ],
       "bead": "S02-3"
      },
      {
       "text": "腿脚发虚地挪着舞步，旧歌只能模糊哼几句",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "头两次还信自己没事，第三次只剩硬撑",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "我不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他心里还憋着一股气，想起曾被当作自己人又高兴了一小会儿",
       "keys": [
        "高兴了一小会儿"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可那点高兴很快变酸，离开后一定会更好吗？",
       "keys": [
        "很快变酸"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "前面急切，后来像故乡夏日麦浪微风温柔又刺痛",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像聊点别的暂时离开伤口，轻松是真的",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "昂扬慢慢退潮，心里问刚才真相信了吗",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他真盼着还能那样相处",
       "keys": [
        "真盼着"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可委屈也翻上来，他开始怀疑当初那一步",
       "keys": [
        "委屈也翻上来"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "没走的话，如今会怎样？",
       "keys": [],
       "from": [
        "S04-2"
       ],
       "bead": "S04-2"
      },
      {
       "text": "过去太好才刺痛，越用力越不安稳",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "细碎音符像急促脚步，心跳乱了拍",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "脑子里反复问如果当时，怎么也停不下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他仍不服气，觉得当初那些气根本不该忍",
       "keys": [
        "不该忍"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "连开心的往事都不敢多想，也太为难自己",
       "keys": [],
       "from": [
        "S05-1"
       ],
       "bead": "S05-1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争到没力气后，他只觉得离开那些人很难受",
       "keys": [
        "没力气"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "两只手像夜色里的影子，彼此低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "旧日记忆又有温度，眷恋里仍带着失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "几次深呼吸，像抵抗累了还没想通",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "难受缓下来，他终于不必压住想念也不用装坚强",
       "keys": [
        "不必压住想念"
       ],
       "from": [
        "S06-1",
        "S06-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "身边没了那些人，才知有人陪着多轻松",
       "keys": [],
       "from": [
        "S06-2"
       ],
       "bead": "S06-2"
      },
      {
       "text": "像隔着玻璃罩听母亲轻哼，连呼吸都不敢惊动",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "圣咏般庄严，委屈和愿望浮上来不用解释",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "像向遥远未知处祈求，远去家园只在梦里亮起",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想再过那样的日子又怕再也没有，静静看着也觉得暖",
       "keys": [
        "静静看着也觉得暖"
       ],
       "from": [
        "S06-3",
        "S06-4",
        "S06-B4"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "祈祷般的静谧忽然被打断，他怕以后难事还得独自硬扛",
       "keys": [
        "独自硬扛"
       ],
       "from": [
        "S07-1",
        "S07-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "寒风猛地吹开窗，后颈一凉心跳猛跳",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "明明像过去了，心里翻转着想冲出去却没出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他想找回亲近却不愿再受气，离开的决心也没了",
       "keys": [
        "不愿再受气"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "当初只想着别再受气，早知道这么孤单还会走吗？",
       "keys": [],
       "from": [
        "S07-2"
       ],
       "bead": "S07-2"
      },
      {
       "text": "熟悉的动作和舞步突然闯进来，亲切反倒刺痛",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他先把回去放一边，只想起曾被当作自己人",
       "keys": [
        "曾被当作自己人"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的柔软处刚打开，像回头一眼就淡了",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "回忆陪不了他面对难处，胸口短暂松口气",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他分不清想回去是舍不得亲近，还是怕孤单到愿再受气",
       "keys": [
        "愿再受气"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "这念头让他心慌，连往下想都不敢了",
       "keys": [],
       "from": [
        "S09-2"
       ],
       "bead": "S09-2"
      },
      {
       "text": "又遇见那个不知怎么办的自己，这回知道他经历过什么",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他最舍不得被当作自己人，可回去还会一样吗",
       "keys": [
        "被当作自己人"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "委屈还在，光凭想念不敢回去",
       "keys": [],
       "from": [
        "S10-2"
       ],
       "bead": "S10-2"
      },
      {
       "text": "想得很累仍没答案，眼下也不踏实",
       "keys": [],
       "from": [
        "S10-3"
       ],
       "bead": "S10-3"
      },
      {
       "text": "像忽然失重，辨不清方向",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "想问怎样继续，累得无力重讲往事",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他明知回去未必找回亲近，还是忍不住盼着",
       "keys": [
        "忍不住盼着"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "不肯只凭指望回去忍让",
       "keys": [],
       "from": [
        "S11-2"
       ],
       "bead": "S11-2"
      },
      {
       "text": "先把眼下过稳，回去以后再说",
       "keys": [],
       "from": [
        "S11-3"
       ],
       "bead": "S11-3"
      },
      {
       "text": "怕独自扛事，迈步后心里松开一点",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不再逼自己选边，也不怪当初离开",
       "keys": [
        "不再逼自己选边"
       ],
       "from": [
        "S12-1",
        "S12-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那些气不该忍，从前也开心过",
       "keys": [],
       "from": [
        "S12-1"
       ],
       "bead": "S12-1"
      },
      {
       "text": "他仍会心软怕孤单，却不为陪伴回头",
       "keys": [],
       "from": [
        "S12-2"
       ],
       "bead": "S12-2"
      },
      {
       "text": "他愿意带着想念继续过",
       "keys": [],
       "from": [
        "S12-2"
       ],
       "bead": "S12-2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "想起从前的亲近，他有劲头把往后日子过好",
       "keys": [
        "有劲头"
       ],
       "from": [
        "S13-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "若再有人把他当自己人，他会珍惜不再咽委屈",
       "keys": [],
       "from": [
        "S13-4"
       ],
       "bead": "S13-4"
      },
      {
       "text": "柔软的祈祷忽然宏大，像故土与共同希望",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "像被气流推着跑，兴奋得来不及喘息",
       "keys": [],
       "from": [
        "S13-B2"
       ],
       "bead": "S13-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他仍盼着再有那样的亲近，怕还要等很久",
       "keys": [
        "怕还要等很久"
       ],
       "from": [
        "S13-1",
        "S13-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "成功似乎还不牢，结尾像歇口气也像决定或梦醒",
       "keys": [],
       "from": [
        "S13-B3"
       ],
       "bead": "S13-B3"
      }
     ]
    }
   ]
  }
 ]
}