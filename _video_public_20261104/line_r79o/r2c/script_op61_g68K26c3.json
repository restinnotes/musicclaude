 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开熟悉的生活，起初觉得总算不用再委屈自己",
       "keys": [
        "不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头像一次召唤，停顿里还等着回声",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "他逼自己挺直背脊，不能倒下，心里却想停下",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可笃定没撑多久，心里就空落落的，说不清舍不得什么",
       "keys": [
        "空落落的"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里有东西，却分不清是愤怒、遗憾还是怀念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "像刚醒来，四周冷空，眼前模糊，胸口发紧",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "颤抖着伸手，只摸到虚空，还没哭出来",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他还想往前过，却不知以后靠什么安下心",
       "keys": [
        "安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日的声音、光线和熟悉感回来，却不会变成现在",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "身体仿佛先记起了该怎样迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得自在的旧日，一想到以后不能再那样过就心慌",
       "keys": [
        "心慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像远处旧歌，只能模糊哼唱，珍惜的东西还在却难拥有",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "庄严步态像面向众人，旋律却像私下哼唱",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "像腿脚虚浮的人，在记忆里挪动舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他赶紧想起受过的气，怕一心软就忘了为何离开",
       "keys": [
        "忘了为何离开"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他像整理衣服抬头，起初信自己没事，后来越说越像硬撑",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "可他仍不甘心，难道连以前的好日子也得丢掉？",
       "keys": [
        "仍不甘心"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "那股激昂也像在说：我不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他心里还憋着一股气",
       "keys": [
        "憋着一股气"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想起曾被当作自己人，又短暂高兴了一会儿",
       "keys": [
        "短暂高兴"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像故乡麦浪与微风，越怀念越觉远得刺痛",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可那点高兴很快变酸，离开后就一定更好吗？",
       "keys": [
        "一定更好吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像侧身离开伤口，聊别的走走，轻松却没解开心事",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "像多人在耳边低声絮语",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "昂扬渐退，他又怀疑自己是否真信了",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
