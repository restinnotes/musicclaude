{"completed": true, "response": "```json\n{\n  \"segments\": [\n    {\n      \"segment\": \"S01\",\n      \"links\": [\n        {\n          \"thread_quote\": \"我明明已经知道要对你说什么。\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"你并不是不知道自己想说什么\",\n          \"type\": \"承接\",\n          \"note\": \"把开场的迟疑落到已经明确心意却尚未开口的心理状态上。\"\n        },\n        {\n          \"thread_quote\": \"说出来，不只是把心意递给你，也可能改变我们之间原本的样子\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"有些话一旦说出来，关系就会改变\",\n          \"type\": \"承接\",\n          \"note\": \"明确说出心意可能改变关系，解释了为什么越清楚反而越谨慎。\"\n        },\n        {\n          \"thread_quote\": \"那两下声音忽然向上迸开\",\n          \"bead\": \"S01/B1\",\n          \"bead_quote\": \"先向高处迸发\",\n          \"type\": \"承接\",\n          \"note\": \"把开头和弦的突然爆发转成叙述者内心先行冲出的动作。\"\n        },\n        {\n          \"thread_quote\": \"光亮还没散尽\",\n          \"bead\": \"S01/B1\",\n          \"bead_quote\": \"细碎的光点再缓缓飘落\",\n          \"type\": \"承接\",\n          \"note\": \"保留烟花般的光尚未消散、声音尚未落稳的短暂悬置。\"\n        },\n        {\n          \"thread_quote\": \"我想让你知道，又怕从这一刻起，再不能像现在这样靠近你。\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"有些话一旦说出来，关系就会改变\",\n          \"type\": \"承接\",\n          \"note\": \"将开场的沉默具体化为想表达与害怕失去现有亲密之间的拉扯。\"\n        },\n        {\n          \"thread_quote\": \"我明明已经知道要对你说什么。\",\n          \"bead\": \"S14/B4\",\n          \"bead_quote\": \"接住开头悬着的话，终于把它说完\",\n          \"type\": \"铺垫\",\n          \"note\": \"开头已经存在却未出口的话，为终段重新接起并完成它留下伏笔。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [\n        \"S01/B3\"\n      ],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S02\",\n      \"links\": [\n        {\n          \"thread_quote\": \"你离我这样近，我几乎不必解释什么。\",\n          \"bead\": \"S02/B1\",\n          \"bead_quote\": \"不必拼命找话题\",\n          \"type\": \"承接\",\n          \"note\": \"把亲密关系中不必刻意交谈的舒适感写成两个人之间的低语。\"\n        },\n        {\n          \"thread_quote\": \"摇荡的水波轻轻托着我\",\n          \"bead\": \"S02/B2\",\n          \"bead_quote\": \"把身体交给船底温柔的托举\",\n          \"type\": \"承接\",\n          \"note\": \"水波的托举解释了叙述者暂时不必主动行动的松弛感。\"\n        },\n        {\n          \"thread_quote\": \"仿佛只要我们还能够这样相处，有些话不说也没有关系。\",\n          \"bead\": \"S02/B1\",\n          \"bead_quote\": \"沉默也不让人紧张\",\n          \"type\": \"承接\",\n          \"note\": \"把沉默从缺少交流转成可以安心停留的亲密状态。\"\n        },\n        {\n          \"thread_quote\": \"两道声音挨得很近，我甚至觉得，沉默也可以是一种亲密。\",\n          \"bead\": \"S02/B1\",\n          \"bead_quote\": \"两个紧挨在一起的人耳语\",\n          \"type\": \"承接\",\n          \"note\": \"直接承接两条歌声贴近所带来的耳语般的亲密体验。\"\n        },\n        {\n          \"thread_quote\": \"我试着把那句话往前送一点，刚一抬高，又忍不住收回来。\",\n          \"bead\": \"S02/B3\",\n          \"bead_quote\": \"话已经到了嘴边，又轻轻咽回去\",\n          \"type\": \"承接\",\n          \"note\": \"把声音收弱的演奏动作转成话语即将出口又被收回的犹豫。\"\n        },\n        {\n          \"thread_quote\": \"我试着把那句话往前送一点，刚一抬高，又忍不住收回来。\",\n          \"bead\": \"S02/B5\",\n          \"bead_quote\": \"没有把心事彻底说死\",\n          \"type\": \"承接\",\n          \"note\": \"对应歌声短暂上涌之后重新柔和下来、仍然有所保留的变化。\"\n        },\n        {\n          \"thread_quote\": \"我试着把那句话往前送一点\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"有些话一旦说出来，关系就会改变\",\n          \"type\": \"回指\",\n          \"note\": \"前段尚未出口的话在这里重新成为实际想要推进的对象。\"\n        },\n        {\n          \"thread_quote\": \"明明幸福还在，我却已经舍不得了。\",\n          \"bead\": \"S02/B4\",\n          \"bead_quote\": \"还没有失去，就已经生出一丝舍不得\",\n          \"type\": \"承接\",\n          \"note\": \"把温柔仍在却已经开始不舍的矛盾直接转成叙述者的感受。\"\n        },\n        {\n          \"thread_quote\": \"时间不会为了我的迟疑停下来\",\n          \"bead\": \"S02/B2\",\n          \"bead_quote\": \"时间也一直在走\",\n          \"type\": \"承接\",\n          \"note\": \"水波不停流动的事实成为迟疑无法无限延长的原因。\"\n        },\n        {\n          \"thread_quote\": \"我越珍惜此刻，就越害怕有一天连此刻也会失去。\",\n          \"bead\": \"S02/B4\",\n          \"bead_quote\": \"希望这一刻再慢一点过去\",\n          \"type\": \"承接\",\n          \"note\": \"把对当下的珍惜推进为尚未失去便已经产生的惆怅。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S03\",\n      \"links\": [\n        {\n          \"thread_quote\": \"我暂时什么也不必做，只让这份亲近留在心里。\",\n          \"bead\": \"S03/B1\",\n          \"bead_quote\": \"暂时“不去哪里”\",\n          \"type\": \"承接\",\n          \"note\": \"把持续摇荡却暂时没有方向的状态转成停留在亲近中的内心体验。\"\n        },\n        {\n          \"thread_quote\": \"水波托着我，轻轻摇荡\",\n          \"bead\": \"S03/B1\",\n          \"bead_quote\": \"水波般的摇曳托着身体\",\n          \"type\": \"承接\",\n          \"note\": \"保留身体被水波托住、意识暂时漂浮的感受。\"\n        },\n        {\n          \"thread_quote\": \"仿佛我终于可以不去追问\",\n          \"bead\": \"S03/B1\",\n          \"bead_quote\": \"沉默并不尴尬，反而很舒服\",\n          \"type\": \"承接\",\n          \"note\": \"把漂浮中的舒适感转成暂时不必追问或采取行动的状态。\"\n        },\n        {\n          \"thread_quote\": \"可那个念头偏偏又冒了出来，急切得几乎不等我同意\",\n          \"bead\": \"S03/B2\",\n          \"bead_quote\": \"忽然冒出几句短促、稍显急切的声音\",\n          \"type\": \"承接\",\n          \"note\": \"将持续摇曳中突然出现的急切声音转成闯入意识的念头。\"\n        },\n        {\n          \"thread_quote\": \"现在说吧，至少让你知道。\",\n          \"bead\": \"S03/B2\",\n          \"bead_quote\": \"某个念头突然想说话\",\n          \"type\": \"承接\",\n          \"note\": \"把短暂冒头的声音具体化为催促自己开口的内心话语。\"\n        },\n        {\n          \"thread_quote\": \"它刚刚浮到心口，我便把它按了回去。\",\n          \"bead\": \"S03/B2\",\n          \"bead_quote\": \"很快又沉回去\",\n          \"type\": \"承接\",\n          \"note\": \"对应念头刚浮出便重新沉没、未能发展成倾诉的段内变化。\"\n        },\n        {\n          \"thread_quote\": \"可安静下面仍有一股暗流，拖着思绪绕来绕去。\",\n          \"bead\": \"S03/B3\",\n          \"bead_quote\": \"平稳的“对话”有一种被水下暗流拖住的感觉\",\n          \"type\": \"承接\",\n          \"note\": \"将音乐的滞留与阻力转成无法停止的内心盘旋。\"\n        },\n        {\n          \"thread_quote\": \"可安静下面仍有一股暗流，拖着思绪绕来绕去。\",\n          \"bead\": \"S03/B3\",\n          \"bead_quote\": \"思绪像被风吹碎的倒影\",\n          \"type\": \"承接\",\n          \"note\": \"补出了平静之下思绪纠缠、无法重新拼合的心理层次。\"\n        },\n        {\n          \"thread_quote\": \"我也不能说自己已经满足，因为那句话仍在。\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"话还没出口，先有几秒钟沉默\",\n          \"type\": \"回指\",\n          \"note\": \"开头未能说出的话重新进入当前的安静，使满足感无法成为最终答案。\"\n        },\n        {\n          \"thread_quote\": \"眼前的温柔确实让我满足\",\n          \"bead\": \"S02/B4\",\n          \"bead_quote\": \"还没有失去，就已经生出一丝舍不得\",\n          \"type\": \"回指\",\n          \"note\": \"前段对温柔的珍惜在这里转化为满足与不满足同时存在的感受。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S04\",\n      \"links\": [\n        {\n          \"thread_quote\": \"熟悉的心意又回来了。\",\n          \"bead\": \"S04/B1\",\n          \"bead_quote\": \"熟悉的歌声又回来了\",\n          \"type\": \"承接\",\n          \"note\": \"把主题的再现转成同一心意再次涌现。\"\n        },\n        {\n          \"thread_quote\": \"这一次，我不再能把它当成偶然闪过的念头。\",\n          \"bead\": \"S03/B2\",\n          \"bead_quote\": \"某个念头突然想说话\",\n          \"type\": \"回指\",\n          \"note\": \"先前短暂冒头又沉下去的念头现在重新出现，并开始显出持续性。\"\n        },\n        {\n          \"thread_quote\": \"它一遍遍涌上来，像是只要再多说一点\",\n          \"bead\": \"S04/B1\",\n          \"bead_quote\": \"本来一句话已经够了，却忍不住再说一遍\",\n          \"type\": \"承接\",\n          \"note\": \"将主题重复和装饰增加转成反复表达、不断补充的冲动。\"\n        },\n        {\n          \"thread_quote\": \"我想让你明白，我珍惜的不只是这一刻的亲近，而是这份感情本身\",\n          \"bead\": \"S04/B1\",\n          \"bead_quote\": \"又折回来补上更多细节\",\n          \"type\": \"承接\",\n          \"note\": \"把反复补充细节的音乐形态转成试图完整传达心意的需要。\"\n        },\n        {\n          \"thread_quote\": \"可越是想说清楚，我越是说不出来。\",\n          \"bead\": \"S04/B2\",\n          \"bead_quote\": \"想把最深的情意说出口，却在喉咙口颤抖、哽咽\",\n          \"type\": \"承接\",\n          \"note\": \"表达的迫切与出口处的阻滞形成同一段内的拉扯。\"\n        },\n        {\n          \"thread_quote\": \"仿佛只要不显得太郑重，就不必承担那么大的后果。\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"有些话一旦说出来，关系就会改变\",\n          \"type\": \"回指\",\n          \"note\": \"开头对关系改变的担忧在这里成为试图淡化心意的直接动机。\"\n        },\n        {\n          \"thread_quote\": \"可情意越往上涌，退意也越清楚。\",\n          \"bead\": \"S04/B2\",\n          \"bead_quote\": \"一边往上争取，一边又在退弱\",\n          \"type\": \"承接\",\n          \"note\": \"把旋律的上行与退弱转成想表达和想撤回同时增强。\"\n        },\n        {\n          \"thread_quote\": \"到了最靠近出口的地方，我竟然开始发颤。\",\n          \"bead\": \"S04/B2\",\n          \"bead_quote\": \"喉咙口颤抖、哽咽\",\n          \"type\": \"承接\",\n          \"note\": \"把高音处的颤动直接转成话到嘴边时的身体反应。\"\n        },\n        {\n          \"thread_quote\": \"不是因为我不知道自己要说什么，而是因为我太知道了\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"你并不是不知道自己想说什么\",\n          \"type\": \"回指\",\n          \"note\": \"重新强调开头的核心困境：阻力不是心意不明，而是心意太明确。\"\n        },\n        {\n          \"thread_quote\": \"一旦说出，我便不能再假装它只是无关紧要的心事。\",\n          \"bead\": \"S11/B1\",\n          \"bead_quote\": \"这是我的感情，我不再为它道歉\",\n          \"type\": \"铺垫\",\n          \"note\": \"此处害怕承担心意的分量，为后面不再淡化或否认感情留下伏笔。\"\n        },\n        {\n          \"thread_quote\": \"我想再靠近一点，身体却先紧了起来。\",\n          \"bead\": \"S04/B3\",\n          \"bead_quote\": \"动作已经先透露了出来\",\n          \"type\": \"承接\",\n          \"note\": \"把握手和拥抱中的紧张转成身体先于意识显露出的退缩。\"\n        },\n        {\n          \"thread_quote\": \"美好仍然在眼前，底下的水波却不停向前。\",\n          \"bead\": \"S04/B4\",\n          \"bead_quote\": \"左手的水波却一直向前流\",\n          \"type\": \"承接\",\n          \"note\": \"用持续前行的水波衬出美好仍在而时间不肯停留。\"\n        },\n        {\n          \"thread_quote\": \"我忽然觉得，每一秒都在流逝\",\n          \"bead\": \"S04/B4\",\n          \"bead_quote\": \"仿佛每一秒都在倒数\",\n          \"type\": \"承接\",\n          \"note\": \"将音乐中的倒数感转成对当下正在流逝的直接意识。\"\n        },\n        {\n          \"thread_quote\": \"我忽然觉得，每一秒都在流逝\",\n          \"bead\": \"S02/B2\",\n          \"bead_quote\": \"时间也一直在走\",\n          \"type\": \"回指\",\n          \"note\": \"前段水波与时间不停前行的意识在这里再次加重。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S05\",\n      \"links\": [\n        {\n          \"thread_quote\": \"忽然，那些托住我的摇荡都退去了。\",\n          \"bead\": \"S05/B1\",\n          \"bead_quote\": \"水波和摇晃，忽然像被抽掉了\",\n          \"type\": \"承接\",\n          \"note\": \"把伴奏支撑突然撤去转成身体失去托举的感觉。\"\n        },\n        {\n          \"thread_quote\": \"忽然，那些托住我的摇荡都退去了。\",\n          \"bead\": \"S05/B3\",\n          \"bead_quote\": \"音乐却仿佛自己松开了手\",\n          \"type\": \"承接\",\n          \"note\": \"同一处突变也表现为原先抓紧当下的动作终于松开。\"\n        },\n        {\n          \"thread_quote\": \"我一下子失去了刚才可以顺势靠近的凭借\",\n          \"bead\": \"S05/B1\",\n          \"bead_quote\": \"突然失去了脚下的支撑\",\n          \"type\": \"承接\",\n          \"note\": \"把音乐支撑消失转成无法继续顺势靠近的失重感。\"\n        },\n        {\n          \"thread_quote\": \"只剩下自己，和那句始终没有落下来的话。\",\n          \"bead\": \"S05/B2\",\n          \"bead_quote\": \"一句快到嘴边的重要话没有说出口\",\n          \"type\": \"承接\",\n          \"note\": \"把谈话突然中断与那句仍未出口的话合并为独自面对自己的状态。\"\n        },\n        {\n          \"thread_quote\": \"刚才明明那么幸福\",\n          \"bead\": \"S05/B2\",\n          \"bead_quote\": \"刚才仿佛还有两个人在贴近耳语\",\n          \"type\": \"承接\",\n          \"note\": \"以先前的亲密作为骤然抽身之后的对照。\"\n        },\n        {\n          \"thread_quote\": \"可现在，幸福本身竟然也变得不确定了。\",\n          \"bead\": \"S05/B2\",\n          \"bead_quote\": \"这份幸福是真实的吗？它能维持多久？\",\n          \"type\": \"承接\",\n          \"note\": \"把谈话停止后的疑问扩展成对幸福真实性与持续时间的怀疑。\"\n        },\n        {\n          \"thread_quote\": \"你离我近，并不等于我已经知道这份亲近意味着什么\",\n          \"bead\": \"S02/B1\",\n          \"bead_quote\": \"沉默也不让人紧张\",\n          \"type\": \"回指\",\n          \"note\": \"前段无须言语的亲密在这里被重新审视，其舒适并不能保证关系的意义。\"\n        },\n        {\n          \"thread_quote\": \"我终于松了一口气，像是不用再勉强自己向前。\",\n          \"bead\": \"S05/B3\",\n          \"bead_quote\": \"深吸一口气\",\n          \"type\": \"承接\",\n          \"note\": \"把音乐松手后的呼吸转成暂时不再勉强推进关系的动作。\"\n        },\n        {\n          \"thread_quote\": \"可一旦松开，那片空出来的地方便显得格外清冷。\",\n          \"bead\": \"S06/B3\",\n          \"bead_quote\": \"突然感到一点酸楚\",\n          \"type\": \"铺垫\",\n          \"note\": \"松开之后出现的空缺，为下一段独处时被放大的酸楚留下情绪上的入口。\"\n        },\n        {\n          \"thread_quote\": \"只要我不说，一切就还可以维持原样。\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"有些话一旦说出来，关系就会改变\",\n          \"type\": \"回指\",\n          \"note\": \"把开头害怕改变关系的理由明确揭示为维持现状的希望。\"\n        },\n        {\n          \"thread_quote\": \"只要我不说，一切就还可以维持原样。\",\n          \"bead\": \"S06/B2\",\n          \"bead_quote\": \"像一个念头好不容易安静下来，却又回来\",\n          \"type\": \"铺垫\",\n          \"note\": \"暂时把沉默当成保护的策略，为下一段自我安慰与渴望反复交锋作铺垫。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S06\",\n      \"links\": [\n        {\n          \"thread_quote\": \"我想，或许我可以不再逼迫自己。\",\n          \"bead\": \"S05/B3\",\n          \"bead_quote\": \"刚才那阵攥得太紧的冲动，终于轻轻退了下去\",\n          \"type\": \"回指\",\n          \"note\": \"前段松开之后的短暂缓和在这里成为不再强迫自己的起点。\"\n        },\n        {\n          \"thread_quote\": \"摇荡重新回来，却变得轻而细碎。\",\n          \"bead\": \"S06/B1\",\n          \"bead_quote\": \"熟悉的摇摆回来了，却不再沉甸甸\",\n          \"type\": \"承接\",\n          \"note\": \"对应摇摆重新建立却减轻重量、变得细碎的音乐变化。\"\n        },\n        {\n          \"thread_quote\": \"刚才那种温暖的明亮退远了，留下清凉、安静的声音。\",\n          \"bead\": \"S06/B1\",\n          \"bead_quote\": \"空气一下凉了\",\n          \"type\": \"承接\",\n          \"note\": \"把音色和调性带来的清凉感转成温暖退去后的心理环境。\"\n        },\n        {\n          \"thread_quote\": \"不必立刻成为承诺，不必马上得到回答\",\n          \"bead\": \"S06/B2\",\n          \"bead_quote\": \"像一个念头好不容易安静下来，却又回来\",\n          \"type\": \"承接\",\n          \"note\": \"把新主题中低声安慰自己的声音转成暂时不要求结果的想法。\"\n        },\n        {\n          \"thread_quote\": \"可以承认这份感情真实地发生在我心里，而不急着让它改变我们之间的关系。\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"有些话一旦说出来，关系就会改变\",\n          \"type\": \"回指\",\n          \"note\": \"开头对关系改变的担忧在这里变成保留感情而不急于表达的策略。\"\n        },\n        {\n          \"thread_quote\": \"这样想的时候，我终于觉得轻松了一点。\",\n          \"bead\": \"S06/B1\",\n          \"bead_quote\": \"A大调的新旋律清澈、舒展\",\n          \"type\": \"承接\",\n          \"note\": \"新主题的清澈与舒展对应叙述者暂时获得的轻松。\"\n        },\n        {\n          \"thread_quote\": \"可那个念头又轻轻插了进来。\",\n          \"bead\": \"S06/B2\",\n          \"bead_quote\": \"旁边另一条声线不时回应、插话\",\n          \"type\": \"承接\",\n          \"note\": \"把另一条声部的插入转成重新打断自我安慰的念头。\"\n        },\n        {\n          \"thread_quote\": \"如果我始终把它留在心里，你又怎么会知道？\",\n          \"bead\": \"S06/B2\",\n          \"bead_quote\": \"不断与它纠缠\",\n          \"type\": \"承接\",\n          \"note\": \"将反复纠缠的声部具体化为沉默无法解决的表达问题。\"\n        },\n        {\n          \"thread_quote\": \"如果我始终把它留在心里，你又怎么会知道？\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"话还没出口，先有几秒钟沉默\",\n          \"type\": \"回指\",\n          \"note\": \"开头的未出口心意再次成为当前安静无法解决的矛盾。\"\n        },\n        {\n          \"thread_quote\": \"它只是暂时安静了下来，等着下一次重新涌起。\",\n          \"bead\": \"S07/B1\",\n          \"bead_quote\": \"原先压着的感受反而变成了动力\",\n          \"type\": \"铺垫\",\n          \"note\": \"此处暂时压下的感受将在下一段转化为推动叙述者向前的力量。\"\n        }\n      ],\n      \"thread_only\": [\n        \"我可以只是爱着你。\"\n      ],\n      \"beads_unlinked\": [\n        \"S06/B3\",\n        \"S06/B4\"\n      ],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S07\",\n      \"links\": [\n        {\n          \"thread_quote\": \"我再也不能只靠安静来满足自己了。\",\n          \"bead\": \"S06/B2\",\n          \"bead_quote\": \"像一个念头好不容易安静下来，却又回来\",\n          \"type\": \"回指\",\n          \"note\": \"上一段暂时压下的念头重新起作用，使安静不再足以维持满足。\"\n        },\n        {\n          \"thread_quote\": \"那些原本被我压住的感受，此刻反而有了更强的力量。\",\n          \"bead\": \"S07/B1\",\n          \"bead_quote\": \"原先压着的感受反而变成了动力\",\n          \"type\": \"承接\",\n          \"note\": \"直接把内声部的攀升与伴奏加密转成被压抑感受的动力化。\"\n        },\n        {\n          \"thread_quote\": \"心跳越来越急