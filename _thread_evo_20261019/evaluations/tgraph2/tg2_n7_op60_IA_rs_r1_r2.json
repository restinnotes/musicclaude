  },
  {
   "from": "N13",
   "to": "N20",
   "rel": "动摇",
   "note": "先前能够放松停留的状态，如今受到失去恐惧的干扰。"
  },
  {
   "from": "N19",
   "to": "N20",
   "rel": "说明",
   "note": "那个还没有答案的疑问使他继续珍惜亲密时也无法彻底放心。"
  },
  {
   "from": "N8",
   "to": "N21",
   "rel": "提供理由",
   "note": "亲密曾经真实地让他满足，所以他相信重新靠近仍可能有效。"
  },
  {
   "from": "N17",
   "to": "N21",
   "rel": "提供理由",
   "note": "满足之后仍有的不安，使他想通过再次靠近获得确认。"
  },
  {
   "from": "N2",
   "to": "N21",
   "rel": "唤起",
   "note": "他起初就希望亲密能够让自己放下对失去的提防，这份愿望再次推动他靠近。"
  },
  {
   "from": "N21",
   "to": "N22",
   "rel": "说明",
   "note": "他再次接近熟悉的温柔，也确实重新感到了放松。"
  },
  {
   "from": "N8",
   "to": "N22",
   "rel": "唤起",
   "note": "再次得到的温柔唤回了早先那份充实和满足。"
  },
  {
   "from": "N20",
   "to": "N24",
   "rel": "提供理由",
   "note": "失去的担忧已经妨碍他享受亲密，所以再次投入时他会主动检查是否安心。"
  },
  {
   "from": "N24",
   "to": "N23",
   "rel": "说明",
   "note": "他把每次温柔当作检验幸福可靠程度的机会，因此仍觉得需要确认。"
  },
  {
   "from": "N22",
   "to": "N25",
   "rel": "提供理由",
   "note": "再次获得温暖，使他能直接看见满足重现以后还有什么没有得到。"
  },
  {
   "from": "N23",
   "to": "N25",
   "rel": "说明",
   "note": "仍想得到保证的反应，暴露了温柔没有处理到的需要。"
  },
  {
   "from": "N25",
   "to": "N26",
   "rel": "提供理由",
   "note": "反复满足仍留下未满足的部分，使他开始追问问题究竟出在哪里。"
  },
  {
   "from": "N15",
   "to": "N27",
   "rel": "提供理由",
   "note": "他想确定快乐能够持续，于是开始在信任中反复求证。"
  },
  {
   "from": "N24",
   "to": "N27",
   "rel": "说明",
   "note": "因为带着疑问投入，他逐渐把信任也变成了检查自己是否安心的办法。"
  },
  {
   "from": "N20",
   "to": "N28",
   "rel": "说明",
   "note": "前一段留下的失去恐惧，使他这次无法像最初那样单纯接受温柔。"
  },
  {
   "from": "N22",
   "to": "N28",
   "rel": "提供理由",
   "note": "亲密仍能让他放松，因此他还愿意继续投入。"
  },
  {
   "from": "N27",
   "to": "N28",
   "rel": "说明",
   "note": "持续求证使他在亲密中同时保有信任和检查。"
  },
  {
   "from": "N4",
   "to": "N29",
