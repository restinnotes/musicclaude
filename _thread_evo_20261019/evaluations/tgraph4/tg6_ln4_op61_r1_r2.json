     "rel": "唤起",
     "how": ""
    }
   ]
  },
  {
   "bars": "148–180",
   "relation": "没在想",
   "items": [
    {
     "id": "I60",
     "text": "他记起旧日生活里一直有的安稳。",
     "key": "一直有的安稳",
     "kind": ""
    },
    {
     "id": "I61",
     "text": "那时，他的心意有地方可以去。",
     "key": "有地方可以去",
     "kind": ""
    },
    {
     "id": "I62",
     "text": "他能安心接受别人的亲近。",
     "key": "安心接受",
     "kind": ""
    },
    {
     "id": "I63",
     "text": "付出时，他不必计算得失。",
     "key": "计算得失",
     "kind": ""
    },
    {
     "id": "I64",
     "text": "接受时，他也不觉得亏欠。",
     "key": "不觉得亏欠",
     "kind": ""
    },
    {
     "id": "I65",
     "text": "那时，他也有骄傲，却无须时时防备。",
     "key": "无须时时防备",
     "kind": ""
    },
    {
     "id": "I66",
     "text": "他从前不必在尊严和亲近之间选择。",
     "key": "亲近之间选择",
     "kind": ""
    },
    {
     "id": "I67",
     "text": "那种自在如今显得格外美好。",
     "key": "格外美好",
     "kind": ""
    },
    {
     "id": "I68",
     "text": "他仿佛又感到从前那份宽阔。",
     "key": "仿佛又感到",
     "kind": ""
    },
    {
     "id": "I69",
     "text": "当年拥有它的喜悦也重新鲜明。",
     "key": "喜悦也重新鲜明",
     "kind": ""
    },
    {
     "id": "I70",
     "text": "失去的事实暂时退远了。",
     "key": "暂时退远了",
     "kind": ""
    },
    {
     "id": "I71",
     "text": "他没有急着比较过去和现在。",
     "key": "比较过去和现在",
     "kind": ""
    },
    {
     "id": "I72",
     "text": "他没有追问那样的生活还能否回来。",
     "key": "还能否回来",
     "kind": ""
    },
    {
     "id": "I73",
     "text": "他只想让那份温暖多停留一会儿。",
     "key": "多停留一会儿",
     "kind": ""
    },
    {
     "id": "I74",
     "text": "他一时几乎忘了自己为何愤怒。",
     "key": "一时几乎忘了",
     "kind": ""
    }
   ],
   "because": [
