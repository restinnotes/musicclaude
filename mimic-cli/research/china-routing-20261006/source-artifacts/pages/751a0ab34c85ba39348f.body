))) device = 'mobile';})(navigator.userAgent||navigator.vendor||window.opera);

      if (device === 'desktop' && document.cookie.indexOf('exv') === -1) {
        var events = new Events(document.cookie);
        events.sdataEvent({
          eventType: 'web:install:shown',
          data: {},
          headers: null,
          subSrc: 'help-center',
        });

        var ua = window.navigator.userAgent;
        var browser;
        var installLink;

        if (ua.indexOf('Edg/') != -1) {
          browser = 'Edge';
          installLink = "https://microsoftedge.microsoft.com/insider-addons/detail/amnbcmdbanbkjhnfoeceemmmdiepnbpp";
        } else if (ua.indexOf('Edge') != -1 || ua.indexOf('Trident') != -1 || ua.indexOf('MSIE') != -1) {
          browser = 'Edge';
          installLink = "https://www.microsoft.com/en-us/store/p/honey/9pfs6hpnlbxk?cid=msft_web_collection";
        } else if (ua.indexOf('Opera') != -1 || ua.indexOf('OPR') != -1) {
          browser = 'Opera';
          installLink = "https://chromewebstore.google.com/detail/paypal-honey-automatic-co/bmnlcjabgnpnenekpadlanbbkooimhnj";
        } else if (ua.indexOf('Chrome') != -1) {
          browser = 'Chrome';
          installLink = "https://chromewebstore.google.com/detail/paypal-honey-automatic-co/bmnlcjabgnpnenekpadlanbbkooimhnj";
        } else if (ua.indexOf('Safari') != -1) {
          browser = 'Safari';
          installLink = "https://apps.apple.com/us/app/paypal-honey-for-safari/id1472777122";
        } else if (ua.indexOf('Firefox') != -1) {
          browser = 'Firefox';
          installLink = "https://addons.mozilla.org/en-US/firefox/addon/honey/";
        } else {
          browser = 'Chrome';
          installLink = "https://chromewebstore.google.com/detail/paypal-honey-automatic-co/bmnlcjabgnpnenekpadlanbbkooimhnj";
        }

       var buttonCopy = `Add to ${browser} - It's Free`;

       if (["fr", "fr-FR", "fr-CA", "fr-CH"].includes(navigator.language)) {
         $('body').append('<style>.brand::after {content: "Aide"}</style>');
         buttonCopy = `Ajouter à ${browser} - C'est gratuit`;

         document.getElementsByClassName('search-query')[0].setAttribute('placeholder', 'Rechercher')
         document.getElementsByClassName('articleRatings-question')[0].innerText = "Est-ce que ça a répondu à ta question?";
         document.getElementsByClassName('articleRatings-feedback-message')[0].innerText = "Merci pour les commentaires";
         document.getElementsByClassName('articleRatings-failure')[0].innerText = "Un problème est survenu lors de l'envoi de vos commentaires. Essayez de nouveau plus tard.";

         document.getElementsByTagName('time')[0].remove();
       }

       if (ua.indexOf('iPhone') == -1 && ua.indexOf('Android') == -1 && ua.indexOf('iPad') == -1) {
          $('<div id="install-container" style="text-align: right; position: relative; margin: 2px 100px 0px 60px"><button id="install-button" style="outline: none; background-color: #cc4b06; border-width: 0px; border-radius: 3px; color: #ffffff; font-family:  avenir-next-lt, Avenir, ' + "'" + 'Open Sans' + "'" + '; font-size: 16px; font-weight: 600; height: 46px; padding: 0px 20px; max-width: 290px; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; " onclick="installClicked(' + `'${installLink}'` + ');">'+ `${buttonCopy}` +'</button></div>').insertAfter(".brand");
        }
      }
    }

    let acceptWithScroll = null;

    function acceptCookiePolicy(action, fromScroll = false) {
      const cookieExpiry = new Date().getTime() + (1000 * 60 * 60 * 24 * 365); // 1 year from now
      document.cookie = 'acceptedCookiePolicy=1;domain=.joinhoney.com;path=/';

      const banner = document.getElementById('honey-cookieBanner');
      banner.parentNode.removeChild(banner);
      if (!fromScroll) {
        if (acceptWithScroll) {
          clearTimeout(acceptWithScroll);
          acceptWithScroll = null;
        }
        // no listeners have been removed yet, remove all
        removeEventListeners();
      } else {
        // scroll listener has already been removed, only remove click
        document.removeEventListener('click', this.clickHandler);
      }

      const events = new Events(document.cookie);
      events.sdataEvent({
        eventType: 'web:cookie_consent:accepted',
        data: { action },
        headers: null,
        subSrc: 'help-center',
      });
    }

    function handleClick(e) {
      const clickedAccept = e.target.id === 'accept-button';
      const clickedClose = e.target.id === 'close-banner-icon';
      const clickedCloseMobile = e.target.id === 'close-banner-icon-mobile';
      const clickedPolicyLink = e.target.id === 'policy-button';

      if (!clickedAccept && !clickedClose && !clickedCloseMobile && !clickedPolicyLink) {
        acceptCookiePolicy('website-interaction');
      }
    }

    function handleScroll() {
      acceptWithScroll = setTimeout(() => acceptCookiePolicy('website-interaction', true), 3000);
      // only remove scroll listener, clicks override scroll handler delay
      window.removeEventListener('scroll', handleScroll);
    }

    function removeEventListeners() {
      window.removeEventListener('click', handleClick);
      window.removeEventListener('scroll', handleScroll);
    }

    function setEventListeners() {
      window.addEventListener('click', handleClick);
      setTimeout(() => {
        window.addEventListener('scroll', handleScroll);
      }, 5000);
    }

    function injectCookieConsentBanner() {
      setEventListeners();

      const cookieBanner = `
        <div id="honey-cookieBanner" class="honey-cookieBanner">
          <div class="closeButtonMobile">
            <img src="https://cdn.joinhoney.com/images/instapage/close.svg" alt="Close" id="close-banner-icon-mobile"/>
          </div>

          <div class="notificationContainer">
            <img src="https://cdn.joinhoney.com/images/instapage/notification.svg" alt="Notification" class="notificationIcon"/>

            <div class="textContainer">
              <div class="notificationTitle">This site uses cookies to enhance your user experience. To accept, please click "Accept" or keep using the site.</div>
              <div class="notificationCopy">To learn more, please see our 
                <a href="https://www.joinhoney.com/privacy" aria-label="privacy-policy" id="policy-button" class="notificationLink">Privacy Policy</a>
              </div>
            </div>
          </div>

          <div class="dismissContainer">
            <div class="acceptButton" id="accept-button">Accept</div>
            <img src="https://cdn.joinhoney.com/images/instapage/close.svg" alt="Close" id="close-banner-icon" class="closeButton"/>
          </div>
        </div>
      `;

      document.body.insertAdjacentHTML('afterbegin', cookieBanner);
      $('#accept-button').click(() => acceptCookiePolicy('accept-click'));
      $('#close-banner-icon').click(() =>  acceptCookiePolicy('banner-close'));
      $('#close-banner-icon-mobile').click(() =>  acceptCookiePolicy('banner-close'));

      const events = new Events(document.cookie);
      events.sdataEvent({
        eventType: 'web:cookie_consent:shown',
        data: {},
        headers: null,
        subSrc: 'help-center',
      });
    }

    function isEULanguage(languageCode) {
      const EU_LANGUAGE_CODES = [
        'sq', // Albania
        'sq-al', // Albania
        'ca', // Andorra
        'cat', // Andorra
        'de-at', // Austria
        'be', // Belarus
        'be-by', // Belarus
        'bs-ba', // Bosnia + Herzegovina
        'hr-ba', // Bosnia + Herzegovina
        'sr-ba', // Bosnia + Herzegovina
        'fr-be', // Belgium
        'nl-be', // Belgium
        'bg', // Bulgaria
        'bg-bg', // Bulgaria
        'hr', // Croatia
        'hr-hr', // Croatia
        'tr', // Cyprus
        'tr-tr', // Cyprus
        'cs', // Czech Republic
        'cs-cz', // Czech Republic
        'da', // Denmark
        'da-dk', // Denmark
        'et', // Estonia
        'et-ee', // Estonia
        'fi-fi', // Finland
        'se-fi', // Finland
        'smn-fi', // Finland
        'sms-fi', // Finland
        'sv-fi', // Finland
        'br-fr', // France
        'co-fr', // France
        'fr-fr', // France
        'gsw-fr', // France
        'oc-fr', // France
        'de-de', // Germany
        'dsb-de', // Germany
        'hsb-de', // Germany
        'el', // Greece
        'el-gr', // Greece
        'hu', // Hungary
        'hu-hu', // Hungary
        'is', // Iceland
        'is-is', // Iceland
        'en-ie', // Ireland
        'ga-ie', // Ireland
        'it', // Italy
        'it-it', // Italy
        'de-li', // Liechtenstein
        'lt', // Lithuania
        'lt-lt', // Lithuania
        'de-lu', // Luxembourg
        'fr-lu', // Luxembourg
        'lb', // Luxembourg
        'lb-lu', // Luxembourg
        'lv', // Latvia
        'lv-lv', // Latvia
        'mt', // Malta
        'mt-mt', // Malta
        'fr-mc', // Monaco
        'sr-me', // Montenegro
        'fy-nl', // Netherlands
        'nl', // Netherlands
        'nl-nl', // Netherlands
        'mk', // North Macedonia
        'mk-mk', // North Macedonia
        'nb-no', // Norway
        'nn-no', // Norway
        'se-no', // Norway
        'sma-no', // Norway
        'smj-no', // Norway
        'pl', // Poland
        'pl-pl', // Poland
        'pt', // Portugal
        'pt-pt', // Portugal
        'ro', // Romania
        'ro-ro', // Romania
        'sr', // Serbia
        'sr-rs', // Serbia
        'ca-es', // Spain
        'es-es', // Spain
        'eu-es', // Spain
        'gl-es', // Spain
        'sl', // Slovenia
        'sl-sl', // Slovenia
        'sk', // Slovakia
        'sk-sk', // Slovakia
        'se-se', // Sweden
        'sma-se', // Sweden
        'smj-se', // Sweden
        'sv-se', // Sweden
        'sv-sv', // Sweden
        'de-ch', // Switzerland
        'fr-ch', // Switzerland
        'it-ch', // Switzerland
        'rm-ch', // Switzerland
        'uk', // Ukraine
        'uk-ua', // Ukraine
        'en-gb', // United Kingdom
      ];
      return EU_LANGUAGE_CODES.includes(languageCode);
    }

    function addCookieConsentBanner() {
      const parsedCookies = document.cookie.split(';').reduce((res, c) => {
        const [key, val] = c.trim().split('=').map(decodeURIComponent)
        const allNumbers = str => /^\d+$/.test(str);
        try {
          return Object.assign(res, { [key]: allNumbers(val) ?  val : JSON.parse(val) })
        } catch (e) {
          return Object.assign(res, { [key]: val })
        }
      }, {});

      const browserLanguage = ((navigator || {}).language) || '';
      const isEU = isEULanguage(browserLanguage.toLowerCase());
      const hasExt = parsedCookies.exv;
      const cookiePolicyAccepted = parsedCookies.acceptedCookiePolicy;

      if (isEU && !hasExt && !cookiePolicyAccepted) {
        injectCookieConsentBanner();
      }
    }

    function swapFooterName() {
      const browserLanguage = ((navigator || {}).language) || '';
      const isUS = browserLanguage === 'en-US';
      const brand = isUS ? 'PayPal, Inc.' : 'Honey Science LLC';
      const today = new Date();
      const year = today.getFullYear();
      const copyright = '© ' + year + ' ' + brand;

      $('footer p').text(copyright);
    }

    function addCookiesPref() {
      $('footer').prepend('<button class="unstyled" onClick="window.manageCookiePreferences();">Cookies</button>');
    }

    function onLoad() {
      $('html').attr('lang', 'en');
      $('#searchBar').find('.search-query').attr('aria-labelledby', 'searchBar');
      $('#mainNav').find('.brand').attr('aria-label', 'Honey');
      $('meta[name=viewport]').attr('content', 'width=device-width');

      //addCookieConsentBanner();
      addInstallButton();
      swapFooterName();
      addCookiesPref();

      var events = new Events(document.cookie);
      var utm_params = { utm_campaign: null, utm_content: null, utm_medium: null, utm_source: null, utm_term: null };
      // var search = location.search.substring(1);
      var ref = document.referrer || null;
      // if (search.length) {
      //   var queryParams = JSON.parse('{"' + search.replace(/&/g, '","').replace(/=/g,'":"') + '"}', function(key, value) { return key===""?value:decodeURIComponent(value) });
      //   Object.keys(queryParams).filter(key => key.includes('utm')).forEach((param) => {
      //     utm_params[param] = queryParams[param];
      //   });
      // }
      events.sdataEvent({
        eventType: 'web:page:show',
        data: { utm_params, ref },
        headers: null,
        subSrc: 'help-center',
      });
    }
    if (window.addEventListener) {
      window.addEventListener("load",onLoad,false);
    } else if (window.attachEvent) {
      window.attachEvent("onload",onLoad);
    }
  })()
</script>

