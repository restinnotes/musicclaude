    <h1 id="s6"><i class="triangle open"></i>错误码解释</h1>
    <div class="J_sCon">
        <table border="1" cellpadding="0" cellspacing="0">
            <thead>
            <tr>
                <th width="30%">错误码</th>
                <th width="30%">错误描述</th>
                <th width="40%">解决方案</th>
            </tr>
            </thead>
            <tbody>
                                <tr>
                    <td>00006</td>
                    <td>商品不存在，商品已经被下架、被删除、或者被卖光。</td>
                    <td>更换商品。</td>
                </tr>
                                <tr>
                    <td>00005</td>
                    <td>依据入参的商品id，查询不到商品。</td>
                    <td>更换商品id。</td>
                </tr>
                                <tr>
                    <td>00004</td>
                    <td>入参商品id错误。</td>
                    <td>请输入正确的商品id</td>
                </tr>
                                <tr>
                    <td>00001</td>
                    <td>服务被限流。</td>
                    <td>请稍后重试。</td>
                </tr>
                            </tbody>
        </table>
    </div>


