    "relation": "没在想",
    "items": [
     {
      "id": "S09-1",
      "text": "他心里还是放着那个人。",
      "key": "他心里还是放着那",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S09-2",
      "text": "这一刻他只是默默想念，没有继续盘算要不要开口。",
      "key": "这一刻他只是默默",
      "follows": false,
