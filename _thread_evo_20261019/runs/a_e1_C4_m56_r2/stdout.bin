  {\n      \"segment\": \"S05\",\n      \"links\": [\n        {\n          \"thread_quote\": \"第35小节，原本托住音乐的摇摆突然消失\",\n          \"bead\": \"S05/B1\",\n          \"bead_quote\": \"原来一直托着你的水波和摇晃，忽然像被抽掉了\",\n          \"type\": \"承接\",\n          \"note\": \"对应支撑音乐的摇摆突然撤去。\"\n        },\n        {\n          \"thread_quote\": \"只剩下一条旋律独自悬在空中\",\n          \"bead\": \"S05/B1\",\n          \"bead_quote\": \"一条单薄、孤零零的旋律，在空中漫无目的地游走\",\n          \"type\": \"承接\",\n          \"note\": \"把支撑消失后的旋律写成孤立而悬空的声音。\"\n        },\n        {\n          \"thread_quote\": \"这种空旷与前面的沉默并不一样\",\n          \"bead\": \"S03/B1\",\n          \"bead_quote\": \"沉默并不尴尬，反而很舒服\",\n          \"type\": \"回指\",\n          \"note\": \"明确区分先前有亲近支撑的沉默与当前失去支撑的空旷。\"\n        },\n        {\n          \"thread_quote\": \"先前的沉默还有柔软的流动可以依靠\",\n          \"bead\": \"S02/B2\",\n          \"bead_quote\": \"把身体交给船底温柔的托举\",\n          \"type\": \"回指\",\n          \"note\": \"以前的摇摆仍能托住身体，构成当前失去支撑的对照。\"\n        },\n        {\n          \"thread_quote\": \"一个此前可以暂时放在一旁的问题，忽然变得无法回避\",\n          \"bead\": \"S05/B2\",\n          \"bead_quote\": \"像一句快到嘴边的重要话没有说出口\",\n          \"type\": \"承接\",\n          \"note\": \"支撑撤去后，原先可以暂缓的问题变得无法回避。\"\n        },\n        {\n          \"thread_quote\": \"这份幸福究竟能够维持多久？\",\n          \"bead\": \"S05/B2\",\n          \"bead_quote\": \"这份幸福是真实的吗？它能维持多久？\",\n          \"type\": \"承接\",\n          \"note\": \"直接展开珠子提出的幸福能否持续的疑问。\"\n        },\n        {\n          \"thread_quote\": \"这个疑问并不是在幸福消失之后才出现的\",\n          \"bead\": \"S04/B4\",\n          \"bead_quote\": \"还没有失去什么，就已经生出一丝舍不得\",\n          \"type\": \"回指\",\n          \"note\": \"当前对失去的担忧延续了先前尚未失去便已舍不得的情绪。\"\n        },\n        {\n          \"thread_quote\": \"因为人确实从中得到过温暖，才会开始在意它是否会失去\",\n          \"bead\": \"S02/B4\",\n          \"bead_quote\": \"因为太喜欢眼前的东西，所以还没有失去，就已经生出一丝舍不得\",\n          \"type\": \"回指\",\n          \"note\": \"把当前对失去的恐惧追溯到先前真实的幸福。\"\n        },\n        {\n          \"thread_quote\": \"关系的持续却不能仅凭这一刻来