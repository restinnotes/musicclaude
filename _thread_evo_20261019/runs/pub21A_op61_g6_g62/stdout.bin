    \"waste\": \"他却想到\",\n          \"keep\": \"刚有点安心\"\n        },\n        {\n          \"text\": \"当初离开时只想着不再受气\",\n          \"point\": \"早知道还会走吗？\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没料到会这么孤单\"\n        },\n        {\n          \"text\": \"他想找回从前的亲近\",\n          \"point\": \"连当初的决心也找不着了\",\n          \"where\": \"后\",\n          \"waste\": \"他想\",\n          \"keep\": \"又不甘心回去受委屈\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"像一个人已经准备离开，却在最后一刻回过头，再看一眼刚才待过的地方；那一眼里有温柔，也有不舍。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"像临走前回头看一眼\"\n        },\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只是瞬间的喘息，并不等于整个人重新安顿下来。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他暂时把回不回去放到一边\",\n          \"point\": \"心里暖了一会儿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"暂时把回不回去放到一边\"\n        },\n        {\n          \"text\": \"可暖意很快淡了\",\n          \"point\": \"回忆不能陪他熬过下一次难关\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"可暖意很快淡了；心又悬起来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"开头沉重的引子从中阴冷地闪现回来，却不再像最初那样郑重召唤。\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"开头引子又冷冷闪回\"\n        },\n        {\n          \"quote\": \"声音短暂落稳，又向高处漂去，刚有的一点稳定感随即散掉\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\":