{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他已经离开熟悉的生活",
     "accent": "离开",
     "emotion": "悬着",
     "from": [
      "S01-1"
     ],
     "at": 0
    },
    {
     "text": "起初他觉得总算不用再委屈自己",
     "accent": "不用再委屈自己",
     "emotion": "安心",
     "from": [
      "S01-1"
     ],
     "at": 8
    },
    {
     "text": "可这份笃定很快就散了",
     "accent": "很快就散了",
     "emotion": "不安",
     "from": [
      "S01-2"
     ],
     "at": 26
    },
    {
     "text": "他一时说不清舍不得什么",
     "accent": "说不清",
     "emotion": "悬着",
     "from": [
      "S01-2"
     ],
     "at": 38
    },
    {
     "text": "他想往前过却不知如何安心",
     "accent": "不知如何安心",
     "emotion": "不安",
     "from": [
      "S01-3"
     ],
     "at": 64
    }
   ],
   "small": [
    {
     "text": "像硬撑着挺直背脊，心里却想停",
     "after": 1,
     "from": [
      "S01-B2"
     ],
     "bars": "",
     "at": 13
    },
    {
     "text": "说不清是愤怒遗憾还是怀念",
     "after": 3,
     "from": [
      "S01-B3"
     ],
     "bars": "",
     "at": 45
    },
    {
     "text": "像刚从昏沉里醒来，四周冷而空",
     "after": 3,
     "from": [
      "S01-B4"
     ],
     "bars": "",
     "at": 53
    },
    {
     "text": "胸口发紧，伸手却只摸到虚空",
     "after": 3,
     "from": [
      "S01-B4"
     ],
     "bars": "",
     "at": 61
    },
    {
     "text": "熟悉的声音和光线回来，却不是现在",
     "after": 4,
     "from": [
      "S01-B5"
     ],
     "bars": "9–17",
     "at": 74
    },
    {
     "text": "身体先记起该怎样迈步",
     "after": 4,
     "from": [
      "S01-B5"
     ],
     "bars": "18–23",
     "at": 82
    }
   ],
   "notes": [
    {
     "text": "沉重一响后琶音像烟雾散开，停顿里还等回声",
     "from": [
      "S01-B1"
     ],
     "bars": "1–6"
    },
    {
     "text": "短句刚冒出就被长停顿截断",
     "from": [
      "S01-B3"
     ],
     "bars": "1–23"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "他舍不得从前的自在日子",
     "accent": "舍不得",
     "emotion": "亲密",
     "from": [
      "S02-1"
     ],
     "at": 0
    },
    {
     "text": "想到以后不能那样过他就慌",
     "accent": "他就慌",
     "emotion": "不安",
     "from": [
      "S02-1"
     ],
     "at": 12
    },
    {
     "text": "他赶紧想起受过的那些气",
     "accent": "受过的那些气",
     "emotion": "不安",
     "from": [
      "S02-2"
     ],
     "at": 23
    },
    {
     "text": "他怕心软忘了为何离开",
     "accent": "怕心软",
     "emotion": "悬着",
     "from": [
      "S02-2"
     ],
     "at": 34
    },
    {
     "text": "不受气就得丢掉好日子吗？",
     "accent": "丢掉好日子",
     "emotion": "不安",
     "from": [
      "S02-3"
     ],
     "at": 49
    }
   ],
   "small": [
    {
     "text": "远处旧歌只剩几句模糊哼唱",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "",
     "at": 5
    },
    {
     "text": "舞步带着庄严，歌声像私下低哼",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "",
     "at": 9
    },
    {
     "text": "像腿脚发虚的人在记忆里挪步",
     "after": 1,
     "from": [
      "S02-B2"
     ],
     "bars": "",
     "at": 16
    },
    {
     "text": "抬头装作没事，反复说着才露出在意",
     "after": 3,
     "from": [
      "S02-B4"
     ],
     "bars": "",
     "at": 39
    },
    {
     "text": "悲伤还在，他不肯全交给它",
     "after": 3,
     "from": [
      "S02-B4"
     ],
     "bars": "",
     "at": 44
    },
    {
     "text": "不甘心就这样消亡",
     "after": 4,
     "from": [
      "S02-B5"
     ],
     "bars": "44–65",
     "at": 54
    }
   ],
   "notes": [
    {
     "text": "伴奏底下细碎声音一直不安地蠕动",
     "from": [
      "S02-B2"
     ],
     "bars": "24–65"
    },
    {
     "text": "音乐猛推又退，随后再聚力，连绵短音催得呼吸发急",
     "from": [
      "S02-B3"
     ],
     "bars": "38–65"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他心里还憋着一股气",
     "accent": "憋着一股气",
     "emotion": "不安",
     "from": [
      "S03-1"
     ],
     "at": 0
    },
    {
     "text": "想起被当自己人他短暂高兴",
     "accent": "短暂高兴",
     "emotion": "亲密",
     "from": [
      "S03-1"
     ],
     "at": 8
    },
    {
     "text": "从前那样的日子回不去了",
     "accent": "回不去了",
     "emotion": "孤单",
     "from": [
      "S03-2"
     ],
     "at": 18
    },
    {
     "text": "离开以后就一定更好过吗？",
     "accent": "一定更好过吗",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ],
     "at": 22
    }
   ],
   "small": [
    {
     "text": "前段焦躁，后段麦浪微风般亲切",
     "after": 1,
     "from": [
      "S03-B2"
     ],
     "bars": "66–91",
     "at": 11
    },
    {
     "text": "那份亲切让人心颤，也刺痛",
     "after": 2,
     "from": [
      "S03-B2"
     ],
     "bars": "80–91",
     "at": 14
    },
    {
     "text": "像出去走走，轻松是真的，问题还在",
     "after": 2,
     "from": [
      "S03-B3"
     ],
     "bars": "66–91",
     "at": 20
    },
    {
     "text": "耳边像多人低语缠绕，脚下像流沙",
     "after": 3,
     "from": [
      "S03-B4"
     ],
     "bars": "66–91",
     "at": 25
    },
    {
     "text": "昂扬慢慢退去，我刚才真相信了吗？",
     "after": 3,
     "from": [
      "S03-B5"
     ],
     "bars": "66–91",
     "at": 25
    }
   ],
   "notes": [
    {
     "text": "重击后忽强忽弱，节奏忽然错开",
     "from": [
      "S03-B1"
     ],
     "bars": "66–91"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "他真盼着从前那样亲近",
     "accent": "真盼着",
     "emotion": "亲密",
     "from": [
      "S04-1"
     ],
     "at": 0
    },
    {
     "text": "可亲近的回忆又勾起委屈",
     "accent": "勾起委屈",
     "emotion": "悬着",
     "from": [
      "S04-2"
     ],
     "at": 8
    },
    {
     "text": "他开始问当初走得对不对",
     "accent": "对不对",
     "emotion": "不安",
     "from": [
      "S04-2"
     ],
     "at": 19
    },
    {
     "text": "没走的话如今又会怎样？",
     "accent": "又会怎样",
     "emotion": "悬着",
     "from": [
      "S04-2"
     ],
     "at": 25
    }
   ],
   "small": [
    {
     "text": "旧日子里有感激亲密和短暂幸福",
     "after": 0,
     "from": [
      "S04-B1"
     ],
     "bars": "92–107",
     "at": 4
    },
    {
     "text": "外面还在往前，心里却多了回声",
     "after": 0,
     "from": [
      "S04-B1"
     ],
     "bars": "92–107",
     "at": 10
    },
    {
     "text": "记忆太好了，想到回不去就刺痛",
     "after": 1,
     "from": [
      "S04-B2"
     ],
     "bars": "108–115",
     "at": 20
    },
    {
     "text": "像急促脚步和乱了拍的心跳",
     "after": 2,
     "from": [
      "S04-B3"
     ],
     "bars": "92–115",
     "at": 24
    },
    {
     "text": "如果当时还能怎样，为什么会变这样",
     "after": 3,
     "from": [
      "S04-B4"
     ],
     "bars": "94–115",
     "at": 28
    },
    {
     "text": "不停往前赶，只是怕停下来",
     "after": 3,
     "from": [
      "S04-B4"
     ],
     "bars": "94–115",
     "at": 29
    }
   ],
   "notes": [
    {
     "text": "急促音符像乱跑的脚步，低沉声响一路追赶",
     "from": [
      "S04-B3"
     ],
     "bars": "92–115"
    },
    {
     "text": "声音忽然绷紧如风暴，一串音步步向下",
     "from": [
      "S04-B2"
     ],
     "bars": "108–115"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "他仍觉得当初那些气不该忍",
     "accent": "不该忍",
     "emotion": "炽热",
     "from": [
      "S05-1"
     ],
     "at": 0
    },
    {
     "text": "他不想连开心的回忆都躲着",
     "accent": "开心的回忆",
     "emotion": "悬着",
     "from": [
      "S05-1"
     ],
     "at": 8
    },
    {
     "text": "争得没了力气不服气也淡了",
     "accent": "没了力气",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ],
     "at": 22
    },
    {
     "text": "想到如今已不在那些人身边",
     "accent": "不在那些人身边",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ],
     "at": 32
    },
    {
     "text": "他心里只剩难受",
     "accent": "难受",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ],
     "at": 39
    }
   ],
   "small": [
    {
     "text": "像夜色里两个影子低声说话",
     "after": 0,
     "from": [
      "S05-B1"
     ],
     "bars": "116–147",
     "at": 12
    },
    {
     "text": "怒气悲伤都在，他还想护住自己",
     "after": 1,
     "from": [
      "S05-B2"
     ],
     "bars": "116–127",
     "at": 16
    },
    {
     "text": "像某个人，也像故乡或过去的生活",
     "after": 2,
     "from": [
      "S05-B3"
     ],
     "bars": "116–147",
     "at": 26
    },
    {
     "text": "眷恋里还带着失去的难过",
     "after": 3,
     "from": [
      "S05-B3"
     ],
     "bars": "116–147",
     "at": 30
    },
    {
     "text": "旋律单独露出来，像脚下地板忽然消失",
     "after": 3,
     "from": [
      "S05-B4"
     ],
     "bars": "128–147",
     "at": 35
    },
    {
     "text": "不安又加深，几次深呼吸后只是累了",
     "after": 4,
     "from": [
      "S05-B5"
     ],
     "bars": "132–147",
     "at": 45
    }
   ],
   "notes": [
    {
     "text": "快速音型渐渐放慢变稀，最后化成疏疏和弦",
     "from": [
      "S05-B4"
     ],
     "bars": "128–147"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "心里那阵难受慢慢缓下来",
     "accent": "慢慢缓下来",
     "emotion": "安心",
     "from": [
      "S06-1"
     ],
     "at": 0
    },
    {
     "text": "身边没人他才懂从前多轻松",
     "accent": "多轻松",
     "emotion": "孤单",
     "from": [
      "S06-2"
     ],
     "at": 14
    },
    {
     "text": "他很想再过不用多说的亲近日子",
     "accent": "亲近日子",
     "emotion": "亲密",
     "from": [
      "S06-3"
     ],
     "at": 27
    },
    {
     "text": "可他怕以后再也没有了",
     "accent": "再也没有了",
     "emotion": "不安",
     "from": [
      "S06-3"
     ],
     "at": 40
    },
    {
     "text": "愿望委屈思念终于浮上来",
     "accent": "终于浮上来",
     "emotion": "亲密",
     "from": [
      "S06-B2"
     ],
     "at": 54
    }
   ],
   "small": [
    {
     "text": "这回他没拿受过的气压住想念",
     "after": 0,
     "from": [
      "S06-1"
     ],
     "bars": "",
     "at": 18
    },
    {
     "text": "真真切切拥有过，想起心里暖一点",
     "after": 2,
     "from": [
      "S06-4"
     ],
     "bars": "",
     "at": 30
    },
    {
     "text": "像玻璃罩隔开世界，母亲轻哼摇篮曲",
     "after": 2,
     "from": [
      "S06-B1"
     ],
     "bars": "148–180",
     "at": 34
    },
    {
     "text": "安宁不代表现实变好，挽不回就轻轻看着",
     "after": 3,
     "from": [
      "S06-B1",
      "S06-B4"
     ],
     "bars": "148–180",
     "at": 45
    },
    {
     "text": "终于不用解释难过，也不用装坚强",
     "after": 4,
     "from": [
      "S06-B2"
     ],
     "bars": "148–180",
     "at": 50
    },
    {
     "text": "祈求未必有回应，梦里家园忽然亮起",
     "after": 4,
     "from": [
      "S06-B2"
     ],
     "bars": "148–180",
     "at": 58
    }
   ],
   "notes": [
    {
     "text": "声音绵长从容，像停在一片静谧里",
     "from": [
      "S06-B1"
     ],
     "bars": "148–180"
    },
    {
     "text": "旋律由含蓄试探渐渐展开，末尾像话没说完",
     "from": [
      "S06-B3"
     ],
     "bars": "148–180"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "刚安心又问自己能否独扛难事",
     "accent": "能否独扛难事",
     "emotion": "不安",
     "from": [
      "S07-1"
     ],
     "at": 0
    },
    {
     "text": "他当初只想不再受那些气",
     "accent": "不再受那些气",
     "emotion": "炽热",
     "from": [
      "S07-2"
     ],
     "at": 8
    },
    {
     "text": "没料到离开后会这么孤单",
     "accent": "这么孤单",
     "emotion": "孤单",
     "from": [
      "S07-2"
     ],
     "at": 17
    },
    {
     "text": "他想找回亲近却不愿再受气",
     "accent": "不愿再受气",
     "emotion": "悬着",
     "from": [
      "S07-3"
     ],
     "at": 25
    },
    {
     "text": "当初离开的决心也找不回了",
     "accent": "找不回了",
     "emotion": "悬着",
     "from": [
      "S07-3"
     ],
     "at": 35
    }
   ],
   "small": [
    {
     "text": "寒风像吹开紧闭的窗，后颈一凉",
     "after": 0,
     "from": [
      "S07-B1"
     ],
     "bars": "182",
     "at": 10
    },
    {
     "text": "脉搏猛跳，甜梦一下被拽回严寒",
     "after": 0,
     "from": [
      "S07-B1"
     ],
     "bars": "182",
     "at": 13
    },
    {
     "text": "像突然换了场景，心里却没安定",
     "after": 3,
     "from": [
      "S07-B2"
     ],
     "bars": "182–197",
     "at": 28
    },
    {
     "text": "熟悉动作和舞步闯进来，亲切反而刺痛",
     "after": 3,
     "from": [
      "S07-B4"
     ],
     "bars": "181–205",
     "at": 32
    },
    {
     "text": "熟悉的宣告声又回来，却已立不成秩序",
     "after": 4,
     "from": [
      "S07-B5"
     ],
     "bars": "182–197",
     "at": 39
    },
    {
     "text": "思绪不停翻转，想冲出去却找不到出口",
     "after": 4,
     "from": [
      "S07-B3"
     ],
     "bars": "198–205",
     "at": 44
    }
   ],
   "notes": [
    {
     "text": "高处忽然浮出一串细长颤音",
     "from": [
      "S07-B1"
     ],
     "bars": "182"
    },
    {
     "text": "舞步突然闯入，前面的静谧被截断",
     "from": [
      "S07-B2"
     ],
     "bars": "182–197"
    },
    {
     "text": "颤音一层层连起来，迟迟不停",
     "from": [
      "S07-B3"
     ],
     "bars": "198–205"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "他先把回去的事放一边",
     "accent": "放一边",
     "emotion": "安心",
     "from": [
      "S08-1"
     ],
     "at": 0
    },
    {
     "text": "想起被当自己人心暖未回头",
     "accent": "心暖未回头",
     "emotion": "亲密",
     "from": [
      "S08-1"
     ],
     "at": 5
    },
    {
     "text": "暖意一淡他又怕独自扛难事",
     "accent": "怕独自扛难事",
     "emotion": "不安",
     "from": [
      "S08-2"
     ],
     "at": 10
    }
   ],
   "small": [
    {
     "text": "像临走前回头再看一眼旧地方",
     "after": 1,
     "from": [
      "S08-B2"
     ],
     "bars": "206–213",
     "at": 12
    },
    {
     "text": "胸口终于吸进一口气，只是短暂喘息",
     "after": 2,
     "from": [
      "S08-B3"
     ],
     "bars": "206–213",
     "at": 14
    },
    {
     "text": "回忆没法陪他熬过真正的难处",
     "after": 2,
     "from": [
      "S08-2"
     ],
     "bars": "",
     "at": 14
    }
   ],
   "notes": [
    {
     "text": "缓慢宽广的歌唱短暂地回来",
     "from": [
      "S08-B1"
     ],
     "bars": "206–213"
    }
   ]
