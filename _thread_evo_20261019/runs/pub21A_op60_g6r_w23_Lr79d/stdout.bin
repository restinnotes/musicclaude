{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"先向高处迸发，细碎的光点再缓缓飘落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"细碎光点缓缓飘落\"\n        },\n        {\n          \"quote\": \"还没有真正落稳，仿佛仍悬在水面上方\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"落下却未落稳\"\n        },\n        {\n          \"quote\": \"这里是刚刚踏上船板的感觉\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现自己那么想靠近\",\n          \"point\": \"那么想靠近这个人\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"心里一下热起来；连自己也有点意外\"\n        },\n        {\n          \"text\": \"他怕对方一看出自己有多需要\",\n          \"point\": \"只敢露出一点点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"有多需要这份亲近；觉得负担太重\"\n        },\n        {\n          \"text\": \"只是这么一点亲近就让他觉得甜\",\n          \"point\": \"下次自己能不能更坦白些\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这么一点亲近就让他觉得甜；还拿不准\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"裹在皮肤上有些黏稠\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它没有继续冲向高潮，而像轻轻呼出一口气\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"没有冲向高潮\"\n        },\n        {\n          \"quote\": \"它既像是甜蜜的确认，又带着一点无法排遣的惆怅\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"甜蜜确认里也有惆怅\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有因为他露出在意就退开\",\n          \"point\": \"他才渐渐放松下来\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没有因为他露出在意就退开；仍愿意跟他亲近\"\n        },\n        {\n          \"text\": \"他也想顺势靠得更近\",\n          \"point\": \"怕太急弄坏眼下的自在\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"有一阵子喜欢得几乎藏不住；怕太急弄坏眼下的自在\"\n        },\n        {\n          \"text\": \"两个人待在一起这么好\",\n          \"point\": \"还没分开就先有一点舍不得\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"偏偏想到这样的时刻总会过去；还没分开就先有一点舍不得\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"身体还在这里，心却已经慢慢漂远\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"身体还在，心却已漂远\"\n        },\n        {\n          \"quote\": \"它只在水面上露了一下头\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"音乐并未走向悲剧，却在那份顺畅之中生出了阻力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"顺畅里生出阻力，不是悲剧\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他难得不去琢磨两个人往后会怎样\",\n          \"point\": \"舒舒服服地待在这份亲近里\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"难得不去琢磨两个人往后会怎样；舒舒服服地\"\n        },\n        {\n          \"text\": \"中间他忽然想告诉对方自己多喜欢\",\n          \"point\": \"念头就淡了\",\n          \"where\": \"后\",\n          \"waste\": \"中间\",\n          \"keep\": \"也想问对方是不是一样；可还没想好怎么开口\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"本来一句话已经够了，却忍不住再说一遍，又折回来补上更多细节\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"说了一遍，又折回来补细节\"\n        },\n        {\n          \"quote\": \"一边奋力向高处攀升，一边又渐渐收弱\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"一边上攀，一边收弱\"\n        },\n        {\n          \"quote\": \"你越用力，水面的颠簸就越剧烈，船舱内的平衡就越脆弱\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越用力，船舱里的平衡越脆弱\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"熟悉的亲近又让他满心欢喜\",\n          \"point\": \"想起上回明明想告诉对方却没有开口\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"熟悉的亲近又让他满心欢喜；明明想告诉对方却没有开口\"\n        },\n        {\n          \"text\": \"他几乎想把藏着的话全说出来\",\n          \"point\": \"盼着对方也喜欢他不再小心收着的样子\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"几乎；不再小心收着的样子\"\n        },\n        {\n          \"text\": \"他甚至盼着说出来能把眼下的好留得久一点\",\n          \"point\": \"最后还是留了些话没说\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"能把眼下的好留得久一点；让对方为难；两个人原有的自在也弄丢\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"丰满的声音只剩下一条单薄、孤零零的旋律\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"从“我与你”的亲密中抽身，转而跌回自己的内心\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"从我与你的亲密跌回自己\"\n        },\n        {\n          \"quote\": \"音乐却仿佛自己松开了手\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"前几次想说又收住\",\n          \"point\": \"对方已经看出他有多在乎\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方却一直愿意跟他亲近；不知不觉就忘了藏好喜欢；等察觉时\"\n        },\n        {\n          \"text\": \"先前藏着时还能装作没那么在乎\",\n          \"point\": \"连怎么