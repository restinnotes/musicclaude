 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "离开熟悉生活后，他先觉得终于不用再委屈自己",
       "keys": [
        "终于不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "强撑着提醒自己不能倒下，可心里其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "四周又冷又空，胸口发紧、视线模糊，伸手只摸到虚空",
       "keys": [
        "伸手只摸到虚空"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "失落还不知是不平、遗憾还是怀念",
       "keys": [
        "不知是不平、遗憾还是怀念"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "偶尔旧日场景忽然清晰，身体也隐约记起该怎样迈步",
       "keys": [
        "隐约记起该怎样迈步"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可那只是牵引，他仍不知道靠什么安下心",
       "keys": [
        "不知道靠什么安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前自在的日子，想到以后不能再那样过便发慌",
       "keys": [
        "想到以后不能再那样过便发慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像腿脚发虚的人，还在记忆里勉强挪着舞步",
