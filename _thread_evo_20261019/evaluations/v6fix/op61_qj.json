      "cite": [
       "S01-2",
       "S03-3",
       "S04-2"
      ]
     },
     {
      "id": "S05-2",
      "text": "他开始怕哪天放松一点，这份熟悉也跟着淡掉。",
      "key": "他开始怕哪天放松",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S05-3",
      "text": "这份担心让他更不甘心放手，也更受不了自己已经如此费力。",
      "key": "这份担心让他更不",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1"
      ]
     },
     {
      "id": "S05-4",
      "text": "做惯的细节偶尔还让他觉得亲切，可亲切一过，他又有些孤单。",
      "key": "做惯的细节偶尔还",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-3",
       "S04-2"
      ]
     }
    ],
    "because": [
     {
