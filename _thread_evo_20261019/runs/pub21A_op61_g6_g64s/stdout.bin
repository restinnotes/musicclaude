\"fix\": \"刚落稳，又散了\"\n        },\n        {\n          \"quote\": \"阴冷地闪现回来，却不再像最初那样郑重召唤\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"只是这一次，你已经知道那个过去的自己经历过什么\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然说不清\",\n          \"point\": \"是舍不得从前的生活，还是难受时只想有人陪着\",\n          \"where\": \"中\",\n          \"waste\": \"自己\",\n          \"keep\": \"难受时只想有人陪着\"\n        },\n        {\n          \"text\": \"这个念头让他一阵心慌\",\n          \"point\": \"连往下想都不敢了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一阵心慌\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"fine\": [\n        {\n          \"quote\": \"像忽然失重，整个人悬在半空，辨不清方向\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不再只是尚未开始时的茫然，而是历经许多之后，仍未能获得彻底答案的疲惫\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"这回不是初时的茫然\"\n        },\n        {\n          \"quote\": \"明明知道它很重要，却已经没有力气把它重新讲述一遍\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他最舍不得的\",\n          \"point\": \"回去后还能一样吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"有人把他当作自己人\"\n        },\n        {\n          \"text\": \"当初受过的那些气\",\n          \"point\": \"光凭舍不得，他还是不敢回去\",\n          \"where\": \"后\",\n          \"waste\": \"当初\",\n          \"keep\": \"不能当作没发生过\"\n        },\n        {\n          \"text\": \"他想得筋疲力尽\",\n          \"point\": \"眼下的日子也过得不踏实\",\n          \"where\":