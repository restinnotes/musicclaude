nslateY(-50%);-moz-transform:translateY(-50%);-ms-transform:translateY(-50%);transform:translateY(-50%);bottom:auto;}.css-1l8ptx2 .sectionTitle{font-size:30px;line-height:40px;margin-bottom:5px;}.css-1l8ptx2 .title{font-size:34px;line-height:42px;margin-bottom:30px;}.css-1l8ptx2 .desc{margin:0;font-size:18px;line-height:28px;margin-bottom:40px;min-height:50px;}.css-1l8ptx2 .buttonContent{display:block;}.css-1l8ptx2.right{right:0;padding-right:0;padding-left:80px;}.css-1l8ptx2.rightTop{right:0;top:180px;-webkit-transform:none;-moz-transform:none;-ms-transform:none;transform:none;}.css-1l8ptx2.center{top:80px;left:50%;-webkit-transform:translateX(-50%);-moz-transform:translateX(-50%);-ms-transform:translateX(-50%);transform:translateX(-50%);text-align:center;width:85%;}.css-1l8ptx2.center .buttonContent{display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-box-pack:center;-ms-flex-pack:center;-webkit-justify-content:center;justify-content:center;-webkit-align-items:center;-webkit-box-align:center;-ms-flex-align:center;align-items:center;}}</style><div class="seactionTextContent css-1l8ptx2"><div class="content"><style data-emotion="css 1u5hkdl">.css-1u5hkdl{position:absolute;width:100%;top:-30px;height:28px;overflow:hidden;}.css-1u5hkdl .sectionTitleContent{position:absolute;width:100%;top:0;left:0;z-index:1;-webkit-transition:top 500ms;transition:top 500ms;}.css-1u5hkdl .sectionTitleContent .sectionTitle{white-space:nowrap;-webkit-transition:opacity 500ms;transition:opacity 500ms;margin:0;}.css-1u5hkdl .sectionTitleContent .absoluteButtonContent{position:absolute;width:100%;bottom:-70px;}@media (min-width: 600px){.css-1u5hkdl{top:-150px;height:120px;margin-bottom:30px;}.css-1u5hkdl .sectionTitleContent .sectionTitle{font-size:24px;line-height:40px;}}</style><div class="sectionTitleContainer css-1u5hkdl"><div class="sectionTitleContent"><h2 class="sectionTitle">自动耗材装载</h2><h2 class="sectionTitle">全自动校准程序</h2><h2 class="sectionTitle">自动热床调平</h2><h2 class="sectionTitle">自动 Z 轴相对高度</h2><h2 class="sectionTitle">自动振动校准</h2><h2 class="sectionTitle">自动流量校准</h2><h2 class="sectionTitle">自动皮带张紧</h2><h2 class="sectionTitle">自动耗材装载</h2><h2 class="sectionTitle">全自动校准程序</h2></div></div><style data-emotion="css 1plvhti">.css-1plvhti .sectionTextContent{position:absolute;left:0;top:0;opacity:0;-webkit-transition:all 500ms;transition:all 500ms;}.css-1plvhti .sectionTextContent:nth-of-type(1){opacity:1;}</style><div class="sectionTextContainer css-1plvhti"><div class="sectionTextContent"><h2 class="title">告别繁琐的手动校准和调整</h2><h3 class="desc">A1 可自动完成各类校准。在每次打印前，它都会自动完成 Z 轴相对高度校准、自动热床调平、全共振频率测量和喷嘴压力校准。</h3></div><div class="sectionTextContent"><h2 class="title">告别繁琐的手动校准和调整</h2><h3 class="desc">A1 可自动完成各类校准。在每次打印前，它都会自动完成 Z 轴相对高度校准、自动热床调平、全共振频率测量和喷嘴压力校准。</h3></div><div class="sectionTextContent"><h2 class="title">告别“A4 纸调平法”</h2><h3 class="desc">A1 利用喷嘴对热床进行探测，以测量绝对 Z 轴偏移。告别手动感知，不用再反复抽拉 A4 纸作为调平参考。</h3></div><div class="sectionTextContent"><h2 class="title">打印前实时校准 X &amp; Y 双轴共振</h2><h3 class="desc">A1 的工具头和 Y 轴搭载了传感器，率先支持打印前实时校准 X 轴和 Y 轴共振，并利用算法补偿。</h3></div><div class="sectionTextContent"><h2 class="title">全自动压力提前校准</h2><h3 class="desc">A1 首创基于喷嘴压力的自动流量校准算法，无需绘制任何图案，不必任何手动挑选和匹配，即可自动完成校准。</h3></div><div class="sectionTextContent"><h2 class="title">自动监测和调整皮带</h2><h3 class="desc">松弛的皮带会导致打印质量下降，A1 可以通过振动频率校准自动检查皮带张力。如果皮带张紧力超出算法可校准的范围，HMS 健康管理系统会通知你启用自动程序，调整皮带张力。</h3></div><div class="sectionTextContent"><h2 class="title">一键装载/卸载耗材</h2><h3 class="desc">无需手动设置，A1 可实现耗材装载/卸载过程的全自动化。</h3></div></div></div></div></div></div></div></div><style data-emotion="css ayliak">.css-ayliak{height:calc(var(--vh100) + 800px);position:relative;}.css-ayliak .maxWidthContent{position:relative;width:100%;height:100%;max-width:1920px;margin:0 auto;}.css-ayliak .textContent{position:absolute;left:0;right:0;top:0;bottom:0;z-index:10;}.css-ayliak .scrollVideoContent{width:100%;height:var(--vh100-fixedTop);position:-webkit-sticky;position:sticky;top:var(--fixedTop);}.css-ayliak .scrollVideoContent .imgContent{display:block;position:absolute;left:0;top:0;width:100%;height:100%;z-index:10;overflow:hidden;}.css-ayliak .scrollVideoContent .imgContent .scrollVideoImg{position:absolute;top:0;left:-100%;width:200%;height:100%;object-fit:cover;object-position:center 70%;}.css-ayliak .scrollVideoImg{position:absolute;width:100%;height:100%;object-fit:contain;}.css-ayliak .scrollVideoCanvas{position:absolute;width:100%;height:100%;z-index:10;}@media (min-width: 600px){.css-ayliak .scrollVideoContent .imgContent .scrollVideoImg{top:0;left:0;width:100%;height:100%;object-fit:contain;object-position:center center;}}</style><div class="zh css-ayliak" style="height:calc(var(--vh100-fixedTop) + 2320px)"><div class="maxWidthContent"><div class="scrollVideoContent"><div class="imgContent"><img class="scrollVideoImg" src="https://portal.bblmw.cn/a1/video/nozzle-31ddd63476f42/1.jpg"/></div><div id="end"></div><div class="textContent"><style data-emotion="css 1uqzs8i">.css-1uqzs8i{position:absolute;left:0;top:0;overflow:hidden;width:100%;}</style><div class="item opcityContent css-1uqzs8i"><div class="section css-1vigyk1"><div class="maxWidth"><div class="css-1l8ptx2"><div class="content"><h2 class="sectionTitle">快速维护</h2><h2 class="title">快拆热端</h2><h3 class="desc">全新快拆热端结构设计，轻轻打开热端锁扣，即可磁吸装取。</h3></div></div></div></div></div></div></div></div></div><style data-emotion="css m0c8sz">.css-m0c8sz{width:100%;}.css-m0c8sz .stickyContent{overflow:hidden;position:-webkit-sticky;position:sticky;top:var(--fixedTop);}.css-m0c8sz .rowContent{position:relative;height:var(--vh100-fixedTop);width:100%;}.css-m0c8sz .item{width:100%;height:100%;position:absolute;left:0;top:0;z-index:0;opacity:0;-webkit-transition:opacity 1000ms;transition:opacity 1000ms;}.css-m0c8sz .item:nth-of-type(1){opacity:1;z-index:1;}.css-m0c8sz .progress{position:absolute;bottom:58px;left:50%;width:calc(100% - 50px);max-width:450px;-webkit-transform:translateX(-50%);-moz-transform:translateX(-50%);-ms-transform:translateX(-50%);transform:translateX(-50%);}</style><div class="zh css-m0c8sz" style="height:calc(100vh + 1500px)"><div class="stickyContent"><div class="rowContent"><style data-emotion="css 1o4htdl">.css-1o4htdl{position:relative;overflow:hidden;width:100vw;}.css-1o4htdl .createBy{position:absolute;right:0;bottom:40px;color:#5B441C;width:100%;text-align:center;font-size:12px;line-height:16px;}.css-1o4htdl:nth-of-type(1){height:100%;box-shadow:none;}@media (min-width: 600px){.css-1o4htdl .createBy{right:60px;bottom:40px;font-size:16px;line-height:24px;width:auto;color:#666666;}}</style><div class="item css-1o4htdl"><div class="section css-1vigyk1" style="background:#d0ab90"><div class="imgContent css-1doqxhe"><div class="content"><picture><source data-srcset="https://portal.bblmw.cn/a1/img/amslite-bg-sm-1-f8260a749e8e1.jpg" media="(max-width: 600px)"/><img class="lazyload" data-src="https://portal.bblmw.cn/a1/img/amslite-bg-1-f8260a749e8e1.jpg" alt=""/></picture></div></div><div class="maxWidth"><div class="right css-1l8ptx2"><div class="content"><h2 class="sectionTitle">AMS lite</h2><h2 class="title">简单易用的多色打印</h2><h3 class="desc">全新的自动供料系统 AMS lite 结构精巧、使用可靠，搭配 A1，让每个人都能轻松驾驭多色 3D 打印。</h3></div></div></div></div><div class="createBy">模型作者 @KOZA</div></div><div class="item css-1o4htdl"><div class="section css-1vigyk1" style="background:#BFD6E8"><div class="imgContent css-1doqxhe"><div class="content"><picture><source data-srcset="https://portal.bblmw.cn/a1/img/amslite-bg-sm-2-93da0819a84b8.jpg" media="(max-width: 600px)"/><img class="lazyload" data-src="https://portal.bblmw.cn/a1/img/amslite-bg-2-9ee0e99d328ca.jpg" alt=""/></picture></div></div><div class="maxWidth"><div class="css-1l8ptx2"><div class="content"><h2 class="sectionTitle">AMS lite</h2><h2 class="title">简单易用的多色打印</h2><h3 class="desc">全新的自动供料系统 AMS lite 结构精巧、使用可靠，搭配 A1，让每个人都能轻松驾驭多色 3D 打印。</h3></div></div></div></div><div class="createBy">模型作者 @Sid Naique</div></div><div class="item css-1o4htdl"><div class="section css-1vigyk1" style="background:#d5aa99"><div class="imgContent css-1doqxhe"><div class="content"><picture><source data-srcset="https://portal.bblmw.cn/a1/img/amslite-bg-sm-3-f8260a749e8e1.jpg" media="(max-width: 600px)"/><img class="lazyload" data-src="https://portal.bblmw.cn/a1/img/amslite-bg-3-f8260a749e8e1.jpg" alt=""/></picture></div></div><div class="maxWidth"><div class="right css-1l8ptx2"><div class="content"><h2 class="sectionTitle">AMS lite</h2><h2 class="title">简单易用的多色打印</h2><h3 class="desc">全新的自动供料系统 AMS lite 结构精巧、使用可靠，搭配 A1，让每个人都能轻松驾驭多色 3D 打印。</h3></div></div></div></div><div class="createBy">模型作者 @3_D_M_A</div></div></div></div></div><div class="section fixHeight css-1vigyk1"><div class="imgContent css-1doqxhe"><div class="content"><picture><source data-srcset="https://portal.bblmw.cn/zh/a1/img/compensation-bg-sm-0d7532d01e20c.jpg" media="(max-width: 600px)"/><img class="lazyload" data-src="https://portal.bblmw.cn/zh/a1/img/compensation-bg-0d7532d01e20c.jpg" alt=""/></picture></div></div><div class="maxWidth"><div class="right white css-1l8ptx2"><div class="content"><h2 class="sectionTitle">主动流量补偿</h2><h2 class="title">让每个转角都丝滑流畅</h2><h3 class="desc">A1 革新了 3D 打印流量控制技术。在打印准备阶段，机器会利用工具头内集成的高分辨率、高频涡流传感器监测喷嘴内部压力。流量补偿算法即根据测得的数据，主动补偿流速，以保证精准的挤出。</h3></div></div></div></div><div class="section fixHeight css-1vigyk1"><div class="imgContent css-1doqxhe"><div class="content"><picture><source data-srcset="https://portal.bblmw.cn/a1/img/highSpeedPrecision-bg-sm-642d3e621f73.jpg" media="(max-width: 600px)"/><img class="lazyload" data-src="https://portal.bblmw.cn/a1/img/highSpeedPrecision-bg-642d3e621f73.jpg" alt=""/></picture></div></div><div class="maxWidth"><div class="css-1l8ptx2"><div class="content"><h2 class="sectionTitle">高速精准</h2><h2 class="title">快，稳，准！</h2><h3 class="desc">A1 搭载了全金属导轨和框架、喷嘴压力传感器、加速度计和强大的 MCU。在先进运动控制系统的精准控制下，A1 无需使用特殊的 PLA，即可打出完美的 14 分钟小船。</h3></div></div></div></div><div class="section fixHeight css-1vigyk1"><div class="imgContent css-1doqxhe"><div class="content"><picture><source data-srcset="https://portal.bblmw.cn/a1/img/intuitiveUI-bg-sm-7a79c72123b35.jpg" media="(max-width: 600px)"/><img class="lazyload" data-src="https://portal.bblmw.cn/a1/img/intuitiveUI-bg-7a79c72123b35.jpg" alt=""/></picture></div></div><div class="maxWidth"><div class="right css-1l8ptx2"><div class="content"><h2 class="sectionTitle">直观的 UI 界面</h2><h2 class="title">操作像手机一样简单</h2><h3 class="desc">A1 搭载了简洁的全新 UI 系统，指引流程更加人性化。无需成为 3D 打印专家，即可玩转 A1。</h3></div></div></div></div><div class="section fixHeight css-1vigyk1" style="background:#020202"><div class="imgContent css-1doqxhe"><div class="content"><picture><source data-srcset="https://portal.bblmw.cn/a1/img/worryFreePrinting-bg-sm-909cdd18b3a19.jpg" media="(max-width: 600px)"/><img class="lazyload" data-src="https://portal.bblmw.cn/a1/img/worryFreePrinting-bg-909cdd18b3a19.jpg" alt=""/></picture></div></div><div class="maxWidth"><div class="white css-1l8ptx2"><div class="content"><h2 class="sectionTitle">无忧打印</h2><h2 class="title">启动！然后做自己的事情去吧</h2><h3 class="desc">拓竹以稳定的打印体验闻名，赢得了用户的广泛赞誉。放心开始打印，然后就去做自己的事情吧。</h3></div></div></div></div><div class="section fixHeight css-1vigyk1"><div class="imgContent css-1doqxhe"><div class="content"><picture><source data-srcset="https://portal.bblmw.cn/a1/img/printSilently-bg-sm-db1cb5352dbe8.jpg" media="(max-width: 600px)"/><img class="lazyload" data-src="https://portal.bblmw.cn/a1/img/printSilently-bg-db1cb5352dbe8.jpg" alt=""/></picture></div></div><div class="maxWidth"><div class="left white css-1l8ptx2"><div class="content"><h2 class="sectionTitle">安静打印</h2><h2 class="title">电机主动降噪技术</h2><h3 class="desc">主动降噪及静音模式可使打印机工作噪声水平低于 48 dB。在打印机工作间小憩，也不用怕被打扰。</h3></div></div></div></div><div class="section fixHeight css-1vigyk1"><div class="imgContent css-1doqxhe"><div class="content"><picture><source data-srcset="https://portal.bblmw.cn/a1/img/reliability-bg-sm-f174819632fa5.jpg" media="(max-width: 600px)"/><img class="lazyload" data-src="https://portal.bblmw.cn/a1/img/reliability-bg-f174819632fa5.jpg" alt=""/></picture></div></div><div class="maxWidth"><div class="right white css-1l8ptx2"><div class="content"><h2 class="sectionTitle">可靠性</h2><h2 class="title">全金属框架、轴承和轨道</h2><h3 class="desc">我们不惜成本，为 A1 装配了更可靠的全金属的线轨和导轮，以及有外壳保护的驱动系统。从首次使用开始，卓越品质，始终如一。</h3></div></div></div></div><style data-emotion="css c5frto">.css-c5frto{background:#f1f1f3;height:calc(var(--vh100) + 800px);position:relative;}.css-c5frto .maxWidthContent{position:relative;width:100%;height:100%;max-width:1920px;margin:0 auto;}.css-c5frto .textContent{position:absolute;left:0;right:0;top:0;bottom:0;z-index:10;}.css-c5frto .scrollVideoContent{width:100%;height:var(--vh100-fixedTop);position:-webkit-sticky;position:sticky;top:var(--fixedTop);}.css-c5frto .scrollVideoContent .imgContent{display:block;position:absolute;left:0;top:0;width:100%;height:100%;z-index:10;overflow:hidden;}.css-c5frto .scrollVideoContent .imgContent .scrollVideoImg{position:absolute;top:0;left:-80%;width:200%;height:100%;object-fit:cover;object-position:center 70%;}.css-c5frto .scrollVideoImg{position:absolute;width:100%;height:100%;object-fit:contain;}.css-c5frto .scrollVideoCanvas{position:absolute;width:100%;height:100%;z-index:10;}@media (min-width: 600px){.css-c5frto .scrollVideoContent .imgContent .scrollVideoImg{top:0;left:20%;width:80%;height:100%;object-fit:contain;object-position:center center;}}</style><div class="zh css-c5frto" style="height:calc(var(--vh100-fixedTop) + 2960px)"><div class="maxWidthContent"><div class="scrollVideoContent"><div class="imgContent"><img class="scrollVideoImg" src="https://portal.bblmw.cn/a1/video/camera-050dd54632d891/1.jpg"/></div><div id="end"></div><div class="textContent"><div class="item opcityContent css-1uqzs8i"><div class="section css-1vigyk1"><div class="maxWidth"><div class="css-1l8ptx2"><div class="content"><h2 class="sectionTitle">隐私保护</h2><h2 class="title">相机隐私遮罩</h2><h3 class="desc">可以手动关闭遮罩来禁用相机。</h3></div></div></div></div></div></div></div></div></div><div class="section fixHeight css-1vigyk1"><div class="imgContent css-1doqxhe"><div class="content"><picture><source data-srcset="https://portal.bblmw.cn/a1/img/privacy-1-bg-sm-68a926ffff81d.jpg" media="(max-width: 600px)"/><img class="lazyload" data-src="https://portal.bblmw.cn/a1/img/privacy-1-bg-68a926ffff81d.jpg" alt=""/></picture></div></div><div class="maxWidth"><div class="right white css-1l8ptx2"><div class="content"><h2 class="sectionTitle">隐私模式</h2><h2 class="title">可选仅局域网模式</h2><h3 class="desc">使用局域网模式可远程控制 / 实时查看打印机，并将打印任务发送到你的 A1，而无需通过云端通信。</h3></div></div></div></div><div class="anchor" id="moreToKnow"><style data-emotion="css 1qn265s">.css-1qn265s{display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-box-pack:center;-ms-flex-pack:center;-webkit-justify-content:center;justify-content:center;-webkit-align-items:center;-webkit-box-align:center;-ms-flex-align:center;align-items:center;background:#FFF;padding:10px;padding-top:40px;position:relative;}.css-1qn265s .content{width:100%;display:grid;grid-gap:10px;}.css-1qn265s .content .leftGrid{display:grid;grid-auto-flow:column;grid-template-columns:1fr;grid-template-rows:1fr 1fr 1fr 1fr;grid-gap:10px;}.css-1qn265s .content .rightGrid{display:grid;grid-auto-flow:column;grid-template-columns:1fr;grid-template-rows:1fr 1fr 1fr 1fr;grid-gap:10px;}@media (min-width: 600px){.css-1qn265s{padding-top:85px;padding-bottom:85px;background:#111;}.css-1qn265s .content{grid-auto-flow:row;grid-gap:15px;max-width:900px;}.css-1qn265s .content .leftGrid{display:grid;grid-auto-flow:column;grid-template-rows:200px 1fr 1fr;grid-template-columns:300px 1fr;grid-gap:15px;}.css-1qn265s .content .rightGrid{display:grid;grid-auto-flow:column;grid-template-rows:400px 250px;grid-template-columns:1fr 1fr;grid-gap:15px;}.css-1qn265s.de .title{-webkit-hyphens:auto;-moz-hyphens:auto;-ms-hyphens:auto;hyphens:auto;