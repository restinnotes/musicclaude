   \"line_a\": [\"S07-1\", \"S07-3\"]\n    },\n    {\n      \"sec\": \"S08\",\n      \"groups\": [\n        {\n          \"label\": \"卸下防卫，不再分析，直接敞开地表达喜欢\",\n          \"points\": [\"S08-B1-p1\", \"S08-B1-p2\", \"S08-B1-p3\"]\n        },\n        {\n          \"label\": \"重新明亮轻盈，带着玩心和调情的欢快\",\n          \"points\": [\"S08-B2-p1\", \"S08-B2-p2\", \"S08-B2-p3\"]\n        },\n        {\n          \"label\": \"快乐还留着余温，却已经开始怀念\",\n          \"points\": [\"S08-B3-p1\", \"S08-B3-p2\", \"S08-B3-p3\"]\n        }\n      ],\n      \"tier_a\": [\"S08-B1-p2\", \"S08-B3-p3\"],\n      \"tier_b\": [\"S08-B2-p3\", \"S08-B1-p3\", \"S08-B3-p2\", \"S08-B2-p1\"],\n      \"only_one\": \"S08-B1-p2\",\n      \"line_order\": [\"S08-1\", \"S08-2\", \"S08-3\"],\n      \"line_a\": [\"S08-1\", \"S08-3\"]\n    },\n    {\n      \"sec\": \"S09\",\n      \"groups\": [\n        {\n          \"label\": \"渴望还在，却突然不敢向前，悬在半空\",\n          \"points\": [\"S09-B1-p1\", \"S09-B1-p2\", \"S09-B1-p3\", \"S09-B1-p4\"]\n        },\n        {\n          \"label\": \"明朗忽然转为低气压般的朦胧不安\",\n          \"points\": [\"S09-B2-p1\", \"S09-B2-p2\"]\n        },\n        {\n          \"label\": \"停下来反复回想，怀疑刚才的幸福是否真实\",\n          \"points\": [\"S09-B3-p1\", \"S09-B3-p2\", \"S09-B3-p3\", \"S09-B3-p4\"]\n        },\n        {\n          \"label\": \"不安暂时退开，意识到眼前的美好比自己的愿望更大\",\n          \"points\": [\"S09-B4-p1\", \"S09-B4-p2\"]\n        }\n      ],\n      \"tier_a\": [\"S09-B1-p4\", \"S09-B3-p3\"],\n      \"tier_b\": [\"S09-B2-p1\", \"S09-B1-p1\", \"S09-B3-p1\", \"S09-B4-p2\"],\n      \"only_one\": \"S09-B3-p3\",\n      \"line_order\": [\"S09-1\", \"S09-2\", \"S09-3\"],\n      \"line_a\": [\"S09-1\", \"S09-3\"]\n    },\n    {\n      \"sec\": \"S10\",\n      \"groups\": [\n        {\n          \"label\": \"终于松开紧绷，允许自己好好呼吸、好好感受\",\n          \"points\": [\"S10-B1-p1\", \"S10-B1-p2\", \"S10-B1-p3\", \"S10-B1-p4\"]\n        },\n        {\n          \"label\": \"时间暂时松开，获得一小块可以停留的空地\",\n          \"points\": [\"S10-B2-p1\", \"S10-B2-p2\", \"S10-B2-p3\"]\n        },\n        {\n          \"label\": \"身体轻到失重，仿佛暂时脱离了负担\",\n          \"points\": [\"S10-B3-p1\", \"S10-B3-p2\", \"S10-B3-p3\"]\n        },\n        {\n          \"label\": \"轻亮、细碎、几乎没有重量的美感\",\n          \"points\": [\"S10-B4-p1\", \"S10-B4-p2\"]\n        }\n      ],\n      \"tier_a\": [\"S10-B1-p3\", \"S10-B2-p3\"],\n      \"tier_b\": [\"S10-B1-p1\", \"S10-B3-p2\", \"S10-B3-p3\", \"S10-B2-p2\", \"S10-B1-p4\"],\n      \"only_one\": \"S10-B1-p1\",\n      \"line_order\": [\"S10-1\", \"S10-2\"],\n      \"line_a\": [\"S10-1\", \"S10-2\"]\n    },\n    {\n      \"sec\": \"S11\",\n      \"groups\": [\n        {\n          \"label\": \"欢喜浓烈到身体几乎承受不住，明亮得发疼\",\n          \"points\": [\"S11-B4-p1\", \"S11-B4-p2\", \"S11-B4-p3\", \"S11-B4-p4\"]\n        },\n        {\n          \"label\": \"终于不再为自己的感情道歉，坦然说出来\",\n          \"points\": [\"S11-B1-p1\", \"S11-B1-p2\", \"S11-B1-p3\"]\n        },\n        {\n          \"label\": \"熟悉的温柔有了新的重量，越珍贵越容易心疼\",\n          \"points\": [\"S11-B2-p1\", \"S11-B2-p2\", \"S11-B2-p3\", \"S11-B2-p4\"]\n        },\n        {\n          \"label\": \"悬置已久的期待终于得到满足，但故事还没结束\",\n          \"points\": [\"S11-B3-p1\", \"S11-B3-p2\", \"S11-B3-p3\"]\n        }\n      ],\n      \"tier_a\": [\"S11-B4-p4\", \"S11-B1-p3\", \"S11-B2-p4\"],\n      \"tier_b\": [\"S11-B4-p3\", \"S11-B1-p2\", \"S11-B2-p3\", \"S11-B3-p2\"],\n      \"only_one\": \"S11-B4-p4\",\n      \"line_order\": [\"S11-1\", \"S11-2\", \"S11-3\"],\n      \"line_a\": [\"S11-1\", \"S11-3\"]\n    },\n    {\n      \"sec\": \"S12\",\n      \"groups\": [\n        {\n          \"label\": \"狂喜终于满溢，快乐到想笑又想哭\",\n          \"points\": [\"S12-B3-p1\", \"S12-B3-p2\", \"S12-B3-p3\"]\n        },\n        {\n          \"label\": \"整个人被卷入更大的世界，连自我都暂时退后\",\n          \"points\": [\"S12-B1-p1\", \"S12-B1-p2\", \"S12-B1-p3\"]\n        },\n        {\n          \"label\": \"热切地还想要更多，始终有一点无法满足\",\n          \"points\": [\"S12-B2-p1\", \"S12-B2-p2\", \"S12-B2-p3\"]\n        }\n      ],\n    