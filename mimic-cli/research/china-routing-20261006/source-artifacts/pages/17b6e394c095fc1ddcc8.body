import("/assets/entry.client-5xvKZrPI.js");</script><script defer="" src="https://www.instagram.com/embed.js"></script><!--$?--><template id="B:0"></template><!--/$--><script id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><div hidden id="S:0"><script>window.__reactRouterContext.streamController.enqueue("[{\"_1\":2,\"_3\":-5,\"_4\":-5},\"loaderData\",{\"_5\":6,\"_7\":8},\"actionData\",\"errors\",\"root\",{\"_382\":68,\"_49\":1001,\"_1002\":152,\"_1003\":990,\"_126\":48,\"_1004\":1005,\"_1006\":-7,\"_43\":1007,\"_1008\":10,\"_1009\":1010,\"_1011\":1012,\"_1013\":1014,\"_1015\":1016,\"_709\":1017,\"_1018\":1019,\"_1020\":-7,\"_1021\":1022,\"_1023\":1024,\"_1025\":1026,\"_1027\":1028,\"_25\":1029},\"routes/$topic.$slug._index\",{\"_9\":10,\"_11\":10,\"_12\":10,\"_13\":14,\"_15\":16,\"_17\":18,\"_19\":20,\"_21\":22,\"_23\":24,\"_25\":26,\"_27\":-7},\"isRequestedByGoogleBot\",false,\"isUserEntitled\",\"isGatedAsPaid\",\"metadata\",{\"_278\":84,\"_231\":64,\"_987\":988,\"_989\":990,\"_991\":992,\"_81\":82,\"_214\":33,\"_51\":216,\"_993\":10,\"_994\":10,\"_247\":10,\"_995\":996},\"template\",{\"_202\":203,\"_204\":205,\"_103\":-5,\"_206\":207,\"_208\":121,\"_209\":66,\"_210\":66,\"_211\":33,\"_212\":33,\"_213\":33,\"_214\":33,\"_215\":216,\"_217\":218,\"_219\":220,\"_221\":222,\"_223\":155,\"_224\":-5,\"_129\":225,\"_226\":227,\"_228\":229,\"_230\":153,\"_231\":64,\"_105\":232,\"_233\":234,\"_81\":235,\"_236\":237,\"_238\":239,\"_240\":241,\"_242\":243,\"_244\":245,\"_246\":33,\"_247\":248,\"_249\":10,\"_250\":251,\"_252\":253,\"_254\":255,\"_12\":10,\"_256\":-7},\"schema\",[131,132,133],\"seo\",{\"_119\":68,\"_120\":121,\"_122\":66,\"_123\":10,\"_124\":125,\"_126\":48,\"_127\":-7,\"_128\":10,\"_129\":130},\"gtm\",{\"_55\":56},\"siteSetting\",{\"_28\":29,\"_30\":31,\"_32\":33,\"_34\":33,\"_35\":36},\"ruid\",\"6qabsln6oyu\",\"pageHeaderSettings\",\"placeholderImages\",{\"_49\":50,\"_51\":52,\"_53\":33,\"_54\":33},\"siteBranding\",{\"_41\":42,\"_43\":44},\"defaultGatingTitle\",\"\",\"defaultGatingDescriptionMessage\",\"newsletterCta\",{\"_37\":38,\"_39\":40},\"newsletterTitle\",\"Newsletter Sign-Up\",\"newsletterUrl\",\"https://lr-resources.lightreading.com/c/pubRD.mpl?secure=1\u0026sr=pp\u0026_t=pp:\u0026qf=w_defa4290\u0026ch=lrwebbutton \",\"siteLogo\",{\"_45\":46,\"_47\":48},\"favicons\",[],\"logoUrl\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt6ee1ea97d4d5fb01/6488533a98284a90a3e608e5/Light_Reading_Logo_landscape_color.svg\",\"altText\",\"Light Reading\",\"brand\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/bltf3253c29056fe0aa/64885212c62638785f0518fc/LR_generic_image.png\",\"contributor\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/bltd25d6f83f51b1164/64885062a180be48d216859d/default-contributor.png\",\"openGraphImage\",\"openGraphLogoOverlay\",\"loadEvent\",{\"_57\":58,\"_59\":60,\"_61\":62},\"attributes\",{\"_101\":102,\"_103\":33,\"_19\":104,\"_105\":106,\"_107\":108},\"category\",{\"_80\":33,\"_81\":82,\"_83\":84,\"_85\":86,\"_87\":88,\"_89\":-7,\"_90\":91,\"_92\":93},\"pageInfo\",{\"_63\":64,\"_65\":66,\"_67\":68,\"_69\":70,\"_51\":71,\"_72\":10},\"pageID\",\"blt00469726fb1d6cfa\",\"pageName\",\"AT\u0026T, T-Mobile and Verizon's smartphone promotions push Q2 sales performance – report\",\"destinationURL\",\"https://www.lightreading.com/smartphones-devices/at-t-t-mobile-and-verizon-s-smartphone-promotions-push-q2-sales-performance-report\",\"issueDate\",\"Aug 19, 2025\",[73],\"isPaid\",{\"_74\":48,\"_75\":76,\"_77\":78,\"_79\":76},\"companyName\",\"displayName\",\"Kelsey Ziser\",\"jobTitle\",\"Senior Editor\",\"name\",\"buyerJourney\",\"contentFormat\",\"News\",\"pageType\",\"article\",\"keyword\",[],\"series\",[],\"programName\",\"primaryTerm\",{\"_95\":99,\"_96\":100,\"_98\":33},\"secondaryTerm\",[94],{\"_95\":33,\"_96\":97,\"_98\":33},\"parent\",\"child\",\"Customer Experience\",\"grandchild\",\"Wireless\",\"Smartphones \u0026 Devices\",\"events\",[],\"subBrand\",{\"_117\":68,\"_118\":10},\"sponsored\",{\"_79\":110,\"_111\":33,\"_112\":10,\"_113\":10,\"_114\":115,\"_116\":33},\"legacy\",{\"_109\":33,\"_69\":33,\"_51\":33},\"destinationPath\",[],\"campaignURL\",\"isSponsored\",\"gateWithSiteReg\",\"gateWithExternalForm\",\"None\",\"externalFormID\",\"canonicalURL\",\"hideFromSearchEngines\",\"canonicalUrl\",\"metaDescription\",\"Carrier promotions have played an important role in increasing smartphone sell-through rates for the Big Three mobile operators in Q2 of 2025, according to Counterpoint Research.\",\"metaTitle\",\"noIndex\",\"imageUrl\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt1704f62468ad6b62/6745c3d5120ebc03f99c0ca4/people_holding_smartphones_at_music_gig_16x9_source_Stephen_Barnes-Technology-Alamy_Stock_Photo_.jpg?disable=upscale\u0026width=1200\u0026height=630\u0026fit=crop\",\"siteName\",\"mediaLinks\",\"noArchive\",\"keywords\",\"Smartphones \u0026 Devices, Customer Experience\",{\"_134\":135,\"_136\":153,\"_154\":155,\"_156\":157,\"_158\":66,\"_159\":68,\"_160\":161,\"_162\":163,\"_164\":165},{\"_134\":135,\"_136\":140,\"_141\":142},{\"_134\":135,\"_136\":137,\"_138\":139},\"@context\",\"https://schema.org\",\"@type\",\"WebPage\",\"isAccessibleForFree\",\"True\",\"BreadcrumbList\",\"itemListElement\",[143,144],{\"_136\":145,\"_146\":150,\"_79\":151,\"_148\":152},{\"_136\":145,\"_146\":147,\"_79\":100,\"_148\":149},\"ListItem\",\"position\",2,\"item\",\"https://www.lightreading.com/wireless/smartphones-devices\",1,\"Home\",\"https://www.lightreading.com\",\"Article\",\"datePublished\",\"2025-08-19T12:00:00.000Z\",\"dateModified\",\"2025-08-18T23:17:50.762Z\",\"headline\",\"mainEntityOfPage\",\"image\",{\"_136\":177,\"_168\":198,\"_199\":33,\"_200\":201},\"author\",[194],\"publisher\",{\"_136\":166,\"_167\":152,\"_79\":48,\"_168\":152,\"_169\":170,\"_171\":172,\"_173\":174,\"_175\":176},[191,192,193],\"identifier\",\"url\",\"sameAs\",[187,188,189,190],\"foundingDate\",\"2000\",\"description\",\"To inform and enlighten everyone working in this vital, multi-trillion-dollar sector.\",\"logo\",{\"_136\":177,\"_168\":178,\"_179\":180,\"_181\":182},\"ImageObject\",\"https://www.lightreading.com/assets/LightReading-Ndi7fH-L.svg\",\"width\",{\"_136\":183,\"_184\":186},\"height\",{\"_136\":183,\"_184\":185},\"QuantitativeValue\",\"value\",112,798,\"https://twitter.com/Light_Reading\",\"https://www.linkedin.com/company/light-reading/\",\"https://www.facebook.com/LightReading/\",\"https://news.google.com/publications/CAAqBwgKMNvnygswi4PiAw\",\"NewsMediaOrganization\",\"Organization\",\"OnlineBusiness\",{\"_136\":195,\"_79\":76,\"_160\":196,\"_168\":197},\"Person\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blta3d74b6fc2bf93c6/679bd9e67303e7fcc4463433/Kelsey_2025_2.jpg\",\"https://www.lightreading.com/author/kelsey-ziser\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt1704f62468ad6b62/6745c3d5120ebc03f99c0ca4/people_holding_smartphones_at_music_gig_16x9_source_Stephen_Barnes-Technology-Alamy_Stock_Photo_.jpg\",\"caption\",\"creditText\",\"(Source: Stephen Barnes/Technology/Alamy Stock Photo)\",\"breadcrumbs\",[984,985],\"topics\",[980,981],\"searchParams\",{},\"summary\",\"title\",\"mobileHeadline\",\"authoredBy\",\"authoredOn\",\"oldUrl\",\"buyersJourney\",\"contributors\",[955],\"readTime\",4,\"articleFooter\",[924,925],\"socialShare\",[909,910,911,912,913],\"publishedDate\",\"updatedDate\",[],\"atAGlance\",[],\"bodyJson\",[725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750],\"contentType\",\"uid\",{\"_723\":724,\"_111\":33,\"_112\":10,\"_113\":10,\"_114\":115,\"_116\":33},\"featuredImage\",{\"_554\":198,\"_556\":721,\"_199\":33,\"_722\":201},{\"_209\":82,\"_168\":720},\"seriesTaxonomy\",[],\"programTaxonomy\",[],\"sidebarModules\",[286,287,288,289,290,291],\"relatedEvents\",[],\"topicSelector\",{\"_273\":274,\"_275\":276},\"disclaimer\",\"paidGating\",{\"_270\":10,\"_271\":272},\"hasActivePaidProduct\",\"errorModal\",{\"_265\":10,\"_266\":267,\"_268\":269},\"additionalGatingSettings\",{\"_261\":262,\"_263\":33,\"_264\":33},\"pageDisplaySelection\",{\"_257\":258,\"_259\":-5,\"_260\":10},\"tableOfContent\",\"displayOptions\",\"defaultStandardPage\",\"bannerImage\",\"inlineFormGatedLandingPage\",\"gatingCharacterLength\",750,\"gatingTitle\",\"gatingDescriptionMessage\",\"showErrorModal\",\"errorTitle\",\"Oops! An error has occurred\",\"errorDescription\",\"The connection on our end has been interrupted. Please refresh the page and try again.\",\"isPaidContent\",\"paidProductTaxonomies\",[],\"mainTopic\",{\"_278\":279,\"_209\":100,\"_168\":284,\"_281\":285},\"additionalTopics\",[277],{\"_278\":279,\"_209\":97,\"_168\":280,\"_281\":282},\"type\",\"TopicSecondary\",\"/digital-transformation/customer-experience\",\"parentTopic\",{\"_278\":283,\"_209\":33},\"TopicPrimary\",\"/wireless/smartphones-devices\",{\"_278\":283,\"_209\":99},{\"_278\":694,\"_231\":695,\"_294\":696},{\"_278\":679,\"_231\":680,\"_294\":681},{\"_278\":506,\"_231\":621,\"_294\":622},{\"_278\":602,\"_231\":603,\"_294\":604},{\"_278\":506,\"_231\":507,\"_294\":508},{\"_278\":292,\"_231\":293,\"_294\":295},\"module_content_spotlight\",\"bltcdd66845e6e86f33\",\"data\",{\"_296\":297,\"_298\":299,\"_300\":301,\"_302\":303,\"_230\":153,\"_304\":33,\"_305\":306},\"variant\",\"reversed\",\"mode\",\"light\",\"textAlignment\",\"left\",\"moduleDesign\",\"standard\",\"listPageUrl\",\"content\",{\"_129\":307,\"_160\":308,\"_208\":309,\"_310\":311,\"_312\":311,\"_313\":314,\"_315\":316,\"_317\":316,\"_318\":319,\"_320\":321,\"_322\":323,\"_324\":325,\"_326\":327,\"_328\":329,\"_247\":330,\"_249\":10,\"_331\":332,\"_333\":334},[],{\"_168\":504,\"_47\":505},\"Featured Story\",\"heading\",\"Nexfibre CEO slams 'counter fantasy' of CityFibre buying Netomnia\",\"mobileHeading\",\"articleBody\",[342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360],\"articleSummary\",\"After UK authorities raise 'counterfactual' objections to Nexfibre's takeover of Netomnia, Nexfibre's Rajiv Datta questions the logic.\",\"body\",\"callToAction\",{\"_340\":341,\"_168\":323},\"linkAttrs\",{},\"articleUrl\",\"/fttx/nexfibre-ceo-slams-counter-fantasy-of-cityfibre-buying-netomnia\",\"categoryName\",\"FTTX\",\"categoryUrl\",\"/network-technology/broadband/fttx\",\"date\",\"2026-10-05T10:03:23.000Z\",{\"_337\":10,\"_338\":339},\"sponsorshipGatingGroup\",{\"_335\":10,\"_336\":10},\"timeRead\",6,\"sponsorshipGatingSponsorFlag\",\"sponsorshipGatingGateRegFlag\",\"paidContent\",\"paidProductTaxonomy\",[],\"text\",\"More\",{\"_278\":361,\"_362\":500,\"_305\":501},{\"_278\":361,\"_362\":496,\"_305\":497},{\"_278\":361,\"_362\":484,\"_305\":485},{\"_278\":361,\"_362\":473,\"_305\":474},{\"_278\":361,\"_362\":469,\"_305\":470},{\"_278\":310,\"_362\":465,\"_305\":466},{\"_278\":361,\"_362\":461,\"_305\":462},{\"_278\":361,\"_362\":457,\"_305\":458},{\"_278\":361,\"_362\":453,\"_305\":454},{\"_278\":361,\"_362\":433,\"_305\":434},{\"_278\":361,\"_362\":429,\"_305\":430},{\"_278\":310,\"_362\":423,\"_305\":424},{\"_278\":361,\"_362\":419,\"_305\":420},{\"_278\":361,\"_362\":415,\"_305\":416},{\"_278\":361,\"_362\":403,\"_305\":404},{\"_278\":361,\"_362\":399,\"_305\":400},{\"_278\":361,\"_362\":395,\"_305\":396},{\"_278\":361,\"_362\":368,\"_305\":369},{\"_278\":361,\"_362\":363,\"_305\":364},\"paragraph\",\"attrs\",{\"_367\":301},[365],{\"_278\":340,\"_340\":366},\"Years of altnet activity have left much of the UK crisscrossed with loss-making fiber lines and weakened the appetite for laying even more. But stitching all that into a handful of competitive and profitable ventures is turning into a major challenge.\",\"textAlign\",{\"_367\":301},[370,371,372,373,374],{\"_278\":340,\"_340\":394},{\"_278\":340,\"_376\":389,\"_340\":390},{\"_278\":340,\"_340\":388},{\"_278\":340,\"_376\":377,\"_340\":378},{\"_278\":340,\"_340\":375},\". \\\"The CMA seems to believe that it will whether this deal happens or not, which may not be right.\\\"\",\"marks\",[379],\"a LinkedIn post\",{\"_278\":380,\"_362\":381},\"link\",{\"_382\":383,\"_384\":385,\"_386\":-5,\"_387\":-5},\"href\",\"https://lnkd.in/p/ez9tnYK3\",\"target\",\"_self\",\"rel\",\"class\",\" to be targeting about £600 million ($793 million) in cost savings. An assumption that fiber investment will continue looks suspect. \\\"One point that may still be debatable is whether VMO2 will upgrade its network from cable to fiber,\\\" said Karen Egan, the managing director of telecoms at Enders Analysis, in \",[391],\"reported\",{\"_278\":380,\"_362\":392},{\"_382\":393,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.ft.com/content/56a0085d-460d-45a1-a5a9-7dc862e826c0?syn-25a6b1a6=1\",\"Nexfibre's own buildout pace has also recently slowed, while VMO2 is burdened with debt and \",{\"_367\":301},[397],{\"_278\":340,\"_340\":398},\"The CMA's other counterfactual is that VMO2/Nexfibre \\\"would continue to upgrade its cable network to FTTP [fiber-to-the-premises] and would also wholesale this to ISPs.\\\" But earlier funding problems at CityFibre and a slowdown in the pace of its rollout surely prove there can be no such guarantees. CityFibre added 800,000 premises in 2024, reaching 4.4 million by the end of that year. But its footprint grew by fewer than 600,000 in the subsequent 18 months.\",{\"_367\":301},[401],{\"_278\":340,\"_340\":402},\"There are other problems with the CMA's review, as well. It observes that \\\"Substantial's financial outlook has deteriorated in recent years, and whilst it was a viable option to continue as a standalone entity, this was not attractive compared to a sale at an acceptable valuation.\\\" That bleak review seems bound to hurt Substantial's future valuation and will not do much to attract investment in the UK.\",{\"_367\":301},[405,406,407],{\"_278\":340,\"_340\":414},{\"_278\":340,\"_376\":409,\"_340\":410},{\"_278\":340,\"_340\":408},\" at a breakfast briefing in June.\",[411],\"said Datta\",{\"_278\":380,\"_362\":412},{\"_382\":413,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.lightreading.com/fttx/openreach-fiber-monopoly-is-a-growing-threat-says-nexfibre-ceo\",\"Years since the \\\"altnets\\\" first began digging roads and climbing poles, that has not really happened. Openreach still served 19.3 million broadband customers at the end of March, having lost about 1.9 million in the preceding two years. \\\"Logically, with this position by the regulator, their share should go down from x to y, and I would argue that they're nowhere near where y should be,\\\" \",{\"_367\":301},[417],{\"_278\":340,\"_340\":418},\"The real problem is not the prospect of a wholesale choice between VMO2/Nexfibre and Openreach across half a million homes. It is the choice of Openreach or nothing for millions. As heavily regulated as Openreach may be, the emergence of competition would be a preferable safeguard against monopolistic behavior.\",{\"_367\":301},[421],{\"_278\":340,\"_340\":422},\"In the meantime, vast swathes of the UK continue to lack a wholesale network alternative to Openreach. Evidence of that can be seen in the premises-passed figures disclosed by the big providers. That Netomnia deal would leave Nexfibre on fewer than 6 million, while CityFibre does not even reach 5 million. Nor is there a wholesale market for hybrid-fiber coax (HFC), the technology still mainly used by VMO2. Openreach is literally streets ahead with almost 23 million at the end of March.\",{\"_367\":301,\"_427\":428},[425],{\"_278\":340,\"_340\":426},\"Openreach or nothing\",\"level\",5,{\"_367\":301},[431],{\"_278\":340,\"_340\":432},\"Arguably a much greater concern for the CMA is BT's proposed takeover of TalkTalk, a struggling retailer of broadband services, announced earlier today. While it would rescue TalkTalk from administration, it would give the UK's dominant broadband player another 2.5 million customers and eliminate the fourth-biggest retailer after BT, Sky and VMO2.\",{\"_367\":301},[435,436,437,438,439],{\"_278\":340,\"_340\":452},{\"_278\":340,\"_376\":447,\"_340\":448},{\"_278\":340,\"_340\":446},{\"_278\":340,\"_376\":441,\"_340\":442},{\"_278\":340,\"_340\":440},\" there was overlap between VMO2/Nexfibre and Netomnia across 540,000 homes in XGS-PON, a high-speed fiber technology.\",[443],\"Assembly Research said\",{\"_278\":380,\"_362\":444},{\"_382\":445,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://nationalwholesalechallenger.co.uk/the-next-chapter-in-uk-fibre-assembly-research-report/?_sp=fc7bcc13-5a63-4d4e-beb2-c9325f9c14fd.1791188292664\",\" with Light Reading in March, after the deal was announced, he reckoned the Nexfibre and Netomnia full-fiber footprints overlapped across only about 200,000 homes. More recently, \",[449],\"Datta spoke\",{\"_278\":380,\"_362\":450},{\"_382\":451,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.lightreading.com/fttx/nexfibre-ceo-defends-2b-netomnia-deal-against-cityfibre-attack\",\"Yet all this seems quite pernickety. Essentially, the CMA is objecting to a deal that could produce a stronger wholesale player for more than a quarter of UK homes because it would shrink the options for a few hundred thousand at most. When \",{\"_367\":301},[455],{\"_278\":340,\"_340\":456},\"Consequently, the proposed deal would leave customers in some areas with a wholesale choice between only Openreach, the BT-owned incumbent, and a VMO2/Nexfibre that has been strengthened by its Netomnia takeover. Were CityFibre to acquire Netomnia instead, those areas would continue to feature competition between three wholesale providers.\",{\"_367\":301},[459],{\"_278\":340,\"_340\":460},\"A regulatory preference for a deal involving CityFibre seems predicated on the idea it would have a less negative impact on competition. One problem with Nexfibre as an acquirer is that it is 50% owned by Liberty Global and Telefónica, the parents of Virgin Media O2 (VMO2), one of the UK's big three consumer-facing telcos. Treating the VMO2 and Nexfibre networks as a single entity, the CMA notes that 14% of its full-fiber footprint is overlapped by Netomnia. Overlap between CityFibre and Netomnia, by contrast, is \\\"minimal.\\\"\",{\"_367\":301},[463],{\"_278\":340,\"_340\":464},\"Shellshocked observers included Rajiv Datta, Nexfibre's CEO. \\\"They're supposed to consider a counterfactual. It feels like they've considered a counter fantasy, and that counter fantasy they have includes this view that CityFibre would do a series of things,\\\" he told Light Reading. \\\"It is frankly surprising that the CMA would take the view that something that actually could have happened but did not happen would happen in the future.\\\"\",{\"_367\":301,\"_427\":428},[467],{\"_278\":340,\"_340\":468},\"'Frankly surprising'\",{\"_367\":301},[471],{\"_278\":340,\"_340\":472},\"On top of this, CityFibre is known to have been outbid for Netomnia by Nexfibre. Simon Holden, CityFibre's CEO, apparently wanted to offer more but did not receive the necessary backing from his investors. Those circumstances make the nature of the CMA's intervention look even more unorthodox, as if the CMA is trying to steer the market toward a preferred scenario in which one private-sector company succeeds at another's expense.\",{\"_367\":301},[475,476,477],{\"_278\":340,\"_340\":483},{\"_278\":340,\"_376\":479,\"_340\":378},{\"_278\":340,\"_340\":478},\".\",[480],{\"_278\":380,\"_362\":481},{\"_382\":482,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://lnkd.in/p/eq3W7ef7\",\"Regulators commonly weigh such counterfactuals when deciding whether to approve a planned merger. Conventionally, however, this would mean simply assuming the market continues as before. \\\"The choice of counterfactual was surprising: In doing so, the Competition and Markets Authority may have signaled (if not in words, but at least in effect) how it wants the fiber market to develop, which doesn't feel like what its review should do,\\\" said James Robinson, a senior analyst at Assembly Research, in \",{\"_367\":301},[486,487,488],{\"_278\":340,\"_340\":495},{\"_278\":340,\"_376\":490,\"_340\":491},{\"_278\":340,\"_340\":489},\" on the merger, \\\"our provisional view is that the most likely counterfactual is an acquisition of Substantial by CityFibre, with a subsequent sale of Substantial's retail businesses to a third-party ISP [Internet service provider].\\\"\",[492],\"summary of its interim report\",{\"_278\":380,\"_362\":493},{\"_382\":494,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://assets.publishing.service.gov.uk/media/6abf3d25f04a15f5337228c4/_Summary_of_Interim_report_.pdf\",\"Even more strikingly, it has also expressed the opinion that CityFibre would acquire Substantial, Netomnia's parent, if the current deal were blocked. As it states in the \",{\"_367\":301},[498],{\"_278\":340,\"_340\":499},\"The deal would create a company with a full-fiber network reaching about 5.8 million homes in a country of more than 30 million. Planned upgrades would boost this to about 8 million by the end of 2027. The CMA's big objection is that a tie-up between those specific companies would significantly lessen competition in parts of the UK. Strikingly, it has made clear that it would prefer to see Netomnia bought by CityFibre, a Nexfibre competitor that has been an outspoken critic of the deal.\",{\"_367\":301},[502],{\"_278\":340,\"_340\":503},\"The UK's Competition and Markets Authority (CMA) cannot be accused of predictability in its rulings on the telecom sector. Years after warning a mobile merger between O2 and Three would damage competition by reducing the number of operators, it blessed the same type of deal between Vodafone and Three without even mandating any structural remedies. Seemingly in blocking mood once again, it has now voiced opposition to a £2 billion (US$2.6 billion) takeover of Netomnia by Nexfibre that would unite two medium-sized broadband players. Most commentators are taken aback.\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt377a4b341431c415/67f7d70639bc7583d329fcc2/O2_Telefonica_logo_on_smartphone_screen_hold_in_hand_and_Virgin_Media_logo_on_blurred_background.jpeg\",\"O2 logo on a smartphone being held up in front of a Virgin Media sign\",\"module_content_cards\",\"blte9fa696e59b7cf66\",{\"_509\":510,\"_209\":511,\"_512\":33,\"_296\":513,\"_514\":515,\"_516\":517,\"_518\":519,\"_520\":519,\"_521\":-7,\"_522\":523,\"_380\":524,\"_525\":526},\"isDynamicContent\",true,\"Our Latest Videos\",\"moduleLabel\",\"column\",\"contentDisplayOption\",\"verticalCard\",\"contents\",[530,531,532,533],\"dateDisplay\",\"hide\",\"contributorDisplay\",\"displayAd\",\"settingOption\",\"dynamic\",{\"_382\":527,\"_528\":529},\"moduleLocation\",\"sidebar\",\"/program/light-reading-studios\",\"label\",\"More videos\",{\"_278\":534,\"_294\":591},{\"_278\":534,\"_294\":571},{\"_278\":534,\"_294\":558},{\"_278\":534,\"_294\":535},\"contentPreview\",{\"_230\":536,\"_296\":537,\"_538\":539,\"_540\":541,\"_210\":541,\"_322\":542,\"_304\":543,\"_320\":544,\"_328\":545,\"_546\":33,\"_324\":547,\"_326\":548,\"_215\":549,\"_333\":550,\"_247\":551,\"_249\":10,\"_331\":552},\"Video\",\"card-vertical\",\"thumbnail\",{\"_554\":555,\"_556\":557},\"articleName\",\"Analyst insight: 6G coming into focus\",\"/6g/analyst-insight-6g-coming-into-focus\",\"/videos\",{},\"Jun 8, 2026\",\"webinarStartTime\",\"Sponsored Content\",\"#\",[],0,{\"_337\":10,\"_338\":553},{\"_335\":510,\"_336\":10},[],\"src\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt7b2699ca71ef4c97/6a26c0bb3747447e32e8db9a/Slide1_1.jpeg\",\"alt\",\"Image reads '6G coming into focus'\",{\"_230\":536,\"_296\":537,\"_538\":559,\"_540\":560,\"_210\":560,\"_322\":561,\"_304\":543,\"_320\":562,\"_328\":563,\"_546\":33,\"_324\":564,\"_326\":565,\"_215\":566,\"_333\":550,\"_247\":567,\"_249\":10,\"_331\":568},{\"_554\":570,\"_556\":33},\"Evolving from a \\\"Bits Transport Pipeline' to the \\\"Tokens Connectivity Foundation\\\"\",\"/ai-machine-learning/evolving-from-a-bits-transport-pipeline-to-the-tokens-connectivity-foundation-\",{},\"Jun 25, 2026\",\"AI \u0026 Machine Learning\",\"/digital-transformation/ai-machine-learning\",[],{\"_337\":10,\"_338\":569},{\"_335\":10,\"_336\":10},[],\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt42d51297b25a214c/6a3d34f70c25e3da85d20a7c/Screenshot_2026-06-25_at_15.02.12.png\",{\"_230\":536,\"_296\":537,\"_538\":572,\"_540\":573,\"_210\":573,\"_322\":574,\"_304\":543,\"_320\":575,\"_328\":576,\"_546\":33,\"_324\":577,\"_326\":578,\"_215\":579,\"_333\":550,\"_247\":580,\"_249\":10,\"_331\":581},{\"_554\":590,\"_556\":33},\"Ericsson Intelligent Automation Platform expands to support core network automation\",\"/5g/ericsson-intelligent-automation-platform-expands-to-support-core-network-automation\",{},\"Jul 6, 2026\",\"5G\",\"/wireless/5g\",[583],{\"_337\":10,\"_338\":582},{\"_335\":10,\"_336\":10},[],{\"_79\":584,\"_380\":585,\"_586\":587,\"_588\":589},\"Scott Bicheno\",\"/author/scott-bicheno\",\"avatar\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt2af43386e9877481/64a3370c88d2997ff9fb5eb2/scott-bicheno-headshot.jpg\",\"role\",\"Editorial Director at Telecoms.com\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt827bb8efc68b7bdc/6a4b7695cee0306b8b7930de/Screenshot_2026-07-06_at_10.21.15.png\",{\"_230\":536,\"_296\":537,\"_538\":592,\"_540\":593,\"_210\":593,\"_322\":594,\"_304\":543,\"_320\":595,\"_328\":596,\"_546\":33,\"_324\":577,\"_326\":578,\"_215\":597,\"_333\":550,\"_247\":598,\"_249\":10,\"_331\":599},{\"_554\":601,\"_556\":33},\"Comsol at ZTE Global Summit 2026: Charting a 5G-Powered Path from Connectivity Provider to Digital Infrastructure Partner\",\"/5g/comsol-at-zte-global-summit-2026\",{},\"Sep 14, 2026\",[],{\"_337\":10,\"_338\":600},{\"_335\":10,\"_336\":10},[],\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/bltbf2f3455d498590a/6aa7c3763c5f102bd9798238/Screenshot_2026-09-14_at_08.56.35.png\",\"module_embed\",\"blt3f36336cc3ba8bf5\",{\"_209\":605,\"_606\":607,\"_608\":609,\"_525\":526},\"Netline - Resources\",\"embedCode\",\"\u003ciframe height=\\\"325\\\" src=\\\"https://docs.google.com/spreadsheets/d/e/2PACX-1vQjX8WLzZZeJlO3uLk-n9OHp7V7TTLT6eMg3pdlNHnx48tBqtl7my8yLCGBqchY_rm9BpnYdXVS9KlF/pubhtml?gid=552530617\u0026widget=false\u0026headers=false\u0026chrome=false\\\"\u003e\u003c/iframe\u003e\",\"embedCodeJson\",[610],{\"_278\":611,\"_362\":612},\"iframe\",{\"_179\":613,\"_181\":614,\"_615\":-5,\"_616\":-5,\"_617\":-5,\"_554\":618,\"_619\":620},\"100%\",\"325px\",\"scrolling\",\"frameBorder\",\"allow\",\"https://docs.google.com/spreadsheets/d/e/2PACX-1vQjX8WLzZZeJlO3uLk-n9OHp7V7TTLT6eMg3pdlNHnx48tBqtl7my8yLCGBqchY_rm9BpnYdXVS9KlF/pubhtml?gid=552530617\u0026widget=false\u0026headers=false\u0026chrome=false\",\"loading\",\"lazy\",\"blt4c0980bd81f39de8\",{\"_509\":510,\"_209\":623,\"_512\":33,\"_296\":513,\"_514\":624,\"_516\":625,\"_518\":626,\"_520\":519,\"_521\":-7,\"_522\":523,\"_380\":627,\"_525\":526},\"Popular whitepapers in 5G\",\"textList\",[630,631,632],\"show\",{\"_382\":628,\"_528\":629},\"/documents\",\"More whitepapers\",{\"_278\":534,\"_294\":666},{\"_278\":534,\"_294\":651},{\"_278\":534,\"_294\":633},{\"_230\":634,\"_296\":537,\"_538\":635,\"_540\":636,\"_210\":636,\"_322\":637,\"_304\":628,\"_320\":638,\"_328\":639,\"_546\":33,\"_324\":547,\"_326\":548,\"_215\":640,\"_333\":550,\"_247\":641,\"_249\":10,\"_331\":642},\"Document\",{\"_554\":649,\"_556\":650},\"AI-Powered RAN: Moving Beyond Basic Automation\",\"/wireless/ai-powered-ran-moving-beyond-basic-automation\",{},\"Sep 22, 2025\",[644],{\"_337\":10,\"_338\":643},{\"_335\":510,\"_336\":10},[],{\"_79\":645,\"_380\":646,\"_586\":647,\"_588\":648},\"Ruth Brown\",\"/author/ruth-brown\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/bltda2ac4ebd746601e/69de5041b4e76985b5b6d00b/ruth_april_2026.PNG\",\"Senior Principal Analyst, Omdia\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt351d3dfded06b9ff/68c929036d10010cf8e910a2/iStock-1168821123.jpg\",\"AI-powered RAN\",{\"_230\":634,\"_296\":537,\"_538\":652,\"_540\":653,\"_210\":653,\"_322\":654,\"_304\":628,\"_320\":655,\"_328\":656,\"_546\":33,\"_324\":547,\"_326\":548,\"_215\":657,\"_333\":550,\"_247\":658,\"_249\":10,\"_331\":659},{\"_554\":665,\"_556\":33},\"Antenna Beam Efficiency in Urban 4G/5G Networks\",\"/5g/antenna-beam-efficiency-in-urban-4g-5g-networks\",{},\"Nov 17, 2025\",[661],{\"_337\":10,\"_338\":660},{\"_335\":510,\"_336\":10},[],{\"_79\":662,\"_380\":663,\"_586\":664,\"_588\":648},\"Gabriel Brown\",\"/author/gabriel-brown\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt89ae3f9dc526d6f0/6513f83cf7552e31597cd0ae/Gabriel-Brown.jpg\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt5a6224b7f11c4bd4/650358a5abb8d8d4b4776aca/Man_standing_on_a_lifting_platform_to_work_on_mobile_tower_antenna_mast.jpg\",{\"_230\":634,\"_296\":537,\"_538\":667,\"_540\":668,\"_210\":669,\"_322\":670,\"_304\":628,\"_320\":671,\"_328\":672,\"_546\":33,\"_324\":547,\"_326\":548,\"_215\":673,\"_333\":550,\"_247\":674,\"_249\":10,\"_331\":675},{\"_554\":678,\"_556\":33},\"Antenna Monitoring for Programmable Performance\",\"Antenna Monitoring for Programmable Performance \",\"/5g/antenna-monitoring-for-programmable-performance\",{},\"Jan 12, 2026\",[677],{\"_337\":10,\"_338\":676},{\"_335\":510,\"_336\":10},[],{\"_79\":662,\"_380\":663,\"_586\":664,\"_588\":648},\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/bltfe0269c9c36f7dd0/69652da21f4cf63c5171387b/Cell_tower.jpg\",\"module_linked_image\",\"blteb141810dcbbe25e\",{\"_209\":682,\"_683\":684,\"_514\":685,\"_686\":687,\"_525\":526},\"Want more Light Reading stories in your Google search results?\",\"ctaButton\",{\"_692\":33,\"_693\":33},\"large\",\"logos\",[688],{\"_168\":689,\"_554\":690,\"_47\":691},\"https://google.com/preferences/source?q=https://www.lightreading.com/\",\"https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blt6ed039842556a881/69b4704bb1d3880b56fc5aed/google_preferred_source_badge_dark@2x.png\",\"Add as a Preferred Source on Google\",\"buttonTitle\",\"buttonUrl\",\"module_iiris_recommend\",\"blt25eb1c54d503a24f\",{\"_697\":698,\"_699\":694,\"_209\":700,\"_231\":695,\"_512\":701,\"_702\":703,\"_704\":705,\"_706\":218,\"_707\":10,\"_708\":334,\"_709\":710,\"_711\":712,\"_713\":150},\"__typename\",\"ModuleIirisRecommend\",\"contentTypeUid\",\"IIRIS Recommend in Sidebar\",\"Recommended for you\",\"iirisRecommendCode\",\"\u003cdiv id=\\\"widget-1726740308382\\\" widgetType=\\\"grid\\\" division=\\\"it\\\" brand_family=\\\"serviceprovider\\\" brand=\\\"lightreading\\\" class=\\\"iris-recommend iris-recommend-non-sticky\\\" cardwidth=\\\"210px\\\" entity=\\\"content\\\" recipe=\\\"similar-items\\\" by=\\\"category\\\" itemUrl=\\\"www.lightreading.com/satellite/telco-satellite-partnerships-point-the-way-to-a-hetnet-future\\\" category=\\\"it-life\\\" carouselid=\\\"iris-recommend\\\" redirectMode=\\\"same\\\" title=\\\"Recommended for you\\\" showentitytag=\\\"yes\\\" entitytagbackground=\\\"#6c6969\\\" entitytagfont=\\\"#ffffff\\\" showdate=\\\"yes\\\" dateformat=\\\"DD/MM/YYYY\\\" rows=\\\"4\\\" columns=\\\"1\\\" borderRadius=\\\"5\\\" titleweight=\\\"600\\\" authorstitleweight=\\\"600\\\" datetimebgcolor=\\\"#ffffff\\\" datetimefontcolor=\\\"#000\\\" imagePosition=\\\"vertical\\\" datetimefontsize=\\\"10\\\" entitytagbordercolor=\\\"#000\\\" showsponsored=\\\"yes\\\" sponsoredtagbackground=\\\"#e2e60a\\\" placement=\\\"bottom\\\" maxAge=\\\"6\\\" sponsoredposition=\\\"1\\\" sponsoredcount=\\\"1\\\"\u003e\u003c/div\u003e\",\"contentTypes\",[84,714,715,716,717,718,719],\"count\",\"inheritAwsConfiguration\",\"itemAge\",\"layout\",\"mixed\",\"recipe\",\"similar-items\",\"sponsoredCount\",\"document\",\"podcast\",\"slideshow\",\"video\",\"webinar\",\"all\",\"/latest-news\",\"People holding smartphones at music gig\",\"creditTo\",\"sponsors\",[],{\"_278\":361,\"_362\":898,\"_305\":899},{\"_278\":361,\"_362\":886,\"_305\":887},{\"_278\":361,\"_362\":882,\"_305\":883},{\"_278\":776,\"_777\":881},{\"_278\":361,\"_362\":877,\"_305\":878},{\"_278\":361,\"_362\":873,\"_305\":874},{\"_278\":766,\"_305\":869,\"_209\":768},{\"_278\":361,\"_362\":865,\"_305\":866},{\"_278\":776,\"_777\":864},{\"_278\":361,\"_362\":860,\"_305\":861},{\"_278\":310,\"_362\":856,\"_305\":857},{\"_278\":361,\"_362\":852,\"_305\":853},{\"_278\":776,\"_777\":851},{\"_278\":361,\"_362\":839,\"_305\":840},{\"_278\":361,\"_362\":827,\"_305\":828},{\"_278\":361,\"_362\":815,\"_305\":816},{\"_278\":766,\"_305\":811,\"_209\":768},{\"_278\":361,\"_362\":807,\"_305\":808},{\"_278\":310,\"_362\":803,\"_305\":804},{\"_278\":361,\"_362\":791,\"_305\":792},{\"_278\":361,\"_362\":779,\"_305\":780},{\"_278\":776,\"_777\":778},{\"_278\":361,\"_362\":772,\"_305\":773},{\"_278\":766,\"_305\":767,\"_209\":768},{\"_278\":361,\"_362\":755,\"_305\":756},{\"_278\":361,\"_362\":751,\"_305\":752},{\"_367\":301},[753],{\"_278\":340,\"_340\":754},\"Research Director Jeff Fieldhack said that HMD's exit presents an opportunity for other smartphone vendors to fill the gap in the low-end smartphone market, and Motorola and TCL are among the brands well-positioned to step in.\",{\"_367\":301},[757,758,759],{\"_278\":340,\"_340\":765},{\"_278\":340,\"_376\":760,\"_340\":761},{\"_278\":340,\"_340\":478},[762],\"scale back its US operations in July\",{\"_278\":380,\"_362\":763},{\"_382\":764,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.theverge.com/news/705046/hmd-global-nokia-scaling-back-us-market\",\"Other small smartphone players have been less fortunate. HMD recently exited the US market, and the company's sell-through dropped 41% YoY, according to Counterpoint. HMD, which licenses the Nokia brand for new phones and tablets, initially announced plans to \",\"relatedArticle\",[769],\"Related\",{\"_209\":770,\"_168\":771,\"_384\":385},\"iPhone 16e outperforms iPhone 16 for AT\u0026T, Verizon users – Ookla\",\"/smartphones-devices/iphone-16e-outperforms-iphone-16-for-at-t-verizon-users-ookla\",{\"_367\":301},[774],{\"_278\":340,\"_340\":775},\"Meanwhile, Nothing is performing well in other markets such as India and China – the company's manufacturing base is split between those countries, with slightly more manufacturing in India.\",\"ad\",\"pos\",\"native_2v\",{\"_367\":301},[781,782,783],{\"_278\":340,\"_340\":790},{\"_278\":340,\"_376\":785,\"_340\":786},{\"_278\":340,\"_340\":784},\" are starting to scale up in retail stores such as Best Buy, but making headway in the US hinges on selling smartphones through the carrier channel, said Bjørhovde. Nothing has also focused on selling directly to consumers via the company's website, in addition to sales through Amazon and Walmart.\",[787],\"Nothing\",{\"_278\":380,\"_362\":788},{\"_382\":789,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.lightreading.com/smartphones-devices/nothing-is-onto-something\",\"Smaller players like \",{\"_367\":301},[793,794,795],{\"_278\":340,\"_340\":802},{\"_278\":340,\"_376\":797,\"_340\":798},{\"_278\":340,\"_340\":796},\". Smaller players don't have the same financial backing to take part in the service provider channel or open their own brick-and-mortar stores to sell directly to consumers, he explained.\",[799],\"told Light Reading recently\",{\"_278\":380,\"_362\":800},{\"_382\":801,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.lightreading.com/smartphones-devices/economic-uncertainty-flattens-smartphone-market-reports\",\"Market domination by larger OEMs is partly a result of how many smartphones are sold in the US through the service provider channel, Runar Bjørhovde, senior analyst at Canalys, \",{\"_367\":301,\"_427\":428},[805],{\"_278\":340,\"_340\":806},\"Some smaller players can't take the heat\",{\"_367\":301},[809],{\"_278\":340,\"_340\":810},\"During the launch of the S25, Samsung ramped up promotion of its Galaxy Club program in addition to offering other promotions such as free streaming services with a direct purchase of the S25 from Samsung. The Galaxy Club is an add-on subscription program for customers to obtain future discounts and device credits.\",[812],{\"_209\":813,\"_168\":814,\"_384\":385},\"Samsung flips the script on device upgrades with Galaxy S25 Edge\",\"/smartphones-devices/Samsung-flips-the-script-on-device-upgrades-with-Galaxy-S25-Edge\",{\"_367\":301},[817,818,819],{\"_278\":340,\"_340\":826},{\"_278\":340,\"_376\":821,\"_340\":822},{\"_278\":340,\"_340\":820},\", also contributed slightly to the increase in sales.\",[823],\"launched in May\",{\"_278\":380,\"_362\":824},{\"_382\":825,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.lightreading.com/smartphones-devices/Samsung-flips-the-script-on-device-upgrades-with-Galaxy-S25-Edge\",\"Indeed, Samsung experienced a solid sell-through increase of 16% YoY, which Counterpoint said was a result of increased demand for its flagship models and device promotions from service providers. The S25 Edge, \",{\"_367\":301},[829,830,831],{\"_278\":340,\"_340\":838},{\"_278\":340,\"_376\":833,\"_340\":834},{\"_278\":340,\"_340\":832},\" of Samsung's Galaxy Z Fold7 and Flip 7 handsets, which are new, thinner foldable handsets from the device maker. The Big Three carriers, plus Boost Mobile, Xfinity Mobile and Comcast Business Mobile, all offered $1,100 off the Z Fold 7 with an eligible device trade-in and/or new line.\",[835],\"launch\",{\"_278\":380,\"_362\":836},{\"_382\":837,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.lightreading.com/smartphones-devices/carriers-flip-out-over-foldables-during-samsung-unpacked\",\"A recent example of strong carrier promotions was during the \",{\"_367\":301},[841,842,843],{\"_278\":340,\"_340\":850},{\"_278\":340,\"_376\":845,\"_340\":846},{\"_278\":340,\"_340\":844},\"\\\" has also been important in boosting handset upgrades and customer satisfaction. The guarantee includes a three-year price lock on all myPlan and MyHome network plans; a free phone with any trade-in from Apple, Google or Samsung; free satellite text messaging; and additional discount and streaming service options.\",[847],\"Best Value Guarantee\",{\"_278\":380,\"_362\":848},{\"_382\":849,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.verizon.com/about/news/accelerating-customer-first-strategy-3-year-price-lock-and-free-phone\",\"Verizon said its \\\"\",\"video_v\",{\"_367\":301},[854],{\"_278\":340,\"_340\":855},\"Sales of the iPhone 16e, plus successful device marketing and carrier promotions, supported Apple's sell-through increase of 10% YoY in Q2, according to Counterpoint Research. The firm noted that Verizon's Red Hot Deal Days and T-Mobile's switcher deal, offering a free iPhone 16 Pro without a trade-in, were among the standout promotions.\",{\"_367\":301,\"_427\":428},[858],{\"_278\":340,\"_340\":859},\"Apple and Samsung perform well in Q2\",{\"_367\":301},[862],{\"_278\":340,\"_340\":863},\"Overall, the US smartphone market increased 9% YoY in Q2. In addition, smartphone revenue reached $17.5 billion for the quarter, up 11% YoY.\",\"native_1v\",{\"_367\":301},[867],{\"_278\":340,\"_340\":868},\"However, demand for handsets in the mid-range price segment of $300-$599, such as the iPhone 16e and Google Pixel 9a, has increased 48%.\",[870],{\"_209\":871,\"_168\":872,\"_384\":385},\"Nothing is onto something\",\"/smartphones-devices/nothing-is-onto-something\",{\"_367\":301},[875],{\"_278\":340,\"_340\":876},\"Upgrade rates were also strong for the Big Three carriers, and sell-through in the premium device segment increased 11% YoY. The average selling price (ASP) of a US smartphone in Q2 increased by about $15 to $647.53, up from $632.59 last year.\",{\"_367\":301},[879],{\"_278\":340,\"_340\":880},\"Smartphone sell-through for AT\u0026T, T-Mobile and Verizon stores increased by 16%, 20% and 12%, respectively, year-over-year (YoY) in Q2, boosted by summer device promotions, according to Counterpoint Research.\",\"300_1v_article\",{\"_367\":301},[884],{\"_278\":340,\"_340\":885},\"\\\"The phone bundles are the biggest carrot that the carriers can offer, and they've been willing over the last five years or so to really lean into that to either retain customers or gain new ones,\\\" Leigh said.\",{\"_367\":301},[888,889,890],{\"_278\":340,\"_340\":897},{\"_278\":340,\"_376\":892,\"_340\":893},{\"_278\":340,\"_340\":891},\" earlier this year.\",[894],\"told Light Reading\",{\"_278\":380,\"_362\":895},{\"_382\":896,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.lightreading.com/smartphones-devices/smartphone-and-wireless-service-bundles-will-bend-not-break-under-trump-tariffs\",\"Wireless carriers are a \\\"very large channel\\\" for selling smartphones to end users, Jason Leigh, senior research manager for IDC, \",{\"_367\":301},[900,901,902],{\"_278\":340,\"_340\":908},{\"_278\":340,\"_376\":903,\"_340\":904},{\"_278\":340,\"_340\":478},[905],\"a new report by Counterpoint Research\",{\"_278\":380,\"_362\":906},{\"_382\":907,\"_384\":385,\"_386\":-5,\"_387\":-5},\"https://www.counterpointresearch.com/en/insights/us-smartphone-sell-through-up-9-yoy-in-q2-2025\",\"Wireless carriers' promotions have boosted Q2 sales in the US smartphone market, according to \",{\"_278\":922,\"_168\":923},{\"_278\":920,\"_168\":921},{\"_278\":918,\"_168\":919},{\"_278\":916,\"_168\":917},{\"_278\":914,\"_168\":915},\"Email\",\"mailto:?subject=AT\u0026T, T-Mobile and Verizon's smartphone promotions push Q2 sales performance – report\u0026body=I%20thought%20the%20following%20from%20Light%20Reading%20might%20interest%20you.%0D%0A%0D%0A%20AT%26T%2C%20T-Mobile%20and%20Verizon's%20smartphone%20promotions%20push%20Q2%20sales%20performance%20%E2%80%93%20report%0D%0Ahttps%3A%2F%2Fwww.lightreading.com%2Fsmartphones-devices%2Fat-t-t-mobile-and-verizon-s-smartphone-promotions-push-q2-sales-performance-report\",\"Bluesky\",\"https://bsky.app/intent/compose?text=AT%26T%2C%20T-Mobile%20and%20Verizon's%20smartphone%20promotions%20push%20Q2%20sales%20performance%20%E2%80%93%20report%20-%20https%3A%2F%2Fwww.lightreading.com%2Fsmartphones-devices%2Fat-t-t-mobile-and-verizon-s-smartphone-promotions-push-q2-sales-performance-report\",\"Twitter\",\"http://www.twitter.com/intent/tweet?url=https://www.lightreading.com/smartphones-devices/at-t-t-mobile-and-verizon-s-smartphone-promotions-push-q2-sales-performance-report\",\"Linkedin\",\"https://www.linkedin.com/sharing/share-offsite/?url=https://www.lightreading.com/smartphones-devices/at-t-t-mobile-and-verizon-s-smartphone-promotions-push-q2-sales-performance-report\",\"Facebook\",\"http://www.facebook.com/sharer/sharer.php?u=https://www.lightreading.com/smartphones-devices/at-t-t-mobile-and-verizon-s-smartphone-promotions-push-q2-sales-performance-report\",{\"_278\":938,\"_231\":939,\"_294\":940},{\"_278\":926,\"_231\":927,\"_294\":928},\"module_newsletter_promo\",\"blt943b313d5ea7f1e1\",{\"_209\":929,\"_930\":931,\"_932\":927,\"_933\":934,\"_693\":40,\"_296\":935,\"_298\":936,\"_937\":510,\"_525\":84},\"Subscribe and receive the latest news from the industry.\",\"message\",\"Join 62,000+ members. Yes it's completely free.\",\"newsletterId\",\"buttonText\",\"Sign me up\",\"horizontal\",\"dark\",\"isOnHomepage\",\"module_events_promotions\",\"bltae45f2b3b8f005df\",{\"_209\":941,\"_942\":33,\"_943\":301,\"_944\":945,\"_946\":936,\"_947\":299,\"_948\":690,\"_949\":950,\"_173\":682,\"_683\":951,\"_525\":84},\"Google Preferred Source\",\"displayTitle\",\"logoPosition\",\"backgroundColor\",\"#ffffff\",\"textColorMode\",\"backgroundMode\",\"logoSrc\",\"logoAlt\",\"Add as a preferred source on Google\",{\"_952\":689,\"_953\":954},\"ctaButtonLink\",\"ctaButtonText\",\"Add Us Now\",{\"_209\":76,\"_79\":76,\"_74\":48,\"_588\":78,\"_586\":196,\"_380\":956,\"_957\":958,\"_208\":959},\"/author/kelsey-ziser\",\"tagLine\",\"Senior Editor, Light Reading\",[960,961,962,963],{\"_278\":361,\"_362\":976,\"_305\":977},{\"_278\":361,\"_362\":972,\"_305\":973},{\"_278\":361,\"_362\":968,\"_305\":969},{\"_278\":361,\"_362\":964,\"_305\":965},{\"_367\":301},[966],{\"_278\":340,\"_340\":967},\"Kelsey is based in Raleigh, N.C.\",{\"_367\":301},[970],{\"_278\":340,\"_340\":971},\"Kelsey enjoys reading four (or 12) books at once, watching movies about space travel, crafting and (hoarding) houseplants.\",{\"_367\":301},[974],{\"_278\":340,\"_340\":975},\"Her interest in the telecom world started with a PR position at Connect2 Communications, which led to a communications role at the FREEDM Systems Center, a smart grid research lab at N.C. State University. There, she orchestrated their webinar program across college campuses and covered research projects such as the center's smart solid-state transformer.\",{\"_367\":301},[978],{\"_278\":340,\"_340\":979},\"Kelsey is a senior editor at Light Reading, co-host of the Light Reading podcast, and host of the \\\"What's the story?\\\" podcast.\",{\"_697\":279,\"_209\":100,\"_168\":284,\"_281\":983},{\"_697\":279,\"_209\":97,\"_168\":280,\"_281\":982},{\"_209\":33},{\"_209\":99},{\"_168\":986,\"_209\":151},{\"_168\":284,\"_209\":100},\"/\",\"aid\",\"876098\",\"reg\",\"anonymous\",\"pterm\",{\"_997\":100,\"_95\":99,\"_998\":999,\"_1000\":276},\"gatedWithExternalForm\",\"gatedWithSiteReg\",\"sponsorName\",[],\"main\",\"grandparent\",{\"_209\":33},\"additional\",\"lightreading\",\"domainUrl\",\"authenticationStatus\",\"authConfig\",{\"_1078\":10,\"_1918\":-7,\"_1919\":-7,\"_1378\":10},\"oAuthConfig\",[],\"isDctsTurnOn\",\"cookieBanner\",{\"_1304\":510,\"_1305\":510,\"_1306\":1307,\"_1916\":1917,\"_1302\":510},\"ui\",{\"_49\":1001,\"_1132\":1133,\"_1134\":1135},\"environment\",\"prod\",\"feature