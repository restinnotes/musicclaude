    }
   ]
  },
  {
   "bars": "78–83",
   "relation": "正在面对",
   "items": [
    {
     "id": "I100",
     "text": "他终于不再逼自己立刻作选择。",
     "key": "立刻作选择",
     "kind": ""
    },
    {
     "id": "I101",
     "text": "他发现眼下还无法减轻这份喜欢。",
     "key": "无法减轻",
     "kind": ""
    },
    {
     "id": "I102",
     "text": "他决定暂时什么也不决定。",
     "key": "什么也不决定",
     "kind": ""
    },
    {
     "id": "I103",
     "text": "想靠近时，他不必马上向前。",
     "key": "马上向前",
     "kind": ""
    },
    {
     "id": "I104",
     "text": "想守分寸时，他也不必压住眷恋。",
     "key": "压住眷恋",
     "kind": ""
    },
    {
     "id": "I105",
     "text": "他容许自己带着愿望安静地喜欢。",
     "key": "带着愿望",
     "kind": ""
    },
    {
     "id": "I106",
     "text": "他也承认自己仍没有把握。",
     "key": "没有把握",
     "kind": ""
    },
    {
     "id": "I107",
     "text": "他因此稍稍松了口气。",
     "key": "稍稍松了口气",
     "kind": ""
    },
    {
     "id": "I108",
     "text": "他不再时时与未解的为难争执。",
     "key": "未解的为难",
     "kind": ""
    },
    {
     "id": "I109",
     "text": "他的温柔又能自然地留在心里。",
     "key": "自然地留在心里",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I97",
     "to": "I100",
     "rel": "提供理由"
    },
    {
     "from": "I9",
     "to": "I101",
     "rel": "仍在起作用"
    },
    {
     "from": "I25",
     "to": "I102",
     "rel": "提供理由"
    },
    {
     "from": "I96",
     "to": "I103",
     "rel": "改写"
    },
    {
     "from": "I95",
     "to": "I104",
     "rel": "改写"
    }
   ]
  },
  {
   "bars": "84–92",
   "relation": "正在面对",
   "items": [
    {
     "id": "I110",
     "text": "他重新感到亲近对方的快乐。",
     "key": "重新感到",
     "kind": ""
    },
    {
     "id": "I111",
     "text": "这次他已知道自己会盼望很多。",
     "key": "盼望很多",
     "kind": ""
    },
    {
     "id": "I112",
     "text": "经历期待和难堪后，他仍愿意喜欢。",
     "key": "仍愿意喜欢",
     "kind": ""
    },
    {
     "id": "I113",
     "text": "他不再用毫无所求证明自己的体贴。",
     "key": "证明自己的体贴",
     "kind": ""
    },
    {
     "id": "I114",
     "text": "他偶尔想被珍惜，也不再怀疑整份感情。",
     "key": "不再怀疑",
     "kind": "分清"
    },
    {
     "id": "I115",
     "text": "他愿意全心投入那份温暖。",
     "key": "全心投入",
     "kind": ""
    },
    {
     "id": "I116",
     "text": "他不再躲避自己感情的深度。",
     "key": "感情的深度",
     "kind": ""
    },
    {
     "id": "I117",
     "text": "他不再因自己的热切感到羞怯。",
     "key": "感到羞怯",
     "kind": ""
    },
    {
     "id": "I118",
     "text": "他甚至为犹疑之后仍能高兴而感动。",
     "key": "高兴而感动",
     "kind": ""
    },
    {
     "id": "I119",
     "text": "他仿佛允许那些彼此挤压的愿望同时存在。",
     "key": "同时存在",
     "kind": ""
    },
    {
     "id": "I120",
     "text": "他知道自己可能受伤，仍愿尽情承认幸福。",
     "key": "可能受伤",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I107",
     "to": "I110",
     "rel": "唤起"
    },
    {
     "from": "I50",
     "to": "I113",
     "rel": "改写"
    },
    {
     "from": "I51",
     "to": "I114",
     "rel": "提供理由"
    },
    {
     "from": "I81",
     "to": "I115",
     "rel": "提供理由"
    },
    {
     "from": "I31",
     "to": "I119",
     "rel": "改写"
    },
    {
     "from": "I106",
     "to": "I120",
     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "93–102",
   "relation": "没在想",
   "items": [
    {
     "id": "I121",
     "text": "他更清楚自己多想与对方亲近。",
     "key": "多想与对方亲近",
     "kind": ""
    },
    {
     "id": "I122",
     "text": "他想把积攒的温柔全都给出去。",
     "key": "积攒的温柔",
     "kind": ""
    },
    {
     "id": "I123",
     "text": "他想让这份亲密不只停在自己的愿望里。",
     "key": "不只停在",
     "kind": ""
    },
    {
     "id": "I124",
     "text": "他想被同样深切地珍惜。",
     "key": "同样深切",
     "kind": ""
    },
    {
     "id": "I125",
     "text": "他想知道彼此的幸福能有多丰盛。",
     "key": "多丰盛",
     "kind": ""
    },
    {
     "id": "I126",
     "text": "那些愿望暂时不再使他感到缺憾。",
     "key": "感到缺憾",
     "kind": ""
    },
    {
     "id": "I127",
     "text": "他觉得自己有许多心意可以给予。",
     "key": "可以给予",
     "kind": ""
    },
    {
     "id": "I128",
     "text": "他甚至觉得已没有什么需要再增加。",
     "key": "再增加",
     "kind": ""
    },
    {
     "id": "I129",
     "text": "他感到一阵几乎难以承受的满足。",
     "key": "难以承受的满足",
     "kind": ""
    },
    {
     "id": "I130",
     "text": "他想把整个自己交给这份亲近。",
     "key": "整个自己",
     "kind": ""
    },
    {
     "id": "I131",
     "text": "他的心愿仿佛都在此刻得到抒发。",
     "key": "仿佛都在此刻",
     "kind": ""
    },
    {
     "id": "I132",
     "text": "虽没有新的保证，他仍真切觉得这样爱着已让生命无比充实。",
     "key": "生命无比充实",
     "kind": ""
    },
    {
     "id": "I133",
     "text": "他一时顾不上以后会怎样。",
     "key": "顾不上以后",
     "kind": ""
    },
    {
     "id": "I134",
     "text": "他只愿让这份幸福完整地属于此刻。",
     "key": "完整地属于此刻",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I115",
     "to": "I121",
     "rel": "唤起"
    },
    {
     "from": "I93",
     "to": "I124",
     "rel": "仍在起作用"
    },
    {
     "from": "I119",
     "to": "I126",
     "rel": "改写"
    },
    {
     "from": "I78",
     "to": "I132",
     "rel": "提供理由"
