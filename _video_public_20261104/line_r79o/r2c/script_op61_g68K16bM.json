   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前自然亲近的日子，他心里又热起来，也盼着以后还能那样相处。",
       "keys": [
        "心里又热起来",
        "盼着以后还能那样相处"
       ],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": [
