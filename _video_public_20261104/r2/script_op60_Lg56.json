      {
       "text": "有一点突然",
       "keys": [],
       "from": [
        "S01-B1-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他怕自己的在乎会成为对方的负担",
