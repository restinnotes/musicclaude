 rgba(255, 255, 255, 0.1) 1px, transparent 1px);background-size:50px 50px"></div><div class="absolute top-1/4 -left-32 w-96 h-96 bg-white/10 rounded-full blur-[128px]"></div><div class="absolute bottom-1/4 -right-32 w-80 h-80 bg-white/10 rounded-full blur-[100px]"></div></div><div class="relative z-10 w-full py-10 lg:py-14 px-0 sm:px-6 lg:px-12 xl:px-20 font-dmsans"><div class="container"><div class="flex items-center gap-3 flex-wrap mb-8"><div class="inline-flex items-center rounded-[5px] border text-xs font-bold bg-white/10 text-white/90 border-white/20 px-4 py-1.5 backdrop-blur-md hover:bg-white/20 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe h-3.5 w-3.5 mr-2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>United States</div><div class="inline-flex items-center rounded-[5px] border text-xs font-bold bg-white/10 text-white/90 border-white/20 px-4 py-1.5 backdrop-blur-md hover:bg-white/20 transition-colors">May 2026</div></div><div class="grid lg:grid-cols-5 gap-12 lg:gap-16 items-center"><div class="lg:col-span-3 space-y-8"><div class="space-y-6"><h1 class="font-noto text-[31px] lg:text-[39px] text-white leading-[1.1] tracking-tight">United States Power Tools Market Outlook to 2030: Size, Share, Growth and Trends</h1><p class="text-white/60 font-light tracking-wide text-lg">2030</p></div><p class="text-white/70 max-w-xl leading-relaxed font-light text-[16px]">The United States Power Tools Market worth USD 11,400 million in 2025 is growing at a CAGR of 3.50% to reach USD 13,995 million by 2031. Stanley Black &amp; Decker, Robert Bosch, Makita, Hilti and Techtronic Industries are the major companies operating in this market.</p><div class="flex flex-col sm:flex-row gap-4 pt-4"><a 