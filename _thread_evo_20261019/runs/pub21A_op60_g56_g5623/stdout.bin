\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正当你以为它还会继续唱下去，它却戛然而止，转入片刻静意。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"忽然戛然而止\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"上回无意露出心意\",\n          \"point\": \"主动、大方地回应\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"上回无意露出心意；这回见对方仍然亲近\"\n        },\n        {\n          \"text\": \"这样想着，他连\",\n          \"point\": \"还能好很久\",\n          \"where\": \"后\",\n          \"waste\": \"这样想着\",\n          \"keep\": \"连往后的日子都开始盼；或许\"\n        },\n        {\n          \"text\": \"可今天这么好\",\n          \"point\": \"心里又有点没底\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"不代表以后每天都会如此\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"整段像两个人对视到呼吸都停了\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"四周并未彻底暗下去，更像阳光被薄雾柔化——光还在，只是隔了一层朦胧的雾气。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"眼前的美好其实比自己的愿望大得多。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"那点没底越来越具体\",\n          \"point\": \"不再需要他的陪伴\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"那点没底越来越具体\"\n        },\n        {\n          \"text\": \"他甚至怕对方\",\n          \"point\": \"连和自己待在一起也不愿意\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"甚至；一下安静下来\"\n        },\n        {\n          \"text\": \"他不敢再往远处想\",\n 