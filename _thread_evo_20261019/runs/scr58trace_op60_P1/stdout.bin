: \"S04\",\n              \"source_item_ids\": [\"S04-1\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            },\n            {\n              \"sec\": \"S04\",\n              \"source_item_ids\": [\"S04-2\"],\n              \"use_type\": \"延续\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A20\",\n          \"kind\": \"本人愿望\",\n          \"content\": \"他希望对方能够接受自己这样坦白地表达喜欢。\",\n          \"certainty\": \"明确愿望，对方是否接受未知。\",\n          \"first_established\": \"S04\",\n          \"depends_on\": [\"A19\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S04\",\n              \"source_item_ids\": [\"S04-2\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A21\",\n          \"kind\": \"本人愿望\",\n          \"content\": \"他想通过多说一些话，让两个人的好时光留得更久。\",\n          \"certainty\": \"明确愿望。\",\n          \"first_established\": \"S04\",\n          \"depends_on\": [\"A19\", \"A11\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S04\",\n              \"source_item_ids\": [\"S04-3\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A22\",\n          \"kind\": \"选择\",\n          \"content\": \"即使很想把话说出来，他最终仍没有把所有藏着的话说出口。\",\n          \"certainty\": \"明确的选择结果。\",\n          \"first_established\": \"S04\",\n          \"depends_on\": [\"A21\", \"A09\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S04\",\n              \"source_item_ids\": [\"S04-3\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A23\",\n          \"kind\": \"选择\",\n          \"content\": \"这一次他不再时时想着把喜欢藏好，心意在相处中自然流露。\",\n          \"certainty\": \"明确陈述的当次相处状态和选择倾向，不自动推定为永久改变。\",\n          \"first_established\": \"S05\",\n          \"depends_on\": [\"A04\", \"A22\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S05\",\n              \"source_item_ids\": [\"S05-1\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A24\",\n          \"kind\": \"处境事实\",\n          \"content\": \"对方已经看出他有多在乎，知道他显露了自己的喜欢。\",\n          \"certainty\": \"明确处境事实。\",\n          \"first_established\": \"S05\",\n          \"depends_on\": [\"A23\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S05\",\n              \"source_item_ids\": [\"S05-1\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            },\n            {\n              \"sec\": \"S06\",\n              \"source_item_ids\": [\"S06-1\"],\n              \"use_type\": \"延续\",\n              \"actual_change\": \"\"\n            },\n            {\n              \"sec\": \"S13\",\n              \"source_item_ids\": [\"S13-2\"],\n              \"use_type\": \"重复表达\",\n              \"actual_change\": \"\"\n            },\n            {\n              \"sec\": \"S13\",\n              \"source_item_ids\": [\"S13-3\"],\n              \"use_type\": \"重复表达\",\n              \"actual_change\": \"\"\n            },\n            {\n              \"sec\": \"S14\",\n              \"source_item_ids\": [\"S14-3\"],\n              \"use_type\": \"重复表达\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A25\",\n          \"kind\": \"后果\",\n          \"content\": \"被对方看见有多在乎之后，他反而不知道该怎么办，心里空落落的。\",\n          \"certainty\": \"明确的心理后果。\",\n          \"first_established\": \"S05\",\n          \"depends_on\": [\"A24\", \"A04\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S05\",\n              \"source_item_ids\": [\"S05-2\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A26\",\n          \"kind\": \"本人顾虑\",\n          \"content\": \"他担心对方会嫌自己太黏。\",\n          \"certainty\": \"明确顾虑，不代表对方实际嫌弃。\",\n          \"first_established\": \"S05\",\n          \"depends_on\": [\"A24\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S05\",\n              \"source_item_ids\": [\"S05-3\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A27\",\n          \"kind\": \"本人感受\",\n          \"content\": \"原本熟悉的亲近在他心里忽然像隔了一层。\",\n          \"certainty\": \"明确的主观感受，不是对方实际疏远的事实。\",\n          \"first_established\": \"S05\",\n          \"depends_on\": [\"A24\", \"A26\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S05\",\n              \"source_item_ids\": [\"S05-3\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A28\",\n          \"kind\": \"推测\",\n          \"content\": \"他想到对方根本不知道自己刚才有多害怕被嫌弃。\",\n          \"certainty\": \"明确陈述为他的当下判断，但对方实际知道多少没有独立核验。\",\n          \"first_established\": \"S06\",\n          \"depends_on\": [\"A26\", \"A27\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S06\",\n              \"source_item_ids\": [\"S06-2\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A29\",\n          \"kind\": \"本人感受\",\n          \"content\": \"想到对方不知道自己的恐惧，他感到有些孤单。\",\n          \"certainty\": \"明确感受。\",\n          \"first_established\": \"S06\",\n          \"depends_on\": [\"A28\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S06\",\n              \"source_item_ids\": [\"S06-2\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A30\",\n          \"kind\": \"推测\",\n          \"content\": \"他猜测对方是否也有一点舍不得结束这份亲近。\",\n          \"certainty\": \"明确的疑问和可能性，不是对方已经表达的事实。\",\n          \"first_established\": \"S06\",\n          \"depends_on\": [\"A07\", \"A08\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S06\",\n              \"source_item_ids\": [\"S06-3\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A31\",\n          \"kind\": \"推测\",\n          \"content\": \"他逐渐觉得这份亲近可能并非只有自己需要，对方有时也可能想让他陪在身边。\",\n          \"certainty\": \"明确的本人推测，依据是对方这些日子一直愿意相处。\",\n          \"first_established\": \"S07\",\n          \"depends_on\": [\"A07\", \"A30\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S07\",\n              \"source_item_ids\": [\"S07-1\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A32\",\n          \"kind\": \"本人感受\",\n          \"content\": \"想到对方可能也需要这份亲近时，他高兴得有些收不住，沉浸在两个人亲近的欢喜之中。\",\n          \"certainty\": \"明确的本人感受。\",\n          \"first_established\": \"S07\",\n          \"depends_on\": [\"A31\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S07\",\n              \"source_item_ids\": [\"S07-2\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A33\",\n          \"kind\": \"本人愿望\",\n          \"content\": \"他希望以后每当对方想有人陪伴时，自己都能够在身边。\",\n          \"certainty\": \"明确愿望，尚未成为已实现的长期事实。\",\n          \"first_established\": \"S07\",\n          \"depends_on\": [\"A31\", \"A32\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S07\",\n              \"source_item_ids\": [\"S07-3\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            },\n            {\n              \"sec\": \"S08\",\n              \"source_item_ids\": [\"S08-1\"],\n              \"use_type\": \"延续\",\n              \"actual_change\": \"\"\n            },\n            {\n              \"sec\": \"S11\",\n              \"source_item_ids\": [\"S11-1\"],\n              \"use_type\": \"延续\",\n              \"actual_change\": \"\"\n            },\n            {\n              \"sec\": \"S12\",\n              \"source_item_ids\": [\"S12-2\"],\n              \"use_type\": \"代价改变\",\n              \"actual_change\": \"即使已经知道无法留住每一个以后，他仍然继续希望多陪对方一些。\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A34\",\n          \"kind\": \"选择\",\n          \"content\": \"他希望这次主动一些，大大方方地回应对方的亲近。\",\n          \"certainty\": \"明确的行动意向，尚未明确记载实际完成。\",\n          \"first_established\": \"S08\",\n          \"depends_on\": [\"A23\", \"A33\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S08\",\n              \"source_item_ids\": [\"S08-1\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A35\",\n          \"kind\": \"本人愿望\",\n          \"content\": \"他开始盼望两个人以后的日子也能一直这样好。\",\n          \"certainty\": \"明确愿望。\",\n          \"first_established\": \"S08\",\n          \"depends_on\": [\"A33\", \"A34\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S08\",\n              \"source_item_ids\": [\"S08-2\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A36\",\n          \"kind\": \"推测\",\n          \"content\": \"他觉得两个人说不定还能保持这样的亲近很久。\",\n          \"certainty\": \"明确为可能性推测，不是已经确定的未来。\",\n          \"first_established\": \"S08\",\n          \"depends_on\": [\"A33\", \"A35\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S08\",\n              \"source_item_ids\": [\"S08-2\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A37\",\n          \"kind\": \"未知\",\n          \"content\": \"他认识到往后的事情无法预先说准。\",\n          \"certainty\": \"明确认识，未来具体结果未知。\",\n          \"first_established\": \"S08\",\n          \"depends_on\": [\"A11\", \"A36\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S08\",\n              \"source_item_ids\": [\"S08-3\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            },\n            {\n              \"sec\": \"S11\",\n              \"source_item_ids\": [\"S11-3\"],\n              \"use_type\": \"延续\",\n              \"actual_change\": \"\"\n            },\n            {\n              \"sec\": \"S14\",\n              \"source_item_ids\": [\"S14-2\"],\n              \"use_type\": \"延续\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A38\",\n          \"kind\": \"本人感受\",\n          \"content\": \"刚刚觉得轻快之后，他心里又生出一点没底。\",\n          \"certainty\": \"明确感受。\",\n          \"first_established\": \"S08\",\n          \"depends_on\": [\"A36\", \"A37\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S08\",\n              \"source_item_ids\": [\"S08-3\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A39\",\n          \"kind\": \"本人顾虑\",\n          \"content\": \"他害怕有一天对方不再需要他的陪伴，甚至不愿意继续和他待在一起。\",\n          \"certainty\": \"明确的假设性顾虑，没有实际发生的证据。\",\n          \"first_established\": \"S09\",\n          \"depends_on\": [\"A33\", \"A37\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S09\",\n              \"source_item_ids\": [\"S09-1\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A40\",\n          \"kind\": \"后果\",\n          \"content\": \"对失去亲近的担忧具体化后，他一下安静下来，不敢继续往下想。\",\n          \"certainty\": \"明确的心理后果。\",\n          \"first_established\": \"S09\",\n          \"depends_on\": [\"A39\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S09\",\n              \"source_item_ids\": [\"S09-2\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A41\",\n          \"kind\": \"选择\",\n          \"content\": \"他选择暂时不猜测那一天会不会到来，先享受眼前仍然能够亲近的欢喜。\",\n          \"certainty\": \"明确选择，范围是暂时停止猜测。\",\n          \"first_established\": \"S10\",\n          \"depends_on\": [\"A39\", \"A07\", \"A13\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S10\",\n              \"source_item_ids\": [\"S10-1\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A42\",\n          \"kind\": \"本人感受\",\n          \"content\": \"此前的紧绷慢慢松开，心里变得明亮，几乎既想笑又想哭。\",\n          \"certainty\": \"明确感受。\",\n          \"first_established\": \"S10\",\n          \"depends_on\": [\"A40\", \"A41\"],\n          \"occurrences\": [\n            {\n              \"sec\": \"S10\",\n              \"source_item_ids\": [\"S10-2\"],\n              \"use_type\": \"首次成立\",\n              \"actual_change\": \"\"\n            }\n          ]\n        },\n        {\n          \"anchor_id\": \"A43\",\n          \"kind\": \"选择\",\n          \"content\": \"他确认自己真的愿意长久陪伴对方，而不是只想多享受几次这样的亲近。\",\n          \"certainty\": \"明确的本人认识和长期