 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近这个人，心里一下热起来，连自己也有点意外。",
       "keys": [
        "那么想靠近",
        "心里一下热起来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方看出自己有多需要这份亲近，会觉得负担太重；所以只敢露出一点点喜欢。",
       "keys": [
        "负担太重",
        "只敢露出一点点喜欢"
       ],
       "from": [
        "S01-2",
        "S01-B2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "只是这么一点亲近就让他觉得甜，他还拿不准，下次自己能不能更坦白些。",
       "keys": [
        "觉得甜",
        "能不能更坦白些"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因为他露出在意就退开，他才渐渐放松下来。",
       "keys": [
        "没有因为他露出在意就退开",
        "渐渐放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "左手像心跳，身体仿佛可以交给船底托举，水却一直在流",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "右手两条旋律线贴得很近，像肩膀挨着肩膀，连呼吸和体温都融在一处",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "像熟人安静坐着 偶尔对视也不尴尬",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "几次柔软的落音像一根温柔的刺：眼前的好还在，心里却先有一点鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠得更近，有一阵子喜欢得几乎藏不住，最后还是怕太急弄坏眼下的自在而收住了。",
       "keys": [
        "喜欢得几乎藏不住",
        "收住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声忽然往上涌了一次；接着又轻轻呼出一口气，回到柔和，没有把心事彻底说死",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待在一起这么好，他偏偏想到这样的时刻总会过去，还没分开就先有一点舍不得。",
       "keys": [
        "这样的时刻总会过去",
        "先有一点舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不去琢磨两个人往后会怎样，只想舒舒服服地待在这份亲近里；歌声渐渐退到后面，沉默也很舒服，心却慢慢漂远。",
       "keys": [
        "舒舒服服地待在这份亲近里",
        "沉默也很舒服"
       ],
       "from": [
        "S03-1",
        "S03-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "持续摇曳中忽然冒出几句短促、急切的声音，很快又沉了回去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水波还在晃，流动却像被水下暗流拖住，思绪像被风吹碎的倒影，闪烁却难拼完整",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "像一句重要的话说完了 人还在余味里发愣",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想说有多喜欢这样，也想问对方是否一样；没想好怎么开口，念头就淡了。",
       "keys": [
        "有多喜欢这样",
        "对方是否一样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他满心欢喜，他想起上回明明想告诉对方，却没有开口。",
       "keys": [
        "满心欢喜",
        "没有开口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的歌声又回来，两道声线仍贴耳低语，这一遍却更华丽、更迫切",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "一句话说完还忍不住折回来补细节",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想把藏着的话全说出来，手仿佛不自觉地握得更紧，水面的颠簸反而越剧烈。",
       "keys": [
        "把藏着的话全说出来",
        "握得更紧"
       ],
       "from": [
        "S04-2",
        "S04-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "高处的长颤音像夕阳切出的最后一道金光，亮得几乎刺眼；音乐一边攀高一边收弱，到后来才慢下来",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "话到喉咙口忽然发紧",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "两道声线仍贴得那么近，左手水波却一直向前，仿佛每一秒都在倒数；还没有失去什么，就已经舍不得",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他甚至盼着说出来能把眼下的好留得久一点；可又怕一下说得太多让对方为难，连两个人原有的自在也弄丢，最后还是留了些话没说。",
       "keys": [
        "把眼下的好留得久一点",
        "最后还是留了些话没说"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "前几次想说又收住，对方却一直愿意跟他亲近；这回他不知不觉忘了藏好喜欢，等察觉时，对方已经看出他有多在乎。",
       "keys": [
        "忘了藏好喜欢",
        "看出他有多在乎"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "原来一直托着人的水波和摇晃忽然像被抽掉，只剩一条单薄旋律",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "刚才还像两个人贴近耳语，交谈却戛然而止；心里闪过一句：这份幸福真实吗？",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "先前藏着时还能装作没那么在乎，他心里空落落的，连怎么跟对方待着都拿不准；他忍不住怕对方会嫌自己太黏，熟悉的亲近也像隔了一层。",
       "keys": [
        "心里空落落的",
        "会嫌自己太黏"
       ],
       "from": [
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "此前那阵想攥紧不放的冲动，到了这里却像音乐自己松开了手",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "像终于能深吸一口气",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这回对方看出他有多在乎，跟他相处却一点没变，他才又能像从前那样自在地待着。",
       "keys": [
        "跟他相处却一点没变",
        "自在地待着"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的摇摆回来，左手波浪却变薄、碎成细纹；光线像从暖金水面滑入古桥阴影，新旋律清澈得像月光",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "忽然想起年少时第一次心动的下午",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "安静时，他还想靠近，却怕要得太多；对方不知道他刚才多怕被嫌弃，他有点孤单。",
       "keys": [
        "还想靠近",
        "他有点孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "旋律压低声音，另一条声线不时回应、插话，又纠缠回来，像一个念头刚安静下去又浮上来",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "心里刚说算了 又忍不住放不下",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "白天和某个人相处得很好，独处时心头却泛酸",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他又忍不住想，对方既然一直没有退开，会不会也有一点舍不得结束这份亲近？",
       "keys": [
        "一直没有退开",
        "舍不得结束这份亲近"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起这些日子对方总愿意跟他待在一起，他渐渐觉得，也许对方有时也需要他，跟他在一起也能安心些。",
       "keys": [
        "也许对方有时也需要他",
        "安心些"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声再回来，清澈底下却越来越不安分：伴奏变密，低音像沉重的脉搏催促，身体仿佛被更深的渴望推着往前",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "独自回想一段关系，气味、身体感觉、幻想、遗憾和快感混在一起；明知正被卷进去，却暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他高兴得有点收不住，想到两个人也许能互相依靠，心里忽然一紧，却还想这样待着；自己也能一直陪在身边。",
       "keys": [
        "互相依靠",
        "一直陪在身边"
       ],
       "from": [
        "S07-2",
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "美也没有消失；可你已经听见时间正在经过，这一刻纵然完美，也没有办法让它停住",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "上回他无意间露了心意，这回见对方依然亲近，他想主动些，大大方方地回应。",
       "keys": [
        "依然亲近",
        "大大方方地回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的摇荡也轻轻催着人往前",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "身体恢复弹性，带一点玩心和调情般的回应",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "这样想着，他连往后的日子都开始盼了，觉得两个人说不定还能这么好很久。",
       "keys": [
        "往后的日子都开始盼了",
        "这么好很久"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声没有落定，反而向上散开；后来忽然戛然而止，快乐余温尚在，心头却泛起怀念",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可眼下两个人都愿意亲近，以后未必还会这样，他心里没底。",
       "keys": [
        "以后未必还会这样",
        "心里没底"
       ],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "那点没底越来越具体：要是哪天对方不再需要他陪，连和他待着都不自在了呢？",
       "keys": [
        "不再需要他陪",
        "都不自在了呢"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "前面那股几乎要冲出去的势头突然收住；飘渺的颤音和轻柔和弦悬在半空，像对视到呼吸都停了",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "那股想靠近的劲还绷着 没有真正松开",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "明朗像被薄雾柔化，声音一层层下沉、变暗，光还在，只是隔了一层",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他一下安静了，刚才还敢盼那么远，现在却不敢再往下想。",
       "keys": [
        "一下安静了",
        "不敢再往下想"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不安还没回答，却暂时不占满心思",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
