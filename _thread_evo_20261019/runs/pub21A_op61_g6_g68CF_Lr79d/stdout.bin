{\n          \"text\": \"那些委屈让他拿不准\",\n          \"point\": \"当初没走会怎样\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"也想不出\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"柔和的歌唱并没有抹掉向前的劲\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是想通，是抵抗累了\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍不服气\",\n          \"point\": \"当初受的那些气不该忍\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"仍不服气\"\n        },\n        {\n          \"text\": \"他不想忘掉那些开心的日子\",\n          \"point\": \"想起离开他们时仍难受\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"不想忘掉那些开心的日子\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不必立刻把它抓回来\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开后难事只能自己扛\",\n          \"point\": \"日子有多轻松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只能自己扛\"\n        },\n        {\n          \"text\": \"他想再遇见有默契的人\",\n          \"point\": \"心里暖了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又怕今后遇不到；可想到曾有过默契\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"后颈一凉，脉搏也剧烈跳动\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这种突兀的换向并不等于情绪好转\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"突转不等于好转\"\n        },\n        {\n          \"quote\": \"恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他没料到离开后这么孤单\",\n          \"point\": \"撑得住吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"难事还得自己扛\"\n        },\n        {\n          \"text\": \"他想找回从前那份亲近\",\n          \"point\": \"早知道这样还会走吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可想到还得受气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像一个人已经准备离开，却在最后一刻回过头，再看一眼刚才待过的地方\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只是瞬间的喘息，并不等于整个人重新安顿下来\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他先把回去的事放一边\",\n          \"point\": \"先把回去的事放一边\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"只回想\"\n        },\n        {\n          \"text\": \"回忆不能陪他过难关\",\n          \"point\": \"回忆不能陪他过难关\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"心又很快悬了起来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"开头沉重的引子从中阴冷地闪现回来，却不再像最初那样郑重召唤\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"刚有的一点稳定感随即散掉\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"稳定感随即又散\"\n        },\n        {\n          \"quote\": \"最初的问题又浮上来，却没有因此得到一个简单的答案\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"旧问题又浮起，仍无答案\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他分不清\",\n          \"point\": \"舍不得那份亲近，还是怕孤单\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"还是怕孤单\"\n        },\n        {\n          \"text\": \"这念头让他一阵心慌\",\n          \"point\": \"连往下想都不敢了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这念头让他一阵心慌\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"fine\": [\n        {\n          \"quote\": \"摇篮曲破碎地重现，只是这次变成了F小调\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"明明知道它很重要，却已经没有力气把它重新讲述一遍\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"历经许多之后，仍未能获得彻底答案的疲惫\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"走过许多，仍没答案\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他最舍不得的\",\n          \"point\": \"别人待他如自己人\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"最舍不得的\"\n        },\n        {\n          \"text\": \"他没法忘掉那些难受的事\",\n          \"point\": \"回去也未必能像从前一样\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"那些难受的事\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"fine\": [\n        {\n          \"quote\": \"紧张都没有完全解除，反而又形成新的压力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"步伐一点点聚拢，到最后四小节，前进感越来越不可回避\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"害怕还在，脚却已经往前走了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"怕还在，脚已往前\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他明知回去未必找回那份亲近\",\n          \"point\": \"忍不住盼一盼\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"回去未必找回那份亲近\"\n        },\n        {\n          \"text\": \"他不愿只凭这点盼头就回头\",\n          \"point\": \"先把眼下的日子过稳\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"害怕也不往回退\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"fine\": [\n        {\n          \"quote\": \"即使知道自己会犹疑、疲惫、想念，仍然可以决定怎样站立\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"仍可主动决定怎样站立\"\n        },\n        {\n          \"quote\": \"它不要求人假装自己从未受过伤\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"不必假装没受过伤\"\n        },\n        {\n          \"quote\": \"