,\n        {\n          \"quote\": \"美好的时光仍在眼前流淌时，恍惚间却像已经成了回忆\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方看出他的在乎\",\n          \"point\": \"像从前一样亲近\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却还是\"\n        },\n        {\n          \"text\": \"安静下来\",\n          \"point\": \"并不知道自己多害怕\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"才发现\"\n        },\n        {\n          \"text\": \"他又猜\",\n          \"point\": \"舍不得这份亲近\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"会不会\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"原先压着的感受反而变成了动力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"你明知道自己正在被卷进去，却暂时不想出来\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"只是这一刻纵然完美，你也没有办法让它停住\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他渐渐觉得\",\n          \"point\": \"需要自己陪着\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"或许\"\n        },\n        {\n          \"text\": \"这念头让他高兴得收不住\",\n          \"point\": \"舍不得抽身\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"越想越\"\n        },\n        {\n          \"text\": \"他盼着以后\",\n          \"point\": \"还会想到自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"以后\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"没有哲学，没有防卫，没有分析\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连身体也像恢复了弹性\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正当你以为它还会继续唱下去，它却戛然而止\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"以为还会唱\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"见对方依然亲近\",\n          \"point\": \"大大方方地回应\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"依然亲近\"\n        },\n        {\n          \"text\": \"他盼着两人能一直这样好\",\n          \"point\": \"怕只是今天\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却又\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"强烈的渴望还在，却引而不发，那股绷紧的劲尚未真正松开\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"四周并未彻底暗下去，更像阳光被薄雾柔化——光还在，只是隔了一层朦胧的雾气\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不急着接下一句，只是听着自己的余响\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然怕有一天\",\n          \"point\": \"不再需要自己陪伴\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"有一天\"\n        },\n        {\n          \"text\": \"这个念头让他安静下来\",\n          \"point\": \"不敢再往后想\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这个念头让他安静下来\"\n  