<script>
(function () {
  var FEATURE_KEY = 'dsers_linkup_youtube_link';
  var API_HOST = 'https://ab-api.dsers.com';
  var DEV_KEY = 'sdk-DI4rWsZpN6wQ2ICh';
  var PROD_KEY = 'sdk-AdPvHnnqX4IgyKZE';
  var LS_VARIANT = 'dsers_site_chrome_variant';
  var LS_FLAGS = 'dsers_site_chrome_flags';
  var cfg = window.__DS_CHROME_CONFIG__ || {};

  function isLocalHost() {
    var host = (location.hostname || '').toLowerCase();
    return host === 'localhost' || host === '127.0.0.1' || host === '0.0.0.0' || host === '::1' || host.endsWith('.local');
  }

  function isProdHost() {
    if (cfg.env === 'prod' || cfg.env === 'production') return true;
    if (cfg.env === 'test' || cfg.env === 'dev' || cfg.env === 'development') return false;
    if (isLocalHost()) return false;
    var host = (location.hostname || '').toLowerCase();
    if (cfg.site === 'help') return host === 'help.dsers.com';
    return host === 'www.dsers.com';
  }

  function clientKey() {
    if (cfg.growthbookKey) return cfg.growthbookKey;
    return isProdHost() ? PROD_KEY : DEV_KEY;
  }

  function asBoolean(value, fallback) {
    if (typeof value === 'boolean') return value;
    if (typeof value === 'string') {
      var n = value.trim().toLowerCase();
      if (n === 'true' || n === '1') return true;
      if (n === 'false' || n === '0') return false;
    }
    return fallback;
  }

  function extractFeatureValue(feat) {
    if (!feat || typeof feat !== 'object') return null;
    var force =
      feat.rules &&
      feat.rules.length &&
      feat.rules[0] &&
      (feat.rules[0].force !== undefined ? feat.rules[0].force : feat.rules[0].value);
    if (force !== undefined && force !== null && force !== '') return force;
    if (feat.defaultValue !== undefined && feat.defaultValue !== null && feat.defaultValue !== '') {
      return feat.defaultValue;
    }
    return force != null ? force : feat.defaultValue;
  }

  function normalizeConfig(raw) {
    var defaults = { accessible: true, indexable: true };
    if (raw == null) return defaults;
    var parsed = raw;
    if (typeof raw === 'string') {
      var t = raw.trim();
      if (t.charAt(0) === '{' || t.charAt(0) === '[') {
        try { parsed = JSON.parse(t); } catch (e) { return defaults; }
      } else {
        return defaults;
      }
    }
    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return defaults;
    return {
      accessible: asBoolean(parsed.accessible != null ? parsed.accessible : parsed.enabled, true),
      indexable: asBoolean(parsed.indexable != null ? parsed.indexable : parsed.allowIndex, true),
    };
  }

  function readCachedFlags() {
    try {
      var raw = localStorage.getItem(LS_FLAGS);
      if (!raw) return null;
      var o = JSON.parse(raw);
      if (o && typeof o.accessible === 'boolean' && typeof o.indexable === 'boolean') return o;
    } catch (e) {}
    return null;
  }

  function writeCachedFlags(flags) {
    try {
      localStorage.setItem(LS_FLAGS, JSON.stringify({
        accessible: flags.accessible,
        indexable: flags.indexable,
      }));
    } catch (e) {}
  }

  function readLocalOverride() {
    try {
      var raw = localStorage.getItem(LS_VARIANT);
      if (raw === 'new' || raw === 'old') return raw;
    } catch (e) {}
    return null;
  }

  function readQueryOverride() {
    try {
      var q = new URLSearchParams(location.search || '');
      var raw = q.get('ds_chrome') || q.get('chrome');
      if (raw === 'new' || raw === 'old') return raw;
    } catch (e) {}
    return null;
  }

  /** Same as website resolveSiteChromeVariant */
  function resolveVariant(accessible, indexable, localOverride) {
    if (!accessible) return 'old';
    if (indexable) return 'new';
    if (localOverride === 'new' || localOverride === 'old') return localOverride;
    return 'old';
  }

  function fetchFlagsSync() {
    try {
      var xhr = new XMLHttpRequest();
      xhr.open('GET', API_HOST + '/api/features/' + encodeURIComponent(clientKey()), false);
      xhr.send(null);
      if (xhr.status >= 200 && xhr.status < 300) {
        var payload = JSON.parse(xhr.responseText);
        var features = (payload && payload.features) || {};
        return normalizeConfig(extractFeatureValue(features[FEATURE_KEY]));
      }
    } catch (e) {}
    return null;
  }

  var flags = fetchFlagsSync() || readCachedFlags() || { accessible: true, indexable: true };
  writeCachedFlags(flags);

  var local = null;
  if (flags.accessible && !flags.indexable) {
    local = readQueryOverride() || readLocalOverride();
  }
  var variant = resolveVariant(flags.accessible, flags.indexable, local);

  document.documentElement.setAttribute('data-ds-site-chrome', variant);
  window.__DS_CHROME_FLAGS__ = flags;
  window.__DS_CHROME_BOOT__ = {
    variant: variant,
    growthbook: isProdHost() ? 'prod' : 'test',
    clientKey: clientKey(),
  };
})();
</script>

