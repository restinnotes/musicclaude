"},\n            {\"text\": \"重新柔和下来\", \"bead\": \"S02-B3\", \"bars\": \"12–16\"},\n            {\"text\": \"短暂落稳\", \"bead\": \"S02-B3\", \"bars\": \"12–16\"},\n            {\"text\": \"又漂起一点\", \"bead\": \"S02-B3\", \"bars\": \"12–16\"},\n            {\"text\": \"心事没说死\", \"bead\": \"S02-B3\", \"bars\": \"12–16\"}\n          ]\n        },\n        {\n          \"kind\": \"line\",\n          \"text\": \"可他怕太急弄坏自在，还没分开就先舍不得。\",\n          \"keys\": [\"弄坏自在\", \"先舍不得\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-2\", \"S02-3\"]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"rows\": [\n        {\n          \"kind\": \"line\",\n          \"text\": \"难得不用琢磨以后，他只想待在这份亲近里。\",\n          \"keys\": [\"不用琢磨以后\", \"亲近里\"],\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"]\n        },\n        {\n          \"kind\": \"feel\",\n          \"items\": [\n            {\"text\": \"歌声渐渐退远\", \"bead\": \"S03-B1\", \"bars\": \"\"},\n            {\"text\": \"只剩流动盘旋\", \"bead\": \"S03-B1\", \"bars\": \"\"},\n            {\"text\": \"水波托着身体\", \"bead\": \"S03-B1\", \"bars\": \"\"},\n            {\"text\": \"一阵阵摇晃\", \"bead\": \"S03-B1\", \"bars\": \"\"},\n            {\"text\": \"轻轻漂浮\", \"bead\": \"S03-B1\", \"bars\": \"\"},\n            {\"text\": \"暂时不去哪里\", \"bead\": \"S03-B1\", \"bars\": \"\"},\n            {\"text\": \"说完话还沉浸着\", \"bead\": \"S03-B1\", \"bars\": \"\"},\n            {\"text\": \"沉默也很舒服\", \"bead\": \"S03-B1\", \"bars\": \"\"},\n            {\"text\": \"心慢慢漂远\", \"bead\": \"S03-B1\", \"bars\": \"\"}\n          ]\n        },\n        {\n          \"kind\": \"line\",\n          \"text\": \"他忽然想说出喜欢，话还没想好，念头就淡了。\",\n          \"keys\": [\"说出喜欢\", \"念头就淡了\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"]\n        },\n        {\n          \"kind\": \"feel\",\n          \"items\": [\n            {\"text\": \"忽然几声急促\", \"bead\": \"S03-B2\", \"bars\": \"约20–21\"},\n            {\"text\": \"带着一点急切\", \"b