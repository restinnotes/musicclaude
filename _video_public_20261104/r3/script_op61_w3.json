        "S02-B1-p4"
       ],
       "keys": []
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我一舍不得，就会想起受过的委屈。",
       "from": [
        "S02-2"
       ],
       "keys": []
      }
     ],
     "beads": [
