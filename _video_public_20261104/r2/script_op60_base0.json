   ]
  }
 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "lines": [
      {
       "text": "他忽然很想靠近对方，却只敢露出一点喜欢。",
       "keys": [
        "只敢露出一点喜欢"
       ],
       "from": [
        "S01-1",
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "两下和弦，突然响起。",
       "keys": [],
       "from": [
        "S01-B1-p1"
       ]
      },
      {
       "text": "声音落下，却还悬着。",
       "keys": [],
       "from": [
        "S01-B1-p2",
        "S01-B1-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "lines": [
      {
       "text": "对方仍愿意亲近，他才慢慢放松。",
       "keys": [
        "慢慢放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "左手一下一下地摇着。",
       "keys": [],
       "from": [
        "S02-B2-p1"
       ]
      },
      {
       "text": "两条旋律贴得很近。",
       "keys": [],
       "from": [
        "S02-B1-p1"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他还没和对方分开，就先舍不得了。",
       "keys": [
        "先舍不得了"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "几次柔软的落音，像温柔的刺。",
       "keys": [],
       "from": [
        "S02-B4-p1"
       ]
      },
      {
       "text": "甜蜜里，忽然有点鼻酸。",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他喜欢得快藏不住，怕太急又收住。",
       "keys": [
        "怕太急又收住"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声忽然往上涌。",
       "keys": [],
       "from": [
        "S02-B3-p1"
       ]
      },
      {
       "text": "又轻轻呼气，回到柔和。",
       "keys": [],
       "from": [
        "S02-B3-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "lines": [
      {
       "text": "他暂时不想以后，只想待在这份亲近里。",
       "keys": [
        "不想以后"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声退后，只剩摇曳、漂浮。",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他想问对方是否也喜欢这样，念头却淡了。",
       "keys": [
        "念头却淡了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "忽然冒出几声短促、急切的声音。",
       "keys": [],
       "from": [
        "S03-B2-p1"
       ]
      },
      {
       "text": "音乐绕远，声音挂在半途。",
       "keys": [],
       "from": [
        "S03-B3-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "lines": [
      {
       "text": "他又因为亲近而欢喜，想起上次没说的话。",
       "keys": [
        "上次没说的话"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的歌声又回来了。",
       "keys": [],
       "from": [
        "S04-B1-p1"
       ]
      },
      {
       "text": "这一遍更华丽，也更迫切。",
       "keys": [],
       "from": [
        "S04-B1-p3"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他几乎想把心里话全说出来。",
       "keys": [
        "全说出来"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "右手在高处悬停。",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "旋律向高处攀升，又渐弱。",
       "keys": [],
       "from": [
        "S04-B2-p3"
       ]
      },
      {
       "text": "高处长颤音，亮得刺眼。",
       "keys": [],
       "from": [
        "S04-B2-p1"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他怕对方为难，还是留了些话没说。",
       "keys": [
        "留了些话没说"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "摇晃慢下来，人也安静。",
       "keys": [],
       "from": [
        "S04-B2-p4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "lines": [
      {
       "text": "他没藏住喜欢，怕对方嫌他太黏。",
       "keys": [
        "没藏住喜欢"
       ],
       "from": [
        "S05-1",
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "摇晃忽然像被抽掉。",
       "keys": [],
       "from": [
        "S05-B2-p1"
       ]
      },
      {
       "text": "只剩单薄、孤零零的旋律。",
       "keys": [],
       "from": [
        "S05-B2-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "lines": [
      {
       "text": "对方看出他的在乎，却仍然亲近，他又自在了。",
       "keys": [
        "他又自在了"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的摇摆回来了，却变薄了。",
       "keys": [],
       "from": [
        "S06-B1-p2"
       ]
      },
      {
       "text": "新旋律清澈、舒展。",
       "keys": [],
       "from": [
        "S06-B1-p4"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他想到对方不知道他的害怕，又猜对方也舍不得。",
       "keys": [
        "对方也舍不得"
       ],
       "from": [
        "S06-2",
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声压低，旁边不时有回应。",
       "keys": [],
       "from": [
        "S06-B2-p2"
       ]
      },
      {
       "text": "声音时而靠近，时而退开。",
       "keys": [],
       "from": [
        "S06-B2-p4"
       ]
      },
      {
       "text": "安静里还有一点孤单。",
       "keys": [],
       "from": [
        "S06-B3-p1",
        "S06-B3-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "lines": [
      {
       "text": "他渐渐觉得，对方也许需要他陪着。",
       "keys": [
        "也许需要他陪着"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "伴奏变密，暗涌不断攀爬。",
       "keys": [],
       "from": [
        "S07-B1-p1"
       ]
      },
      {
       "text": "低音像沉重的脉搏催促。",
       "keys": [],
       "from": [
        "S07-B1-p1"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他越想越舍不得，盼着以后一直陪着对方。",
       "keys": [
        "一直陪着对方"
       ],
       "from": [
        "S07-2",
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "热度从心底翻涌。",
       "keys": [],
       "from": [
        "S07-B1-p3"
       ]
      },
      {
       "text": "越舒服，越不想抽身。",
       "keys": [],
       "from": [
        "S07-B2-p4",
        "S07-B2-p5"
       ]
      },
      {
       "text": "音乐还美，时间却不停。",
       "keys": [],
       "from": [
        "S07-B3-p1",
        "S07-B3-p2",
        "S07-B3-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "lines": [
      {
       "text": "见对方仍亲近，他也想大方回应。",
       "keys": [
        "大方回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声忽然直接、舒展。",
       "keys": [],
       "from": [
        "S08-B1-p1"
       ]
      },
      {
       "text": "明亮轻盈，还带点玩心。",
       "keys": [],
       "from": [
        "S08-B2-p1",
        "S08-B2-p2"
       ]
      },
      {
       "text": "歌句越唱越开。",
       "keys": [],
       "from": [
        "S08-B1-p3"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他盼着这样好很久，又怕以后变了。",
       "keys": [
        "又怕以后变了"
       ],
       "from": [
        "S08-2",
        "S08-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声向上散掉，没落定。",
       "keys": [],
       "from": [
        "S08-B3-p1"
       ]
      },
      {
       "text": "正要继续，却突然停了。",
       "keys": [],
       "from": [
        "S08-B3-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "lines": [
      {
       "text": "他怕哪天对方不再需要他，连亲近都没了。",
       "keys": [
        "不再需要他"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "冲出去的势头忽然收住。",
       "keys": [],
       "from": [
        "S09-B1-p1"
       ]
      },
      {
       "text": "声音一层层下沉、变暗。",
       "keys": [],
       "from": [
        "S09-B2-p1"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他不敢再想以后，却因眼下仍亲近而高兴。",
       "keys": [
        "眼下仍亲近"
       ],
       "from": [
        "S09-2",
        "S09-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "颤音与轻柔和弦悬在半空。",
       "keys": [],
       "from": [
        "S09-B1-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "lines": [
      {
       "text": "他先不猜以后，终于能享受眼前的亲近。",
       "keys": [
        "享受眼前的亲近"
       ],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "终于长长呼出一口气。",
       "keys": [],
       "from": [
        "S10-B1-p1"
       ]
      },
      {
       "text": "高音细亮，几乎没有重量。",
       "keys": [],
       "from": [
        "S10-B4-p1"
       ]
      },
      {
       "text": "明亮得让人有点想哭。",
       "keys": [],
       "from": [
        "S10-B1-p4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "lines": [
      {
       "text": "他决定不再藏喜欢，愿意一直陪着对方。",
       "keys": [
        "不再藏喜欢"
       ],
       "from": [
        "S11-1",
        "S11-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "厚重的和弦托起歌声。",
       "keys": [],
       "from": [
        "S11-B1-p2"
       ]
      },
      {
       "text": "温柔的水波翻成惊涛骇浪。",
       "keys": [],
       "from": [
        "S11-B1-p2"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他想一直陪着，却不知道对方以后愿不愿意。",
       "keys": [
        "以后愿不愿意"
       ],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "原来的温柔有了新重量。",
       "keys": [],
       "from": [
        "S11-B2-p3"
       ]
      },
      {
       "text": "欢喜浓烈到胸口发疼。",
       "keys": [],
       "from": [
        "S11-B4-p3",
        "S11-B4-p4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "lines": [
      {
       "text": "他只想把能给的都给对方，不再计较回应。",
       "keys": [
        "能给的都给对方"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音明亮、开阔，一浪高过一浪。",
       "keys": [],
       "from": [
        "S12-B1-p1"
       ]
      },
      {
       "text": "内声部却彼此拉扯。",
       "keys": [],
       "from": [
        "S12-B1-p1"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他还想多陪一会儿，终于不再收着喜欢。",
       "keys": [
        "不再收着喜欢"
       ],
       "from": [
        "S12-2",
        "S12-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旋律一次次向上，还想要更多。",
       "keys": [],
       "from": [
        "S12-B2-p2"
       ]
      },
      {
       "text": "那口气悬到最后才释放。",
       "keys": [],
       "from": [
        "S12-B2-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "lines": [
      {
       "text": "他想听一句永远不变的保证，却知道没人能答应。",
       "keys": [
        "没人能答应"
       ],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚刚释放，音乐却没收住。",
       "keys": [],
       "from": [
        "S13-B1-p1"
       ]
      },
      {
       "text": "反复渐强，越推越紧。",
       "keys": [],
       "from": [
        "S13-B1-p2"
       ]
      },
      {
       "text": "明亮里渐渐混入尖锐、暗沉。",
       "keys": [],
       "from": [
        "S13-B3-p2"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他怕以后更疼，想藏回喜欢反而更难受。",
       "keys": [
        "反而更难受"
       ],
       "from": [
        "S13-2",
        "S13-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "上方的声音一次次下落。",
       "keys": [],
       "from": [
        "S13-B4-p2"
       ]
      },
      {
       "text": "又有更大的浪推上来。",
       "keys": [],
       "from": [
        "S13-B1-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S14",
   "groups": [
    {
     "lines": [
      {
       "text": "他想起最初的紧张，仍舍不得，却不再求保证。",
       "keys": [
        "不再求保证"
       ],
       "from": [
        "S14-1",
        "S14-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "最后一股浪过后，音乐终于松下来。",
       "keys": [],
       "from": [
        "S14-B3-p1",
        "S14-B3-p2"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "他不再藏起喜欢，往后的事等以后再说。",
       "keys": [
        "不再藏起喜欢"
       ],
       "from": [
        "S14-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的声响，远远回应一声。",
       "keys": [],
       "from": [
        "S14-B4-p2"
       ]
      },
      {
       "text": "细碎的琶音，最后一闪。",
       "keys": [],
       "from": [
        "S14-B1-p3"
       ]
      },
      {
       "text": "最后几下和弦，干脆沉重。",
       "keys": [],
       "from": [
        "S14-B2-p2"
       ]
      }
     ]
    }
   ]
  }
 ]
}