      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S11",
    "bars": "226–241",
    "relation": "正在面对",
    "items": [
     {
      "id": "S11-1",
      "text": "他还是会想象重新靠近旧日生活，心里先涌上来的仍是那份熟悉的温暖。",
      "key": "他还是会想象重新",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2",
       "S10-3"
      ]
     },
     {
      "id": "S11-2",
      "text": "可一想到回去也可能重新受委屈，他就发紧，想靠近的念头总被这层担心反复压住。",
      "key": "可一想到回去也可",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-1"
      ]
     },
     {
      "id": "S11-3",
      "text": "即便不安没有消失，他心里那点想试着重新靠近的愿望还是渐渐清楚起来，只是还没成为决定。",
      "key": "即便不安没有消失",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-1",
       "S11-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-2",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S10-3",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S10-1",
      "to": "S11-2",
      "rel": "引用"
     },
     {
      "from": "S11-1",
      "to": "S11-3",
      "rel": "引用"
     },
     {
      "from": "S11-2",
      "to": "S11-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "242–253",
    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "他终于能坦然承认，自己就是舍不得那份自然被接纳的感觉，同时也不愿再回到委屈自己的日子。",
      "key": "他终于能坦然承认",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2",
       "S01-2",
       "S11-1",
       "S11-2"
      ]
     },
     {
      "id": "S12-2",
      "text": "这份承认刚在心里落定，他又有一瞬发虚，怕自己终究会后悔；可那点不安没有让他收回刚才的承认。",
      "key": "这份承认刚在心里",
