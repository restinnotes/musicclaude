 \"S13\",\n      \"row\": 4,\n      \"items\": [\n        {\"text\": \"刚刚答了声是\", \"bead\": \"S13-B3\"},\n        {\"text\": \"心里马上反问\", \"bead\": \"S13-B3\"},\n        {\"text\": \"可是呢\", \"bead\": \"S13-B3\"},\n        {\"text\": \"苦涩插进来\", \"bead\": \"S13-B3\"},\n        {\"text\": \"幸福没有变假\", \"bead\": \"S13-B3\"},\n        {\"text\": \"相信之后生出怀疑\", \"bead\": \"S13-B3\"},\n        {\"text\": \"越相信越疼\", \"bead\": \"S13-B3\"}\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"row\": 2,\n      \"items\": [\n        {\"text\": \"左手幽幽唱出\", \"bead\": \"S14-B2\"},\n        {\"text\": \"男中音般沉思\", \"bead\": \"S14-B2\"},\n        {\"text\": \"熟悉的歌声回来\", \"bead\": \"S14-B2\"},\n        {\"text\": \"低低一声回望\", \"bead\": \"S14-B2\"},\n        {\"text\": \"细碎琶音\", \"bead\": \"S14-B2\"},\n        {\"text\": \"水花溅向夜空\", \"bead\": \"S14-B2\"},\n        {\"text\": \"最后一闪\", \"bead\": \"S14-B2\"}\n      ]\n    }\n  ],\n  \"lines\": [\n    {\n      \"sec\": \"S04\",\n      \"idx\": 2,\n      \"text\": \"可他怕说得太多会让对方为难。\",\n      \"keys\": [\"也怕两人失去原本的自在\"]\n    },\n    {\n      \"sec\": \"S05\",\n      \"idx\": 0,\n      \"text\": \"前几次他收住了，对方仍亲近他，这回没藏住喜欢。\",\n      \"keys\": [\"对方却仍亲近\"]\n    },\n    {\n      \"sec\": \"S07\",\n      \"idx\": 1,\n      \"text\": \"两人也许能互相依靠，他高兴，也隐隐紧张起来。\",\n      \"keys\": [\"这念头让他高兴，也隐隐紧张起来\"]\n    },\n    {\n      \"sec\": \"S08\",\n      \"idx\": 1,\n      \"text\": \"他想把眼前的亲近过得尽兴。\",\n      \"keys\": [\"一直这么好\", \"未必天天如此\"]\n    },\n    {\n      \"sec\": \"S12\",\n      \"idx\": 1,\n      \"text\": \"他仍嫌时间太少，想多陪对方。\",\n      \"keys\": [\"以后未必还能像现在这样相处\"]\n    },\n    {\n      \"sec\": \"S13\",\n      \"idx\": 1,\n      \"text\": \"他越喜欢，越想把喜欢藏起来。\",\n      \"keys\": [\"怕对方不再需要自己\"]\n    },\n    {\n      \"sec\": \"S13\",\n      \"idx\": 2,\n      \"text\": \"他不再装作不在乎；他是真心想对对方好，若再藏起心意反而难受。\",\n      \"keys\": [\"再把这份心意藏起来反而难受\"]\n    },\n    {\n      \"sec\": \"S14\",\n      \"idx\": 1,\n      \"text\": \"他还是舍不得，却不再求保证。\",\n      \"keys\": [\