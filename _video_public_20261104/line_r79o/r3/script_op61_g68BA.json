       "from": [
        "S04-1",
        "S04-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旋律像独自说话",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "步伐还在向前",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
