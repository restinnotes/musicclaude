        <script>
            window.TRADEUP_INLINE_BOOTSTRAP = {"tradeInBaseUrl":"/shop/tradein-module?bfr=true&fae=true&pcat=tablet","tradeInDetailsUrl":"/shop/tradein-details?bfr=true&fae=true&pcat=tablet","modules":[{"module":"verify","moduleData":{"verification":{"sections":[{"fields":[[{"name":"sno","type":"text","label":"序列号","maxSize":"14","required":"true","rules":[{"type":"required","message":"请输入设备的序列号。"},{"type":"regex","message":"该序列号无效。请再试一次。","regEx":["^[a-zA-Z0-9]{8,14}$"]}]}]]}],"piplConsent":[{"disclaimer":"我同意<a href=\"https://support.apple.com/zh-cn/HT213840\" data-slot-name=\"tradeIn\" data-feature-name=\"Astro Link\" data-display-name=\"AOS: support.apple.com/zh-cn/HT213840\" class=\"icon icon-external\" target=\"_blank\">Apple 的隐私政策<span class=\"visuallyhidden\">(在新窗口中打开)</span></a>","param":"cp1"},{"disclaimer":"我了解，当我参与 Apple Trade In 换购计划时，有限的个人信息可能会在中国境外存储和处理。","param":"cp2"}]},"verifyUrl":"/shop/tradein-verify?bfr=true&cat=tablet&fae=true&product=md4g4ch/a&pcat=tablet&bid=1","method":"POST"},"assets":{"tradein-verify-header":"输入你的 iPad 序列号。","tradein-verify-piplconsent-footer":"我们提供包括 Apple 隐私政策在内的更多信息。<a href=\"https://support.apple.com/zh-cn/HT213840\" data-slot-name=\"tradeIn\" data-feature-name=\"Astro Link\" data-display-name=\"AOS: support.apple.com/zh-cn/HT213840\" class=\"icon icon-external\" target=\"_blank\">进一步了解<span class=\"visuallyhidden\">Apple 隐私政策(在新窗口中打开)</span></a>。","tradein-verify-desc":"前往“设置”>“通用”>“关于本机”。此信息也可能镌刻在设备背面。","tradein-verify-success-message":"","tradein-verify-footer":"<div class=\"row as-tradeup-findserial\">\n\t<div class=\"column as-tradeup-findserial-details\">\n\t\t<h4 class=\"as-tradeup-findserial-header\">如何找到此信息</h4>\n\t\t<div class=\"as-tradeup-findserial-path\">前往“设置”<span>&gt;</span>“通用”<span>&gt;</span>“关于本机”。此信息可能镌刻在设备背面。你提供的数据将按照 <a href=\"https://www.apple.com.cn/legal/privacy/szh\" data-slot-name=\"tradeIn\" data-feature-name=\"Astro Link\" data-display-name=\"AOS: legal/privacy/szh\" target=\"privacynotice