       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "刚才多怕被嫌弃只有他自己晓得，心里不免孤单",
       "keys": [
        "心里不免孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像白天相处很好，夜里回到家独处心头却泛起酸楚",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他又忍不住想，对方既然一直留着没躲开，会不会也有点舍不得跟他分开？",
