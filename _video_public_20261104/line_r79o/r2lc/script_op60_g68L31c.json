 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "这份亲近忽然让他心里一热，他有些意外",
       "keys": [
        "心里一热"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夏夜烟花缓缓飘落，又像刚踏上船板晃得一下失重",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可一旦认真认下来，眼下的自在或许就会变样，他还是把这份心意收在心里",
       "keys": [
        "把这份心意收在心里"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话到嘴边先沉默几秒，怕一说出口关系就变了",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "光这么一点亲近就很甜，他还拿不准下次能不能更坦白些",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这份亲近让他觉得温暖而妥帖，不必刻意维持什么，也能安静地享受其中",
       "keys": [
        "温暖而妥帖"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像紧挨着耳语连体温都融在一处，又像夏末微黏的暖风",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "也像熟人安静坐着不用找话，偶尔对望也不紧张",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "脚下不必踩实地面，把身体交给船底温柔地托着",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他开始盼着自己能一直留在这样的亲近里，不再总给自己留一截退路",
       "keys": [
        "一直留在这样的亲近里"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可真要把心意全放进去，他又怕打破眼下的安宁",
       "keys": [
        "怕打破眼下的安宁"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "想到这份好未必长久，满足里已带着一点不舍",
       "keys": [
        "带着一点不舍"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "人在船上舒服地漂着不急着靠岸，水和时间却一直在走",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像扎了根温柔的刺，眼前的好还在却已经有点鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他很想痛快地承认自己有多珍惜，随即又把那股热意收回，仍没想好该把心意放到哪里",
       "keys": [
        "又把那股热意收回"
       ],
       "from": [
        "S02-4"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他不再时时提醒自己留点余地，开始更坦然地享受这份亲近带来的满足",
       "keys": [
        "更坦然地享受"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像说完重要的话还陶醉在里头，有一点走神",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "又像交谈后安静下来也不尴尬，人还在心却慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "沉浸中忽然闪过一个急切念头，他很想让这种感觉再多留一会儿",
       "keys": [
        "再多留一会儿"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "念头很快退去，没有变成打算",
       "keys": [
        "念头很快退去"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急着倾诉的念头只在水面露了下头，很快又沉了回去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
