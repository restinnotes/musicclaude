": \"\",\n          \"keep\": \"真盼着\"\n        },\n        {\n          \"text\": \"可越想念，他越想起委屈\",\n          \"point\": \"怀疑当初那一步\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"越想念，他越想起委屈\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是想通了，是抵抗累了\"\n        },\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像脚下原有的地板忽然不见了，只剩一个声音自己说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"只剩一个声音独自说话\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他不服气，受过的气\",\n          \"point\": \"开心的事也不该抹掉\",\n          \"where\": \"后\",\n          \"waste\": \"他不服气，\",\n          \"keep\": \"也\"\n        },\n        {\n          \"text\": \"争得没了力气\",\n          \"point\": \"已不在那些人身边\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"争得没了力气，他才发现\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份安宁并不意味着现实已经变好，也不是一个能永远停留的地方\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"这回想起从前\",\n          \"point\": \"没急着拿受过的气压住想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没急着\"\n        },\n        {\n          \"text\": \"独自熬过难处后\",\n          \"point\": \"有人陪着有多轻松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"独自熬过难处后\"\n        },\n        {\n          \"text\": \"他怕再也没有那份亲近\",\n          \"point\": \"因曾拥有而暖了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却因曾拥有而暖了一点\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"把人从甜梦里生生拽回严寒；后颈一凉，脉搏也剧烈跳动\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"早知道这样，自己还会走吗？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"早知道会这么孤单，还会走吗？\"\n        },\n        {\n          \"quote\": \"恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他刚安心一点\",\n          \"point\": \"还得独自扛\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"刚安心一点，就想到\"\n        },\n        {\n          \"text\": \"他想找回亲近\",\n          \"point\": \"没了当初的决心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却不愿再受气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"刚认出它，还没来得及重新安顿下来，它就又退去了\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一眼里有温柔，也有不舍\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\"