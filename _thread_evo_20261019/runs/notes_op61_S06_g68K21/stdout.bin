{"completed": true, "response": "<escape>{\n  \"feel\": [\n    {\n      \"text\": \"隔开的一片静谧\",\n      \"from\": [\"S06-B1\"]\n    },\n    {\n      \"text\": \"连呼吸都不愿惊动\",\n      \"from\": [\"S06-B1\"]\n    },\n    {\n      \"text\": \"安宁不等于一切变好\",\n      \"from\": [\"S06-B1\"]\n    },\n    {\n      \"text\": \"这片安宁不能久留\",\n      \"from\": [\"S06-B1\"]\n    },\n    {\n      \"text\": \"不用解释难过\",\n      \"from\": [\"S06-B2\"]\n    },\n    {\n      \"text\": \"不必维持坚强\",\n      \"from\": [\"S06-B2\"]\n    },\n    {\n      \"text\": \"压住的委屈和愿望冒头\",\n      \"from\": [\"S06-B2\"]\n    },\n    {\n      \"text\": \"看见却回不去\",\n      \"from\": [\"S06-B2\"]\n    },\n    {\n      \"text\": \"知道有些事挽不回\",\n      \"from\": [\"S06-B4\"]\n    },\n    {\n      \"text\": \"放轻声音看着它\",\n      \"from\": [\"S06-B4\"]\n    },\n    {\n      \"text\": \"像看着珍惜的东西\",\n      \"from\": [\"S06-B4\"]\n    },\n    {\n      \"text\": \"不必立刻抓回来\",\n      \"from\": [\"S06-B4\"]\n    }\n  ],\n  \"notes\": [\n    {\n      \"text\": \"绵长从容的声音几乎停驻\",\n      \"bars\": \"148–180\",\n      \"from\": [\"S06-B1\"]\n    },\n    {\n      \"text\": \"整片声音像被透明玻璃罩隔开\",\n      \"bars\": \"148–180\",\n      \"from\": [\"S06-B1\"]\n    },\n    {\n      \"text\": \"轻柔旋律像母亲在耳边哼唱摇篮曲\",\n      \"bars\": \"148–180\",\n      \"from\": [\"S06-B1\"]\n    },\n    {\n      \"text\": \"近似圣咏的庄严旋律藏着秘密念头\",\n      \"bars\": \"148–180\",\n      \"from\": [\"S06-B2\"]\n    },\n    {\n      \"text\": \"歌唱像向遥远处祈求，却未许诺回应\",\n      \"bars\": \"148–180\",\n      \"from\": [\"S06-B2\"]\n    },\n    {\n      \"text\": \"旋律忽然亮起，远去的家园在梦里显现\",\n      \"bars\": \"160–160\",\n      \"from\": [\"S06-B2\"]\n    },\n    {\n      \"text\": \"旋律含蓄试探，像话还没说出口\",\n      \"bars\": \"148–151\",\n      \"from\": [\"S06-B3\"]\n    },\n    {\n      \"text\": \"歌唱渐渐展开，像终于鼓起勇气开口\",\n      \"bars\": \"152–167\",\n      \"from\": [\"S06-B3\"]\n    },\n    {\n      \"text\": \"歌唱再次展开，听来更充实也更迫切\",\n      \"bars\": \"168–180\",\n      \"from\": [\"S06-B3\"]\n    },\