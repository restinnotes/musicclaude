      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "216–225",
    "relation": "正在面对",
    "items": [
     {
      "id": "S10-1",
      "text": "他又想到一件更没把握的事：就算真的回去，从前那种被人当自己人的日子，就一定还能有吗？",
      "key": "他又想到一件更没",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S03-2",
       "S09-1"
      ]
     },
     {
      "id": "S10-2",
      "text": "何况当初那些让他难受的事也不能当作没发生过，光凭舍不得，他还是没法放心回去。",
      "key": "何况当初那些让他",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S02-2",
       "S10-1"
      ]
     },
     {
      "id": "S10-3",
      "text": "他翻来覆去想得很累，还是没个答案，连眼下的日子都过得不踏实。",
      "key": "他翻来覆去想得很",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-2",
       "S10-1",
       "S10-2"
      ]
     }
    ],
    "because": [
     {
