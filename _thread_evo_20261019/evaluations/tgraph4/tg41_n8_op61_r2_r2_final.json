{
 "center": "向外行动与旧梦都要求投入，却彼此牵制。",
 "segments": [
  {
   "bars": "1–23",
   "relation": "还说不清",
   "items": [
    {
     "id": "I1",
     "text": "他起初不知自己究竟在等什么，只隐约觉得放任某些事，仿佛就是认了它们理所当然。",
     "key": "放任某些事等于默认",
     "kind": "",
     "key_model": "理所当然"
    },
    {
     "id": "I2",
     "text": "他想把自己投进去，却又怕丢下什么，还分不清两股牵扯各自指向哪里。",
     "key": "想投入却怕丢下什么",
     "kind": "",
     "key_model": "丢下什么"
    },
    {
     "id": "I3",
     "text": "他试着寻找一个足以不再犹豫的理由，刚有些把握，另一份舍不得便浮上来。",
     "key": "寻找不再犹豫的理由",
     "kind": "",
     "key_model": "不再犹豫"
    },
    {
     "id": "I4",
     "text": "他有时几乎相信自己想通了，过一会儿却连刚才的确信也觉得陌生。",
     "key": "刚有的确信变陌生",
     "kind": "",
     "key_model": "确信"
    },
    {
     "id": "I5",
     "text": "反复摇摆让他难堪，他怀疑自己是否非得把心里的事都理清才肯向前。",
     "key": "因反复摇摆而难堪",
     "kind": "",
     "key_model": "摇摆"
    }
   ],
   "because": [],
   "relation_votes": {
    "还说不清": 6
   },
   "relation_model": "还说不清"
  },
  {
   "bars": "24–65",
   "relation": "正在面对",
   "items": [
    {
     "id": "I6",
     "text": "他渐渐无法再拿没想清楚作等待的理由，决定先承担自己能够承担的部分。",
     "key": "不等想清楚便先承担",
     "kind": "",
     "key_model": "先承担"
    },
    {
     "id": "I7",
     "text": "没有保证，心里的牵挂也没有消失，但开始行动后，他真切感到自己有了力量。",
     "key": "行动中感到力量",
     "kind": "",
     "key_model": "有了力量"
    },
    {
     "id": "I8",
     "text": "他不再反复追问值不值得，转而愿意尽力，并为没有任疑虑支配自己而骄傲。",
     "key": "不问值不值得而尽力",
     "kind": "",
     "key_model": "愿意尽力"
    },
    {
     "id": "I9",
     "text": "投入与付出令他热切而快乐，仿佛原先无处可去的不满终于有了去处。",
     "key": "付出带来热切快乐",
     "kind": "",
     "key_model": "热切而快乐"
    },
    {
     "id": "I10",
     "text": "他乐意付出更多，甚至贪恋倾尽全力的畅快，不愿再为一点软弱停下来审视自己。",
     "key": "贪恋倾尽全力的畅快",
     "kind": "",
     "key_model": "倾尽全力"
    },
    {
     "id": "I11",
     "text": "用力到深处，他偶尔触到心里仍未跟着振奋的一处，隐约知道坚定没照顾到所有牵挂。",
     "key": "振奋中仍有未安之处",
     "kind": "满足照出未满足",
     "key_model": "所有牵挂"
    }
   ],
   "because": [
    {
     "from": "I1",
     "to": "I6",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I5",
     "to": "I6",
     "rel": "动摇",
     "audit": "支持"
    },
    {
     "from": "I3",
     "to": "I8",
     "rel": "改写",
     "audit": "支持"
    },
    {
     "from": "I2",
     "to": "I11",
     "rel": "仍在起作用",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 4,
    "还说不清": 2
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "66–91",
   "relation": "没在想",
   "items": [
    {
     "id": "I12",
     "text": "那点隐约的不安还不足以使他停下，认真投入过后，他反倒能稍稍放下反复自问。",
     "key": "认真投入后稍放自问",
     "kind": "",
     "key_model": "反复自问"
    },
    {
     "id": "I13",
     "text": "他为不再畏缩而高兴，偶尔忘了为何用力，也觉得这一时的轻松并不算背叛。",
     "key": "为不再畏缩而高兴",
     "kind": "",
     "key_model": "不再畏缩"
    },
    {
     "id": "I14",
     "text": "那种许久没有的自由使他轻盈，他顺着它走了一程，没有忙着赋予更大意义。",
     "key": "顺着自由轻盈前行",
     "kind": "",
     "key_model": "使他轻盈"
    },
    {
     "id": "I15",
     "text": "当快乐渐渐不再那么满，他发现此前的决定仍等着自己，不能一直忘在一旁。",
     "key": "快乐退去决定仍在",
     "kind": "",
     "key_model": "此前的决定"
    }
   ],
   "because": [
    {
     "from": "I7",
     "to": "I12",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I8",
     "to": "I13",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I6",
     "to": "I15",
     "rel": "仍在起作用",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "没在想": 6
   },
   "relation_model": "没在想"
  },
  {
   "bars": "92–115",
   "relation": "正在面对",
   "items": [
    {
     "id": "I16",
     "text": "他重新面对自己作过的决定，仍愿坚持，不愿因心里尚有缺口就否定此前的行动。",
     "key": "带着缺口坚持决定",
     "kind": "",
     "key_model": "仍愿坚持"
    },
    {
     "id": "I17",
     "text": "从前令他振奋的坚定，此时已无法使他安心。",
     "key": "坚定已无法使他安心",
     "kind": "",
     "key_model": "无法使他安心"
    },
    {
     "id": "I18",
     "text": "他试图用坚定确认自己还有力量，却察觉心里另有要求无法被它照顾。",
     "key": "坚定照顾不了另一要求",
     "kind": "",
     "key_model": "另有要求"
    },
    {
     "id": "I19",
     "text": "他虽不情愿，仍不得不承认，值得继续的行动也留下了无法满足的要求。",
     "key": "行动留下未满足的要求",
     "kind": "办法的限度",
     "key_model": "无法满足"
    }
   ],
   "because": [
    {
     "from": "I7",
     "to": "I16",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I13",
     "to": "I16",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I10",
     "to": "I17",
     "rel": "失效",
     "audit": "支持"
    },
    {
     "from": "I11",
     "to": "I18",
     "rel": "唤起",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 4,
    "还说不清": 2
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "116–147",
   "relation": "正在面对",
   "items": [
    {
     "id": "I20",
     "text": "明知行动仍有欠缺，他怕失望意味着自己变了心，于是更用力地催逼自己坚持。",
     "key": "怕失望便加倍坚持",
     "kind": "",
     "key_model": "变了心"
    },
    {
     "id": "I21",
     "text": "心里难受时他把它当成要克服的迟疑，想稍微停下，又担心自己是在退缩。",
     "key": "把难受当成迟疑来克服",
     "kind": "",
     "key_model": "退缩"
    },
    {
     "id": "I22",
     "text": "他知道自己正受苦，却想不出除了坚持，还有什么能对得起最初的决意。",
     "key": "只想得出坚持一途",
     "kind": "",
     "key_model": "最初的决意"
    },
    {
     "id": "I23",
     "text": "从前令他昂扬的要求渐渐变成苛责，连脆弱也容不下，他仿佛在逼迫疲惫的自己。",
     "key": "昂扬要求变成苛责",
     "kind": "办法的限度",
     "key_model": "逼迫疲惫"
    },
    {
     "id": "I24",
     "text": "他终于不愿再证明自己有多坚强，便暂时停下对自己的催逼。",
     "key": "停止逼迫自己",
     "kind": "",
     "key_model": "不愿再证明"
    },
    {
     "id": "I25",
     "text": "停下仍未让他安心，却让被压下的依恋浮现，他仿佛肯承认自己还真心舍不得一些东西。",
     "key": "停下后依恋浮现",
     "kind": "",
     "key_model": "依恋"
    }
   ],
   "because": [
    {
     "from": "I7",
     "to": "I20",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I19",
     "to": "I20",
     "rel": "唤起",
     "audit": "支持"
    },
    {
     "from": "I10",
     "to": "I23",
     "rel": "失效",
     "audit": "支持"
    },
    {
     "from": "I11",
     "to": "I25",
     "rel": "唤起",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 4,
    "还说不清": 2
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "148–180",
   "relation": "没在想",
   "items": [
    {
     "id": "I26",
     "text": "他慢慢发现，自己舍不得的是曾经真心相信能有的生活，并不只求免于辛苦。",
     "key": "舍不得曾相信的生活",
     "kind": "分清",
     "key_model": "相信能有的生活"
    },
    {
     "id": "I27",
     "text": "他盼望人与人无需时时防备，珍爱的东西也不必靠争夺才能保住。",
     "key": "盼望亲近不必争夺",
     "kind": "",
     "key_model": "无需时时防备"
    },
    {
     "id": "I28",
     "text": "他还盼望无需不断证明值得被爱，能因喜欢而付出，靠近时也无需先防备受伤。",
     "key": "盼望付出靠近无需防备",
     "kind": "",
     "key_model": "值得被爱"
    },
    {
     "id": "I29",
     "text": "他曾自然地相信这种生活可能，也确实在其中感到快乐与不费力的亲近。",
     "key": "曾相信亲近可以轻松",
     "kind": "",
     "key_model": "不费力的亲近"
    },
    {
     "id": "I30",
     "text": "因那份快乐曾经真实，他不愿把如今的盼望看作逃避时编出的安慰，也不肯说它软弱。",
     "key": "不肯贬低真实的盼望",
     "kind": "",
     "key_model": "逃避时编出"
    },
    {
     "id": "I31",
     "text": "他终于肯尽情爱惜那份盼望，不再拿责任审问自己，也不急着问它能否得到或是否更重要。",
     "key": "尽情爱惜那份盼望",
     "kind": "",
     "key_model": "尽情爱惜"
    },
    {
     "id": "I32",
     "text": "只需允许自己这样爱、这样相信，他就感到深深满足，仿佛又能柔软地生活。",
     "key": "允许自己柔软地生活",
     "kind": "",
     "key_model": "深深满足"
    },
    {
     "id": "I33",
     "text": "他沉浸在这份真实的安宁中，几乎忘了先前的疲惫，一时也不想离开。",
     "key": "沉浸真实安宁不愿离开",
     "kind": "",
     "key_model": "真实的安宁"
    }
   ],
   "because": [
    {
     "from": "I24",
     "to": "I26",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I2",
     "to": "I26",
     "rel": "改写",
     "audit": "支持"
    },
    {
     "from": "I25",
     "to": "I29",
     "rel": "唤起",
     "audit": "支持"
    },
    {
     "from": "I23",
     "to": "I31",
     "rel": "改写",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "没在想": 5,
    "正在面对": 1
   },
   "relation_model": "没在想"
  },
  {
   "bars": "181–205",
   "relation": "正在面对",
   "items": [
    {
     "id": "I34",
     "text": "真实的安宁渐渐让他意识到，只靠心里的怀念无法改变那种生活所受的威胁。",
     "key": "怀念无法改变生活威胁",
     "kind": "满足照出未满足",
     "key_model": "心里的怀念"
    },
    {
     "id": "I35",
     "text": "重新感到那份生活值得爱惜，他便不甘心再被动等待，想重新面对那些威胁。",
     "key": "重新面对威胁不再等待",
     "kind": "",
     "key_model": "再被动等待"
    },
    {
     "id": "I36",
     "text": "他随即懊恼自己刚才沉浸在满足里，竟忘了那些必须面对的事。",
     "key": "懊恼沉浸满足忘了面对",
     "kind": "",
     "key_model": "懊恼"
    },
    {
     "id": "I37",
     "text": "他试着重新催促自己振作，这一次却无法像先前那样毫无顾忌地投入。",
     "key": "再催振作却难投入",
     "kind": "",
     "key_model": "振作"
    },
    {
     "id": "I38",
     "text": "他怕艰难的争取慢慢耗尽心中温柔，最后只剩不肯退让的意志，却忘了为何要争取。",
     "key": "怕争取耗尽心中温柔",
     "kind": "",
     "key_model": "耗尽心中温柔"
    },
    {
     "id": "I39",
     "text": "他既舍不得刚感到的安宁，也放不下它所受的威胁，向前与停留都使他不安。",
     "key": "安宁与威胁难以两全",
     "kind": "",
     "key_model": "向前与停留"
    },
    {
     "id": "I40",
     "text": "如今他能找到的理由反而更多，内心却比从前更难作决定。",
     "key": "理由更多决定更难",
     "kind": "知道更多反而更尖锐",
     "key_model": "理由反而更多"
    }
   ],
   "because": [
    {
     "from": "I33",
     "to": "I34",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I1",
     "to": "I35",
     "rel": "仍在起作用",
     "audit": "支持"
    },
    {
     "from": "I29",
     "to": "I38",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I3",
     "to": "I40",
     "rel": "改写",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "206–213",
   "relation": "没在想",
   "items": [
    {
     "id": "I41",
     "text": "为难中，那份温柔又短暂贴近他，明知无法一直停留，他仍不忍立刻推开。",
     "key": "不忍推开短暂温柔",
     "kind": "",
     "key_model": "短暂贴近"
    },
    {
     "id": "I42",
     "text": "他想到它曾给过深深的满足，便愿意再爱惜片刻，暂时不拿它审问自己。",
     "key": "再爱惜那份满足",
     "kind": "",
     "key_model": "再爱惜片刻"
    },
    {
     "id": "I43",
     "text": "他短暂放下那些还无答案的事，安静仍使他欢喜，欢喜里却已经带着不舍。",
     "key": "安静欢喜中带不舍",
     "kind": "",
     "key_model": "带着不舍"
    }
   ],
   "because": [
    {
     "from": "I33",
     "to": "I41",
     "rel": "唤起",
     "audit": "支持"
    },
    {
     "from": "I32",
     "to": "I42",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I39",
     "to": "I43",
     "rel": "仍在起作用",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "没在想": 6
   },
   "relation_model": "没在想"
  },
  {
   "bars": "214–215",
   "relation": "正在面对",
   "items": [
    {
     "id": "I44",
     "text": "当这点安静退去，熟悉的迟疑又回来了，他仿佛走了很远仍回到原处。",
     "key": "迟疑又回到原处",
     "kind": "",
     "key_model": "回到原处"
    },
    {
     "id": "I45",
     "text": "他终于知道迟疑里除了怯懦，还有自己真心不愿失去的生活希望。",
     "key": "迟疑藏着生活希望",
     "kind": "分清",
     "key_model": "生活希望"
    }
   ],
   "because": [
    {
     "from": "I5",
     "to": "I44",
     "rel": "仍在起作用",
     "audit": "支持"
    },
    {
     "from": "I26",
     "to": "I45",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I2",
     "to": "I45",
     "rel": "改写",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "216–225",
   "relation": "正在面对",
   "items": [
    {
     "id": "I46",
     "text": "明白舍不得什么仍未使他勇敢起来，他既无法只凭决心向前，也难安心待在旧愿里。",
     "key": "既难向前也难停留",
     "kind": "",
     "key_model": "无法只凭决心"
    },
    {
     "id": "I47",
     "text": "他一时无力再逼自己作大改变，只盼再次争取时，别忘记自己为什么争取。",
     "key": "盼争取时不忘初衷",
     "kind": "",
     "key_model": "别忘记"
    },
    {
     "id": "I48",
     "text": "他也盼能继续爱惜那份安宁，同时不回避那些使它难以存在的事。",
     "key": "爱惜安宁也不回避威胁",
     "kind": "",
     "key_model": "不回避"
    },
    {
     "id": "I49",
     "text": "他还不知道怎样才能两边都顾及，只是反复想着，非舍弃一边不可的逼迫似乎轻了一点。",
     "key": "非此即彼的逼迫减轻",
     "kind": "",
     "key_model": "逼迫似乎轻了"
