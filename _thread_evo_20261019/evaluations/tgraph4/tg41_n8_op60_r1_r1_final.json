  {
   "bars": "111–116",
   "relation": "正在面对",
   "items": [
    {
     "id": "I65",
     "text": "牵挂仍未平息，他渐渐不再要求自己找出一种不会受伤的爱法。",
     "key": "不再强求无伤的爱法",
     "kind": "",
     "key_model": "不会受伤的爱法"
    },
    {
     "id": "I66",
     "text": "他仍想被对方选择，因为对方确实重要，即使未必如愿，也不愿假装不曾期盼。",
     "key": "仍盼被重要的人选择",
     "kind": "",
     "key_model": "不曾期盼"
    },
    {
     "id": "I67",
     "text": "他不愿放弃克制，因为对方有自己的心意，他不想为了安心而逼对方迁就。",
     "key": "不愿逼对方迁就求安心",
     "kind": "分清",
     "key_model": "逼对方迁就"
    },
    {
     "id": "I68",
     "text": "他依旧会遗憾，但不再觉得必须先消除这份遗憾，才能继续喜欢。",
     "key": "带着遗憾继续喜欢",
     "kind": "",
     "key_model": "依旧会遗憾"
    },
    {
     "id": "I69",
     "text": "即使疑问没得到回答，他仍珍惜先前那些真实的快乐，也因此知道对方多重要。",
     "key": "珍惜快乐更懂对方重要",
     "kind": "",
     "key_model": "真实的快乐"
    },
    {
     "id": "I70",
     "text": "他仍盼回应，也仍会克制，却不拿回应的有无检验真心，或拿克制多少证明清醒。",
     "key": "不以回应克制检验真心",
     "kind": "分清",
     "key_model": "检验真心"
    },
    {
     "id": "I71",
     "text": "他知道今后还会想靠得更近，仍可能因得不到而疼，却不把疼痛变成否认或催促。",
     "key": "疼痛中不否认也不催促",
     "kind": "",
     "key_model": "因得不到而疼"
    },
    {
     "id": "I72",
     "text": "他愿继续把这个人放在心里，认真地喜欢，尽情欢喜，也接纳无法替对方决定的部分。",
     "key": "尽情喜欢尊重对方心意",
     "kind": "",
     "key_model": "认真地喜欢"
    },
    {
     "id": "I73",
     "text": "即使没有得到想要的一切，他仍可以盼着被爱而不强求，也能尊重对方而不收回心意。",
     "key": "盼爱不强求不收回心意",
     "kind": "分清",
     "key_model": "不收回心意"
    }
   ],
