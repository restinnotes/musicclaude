dden_imports\": [\n          \"把追回或抓回某件具体物品写成已经发生的实际动作。\"\n        ],\n        \"confidence\": \"高\"\n      }\n    ],\n    \"compatible_bundle\": [\n      \"【感受】【原记录主体验】温柔、安宁，戒备暂时松开。\",\n      \"【感受】【原记录补充侧面】压抑的愿望、委屈和思念逐渐获得表达空间。\",\n      \"【期待顾虑】【原记录补充侧面】怀抱真实愿望，却不确定能否获得回应。\",\n      \"【行动倾向】逐渐愿意表达内心感受，但仍然留有未完成感。\",\n      \"【关系姿态】【原记录另一种理解】对无法挽回的珍爱之物保持温柔，不急于强求。\"\n    ],\n    \"tensions\": []\n  },\n  \"S07\": {\n    \"beads\": [\n      {\n        \"bead_id\": \"S07-B1\",\n        \"qualities\": [\n          \"【感受】【原记录主体验】突如其来的寒意与惊悸，身体警觉骤然升高。\",\n          \"【时间变化】【原记录主体验】原有的安宁被突然打断，身体先于意识出现强烈警觉。\"\n        ],\n        \"temporal_shape\": \"182附近，原有的安宁突然破裂，身体先于意识出现寒意和惊悸，进入高度警觉状态。\",\n        \"forbidden_imports\": [\n          \"被寒风吹开窗户、从甜梦中被外力拽醒的具体情节。\"\n        ],\n        \"confidence\": \"高\"\n      },\n      {\n        \"bead_id\": \"S07-B2\",\n        \"qualities\": [\n          \"【注意力】原本深沉、持续的思绪被突如其来的转向截断，注意力转向别处。\",\n          \"【感受】外在状态虽然发生鲜明变化，内心却未因此安定下来。\"\n        ],\n        \"temporal_shape\": \"先是深沉、近乎祈愿的内在状态，随后注意力突然转向别处，原先的思绪被中断。\",\n        \"forbidden_imports\": [\n          \"把突然的转向写成实际更换地点、场景或开始跳舞的事件。\"\n        ],\n        \"confidence\": \"高\"\n      },\n      {\n        \"bead_id\": \"S07-B3\",\n        \"qualities\": [\n          \"【时间变化】紧张感逐渐累积，难以平复。\",\n          \"【注意力】思绪持续翻转，难以主动停止。\",\n          \"【行动倾向】想摆脱当前状态，却感到找不到真正可行的出口。\"\n        ],\n        \"temporal_shape\": \"198–205：紧张逐层累积，思绪持续翻转，原有的不安始终没有完全平复。\",\n        \"forbidden_imports\": [\n          \"把想要冲出去写成已经发生的实际动作或已经找到出口的具体事件。\"\n        ],\n        \"confidence\": \"高\"\n      },\n      {\n        \"bead_id\": \"S07-B4\",\n        \"qualities\": [\n          \"【感受】【原记录另一种理解】熟悉的坚定感似乎重新出现，却不再完整、鲜明，也不足以带来稳定感。\"\n        ],\n        \"temporal_shape\": \"\",\n        \"forbidden_imports\": [\n          \"把重新站直、重新找回旧日自我写成已经发生的连续情节。\"\n        ],\n        \"confidence\": \"高\"\n      },\n      {\n        \"bead_id\": \"S07-B5\",\n        \"qualities\": [\n          \"【注意力】【原记录补充侧面】熟悉的日常细节突然进入意识，打断原本深沉的思绪。\",\n          \"【感受】【原记录补充侧面】亲切感反而加深对失去之物的意识与失落。\"\n        ],\n        \"temporal_shape\": \"\",\n        \"forbidden_imports\": [\n          \"把某个熟悉动作、一次舞蹈或某段日常生活写成已经确认发生的具体事件。\"\n        ],\n        \"confidence\": \"高\"\n      }\n    ],\n    \"compatible_bundle\": [\n      \"【感受】【原记录主体验】原有安宁突然被打断，身体出现强烈惊悸和警觉。\",\n      \"【时间变化】突发的紧张逐渐累积，之后仍然难以平复。\",\n      \"【注意力】熟悉的生活细节突然进入意识，打断原有思绪。\",\n      \"【感受】【原记录补充侧面】亲切感反而加深失去感与失落。\"\n    ],\n    \"tensions\": [\n      \"涉及 S07-B2 与 S07-B4：B2 将这一阶段理解为原有思绪被突然打断，注意力转向一个不同的方向；B4 则将其理解为熟悉的坚定感重新显现，但这种熟悉感已经无法恢复原有的稳定秩序。前者侧重突兀的中断与转向，后者侧重熟悉感的重新出现，两种材料辨认不能合并成同一个确定解释。\"\n    ]\n  },\n  \"S08\": {\n    \"beads\": [\n      {\n        \"bead_id\": \"S08-B1\",\n        \"qualities\": [\n          \"【感受】【原记录主体验】熟悉的柔软与安静短暂重新浮现。\",\n          \"【注意力】【原记录主体验】重新进入沉思、近乎祈求的内在状态。\"\n        ],\n        \"temporal_shape\": \"\",\n        \"forbidden_imports\": [],\n        \"confidence\": \"高\"\n      },\n      {\n        \"bead_id\": \"S08-B2\",\n        \"qualities\": [\n          \"【感受】【原记录补充侧面】温柔与不舍同时存在。\",\n          \"【期待顾虑】【原记录补充侧面】意识到这份安静停留短暂，尚未来得及安顿便可能再次失去。\"\n        ],\n        \"temporal_shape\": \"安静感刚刚重新出现便迅速退去，尚未来得及形成新的稳定状态。\",\n        \"forbidden_imports\": [\n          \"临别时实际离开、回头再看一眼某处的动作和情节。\"\n        ],\n        \"confidence\": \"高\"\n      },\n      {\n        \"bead_id\": \"S08-B3\",\n        \"qualities\": [\n          \"【感受】【原记录补充侧面】激烈思绪之间出现短暂的松弛与喘息感。\",\n          \"【感受】【原记录补充侧面】这份缓解不足以使整体重新安定。\"\n        ],\n        \"temporal_shape\": \"在激烈思绪之间短暂出现缓解，随后仍未发展为持续、完整的安定。\",\n        \"forbidden_imports\": [\n          \"把短暂喘息感写成已经发生的实际深吸一口气的动作。\"\n        ],\n        \"confidence\": \"高\"\n      }\n    ],\n    \"compatible_bundle\": [\n      \"【感受】【原记录主体验】熟悉的柔软与安静重新浮现。\",\n      \"【感受】【原记录补充侧面】短暂缓解中同时存在温柔、不舍与失落。\",\n      \"【期待顾虑】【原记录补充侧面】担心这份安静很快再次消失，尚未获得充分安顿。\",\n      \"【感受】【原记录补充侧面】短暂松弛并不意味着整体紧张已经解除。\"\n    ],\n    \"tensions\": []\n  },\n  \"S09\": {\n    \"beads\": [\n      {\n        \"bead_id\": \"S09-B1\",\n        \"qualities\": [\n          \"【感受】【原记录主体验】熟悉的沉重感以更阴冷、缺少郑重感的方式重新浮现。\",\n          \"【时间变化】【原记录主体验】短暂获得稳定感后，很快再次失去稳定。\",\n          \"【期待顾虑】【原记录主体验】原先未解的问题再次显现，但继续行动的方向尚未形成。\"\n        ],\n        \"temporal_shape\": \"先短暂恢复稳定感，随后再次失稳；真正明确的前进意愿尚未聚拢。\",\n        \"forbidden_imports\": [],\n        \"confidence\": \"高\"\n      },\n      {\n        \"bead_id\": \"S09-B2\",\n        \"qualities\": [\n          \"【感受】【原记录补充侧面】对曾经无措的自我重新产生理解，知道其经历过什么。\",\n          \"【注意力】【原记录补充侧面】最初未解的问题再次占据注意力，但仍然没有简单答案。\"\n        ],\n        \"temporal_shape\": \"\",\n        \"forbidden_imports\": [\n          \"把重新遇见过去的自己写成与另一个人真实相遇的事件。\"\n        ],\n        \"confidence\": \"高\"\n      },\n      {\n        \"bead_id\": \"S09-B3\",\n        \"qualities\": [\n          \"【感受】若突发刺激格外突出，会产生短促的惊跳与警觉。\",\n          \"【时间变化】惊跳很快退去，原有的荒凉感重新显现。\"\n        ],\n        \"temporal_shape\": \"在突发刺激被明显强化的条件下，先出现短促惊跳，随后力量感迅速退去。\",\n        \"forbidden_imports\": [],\n        \"confidence\": \"高\"\n      }\n    ],\n    \"compatible_bundle\": [\n      \"【感受】【原记录主体验】熟悉的沉重与未解感再次浮现，却缺少最初的郑重与稳定。\",\n      \"【注意力】【原记录补充侧面】重新回到最初未解的问题，但仍然无法获得简单答案。\",\n      \"【感受】【原记录补充侧面】对过去无措的自我多了一层理解。\"\n    ],\n    \"tensions\": []\n  },\n  \"S10\": {\n    \"beads\": [\n      {\n        \"bead_id\": \"S10-B1\",\n        \"qualities\": [\n          \"【注意力】【原记录主体验】熟悉的体验仅以零散片段浮现，难以重新形成完整理解。\",\n          \"【感受】【原记录主体验】熟悉感仍然存在，却伴随残缺与不连贯。\"\n        ],\n        \"temporal_shape\": \"\",\n        \"forbidden_imports\": [],\n        \"confidence\": \"高\"\n      },\n      {\n        \"bead_id\": \"S10-B2\",\n        \"qualities\": [\n          \"【感受】【原记录补充侧面】身体感到失去着落、悬而不定。\",\n          \"【注意力】【原记录补充侧面】暂时无法辨清方向，缺少明确的内在定位。\"\n        ],\n        \"temporal_shape\": \"\",\n        \"forbidden_imports\": [],\n        \"confidence\": \"高\"\n      },\n      {\n        \"bead_id\": \"S10-B3\",\n        \"qualities\": [\n          \"【注意力】【原记录另一种理解】重新审视如何继续生活这一未解的问题。\",\n          \"【感受】【原记录另一种理解】经历许多之后