     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "66–91",
   "relation": "正在面对",
   "items": [
    {
     "id": "I25",
     "text": "先前的委屈使他更觉强硬痛快。",
     "key": "强硬痛快",
     "kind": ""
    },
    {
     "id": "I26",
     "text": "他舍不得松开这股向前的力量。",
     "key": "舍不得松开",
     "kind": ""
    },
    {
     "id": "I27",
     "text": "他觉得精神昂扬时，期待好像追不上他。",
     "key": "好像追不上",
     "kind": ""
    },
    {
     "id": "I28",
     "text": "他渐渐急于维持这份畅快。",
     "key": "维持这份畅快",
     "kind": ""
    },
    {
     "id": "I29",
     "text": "旧日亲近刚浮现，他就立刻抵住。",
     "key": "立刻抵住",
     "kind": ""
    },
    {
     "id": "I30",
     "text": "他其实仍在乎那份亲近。",
     "key": "仍在乎",
     "kind": ""
    },
    {
     "id": "I31",
     "text": "他仿佛害怕片刻柔软会让自己重新乞求。",
     "key": "重新乞求",
     "kind": ""
    },
    {
     "id": "I32",
     "text": "他因此不敢有片刻示弱。",
     "key": "片刻示弱",
     "kind": ""
    },
    {
     "id": "I33",
     "text": "他开始感到持续强硬让自己不能放松。",
     "key": "不能放松",
     "kind": "办法的限度"
    },
    {
     "id": "I34",
     "text": "他仍会为自己的强盛振奋。",
     "key": "强盛振奋",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I15",
     "to": "I25",
     "rel": "提供理由"
    },
