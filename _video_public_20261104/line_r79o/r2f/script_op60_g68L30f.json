       "keys": [
        "怕太急弄坏眼下的自在"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "两个人待在一起这么舒服，他几乎想就这样放松地漂着",
       "keys": [
        "就这样放松地漂着"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可时间仍往前，还没分开就先有一点舍不得",
       "keys": [
        "先有一点舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "人在船上舒服地漂着不急着靠岸，水和时间却一直在走",
