{
 "center": "维持尊严的行动与对旧日生活及归属的怀念反复拉扯",
 "segments": [
  {
   "bars": "1–23",
   "relation": "还说不清",
   "items": [
    {
     "id": "I1",
     "text": "起初他不觉得自己在怀念什么。",
     "key": "怀念什么",
     "kind": ""
    },
    {
     "id": "I2",
     "text": "他心里总有说不出的不踏实。",
     "key": "不踏实",
     "kind": ""
    },
    {
     "id": "I3",
     "text": "他曾经相信自己有一个位置。",
     "key": "有一个位置",
     "kind": ""
    },
    {
     "id": "I4",
     "text": "他那时不必费力解释自己。",
     "key": "解释自己",
     "kind": ""
    },
    {
     "id": "I5",
     "text": "他那时不必小心衡量自己的心意。",
     "key": "衡量自己的心意",
     "kind": ""
    },
    {
     "id": "I6",
     "text": "如今他已没有那份自然的确信。",
     "key": "自然的确信",
     "kind": ""
    },
    {
     "id": "I7",
     "text": "他仍不由自主地期待那份亲近。",
     "key": "不由自主",
     "kind": ""
    },
    {
     "id": "I8",
     "text": "期待落空时，他先感到难堪。",
     "key": "期待落空",
     "kind": ""
    },
    {
     "id": "I9",
     "text": "他仿佛觉得承认仍在等就显得可怜。",
     "key": "显得可怜",
     "kind": ""
    },
    {
     "id": "I10",
     "text": "他羞于承认的期待仍未消失。",
     "key": "期待仍未消失",
     "kind": ""
    },
    {
     "id": "I11",
     "text": "他不能安心等，也不能真的不等。",
     "key": "不能安心等",
     "kind": ""
    }
   ],
   "because": []
  },
  {
   "bars": "24–65",
   "relation": "正在面对",
   "items": [
    {
     "id": "I12",
     "text": "他最受不了自己还需要回应。",
     "key": "需要回应",
     "kind": ""
    },
    {
     "id": "I13",
     "text": "他觉得旧日亲近如今似乎得伸手求。",
     "key": "似乎得伸手求",
     "kind": ""
    },
    {
     "id": "I14",
     "text": "一想到伸手去求，他就觉得受辱。",
     "key": "觉得受辱",
     "kind": ""
    },
    {
     "id": "I15",
     "text": "他的难堪渐渐变成不甘。",
     "key": "变成不甘",
     "kind": ""
    },
    {
     "id": "I16",
     "text": "他不愿再靠别人的接纳才能安心。",
     "key": "别人的接纳",
     "kind": ""
    },
    {
     "id": "I17",
     "text": "他不愿把自己的分量交给别人决定。",
     "key": "分量交给别人",
     "kind": ""
    },
    {
     "id": "I18",
     "text": "他不再顺着牵挂向别人伸手。",
     "key": "不再顺着牵挂",
     "kind": ""
    },
    {
     "id": "I19",
     "text": "他试着凭自己的力量向前。",
     "key": "凭自己的力量",
     "kind": ""
    },
    {
     "id": "I20",
     "text": "他因不再围着缺少的东西打转而畅快。",
     "key": "缺少的东西",
     "kind": ""
    },
    {
     "id": "I21",
     "text": "他喜欢不必讨人准许的强硬。",
     "key": "讨人准许",
     "kind": ""
    },
    {
     "id": "I22",
     "text": "他心里仍有旧日牵挂。",
     "key": "旧日牵挂",
     "kind": ""
    },
    {
     "id": "I23",
     "text": "他仿佛感到先前的屈辱减轻了。",
     "key": "屈辱减轻",
     "kind": ""
    },
    {
     "id": "I24",
     "text": "他第一次觉得失去亲近也能保住自己。",
     "key": "保住自己",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I7",
     "to": "I12",
     "rel": "仍在起作用"
    },
    {
     "from": "I6",
