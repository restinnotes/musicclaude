   "items_before_fix": [
    {
     "id": "I76",
     "text": "带着这份仍未平息的牵挂，他渐渐不再要求自己找到一种不会受伤的爱法。",
     "key": "不再寻找无伤爱法",
     "kind": ""
    },
    {
     "id": "I77",
     "text": "他仍想被选择，因为对方重要，也盼两人彼此亲近，即使未必如愿也不假装没有这愿望。",
     "key": "仍想被选也不否认",
     "kind": ""
    },
    {
     "id": "I78",
     "text": "他喜欢得很深，也仍舍不得放弃克制，因为对方有自己的心意，不必与他相同。",
     "key": "克制出于珍惜自由",
     "kind": "分清"
    },
    {
     "id": "I79",
     "text": "若为安心要求对方承担全部期待，他盼望的亲近也会失去自在。",
     "key": "要求期待会损害自在",
     "kind": "选择的代价",
     "follows": true
    },
    {
     "id": "I80",
     "text": "他仍会遗憾，却不再觉得必须消灭遗憾才能好好爱一个人。",
     "key": "遗憾无需先被消灭",
     "kind": "",
     "follows": true
    },
    {
     "id": "I81",
     "text": "小心亲近、不求确认地付出、独自珍藏和尽情欢欣，都曾给他真实的幸福。",
     "key": "几种快乐都真实",
     "kind": "",
     "follows": true
    },
    {
     "id": "I82",
     "text": "这些快乐虽没解决最后的问题，却没有白费，还让他一再向前、看清对方重要。",
     "key": "快乐没有白费",
     "kind": "",
     "follows": true
    },
    {
     "id": "I83",
     "text": "他曾努力收住，也曾尽情投入，因此知道两种办法都不能免去爱人的风险。",
     "key": "两种办法都无法免险",
     "kind": "办法的限度",
     "follows": true
    },
    {
     "id": "I84",
     "text": "他仍盼回应，也偶尔收住心意，却不再用回应有无判断真心，也不拿克制多少证明清醒。",
     "key": "不以回应或克制自证",
     "kind": "",
     "follows": true
    },
    {
     "id": "I85",
     "text": "他知道以后仍可能失望，也会因不能更近一步而感到疼痛。",
     "key": "知道以后仍会疼痛",
     "kind": ""
    },
    {
     "id": "I86",
     "text": "这些疼痛不必让他否认感情，也不必成为催促对方的理由。",
     "key": "疼痛不该否认或催促",
     "kind": "",
     "follows": true
    },
    {
     "id": "I87",
     "text": "他愿继续把对方放在心里，认真喜欢、充分欢喜，也承受无法决定的部分。",
     "key": "继续认真喜欢和欢喜",
     "kind": "",
     "follows": true
    },
    {
     "id": "I88",
     "text": "他可以渴望被爱而不把渴望变成对方的义务，也能珍惜对方自由而不收回自己的心。",
     "key": "渴望与自由能够并存",
     "kind": "",
     "follows": true
    },
    {
     "id": "I89",
     "text": "他没有得到想要的一切，却不再为了保护彼此而先放弃最想给予的爱。",
     "key": "未得一切仍继续爱",
     "kind": "",
     "follows": true
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对",
   "items_before_reorg": [
    {
     "id": "N78",
     "text": "带着仍没平息的牵挂，他渐渐不再逼自己找出一种绝不会受伤的爱法。",
     "from": [
      "I76"
     ],
     "key": "",
     "kind": "",
     "follows": false
    },
    {
     "id": "N79",
     "text": "他还是想被选择：因为这个人重要，他真心盼两人彼此亲近，即使未必如愿。",
     "from": [
      "I77"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N80",
     "text": "也正因为喜欢得深，他舍不得放弃克制；对方有自己的心意，不必和他一样。",
     "from": [
      "I78"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N81",
     "text": "若为求安心就要对方接住全部期待，这份亲近反而会失去原有的自在。",
     "from": [
      "I79"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N82",
     "text": "遗憾还会有，但他不再认为非得先消灭遗憾，才能好好喜欢一个人。",
     "from": [
      "I80"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N83",
     "text": "小心靠近、不求对方确认地付出、独自珍藏，以及尽情欢喜，都曾给他真切的快乐。",
     "from": [
      "I81"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N84",
     "text": "这些快乐没解开最后的难题，却没有白费；它们让他一次次愿意靠近，也看清对方有多重要。",
     "from": [
      "I82"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N85",
     "text": "他试过收住，也试过尽情投入，终于明白哪种做法都不能让爱一个人毫无风险。",
     "from": [
      "I83"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N86",
     "text": "他仍盼对方也喜欢自己，偶尔也收住心意；却不再拿对方的选择判真心，也不拿克制证明清醒。",
     "from": [
      "I84"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N87",
     "text": "往后他仍可能失望、想要更多，也会因不能更近一步而疼；没人能保证未来。",
     "from": [
      "I85"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N88",
     "text": "这些愿望和疼痛，不再成为他否认感情或催促对方的理由。",
     "from": [
      "I86"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N89",
     "text": "他愿继续认真喜欢、尽情欢喜，也接受有些事只能由对方决定。",
     "from": [
      "I87"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N90",
     "text": "他可以渴望被爱，却不把这份渴望变成对方的义务；珍惜对方的自由，也不必收回自己的心。",
     "from": [
      "I88"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N91",
     "text": "他没有得到想要的一切，却不再为了保护彼此，先放弃最想给出的爱。",
     "from": [
      "I89"
     ],
     "key": "",
     "kind": "",
     "follows": true
    }
   ]
  }
