  .er-cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 18px;
    border: 2px solid #0b1f44;
    border-radius: 9999px;
    color: #0b1f44;
    font-weight: 700;
    transition: background 0.2s ease;
  }
  .er-cta-pill:hover {
    background: #b9ddee;
  }
  .er-cta-icon {
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    border: 1px solid #cbd5e1;
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .er-report-cta-primary,
  .er-report-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 46px;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
    transition: all 0.2s ease;
  }
  .er-report-cta-primary {
    background: #1d4ed8;
    color: #fff;
    border: 1px solid #1d4ed8;
    box-shadow: 0 10px 24px rgba(29, 78, 216, 0.18);
  }
  .er-report-cta-primary:hover {
    background: #1e40af;
    border-color: #1e40af;
    color: #fff;
  }
  .er-report-cta-secondary {
    background: #fff;
    color: #1d4ed8;
    border: 1px solid #1d4ed8;
  }
  .er-report-cta-secondary:hover {
    background: #eff6ff;
    color: #1e40af;
    border-color: #1e40af;
  }
  .er-inline-cta {
    margin-top: 1.5rem;
    padding: 2rem 0 0;
    border-top: 1px solid #cbd5e1;
  }
  .er-inline-cta-copy {
    color: #111827;
    font-size: 1.125rem;
    line-height: 1.8;
    max-width: 38rem;
  }
  .logos-band {
    position: relative;
    overflow: hidden;
    background: #071825;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .logos-band::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 184, 212, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 184, 212, 0.025) 1px, transparent 1px);
    background-size: 52px 52px;
    pointer-events: none;
    z-index: 0;
  }
  .logos-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #071825 0%, transparent 11%, transparent 89%, #071825 100%);
    pointer-events: none;
    z-index: 10;
  }
  .logos-hdr {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 22px 48px 6px;
  }
  .logos-hdr-line {
    flex: 1;
    max-width: 90px;
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
  }
  .logos-hdr-label,
  .logos-hdr-count {
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .logos-hdr-label {
    color: rgba(255, 255, 255, 0.25);
  }
  .logos-hdr-count {
    color: rgba(0, 184, 212, 0.45);
  }
  .logos-row {
    position: relative;
    z-index: 2;
    overflow: hidden;
    padding: 14px 0;
  }
  .logos-row.row2 {
    padding-top: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }
  .logos-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: logosScrollR 50s linear infinite;
  }
  .logos-track.rev {
    animation: logosScrollL 65s linear infinite;
  }
  .logos-track:hover {
    animation-play-state: paused;
  }
  .logo-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 64px;
    padding: 0 36px;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
  }
  .logo-item img {
    display: block;
    max-height: 26px;
    width: auto;
    object-fit: contain;
  }
  .logos-proof {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: 4px 48px 18px;
  }
  .lp-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 20px;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.2);
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .lp-item:last-child {
    border-right: none;
  }
  .lp-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #00b8d4;
    opacity: 0.5;
    flex-shrink: 0;
  }
  .img-fluid,
  .rdPageImg {
    max-width: 100%;
    height: auto;
  }
  .mck-article {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .mck-article table {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .rd-table-scroll {
    width: 100%;
    max-width: 100%;
    margin: 10px 0 16px;
    display: block;
    overflow-x: auto;
    overflow-y: hidden;
    border: 1px solid #d8e2ec;
    border-radius: 12px;
    background: #ffffff;
    -webkit-overflow-scrolling: touch;
  }
  .rd-table-scroll table {
    margin: 0;
    border: 0 !important;
  }
  @media (min-width: 768px) {
    .report-prose .rd-table-scroll,
    .mck-article .rd-table-scroll {
      overflow-x: visible;
    }

    .report-prose .rd-table-scroll table,
    .mck-article .rd-table-scroll table,
    .report-prose table.rd-table--mobile-cards,
    .mck-article table.rd-table--mobile-cards {
      display: table;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      table-layout: fixed;
      border-collapse: collapse;
    }

    .report-prose table.rd-table--mobile-cards tbody,
    .report-prose table.rd-table--mobile-cards thead,
    .report-prose table.rd-table--mobile-cards tr,
    .mck-article table.rd-table--mobile-cards tbody,
    .mck-article table.rd-table--mobile-cards thead,
    .mck-article table.rd-table--mobile-cards tr {
      display: table-row-group;
    }

    .report-prose table.rd-table--mobile-cards thead,
    .mck-article table.rd-table--mobile-cards thead {
      display: table-header-group;
    }

    .report-prose table.rd-table--mobile-cards tr,
    .mck-article table.rd-table--mobile-cards tr {
      display: table-row;
    }

    .report-prose table.rd-table--mobile-cards th,
    .report-prose table.rd-table--mobile-cards td,
    .mck-article table.rd-table--mobile-cards th,
    .mck-article table.rd-table--mobile-cards td {
      display: table-cell;
      vertical-align: middle;
      word-break: normal;
      overflow-wrap: break-word;
      hyphens: none;
      white-space: normal;
    }

    .report-prose table.rd-table--cols-4 th:nth-child(1),
    .report-prose table.rd-table--cols-4 td:nth-child(1),
    .mck-article table.rd-table--cols-4 th:nth-child(1),
    .mck-article table.rd-table--cols-4 td:nth-child(1) { width: 30%; }
    .report-prose table.rd-table--cols-4 th:nth-child(2),
    .report-prose table.rd-table--cols-4 td:nth-child(2),
    .mck-article table.rd-table--cols-4 th:nth-child(2),
    .mck-article table.rd-table--cols-4 td:nth-child(2) { width: 18%; }
    .report-prose table.rd-table--cols-4 th:nth-child(3),
    .report-prose table.rd-table--cols-4 td:nth-child(3),
    .mck-article table.rd-table--cols-4 th:nth-child(3),
    .mck-article table.rd-table--cols-4 td:nth-child(3) { width: 16%; }
    .report-prose table.rd-table--cols-4 th:nth-child(4),
    .report-prose table.rd-table--cols-4 td:nth-child(4),
    .mck-article table.rd-table--cols-4 th:nth-child(4),
    .mck-article table.rd-table--cols-4 td:nth-child(4) { width: 36%; }
  }
  .mck-article iframe,
  .mck-article video {
    max-width: 100%;
  }
  h3 {
    padding: 10px 0;
    font-size: 15px;
    font-weight: 700;
  }
  h2.text-xl.font-extrabold.text-gray-900 {
    color: #163781;
  }
  table tbody tr { background: #e8faff; }
  table tbody tr:nth-child(odd) { background: #fff; }
  table tbody tr:nth-child(1) {
    background: linear-gradient(60deg, #3297b1 0%, #1d2746 100%);
