   "notes": [],
   "revised": false
  },
  "S04": {
   "edit": {
    "items": [
     {
      "id": "S04-1",
      "text": "他发现真心盼对方好、关心和给予本身也能让自己快乐，便暂时不再惦记自己是否特别。",
      "key": "关心和给予",
      "follows": false,
      "causes": [
       "c1"
      ]
     },
     {
      "id": "S04-2",
      "text": "他把不索取回应带来的轻松误当成亲近不会失去的保证，因此更敢把心意给出去。",
      "key": "轻松误当成保证",
      "follows": true,
      "causes": [
       "c1"
      ]
     },
     {
      "id": "S04-3",
      "text": "他想更深地表达心意，却怕热切会变成催促，便收住了表达。",
      "key": "热切会变成催促",
      "follows": false,
      "causes": [
