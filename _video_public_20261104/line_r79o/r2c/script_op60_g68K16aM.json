     "beads": []
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他顾不上对方是否在乎自己，把能给的都给对方，希望对方安心；像被卷进比自己更大的世界，连“我”都暂时退到后面。",
       "keys": [
        "把能给的都给对方",
        "比自己更大的世界"
