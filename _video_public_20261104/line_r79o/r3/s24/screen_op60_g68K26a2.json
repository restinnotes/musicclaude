     "bars": "72–77",
     "from": [
      "S09-B2"
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "rows": [
    {
     "kind": "line",
     "text": "他不再猜往后怎样，先享受眼前亲近",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S10-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "清风拨开水浪，时间短暂松开",
