p\": \"熟悉的亲近感又回来了\"\n        },\n        {\n          \"text\": \"他想把心意全说出来\",\n          \"point\": \"把心意全说出来\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"也盼着对方能喜欢坦白心意的自己\"\n        },\n        {\n          \"text\": \"他想把眼下的好留久些\",\n          \"point\": \"说多了又怕让对方为难\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"失去自在\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"原来一直托着你的水波和摇晃，忽然像被抽掉了\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份幸福是真实的吗？它能维持多久？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"刚才那阵想攥紧不放的冲动，终于轻轻退了下去\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方一直没退开\",\n          \"point\": \"终于没藏住喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方一直没退开\"\n        },\n        {\n          \"text\": \"对方看出他有多在乎\",\n          \"point\": \"反倒空落落的\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"还怕自己太黏\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"不再努力显得完整\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"每个心里角落\"\n        },\n        {\n          \"quote\": \"不是感官欲望退潮，而是一种更贴身的沉醉\",\n          \"carrier\": \"连接转折\",\n          \"screen\":