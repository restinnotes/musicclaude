"at\": 22\n        },\n        {\n          \"text\": \"早知道这样他还会走吗？\",\n          \"accent\": \"还会走吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-2\"],\n          \"at\": 34\n        },\n        {\n          \"text\": \"他想找回亲近又不愿再受委屈\",\n          \"accent\": \"不愿再受委屈\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\"],\n          \"at\": 48\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"后颈发凉脉搏也猛地跳起来\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\",\n          \"at\": 0\n        },\n        {\n          \"text\": \"舞步闯入却没让心安定\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182–197\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"事情像过去了心里却还没相信\",\n          \"after\": 1,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"心里有东西颤着却找不到出口\",\n          \"after\": 1,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"越熟悉越看清自己失去了什么\",\n          \"after\": 2,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181–205\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"连当初离开的决心也找不回\",\n          \"after\": 4,\n          \"from\": [\"S07-3\"],\n          \"bars\": \"\",\n          \"at\": 48\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高处忽然浮出一串细长颤音\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\"\n        },\n        {\n          \"text\": \"细长颤音像寒风吹开紧闭的窗\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\"\n        },\n        {\n          \"text\": \"舞步突然闯入截断祈祷般的静谧\",\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"连续颤音一层层把紧张堆高\",\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\"\n        },\n        {\n          \"text\": \"熟悉动作和舞步突然闯进来\",\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181–205\"\n        },\n        {\n          \"text\": \"熟悉舞步再次出现却不再完整鲜明\",\n          \"from\": [\"S07-B5\"],\n          \"bars\": \"182–197\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"他先把回去的事放一边\",\n          \"accent\": \"放一边\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起被当作自己人心里暖了\",\n          \"accent\": \"心里暖了\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\", \"S08-B1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"可这点暖意没让他想回头\",\n          \"accent\": \"没让他想回头\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"暖意淡了回忆陪不了他\",\n          \"accent\": \"陪不了他\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-2\", \"S08-B2\", \"S08-B3\"],\n          \"at\": 13\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像心里熟悉的柔软处重新打开\",\n          \"after\": 1,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"206–213\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"像临走前忍不住回头再看一眼\",\n          \"after\": 2,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"206–213\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"那一眼里有温柔也有不舍\",\n          \"after\": 2,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"206–213\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"胸口忽然吸进一口气\",\n          \"after\": 3,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"206–213\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"只是瞬间喘息并没安顿下来\",\n          \"after\": 3,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"206–213\",\n          \"at\": 13\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"宽广缓慢的歌唱短暂回来又退去\",\n          \"from\": [\"S08-B1\", \"S08-B2\"],\n          \"bars\": \"206–213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他忽然说不清想回去为什么\",\n          \"accent\": \"说不清\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-1\", \"S09-B2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"是舍不得被当作自己人\",\n          \"accent\": \"自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S09-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"还是怕孤单到连那些气也肯受？\",\n          \"accent\": \"连那些气也肯受\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S09-1\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"这念头让他心慌不敢再想\",\n          \"accent\": \"不敢再想\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-2\"],\n          \"at\": 22\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从另一面重新看见同一扇门\",\n          \"after\": 0,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\",\n          \"at\": 0\n        },\n        {\n          \"text\": \"像又遇见那个不知怎么办的自己\",\n          \"after\": 0,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–215\",\n          \"at\": 0\n        },\n        {\n          \"text\": \"这次他知道过去的自己经历过什么\",\n          \"after\": 3,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–215\",\n          \"at\": 22\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"巨大颤音光晕里引子阴冷闪回\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\"\n        },\n        {\n          \"text\": \"声音短暂落稳又向高处漂去\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他最舍不得有人把他当自己人\",\n          \"accent\": \"当自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可回去还能像从前那样吗？\",\n          \"accent\": \"还能像从前那样吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-1\", \"S10-B1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"当初那些委屈不能当没发生\",\n          \"accent\": \"不能当没发生\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"光凭舍不得他还是不敢回去\",\n          \"accent\": \"不敢回去\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-2\"],\n          \"at\": 16\n        },\n        {\n          \"text\": \"他想得很累眼下也过不踏实\",\n          \"accent\": \"过不踏实\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S10-3\", \"S10-B3\", \"S10-B4\"],\n          \"at\": 22\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从前歌唱留下的碎片\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216–225\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"也像舞曲主题散落的残片\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216–225\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"又像那首摇篮曲破碎地回来\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216–225\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"像忽然失重悬在半空\",\n          \"after\": 4,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"221–225\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"他问自己究竟怎样继续生活\",\n          \"after\": 4,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"216–225\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"那段往事重要却已无力重讲\",\n          \"after\": 4,\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"216–225\",\n          \"at\": 22\n        }\n      ],\n      \"notes\": []\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他知道回去未必找得回亲近\",\n          \"accent\": \"未必找得回亲近\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可他仍忍不住想万一能呢？\",\n          \"accent\": \"万一能呢\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S11-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他不愿只凭希望回去忍让\",\n          \"accent\": \"不愿\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"他想先把眼下日子过稳些\",\n          \"accent\": \"过稳些\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-3\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他仍怕独自扛事却不收回打算\",\n          \"accent\": \"不收回打算\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-4\", \"S11-B3\"],\n          \"at\": 17\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"每次爆发后压力又重新压来\",\n          \"after\": 4,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226–237\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"像困在绝境里一次次顶住\",\n          \"after\": 4,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226–237\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"柔软的祈祷开始变成意志\",\n          \"after\": 3,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"226–241\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"害怕还在脚却已经往前走\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"226–241\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"紧张未解停滞却松开一点\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"226–241\",\n          \"at\": 17\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"低沉音浪一阵阵涌起\",\n          \"from\":