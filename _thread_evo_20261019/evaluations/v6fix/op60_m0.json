   {
    "sec": "S10",
    "bars": "78–83",
    "relation": "正在面对",
    "items": [
     {
      "id": "I77",
      "text": "无措让他对那个人生出柔软的疼惜",
      "key": "柔软的疼惜",
      "follows": null
     },
     {
      "id": "I78",
      "text": "他不愿让对方替他承担所有不安",
      "key": "承担所有不安",
      "follows": null
     },
     {
      "id": "I79",
      "text": "他喜欢对方有自己的心意",
      "key": "自己的心意",
      "follows": null
     },
     {
      "id": "I80",
      "text": "他舍不得让依恋束缚对方",
      "key": "依恋束缚对方",
      "follows": null
     },
     {
      "id": "I81",
      "text": "他不愿束缚对方，心里的眷恋却更深",
      "key": "眷恋却更深",
      "follows": null
     },
     {
      "id": "I82",
      "text": "他仍觉得亲近很甜，甜里带一点酸",
      "key": "甜里带一点酸",
      "follows": null
     },
     {
      "id": "I83",
      "text": "他也喜欢自己能这样爱着对方",
      "key": "这样爱着对方",
      "follows": null
     },
     {
      "id": "I84",
      "text": "他因美好不能由自己把握，不知疼惜该落向哪里",
      "key": "落向哪里",
      "follows": null
     }
    ],
