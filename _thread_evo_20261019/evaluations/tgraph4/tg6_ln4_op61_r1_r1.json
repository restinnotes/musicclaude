  {
   "bars": "116–147",
   "relation": "正在面对",
   "items": [
    {
     "id": "I44",
     "text": "他想起旧日的好，先感到久违的亲切。",
     "key": "久违的亲切",
     "kind": ""
    },
    {
     "id": "I45",
     "text": "他没有先感到自己所怕的软弱。",
     "key": "所怕的软弱",
     "kind": ""
    },
    {
     "id": "I46",
     "text": "他怀念曾被人接纳的安心。",
     "key": "被人接纳",
     "kind": ""
    },
    {
     "id": "I47",
     "text": "他更珍惜当时能自然信赖别人。",
     "key": "自然信赖",
     "kind": "分清"
    },
    {
     "id": "I48",
     "text": "他那时可以不吝惜自己的心意。",
     "key": "不吝惜",
     "kind": ""
    },
    {
     "id": "I49",
     "text": "他付出时不必先怕被轻慢。",
     "key": "怕被轻慢",
     "kind": ""
    },
    {
     "id": "I50",
     "text": "他那时不必时时证明自己值得被爱。",
     "key": "值得被爱",
     "kind": ""
    },
    {
     "id": "I51",
     "text": "他那时柔软热切，也不觉得低人一等。",
     "key": "低人一等",
     "kind": ""
    },
    {
     "id": "I52",
     "text": "他独自硬撑的紧绷淡了一些。",
     "key": "紧绷淡了一些",
     "kind": ""
    },
    {
     "id": "I53",
     "text": "他开始疼爱曾经那样生活的自己。",
     "key": "开始疼爱",
     "kind": ""
    }
   ],
