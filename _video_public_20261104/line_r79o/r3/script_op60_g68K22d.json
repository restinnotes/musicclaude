 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近这个人，心里一下热起来，连自己也有点意外。",
       "keys": [
        "那么想靠近",
        "心里一下热起来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方看出自己有多需要这份亲近，会觉得负担太重；像一句想了很久的话，明知说出口关系就会改变，到了嘴边还是先沉默几秒，只敢露出一点点喜欢。",
       "keys": [
        "负担太重",
        "一点点喜欢"
       ],
       "from": [
        "S01-2",
        "S01-B2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "只是这么一点亲近就让他觉得甜；下次能不能更坦白些，他还拿不准。",
       "keys": [
        "觉得甜",
        "更坦白些"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因为他露出在意就退开，仍愿意跟他亲近，他才渐渐放松下来。",
       "keys": [
        "没有因为他露出在意就退开",
        "渐渐放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两条声线贴得很近，像肩膀挨着肩膀，呼吸和体温都融在一处；夏末潮湿温热的风黏在皮肤上",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "像相识已久的人安静坐着，偶尔对视一眼，沉默也不让人紧张",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠得更近，一阵子喜欢得几乎藏不住，最后还是怕太急弄坏眼下的自在，硬把话收住了。",
       "keys": [
        "几乎藏不住",
        "收住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待在一起这么好，他却想到这样的时刻总会过去，还没分开就先有点舍不得。",
       "keys": [
        "总会过去",
        "先有点舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不去想两个人往后会怎样，只想舒服地待在这份亲近里；歌声渐渐退远，水波般的摇曳托着身体，沉默也很舒服，心却慢慢漂远。",
       "keys": [
        "舒服地待在这份亲近里",
        "沉默也很舒服"
       ],
       "from": [
        "S03-1",
        "S03-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像一句重要的话说完，人还留在余味里，有点陶醉，有点走神",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想说有多喜欢这样，也想问对方是不是一样；没想好怎么开口，念头就淡了。",
       "keys": [
        "有多喜欢这样",
        "对方是不是一样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他满心欢喜，也让他想起上回明明想告诉对方，却没有开口。",
       "keys": [
        "满心欢喜",
        "没有开口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像讲起一段往事，刚开始还能笑着说，讲着讲着语速变了；一句话说完，还忍不住折回来补上更多细节",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想把藏着的话全说出来，盼着对方也喜欢自己不再小心收着的样子；手仿佛不自觉握得更紧，想把当下抱牢，水面却跟着颠簸起来，船舱里的平衡也变得脆弱。",
       "keys": [
        "把藏着的话全说出来",
        "握得更紧"
       ],
       "from": [
        "S04-2",
        "S04-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "两道声线仍贴得很近，左手水波却一直向前，仿佛每一秒都在倒数；还没失去什么，就先舍不得",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他甚至盼着说出来能把眼下的好留得久一点；又怕一下说得太多让对方为难，连两个人原有的自在也弄丢，最后还是留了些话没说。",
       "keys": [
        "留得久一点",
        "留了些话没说"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "前几次他想说又收住，对方却一直愿意跟他亲近；这回他忘了藏喜欢，对方已经看出他有多在乎。",
       "keys": [
        "忘了藏喜欢",
        "看出他有多在乎"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "先前藏着时，他还能装作没那么在乎；如今心里空落落的，连怎么相处都拿不准，怕对方嫌自己太黏，连熟悉的亲近也像隔了一层。",
       "keys": [
        "心里空落落的",
        "隔了一层"
       ],
       "from": [
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这回对方看出他有多在乎，相处却一点没变，他才又能像从前那样自在地待着。",
       "keys": [
        "相处却一点没变",
        "自在地待着"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "安静时，他还想靠近，却怕自己要得太多；对方不知道他刚才多怕被嫌弃，他有点孤单。",
       "keys": [
        "还想靠近",
        "有点孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "旋律压低了声音，另一条声线不时回应、插话，又纠缠回来，像心里刚说了句「算了」，转眼又放不下；不是哭泣或崩溃，只是不再努力显得完整",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "白天明明和某个人相处得很好，独处时心头却泛酸；连最亲近的人，也陪不到心里的每个角落，美好时光恍惚间像已经成了回忆",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "像独自回想一段关系，气味、身体感觉、幻想、遗憾和快感一层层荡开，混在一起；舒服得让人失去方向",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他又忍不住想，对方一直没有退开，会不会也有一点舍不得结束这份亲近？",
       "keys": [
        "一直没有退开",
        "舍不得结束这份亲近"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起这些日子对方总愿意跟他待在一起，他渐渐觉得，也许对方有时也需要他，跟他在一起也能安心些。",
       "keys": [
        "也许对方有时也需要他",
        "安心些"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "独自回想一段关系，气味、身体感觉、幻想、遗憾和快感混在一起，带着一点情色的暖意；明知正被卷进去，却暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "美还在，时间却正在经过；这一刻纵然完美，也没法让它停住",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到两个人也许能互相依靠，他高兴得有点收不住，心里忽然一紧，却还想这样待着。",
       "keys": [
        "互相依靠",
        "心里忽然一紧"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他真盼着往后对方想找人陪时还会想到自己，自己也能一直陪在身边。",
       "keys": [
        "还会想到自己",
        "一直陪在身边"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "上回他无意间露了心意，这回见对方依然亲近，便想主动些，大大方方地回应。",
       "keys": [
        "依然亲近",
        "大大方方地回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声直接舒展，像意大利歌剧里的咏叹调；整个人不设防、不分析，歌句越唱越开，熟悉的摇荡轻轻催人往前",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "像重新碰到阳光和风，身体恢复弹性，带一点玩心，像轻快地调情、回应",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "这样想着，他连往后的日子都开始盼了，觉得两个人说不定还能这么好很久。",
       "keys": [
        "往后的日子都开始盼了",
        "这么好很久"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可眼下两个人都愿意亲近，以后未必还会这样，他心里没底。",
       "keys": [
        "以后未必还会这样",
        "心里没底"
       ],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": []
    }
   ]
