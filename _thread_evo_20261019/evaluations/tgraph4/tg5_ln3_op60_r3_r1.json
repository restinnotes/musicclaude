     "kind": ""
    },
    {
     "id": "I49",
     "text": "两个人再相爱，也各有无法由对方代替的感受。",
     "key": "无法代替",
     "kind": "办法的限度"
    },
    {
     "id": "I50",
     "text": "他没有责怪这点距离，却舍不得它留下，仍为它难过。",
     "key": "舍不得距离",
     "kind": ""
    }
   ],
