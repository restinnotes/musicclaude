 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "彼此是生活里最亲近的人",
       "keys": [
        "最亲近的人"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夏夜烟花缓缓飘落，又像刚踏上船板晃得一下失重",
