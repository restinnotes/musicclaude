{
 "graph": {
  "center": "亲密的幸福与留不住它的痛楚难以分开",
  "segments": [
   {
    "sec": "S01",
    "bars": "1–3",
    "relation": "还说不清",
    "items": [
     {
      "id": "I1",
      "text": "起初他还不知道自己盼望什么。",
      "key": "不知道",
      "follows": null
     },
     {
      "id": "I2",
      "text": "独自过得安稳的他如今觉得少了些什么。",
      "key": "少了些什么",
      "follows": null
     },
     {
      "id": "I3",
      "text": "他想靠近对方。",
      "key": "想靠近",
      "follows": null
     },
     {
      "id": "I4",
      "text": "他不敢确信心意会被接住。",
      "key": "不敢确信",
      "follows": null
     },
     {
      "id": "I5",
      "text": "这份没把握并未让他退缩。",
      "key": "没把握",
      "follows": null
     },
     {
      "id": "I6",
      "text": "想到也许能在对方面前不必小心，他就有些欢喜。",
      "key": "有些欢喜",
      "follows": null
     }
    ],
    "because": []
   },
   {
    "sec": "S02",
    "bars": "4–16",
    "relation": "没在想",
    "items": [
     {
      "id": "I7",
      "text": "他慢慢把心敞开一些。",
      "key": "敞开",
      "follows": null
     },
     {
      "id": "I8",
      "text": "对方真的接住了他。",
      "key": "接住了他",
      "follows": null
     },
     {
      "id": "I9",
      "text": "他原以为被理解前得先把自己讲明白。",
      "key": "讲明白",
      "follows": null
     },
     {
      "id": "I10",
      "text": "他原以为被喜欢就得藏起不讨喜的部分。",
      "key": "藏起",
      "follows": null
     },
     {
      "id": "I11",
      "text": "他发现不够好也能被亲近。",
      "key": "不够好",
      "follows": null
     },
     {
      "id": "I12",
      "text": "他发现柔软和迟疑没有令自己难堪。",
      "key": "柔软和迟疑",
      "follows": null
     },
     {
      "id": "I13",
      "text": "他觉得先前的冒险值得。",
      "key": "冒险值得",
      "follows": null
     },
     {
      "id": "I14",
      "text": "他愿意再多敞开一些。",
      "key": "再多敞开",
      "follows": null
     },
     {
      "id": "I15",
      "text": "每次不收住心意，他都更放松。",
      "key": "更放松",
      "follows": null
     },
     {
      "id": "I16",
      "text": "他享受自然做自己的舒畅。",
      "key": "自然做自己",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I3",
      "to": "I7",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I6",
      "to": "I7",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I4",
      "to": "I13",
      "rel": "改写",
      "how": ""
     }
    ]
   },
   {
    "sec": "S03",
    "bars": "17–23",
    "relation": "没在想",
    "items": [
     {
      "id": "I17",
      "text": "他开始有余力关心对方的快乐。",
      "key": "关心对方",
      "follows": null
     },
     {
      "id": "I18",
      "text": "他也想知道自己在对方心里多重要。",
      "key": "多重要",
      "follows": null
     },
     {
      "id": "I19",
      "text": "他希望对方在自己面前同样自在。",
      "key": "同样自在",
      "follows": null
     },
     {
      "id": "I20",
      "text": "他发现让对方幸福也使自己满足。",
      "key": "自己满足",
      "follows": null
     },
     {
      "id": "I21",
      "text": "他急着把得到的好也给对方。",
      "key": "给对方",
      "follows": null
     },
     {
      "id": "I22",
      "text": "付出没有令他委屈，反而使他丰足。",
      "key": "使他丰足",
      "follows": null
     },
     {
      "id": "I23",
      "text": "他终于不必总守着自己的需要。",
      "key": "自己的需要",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I11",
      "to": "I17",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I16",
      "to": "I19",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I8",
      "to": "I21",
      "rel": "唤起",
      "how": ""
     }
    ]
   },
   {
    "sec": "S04",
    "bars": "24–34",
    "relation": "没在想",
    "items": [
     {
      "id": "I24",
      "text": "他渐渐忘了最初的顾虑。",
      "key": "最初的顾虑",
      "follows": null
     },
     {
      "id": "I25",
      "text": "他不再查看彼此是否同样热切。",
      "key": "同样热切",
      "follows": null
     },
     {
      "id": "I26",
      "text": "他不再计算付出与得到的多少。",
      "key": "付出与得到",
      "follows": null
     },
     {
      "id": "I27",
      "text": "有时他甚至没觉得自己在追求幸福。",
      "key": "追求幸福",
      "follows": null
     },
     {
      "id": "I28",
      "text": "他能尽情喜欢，也坦然接受对方的喜欢。",
      "key": "坦然接受",
      "follows": null
     },
     {
      "id": "I29",
      "text": "他不再从每份亲近里寻找证明。",
      "key": "寻找证明",
      "follows": null
     },
     {
      "id": "I30",
      "text": "他开始喜欢亲近时不必刻意用力。",
      "key": "不必刻意",
      "follows": null
     },
     {
      "id": "I31",
      "text": "他喜欢心意自然流向对方的自己。",
      "key": "自然流向",
      "follows": null
     },
     {
      "id": "I32",
      "text": "他喜欢彼此不必费力的信任。",
      "key": "不必费力",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I8",
      "to": "I24",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I20",
      "to": "I25",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I22",
      "to": "I26",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I19",
      "to": "I28",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I15",
      "to": "I30",
      "rel": "说明",
      "how": ""
     }
    ]
   },
   {
    "sec": "S05",
    "bars": "35–39",
    "relation": "还说不清",
    "items": [
     {
      "id": "I33",
      "text": "他忽然有一点舍不得。",
      "key": "舍不得",
      "follows": null
     },
     {
      "id": "I34",
      "text": "那时他并没有失去什么。",
      "key": "没有失去",
      "follows": null
     },
     {
      "id": "I35",
      "text": "他也没有怀疑对方。",
      "key": "没有怀疑",
      "follows": null
     },
     {
      "id": "I36",
      "text": "快乐时他忽然想一直这样下去。",
      "key": "一直这样",
      "follows": null
     },
     {
      "id": "I37",
      "text": "这个念头让他短暂地发紧。",
      "key": "短暂地发紧",
      "follows": null
     },
     {
      "id": "I38",
      "text": "眼前的幸福随即安抚了他。",
      "key": "安抚",
      "follows": null
     },
     {
      "id": "I39",
      "text": "他还没把这点不安当成问题。",
      "key": "当成问题",
      "follows": null
     },
     {
      "id": "I40",
      "text": "他以为舍不得只是因为太喜欢这一切。",
      "key": "太喜欢",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I27",
      "to": "I33",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I32",
      "to": "I36",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I8",
      "to": "I35",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I28",
      "to": "I38",
      "rel": "提供理由",
      "how": ""
     }
    ]
   },
   {
    "sec": "S06",
    "bars": "40–50",
    "relation": "还说不清",
    "items": [
     {
      "id": "I41",
      "text": "他不愿让舍不得搅扰快乐。",
      "key": "搅扰快乐",
      "follows": null
     },
     {
      "id": "I42",
      "text": "他转而更用心珍惜眼前的亲近。",
      "key": "用心珍惜",
      "follows": null
     },
     {
      "id": "I43",
      "text": "他觉得该爱得更充分。",
      "key": "更充分",
      "follows": null
     },
     {
      "id": "I44",
      "text": "他想把这一刻感受得更深。",
      "key": "更深",
      "follows": null
     },
     {
      "id": "I45",
      "text": "他开始主动体会每点细微的好。",
      "key": "细微的好",
      "follows": null
     },
     {
      "id": "I46",
      "text": "他盼望以后想起时仍能获得力量。",
      "key": "获得力量",
      "follows": null
     },
     {
      "id": "I47",
      "text": "他想到将来未必总这样满足。",
      "key": "未必",
      "follows": null
     },
     {
      "id": "I48",
      "text": "他确信此刻得到的幸福谁也抹不掉。",
      "key": "谁也抹不掉",
      "follows": null
     },
     {
      "id": "I49",
      "text": "他觉得这种爱比从前更郑重。",
      "key": "更郑重",
      "follows": null
     },
     {
      "id": "I50",
      "text": "他没意识到自己也想靠认真留住些什么。",
      "key": "留住些什么",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I37",
      "to": "I41",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I36",
      "to": "I42",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I30",
      "to": "I45",
      "rel": "改写",
      "how": "原先自然感到的好，如今被他主动留意。"
     },
     {
      "from": "I33",
      "to": "I50",
      "rel": "仍在起作用",
      "how": ""
     }
    ]
   },
   {
    "sec": "S07",
    "bars": "51–61",
    "relation": "正在面对",
    "items": [
     {
      "id": "I51",
      "text": "他开始检查此刻是否还像刚才那样好。",
      "key": "像刚才",
      "follows": null
     },
     {
      "id": "I52",
      "text": "他开始检查自己的心是否仍然饱满。",
      "key": "仍然饱满",
      "follows": null
     },
     {
      "id": "I53",
      "text": "他想确认对方的亲近是否仍足够。",
      "key": "是否仍足够",
      "follows": null
     },
     {
      "id": "I54",
      "text": "那份细心反倒使他难以安宁。",
      "key": "难以安宁",
      "follows": null
     },
     {
      "id": "I55",
      "text": "即使什么没变，他也忍不住比较。",
      "key": "忍不住比较",
      "follows": null
     },
     {
      "id": "I56",
      "text": "他仍感到被爱，却想知道能否一直如此。",
      "key": "能否一直如此",
      "follows": null
     },
     {
      "id": "I57",
      "text": "细微的好成了他反复辨认的凭据。",
      "key": "反复辨认",
      "follows": null
     },
     {
      "id": "I58",
      "text": "他并不真的怀疑对方爱他。",
      "key": "并不真的怀疑",
      "follows": null
     },
     {
      "id": "I59",
      "text": "他难过自己已无法毫无顾虑地享受亲密。",
      "key": "毫无顾虑",
      "follows": null
     },
     {
      "id": "I60",
      "text": "反复确认没有失去，反让他仿佛失去了什么。",
      "key": "仿佛失去了",
      "follows": null
     },
     {
      "id": "I61",
      "text": "他为自己的委屈感到羞愧。",
      "key": "感到羞愧",
      "follows": null
     },
     {
      "id": "I62",
      "text": "他不明白得到了真实的好为何仍不满足。",
      "key": "为何仍不满足",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I45",
      "to": "I51",
      "rel": "改写",
      "how": "体会细微的好变成了检查好是否还在。"
     },
     {
      "from": "I50",
      "to": "I56",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I29",
      "to": "I59",
      "rel": "失效",
      "how": "原先无须证明的轻松已经难以维持。"
     },
     {
      "from": "I35",
      "to": "I58",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I48",
      "to": "I62",
      "rel": "限制",
      "how": "确信得到过幸福，仍不能消除眼前的不满足。"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "62–71",
    "relation": "正在面对",
    "items": [
     {
      "id": "I63",
      "text": "他开始厌烦自己反复追索。",
      "key": "反复追索",
      "follows": null
     },
     {
      "id": "I64",
      "text": "他发现自己把对方心意当成必须交出的东西。",
      "key": "必须交出",
      "follows": null
     },
     {
      "id": "I65",
      "text": "他觉得这种索取改变了原先喜欢的亲密。",
      "key": "这种索取",
      "follows": null
     },
     {
      "id": "I66",
      "text": "他试着收住比较的念头。",
      "key": "收住比较",
      "follows": null
     },
     {
      "id": "I67",
      "text": "他不再要求每一刻胜过上一刻。",
      "key": "不再要求",
      "follows": null
     },
     {
      "id": "I68",
      "text": "起初这样做并不容易。",
      "key": "并不容易",
      "follows": null
     },
     {
      "id": "I69",
      "text": "少了盘问，他确实又轻松一些。",
      "key": "轻松一些",
      "follows": null
     },
     {
      "id": "I70",
      "text": "他记起自己喜欢的还有对方这个人。",
      "key": "对方这个人",
      "follows": null
     },
     {
      "id": "I71",
      "text": "他仍会担忧，却不再催对方立刻消除。",
      "key": "立刻消除",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I61",
      "to": "I63",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I57",
      "to": "I64",
      "rel": "说明",
      "how": ""
     },
     {
      "from": "I25",
      "to": "I65",
      "rel": "改写",
      "how": "彼此曾经不必时时察看，如今却被索取打扰。"
     },
     {
      "from": "I8",
      "to": "I66",
      "rel": "唤起",
      "how": "他记起最初的快乐来自敞开后的回应。"
     },
     {
      "from": "I20",
      "to": "I70",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I56",
      "to": "I71",
      "rel": "改写",
      "how": "他仍想安心，但不再把消除担忧交给对方。"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "72–77",
    "relation": "正在面对",
    "items": [
     {
      "id": "I72",
      "text": "不再索要保证后，他仍想长久相爱。",
      "key": "长久相爱",
      "follows": null
     },
     {
      "id": "I73",
      "text": "他发现苦恼不能全怪自己计较。",
      "key": "不能全怪",
      "follows": null
     },
     {
      "id": "I74",
      "text": "即使不再比较，他仍怕幸福终有变化。",
      "key": "幸福终有变化",
      "follows": null
     },
     {
      "id": "I75",
      "text": "他盼望往后还能与对方相伴。",
      "key": "与对方相伴",
      "follows": null
     },
     {
      "id": "I76",
      "text": "他不愿轻易责备自己贪心。",
      "key": "责备自己",
      "follows": null
     },
     {
      "id": "I77",
      "text": "真实得到的快乐让他更渴望长久。",
      "key": "更渴望长久",
      "follows": null
     },
     {
      "id": "I78",
      "text": "他开始分清眼前被爱与往后永不改变。",
      "key": "开始分清",
      "follows": null
     },
     {
      "id": "I79",
      "text": "他知道此刻被爱也无法保证往后永远如此。",
      "key": "永远如此",
      "follows": null
     },
     {
      "id": "I80",
      "text": "他知道自己的珍惜无法保证以后。",
      "key": "无法保证",
      "follows": null
     },
     {
      "id": "I81",
      "text": "他接受这个分别，心里仍旧疼。",
      "key": "仍旧疼",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I69",
      "to": "I72",
      "rel": "限制",
      "how": "盘问减少了，长久的愿望却还在。"
     },
     {
      "from": "I64",
      "to": "I73",
      "rel": "限制",
      "how": "索取保证确实有问题，却不能解释全部苦恼。"
     },
     {
      "from": "I37",
      "to": "I74",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I20",
      "to": "I77",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I8",
      "to": "I78",
      "rel": "提供理由",
      "how": "他确实得到过对方愿意爱他的回应。"
     },
     {
      "from": "I50",
      "to": "I80",
      "rel": "失效",
      "how": "认真珍惜不能换来以后不变。"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "78–83",
    "relation": "正在面对",
    "items": [
     {
      "id": "I82",
      "text": "他不再勉强自己装作无所谓。",
      "key": "装作无所谓",
      "follows": null
     },
     {
      "id": "I83",
      "text": "他仍盼幸福长久。",
      "key": "幸福长久",
      "follows": null
     },
     {
      "id": "I84",
      "text": "他仍怕有一天不再如此。",
      "key": "不再如此",
      "follows": null
     },
     {
      "id": "I85",
      "text": "他不愿为了防备那天先收回眼下的爱。",
      "key": "收回眼下的爱",
      "follows": null
     },
     {
      "id": "I86",
      "text": "他珍惜对方自由给予的亲近。",
      "key": "自由给予",
      "follows": null
     },
     {
      "id": "I87",
      "text": "他也想自由地给予自己的爱。",
      "key": "自由地给予",
      "follows": null
     },
     {
      "id": "I88",
      "text": "他不愿暗中要求对方永不改变。",
      "key": "永不改变",
      "follows": null
     },
     {
      "id": "I89",
      "text": "即使不能保证以后，他仍愿把心交出去。",
      "key": "把心交出去",
      "follows": null
     },
     {
      "id": "I90",
      "text": "这个选择没有让他安心。",
      "key": "没有让他安心",
      "follows": null
     },
     {
      "id": "I91",
      "text": "他却重新感到坦然。",
      "key": "感到坦然",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I81",
      "to": "I82",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I74",
      "to": "I85",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I8",
      "to": "I86",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I64",
      "to": "I88",
      "rel": "改写",
      "how": "他不想再把对方的心意变成必须交出的东西。"
     },
     {
      "from": "I80",
      "to": "I89",
      "rel": "限制",
      "how": "他只能决定此刻仍愿意爱。"
     }
    ]
   },
   {
    "sec": "S11",
    "bars": "84–92",
    "relation": "没在想",
    "items": [
     {
      "id": "I92",
      "text": "少了暗中计较，他又能尽情欢喜。",
      "key": "尽情欢喜",
      "follows": null
     },
     {
      "id": "I93",
      "text": "他没有忘记亲密可能带来痛楚。",
      "key": "可能带来痛楚",
      "follows": null
     },
     {
      "id": "I94",
      "text": "他不再为自己的热切羞愧。",
      "key": "热切羞愧",
      "follows": null
     },
     {
      "id": "I95",
      "text": "他不再为显得清醒而克制喜爱。",
      "key": "克制喜爱",
      "follows": null
     },
     {
      "id": "I96",
      "text": "他能够坦然感到自己需要对方。",
      "key": "需要对方",
      "follows": null
     },
     {
      "id": "I97",
      "text": "他也能热切地盼对方幸福。",
      "key": "对方幸福",
      "follows": null
     },
     {
      "id": "I98",
      "text": "这两种心愿不再互相争夺。",
      "key": "互相争夺",
      "follows": null
     },
     {
      "id": "I99",
      "text": "他喜欢在爱里变得柔软的自己。",
      "key": "变得柔软",
      "follows": null
     },
     {
      "id": "I100",
      "text": "他喜欢自己能够慷慨地给予。",
      "key": "慷慨地给予",
      "follows": null
     },
     {
      "id": "I101",
      "text": "犹疑后仍愿相信，使他的满足更深。",
      "key": "满足更深",
      "follows": null
     },
     {
      "id": "I102",
      "text": "他还没有想通所有问题。",
      "key": "没有想通",
      "follows": null
     },
     {
      "id": "I103",
      "text": "有一阵子他幸福得不再追问。",
      "key": "有一阵子",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I88",
      "to": "I92",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I89",
      "to": "I93",
      "rel": "仍在起作用",
      "how": "他是在知道可能受伤的情况下继续亲近。"
     },
     {
      "from": "I61",
      "to": "I94",
      "rel": "改写",
      "how": ""
     },
     {
      "from": "I19",
      "to": "I97",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I22",
      "to": "I100",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I71",
      "to": "I103",
      "rel": "提供理由",
      "how": "他暂时不必让每份担忧都得到解答。"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "93–102",
    "relation": "正在面对",
    "items": [
     {
      "id": "I104",
      "text": "他难以忍受如此圆满也留不住。",
      "key": "如此圆满",
      "follows": null
     },
     {
      "id": "I105",
      "text": "他想再靠近对方一点。",
      "key": "再靠近",
      "follows": null
     },
     {
      "id": "I106",
      "text": "他恨不得彼此心意完全相融。",
      "key": "完全相融",
      "follows": null
     },
     {
      "id": "I107",
      "text": "他想消除一切可能使两人分离的距离。",
      "key": "分离的距离",
      "follows": null
     },
     {
      "id": "I108",
      "text": "他明白亲近再深，两人仍是两个人。",
      "key": "仍是两个人",
      "follows": null
     },
     {
      "id": "I109",
      "text": "他明白此刻圆满也无法阻止以后变化。",
      "key": "以后变化",
      "follows": null
     },
     {
      "id": "I110",
      "text": "明白这些后，他的渴望反而更炽烈。",
      "key": "更炽烈",
      "follows": null
     },
     {
      "id": "I111",
      "text": "他不肯因此减少自己的爱。",
      "key": "减少自己的爱",
      "follows": null
     },
     {
      "id": "I112",
      "text": "他想倾注所有眷恋。",
      "key": "所有眷恋",
      "follows": null
     },
     {
      "id": "I113",
      "text": "这样爱着令他幸福得近乎无法承受。",
      "key": "近乎无法承受",
      "follows": null
     },
     {
      "id": "I114",
      "text": "想到幸福换不来永远，他又感到剧痛。",
      "key": "换不来永远",
      "follows": null
     },
     {
      "id": "I115",
      "text": "他分不清急切来自太快乐还是无法留住。",
      "key": "分不清急切",
      "follows": null
     },
     {
      "id": "I116",
      "text": "他舍不得到几乎不能安静地幸福。",
      "key": "不能安静",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I101",
      "to": "I104",
      "rel": "唤起",
      "how": "犹疑之后得到的满足，使他格外舍不得。"
     },
     {
      "from": "I103",
      "to": "I104",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I75",
      "to": "I105",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I79",
      "to": "I108",
      "rel": "说明",
      "how": "对方的心意无法完全由他决定。"
     },
     {
      "from": "I80",
      "to": "I109",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I89",
      "to": "I111",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I36",
      "to": "I115",
      "rel": "仍在起作用",
      "how": "最初盼望一直这样下去的心愿没有消失。"
     }
    ]
   },
   {
    "sec": "S13",
    "bars": "103–110",
    "relation": "正在面对",
    "items": [
     {
      "id": "I117",
      "text": "这种急切终于使他感到无力。",
      "key": "感到无力",
      "follows": null
     },
     {
      "id": "I118",
      "text": "他发觉尽情爱仍不能替未来保证。",
      "key": "不能替未来保证",
      "follows": null
     },
     {
      "id": "I119",
      "text": "他甚至希望自己不要懂这么多。",
      "key": "不要懂这么多",
      "follows": null
     },
     {
      "id": "I120",
      "text": "他想若像最初只知靠近，也许不必这样疼。",
      "key": "也许不必",
      "follows": null
     },
     {
      "id": "I121",
      "text": "他想至少把一切牢牢记住。",
      "key": "牢牢记住",
      "follows": null
     },
     {
      "id": "I122",
      "text": "记忆能证明他曾得到幸福。",
      "key": "曾得到幸福",
      "follows": null
     },
     {
      "id": "I123",
      "text": "记忆无法使他重新拥有那份幸福。",
      "key": "重新拥有",
      "follows": null
     },
     {
      "id": "I124",
      "text": "他不觉得先前的快乐是假的。",
      "key": "快乐是假的",
      "follows": null
     },
     {
      "id": "I125",
      "text": "他也不觉得自己的投入是错的。",
      "key": "投入是错的",
      "follows": null
     },
     {
      "id": "I126",
      "text": "确信那些快乐真实，让他更难放下。",
      "key": "更难放下",
      "follows": null
     },
     {
      "id": "I127",
      "text": "他有一瞬间埋怨自己爱得太深。",
      "key": "一瞬间",
      "follows": null
     },
     {
      "id": "I128",
      "text": "他无法真心希望幸福从未发生。",
      "key": "无法真心",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I116",
      "to": "I117",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I111",
      "to": "I118",
      "rel": "限制",
      "how": "不减少爱，也无法令以后按他的愿望发展。"
     },
     {
      "from": "I1",
      "to": "I120",
      "rel": "唤起",
      "how": "他一度怀念最初还不懂得这些的自己。"
     },
     {
      "from": "I46",
      "to": "I121",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I48",
      "to": "I123",
      "rel": "限制",
      "how": "幸福确实存在过，也无法靠记忆留在眼前。"
     },
     {
      "from": "I8",
      "to": "I124",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I114",
      "to": "I127",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I113",
      "to": "I128",
      "rel": "仍在起作用",
      "how": ""
     }
    ]
   },
   {
    "sec": "S14",
    "bars": "111–116",
    "relation": "正在面对",
    "items": [
     {
      "id": "I129",
      "text": "他分清希望长久与要求永不改变。",
      "key": "分清",
      "follows": null
     },
     {
      "id": "I130",
      "text": "他希望长久是因为真心爱对方。",
      "key": "真心爱对方",
      "follows": null
     },
     {
      "id": "I131",
      "text": "他看见要求永不变会让自己难以自由地爱。",
      "key": "难以自由地爱",
      "follows": null
     },
     {
      "id": "I132",
      "text": "他不再为希望长久感到羞愧。",
      "key": "希望长久",
      "follows": null
     },
     {
      "id": "I133",
      "text": "他不愿再用永不变的要求束缚彼此。",
      "key": "束缚彼此",
      "follows": null
     },
     {
      "id": "I134",
      "text": "想明白这些，他依然感到疼。",
      "key": "依然感到疼",
      "follows": null
     },
     {
      "id": "I135",
      "text": "无法确定以后，仍令他心口发紧。",
      "key": "心口发紧",
      "follows": null
     },
     {
      "id": "I136",
      "text": "他不再急着责备自己的舍不得。",
      "key": "不再急着责备",
      "follows": null
     },
     {
      "id": "I137",
      "text": "他不再用舍不得否定得到过的快乐。",
      "key": "否定",
      "follows": null
     },
     {
      "id": "I138",
      "text": "他知道自己确实幸福，所以如此留恋。",
      "key": "如此留恋",
      "follows": null
     },
     {
      "id": "I139",
      "text": "他知道幸福留不住，因此幸福时也疼。",
      "key": "幸福时也疼",
      "follows": null
     },
     {
      "id": "I140",
      "text": "快乐无法消除他的痛楚。",
      "key": "无法消除",
      "follows": null
     },
     {
      "id": "I141",
      "text": "他不愿为了不疼而减少快乐。",
      "key": "减少快乐",
      "follows": null
     },
     {
      "id": "I142",
      "text": "他依旧想靠近，也愿意爱。",
      "key": "依旧想靠近",
      "follows": null
     },
     {
      "id": "I143",
      "text": "他还有一点不甘心。",
      "key": "一点不甘心",
      "follows": null
     },
     {
      "id": "I144",
      "text": "他无法安排往后的变化。",
      "key": "往后的变化",
      "follows": null
     },
     {
      "id": "I145",
      "text": "他不愿因此收回已经付出的心意。",
      "key": "收回",
      "follows": null
     },
     {
      "id": "I146",
      "text": "他舍不得那个因爱过而舍不得的自己。",
      "key": "舍不得的自己",
      "follows": null
     },
     {
      "id": "I147",
      "text": "他不愿退回还不知道自己能如此幸福的从前。",
      "key": "不愿退回",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I78",
      "to": "I129",
      "rel": "改写",
      "how": "他进一步分清长久的心愿与永不改变的要求。"
     },
     {
      "from": "I64",
      "to": "I131",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I81",
      "to": "I134",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I61",
      "to": "I136",
      "rel": "改写",
      "how": "原先的羞愧不再要求他立刻压下舍不得。"
     },
     {
      "from": "I126",
      "to": "I137",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I101",
      "to": "I138",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I118",
      "to": "I139",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I89",
      "to": "I142",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I115",
      "to": "I143",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I109",
      "to": "I144",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I128",
      "to": "I146",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I120",
      "to": "I147",
      "rel": "改写",
      "how": "他曾希望少懂一些，如今却不愿失去已懂得的幸福。"
     },
     {
      "from": "I90",
      "to": "I147",
      "rel": "仍在起作用",
      "how": "他仍没有安心的保证。"
     }
    ]
   }
  ]
