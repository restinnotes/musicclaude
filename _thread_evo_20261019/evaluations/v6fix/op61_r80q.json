      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "242–253",
    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "他开始主动认下自己的立场：旧日归属仍让他牵挂，眼下的日子也要由自己认真过好。",
      "key": "他开始主动认下自",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-2",
       "S10-2"
      ]
     },
     {
      "id": "S12-2",
      "text": "这份自我肯定一下子变得很有力量，他觉得自己终于能把日子接回手里，心里也生出久违的踏实。",
      "key": "这份自我肯定一下",
      "follows": false,
      "explains": [],
      "cite": [
       "S12-1",
       "S11-1"
      ]
     },
     {
      "id": "S12-3",
      "text": "中间仍有一瞬不稳，旧日的牵挂轻轻晃动了他；但那点动摇没有把他推回原先的退缩，他仍愿意继续。",
      "key": "中间仍有一瞬不稳",
      "follows": false,
      "explains": [],
      "cite": [
       "S12-2"
      ]
     }
    ],
    "because": [
     {
