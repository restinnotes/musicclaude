{
 "sections": [
  {
   "sec": "S01",
   "rows": [
    {
     "form": "连贯",
     "text": "刚离开熟悉的生活，他觉得终于不用再委屈自己。",
     "keys": [
      "终于不用再委屈自己"
     ],
     "emotion": "安心",
     "from": [
      "S01-1"
     ],
     "at": 0
    },
    {
     "form": "连贯",
     "text": "这份笃定很快散了，他心里空落落的，却说不清舍不得什么。",
     "keys": [
      "笃定很快散了",
      "说不清舍不得什么"
     ],
     "emotion": "悬着",
     "from": [
      "S01-2"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "短句像叹息，刚冒出来就被停顿截断",
       "from": [
        "S01-B3"
       ],
       "bars": "",
       "at": 0
      },
      {
       "text": "像刚醒来，胸口发紧，眼前还模糊",
       "from": [
        "S01-B4"
       ],
       "bars": "",
       "at": 0
      }
     ]
    },
    {
     "form": "连贯",
     "text": "他还想往前走，却不知靠什么安下心。",
     "keys": [
      "还想往前走",
      "靠什么安下心"
     ],
     "emotion": "悬着",
     "from": [
      "S01-3"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "我不能倒下，可我其实很想停下来",
       "from": [
        "S01-B2"
       ],
       "bars": "",
       "at": 0
      },
      {
       "text": "旧场景忽然清晰，过去却回不来",
       "from": [
        "S01-B5"
       ],
       "bars": "9–17",
       "at": 0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "开头一声沉重得像宣告，后面的声音像烟雾散开",
     "from": [
      "S01-B1"
     ],
     "bars": "1–6"
    }
   ]
  },
  {
   "sec": "S02",
   "rows": [
    {
     "form": "连贯",
     "text": "舍不得从前的自在，想到以后不能再那样过便发慌。",
     "keys": [
      "舍不得从前的自在",
      "便发慌"
     ],
     "emotion": "不安",
     "from": [
      "S02-1"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "舞步清楚了，却不像英雄凯旋",
       "from": [
        "S02-B1"
       ],
       "bars": "",
       "at": 0
      },
      {
       "text": "腿脚发虚，还在挪着舞步",
       "from": [
        "S02-B2"
       ],
       "bars": "",
       "at": 0
      }
     ]
    },
    {
     "form": "连贯",
     "text": "想念一来，他就拿受过的气提醒自己为何离开。",
     "keys": [
      "受过的气",
      "为何离开"
     ],
     "emotion": "不安",
     "from": [
      "S02-2"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "反复说“我没事”，越说越显出在意",
       "from": [
        "S02-B4"
       ],
       "bars": "44–65",
       "at": 0
      }
     ]
    },
    {
     "form": "连贯",
     "text": "可他不甘心，难道好日子也要一并否定？",
     "keys": [
      "不甘心",
      "好日子也要一并否定"
     ],
     "emotion": "悬着",
     "from": [
      "S02-3"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "我不甘心就这样消亡",
       "from": [
        "S02-B5"
       ],
       "bars": "44–65",
       "at": 0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "声音猛地往上冲又退下，呼吸跟着急起来",
     "from": [
      "S02-B3"
     ],
     "bars": "38–65"
    }
   ]
  },
  {
   "sec": "S03",
   "rows": [
    {
     "form": "连贯",
     "text": "想起曾被当作自己人，他高兴过；旧日难再有，离开真会更好吗？",
     "keys": [
      "曾被当作自己人",
      "离开真会更好吗"
     ],
     "emotion": "悬着",
     "from": [
      "S03-1",
      "S03-2"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "像故乡夏日的麦浪与微风",
       "from": [
        "S03-B2"
       ],
       "bars": "80–91",
       "at": 0
      },
      {
       "text": "像暂时侧身离开沉重的问题，轻松是真的，却没带来答案",
       "from": [
        "S03-B3"
       ],
       "bars": "66–91",
       "at": 0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "那一下若被听清，像重锤砸下",
     "from": [
      "S03-B1"
     ],
     "bars": "66–91"
    },
    {
     "text": "像几个人在耳边低声絮语，彼此缠绕",
     "from": [
      "S03-B4"
     ],
     "bars": "66–91"
    },
    {
     "text": "昂扬退去，心里冒出一句：刚才真的相信了吗？",
     "from": [
      "S03-B5"
     ],
     "bars": "66–91"
    }
   ]
  },
  {
   "sec": "S04",
   "rows": [
    {
     "form": "连贯",
     "text": "想起从前的亲近，他盼着还能那样相处。",
     "keys": [
      "从前的亲近",
      "还能那样相处"
     ],
     "emotion": "亲密",
     "from": [
      "S04-1"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "旧记忆里的亲密、感激和短暂幸福都鲜活起来",
       "from": [
        "S04-B1"
       ],
       "bars": "92–107",
       "at": 0
      }
     ]
    },
    {
     "form": "连贯",
     "text": "可旧日委屈也翻上来：离开对吗？留下又会怎样？",
     "keys": [
      "旧日委屈也翻上来",
      "留下又会怎样"
     ],
     "emotion": "不安",
     "from": [
      "S04-2"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "不是记忆变坏，是那段日子太好了",
       "from": [
        "S04-B2"
       ],
       "bars": "108–115",
       "at": 0
      },
      {
       "text": "脑子里反复转着：如果当时……",
       "from": [
        "S04-B4"
       ],
       "bars": "94–115",
       "at": 0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "细碎声音像急促脚步，心跳乱了拍",
     "from": [
      "S04-B3"
     ],
     "bars": "92–115"
    }
   ]
  },
  {
   "sec": "S05",
   "rows": [
    {
     "form": "连贯",
     "text": "他不替旧委屈开脱，也不再逼自己忘掉好时光。",
     "keys": [
      "不替旧委屈开脱",
      "不再逼自己忘掉好时光"
     ],
     "emotion": "悬着",
     "from": [
      "S05-1"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "像夜色里两个影子，彼此低声说话",
       "from": [
        "S05-B1"
       ],
       "bars": "",
       "at": 0
      },
      {
       "text": "这件事不能就这样算了",
       "from": [
        "S05-B2"
       ],
       "bars": "116–127",
       "at": 0
      },
      {
       "text": "旧日记忆重新有了温度",
       "from": [
        "S05-B3"
       ],
       "bars": "",
       "at": 0
      }
     ]
    },
    {
     "form": "连贯",
     "text": "争辩到累了，火气渐淡，只剩不在他们身边的难受。",
     "keys": [
      "火气渐淡",
      "不在他们身边的难受"
     ],
     "emotion": "孤单",
     "from": [
      "S05-2"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "几次深呼吸，像抵抗得累了",
       "from": [
        "S05-B5"
       ],
       "bars": "144–147",
       "at": 0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "声音渐稀，最后只剩较慢、较疏的几下",
     "from": [
      "S05-B4"
     ],
     "bars": "128–147"
    }
   ]
  },
  {
   "sec": "S06",
   "rows": [
    {
     "form": "连贯",
     "text": "难受缓下来，他不再拿旧委屈压住这份想念。",
     "keys": [
      "难受缓下来",
      "不再拿旧委屈压住这份想念"
     ],
     "emotion": "亲密",
     "from": [
      "S06-1"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "像被透明玻璃罩隔开的静谧",
       "from": [
        "S06-B1"
       ],
       "bars": "",
       "at": 0
      },
      {
       "text": "愿望朝远方发出，却没有回应的保证",
       "from": [
        "S06-B2"
       ],
       "bars": "",
       "at": 0
      }
     ]
    },
    {
     "form": "连贯",
     "text": "离开后常得独自熬难事，他才懂有人陪着有多轻松。",
     "keys": [
      "独自熬难事",
      "有人陪着有多轻松"
     ],
     "emotion": "孤单",
     "from": [
      "S06-2"
     ],
     "at": 0
    },
    {
     "form": "连贯",
     "text": "曾有过的默契让他宽慰，如今盼着再有，却怕难再遇。",
     "keys": [
      "曾有过的默契让他宽慰",
      "怕难再遇"
     ],
     "emotion": "悬着",
     "from": [
      "S06-3"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "歌唱渐渐展开，临近结束像话没说完",
       "from": [
        "S06-B3"
       ],
       "bars": "148–180",
       "at": 0
      },
      {
       "text": "好好看着珍惜的东西，不急着抓回来",
       "from": [
        "S06-B4"
       ],
       "bars": "",
       "at": 0
      }
     ]
    }
   ],
   "notes": []
  },
  {
   "sec": "S07",
   "rows": [
    {
     "form": "连贯",
     "text": "想到以后难事还得独自扛，他怕自己撑不住。",
     "keys": [
      "以后难事还得独自扛",
      "怕自己撑不住"
     ],
     "emotion": "不安",
     "from": [
      "S07-1"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "寒风猛地吹开窗，后颈一凉",
       "from": [
        "S07-B1"
       ],
       "bars": "182附近",
       "at": 0
      }
     ]
    },
    {
     "form": "连贯",
     "text": "当初离开只为不再受气，如今孤单得又问自己还走不走。",
     "keys": [
      "只为不再受气",
      "孤单得又问自己还走不走"
     ],
     "emotion": "孤单",
     "from": [
      "S07-2"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "像一个熟悉动作突然闯进来，反而照见失去什么",
       "from": [
        "S07-B4"
       ],
       "bars": "",
       "at": 0
      },
      {
       "text": "心里直想冲出去，却找不到出口",
       "from": [
        "S07-B3"
       ],
       "bars": "198–205",
       "at": 0
      }
     ]
    },
    {
     "form": "连贯",
     "text": "想找回亲近，却不肯再受委屈，离开的决心也松了。",
     "keys": [
      "想找回亲近",
      "离开的决心也松了"
     ],
     "emotion": "悬着",
     "from": [
      "S07-3"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "熟悉的舞曲气息回来，却不再完整",
       "from": [
        "S07-B5"
       ],
       "bars": "182–197",
       "at": 0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "舞步突然闯入，截断先前的静谧",
     "from": [
      "S07-B2"
     ],
     "bars": "182–197"
    }
   ]
  },
  {
   "sec": "S08",
   "rows": [
    {
     "form": "连贯",
     "text": "他先不把怀念当回头理由；可回忆不能陪他熬过未来难处，心仍悬着。",
     "keys": [
      "不把怀念当回头理由",
      "心仍悬着"
     ],
     "emotion": "悬着",
     "from": [
      "S08-1",
      "S08-2"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "宽广的歌唱短暂回来，像临走前回头一眼",
       "from": [
        "S08-B1",
        "S08-B2"
       ],
       "bars": "206–213",
       "at": 0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "胸口像忽然吸进一口气",
     "from": [
      "S08-B3"
     ],
     "bars": "206–213"
    }
   ]
  },
  {
   "sec": "S09",
   "rows": [
    {
     "form": "连贯",
     "text": "想回去，是舍不得亲近，还是怕孤单到愿再受委屈？心慌得不敢想。",
     "keys": [
      "舍不得亲近",
      "心慌得不敢想"
     ],
     "emotion": "不安",
     "from": [
      "S09-1",
      "S09-2"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "颤动的光晕里，开头那股沉重又阴冷地闪回",
       "from": [
        "S09-B1"
       ],
       "bars": "214–215",
       "at": 0
      },
      {
       "text": "这次再看那个茫然的自己，已知道他经历过什么",
       "from": [
        "S09-B2"
       ],
       "bars": "214–215",
       "at": 0
      }
     ]
    }
   ],
   "notes": []
  },
  {
   "sec": "S10",
   "rows": [
    {
     "form": "连贯",
     "text": "他最放不下那份亲近；旧委屈未消，回去未必如前，反复想仍难安。",
     "keys": [
      "最放不下那份亲近",
      "反复想仍难安"
     ],
     "emotion": "悬着",
     "from": [
      "S10-1",
      "S10-2",
      "S10-3"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "熟悉的声音只剩碎片，重要的事已无力讲完",
       "from": [
        "S10-B1",
        "S10-B4"
       ],
       "bars": "216–225",
       "at": 0
      },
      {
       "text": "我究竟要怎样继续生活？",
       "from": [
        "S10-B3"
       ],
       "bars": "216–225",
       "at": 0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "声音忽然失重，像整个人悬在半空",
     "from": [
      "S10-B2"
     ],
     "bars": "221–225"
    }
   ]
  },
  {
   "sec": "S11",
   "rows": [
    {
     "form": "连贯",
     "text": "明知回去未必恢复亲近，他仍忍不住盼着。",
     "keys": [
      "未必恢复亲近",
      "忍不住盼着"
     ],
     "emotion": "悬着",
     "from": [
      "S11-1"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "不肯只凭盼头回去；怕独自扛事，仍要先把眼下日子过稳",
       "from": [
        "S11-2",
        "S11-3"
       ],
       "bars": "",
       "at": 0
      },
      {
       "text": "步子从试探慢慢聚拢；害怕还在，脚却往前",
       "from": [
        "S11-B2",
        "S11-B3"
       ],
       "bars": "226–241",
       "at": 0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "低音像波涛涌起，重重声响接连砸下",
     "from": [
      "S11-B1"
     ],
     "bars": "226–237"
    }
   ]
  },
  {
   "sec": "S12",
   "rows": [
    {
     "form": "连贯",
     "text": "委屈不该忍，好日子也真有过；他不再逼自己选边。",
     "keys": [
      "委屈不该忍",
      "不再逼自己选边"
     ],
     "emotion": "安心",
     "from": [
      "S12-1"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "可以决定怎样站立，不必假装没受过伤",
       "from": [
        "S12-B2"
       ],
       "bars": "242–253",
       "at": 0
      },
      {
       "text": "仍怕独自熬，却不怪自己离开，也不为陪伴回头；带着想念过日子",
       "from": [
        "S12-2",
        "S12-3"
       ],
       "bars": "",
       "at": 0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "熟悉的舞步轰然回来，脚下终于踏实",
     "from": [
      "S12-B1"
     ],
     "bars": "242–253"
    },
    {
     "text": "脚步向前时，像地面短暂斜了一下",
     "from": [
      "S12-B3"
     ],
     "bars": "249–253"
    }
   ]
  },
  {
   "sec": "S13",
   "rows": [
    {
     "form": "连贯",
     "text": "盼着再遇见自然亲近的人，他有劲头过日子，不再整天跟旧事较劲。",
     "keys": [
      "再遇见自然亲近的人",
      "不再整天跟旧事较劲"
     ],
     "emotion": "炽热",
     "from": [
      "S13-1",
      "S13-2"
     ],
     "at": 0
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "温柔的歌忽然站到明亮处，力量也涌起来",
       "from": [
        "S13-B1"
       ],
       "bars": "254–270",
       "at": 0
      }
     ]
    },
    {
     "form": "连贯",
     "text": "劲头稍退，他又怕还要等很久。",
     "keys": [
      "劲头稍退",
      "怕还要等很久"
     ],
     "emotion": "不安",
     "from": [
