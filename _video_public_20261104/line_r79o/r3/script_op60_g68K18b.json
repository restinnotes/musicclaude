    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "高兴后，他想听对方说以后不变；时间飞快，能一直这样吗？",
       "keys": [
