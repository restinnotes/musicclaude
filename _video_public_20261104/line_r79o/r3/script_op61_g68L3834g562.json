       "from": [
        ""
       ],
       "bead": ""
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "回不回去以后再说，先把眼下日子过稳些",
       "keys": [
        "先把眼下日子过稳些"
       ],
       "from": []
      }
     ],
     "beads": [
      {
       "text": "像绝境里的困兽一次次顶住重压，心里的祈求化作了迈步的决心",
