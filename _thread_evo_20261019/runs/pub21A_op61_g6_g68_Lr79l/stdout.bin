{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"连失落也还说不清\"\n        },\n        {\n          \"quote\": \"像烟雾往高处散，声音轻了、远了，悬在半空\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"记忆再清晰，过去也不会因此重新变成现在\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"记忆再清晰，也不能变成现在\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开熟悉生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"总算\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"不知如何安顿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可心里很快空了\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"节奏本身庄严、傲慢，旋律却脆弱凄婉\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"节奏庄严傲慢，旋律却脆弱凄婉\"\n        },\n        {\n          \"quote\": \"连反复说这句话本身都暴露出：其实还是很在意\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越反复说，越显得在意\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到以后再没有\",\n          \"point\": \"再没有那样的日子\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"再没有\"\n        },\n        {\n          \"text\": \"他提醒自己受过的气\",