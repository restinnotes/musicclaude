     "emotion": "亲密",
     "from": [
      "S13-3",
      "S13-B3"
     ]
    },
    {
     "form": "散落",
     "items": [
      {
       "text": "脚步牢牢踩地",
       "from": [
        "S13-B3"
       ],
       "bars": "103–110"
      },
      {
       "text": "上方声音反复落下",
       "from": [
        "S13-B3"
       ],
       "bars": "103–110"
      },
      {
       "text": "胸口一沉再沉",
       "from": [
        "S13-B3"
       ],
       "bars": "103–110"
      }
     ]
    }
   ]
  },
  {
