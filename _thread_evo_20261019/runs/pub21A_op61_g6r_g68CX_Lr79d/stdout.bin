{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"反而像烟雾往高处散，声音轻了、远了，悬在半空。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"我不能倒下，可我其实很想停下来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"伸出颤抖的手去摸，摸到的却只有虚空。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开熟悉的生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初觉得\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"不知靠什么安定下来\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想继续往前走，却\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"依稀记得\"\n        },\n        {\n          \"quote\": \"节奏本身庄严、傲慢，旋律却脆弱凄婉。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"第一次还有几分相信，第二次开始努力让自己相信，说到第三次，连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到再不能自在地过日子\",\n          \"point\": \"心里就慌\",\n          \"where\": \"后\",\n          \"waste\": \"心里\",\n          \"keep\": \"再不能自在地过日子\"\n        },\n        {\n          \"text\": \"他怕一心软就忘