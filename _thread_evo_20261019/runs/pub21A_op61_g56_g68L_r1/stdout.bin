       {\n          \"quote\": \"不停地往前赶，只是为了避免停下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起以前彼此那么亲近\",\n          \"point\": \"还能像那时一样\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"彼此那么亲近\"\n        },\n        {\n          \"text\": \"怀疑当初走错了\",\n          \"point\": \"想不出要是没走会怎样\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怀疑当初走错了\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"可正因已经过去，眷恋里也带着失落。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"因已过去\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍觉得那些气不该忍\",\n          \"point\": \"那些气不该忍\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"从前开心的事也舍不得忘\"\n        },\n        {\n          \"text\": \"跟自己较劲到没力气\",\n          \"point\": \"离开那些人很难受\",\n          \"where\": \"后\",\n          \"waste\": \"他只觉得\",\n          \"keep\": \"跟自己较劲到没力气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"它也像母亲在耳畔轻轻哼唱的摇篮曲，温柔得让人暂时松开戒备。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"明知有些事已经挽不回，便放轻声音，好好看着它。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"心里好受了些\",\n          \"point\": \"不再拿受过的气压住想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"心里好受了些\"\n        },\n        {\n          \"text\": \"难事常得自己扛\",\n          \"point\": \"有人陪着多轻松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"难事常得自己扛\"\n        },\n        {\n          \"text\": \"他怕再没有那种亲近\",\n          \"point\": \"自己真的有过\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕再没有那种亲近\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"它像寒风猛地吹开紧闭的窗，把人从甜梦里生生拽回严寒。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这种突兀的换向并不等于情绪好转；新出现的舞步可以很鲜明，内心却未必因此安定下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这样的亲切感未必安慰人；恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"刚安心一点\",\n          \"point\": \"只能独自撑着\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"刚安心一点，他又怕\"\n        },\n        {\n          \"text\": \"当初只想不再受气\",\n          \"point\": \"离开会这么孤单\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"当初只想不再受气\"\n        },\n        {\n          \"text\": \"想找回那份亲近\",\n          \"point\": \"走