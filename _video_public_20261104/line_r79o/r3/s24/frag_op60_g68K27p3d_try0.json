     "from": [
      "S14-2"
     ],
     "bars": "",
     "at": 0
    },
    {
     "text": "往后会怎样，等真的到了那时再说",
     "after": 3,
     "from": [
      "S14-3"
     ],
     "bars": "",
     "at": 0
    },
    {
