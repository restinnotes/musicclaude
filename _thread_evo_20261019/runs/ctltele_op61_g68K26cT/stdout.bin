13\",\n      \"big\": [\n        {\n          \"text\": \"旧日亲近再忆，心复温热；亦盼未来重现\",\n          \"accent\": \"盼未来重现\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S13-1\"\n          ],\n          \"at\": 0\n        },\n        {\n          \"text\": \"此愿望化作动力：好好过日子，不再争执\",\n          \"accent\": \"好好过日子\",\n          \"emotion\": \"炽热\",\n          \"from\": [\n            \"S13-2\"\n          ],\n          \"at\": 8\n        },\n        {\n          \"text\": \"惟恐仍需久候，方能遇见那样的人\",\n          \"accent\": \"仍需久候\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S13-3\"\n          ],\n          \"at\": 16\n        },\n        {\n          \"text\": \"若再有人视其为自己人，必当珍惜\",\n          \"accent\": \"必当珍惜\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S13-4\"\n          ],\n          \"at\": 24\n        },\n        {\n          \"text\": \"纵始终未有，他亦愿自顾生活，不再吞咽委屈\",\n          \"accent\": \"不再吞咽委屈\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S13-4\"\n          ],\n          \"at\": 31\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"柔软歌唱扩为宏大：故土、共同记忆、希望；心跳抵达极限\",\n          \"after\": 1,\n          \"from\": [\n            \"S13-B1\"\n          ],\n          \"bars\": \"254–270\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"冲势退落；不安尚存，亦可喘息；结尾似决意，或醒转\",\n          \"after\": 4,\n          \"from\": [\n            \"S13-B3\",\n            \"S13-B5\"\n          ],\n          \"bars\": \"281–288\",\n          \"at\": 38\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"密集音流向天空喷涌，随后明亮音流疾冲\",\n          \"from\": [\n            \"S13-B1\",\n            \"S13-B2\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"254–280\"\n        },\n        {\n          \"text\": \"冲势收敛，细碎颤动又带来一点不安\",\n          \"from\": [\n            \"S13-B3\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"281–287\"\n