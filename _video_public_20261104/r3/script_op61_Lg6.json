 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他离开了熟悉的生活，起初觉得自己终于不用再委屈了。",
       "detail": "可他还没有找到往前走的方向，心里也很想停下来。",
       "keys": [],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "挺直背脊 不能倒下",
       "keys": [],
       "from": [
        "S01-B1-p1"
       ]
      },
      {
       "text": "很想停下来",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ]
      },
      {
       "text": "找不到方向",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ]
      },
      {
       "text": "内心游移",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "离开后，他反而空落落的，连自己舍不得什么都说不清。",
       "detail": "那份失落还分不清是生气、遗憾，还是想念。",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "生气还是想念？",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "伸手只摸到虚空",
       "keys": [],
       "from": [
        "S01-B4-p2"
       ]
      },
      {
       "text": "停顿里等回声",
       "keys": [],
       "from": [
        "S01-B2-p2"
       ]
      },
      {
       "text": "胸口发紧",
       "keys": [],
       "from": [
        "S01-B4-p1"
       ]
      },
      {
       "text": "遗憾",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "尚未找到对象和语言的失落",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "恍惚",
       "keys": [],
       "from": [
        "S01-B4-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他还是想往前过，却不知道以后靠什么让自己安下心。",
       "detail": "从前的声音和光线还会忽然回来，可记得清楚也不等于回得去。",
       "keys": [],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "记得清楚却回不去",
       "keys": [],
       "from": [
        "S01-B5-p2"
       ]
      },
      {
       "text": "身体先记起迈步",
       "keys": [],
       "from": [
        "S01-B5-p3"
       ]
      },
      {
       "text": "旧场景忽然回来",
       "keys": [],
       "from": [
        "S01-B5-p1"
       ]
      },
      {
       "text": "当时的声音和光线",
       "keys": [],
       "from": [
        "S01-B5-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他舍不得从前自在的日子，一想到以后不能再那样过，心里就慌。",
       "detail": "",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "记得却不能再拥有",
       "keys": [],
       "from": [
        "S02-B1-p4"
       ]
      },
      {
       "text": "腿脚虚浮",
       "keys": [],
       "from": [
        "S02-B2-p1"
       ]
      },
      {
       "text": "远处旧歌 只哼几句",
       "keys": [],
       "from": [
        "S02-B1-p2"
       ]
      },
      {
       "text": "呼吸越来越急",
       "keys": [],
       "from": [
        "S02-B3-p3"
       ]
      },
      {
       "text": "最后还是没落稳",
       "keys": [],
       "from": [
        "S02-B3-p2"
       ]
      },
      {
       "text": "面向众人的庄严",
       "keys": [],
       "from": [
        "S02-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他赶紧提醒自己当初为什么离开，怕一心软就忘了受过的气。",
       "detail": "他努力让自己相信没事，不愿再轻易动摇。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "越说没事越在意",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "整理衣服 抬起头",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      },
      {
       "text": "不让人看出动摇",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      },
      {
       "text": "第一次还信自己没事",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "第二次努力相信",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "不肯把自己交给悲伤",
       "keys": [],
       "from": [
        "S02-B4-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他不甘心：难道不再受委屈，就得连过去的好日子也一并舍弃？",
       "detail": "",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "还不肯认输",
       "keys": [],
       "from": [
        "S02-B5-p1"
       ]
      },
      {
       "text": "这股劲还在",
       "keys": [],
       "from": [
        "S02-B5-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他还憋着那股气，却也怀念曾被当作自己人的日子。",
       "detail": "想起那份亲近，他还是会短暂地高兴；这并没有抹掉受过的委屈。",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "故乡夏日的麦浪",
       "keys": [],
       "from": [
        "S03-B2-p2"
       ]
      },
      {
       "text": "温柔得让人心颤",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ]
      },
      {
       "text": "心里一悬",
       "keys": [],
       "from": [
        "S03-B1-p2"
       ]
      },
      {
       "text": "低声絮语 找不到出口",
       "keys": [],
       "from": [
        "S03-B3-p1"
       ]
      },
      {
       "text": "越怀念越觉得远",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ]
      },
      {
       "text": "想往前却拿不定方向",
       "keys": [],
       "from": [
        "S03-B1-p3"
       ]
      },
      {
       "text": "出去走走透口气",
       "keys": [],
       "from": [
        "S03-B4-p1"
       ]
      },
      {
       "text": "刚才真的相信了吗？",
       "keys": [],
       "from": [
        "S03-B5-p2"
       ]
      },
      {
       "text": "轻松过后还是心酸",
       "keys": [],
       "from": [
        "S03-B4-p2",
        "S03-B4-p3"
       ]
      },
      {
       "text": "愤怒与抗拒",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "焦躁急切",
       "keys": [],
       "from": [
        "S03-B2-p1"
       ]
      },
      {
       "text": "轻松亲近",
       "keys": [],
       "from": [
        "S03-B2-p3"
       ]
      },
      {
       "text": "刺痛得让人绝望",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ]
      },
      {
       "text": "那一刻的轻松是真的",
       "keys": [],
       "from": [
        "S03-B4-p2"
       ]
      },
      {
       "text": "心里的事没有答案",
       "keys": [],
       "from": [
        "S03-B4-p3"
       ]
      },
      {
       "text": "昂扬慢慢退潮",
       "keys": [],
       "from": [
        "S03-B5-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "那点高兴还没退，他就开始怀疑：离开以后真的会更好吗？",
       "detail": "从前的日子已经回不去，可眼前也还没有给他安稳的答案。",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他一度真盼着，从前那份亲近还能继续。",
       "detail": "那些记忆重新鲜活起来，让他短暂觉得一切也许还能照旧。",
       "keys": [],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧记忆忽然鲜活",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      },
      {
       "text": "柔软得容易受伤",
       "keys": [],
       "from": [
        "S04-B1-p3"
       ]
      },
      {
       "text": "短暂的幸福",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      },
      {
       "text": "坚定也要努力相信",
       "keys": [],
       "from": [
        "S04-B1-p4"
       ]
      },
      {
       "text": "感激 亲密 柔情",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可他开始怀疑，当初离开是不是走错了。",
       "detail": "他却想不出，如果当时没有离开，如今又会是什么样子。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "美好回忆也刺痛",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "还能挽回吗？",
       "keys": [],
       "from": [
        "S04-B4-p1"
       ]
      },
      {
       "text": "急促脚步 乱拍心跳",
       "keys": [],
       "from": [
        "S04-B3-p1"
       ]
      },
      {
       "text": "不敢停下来",
       "keys": [],
       "from": [
        "S04-B4-p3"
       ]
      },
      {
       "text": "越用力越不安稳",
       "keys": [],
       "from": [
        "S04-B2-p1"
       ]
      },
      {
       "text": "抵抗疲惫仓促",
       "keys": [],
       "from": [
        "S04-B2-p3"
       ]
      },
      {
       "text": "被时间催着往前跑",
       "keys": [],
       "from": [
        "S04-B3-p2"
       ]
      },
      {
       "text": "没有真正抵达",
       "keys": [],
       "from": [
        "S04-B4-p2"
       ]
      },
      {
       "text": "思绪反复盘旋",
       "keys": [],
       "from": [
        "S04-B4-p4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他仍认定当初受的气不该忍，却也不想因此否认曾经的快乐。",
       "detail": "他既想维护自己，也想允许那些温暖的记忆留下来。",
       "keys": [],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "夜色里并肩低语",
       "keys": [],
       "from": [
        "S05-B1-p2"
       ]
      },
      {
       "text": "不能就这样算了",
       "keys": [],
       "from": [
        "S05-B2-p1"
       ]
      },
      {
       "text": "眷恋里带着失落",
       "keys": [],
       "from": [
        "S05-B3-p3"
       ]
      },
      {
       "text": "旧日记忆又有温度",
       "keys": [],
       "from": [
        "S05-B3-p1"
       ]
      },
      {
       "text": "愤怒 悲伤",
       "keys": [],
       "from": [
        "S05-B2-p2"
       ]
      },
      {
       "text": "想维护自己",
       "keys": [],
       "from": [
        "S05-B2-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争得太久，他已经累了；想到如今不在那些人身边，心里只剩难受。",
       "detail": "这不是想通了，只是那股不服气也被疲惫慢慢磨淡了。",
       "keys": [],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不是想通只是累了",
       "keys": [],
       "from": [
        "S05-B5-p3"
       ]
      },
      {
       "text": "脚下地板忽然不见",
       "keys": [],
       "from": [
        "S05-B4-p2"
       ]
      },
      {
       "text": "一声深深的叹息",
       "keys": [],
       "from": [
        "S05-B5-p2"
       ]
      },
      {
       "text": "躁动不安加深",
       "keys": [],
       "from": [
        "S05-B5-p1"
       ]
      },
      {
       "text": "抵抗得累了",
       "keys": [],
       "from": [
        "S05-B5-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "这一次，他没有再拿受过的委屈压住对从前的想念。",
       "detail": "他重新想起那些不必时时防备、也不必解释自己难过的相处。",
       "keys": [],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "暂时不用防备",
       "keys": [],
       "from": [
        "S06-B1-p4"
       ]
      },
      {
       "text": "压住的心事浮上来",
       "keys": [],
       "from": [
        "S06-B2-p3"
       ]
      },
      {
       "text": "盼着回应却没把握",
       "keys": [],
       "from": [
        "S06-B2-p4"
       ]
      },
      {
       "text": "隔着玻璃 连呼吸都放轻",
       "keys": [],
       "from": [
        "S06-B1-p3"
       ]
      },
      {
       "text": "母亲轻轻哼歌",
       "keys": [],
       "from": [
        "S06-B1-p4"
       ]
      },
      {
       "text": "梦里看见远方的家",
       "keys": [],
       "from": [
        "S06-B2-p5"
       ]
      },
      {
       "text": "不能永远停留",
       "keys": [],
       "from": [
        "S06-B1-p5"
       ]
      },
      {
       "text": "藏在心里的秘密念头",
       "keys": [],
       "from": [
        "S06-B2-p1"
       ]
      },
      {
       "text": "不用解释难过",
       "keys": [],
       "from": [
        "S06-B2-p2"
       ]
      },
      {
       "text": "不必维持坚强",
       "keys": [],
       "from": [
        "S06-B2-p2"
       ]
      },
      {
       "text": "愿望 委屈 思念浮现",
       "keys": [],
       "from": [
        "S06-B2-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "离开后遇到难处，他常常只能自己扛，这才明白有人在身边曾让生活轻松多少。",
       "detail": "",
       "keys": [],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他很想再过那种不用多说就彼此亲近的日子，却怕以后再也没有了。",
       "detail": "",
       "keys": [],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "话停在一半",
       "keys": [],
       "from": [
        "S06-B3-p3"
       ]
      },
      {
       "text": "鼓起勇气说心里话",
       "keys": [],
       "from": [
        "S06-B3-p1"
       ]
      },
      {
       "text": "情感更迫切",
       "keys": [],
       "from": [
        "S06-B3-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "那样的日子至少真实发生过；只是想起，他心里也能暖一点。",
       "detail": "",
       "keys": [],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "好好看着 不必抓回来",
       "keys": [],
       "from": [
        "S06-B4-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他刚因回忆安心一点，又怕以后遇上难事仍只能一个人扛。",
       "detail": "他开始怀疑，自己是否真能一直这样撑下去。",
       "keys": [],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "寒风猛地吹进来",
       "keys": [],
       "from": [
        "S07-B1-p2"
       ]
