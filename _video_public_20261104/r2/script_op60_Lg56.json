     ],
     "beads": [
      {
       "text": "烟花迸开",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
      },
      {
       "text": "一瞬失重",
       "keys": [],
       "from": [
        "S01-B2-p1"
       ]
      },
      {
       "text": "细光飘落",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
