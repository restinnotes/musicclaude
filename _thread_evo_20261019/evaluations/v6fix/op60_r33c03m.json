      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S06",
    "bars": "40–50",
    "relation": "还说不清",
    "items": [
     {
      "id": "S06-1",
      "text": "对方并未因为他显露更多依恋而疏远，他渐渐能够不那么费力地做自己。",
      "key": "对方并未因为他显",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1",
       "S05-3"
      ]
     },
     {
      "id": "S06-2",
      "text": "安心的时候，他觉得这份亲近格外难得，连那些不必急着证明什么的时刻都让他满足。",
      "key": "安心的时候，他觉",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1"
      ]
     },
     {
      "id": "S06-3",
      "text": "可他仍会被自己的依恋弄得有些酸楚，知道心里那部分牵念终究得由自己承受。",
      "key": "可他仍会被自己的",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-2",
       "S06-1"
      ]
     },
     {
      "id": "S06-4",
      "text": "即便如此，亲近带来的愉悦仍让他深深留恋，有时只想沉浸其中，暂时不去想自己投入了多少。",
      "key": "即便如此，亲近带",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1",
       "S06-3"
      ]
     }
    ],
    "because": [
     {
      "from": "S05-1",
      "to": "S06-1",
      "rel": "引用"
     },
     {
      "from": "S05-3",
      "to": "S06-1",
      "rel": "引用"
     },
     {
      "from": "S06-1",
      "to": "S06-2",
      "rel": "引用"
     },
     {
      "from": "S05-2",
      "to": "S06-3",
      "rel": "引用"
     },
     {
      "from": "S06-1",
      "to": "S06-3",
      "rel": "引用"
     },
     {
      "from": "S06-1",
      "to": "S06-4",
