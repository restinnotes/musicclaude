{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"心里一下热起来，连自己也有点意外。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"心里一下热起来\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越清楚，越怕关系改变\"\n        },\n        {\n          \"quote\": \"这里是刚刚踏上船板的感觉，还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"怕自己的需要成了负担\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"忽然很想靠近；却怕\"\n        },\n        {\n          \"text\": \"他只敢流露出一点喜欢\",\n          \"point\": \"只敢流露出一点喜欢\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"还不知道下次能不能坦白说出来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"裹在皮肤上有些黏稠\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"可以放弃对重力的控制，把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它既像是甜蜜的确认，又带着一点无法排遣的惆怅\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"甜蜜的确认里，也有惆怅\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"他才慢慢放松\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"对方没有退开；也想再靠近一点\"\n        },\n        {\n          \"text\": \"他怕自己太着急\",\n          \"point\": \"打破这份自在\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"怕自己太着急；也不想让这样的时刻太快过去\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"沉默并不尴尬，反而很舒服\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"反而很舒服\"\n        },\n        {\n          \"quote\": \"它只在水面上露了一下头，没有变成一场真正的倾诉\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"音乐并未走向悲剧，却在那份顺畅之中生出了阻力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他难得不去想以后\",\n          \"point\": \"舒服地待在这份亲近里\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"难得不去想以后\"\n        },\n        {\n          \"text\": \"想说喜欢、想问对方\",\n          \"point\": \"念头就淡了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想说喜欢、想问对方；却还没开口\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"本来一句话已经够了，却忍不住再说一遍，又折回来补上更多细节\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"一句已够，仍忍不住补细节\"\n        },\n        {\n          \"quote\": \"自己也许还没有意识到在害怕什么，动作已经先透露了出来\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"明明美好的东西仍在发生，两道声线仍贴得那么近，左手的水波却一直向前流，仿佛每一秒都在倒数\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"声线仍贴近\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"熟悉的亲近又让他欢喜\",\n          \"point\": \"想起上回没说的话\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"熟悉的亲近；又；上回没说的话\"\n        },\n        {\n          \"text\": \"他想把话全说出来\",\n          \"point\": \"怕让对方为难\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"想把话全说出来；也怕两人因此不自在\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"不知不觉就忘了藏好喜欢，等察觉时\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不知不觉露了心意\"\n        },\n        {\n          \"quote\": \"担心对方会嫌自己太黏\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"怕对方嫌他太黏\"\n        },\n        {\n          \"quote\": \"一个人从“我与你”的亲密中抽身，转而跌回自己的内心\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"前几次他都把话咽回去\",\n          \"point\": \"这回却没藏住喜欢\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"前几次他都把话咽回去；让对方知道他有多在乎\"\n        },\n        {\n          \"text\": \"这下他心里空落落的\",\n          \"point\": \"不知道该怎么相处\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这下；也有些害怕\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"像一个念头好不容易安静下来，却又回来\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"刚安静下来，又回来\"\n        },\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"陪你走进心里的每个角落\"\n        },\n        {\n          \"quote\": \"恍惚间却像已经成了回忆\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方看出了他的在乎\",\n          \"point\": \"没有因此疏远\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"却没有因此疏远；他这才放松下来\"\n        },\n        {\n          \"text\": \"他怕要得太多\",\n          \"point\": \"舍不舍得这份亲近\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方没看出他不安；他怕要得太多\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"也许对方有时也需要他陪着，跟他在一起也能安心些\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"也许有时也需要他陪着\"\n        },\n        {\n          \"quote\": \"身体仿佛被一股更深的渴望推着往前\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"身体被更深的渴望推着往前\"\n        },\n        {\n          \"quote\": \"你明知道自己正在被卷进去，却暂时不想出来\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方总愿意跟他待着\",\n          \"point\": \"对方也需要他的陪伴\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"总愿意；渐渐觉得\"\n        },\n        {\n          \"text\": \"想到能互相依靠\",\n          \"point\": \"盼着对方能想起他\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想到能互相依靠；高兴得忍不住笑\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"没有哲学，没有防卫，没有分析\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连身体也像恢复了弹性，甚至带一点玩心\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"快乐的余温尚