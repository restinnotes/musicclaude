{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"声音轻了、远了，悬在半空\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"轻了、远了，悬在半空\"\n        },\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"身体先于意识，隐约记起了该如何迈步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开熟悉的生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"靠什么安定下来\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却不知\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"依稀记得\"\n        },\n        {\n          \"quote\": \"节奏本身庄严、傲慢，旋律却脆弱凄婉\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连反复说这句话本身都暴露出：其实还是很在意\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"反复说本身就露出在意\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到再不能自在地过日子\",\n          \"point\": \"再不能自在地过日子\",\n          \"where\": \"前\",\n          \"waste\": \"他心里\",\n          \"keep\": \"再不能\"\n        },\n        {\n          \"text\": \"他怕一心软就忘了当初为什么要走\",\n          \"point\": 