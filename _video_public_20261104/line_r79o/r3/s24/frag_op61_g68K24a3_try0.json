{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他终于离开了熟悉生活",
     "accent": "终于离开",
     "emotion": "安心",
     "from": [
      "S01-1"
     ],
     "at": 0
    },
    {
     "text": "起初他觉得不用再委屈自己",
     "accent": "不用再委屈自己",
     "emotion": "安心",
     "from": [
      "S01-1",
      "S01-B2"
     ],
     "at": 12
    },
    {
     "text": "可他心里很快空了下来",
     "accent": "空了下来",
     "emotion": "孤单",
     "from": [
      "S01-2",
      "S01-B3",
      "S01-B4"
     ],
     "at": 36
    },
    {
     "text": "想往前走却不知怎样安定",
     "accent": "不知怎样安定",
     "emotion": "悬着",
     "from": [
      "S01-3",
      "S01-B5"
     ],
     "at": 68
    }
   ],
   "small": [
    {
     "text": "像烟雾散开，像一次召唤等着回声",
     "after": 0,
     "from": [
      "S01-B1"
     ],
     "bars": "1–6",
     "at": 5
    },
    {
     "text": "我不能倒下，可我其实很想停下来",
     "after": 1,
     "from": [
      "S01-B2"
     ],
     "bars": "",
     "at": 20
    },
    {
     "text": "分不清心里是愤怒遗憾还是怀念",
     "after": 2,
     "from": [
      "S01-B3"
     ],
     "bars": "",
     "at": 42
    },
    {
     "text": "冷空中胸口发紧，视线模糊伸手摸空",
     "after": 2,
     "from": [
      "S01-B4"
     ],
     "bars": "",
     "at": 50
    },
    {
     "text": "旧日声音和光线回来，却回不到现在",
     "after": 3,
     "from": [
      "S01-B5"
     ],
     "bars": "9–17",
     "at": 76
    },
    {
     "text": "身体先于意识记起怎样迈步",
     "after": 3,
     "from": [
      "S01-B5"
     ],
     "bars": "18–23",
     "at": 86
    }
   ],
   "notes": [
    {
     "text": "重和弦之后，声音轻轻往高处散开",
     "from": [
      "S01-B1"
     ],
     "bars": "1–6"
    },
    {
     "text": "短句被停顿截断，余音在冷空气里散尽",
     "from": [
      "S01-B3"
     ],
     "bars": "1–23"
    },
    {
     "text": "旋律轮廓渐渐清楚",
     "from": [
      "S01-B5"
     ],
     "bars": "9–17"
    },
    {
     "text": "波兰舞步逐渐浮现",
     "from": [
      "S01-B5"
     ],
     "bars": "18–23"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "他舍不得从前自在的日子",
     "accent": "舍不得",
     "emotion": "亲密",
     "from": [
      "S02-1",
      "S02-B1"
     ],
     "at": 0
    },
    {
     "text": "想到以后不能那样过他就心慌",
     "accent": "心慌",
     "emotion": "不安",
     "from": [
      "S02-1",
      "S02-B1"
     ],
     "at": 12
    },
    {
     "text": "他赶紧提醒自己别忘了受过的气",
     "accent": "受过的气",
     "emotion": "不安",
     "from": [
      "S02-2",
      "S02-B4"
     ],
     "at": 31
    },
    {
     "text": "他不甘心连以前的好日子也丢掉",
     "accent": "不甘心",
     "emotion": "炽热",
     "from": [
      "S02-3",
      "S02-B5"
     ],
     "at": 51
    }
   ],
   "small": [
    {
     "text": "庄严舞步下，旋律像远处旧歌只能模糊哼",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "",
     "at": 5
    },
    {
     "text": "腿脚虚浮地挪着舞步",
     "after": 0,
     "from": [
      "S02-B2"
     ],
     "bars": "",
     "at": 18
    },
    {
     "text": "呼吸被连绵音流催得越来越急",
     "after": 1,
     "from": [
      "S02-B3"
     ],
     "bars": "56–65",
     "at": 58
    },
    {
     "text": "他抬头整理衣服，不让人看出动摇",
     "after": 2,
     "from": [
      "S02-B4"
     ],
     "bars": "",
     "at": 36
    },
    {
     "text": "先信几分，再逼自己信，越说越显在意",
     "after": 2,
     "from": [
      "S02-B4"
     ],
     "bars": "44–65",
     "at": 43
    },
    {
     "text": "我不甘心就这样消亡",
     "after": 3,
     "from": [
      "S02-B5"
     ],
     "bars": "44–65",
     "at": 56
    }
   ],
   "notes": [
    {
     "text": "伴奏里细碎的音符不安地蠕动",
     "from": [
      "S02-B2"
     ],
     "bars": "24–65"
    },
    {
     "text": "音乐猛地上冲又退下，随后再次聚起",
     "from": [
      "S02-B3"
     ],
     "bars": "38–65"
    },
    {
     "text": "急促的声音连成一片持续滚动",
     "from": [
      "S02-B3"
     ],
     "bars": "56–65"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他心里还憋着一股气",
     "accent": "憋着一股气",
     "emotion": "炽热",
     "from": [
      "S03-1",
      "S03-B1"
     ],
     "at": 0
    },
    {
     "text": "想起曾被当作自己人他短暂高兴",
     "accent": "短暂高兴",
     "emotion": "欢喜",
     "from": [
      "S03-1",
      "S03-B2"
     ],
     "at": 4
    },
    {
     "text": "可那点高兴很快变酸",
     "accent": "变酸",
     "emotion": "孤单",
     "from": [
      "S03-2",
      "S03-B2"
     ],
     "at": 15
    },
    {
     "text": "离开以后真的会更好吗？",
     "accent": "更好吗",
     "emotion": "悬着",
     "from": [
      "S03-2",
      "S03-B5"
     ],
     "at": 22
    }
   ],
   "small": [
    {
     "text": "麦浪微风般亲切，越发觉与眼前隔得远",
     "after": 1,
     "from": [
      "S03-B2"
     ],
     "bars": "80–91",
     "at": 7
    },
    {
     "text": "像出去走走暂避伤口，轻松却没答案",
     "after": 2,
     "from": [
      "S03-B3"
     ],
     "bars": "",
     "at": 18
    },
    {
     "text": "耳边多人低语缠绕，脚下如流沙",
     "after": 2,
     "from": [
      "S03-B4"
     ],
     "bars": "",
     "at": 21
    },
    {
     "text": "刚才那股昂扬，他真信了吗？",
     "after": 3,
     "from": [
      "S03-B5"
     ],
     "bars": "",
     "at": 25
    }
   ],
   "notes": [
    {
     "text": "重重一击落下，声音忽强忽弱",
     "from": [
      "S03-B1"
     ],
     "bars": "66–91"
    },
    {
     "text": "前半急切，后半忽然柔和轻盈",
     "from": [
      "S03-B2"
     ],
     "bars": "66–91"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "他真盼着还能那样亲近",
     "accent": "真盼着",
     "emotion": "亲密",
     "from": [
      "S04-1",
      "S04-B1"
     ],
     "at": 0
    },
    {
     "text": "可当初受的委屈又翻上来",
     "accent": "委屈又翻上来",
     "emotion": "不安",
     "from": [
      "S04-2",
      "S04-B2"
     ],
     "at": 10
    },
    {
     "text": "他反复问那一步走对了吗？",
     "accent": "走对了吗",
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ],
     "at": 22
    },
    {
     "text": "没走的话如今会怎样？",
     "accent": "会怎样",
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ],
     "at": 29
    }
   ],
   "small": [
    {
     "text": "旧日温暖带回感激和短暂幸福",
     "after": 0,
     "from": [
      "S04-B1"
     ],
     "bars": "92–107",
     "at": 5
    },
    {
     "text": "那份坚定更像他努力想成为的样子",
     "after": 0,
     "from": [
      "S04-B1"
     ],
     "bars": "92–107",
     "at": 8
    },
    {
     "text": "过去太好，越想越觉得回不去了",
     "after": 1,
     "from": [
      "S04-B2"
     ],
     "bars": "108–115",
     "at": 15
    },
    {
     "text": "脚步急了，心跳乱了，像被时间催着跑",
     "after": 2,
     "from": [
      "S04-B3"
     ],
     "bars": "",
     "at": 24
    },
    {
     "text": "他不停往前赶，只为不让自己停下来",
     "after": 3,
     "from": [
      "S04-B4"
     ],
     "bars": "94–115",
     "at": 27
    }
   ],
   "notes": [
    {
     "text": "后段骤然紧绷，旋律又一步步往下退",
     "from": [
      "S04-B2"
     ],
     "bars": "108–115"
    },
    {
     "text": "细碎声音急促，低处的声音一路追赶",
     "from": [
      "S04-B3"
     ],
     "bars": "92–115"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "他仍觉得当初那些气不该忍",
     "accent": "不该忍",
     "emotion": "炽热",
     "from": [
      "S05-1",
      "S05-B2"
     ],
     "at": 0
    },
    {
     "text": "他也不愿连开心回忆都不敢想",
     "accent": "开心回忆",
     "emotion": "悬着",
     "from": [
      "S05-1",
      "S05-B2"
     ],
     "at": 10
    },
    {
     "text": "跟自己争久了他渐渐没力气",
     "accent": "没力气",
     "emotion": "孤单",
     "from": [
      "S05-2",
      "S05-B5"
     ],
     "at": 26
    },
    {
     "text": "想到已不在那些人身边他难受",
     "accent": "不在那些人身边",
     "emotion": "孤单",
     "from": [
      "S05-2",
      "S05-B3"
     ],
     "at": 39
    }
   ],
   "small": [
    {
     "text": "柔声里仍有股劲：这事不能就这样算了",
     "after": 0,
     "from": [
      "S05-B2"
     ],
     "bars": "116–127",
     "at": 15
    },
    {
     "text": "旧日记忆有了温度，可能是某个人或故乡",
     "after": 2,
     "from": [
      "S05-B3"
     ],
     "bars": "",
     "at": 31
    },
    {
     "text": "两只手像夜色里的影子，彼此低声说话",
     "after": 3,
     "from": [
      "S05-B1"
     ],
     "bars": "",
     "at": 42
    },
    {
     "text": "脚下像突然没了地板，只剩一个声音",
     "after": 3,
     "from": [
      "S05-B4"
     ],
     "bars": "128–147",
     "at": 46
    },
    {
     "text": "几次深呼吸后松开一点，却只是累了",
     "after": 3,
     "from": [
      "S05-B5"
     ],
     "bars": "144–147",
     "at": 50
    }
   ],
   "notes": [
    {
     "text": "快速流动的声音渐渐放慢，最后稀疏下来",
     "from": [
      "S05-B4"
     ],
     "bars": "128–147"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "难受缓下来他没再压住想念",
     "accent": "没再压住想念",
     "emotion": "孤单",
     "from": [
      "S06-1",
      "S06-B1",
      "S06-B2"
     ],
     "at": 0
    },
    {
     "text": "他才懂从前有人陪着多轻松",
     "accent": "多轻松",
     "emotion": "亲密",
     "from": [
      "S06-2",
      "S06-B2"
     ],
     "at": 13
    },
    {
     "text": "他很想再有那种自然亲近",
     "accent": "很想再有",
     "emotion": "亲密",
     "from": [
      "S06-3",
      "S06-B3"
     ],
     "at": 27
    },
    {
     "text": "可他怕以后再也遇不到",
     "accent": "再也遇不到",
     "emotion": "不安",
     "from": [
      "S06-3",
      "S06-B3"
     ],
     "at": 41
    },
    {
     "text": "想起真切拥有过他心里暖了",
     "accent": "心里暖了",
     "emotion": "安心",
     "from": [
      "S06-4",
      "S06-B4"
     ],
     "at": 58
    }
   ],
   "small": [
    {
     "text": "像隔着玻璃听母亲哼摇篮曲",
     "after": 0,
     "from": [
      "S06-B1"
     ],
     "bars": "",
     "at": 6
    },
    {
     "text": "安宁难久留，现实也没有变好",
     "after": 0,
     "from": [
      "S06-B1"
     ],
     "bars": "",
     "at": 10
    },
    {
     "text": "不用解释难过，也不用装坚强",
     "after": 1,
     "from": [
      "S06-B2"
     ],
     "bars": "",
     "at": 18
    },
    {
     "text": "像向某个遥远又不确定的对象祈求",
     "after": 3,
     "from": [
      "S06-B2"
     ],
     "bars": "",
     "at": 32
    },
    {
     "text": "远去的家园在梦里忽然被照亮",
     "after": 3,
     "from": [
      "S06-B2"
     ],
     "bars": "约160",
     "at": 43
    },
    {
     "text": "终于敢说心里话，也轻轻看着挽不回的事",
     "after": 4,
     "from": [
      "S06-B3",
      "S06-B4"
     ],
     "bars": "",
     "at": 63
    }
   ],
   "notes": [
    {
     "text": "绵长的声音让四周近乎停驻",
     "from": [
      "S06-B1"
     ],
     "bars": "148–180"
    },
    {
     "text": "歌声带着近乎祈祷的庄严",
     "from": [
      "S06-B2"
     ],
     "bars": "148–180"
    },
    {
     "text": "先含蓄试探，随后展开得更迫切，末尾停在未完处",
     "from": [
      "S06-B3"
     ],
     "bars": "148–180"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "以后遇上难事还得独自扛吗？",
     "accent": "独自扛吗",
     "emotion": "不安",
     "from": [
      "S07-1",
      "S07-B1",
      "S07-B3"
     ],
     "at": 0
    },
    {
     "text": "当初只想着不再受气",
     "accent": "不再受气",
     "emotion": "安心",
     "from": [
      "S07-2"
     ],
     "at": 8
    },
    {
     "text": "早知道这么孤单还会走吗？",
     "accent": "还会走吗",
     "emotion": "孤单",
     "from": [
      "S07-2",
      "S07-B4"
     ],
     "at": 18
    },
    {
     "text": "他想找回亲近又不愿再受气",
     "accent": "不愿再受气",
     "emotion": "悬着",
     "from": [
      "S07-3",
      "S07-B2",
      "S07-B5"
     ],
     "at": 32
    },
    {
     "text": "连当初离开的决心也找不回",
     "accent": "找不回",
     "emotion": "孤单",
     "from": [
      "S07-3",
      "S07-B5"
     ],
     "at": 43
    }
   ],
   "small": [
    {
     "text": "寒风猛地吹开窗，后颈一凉心跳加快",
     "after": 0,
     "from": [
      "S07-B1"
     ],
     "bars": "182附近",
     "at": 4
    },
    {
     "text": "舞步突然闯进来，场景换了心里却没安定",
     "after": 3,
     "from": [
      "S07-B2",
      "S07-B5"
     ],
     "bars": "182–197",
     "at": 22
    },
    {
     "text": "心里发颤想冲出去却找不到出口",
     "after": 4,
     "from": [
      "S07-B3"
     ],
     "bars": "198–205",
     "at": 39
    },
    {
     "text": "熟悉动作和舞蹈闯进来，反而更觉失去",
     "after": 4,
     "from": [
      "S07-B4"
     ],
     "bars": "181–205",
     "at": 46
    }
   ],
   "notes": [
    {
     "text": "高音区忽然响起一串细长颤动的声音",
     "from": [
      "S07-B1"
     ],
     "bars": "182附近"
    },
    {
     "text": "舞蹈节奏突然闯入，步态不再完整",
     "from": [
      "S07-B2",
      "S07-B5"
     ],
     "bars": "182–197"
    },
    {
     "text": "连续的颤动声越积越紧",
     "from": [
      "S07-B3"
     ],
     "bars": "198–205"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "他暂且把回去放一边",
     "accent": "放一边",
     "emotion": "悬着",
     "from": [
      "S08-1"
     ],
     "at": 0
    },
    {
     "text": "想起曾被当作自己人心里一暖",
     "accent": "心里一暖",
     "emotion": "亲密",
     "from": [
      "S08-1",
      "S08-B1"
     ],
     "at": 4
    },
    {
     "text": "这点暖意没让他回头",
     "accent": "没让他回头",
     "emotion": "悬着",
     "from": [
      "S08-1",
      "S08-B2"
     ],
     "at": 8
    },
    {
     "text": "想到以后难处回忆陪不了他",
     "accent": "回忆陪不了他",
     "emotion": "不安",
     "from": [
      "S08-2",
      "S08-B2",
      "S08-B3"
     ],
     "at": 11
    }
   ],
   "small": [
    {
     "text": "只短暂回头一眼，胸口终于吸进一口气",
     "after": 3,
     "from": [
      "S08-B2",
      "S08-B3"
     ],
     "bars": "",
     "at": 14
    }
   ],
   "notes": [
    {
     "text": "缓慢宽广的歌唱短暂回来",
     "from": [
      "S08-B1"
     ],
     "bars": "206–213"
    }
   ]
  },
  {
   "sec": "S09",
   "big": [
    {
     "text": "他忽然说不清自己为何想回去",
     "accent": "说不清",
     "emotion": "悬着",
     "from": [
      "S09-1",
      "S09-B2"
     ],
     "at": 0
    },
    {
     "text": "是舍不得被当作自己人",
     "accent": "舍不得",
     "emotion": "亲密",
     "from": [
      "S09-1"
     ],
     "at": 4
    },
    {
     "text": "还是怕孤单到愿意再受那些气",
     "accent": "愿意再受那些气",
     "emotion": "不安",
     "from": [
      "S09-1",
      "S09-B2"
     ],
     "at": 10
    },
    {
     "text": "这念头让他心慌得不敢往下想",
     "accent": "不敢往下想",
     "emotion": "不安",
     "from": [
      "S09-2",
      "S09-B2"
     ],
     "at": 18
    }
   ],
   "small": [
    {
     "text": "刚有点稳定又散开，像从另一面看见门",
     "after": 0,
     "from": [
      "S09-B1"
     ],
     "bars": "214–215",
     "at": 7
    },
    {
     "text": "又遇见那个自己，这回知道他经历过什么",
     "after": 3,
     "from": [
      "S09-B2"
     ],
     "bars": "214–215",
     "at": 21
    }
   ],
   "notes": [
    {
     "text": "颤动的声音里，开头的引子阴冷闪现",
     "from": [
      "S09-B1"
     ],
     "bars": "214–215"
    }
   ]
  },
  {
   "sec": "S10",
   "big": [
    {
     "text": "他最舍不得被当作自己人",
     "accent": "最舍不得",
     "emotion": "亲密",
     "from": [
      "S10-1",
      "S10-B1"
     ],
     "at": 0
    },
    {
     "text": "可回去还能像从前那样吗？",
     "accent": "还能像从前那样吗",
     "emotion": "悬着",
     "from": [
      "S10-1",
      "S10-B1"
     ],
     "at": 4
    },
    {
     "text": "受过的委屈让他不敢放心回去",
     "accent": "不敢放心回去",
     "emotion": "不安",
     "from": [
      "S10-2"
     ],
     "at": 9
    },
    {
     "text": "走过许多仍想不出怎样生活",
     "accent": "想不出怎样生活",
     "emotion": "悬着",
     "from": [
      "S10-3",
      "S10-B3"
     ],
     "at": 14
    },
    {
     "text": "眼下日子也过得不踏实",
     "accent": "不踏实",
     "emotion": "不安",
     "from": [
      "S10-3"
     ],
     "at": 18
    }
   ],
   "small": [
    {
     "text": "他像悬在半空，辨不清方向",
     "after": 4,
     "from": [
      "S10-B2"
     ],
     "bars": "221–225",
     "at": 19
    },
    {
     "text": "往事明明重要，他却没力气再讲",
     "after": 3,
     "from": [
      "S10-B4"
     ],
     "bars": "216–225",
     "at": 20
    }
   ],
   "notes": [
    {
     "text": "熟悉旋律断断续续，只剩零碎片段",
     "from": [
      "S10-B1"
     ],
     "bars": "216–225"
    },
    {
     "text": "摇篮曲般的声音破碎重现，更显凄厉",
     "from": [
      "S10-B1"
     ],
     "bars": "216–225"
    }
   ]
  },
  {
   "sec": "S11",
   "big": [
    {
     "text": "明知未必找回亲近他仍盼万一",
     "accent": "仍盼万一",
     "emotion": "悬着",
     "from": [
      "S11-1",
      "S11-B2"
     ],
     "at": 0
    },
    {
     "text": "他不愿只凭指望回去忍让",
     "accent": "不愿",
     "emotion": "炽热",
     "from": [
      "S11-2"
     ],
     "at": 4
    },
    {
     "text": "他想先把眼下日子过稳",
     "accent": "先把眼下日子过稳",
     "emotion": "安心",
     "from": [
      "S11-3",
      "S11-B2"
     ],
     "at": 9
    },
    {
     "text": "怕以后独自扛他仍不改主意",
     "accent": "仍不改主意",
     "emotion": "炽热",
     "from": [
      "S11-4",
      "S11-B1",
      "S11-B3"
     ],
     "at": 14
    }
   ],
   "small": [
    {
     "text": "像困兽一次次顶住，爆发后压力又来",
     "after": 1,
     "from": [
      "S11-B1"
     ],
     "bars": "226–237",
     "at": 6
    },
    {
     "text": "祈祷变成意志，紧张未解却不再停住",
     "after": 3,
     "from": [
      "S11-B2",
      "S11-B3"
     ],
     "bars": "",
     "at": 16
    }
   ],
   "notes": [
    {
     "text": "低沉声音翻涌，重重的音响一次次砸下",
     "from": [
      "S11-B1"
     ],
     "bars": "226–241"
    },
    {
     "text": "波兰舞步从试探渐渐聚拢",
     "from": [
      "S11-B2"
     ],
     "bars": "226–241"
    }
   ]
  },
  {
   "sec": "S12",
   "big": [
    {
     "text": "委屈不该忍从前也开心过",
     "accent": "不该忍",
     "emotion": "炽热",
     "from": [
      "S12-1",
      "S12-B2"
     ],
     "at": 0
    },
    {
     "text": "他不再逼自己选边",
     "accent": "不再逼自己选边",
     "emotion": "安心",
     "from": [
      "S12-1"
     ],
     "at": 5
    },
    {
     "text": "他不怪离开也不为陪伴回头",
     "accent": "不为陪伴回头",
     "emotion": "安心",
     "from": [
      "S12-2",
      "S12-B2"
     ],
     "at": 10
    },
    {
     "text": "他愿带着想念继续过日子",
     "accent": "带着想念",
     "emotion": "安心",
     "from": [
      "S12-2",
      "S12-B2"
     ],
     "at": 15
    }
   ],
   "small": [
    {
     "text": "步子沉沉落地，像带着集体感的昂扬",
     "after": 0,
     "from": [
      "S12-B1"
     ],
     "bars": "",
     "at": 4
    },
    {
     "text": "经历动摇后仍能站稳，不必装作没受过伤",
     "after": 2,
     "from": [
      "S12-B2"
     ],
     "bars": "",
     "at": 12
    },
    {
     "text": "脚步向前时，地面忽然斜了一下",
     "after": 3,
     "from": [
      "S12-B3"
     ],
     "bars": "249–253",
     "at": 18
    }
   ],
   "notes": [
    {
     "text": "熟悉的舞步以雷鸣般声势轰然回来",
     "from": [
      "S12-B1"
     ],
     "bars": "242–253"
    },
    {
     "text": "昂扬步伐中途忽然换了色彩",
     "from": [
      "S12-B3"
     ],
     "bars": "249–253"
    }
   ]
  },
  {
   "sec": "S13",
   "big": [
    {
     "text": "想起从前亲近他心里又热了",
     "accent": "心里又热了",
     "emotion": "欢喜",
     "from": [
      "S13-1",
      "S13-B1"
     ],
     "at": 0
    },
    {
     "text": "他盼以后再有那样的亲近",
     "accent": "盼以后再有",
     "emotion": "亲密",
     "from": [
      "S13-1",
      "S13-B1"
     ],
     "at": 8
    },
    {
     "text": "他想好好过日子不再较劲",
     "accent": "好好过日子",
     "emotion": "炽热",
     "from": [
      "S13-2",
      "S13-B1",
      "S13-B2"
     ],
     "at": 20
    },
    {
     "text": "再有人当他自己人他会珍惜",
     "accent": "他会珍惜",
     "emotion": "亲密",
     "from": [
      "S13-4"
     ],
     "at": 32
    },
    {
     "text": "即使没有他也好好过不咽委屈",
     "accent": "不咽委屈",
     "emotion": "安心",
     "from": [
      "S13-4"
     ],
     "at": 40
    }
   ],
   "small": [
    {
     "text": "温柔歌声站到明亮处，带来故土记忆和希望",
     "after": 0,
     "from": [
      "S13-B1"
     ],
     "bars": "254–270",
     "at": 5
    },
    {
     "text": "密集音符像激流冲天，心跳几乎到极限",
     "after": 1,
     "from": [
      "S13-B1"
     ],
     "bars": "254–270",
     "at": 14
    },
    {
     "text": "一股气流推着人往前跑，兴奋得喘不过气",
     "after": 2,
     "from": [
      "S13-B2"
     ],
     "bars": "269–280",
     "at": 27
    },
    {
     "text": "刚有的成功还稳吗？又像终于能喘口气",
     "after": 3,
     "from": [
      "S13-B3"
     ],
     "bars": "281–287",
     "at": 42
    },
    {
     "text": "怕亲近的人还要等很久，心里渐渐静了",
     "after": 4,
     "from": [
      "S13-3",
      "S13-B3"
     ],
     "bars": "281–287",
     "at": 44
    },
    {
     "text": "最高音像孤悬寒星，也像意志落定或梦醒",
     "after": 4,
     "from": [
      "S13-B4",
      "S13-B5"
     ],
     "bars": "286–288",
     "at": 46
    }
   ],
   "notes": [
    {
     "text": "柔软的歌声忽然铺展成宏大庄严的声音",
     "from": [
      "S13-B1"
     ],
     "bars": "254–270"
    },
    {
     "text": "明亮急促的声音一下子向前冲出",
     "from": [
      "S13-B2",
      "S13-B3"
     ],
     "bars": "269–287"
    },
    {
     "text": "低处两声耳语般轻响后，高处忽然清脆如钟",
     "from": [
      "S13-B4"
     ],
     "bars": "末尾几小节"
    }
   ]
  }
 ]
}