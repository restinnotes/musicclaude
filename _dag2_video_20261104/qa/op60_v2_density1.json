    {
      "sec": "S06",
      "body_font": 25,
      "bead_nodes": [
        "S06-B1",
        "S06-B3",
        "S06-B2",
        "S06-B4"
      ],
      "bead_edges": [
        {
          "a": "S06-B1",
          "b": "S06-B2",
          "type": "可同时成立",
          "note": "B1是新主题入口处的音色、空间及记忆质地；B2是新旋律内部低声而不安的声部运动。外层清澈舒展与内层反复纠缠可以同时被听到。无需先纯净、再不安的剧情。"
        },
        {
          "a": "S06-B2",
          "b": "S06-B3",
          "type": "重叠但新增",
          "note": "B2已有私人心事及反复迟疑，B3新增亲密相处以后独处反而心酸、某些内心无法由别人陪伴进入的具体关系经验。它不是B2那个人物必然经历的下一幕。"
        },
        {
          "a": "S06-B1",
          "b": "S06-B3",
          "type": "另一种理解",
          "note": "B1把清澈听成童年或第一次心动般的纯净回忆，B3则听成亲密之后独处的酸楚。它们共享向内回望的距离感，但回望的对象及情绪不同，适合分别选择，不应拼成同一人物的前后故事。"
        },
        {
          "a": "S06-B1",
          "b": "S06-B4",
          "type": "另一种理解",
          "note": "B1所依据的原稿倾向于感官热度退潮、出现透明纯净的空间；B4依据的原稿明确感到40–50小节有强烈感官享受。两种心理取景有真实差别，不将它们硬说成先后发生。伴奏变薄这一听觉观察本身并不排斥B4的感官愉悦。"
        },
        {
          "a": "S06-B2",
          "b": "S06-B4",
          "type": "可同时成立",
          "note": "B2的低声不安、念头反复，与B4的身体沉醉可以同时存在；但没有证据表明反复的心事在40–50小节内部逐渐导致感官沉迷。"
        }
      ],
