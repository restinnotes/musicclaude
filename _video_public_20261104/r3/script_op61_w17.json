    "S13"
   ]
  }
 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "我离开了熟悉的生活，起初觉得终于不用再一次次委屈自己。",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "生气还是想念？",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ],
       "emotion": "悬着"
      },
      {
       "text": "伸手只摸到虚空",
       "keys": [],
       "from": [
        "S01-B4-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可这份笃定很快散了，我心里空落落的，不知舍不得什么。",
       "keys": [],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "挺直背脊 不能倒下",
       "keys": [],
       "from": [
        "S01-B1-p1"
       ]
      },
      {
       "text": "很想停下来",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "我仍想往前走，却不知靠什么安定下来。",
       "keys": [],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "记得清楚却回不去",
       "keys": [],
       "from": [
        "S01-B5-p2"
       ]
      },
      {
       "text": "身体先记起迈步",
       "keys": [],
       "from": [
        "S01-B5-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "我舍不得从前自在的日子，一想到以后不能再那样过，心里就慌。",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "记得却不能再拥有",
       "keys": [],
       "from": [
        "S02-B1-p4"
       ]
      },
      {
       "text": "腿脚虚浮",
       "keys": [],
       "from": [
        "S02-B2-p1"
       ],
       "emotion": "不安"
      },
      {
       "text": "冲上去又退回来",
       "keys": [],
       "from": [
        "S02-B3-p1"
       ],
       "emotion": "不安"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "心一软，我便提醒自己：当初是受不了那些气才走。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "越说没事越在意",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "可我不甘心，难道不再受气，就得连好日子也丢掉？",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "还不肯认输",
       "keys": [],
       "from": [
        "S02-B5-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "我心里还憋着气，可想起和他们在一起、被他们当作自己人时，竟又高兴了一小会儿。",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "故乡夏日的麦浪",
       "keys": [],
       "from": [
        "S03-B2-p2"
       ],
       "emotion": "亲密"
      },
      {
       "text": "温柔得让人心颤",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可那点高兴转眼成了酸楚：离开后就一定更好过吗？",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "越怀念越觉得远",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起和他们亲近时，我有一阵真盼着一切还能像从前那样继续。",
       "keys": [],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧记忆忽然鲜活",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      },
      {
       "text": "柔软得容易受伤",
       "keys": [],
       "from": [
        "S04-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可我又怀疑当初是否走错，却想不出没走会怎样。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "美好回忆也刺痛",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "还能挽回吗？",
       "keys": [],
       "from": [
        "S04-B4-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我仍不服气，觉得当初那些气不该忍；可连过去开心的事都不敢多想，也太为难自己。",
       "keys": [],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "夜色里并肩低语",
       "keys": [],
       "from": [
        "S05-B1-p2"
       ]
      },
      {
       "text": "不能就这样算了",
       "keys": [],
       "from": [
        "S05-B2-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "眷恋里带着失落",
       "keys": [],
       "from": [
        "S05-B3-p3"
       ],
       "emotion": "孤单"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "争得累了，不服气渐渐淡去；想到已不在他们身边，我只觉难受。",
       "keys": [],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不是想通只是累了",
       "keys": [],
       "from": [
        "S05-B5-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "难受缓下来后，我想起和他们在一起、不必时时防备的日子，这回没急着用受过的气压住想念。",
       "keys": [],
       "from": [
        "S06-1",
        "S06-2",
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "暂时不用防备",
       "keys": [],
       "from": [
        "S06-B1-p4"
       ],
       "emotion": "安心"
      },
      {
       "text": "压住的心事浮上来",
       "keys": [],
       "from": [
        "S06-B2-p3"
       ],
       "emotion": "孤单"
      },
      {
       "text": "好好看着 不必抓回来",
       "keys": [],
       "from": [
        "S06-B4-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "独自熬过难处，我才懂陪伴可贵，也怕再无那样的亲近。",
       "keys": [],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "盼着回应却没把握",
       "keys": [],
       "from": [
        "S06-B2-p4"
       ],
       "emotion": "悬着"
      },
      {
       "text": "话停在一半",
       "keys": [],
       "from": [
        "S06-B3-p3"
       ],
       "emotion": "悬着"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，我却猛然想到：以后再遇上难事，要还是只能一个人扛，我真撑得住吗？",
       "keys": [],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "寒风猛地吹进来",
       "keys": [],
       "from": [
        "S07-B1-p2"
       ]
      },
      {
       "text": "从甜梦里惊醒",
       "keys": [],
       "from": [
        "S07-B1-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "没料到离开后这么孤单；早知如此，我还会走吗？",
       "keys": [],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "事情过去了 身体还不信",
       "keys": [],
       "from": [
        "S07-B3-p2"
       ]
      },
      {
       "text": "想冲出去却找不到出口",
       "keys": [],
       "from": [
        "S07-B3-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "我想找回亲近，却不愿再受气，也找不回当初的决心。",
       "keys": [],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "越熟悉越看见失去",
       "keys": [],
       "from": [
        "S07-B4-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我暂时把回不回去放到一边，想起从前和他们亲近的时光，心里又暖了一会儿。",
       "keys": [],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "回头一眼 温柔又不舍",
       "keys": [],
       "from": [
        "S08-B2-p2",
        "S08-B2-p3"
       ]
      },
      {
       "text": "胸口终于吸进一口气",
       "keys": [],
       "from": [
        "S08-B3-p1"
       ],
       "emotion": "安心"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可暖意很快散了，往后遇上难事，回忆也陪不了我。",
       "keys": [],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "安静刚认出就退去",
       "keys": [],
       "from": [
        "S08-B2-p1"
       ]
      },
      {
       "text": "还没来得及安顿",
       "keys": [],
       "from": [
        "S08-B2-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "我忽然说不清，想回去是舍不得从前的生活，还是难受时只想有人陪；这念头让我一阵心慌，连往下想都不敢。",
       "keys": [],
       "from": [
        "S09-1",
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "最初的问题又浮上来",
       "keys": [],
       "from": [
        "S09-B2-p2"
       ]
      },
      {
       "text": "没有简单答案",
       "keys": [],
       "from": [
        "S09-B2-p2"
       ],
       "emotion": "悬着"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "我慢慢觉得，最舍不得的还是从前被他们当作自己人的日子；可就算真回去，还能像从前那样吗？何况受过的气也不能当作没发生过，光凭舍不得，我仍没法放心回去。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音回来却没完整铺开",
       "keys": [],
       "from": [
        "S10-B1-p5"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "想来想去仍无答案，眼下也过得不踏实。",
       "keys": [],
       "from": [
        "S10-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "走了这么久还是没答案",
       "keys": [],
       "from": [
        "S10-B3-p2"
       ]
      },
      {
       "text": "累得不想再讲一遍",
       "keys": [],
       "from": [
        "S10-B4-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我明知回去未必找得回那份亲近，还是忍不住想：万一能呢？可我再心动，也不愿只凭这点指望回去继续忍让。",
       "keys": [],
       "from": [
        "S11-3",
        "S11-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "祈祷变成意志",
       "keys": [],
       "from": [
        "S11-B2-p2"
       ]
      },
      {
       "text": "害怕还在 脚已经往前",
       "keys": [],
       "from": [
        "S11-B3-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "回不回去以后再定，我先把眼下过稳；虽怕独扛，也不收回打算。",
       "keys": [],
       "from": [
        "S11-1",
        "S11-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "一次次顶住再用力",
       "keys": [],
       "from": [
        "S11-B1-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我知道当初那些气确实不该忍，和他们在一起时也确实开心过，这些都可以记着。",
       "keys": [],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "犹豫也自己作决定",
       "keys": [],
       "from": [
        "S12-B1-p1"
       ]
      },
      {
       "text": "不必假装没受过伤",
       "keys": [],
       "from": [
        "S12-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "我仍会心软怕孤单，却不怪自己离开，也不为陪伴回头。",
       "keys": [],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "脚下一晃 仍继续向前",
       "keys": [],
       "from": [
        "S12-B3-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我又想起从前自然亲近的日子，心里热起来，也盼以后还能那样相处。",
       "keys": [],
       "from": [
        "S13-2",
        "S13-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "柔软的歌也唱进高潮",
       "keys": [],
       "from": [
        "S13-B1-p3"
       ]
      },
      {
       "text": "兴奋得顾不上喘气",
       "keys": [],
       "from": [
        "S13-B2-p2"
       ],
       "emotion": "炽热"
      },
      {
       "text": "终于下定决心",
       "keys": [],
       "from": [
        "S13-B5-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "这念头给了我劲头，我想把往后的日子过好，不再和过去较劲。",
       "keys": [],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "想起故土",
       "keys": [],
       "from": [
        "S13-B1-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "往后或许仍孤单；有人把我当自己人便珍惜，没有也不再委屈自己。",
       "keys": [],
       "from": [
        "S13-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "它真的已经牢固了吗？",
       "keys": [],
       "from": [
        "S13-B3-p2"
       ]
      }
     ]
    }
   ]
  }
 ]
}