        .product .product_wrapper .slider_wrapper .onsale {
          position: absolute;
          top: -20px;
          right: -64px;
          z-index: 999;
          width: 0px;
          height: 0px;
          border-style: inset;
          border-width: 0 100px 100px 100px;
          border-color: transparent transparent #f7941d transparent;
          transform: rotate(45deg);
          -ms-transform: rotate(45deg);
