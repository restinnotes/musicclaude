      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S13",
    "bars": "103–110",
    "relation": "正在面对",
    "items": [
     {
      "id": "S13-1",
      "text": "心里终于有了愿意坦诚的方向，他感到长久悬着的愿望靠近了一点，却清楚自己还没有真正得到理解。",
      "key": "心里终于有了愿意",
      "follows": false,
      "explains": [],
      "cite": [
       "S12-4"
      ]
     },
     {
      "id": "S13-2",
      "text": "他仍深深享受这份亲密的幸福，可一想到对方未必能够承受自己的脆弱，心里便又添了苦涩。",
      "key": "他仍深深享受这份",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-3"
      ]
