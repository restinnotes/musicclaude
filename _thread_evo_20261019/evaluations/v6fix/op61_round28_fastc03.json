      "rel": "引用"
     },
     {
      "from": "S10-1",
      "to": "S11-2",
      "rel": "引用"
     },
     {
      "from": "S11-2",
      "to": "S11-3",
      "rel": "引用"
     },
     {
      "from": "S06-2",
      "to": "S11-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "242–253",
    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "他终于能坦然承认自己舍不得旧日的亲近，而不必立刻替当初的离开辩护。",
      "key": "他终于能坦然承认",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-2",
       "S07-2",
       "S11-3"
      ]
     },
     {
      "id": "S12-2",
      "text": "不愿再靠忍让换得一个位置，这一点在他心里仍然很清楚，也不因那份舍不得而站不住。",
      "key": "不愿再靠忍让换得",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S12-1"
      ]
     },
     {
      "id": "S12-3",
      "text": "偶尔想到以后也许还是会一个人，他仍会动摇，却不再觉得这点动摇就非得让自己马上回去。",
      "key": "偶尔想到以后也许",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-2",
       "S07-2",
       "S12-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S04-2",
      "to": "S12-1",
      "rel": "引用"
     },
     {
      "from": "S07-2",
      "to": "S12-1",
      "rel": "引用"
     },
     {
      "from": "S11-3",
