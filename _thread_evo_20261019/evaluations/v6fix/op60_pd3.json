    "bars": "51–61",
    "relation": "正在面对",
    "items": [
     {
      "id": "S07-1",
      "text": "即使回想已经让他这么累，他还是很想回到曾经与对方亲近的时候。",
      "key": "即使回想已经让他",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-3"
      ]
     },
     {
      "id": "S07-2",
      "text": "他为自己再怎么舍不得也改变不了现在而难过，一时连放松回忆都做不到。",
      "key": "他为自己再怎么舍",
      "follows": true,
      "explains": [],
      "cite": []
     }
    ],
    "because": [
     {
