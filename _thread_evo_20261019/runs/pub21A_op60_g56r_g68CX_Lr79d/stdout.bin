{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这里是刚刚踏上船板的感觉，还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"心里一下热了起来\"\n        },\n        {\n          \"text\": \"怕让对方为难\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"怕让对方为难\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"脚下仿佛不必再踩实地面，可以放弃对重力的控制\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"放弃对重力的控制\"\n        },\n        {\n          \"quote\": \"对方偶尔望来一眼，沉默也不让人紧张\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"还没有失去什么，就已经生出一丝舍不得\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"仍愿意亲近\",\n          \"where\": \"中\",\n          \"waste\": \"对方没有退开\",\n          \"keep\": \"他才慢慢放松\"\n        },\n        {\n          \"text\": \"他也想靠近些\",\n          \"point\": \"喜欢得几乎藏不住\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"几乎藏不住\"\n        },\n        {\n          \"text\": \"可他怕太急\",\n          \"point\": \"还没分开就先