     "rel": "说明"
    }
   ]
  },
  {
   "bars": "214–215",
   "relation": "正在面对",
   "items": [
    {
     "id": "I58",
     "text": "最舍不得的温暖竟也让他收起部分自己。",
     "key": "收起部分自己",
     "kind": ""
    },
    {
     "id": "I59",
     "text": "他仍舍不得那份爱，却再也受不了委屈。",
     "key": "再也受不了委屈",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I54",
     "to": "I58",
     "rel": "说明"
