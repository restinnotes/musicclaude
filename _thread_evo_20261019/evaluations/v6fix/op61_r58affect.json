      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S11",
    "bars": "226–241",
    "relation": "正在面对",
    "items": [
     {
      "id": "S11-1",
      "text": "他还是会想，若能重新靠近从前的生活就好了，心里既有想靠近的劲，也有怕再受委屈的迟疑。",
      "key": "他还是会想，若能",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2",
       "S10-1"
      ]
     },
     {
      "id": "S11-2",
      "text": "可一想到回去，他也会同时想到当初那些委屈；两种念头撞在一起，心里沉重而紧绷，去留仍没法定下来。",
      "key": "可一想到回去，他",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-2",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S10-1",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S10-1",
      "to": "S11-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "242–253",
    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "他心里忽然有一股很郑重的劲，觉得当初不愿再受委屈，并不是一件丢人的事。",
      "key": "他心里忽然有一股",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S10-1"
      ]
     },
     {
      "id": "S12-2",
      "text": "他仍舍不得从前那份归属，想起它时心里会软下来；这份想念并没有因为他肯替当初的自己说句公道话就消失。",
      "key": "他仍舍不得从前那",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2"
      ]
     },
     {
      "id": "S12-3",
      "text": "心里偶尔仍会摇摆，但这回他不急着为每一次怀念辩护，也没有因此决定回去。",
      "key": "心里偶尔仍会摇摆",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-2",
       "S04-3"
      ]
     }
    ],
    "because": [
     {
      "from": "S01-1",
      "to": "S12-1",
      "rel": "引用"
     },
     {
      "from": "S10-1",
      "to": "S12-1",
      "rel": "引用"
     },
     {
      "from": "S03-2",
      "to": "S12-2",
      "rel": "引用"
