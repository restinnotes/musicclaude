     "rel": "提供理由"
    }
   ]
  },
  {
   "bars": "242–253",
   "relation": "正在面对",
   "items": [
    {
     "id": "I126",
     "text": "他不再需要靠贬低怀念维持坚持。",
     "key": "贬低怀念",
     "kind": ""
    },
    {
     "id": "I127",
     "text": "他愿承认自己仍渴望旧日的亲近。",
     "key": "仍渴望",
     "kind": ""
    },
    {
     "id": "I128",
     "text": "想起从前，他仍会难过。",
     "key": "仍会难过",
     "kind": ""
    },
    {
     "id": "I129",
     "text": "他肯定有些坚持得不到安慰也值得保留。",
     "key": "值得保留",
     "kind": "分清"
    },
    {
     "id": "I130",
     "text": "这种想法没有让他立刻轻松。",
     "key": "立刻轻松",
     "kind": ""
    },
    {
     "id": "I131",
     "text": "他不再压抑后，更真切地感到失去沉重。",
     "key": "更真切",
     "kind": ""
    },
    {
     "id": "I132",
     "text": "他有时舍不得，甚至怀疑能否一直走下去。",
     "key": "怀疑",
     "kind": ""
    },
    {
     "id": "I133",
     "text": "他开始愿意感激过去而不怨恨它。",
     "key": "不怨恨它",
     "kind": ""
    },
    {
     "id": "I134",
     "text": "他不愿让无法恢复的过去拖住今后的选择。",
     "key": "今后的选择",
     "kind": ""
    },
    {
     "id": "I135",
     "text": "他不愿用得不到亲近来否定自己。",
     "key": "否定自己",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I125",
     "to": "I126",
     "rel": "改写"
    },
    {
     "from": "I98",
     "to": "I127",
     "rel": "仍在起作用"
    },
    {
     "from": "I124",
     "to": "I129",
     "rel": "提供理由"
