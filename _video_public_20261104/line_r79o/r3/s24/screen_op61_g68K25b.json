{
 "uniform": true,
 "sections": [
  {
   "sec": "S01",
   "rows": [
    {
     "kind": "line",
     "text": "他离开了熟悉的生活",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S01-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像一声召唤，停顿里还等着回声",
       "bead": "S01-B1",
       "from": [
        "S01-B1"
       ],
       "bars": "1–6"
      }
     ]
    },
    {
     "kind": "line",
     "text": "起初以为不用再委屈自己",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S01-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像有人硬挺背脊，心里却想停下来",
       "bead": "S01-B2",
       "from": [
        "S01-B2"
       ],
       "bars": "1–23"
      }
     ]
    },
    {
     "kind": "line",
     "text": "笃定没撑多久心里就空了",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S01-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "心里分不清是愤怒遗憾还是怀念",
       "bead": "S01-B3",
       "from": [
        "S01-B3"
       ],
       "bars": "1–23"
      },
      {
       "text": "像刚醒来，冷空里胸紧眼花，颤手摸空",
       "bead": "S01-B4",
       "from": [
        "S01-B4"
       ],
       "bars": "1–23"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他还说不清舍不得什么",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S01-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "旧日声音光线忽然回来，却不再是现在",
       "bead": "S01-B5",
       "from": [
        "S01-B5"
       ],
       "bars": "9–17"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他想往前过却不知靠什么安心",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S01-3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "身体先于意识记起该怎样迈步",
       "bead": "S01-B5",
       "from": [
        "S01-B5"
       ],
       "bars": "18–23"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "沉重和弦后自由琶音像烟雾向上散开",
     "bars": "1–6",
     "from": [
      "S01-B1"
     ]
    },
    {
     "text": "短句像叹息，长停顿后余音散在冷空气里",
     "bars": "1–23",
     "from": [
      "S01-B3"
     ]
    },
    {
     "text": "波兰舞步逐渐浮现，主题尚未真正站稳",
     "bars": "18–23",
     "from": [
      "S01-B5"
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "rows": [
    {
     "kind": "line",
     "text": "他舍不得从前自在的时候",
     "keys": [],
     "emotion": "亲密",
     "from": [
      "S02-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "庄严舞步下，私藏的旧歌远远传来",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24–65"
      },
      {
       "text": "只能哼出几句，珍惜的东西难再拥有",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想到以后不能那样过心里发慌",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S02-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像腿脚发虚的人还在挪舞步",
       "bead": "S02-B2",
       "from": [
        "S02-B2"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他赶紧提醒自己受过的气",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S02-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像有人整好衣服抬头，不让人看出动摇",
       "bead": "S02-B4",
       "from": [
        "S02-B4"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他怕一心软就忘了为何离开",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S02-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "头一回还信几分，后来越说越显得在意",
       "bead": "S02-B4",
       "from": [
        "S02-B4"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他不甘心连好日子也丢掉",
     "keys": [],
     "emotion": "炽热",
     "from": [
      "S02-3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "激昂像在喊我不甘心就此消亡",
       "bead": "S02-B5",
       "from": [
        "S02-B5"
       ],
       "bars": "44–65"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "庄严节奏托着脆弱旋律，底下细碎音符不安地动",
     "bars": "24–65",
     "from": [
      "S02-B2"
     ]
    },
    {
     "text": "上冲后退又聚力，后段更焦灼，连续音符催急呼吸",
     "bars": "38–43；44–65；52–63；56–65",
     "from": [
      "S02-B3"
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "rows": [
    {
     "kind": "line",
     "text": "他心里还憋着一股气",
     "keys": [],
     "emotion": "炽热",
     "from": [
      "S03-1"
     ]
    },
    {
     "kind": "line",
     "text": "想起被当作自己人他先喜后酸",
     "keys": [],
     "emotion": "欢喜",
     "from": [
      "S03-1",
      "S03-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像夏日麦浪微风，也像亲近时不用防备",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "66–79；80–91"
      },
      {
       "text": "温柔得让人心颤，也刺痛于今昔相隔",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "66–79；80–91"
      }
     ]
    },
    {
     "kind": "line",
     "text": "从前回不去离开后会更好吗？",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S03-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像出去走走，轻松是真的，问题还在",
       "bead": "S03-B3",
       "from": [
        "S03-B3"
       ],
       "bars": "66–91"
      },
      {
       "text": "像许多低语缠在耳边，脚下又像流沙",
       "bead": "S03-B4",
       "from": [
        "S03-B4"
       ],
       "bars": "66–91"
      },
      {
       "text": "昂扬像慢慢退潮，心里问刚才真信了吗",
       "bead": "S03-B5",
       "from": [
        "S03-B5"
       ],
       "bars": "66–91"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "重和弦若突出像重锤，节奏忽紧忽松并转入流动舞步",
     "bars": "66–91",
     "from": [
      "S03-B1"
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "rows": [
    {
     "kind": "line",
     "text": "想起从前亲近他真盼能再那样",
     "keys": [],
     "emotion": "亲密",
     "from": [
      "S04-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "旧日亲近带来感激柔情和短暂幸福",
       "bead": "S04-B1",
       "from": [
        "S04-B1"
       ],
       "bars": "92–107"
      },
      {
       "text": "那份坚定也像他努力想成为的样子",
       "bead": "S04-B1",
       "from": [
        "S04-B1"
       ],
       "bars": "92–107"
      },
      {
       "text": "步子还向前，心里却多了回声",
       "bead": "S04-B1",
       "from": [
        "S04-B1"
       ],
       "bars": "92–107"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可越想起亲近越想起受过的委屈",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S04-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "心跳乱了拍，像被时间催着往前跑",
       "bead": "S04-B3",
       "from": [
        "S04-B3"
       ],
       "bars": "92–115"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他开始怀疑当初走得对不对",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S04-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "脑子反复问如果当时，连停下来都不敢",
       "bead": "S04-B4",
       "from": [
        "S04-B4"
       ],
       "bars": "94–115"
      }
     ]
    },
    {
     "kind": "line",
     "text": "没离开的话如今会怎样？",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S04-2"
     ]
    }
   ],
   "notes": [
    {
     "text": "温暖后忽然风暴般紧绷，另一股声音一路下行",
     "bars": "108–115",
     "from": [
      "S04-B2"
     ]
    },
    {
     "text": "细碎音符急促，低音追赶，旋律狂乱挣扎",
     "bars": "92–115",
     "from": [
      "S04-B3"
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "rows": [
    {
     "kind": "line",
     "text": "他觉得当初那些气不该忍",
     "keys": [],
     "emotion": "炽热",
     "from": [
      "S05-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "柔和歌唱仍被压力推着，像说不能算了",
       "bead": "S05-B2",
       "from": [
        "S05-B2"
       ],
       "bars": "116–127"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可他不想连开心回忆也不敢想",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S05-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "夜色里两道影子低声说话",
       "bead": "S05-B1",
       "from": [
        "S05-B1"
       ],
       "bars": "116–147"
      }
     ]
    },
    {
     "kind": "line",
     "text": "跟自己争到没了力气",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    },
    {
     "kind": "line",
     "text": "那股不服气渐渐淡了",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像脚下地板忽然不见，只剩一个声音",
       "bead": "S05-B4",
       "from": [
        "S05-B4"
       ],
       "bars": "128–129；139–144"
      },
      {
       "text": "像深深叹气，松下来是抵抗累了",
       "bead": "S05-B5",
       "from": [
        "S05-B5"
       ],
       "bars": "132–147"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想到已不在他们身边很难受",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "旧记忆有温度，可能是人、故乡或旧生活",
       "bead": "S05-B3",
       "from": [
        "S05-B3"
       ],
       "bars": "116–147"
      },
      {
       "text": "眷恋里仍带着失落",
       "bead": "S05-B3",
       "from": [
        "S05-B3"
       ],
       "bars": "116–147"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "歌唱忽然转柔，语气亲近而克制",
     "bars": "116–147",
     "from": [
      "S05-B1"
     ]
    },
    {
     "text": "快速音型渐渐放缓变稀，最后落成疏疏和弦",
     "bars": "128–147",
     "from": [
      "S05-B4"
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "rows": [
    {
     "kind": "line",
     "text": "难受缓下来他没拿旧气压想念",
     "keys": [],
     "emotion": "亲密",
     "from": [
      "S06-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "隔着玻璃罩听母亲轻哼，连呼吸都放轻",
       "bead": "S06-B1",
       "from": [
        "S06-B1"
       ],
       "bars": "148–180"
      },
      {
       "text": "安宁不代表现实变好，也留不久",
       "bead": "S06-B1",
       "from": [
        "S06-B1"
       ],
       "bars": "148–180"
      },
      {
       "text": "像藏着秘密，不必解释难过或装坚强",
       "bead": "S06-B2",
       "from": [
        "S06-B2"
       ],
       "bars": "148–180"
      }
     ]
    },
    {
     "kind": "line",
     "text": "没人陪着才知从前多轻松",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S06-2"
     ]
    },
    {
     "kind": "line",
     "text": "他想再有不用多说的亲近",
     "keys": [],
     "emotion": "亲密",
     "from": [
      "S06-3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "压着的愿望委屈和想念终于浮上来",
       "bead": "S06-B2",
       "from": [
        "S06-B2"
       ],
       "bars": "148–180"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可他怕以后再也遇不到",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S06-3"
     ]
    },
    {
     "kind": "line",
     "text": "想到真切拥有过心里暖了",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S06-4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "祈求未必有回应，梦里远方家园忽然亮起",
       "bead": "S06-B2",
       "from": [
        "S06-B2"
       ],
       "bars": "148–180"
      },
      {
       "text": "像静静看着珍惜之物，不急着抓回来",
       "bead": "S06-B4",
       "from": [
        "S06-B4"
       ],
       "bars": "148–180"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "歌唱带着圣歌般的庄严",
     "bars": "148–180",
     "from": [
      "S06-B2"
     ]
    },
    {
     "text": "歌唱从含蓄试探逐渐展开，末尾停在未完处",
     "bars": "148–151；152–167；168–180",
     "from": [
      "S06-B3"
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "rows": [
    {
     "kind": "line",
     "text": "刚安心又怕自己扛不住难事",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S07-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "寒风吹开窗，后颈发凉脉搏猛跳",
       "bead": "S07-B1",
       "from": [
        "S07-B1"
       ],
       "bars": "182附近"
      },
      {
       "text": "新场景很鲜明，心里却未必安定",
       "bead": "S07-B2",
       "from": [
        "S07-B2"
       ],
       "bars": "182–197"
      },
      {
       "text": "心里不停翻转发颤，想冲出去却没出口",
       "bead": "S07-B3",
       "from": [
        "S07-B3"
       ],
       "bars": "198–205"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他当初只想不再受气",
     "keys": [],
     "emotion": "炽热",
     "from": [
      "S07-2"
     ]
    },
    {
     "kind": "line",
     "text": "早知道会孤单他还会离开吗？",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S07-2"
     ]
    },
    {
     "kind": "line",
     "text": "他想找回亲近又不愿再受气",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S07-3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "熟悉动作舞蹈和日常片段忽然闯进来",
       "bead": "S07-B4",
       "from": [
        "S07-B4"
       ],
       "bars": "181–205"
      },
      {
       "text": "越亲切越让人看见失去了什么",
       "bead": "S07-B4",
       "from": [
        "S07-B4"
       ],
       "bars": "181–205"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可连当初的决心都找不回",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S07-3"
     ]
    }
   ],
   "notes": [
    {
     "text": "高音区忽然浮出轻细刺骨的长颤音",
     "bars": "182附近",
     "from": [
      "S07-B1"
     ]
    },
    {
     "text": "马祖卡般舞步突然闯入，波兰舞曲气息已不完整",
     "bars": "182–197",
     "from": [
      "S07-B2",
      "S07-B5"
     ]
    },
    {
     "text": "连续颤音一层层叠起",
     "bars": "198–205",
     "from": [
      "S07-B3"
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "rows": [
    {
     "kind": "line",
     "text": "他先把回去放一边",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S08-1"
     ]
    },
    {
     "kind": "line",
     "text": "想起被当作自己人心里一暖",
     "keys": [],
     "emotion": "亲密",
     "from": [
      "S08-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "熟悉的柔软处像临走前回头一望",
       "bead": "S08-B1",
       "from": [
        "S08-B1",
        "S08-B2"
       ],
       "bars": "206–213"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可那点暖意很快退了",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S08-2"
     ]
    },
    {
     "kind": "line",
     "text": "想到以后难事回忆帮不了他",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S08-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "胸口像终于吸进一口气，却只是一瞬",
       "bead": "S08-B3",
       "from": [
        "S08-B3"
       ],
       "bars": "206–213"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "rows": [
    {
     "kind": "line",
     "text": "他分不清自己为何想回去",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S09-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像从另一面重新看见同一扇门",
       "bead": "S09-B1",
       "from": [
        "S09-B1"
       ],
       "bars": "214–215"
      },
      {
       "text": "像重遇那个自己，这回懂他经历过什么",
       "bead": "S09-B2",
       "from": [
        "S09-B2"
       ],
       "bars": "214–215"
      }
     ]
    },
    {
     "kind": "line",
     "text": "是舍不得被当作自己人",
     "keys": [],
     "emotion": "亲密",
     "from": [
      "S09-1"
     ]
    },
    {
     "kind": "line",
     "text": "还是怕孤单到愿再受那些气",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "kind": "line",
     "text": "这念头让他一阵心慌",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S09-2"
     ]
    },
    {
     "kind": "line",
     "text": "他连往下想都不敢了",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S09-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "最初的问题仍没有简单答案",
       "bead": "S09-B2",
       "from": [
        "S09-B2"
       ],
       "bars": "214–215"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "开头沉重引子从颤音光晕中阴冷闪回，声音刚落稳又向高处漂去",
     "bars": "214–215",
     "from": [
      "S09-B1"
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "rows": [
    {
     "kind": "line",
     "text": "他最舍不得被当作自己人",
     "keys": [],
     "emotion": "亲密",
     "from": [
      "S10-1"
     ]
    },
    {
     "kind": "line",
     "text": "可回去还能像从前那样吗？",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S10-1"
     ]
    },
    {
     "kind": "line",
     "text": "受过的委屈不能当没发生",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S10-2"
     ]
    },
    {
     "kind": "line",
     "text": "光凭想念他还是不敢回去",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S10-2"
     ]
    },
    {
     "kind": "line",
     "text": "想得很累仍没答案日子不踏实",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S10-3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像忽然失重，整个人悬在半空",
       "bead": "S10-B2",
       "from": [
        "S10-B2"
       ],
       "bars": "221–225"
      },
      {
       "text": "心里又问：往后究竟该怎么过？",
       "bead": "S10-B3",
       "from": [
        "S10-B3"
       ],
       "bars": "216–225"
      },
      {
       "text": "像累极的人，重要往事也说不动了",
       "bead": "S10-B4",
       "from": [
        "S10-B4"
       ],
       "bars": "216–225"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "熟悉的如歌和舞曲只剩碎片，也像摇篮曲在F小调里哀婉重现",
     "bars": "216–225",
     "from": [
      "S10-B1"
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "rows": [
    {
     "kind": "line",
     "text": "他知道回去未必找回亲近",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S11-1"
     ]
    },
    {
     "kind": "line",
     "text": "可还是忍不住想万一呢",
     "keys": [],
     "emotion": "炽热",
     "from": [
      "S11-1"
     ]
    },
    {
     "kind": "line",
     "text": "他不愿只凭希望再去忍让",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S11-2"
     ]
    },
    {
     "kind": "line",
     "text": "他想先把眼下日子过稳",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S11-3"
     ]
    },
    {
     "kind": "line",
     "text": "怕独自扛难事他也不收回打算",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S11-4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像困兽一次次顶住压力",
       "bead": "S11-B1",
       "from": [
        "S11-B1"
       ],
       "bars": "226–237"
      },
      {
       "text": "怕还在脚已往前，停滞松开一点",
       "bead": "S11-B3",
       "from": [
        "S11-B3"
       ],
       "bars": "226–241"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "低音波涛涌起，和弦重击后压力又叠一层",
     "bars": "226–237",
     "from": [
      "S11-B1"
     ]
    },
    {
     "text": "舞步从试探慢慢聚拢，末尾向上推进",
     "bars": "226–241",
     "from": [
      "S11-B2"
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "rows": [
    {
     "kind": "line",
     "text": "当初那些气他不该忍",
     "keys": [],
     "emotion": "炽热",
     "from": [
      "S12-1"
     ]
    },
    {
     "kind": "line",
     "text": "和那些人在一起也真开心过",
     "keys": [],
     "emotion": "欢喜",
     "from": [
      "S12-1"
     ]
    },
    {
     "kind": "line",
     "text": "他不再逼自己非得选边",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S12-1"
     ]
    },
    {
     "kind": "line",
     "text": "他不怪自己离开也不为陪伴回头",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S12-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "明知还会犹疑疲惫，仍能决定怎样站立",
       "bead": "S12-B2",
       "from": [
        "S12-B2"
       ],
       "bars": "242–253"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他愿带着想念继续过日子",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S12-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "脚步向前时地面忽然斜了一下",
       "bead": "S12-B3",
       "from": [
        "S12-B3"
       ],
       "bars": "249–253"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "波兰舞曲主题雷鸣般回归，带着面向众人的昂扬",
     "bars": "242–253",
     "from": [
      "S12-B1"
     ]
    },
    {
     "text": "向前的步子中间忽然换了一下色彩",
     "bars": "249–253",
     "from": [
      "S12-B3"
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "rows": [
    {
     "kind": "line",
     "text": "想起从前的亲近他心里发热",
     "keys": [],
     "emotion": "亲密",
     "from": [
      "S13-1"
     ]
    },
    {
     "kind": "line",
     "text": "他盼以后还能有那样的相处",
     "keys": [],
     "emotion": "亲密",
     "from": [
      "S13-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "心跳像开到最高负荷",
       "bead": "S13-B1",
       "from": [
        "S13-B1"
       ],
       "bars": "254–270"
      },
      {
       "text": "也让人想到故土和共同记忆",
       "bead": "S13-B1",
       "from": [
        "S13-B1"
       ],
       "bars": "254–270"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他要好好过日子不再跟过去较劲",
     "keys": [],
     "emotion": "炽热",
     "from": [
      "S13-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "兴奋得几乎来不及喘息",
       "bead": "S13-B2",
       "from": [
        "S13-B2"
       ],
       "bars": "269–280"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他怕很久才遇见亲近的人",
     "keys": [],
     "emotion": "悬着",
     "from": [
      "S13-3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像成功被轻轻追问，也像终于能喘口气",
       "bead": "S13-B3",
       "from": [
        "S13-B3"
       ],
       "bars": "281–287"
      }
     ]
    },
    {
     "kind": "line",
     "text": "等不到亲近的人他也愿好好过",
     "keys": [],
     "emotion": "安心",
     "from": [
      "S13-4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "有人当他自己人，他会珍惜不为谁忍委屈",
       "bead": "S13-4",
       "from": [
        "S13-4"
       ],
       "bars": ""
      },
      {
       "text": "最后一记和弦，像决定也像梦醒",
       "bead": "S13-B5",
       "from": [
        "S13-B5"
       ],
       "bars": "286–288"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "柔软歌唱在管风琴般宏大音响里铺开，密集音符如激流喷涌",
     "bars": "254–270",
     "from": [
      "S13-B1"
     ]
    },
    {
     "text": "明亮迅疾的八度音型成串向前冲出",
     "bars": "269–280",
     "from": [
      "S13-B2"
     ]
    },
    {
     "text": "音乐收敛下来，细碎颤动又带来一点不安",
     "bars": "281–287",
     "from": [
      "S13-B3"
     ]
    },
    {
     "text": "低处两记耳语般和弦后，高处亮起透明钟声般的高和弦",
     "bars": "末尾几小节",
     "from": [
      "S13-B4"
     ]
    }
   ]
  }
 ]
}