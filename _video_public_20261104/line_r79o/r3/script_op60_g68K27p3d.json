       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "这点亲近已经很甜，下次能不能坦白些还没把握",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      },
      {
       "text": "像一句想了很久的话，到了嘴边仍沉默",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他露出在意，对方却没有退开，仍愿意亲近",
