{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没找到说法\"\n        },\n        {\n          \"quote\": \"伸出颤抖的手去摸，摸到的却只有虚空\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像烟雾往高处散，声音轻了、远了，悬在半空\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开了熟悉的生活\",\n          \"point\": \"终于不用再受委屈\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"终于\"\n        },\n        {\n          \"text\": \"没多久，他心里空落落的\",\n          \"point\": \"不知舍不得什么\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没多久\"\n        },\n        {\n          \"text\": \"想继续往前走\",\n          \"point\": \"不知道以后怎么安心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只是\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"模糊地\"\n        },\n        {\n          \"quote\": \"节奏本身庄严、傲慢，旋律却脆弱凄婉\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"傲慢\"\n        },\n        {\n          \"quote\": \"悲伤还在，只是不愿把自己完全交给悲伤\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不把自己交给悲伤\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他舍不得过去的自在\",\n          \"point\": \"回不去就心