<!-- 处理用户下载时 是否已经登录或者已经注册过了-->
<script src="https://www.ymtc.com/cn/statics/home/pc/js/layui/layui.all.js"></script>
<script>
    function isLogin(el){

        var islg = 2;
        if(islg==1){
            var url = $(el).attr('data-href');
            var filename = $(el).attr('data-download') || '下载文件';
            download(url, filename);
            return true;
        }else{
            layer.open({
                content: '需要登录！',
                btn: ['登录', '取消'], //可以无限个按钮,
                yes: function(index, layero){
                    //按钮【按钮一】的回调
                    layer.msg('登录跳转中...', { icon: 1 })
                    window.location.href = 'https://www.ymtc.com/cn/login.html';
                }, 
                cancel: function(index){
                    //按钮【按钮二】的回调
                }
            });
        }
    }

    function download(url, filename) {
        var a = document.createElement("a");
        a.href = url; // 给a标签赋上下载地址
        a.download = filename;
        a.style.display = "none"; // 让a标签不显示
        a.click(); // a标签自点击

    }
</script>
<!-- 结束 -->
	<script src="https://www.ymtc.com/cn/statics/home/pc/js/idangerous.swiper.min.js"></script>

	<script type="text/javascript">
// 	$('.pd-specsitem').on('click',function () {
// 		$('.pd-specsitem').removeClass('on');
// 		$(this).addClass('on');
// 	});
	$('.pd-show-more').on('click',function () {
		var item = $(this).parent().parent();
		if (item.hasClass('on')) {
			item.removeClass('on');
			item.find('.pd-box').animate({ height:0 })
		} else {
			item.addClass('on');
			var h = item.find('.pd-wrap').height() + 20;
			item.find('.pd-box').animate({height: h + 'px'})
		}
	})
</script>
	<script>
		var slidesPerView = 3

		var mySwiper = new Swiper('.pd-specs .swiper-container',{
				paginationClickable :true,
				paginationAsRange : true,
				slidesPerView: slidesPerView,
				slidesPerGroup: 3,
				onSlideChangeStart: function (swiper) {
					console.log(swiper)
					if (swiper.activeIndex > swiper.slides.length - 4 ){
						$('.pd-specs .nextbtn').addClass('disable');
					} else{
						$('.pd-specs .nextbtn').removeClass('disable');
					}

					if (mySwiper.activeIndex === 0){
						$('.pd-specs .prevbtn').addClass('disable')
					} else{
						$('.pd-specs .prevbtn').removeClass('disable')
					}

				}

			});
		if( slidesPerView === 2 ){
			$('.pd-specslist .swiper-slide:nth-of-type(2)').css('text-align', 'right')
		} else if( slidesPerView === 1 ) {
			$('.pd-specslist .swiper-slide .pd-specsitem').css('width', '100%')
		}
    $('.pd-specs .prevbtn').click(function () {
      mySwiper.swipePrev()
    })
    $('.pd-specs .nextbtn').click(function () {
      mySwiper.swipeNext()
    })

	</script>

	<script>
	var bannerMount;
    var viewSwiper = new Swiper('.max-pic .swiper-container', {
    	pagination: '.pagination',
	    // paginationClickable: false,
		onSlideChangeStart: function() {
			updateNavPosition()
		}
	});

    var priNumber = $('.max-pic .pagination span');

    if (priNumber.length >=10 ) {
    	$(".swiper-num span.total").text(priNumber.length);
    }else{
    	$(".swiper-num span.total").text("0" + priNumber.length);
    }

	
	$(".max-pic .pagination").each(function(){
		$(this).find("span").each(function(i){
			if (i>=9 ) {
				$(this).text((i+1));
			}else{
				$(this).text("0"+(i+1));
			}
		});
			
	});
   


	$('.max-pic .arrow-left,.min-pic .arrow-left').on('click', function(e) {
		e.preventDefault()
		if (viewSwiper.activeIndex == 0) {
			viewSwiper.swipeTo(viewSwiper.slides.length - 1, 1000);
			return
		}
		viewSwiper.swipePrev()
	})
	$('.max-pic .arrow-right,.min-pic .arrow-right').on('click', function(e) {
		e.preventDefault()
		if (viewSwiper.activeIndex == viewSwiper.slides.length - 1) {
			viewSwiper.swipeTo(0, 1000);
			return
		}
		viewSwiper.swipeNext()
	})

	var previewSwiper = new Swiper('.min-pic .swiper-container', {
		visibilityFullFit: true,
		autoplayDisableOnInteraction: true,
		slidesPerView: 'auto',
		onlyExternal: true,
		onSlideClick: function() {
			viewSwiper.swipeTo(previewSwiper.clickedSlideIndex)
		}
	})

	function updateNavPosition() {
			$('.min-pic .active-nav').removeClass('active-nav')
			var activeNav = $('.min-pic .swiper-slide').eq(viewSwiper.activeIndex).addClass('active-nav')
			if (!activeNav.hasClass('swiper-slide-visible')) {
				if (activeNav.index() > previewSwiper.activeIndex) {
					var thumbsPerNav = Math.floor(previewSwiper.width / activeNav.width()) - 1
					previewSwiper.swipeTo(activeNav.index() - thumbsPerNav)
				} else {
					previewSwiper.swipeTo(activeNav.index())
				}
			}
		}
	</script>

	<script type="text/javascript">

		var arr = [];
		var childArr = [];

		$('ul.pro-view-table li').each(function (index, dom) {
			childArr.push(dom);
			if ((index + 1) % 3 === 0){
				arr.push(childArr);
				childArr = [];
			}
		});

		for (var i = 0 ; i < arr.length; i++){
			var maxHeight = '';
			for (var j = 0; j< arr[i].length; j++){
				maxHeight = $(arr[i][j]).outerHeight() > $(arr[i][j + 1]).outerHeight()
					? $(arr[i][j]).outerHeight() : $(arr[i][j + 1]).outerHeight();
			}
			for (var j = 0; j< arr[i].length; j++){
				 $(arr[i][j]).css({ height: maxHeight})
			}
		}

