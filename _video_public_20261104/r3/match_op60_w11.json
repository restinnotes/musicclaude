   "lost": ""
  },
  {
   "id": "S02-1-1",
   "a": "偏了",
   "b": "对上",
   "lost": "甲把柔和回落理解成主动压住想靠近的冲动，原稿表达的是没有继续冲向高潮，而是轻轻呼气、重新恢复柔和。"
  },
  {
   "id": "S02-2-0",
   "a": "对上",
   "b": "对上",
   "lost": ""
  },
  {
   "id": "S02-2-1",
   "a": "对上",
   "b": "对上",
   "lost": ""
  },
  {
   "id": "S03-0-0",
