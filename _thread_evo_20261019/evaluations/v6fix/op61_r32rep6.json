      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S11",
    "bars": "226–241",
    "relation": "正在面对",
    "items": [
     {
      "id": "S11-1",
      "text": "他还是会想重新靠近过去，一想到能再过那种有人接纳的日子，心里就软下来。",
      "key": "他还是会想重新靠",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2",
       "S10-2"
      ]
     },
     {
      "id": "S11-2",
      "text": "但那些忍让也紧跟着冒出来，他一想到回去或许还得那样过，心里便不肯了。",
      "key": "但那些忍让也紧跟",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S11-1"
      ]
     },
     {
      "id": "S11-3",
      "text": "他开始想，也许先把现在的日子过下去，比急着回到从前更靠得住。",
      "key": "他开始想，也许先",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-3",
       "S11-1",
       "S11-2"
      ]
     },
     {
      "id": "S11-4",
      "text": "这念头还不稳，孤单仍叫他害怕，可他已经有点愿意照这样试试看。",
      "key": "这念头还不稳，孤",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-2",
       "S11-3"
      ]
     }
    ],
    "because": [
     {
