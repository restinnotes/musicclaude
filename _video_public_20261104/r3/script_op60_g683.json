        "仍不知道"
       ],
       "from": [
        "S14-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "但眼下还能亲近，他不想再逼对方给出永不改变的保证。",
