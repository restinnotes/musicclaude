    },
    {
     "id": "I5",
     "text": "有时他几乎相信自己想通了，另一份舍不得便浮上来，连刚有的确信也很快变得陌生。",
     "key": "刚确信又生不舍",
     "kind": "",
     "follows": true,
     "key_model": "确信又被舍不得打断"
    },
    {
     "id": "I6",
     "text": "反复之后，他开始难堪于自己的摇摆，甚至疑惑自己是否非得理清心里一切才肯向前。",
     "key": "难堪于反复摇摆",
     "kind": "",
     "follows": true,
     "key_model": "怀疑必须想清一切"
    }
   ]
  },
  {
   "bars": "24–65",
   "relation": "正在面对",
   "items": [
    {
     "id": "I7",
     "text": "他渐渐不愿再拿“还没想清楚”当作等候理由，先做自己能做的那一份。",
     "key": "不再拿没想清楚等候",
     "kind": "",
     "follows": false
    },
    {
     "id": "I8",
     "text": "没有保证，也没有牵挂消失，但他不再只是等待，真切感到自己有了力量。",
     "key": "行动后感到有力量",
     "kind": "",
     "follows": true
    },
    {
     "id": "I9",
     "text": "他从反复追问值不值得，转而觉得至少自己愿意尽力。",
     "key": "不再追问只愿尽力",
     "kind": "",
     "follows": true
    },
    {
     "id": "I10",
     "text": "这种改变让他骄傲起来，他发现自己仍有疑虑，也可以不让疑虑支配自己。",
     "key": "带着疑虑不受支配",
     "kind": "",
     "follows": true
    },
    {
     "id": "I11",
     "text": "他投入得更热切，付出的过程本身让他快乐，仿佛不满终于有了去处。",
     "key": "投入付出本身带来快乐",
     "kind": "",
     "follows": true
    },
    {
     "id": "I15",
     "text": "用力时，他察觉有一处心意并未随之昂扬，坚定也没顾到所有牵挂。",
     "key": "用力未顾及所有牵挂",
     "kind": "",
     "follows": true
    }
   ],
   "because": [
    {
     "from": "I6",
     "to": "I7",
     "rel": "改写",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 4,
    "还说不清": 2
   },
   "relation_model": "正在面对",
   "items_before_trim": [
    {
     "id": "I7",
     "text": "他渐渐受不了再拿“还没想清楚”当作等候理由，便先承担自己能承担的那一份。",
     "key": "不再拿没想清楚等候",
     "kind": "",
     "key_model": "承担自己能做的部分"
    },
    {
     "id": "I8",
     "text": "没有保证，也没有牵挂消失，但他不再只是等待，真切感到自己有了力量。",
     "key": "承担后感到有力量",
     "kind": "",
     "follows": true,
     "key_model": "投入后感到有力量"
    },
    {
     "id": "I9",
     "text": "他从反复追问值不值得，转而觉得至少自己愿意尽力。",
     "key": "不再追问只愿尽力",
     "kind": "",
     "follows": true,
     "key_model": "愿意尽力"
    },
    {
     "id": "I10",
     "text": "这种改变让他骄傲起来，他发现自己仍有疑虑，也可以不让疑虑支配自己。",
     "key": "带着疑虑不受支配",
     "kind": "",
     "follows": true,
     "key_model": "疑虑不再支配自己"
    },
    {
     "id": "I11",
     "text": "他投入得更热切，付出的过程本身让他快乐，仿佛不满终于有了去处。",
     "key": "投入付出本身带来快乐",
     "kind": "",
     "follows": true,
     "key_model": "付出过程带来快乐"
    },
    {
     "id": "I12",
     "text": "他舍得给出更多，甚至有些贪恋倾尽全力的畅快。",
     "key": "贪恋倾尽全力的畅快",
     "kind": "",
     "follows": true,
     "key_model": "贪恋倾尽全力"
    },
    {
     "id": "I13",
     "text": "他不再需要时时审视自己，也不想总为一点软弱停下来。",
     "key": "不再时时审视自己",
     "kind": "",
     "follows": true,
     "key_model": "不再时时审视自己"
    },
    {
     "id": "I14",
     "text": "可用力到深处，他偶尔碰到心里一小块没有跟着昂扬起来的地方。",
     "key": "用力时仍有一处未昂扬",
     "kind": "",
     "follows": true,
     "key_model": "心里仍有未昂扬处"
    },
    {
     "id": "I15",
     "text": "那处不妨碍他继续，却让他隐约知道，坚决并未照顾到所有牵挂。",
     "key": "坚定未顾及所有牵挂",
     "kind": "满足照出未满足",
     "follows": true,
     "key_model": "坚决仍顾不到牵挂"
    }
   ]
  },
  {
   "bars": "66–91",
   "relation": "没在想",
   "items": [
    {
     "id": "I16",
     "text": "因为已经认真投入过，他反而能从原先反复自问里稍稍松开。",
     "key": "投入后稍松反复自问",
     "kind": "",
     "follows": false
    },
    {
     "id": "I18",
     "text": "他在向前的热情里感到轻盈，偶尔忘了用力的缘由也不觉得背叛，仿佛尝到久违的自由。",
     "key": "热情中尝到久违自由",
     "kind": "",
     "follows": true
    },
    {
     "id": "I19",
     "text": "他顺着这份自由走了一程，没有急着给它更大的意义。",
     "key": "顺着自由走了一程",
     "kind": "",
     "follows": true
    },
    {
     "id": "I20",
     "text": "快乐不再那么满时，先前作出的决定仍在等着他。",
     "key": "快乐减退后决定仍在",
     "kind": "",
     "follows": true
    }
   ],
   "because": [
    {
