      "rel": "引用"
     },
     {
      "from": "S02-2",
      "to": "S02-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S03",
    "bars": "17–23",
    "relation": "还说不清",
    "items": [
     {
      "id": "S03-1",
      "text": "他一时只顾着享受这份亲近，连下一步该怎样都懒得想。",
      "key": "他一时只顾着享受",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-1"
      ]
     },
     {
      "id": "S03-2",
      "text": "偶尔他又很想让对方看见更多，可那股热切还没充分展开就被自己收住了。",
      "key": "偶尔他又很想让对",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-3"
      ]
     }
    ],
    "because": [
     {
      "from": "S02-1",
      "to": "S03-1",
      "rel": "引用"
     },
     {
      "from": "S02-3",
      "to": "S03-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S04",
    "bars": "24–34",
    "relation": "还说不清",
    "items": [
     {
      "id": "S04-1",
      "text": "熟悉的亲近再次让他满心欢喜，这回他却不满足于只让对方看见自己收敛的一面。",
      "key": "熟悉的亲近再次让",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S04-2",
      "text": "他很想痛快地把依恋都表现出来，可想到自己真这么做，又有点发怵。",
      "key": "他很想痛快地把依",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2",
       "S04-1"
      ]
     },
     {
      "id": "S04-3",
      "text": "他盼着对方能够一直容得下这样的自己，心里便有了想把这份亲近牢牢留住的急切。",
      "key": "他盼着对方能够一",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-1",
       "S04-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S01-2",
      "to": "S04-2",
      "rel": "引用"
     },
