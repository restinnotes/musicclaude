{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"像夏夜威尼斯上空升起的一束烟花\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这里是刚刚踏上船板的感觉，还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"却怕自己的需要成了负担\"\n        },\n        {\n          \"text\": \"他只敢流露出一点喜欢\",\n          \"point\": \"只敢流露出一点喜欢\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"还不知道下次能不能坦白说出来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"连呼吸都贴在一起，体温也仿佛融在了一处\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"可以放弃对重力的控制，把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"水波不会停：人在船上舒服地漂着，暂时不急着靠岸，水却一直在流，时间也一直在走\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"没有退开\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"他才慢慢放松\"\n        },\n        {\n          \"text\": \"