       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "不去想归属能不能回来，也不急着处理自己该怎样坚持",
       "keys": [
        "也不急着处理自己该怎样坚持"
