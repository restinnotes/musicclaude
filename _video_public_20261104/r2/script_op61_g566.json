       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他有了劲头，想过好日子，不再跟过去较劲。",
