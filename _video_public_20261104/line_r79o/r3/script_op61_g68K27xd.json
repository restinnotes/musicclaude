 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他已经离开了那段熟悉的生活",
       "keys": [
        "离开"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "起初他还觉得，自己总算不用再一次次受委屈了",
       "keys": [
        "不用再一次次受委屈"
       ],
       "from": [
        "S01-1",
        "S01-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "强撑着提醒自己不能倒下，可其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里就空落落的",
