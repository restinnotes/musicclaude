    <style id="ds-chrome-boot-css">
  .ds-chrome-root > [data-ds-chrome] { display: none !important; }
  html[data-ds-site-chrome="old"] .ds-chrome-root > [data-ds-chrome="old"],
  html[data-ds-site-chrome="new"] .ds-chrome-root > [data-ds-chrome="new"] {
