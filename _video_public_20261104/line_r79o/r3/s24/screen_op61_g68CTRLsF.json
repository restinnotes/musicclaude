   "notes": [
    {
     "text": "私下祈祷般的柔和歌唱走入宏大音响，如管风琴般庄严",
     "bars": "254-270",
     "from": [
      "S13-B1"
     ]
    },
    {
     "text": "密集的音符如激流向天空喷涌，随后八度音迅疾冲出",
     "bars": "254-280",
     "from": [
      "S13-B1",
      "S13-B2"
     ]
    },
    {
     "text": "前冲的势头收敛下来，颤动的装饰音重新浮现",
     "bars": "281-287",
     "from": [
      "S13-B3"
     ]
    },
    {
     "text": "低音区如呼出最后一口气，沉沉吐出两记耳语般的和弦",
     "bars": "286-288",
     "from": [
      "S13-B4"
     ]
    },
    {
     "text": "最高音区忽然亮起孤悬如寒星的和弦，像一声清脆钟响",
     "bars": "286-288",
     "from": [
      "S13-B4"
     ]
    }
   ]
  }
 ]
}