       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他怕对方看出自己有多需要这份亲近，会觉得负担太重，所以只敢露出一点点喜欢",
       "keys": [
        "只敢露出一点点喜欢"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话到嘴边先沉默几秒，怕一说出口关系就变了",
