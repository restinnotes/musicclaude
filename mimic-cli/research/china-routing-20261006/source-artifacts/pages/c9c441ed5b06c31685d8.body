                var variant = product.variants[i];
                if (variant) {
                    var key1 = variant.option1;
                    var key2 = variant.option1 + ' / ' + variant.option2;
                    Shopify.optionsMap[key1] = [];
                    Shopify.optionsMap[key2] = [];
