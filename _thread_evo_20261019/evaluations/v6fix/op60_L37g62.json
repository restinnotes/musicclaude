      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S03",
    "bars": "17–23",
    "relation": "没在想",
    "items": [
     {
      "id": "S03-1",
      "text": "那段时间我们还是照常相处，即使没有特别安排，也不觉得非得把每段时间都填满。",
      "key": "那段时间我们还是",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-1"
      ]
     },
     {
      "id": "S03-2",
      "text": "偶尔我会突然想到以后怎么办，但这个念头很快就淡下去，我又把心思放回眼前的相处。",
      "key": "偶尔我会突然想到",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1"
      ]
     },
     {
      "id": "S03-3",
      "text": "有些事我想来想去还是理不出头绪，就先放在一边，没有让它打断我们原来的日子。",
      "key": "有些事我想来想去",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S02-1",
      "to": "S03-1",
