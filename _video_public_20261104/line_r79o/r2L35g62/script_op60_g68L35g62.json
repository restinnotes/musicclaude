       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "只是我刻意不让自己完全沉进去",
       "keys": [
        "刻意不让自己完全沉进去"
