<body class="bg-white text-gray-900 font-sans er-site-promo-active">
<style>
  .er-bg-section { background: var(--bg-section); }
  .er-text-main { color: var(--text-main); }
  .er-text-muted { color: var(--text-muted); }
  .er-primary { color: var(--primary-navy); }
  .er-link { color: var(--secondary-teal); }
  .er-link:hover { color: var(--accent-teal-dark); }
  .er-btn-primary { background: var(--secondary-teal); color: #fff; }
  .er-btn-primary:hover { background: var(--accent-teal-dark); }
  .er-btn-outline { border: 1px solid var(--secondary-teal); color: var(--secondary-teal); }
  .er-btn-outline:hover { background: var(--secondary-teal); color: #fff; }
  .er-tag { border: 1px solid var(--secondary-teal); color: var(--secondary-teal); }
  .er-tag:hover { background: var(--secondary-teal); color: #fff; }
  .er-serif { font-family: "Sora", sans-serif; font-weight: 700; font-style: normal; }
  .er-serif-italic { font-family: "Sora", sans-serif; font-weight: 700; font-style: italic; }
  .er-serif-bold { font-family: "Sora", sans-serif; font-weight: 800; font-style: normal; }
  .er-serif-bold-italic { font-family: "Sora", sans-serif; font-weight: 800; font-style: italic; }
  .er-home-promo {
    --promo-height: 265px;
    position: fixed;
    inset: 0 0 auto;
    z-index: 650;
    min-height: var(--promo-height);
    background:
      linear-gradient(rgba(255,255,255,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px),
      linear-gradient(135deg, #087783 0%, #0097a8 100%);
    background-size: 56px 56px, 56px 56px, auto;
    color: #fff;
    box-shadow: 0 20px 52px rgba(2, 18, 29, 0.22);
  }
  .er-home-promo.is-hidden { display: none; }
  body.er-home-promo-active { padding-top: var(--er-home-promo-height, 265px); }
  body.er-home-promo-active .er-header { top: var(--er-home-promo-height, 265px) !important; }
  .er-home-promo__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 30px 24px 28px;
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 34px;
    align-items: center;
  }
  .er-home-promo__badge {
    width: 116px;
    min-height: 106px;
    border: 1px solid rgba(255,255,255,0.34);
    display: grid;
    place-items: center;
    text-align: center;
    background: rgba(255,255,255,0.08);
  }
  .er-home-promo__badge strong {
    display: block;
    font-size: 44px;
    line-height: 1;
    font-weight: 800;
  }
  .er-home-promo__badge strong span { font-size: 22px; }
  .er-home-promo__badge em {
    display: block;
    width: 74%;
    margin: 12px auto 0;
    padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,0.42);
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-style: normal;
    letter-spacing: 0.22em;
  }
  .er-home-promo__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  .er-home-promo__eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: rgba(255,255,255,0.55);
  }
  .er-home-promo h2 {
    margin: 0;
    font-size: 31px;
    line-height: 1.15;
    letter-spacing: 0;
    color: #fff;
  }
  .er-home-promo h2 span { color: #bff6ff; }
  .er-home-promo__points {
    margin: 12px 0 20px;
    color: rgba(255,255,255,0.92);
    font-size: 13px;
    line-height: 1.55;
  }
  .er-home-promo__points span + span::before {
    content: "\00B7";
    margin: 0 12px;
    color: rgba(255,255,255,0.45);
  }
  .er-home-promo__form {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(180px, 1fr) 184px;
    gap: 10px;
    max-width: 780px;
  }
  .er-home-promo__input,
  .er-home-promo__button {
    width: 100%;
    min-height: 46px;
    border: 0;
    border-radius: 0;
    box-sizing: border-box;
  }
  .er-home-promo__input {
    padding: 0 16px;
    background: #fff;
    color: #0d2b45;
    font-size: 14px;
  }
  .er-home-promo__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    grid-column: 3;
    grid-row: 1;
    gap: 10px;
    background: #061426;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .er-home-promo__note {
    margin-top: 10px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.68);
  }
  .er-home-promo__form .er-captcha-block {
    grid-column: 1 / span 2;
    margin: 0 !important;
    display: flex;
    justify-content: flex-start;
  }
  .er-site-promo {
    --site-promo-height: 70px;
    position: fixed;
    inset: 0 0 auto;
    z-index: 650;
    min-height: var(--site-promo-height);
    background:
      linear-gradient(rgba(255,255,255,0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.12) 1px, transparent 1px),
      linear-gradient(135deg, #ff9900 0%, #ffc857 54%, #ff9800 100%);
    background-size: 56px 56px, 56px 56px, auto;
    color: #061426;
    box-shadow: 0 12px 34px rgba(5, 15, 28, 0.16);
  }
  .er-site-promo.is-hidden { display: none; }
  body.er-site-promo-active { padding-top: var(--er-site-promo-height, 70px); }
  body.er-site-promo-active .er-header { top: var(--er-site-promo-height, 70px) !important; }
  .er-site-promo__inner {
    max-width: 1180px;
    min-height: var(--site-promo-height);
    margin: 0 auto;
    padding: 0 28px;
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 18px;
    box-sizing: border-box;
  }
  .er-site-promo__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #061426;
    color: #ffc857;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .er-site-promo__eyebrow::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffc857;
  }
  .er-site-promo__title {
    margin: 0;
    color: #061426;
    font-size: 18px;
    line-height: 1.1;
    font-weight: 800;
    white-space: nowrap;
  }
  .er-site-promo__title span {
    font-weight: 600;
    font-size: 16px;
  }
  .er-site-promo__copy {
    min-width: 0;
    padding-left: 20px;
    border-left: 1px solid rgba(6, 20, 38, 0.18);
    color: rgba(6, 20, 38, 0.78);
    font-size: 13px;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .er-site-promo__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 34px;
    padding: 0 22px;
    background: #061426;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .er-home-promo,
    .er-site-promo { display: none !important; }
    body.er-home-promo-active,
    body.er-site-promo-active { padding-top: 0; }
    body.er-home-promo-active .er-header,
    body.er-site-promo-active .er-header { top: 0 !important; }
  }
  @media (max-width: 1180px) {
    .er-site-promo__inner {
      grid-template-columns: auto auto minmax(0, 1fr) auto;
      gap: 14px;
      padding: 0 20px;
    }
    .er-site-promo__copy { display: none; }
  }
</style>

