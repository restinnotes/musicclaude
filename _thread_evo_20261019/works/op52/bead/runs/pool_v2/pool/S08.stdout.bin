  },\n    {\n      \"id\": \"P41\",\n      \"src\": \"SRC-gpt56w-web-4\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"因为此时人物已经知道自己想要什么。\",\n      \"experience\": \"人物已清楚自己渴望的生活。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P42\",\n      \"src\": \"SRC-gpt56w-web-4\",\n      \"src_range\": \"mm. 100–118\",\n      \"measures\": \"100–118\",\n      \"range_reason\": \"\",\n      \"quote\": \"失去刚刚获得的安宁之后，情绪重新变得焦躁。\",\n      \"experience\": \"失去安宁后，情绪重新焦躁。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P43\",\n      \"src\": \"SRC-gpt56w-web-4\",\n      \"src_range\": \"mm. 100–118\",\n      \"measures\": \"100–118\",\n      \"range_reason\": \"\",\n      \"quote\": \"音乐中有很多奔走、追逐的感觉，仿佛一个人急切地寻找刚刚失去的东西。\",\n      \"experience\": \"像急切追逐刚刚失去的安宁。\",\n      \"type\": \"画面\"\n    },\n    {\n      \"id\": \"P44\",\n      \"src\": \"SRC-gpt56w-web-5\",\n      \"src_range\": \"mm.100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"前面是平静的田园世界，现在却突然变得紧张、活跃，甚至有些焦灼。\",\n      \"experience\": \"田园般的平静突然转为紧张、活跃和焦灼。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P45\",\n      \"src\": \"SRC-gpt56w-web-5\",\n      \"src_range\": \"mm.100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"一个人刚刚获得了一点幸福，却突然发现幸福并不受自己控制。\",\n      \"experience\": \"刚获得幸福，便发现它不由自己掌控。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P46\",\n      \"src\": \"SRC-gpt56w-web-5\",\n      \"src_range\": \"mm.100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"想要挽回刚才的平静。\",\n      \"experience\": \"想挽回刚才的平静。\",\n      \"type\": \"动因\"\n    },\n    {\n      \"id\": \"P47\",\n      \"src\": \"SRC-gpt56w-web-5\",\n      \"src_range\": \"mm.100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"想要证明那种幸福并非幻想。\",\n      \"experience\": \"想证明刚才的幸福并非幻想。\",\n      \"type\": \"动因\"\n    },\n    {\n      \"id\": \"P48\",\n      \"src\": \"SRC-gpt56w-web-5\",\n      \"src_range\": \"mm.100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"想要把曾经只能在回忆里存在的东西，变成现实。\",\n      \"experience\": \"想让回忆中的美好成为现实。\",\n      \"type\": \"动因\"\n    },\n    {\n      \"id\": \"P49\",\n      \"src\": \"SRC-gpt56w-web-5\",\n      \"src_range\": \"mm.100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"不愿意接受它再次消失。\",\n      \"experience\": \"不愿接受那种幸福再次消失。\",\n      \"type\": \"动因\"\n    },\n    {\n      \"id\": \"P50\",\n      \"src\": \"SRC-gpt56w-web-6\",\n      \"src_range\": \"m. 100\",\n      \"measures\": \"100\",\n      \"range_reason\": \"\",\n      \"quote\": \"到了 m. 100，这份宁静被打破。\",\n      \"experience\": \"m.100宁静被打破。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P51\",\n      \"src\": \"SRC-gpt56w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"原稿标题覆盖100–128；本句描述m.100开始的安静旋律被活跃音乐打断，后文另述112–128的复杂线条，故定位于初始变化。\",\n      \"quote\": \"原本安静的旋律被更加活跃的音乐打断，情绪逐渐紧张起来。\",\n      \"experience\": \"安静旋律被活跃音乐打断，情绪渐紧。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P52\",\n      \"src\": \"SRC-gpt56w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"现实中的问题没有消失。过去没有真正过去。\",\n      \"experience\": \"现实问题仍在，过去的事情也并未真正过去。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P53\",\n      \"src\": \"SRC-gpt56w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"而那个理想世界也没有办法自动变成现实。\",\n      \"experience\": \"理想世界不会自动成为现实。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P54\",\n      \"src\": \"SRC-gpt56w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"你已经知道自己想要什么，却发现自己没有办法真正得到它。\",\n      \"experience\": \"清楚自己想要什么，却无法真正得到。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P55\",\n      \"src\": \"SRC-gpt56w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"音乐中出现了一些令人难以预料的转折，仿佛思绪不断被新的东西打断。\",\n      \"experience\": \"音乐转折难以预料，思绪不断被打断。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P56\",\n      \"src\": \"SRC-gpt6w-int-1\",\n      \"src_range\": \"mm. 100–116 左右\",\n      \"measures\": \"100–116\",\n      \"range_reason\": \"\",\n      \"quote\": \"mm. 100–116 左右，音乐开始出现大量流动、起伏和不断变化的音型。\",\n      \"experience\": \"100–116的音乐出现大量流动起伏、不断变化的音型。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P57\",\n      \"src\": \"SRC-gpt6w-int-1\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"一个人短暂地回到了平静生活，但内心深处的事情又开始浮现。\",\n      \"experience\": \"短暂回到平静生活时，内心旧事重新浮现。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P58\",\n      \"src\": \"SRC-gpt6w-int-1\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"对美好事物的留恋。\",\n      \"experience\": \"仍留恋美好的事物。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P59\",\n      \"src\": \"SRC-gpt6w-int-1\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"对现实的无奈。\",\n      \"experience\": \"对现实感到无奈。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P60\",\n      \"src\": \"SRC-gpt6w-int-1\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"对过去的重新审视。\",\n      \"experience\": \"重新审视过去。\",\n      \"type\": \"其他\"\n    },\n    {\n      \"id\": \"P61\",\n      \"src\": \"SRC-gpt6w-int-1\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"一种越来越难以安放的焦虑。\",\n      \"experience\": \"焦虑逐渐加深，难以安放。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P62\",\n      \"src\": \"SRC-gpt6w-int-2\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"前面那种美好并没有持续下去。\",\n      \"experience\": \"前段的美好没有持续。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P63\",\n      \"src\": \"SRC-gpt6w-int-2\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"音乐重新开始运动，而且这次的运动显得更加不安。\",\n      \"experience\": \"音乐重新运动，且带有更强不安。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P64\",\n      \"src\": \"SRC-gpt6w-int-2\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"一个人开始意识到，自己刚才体验到的平静，可能只是短暂的。\",\n      \"experience\": \"意识到刚才体验的平静可能只是短暂的。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P65\",\n      \"src\": \"SRC-gpt6w-int-3\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"音乐逐渐失去原来的稳定感，出现大量流动、起伏、上升和下降的音型。\",\n      \"experience\": \"音乐失去稳定，出现流动起伏和升降音型。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P66\",\n      \"src\": \"SRC-gpt6w-int-3\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"一个人从美好的回忆中醒来，突然发现现实仍然是原来的样子。\",\n      \"experience\": \"像从美好回忆中醒来，发现现实未变。\",\n      \"type\": \"画面\"\n    },\n    {\n      \"id\": \"P67\",\n      \"src\": \"SRC-gpt6w-int-3\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"他刚才感受到的安宁是真的，但它并没有改变现实。\",\n      \"experience\": \"安宁体验真实，却没有改变现实。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P68\",\n      \"src\": \"SRC-gpt6w-int-3\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"于是，之前没有解决的问题重新出现。\",\n      \"experience\": \"未解决的问题再次出现。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P69\",\n      \"src\": \"SRC-gpt6w-int-3\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"一个人越是接近自己渴望的美好，就越无法忽略自己与那种美好之间的距离。\",\n      \"experience\": \"越接近渴望的美好，越感到彼此距离。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P70\",\n      \"src\": \"SRC-gpt6w-int-3\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"你知道自己想去哪里，却不知道如何到达。\",\n      \"experience\": \"知道自己想去哪里，却不知如何抵达。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P71\",\n      \"src\": \"SRC-gpt6w-int-4\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"前面那段温柔的音乐并没有真正解决什么。\",\n      \"experience\": \"温柔音乐没有真正解决原有问题。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P72\",\n      \"src\": \"SRC-gpt6w-int-4\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"原本比较连贯的旋律开始被拆解、延伸\",\n      \"experience\": \"连贯旋律被拆解并延伸。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P73\",\n      \"src\": \"SRC-gpt6w-int-4\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"自己刚刚感受到的安宁，也许只是暂时的。\",\n      \"experience\": \"意识到刚才的安宁可能只是暂时的。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P74\",\n      \"src\": \"SRC-gpt6w-int-4\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"他开始重新思考，重新寻找，试图弄明白怎样才能真正摆脱之前的精神困境。\",\n      \"experience\": \"重新思考和寻找，想摆脱先前的精神困境。\",\n      \"type\": \"动因\"\n    },\n    {\n      \"id\": \"P75\",\n      \"src\": \"SRC-gpt6w-int-5\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"现实并不会因为他暂时忘记了痛苦，就真的发生改变。\",\n      \"experience\": \"暂时忘痛并不会让现实发生改变。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P76\",\n      \"src\": \"SRC-gpt6w-int-5\",\n      \"src_range\": \"mm. 100–112\",\n      \"measures\": \"100–112\",\n      \"range_reason\": \"\",\n      \"quote\": \"这里不是简单的愤怒，而是一种突然失去安宁后的精神震荡。\",\n      \"experience\": \"失去安宁后出现精神震荡，并非单纯愤怒。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P77\",\n      \"src\": \"SRC-gpt6w-int-5\",\n      \"src_range\": \"mm. 100–112\",\n      \"measures\": \"100–112\",\n      \"range_reason\": \"\",\n      \"quote\": \"好比一个人做了一个非常美好的梦，醒来时却发现自己仍然处于原来的困境。\",\n      \"experience\": \"像从美梦醒来，发现仍处在原有困境。\",\n      \"type\": \"画面\"\n    },\n    {\n      \"id\": \"P78\",\n      \"src\": \"SRC-gpt6w-int-5\",\n      \"src_range\": \"mm. 100–112\",\n      \"measures\": \"100–112\",\n      \"range_reason\": \"\",\n      \"quote\": \"最难受的并不是梦消失了，而是醒来之后，现实显得比做梦之前更加难以接受。\",\n      \"experience\": \"醒来后现实比做梦前更难接受。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P79\",\n      \"src\": \"SRC-gpt6w-int-5\",\n      \"src_range\": \"mm. 100–112\",\n      \"measures\": \"100–112\",\n      \"range_reason\": \"\",\n      \"quote\": \"想要抓住什么，想要重新找到方向，想要摆脱刚刚意识到的失落。\",\n      \"experience\": \"急切想抓住东西、找到方向并摆脱失落。\",\n      \"type\": \"动因\"\n    },\n    {\n      \"id\": \"P80\",\n      \"src\": \"SRC-gpt6w-int-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"前一段带来的安慰并没有持续下去。\",\n      \"experience\": \"前段的安慰没有持续。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P81\",\n      \"src\": \"SRC-gpt6w-int-6\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"思绪不断加速，原本相对连贯的情绪开始变得躁动。\",\n      \"experience\": \"思绪加速，连贯情绪逐渐躁动。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P82\",\n      \"src\": \"SRC-gpt6w-int-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"它开始变得难以控制。\",\n      \"experience\": \"原先可通过歌唱表达的痛苦变得难以控制。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P83\",\n      \"src\": \"SRC-gpt6w-int-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"一个人明明知道自己应该平静下来，却发现自己的思绪已经不受控制。\",\n      \"experience\": \"想保持平静，却发现思绪不受控制。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P84\",\n      \"src\": \"SRC-gpt6w-int-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"晚上躺在床上，本来已经决定不再想某件事情，但脑海中的念头却越来越多。\",\n      \"experience\": \"躺下后想停止思考，念头却不断增多。\",\n      \"type\": \"画面\"\n    },\n    {\n      \"id\": \"P85\",\n      \"src\": \"SRC-gpt6w-int-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"你想停止，却又忍不住继续想。\",\n      \"experience\": \"想停止思考，却忍不住继续。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P86\",\n      \"src\": \"SRC-gpt6w-web-1\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"mm. 100–111，音乐重新出现了强烈的动荡感。\",\n      \"experience\": \"100–111重新出现强烈动荡。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P87\",\n      \"src\": \"SRC-gpt6w-web-1\",\n      \"src_range\": \"mm. 100–118\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"原稿范围为100–118；原稿另将112–118描述为田园般的宁静色彩，本句的害怕失去安宁对应前段100–111的动荡起点。\",\n      \"quote\": \"当你终于知道什么是幸福，就会更加害怕幸福消失。\",\n      \"experience\": \"体验过安宁后，更害怕幸福消失。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P88\",\n      \"src\": \"SRC-gpt6w-web-2\",\n      \"src_range\": \"mm. 100–116\",\n      \"measures\": \"100–116\",\n      \"range_reason\": \"\",\n      \"quote\": \"刚才那种宁静的世界没有能够持续。\",\n      \"experience\": \"先前宁静的世界没能持续。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P89\",\n      \"src\": \"SRC-gpt6w-web-2\",\n      \"src_range\": \"mm. 100–116\",\n      \"measures\": \"100–116\",\n      \"range_reason\": \"\",\n      \"quote\": \"音乐重新变得紧张，带着明显的推动感。\",\n      \"experience\": \"音乐转为紧张并具有推动力。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P90\",\n      \"src\": \"SRC-gpt6w-web-2\",\n      \"src_range\": \"mm. 100–116\",\n      \"measures\": \"100–116\",\n      \"range_reason\": \"\",\n      \"quote\": \"一个人刚刚获得片刻安宁，就不得不重新面对那些无法解决的问题。\",\n      \"experience\": \"短暂安宁后又要面对未解决的问题。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P91\",\n      \"src\": \"SRC-gpt6w-web-2\",\n      \"src_range\": \"mm. 100–116\",\n      \"measures\": \"100–116\",\n      \"range_reason\": \"\",\n      \"quote\": \"可你无法一直待在那里。\",\n      \"experience\": \"知道宁静世界存在，却无法一直停留。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P92\",\n      \"src\": \"SRC-gpt6w-web-3\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"它们有时显得活跃，有时又有些神秘，彼此之间的性格差异也很明显。\",\n      \"experience\": \"音乐形象有时活跃、有时神秘，性格差异明显。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P93\",\n      \"src\": \"SRC-gpt6w-web-3\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"刚才那个理想的、宁静的世界并没有消除现实中的问题。\",\n      \"experience\": \"理想的宁静没有消除现实问题。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P94\",\n      \"src\": \"SRC-gpt6w-web-3\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"你可能会想到不同的人、不同的经历，也会想到那些曾经让自己快乐或者痛苦的事情。\",\n      \"experience\": \"思绪牵连到不同的人和经历，以及快乐与痛苦。\",\n      \"type\": \"画面\"\n    },\n    {\n      \"id\": \"P95\",\n      \"src\": \"SRC-gpt6w-web-3\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"而且，这些记忆并不按照你希望的顺序出现。\",\n      \"experience\": \"回忆以不受控制的顺序浮现。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P96\",\n      \"src\": \"SRC-gpt6w-web-3\",\n      \"src_range\": \"mm. 84–120\",\n      \"measures\": \"84–120\",\n      \"range_reason\": \"\",\n      \"quote\": \"mm. 84–120 这一段理解为一系列不同场景的出现\",\n      \"experience\": \"将84–120听作多个场景依次出现。\",\n      \"type\": \"画面\"\n    },\n    {\n      \"id\": \"P97\",\n      \"src\": \"SRC-gpt6w-web-4\",\n      \"src_range\": \"mm. 100\",\n      \"measures\": \"100\",\n      \"range_reason\": \"\",\n      \"quote\": \"mm. 100 开始，刚刚建立起来的宁静突然被打破。\",\n      \"experience\": \"m.100刚建立的宁静突然被打破。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P98\",\n      \"src\": \"SRC-gpt6w-web-4\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"原稿标题覆盖100–128；112–120另述轻盈的舞蹈性主题，本句描述m.100开始的急促运动，故定位于100–111。\",\n      \"quote\": \"音乐重新变得活跃、急促，出现大量上下流动的音型。\",\n      \"experience\": \"音乐活跃急促，出现大量上下流动音型。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P99\",\n      \"src\": \"SRC-gpt6w-web-4\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"原稿标题覆盖100–128；本句紧接m.100的安宁破裂，后续112–120另述舞蹈主题，故定位于初始的现实冲击。\",\n      \"quote\": \"一个人刚刚获得片刻安宁，却突然想起，自己面对的那些问题其实一个都没有消失。\",\n      \"experience\": \"重新意识到先前未解决的问题仍然存在。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P100\",\n      \"src\": \"SRC-gpt6w-web-5\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"刚才的温暖并没有消失在记忆中，但它已经无法继续维持。\",\n      \"experience\": \"温暖仍留在记忆里，却不能继续维持。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P101\",\n      \"src\": \"SRC-gpt6w-web-5\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"音乐开始变得不安、复杂、充满运动感。\",\n      \"experience\": \"音乐转为不安、复杂且充满运动感。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P102\",\n      \"src\": \"SRC-gpt6w-web-5\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"我必须面对现实。\",\n      \"experience\": \"意识到必须面对现实。\",\n      \"type\": \"动因\"\n    },\n    {\n      \"id\": \"P103\",\n      \"src\": \"SRC-gpt6w-web-5\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"无论怎样努力，它都在逐渐远离。\",\n      \"experience\": \"越努力抓住重要之物，它越显得远离。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P104\",\n      \"src\": \"SRC-gpt6w-web-5\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"不同的声音仿佛不再只是共同支持一条旋律，而是各自带着不同的方向和情绪。\",\n      \"experience\": \"不同声部仿佛各有方向与情绪。\",\n      \"type\": \"音乐描述\"\n    },\n    {\n      \"id\": \"P105\",\n      \"src\": \"SRC-gpt6w-web-5\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"较高的线条可以更明亮、偏冷，较低的线条则更温暖。\",\n      \"experience\": \"高声部偏明亮冷冽，低声部更温暖。\",\n      \"type\": \"演奏差异\"\n    },\n    {\n      \"id\": \"P106\",\n      \"src\": \"SRC-gpt6w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"原稿标题覆盖100–128，但本句明确从m.100开始描述不安的重新出现；后续112–128另述线条复杂化，故定位于100–111。\",\n      \"quote\": \"从 mm. 100 开始，音乐重新进入更加不安的状态。\",\n      \"experience\": \"从m.100起音乐重新转入不安。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P107\",\n      \"src\": \"SRC-gpt6w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"之前被安抚下来的内心问题重新浮现。\",\n      \"experience\": \"先前被安抚的内心问题再次浮现。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P108\",\n      \"src\": \"SRC-gpt6w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"刚才那个温暖的世界还在记忆中，但现实中的自己仍然没有抵达那里。\",\n      \"experience\": \"温暖世界仍在记忆中，现实却尚未抵达。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P109\",\n      \"src\": \"SRC-gpt6w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"我知道自己想要什么，也知道什么东西能够让我幸福，但我就是无法真正得到它。\",\n      \"experience\": \"知道幸福所需，却无法真正获得。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P110\",\n      \"src\": \"SRC-gpt6w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"他试图继续向前，试图找到出口，甚至可能想通过行动来改变自己的处境。\",\n      \"experience\": \"尝试前进、寻找出口并改变处境。\",\n      \"type\": \"动因\"\n    },\n    {\n      \"id\": \"P111\",\n      \"src\": \"SRC-gpt6w-web-6\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"这种努力并没有带来真正的答案。\",\n      \"experience\": \"努力寻找仍未获得答案。\",\n      \"type\": \"感受\"\n    }\n  ],\n  \"excluded\": [\n    {\n      \"src\": \"SRC-gpt56w-int-1\",\n      \"quote\": \"到了 mm.125 左右，反复出现的音型带有一种明显的执着感。\",\n      \"belongs_to\": \"mm.125–128\",\n      \"reason\": \"原稿明确定位在m.125附近，已超出S08的100–111。\"\n    },\n    {\n      \"src\": \"SRC-gpt56w-int-2\",\n      \"quote\": \"出现新的节奏性格，情绪更加不安，甚至带有某种躁动。\",\n      \"belongs_to\": \"mm.112–119\",\n      \"reason\": \"原稿分项明确标为112–119，属于S08之后的新节奏材料。\"\n    },\n    {\n      \"src\": \"SRC-gpt56w-int-2\",\n      \"quote\": \"先前主题的影子重新出现，音乐不断累积压力\",\n      \"belongs_to\": \"mm.120–128\",\n      \"reason\": \"原稿将该变化标在120–128，并将高潮定位于m.125，属于后续位置。\"\n    },\n    {\n      \"src\": \"SRC-gpt56w-int-4\",\n      \"quote\": \"尤其是 mm. 121–128，原来的主题和开头的材料重新浮现。\",\n      \"belongs_to\": \"mm.121–128\",\n      \"reason\": \"原稿明确标出121–128，属于后续主题材料重新出现的位置。\"\n    },\n    {\n      \"src\": \"SRC-gpt56w-web-2\",\n      \"quote\": \"mm.112–128，音乐开始出现更加复杂的线条交织\",\n      \"belongs_to\": \"mm.112–128\",\n      \"reason\": \"原稿明确将复杂线条交织定位在112–128，超出S08。\"\n    },\n    {\n      \"src\": \"SRC-gpt56w-web-3\",\n      \"quote\": \"mm. 113–120：不同的旋律材料开始交错，原先的主题碎片重新出现。\",\n      \"belongs_to\": \"mm.113–120\",\n      \"reason\": \"原稿明确标为113–120，属于后续旋律材料交错的部分。\"\n    },\n    {\n      \"src\": \"SRC-gpt56w-web-3\",\n      \"quote\": \"mm. 121–128：开头的重复音型逐渐重新浮现。\",\n      \"belongs_to\": \"mm.121–128\",\n      \"reason\": \"原稿明确标为121–128，属于开头重复音型重新浮现的部分。\"\n    },\n    {\n      \"src\": \"SRC-gpt56w-web-4\",\n      \"quote\": \"mm. 112–118 还短暂出现近似田园、鸟鸣般的柔和色彩\",\n      \"belongs_to\": \"mm.112–118\",\n      \"reason\": \"原稿明确定位112–118，描述的是后续短暂的柔和色彩。\"\n    },\n    {\n      \"src\": \"SRC-gpt56w-web-4\",\n      \"quote\": \"mm. 119–128：音乐开始出现一种更强烈的自我肯定。\",\n      \"belongs_to\": \"mm.119–128\",\n      \"reason\": \"原稿明确将自我肯定和英雄式突破定位在119–128。\"\n    },\n    {\n      \"src\": \"SRC-gpt56w-web-5\",\n      \"quote\": \"mm.117–128，紧张感逐渐重新聚集，仿佛一切都在为下一次重要的出现做准备。\",\n      \"belongs_to\": \"mm.117–128\",\n      \"reason\": \"原稿明确标出117–128，属于后续紧张感重新聚集的阶段。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-int-1\",\n      \"quote\": \"原本向外展开的运动，逐渐转向更加复杂、内省的状态。\",\n      \"belongs_to\": \"mm.117–128\",\n      \"reason\": \"上下文明确以117–128为进一步变化的位置，描述的是后续内省状态。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-int-3\",\n      \"quote\": \"尤其是接近 mm. 125 的反复音型，会让人联想到开头那种尚未说清楚的声音。\",\n      \"belongs_to\": \"mm.125–128\",\n      \"reason\": \"原稿明确将反复音型定位在m.125附近，超出目标范围。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-int-5\",\n      \"quote\": \"这时音乐仍然处于比较活跃的状态。\",\n      \"belongs_to\": \"mm.112–128\",\n      \"reason\": \"该句位于原稿明确标出的112–128小节分项中。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-int-5\",\n      \"quote\": \"一方面，他知道自己应该向前走；另一方面，他又不断被过去吸引。\",\n      \"belongs_to\": \"mm.112–128\",\n      \"reason\": \"该心理摇摆属于原稿单独标出的112–128小节，而非100–111。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-int-6\",\n      \"quote\": \"出现新的、带有切分感的舞蹈性材料\",\n      \"belongs_to\": \"mm.112–119\",\n      \"reason\": \"原稿明确将切分舞蹈性材料定位在112–119。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-int-6\",\n      \"quote\": \"最初主题的片段重新出现，但已经不像完整的歌唱\",\n      \"belongs_to\": \"mm.120–124\",\n      \"reason\": \"原稿明确将最初主题片段的重新出现定位在120–124。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-int-6\",\n      \"quote\": \"音乐达到这一阶段的高潮，并重新唤起开头的引子材料。\",\n      \"belongs_to\": \"mm.125–128\",\n      \"reason\": \"原稿明确将高潮和引子材料的重新唤起定位在125–128。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-web-1\",\n      \"quote\": \"mm. 112–118，音乐又短暂地出现田园般的宁静色彩\",\n      \"belongs_to\": \"mm.112–118\",\n      \"reason\": \"原稿明确将田园般的宁静色彩定位在112–118，属于相邻位置。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-web-3\",\n      \"quote\": \"前面的活动逐渐沉下来，随后出现一种更加清晰、相对干燥的多声部织体。\",\n      \"belongs_to\": \"mm.117–128\",\n      \"reason\": \"上下文明确将该织体及其内省性变化定位在117–128。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-web-4\",\n      \"quote\": \"mm. 112–120 出现了一个新的、比较轻盈的舞蹈性主题。\",\n      \"belongs_to\": \"mm.112–120\",\n      \"reason\": \"原稿明确定位112–120，属于后续舞蹈性主题。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-web-4\",\n      \"quote\": \"到了 mm. 121–128，音乐又出现一个短暂的辉煌时刻。\",\n      \"belongs_to\": \"mm.121–128\",\n      \"reason\": \"原稿明确定位121–128，属于后续辉煌高潮。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-web-5\",\n      \"quote\": \"直到 mm. 128 左右，音乐逐渐收住，仿佛终于筋疲力尽。\",\n      \"belongs_to\": \"mm.128\",\n      \"reason\": \"原稿将音乐收束和疲惫感定位在m.128，属于目标范围之后。\"\n    },\n    {\n      \"src\": \"SRC-gpt6w-web-6\",\n      \"quote\": \"mm. 112–128，这种不安进一步发展，出现更多复杂、活跃的音乐线条。\",\n      \"belongs_to\": \"mm.112–128\",\n      \"reason\": \"原稿明确将进一步复杂化定位在112–128，属于后续发展。\"\n    }\n  ],\n  \"sources_checked\": {\n    \"SRC-gpt56w-int-1\": 4,\n    \"SRC-gpt56w-int-2\": 4,\n    \"SRC-gpt56w-int-3\": 5,\n    \"SRC-gp