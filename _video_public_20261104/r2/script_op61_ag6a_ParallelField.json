 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "beads": [
      {
       "text": "开头沉重的和弦，像逼着自己挺直背脊；紧接着散开的声音，却让这份力气又悬了起来。",
       "keys": [
        "挺直背脊",
        "又悬了起来",
        "又悬了起来"
       ],
       "from": [
        "S01-B1-p1",
        "S01-B1-p2",
        "S01-B2-p1"
       ]
      }
     ],
     "lines": [
      {
       "text": "他已经离开了那种总要委屈自己的生活，想守住这份尊严，却还不知道接下来怎样站稳。",
       "keys": [
        "离开了",
        "守住这份尊严",
        "怎样站稳",
        "怎样站稳"
       ],
       "from": [
        "S01-1",
        "S01-3"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "短短的声音像刚要叹息便停住了；又像伸手想摸到什么，却只摸了个空。",
       "keys": [
        "刚要叹息便停住了",
        "只摸了个空",
        "只摸了个空"
       ],
       "from": [
        "S01-B3-p1",
        "S01-B4-p2"
       ]
      }
     ],
     "lines": [
      {
       "text": "离开后的空落来得突然，他连自己究竟舍不得什么都说不清。",
       "keys": [
        "空落",
        "舍不得什么",
        "说不清",
        "说不清"
       ],
       "from": [
        "S01-2"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "旋律渐渐清楚，像从前熟悉的场面又浮现在眼前。可再清楚，也只是回忆。",
       "keys": [
        "熟悉的场面",
        "只是回忆",
        "只是回忆"
       ],
       "from": [
        "S01-B5-p1",
        "S01-B5-p2"
       ]
      }
     ],
     "lines": [
      {
       "text": "他偶尔会想起过去的日子，但那份熟悉已经不能让现在的自己安心。",
       "keys": [
        "过去的日子",
        "不能让现在的自己安心",
        "不能让现在的自己安心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "熟悉的舞步慢慢浮现，像身体已经记起怎么迈步，却还没有真正走稳。",
       "keys": [
        "记起怎么迈步",
        "没有真正走稳",
        "没有真正走稳"
       ],
       "from": [
        "S01-B5-p3",
        "S01-B5-p4"
       ]
      }
     ],
     "lines": [
      {
       "text": "他还是想往前过，只是还没找到能让自己安下心的方向。",
       "keys": [
        "想往前过",
        "安下心的方向",
        "安下心的方向"
       ],
       "from": [
        "S01-3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "beads": [
      {
       "text": "舞步明明挺拔，旋律却像远处传来的旧歌。那些熟悉的美好仿佛还在，却已经无法像从前那样拥有。",
       "keys": [
        "远处传来的旧歌",
        "无法像从前那样拥有",
        "无法像从前那样拥有"
       ],
       "from": [
        "S02-B1-p2",
        "S02-B1-p4",
        "S02-B2-p2"
       ]
      }
     ],
     "lines": [
      {
       "text": "他舍不得以前自在的好日子。难道为了不再受委屈，就得连那些好也一起丢掉？",
       "keys": [
        "舍不得",
        "以前自在的好日子",
        "一起丢掉",
        "一起丢掉"
       ],
       "from": [
        "S02-1",
        "S02-3"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "那股挺拔劲儿像在反复告诉自己“我没事”，越说越听得出在意；可里面也有一股真切的不甘心。",
       "keys": [
        "我没事",
        "在意",
        "不甘心",
        "不甘心"
       ],
       "from": [
        "S02-B4-p3",
        "S02-B5-p1"
       ]
      }
     ],
     "lines": [
      {
       "text": "一想起过去的好，他就赶紧提醒自己受过的气，怕心一软，忘了当初为什么离开。但他也确实不甘心失去那些好时光。",
       "keys": [
        "受过的气",
        "为什么离开",
        "不甘心失去",
        "不甘心失去"
       ],
       "from": [
        "S02-2",
        "S02-3"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "一连串音符把呼吸催得越来越急，像怎么使劲，都没法安稳地落下来。",
       "keys": [
        "呼吸催得越来越急",
        "没法安稳",
        "没法安稳"
       ],
       "from": [
        "S02-B3-p2",
        "S02-B3-p3"
       ]
      }
     ],
     "lines": [
      {
       "text": "他越想守住离开的理由，越忍不住为那些再也不能照旧过的好日子发慌。",
       "keys": [
        "守住离开的理由",
        "发慌",
        "发慌"
       ],
       "from": [
        "S02-1",
        "S02-2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "beads": [
      {
       "text": "音乐忽然柔和亲切，像重新感到那种不用防备的亲近。暖意还没散，心里却已经酸了。",
       "keys": [
        "柔和亲切",
        "不用防备的亲近",
        "心里却已经酸了",
        "心里却已经酸了"
       ],
       "from": [
        "S03-B2-p1",
        "S03-B2-p3",
        "S03-B2-p4"
       ]
      }
     ],
     "lines": [
      {
       "text": "他明明还生着气，想到曾经有人把自己当作自己人，竟真的高兴了一小会儿；可那样的日子如今已经过不成了。",
       "keys": [
        "还生着气",
        "当作自己人",
        "高兴了一小会儿",
        "已经过不成了",
        "已经过不成了"
       ],
       "from": [
        "S03-1",
        "S03-2"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "舞步变得灵活，却又飘忽不定，像想往前走，却总找不准方向。",
       "keys": [
        "飘忽不定",
        "找不准方向",
        "找不准方向"
       ],
       "from": [
        "S03-B1-p3",
        "S03-B3-p2"
       ]
      }
     ],
     "lines": [
      {
       "text": "这一小会儿的快乐是真的，但离开以后究竟能不能过得更好，他仍然没有把握。",
       "keys": [
        "快乐是真的",
        "没有把握",
        "没有把握"
       ],
       "from": [
        "S03-2"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "开头那一下重重砸下，像压在心里的火气突然撞了出来。",
       "keys": [
        "重重砸下",
        "火气突然撞了出来",
        "火气突然撞了出来"
       ],
       "from": [
        "S03-B1-p1"
       ]
      }
     ],
     "lines": [
      {
       "text": "他心里那股气还没消。想念曾经的亲近，并没有让过去的不满一并消失。",
       "keys": [
        "那股气还没消",
        "想念曾经的亲近",
        "想念曾经的亲近"
       ],
       "from": [
        "S03-1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "beads": [
      {
       "text": "熟悉的旋律又变得柔软，仿佛旧日的亲近重新有了温度。原来的挺拔步态还在，里面却多了一份容易受伤的温柔。",
       "keys": [
        "重新有了温度",
        "挺拔步态",
        "容易受伤的温柔",
        "容易受伤的温柔"
       ],
       "from": [
        "S04-B1-p2",
        "S04-B1-p3"
       ]
      }
     ],
     "lines": [
      {
       "text": "想起那些亲近的时候，他真希望一切还能像从前那样继续，哪怕心里已经没那么笃定。",
       "keys": [
        "还能像从前那样继续",
        "没那么笃定",
        "没那么笃定"
       ],
       "from": [
        "S04-1",
        "S04-2"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "原本温暖的音乐忽然紧绷起来，低音像在追赶，急促的声音让人心跳都乱了。最刺痛人的，恰恰是回忆太美好。",
       "keys": [
        "忽然紧绷",
        "心跳都乱了",
        "回忆太美好",
        "回忆太美好"
       ],
       "from": [
        "S04-B2-p1",
        "S04-B2-p2",
        "S04-B3-p2"
       ]
      }
     ],
     "lines": [
      {
       "text": "他忍不住反复问自己：要是当初没走呢？是不是就不会失去那些好日子？可他根本不知道，另一种生活会是什么样。",
       "keys": [
        "要是当初没走呢",
        "反复问自己",
        "根本不知道",
        "根本不知道"
       ],
       "from": [
        "S04-2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "beads": [
      {
       "text": "歌声忽然柔和了许多，却仍带着向前顶住压力的劲，仿佛在说：这件事不能就这么算了。",
       "keys": [
        "柔和了许多",
        "顶住压力",
        "不能就这么算了",
        "不能就这么算了"
       ],
       "from": [
        "S05-B1-p1",
        "S05-B2-p1",
        "S05-B2-p2"
       ]
      }
     ],
     "lines": [
      {
       "text": "那些委屈他仍觉得不该忍，可连过去开心的事都不敢多想，也太难为自己了。",
       "keys": [
        "委屈",
        "不该忍",
        "开心的事都不敢多想",
        "开心的事都不敢多想"
       ],
       "from": [
        "S05-1"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "柔和的歌唱像让旧日记忆重新有了温度，可越觉得亲近，越听得出失去它的难受。",
       "keys": [
        "重新有了温度",
        "亲近",
        "失去它的难受",
        "失去它的难受"
       ],
       "from": [
        "S05-B3-p1",
        "S05-B3-p3"
       ]
      }
     ],
     "lines": [
      {
       "text": "他舍不得以前那些开心的日子，也清楚自己如今已经不在那些人身边了。",
       "keys": [
        "舍不得",
        "已经不在那些人身边了",
        "已经不在那些人身边了"
       ],
       "from": [
        "S05-1",
        "S05-2"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "密集的声音渐渐稀疏，像终于深深叹了一口气。紧绷松开了，却更像是累得撑不住，而不是已经安心。",
       "keys": [
        "深深叹了一口气",
        "累得撑不住",
        "不是已经安心",
        "不是已经安心"
       ],
       "from": [
        "S05-B5-p2",
        "S05-B5-p3"
       ]
      }
     ],
     "lines": [
      {
       "text": "他跟自己争得没了力气，那股不服气渐渐淡下去，剩下的是离开那些熟悉的人以后的难受。",
       "keys": [
        "争得没了力气",
        "不服气渐渐淡下去",
        "难受",
        "难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "beads": [
      {
       "text": "声音慢慢进入安静，像耳边有人轻轻哼着摇篮曲，让紧绷许久的心终于能松开戒备。",
       "keys": [
        "摇篮曲",
        "松开戒备",
        "松开戒备"
       ],
       "from": [
        "S06-B1-p1",
        "S06-B1-p4"
       ]
      }
     ],
     "lines": [
      {
       "text": "他想起以前和人在一起、不必时时防备的日子。这一次，他没有急着拿受过的委屈压住想念，也不用逼自己一直坚强。",
       "keys": [
        "不必时时防备",
        "没有急着",
        "压住想念",
        "一直坚强",
        "一直坚强"
       ],
       "from": [
        "S06-1"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "歌声像在向远处轻轻祈求。愿望那么真切，却没有听见确定的回应。",
       "keys": [
        "轻轻祈求",
        "没有听见确定的回应",
        "没有听见确定的回应"
       ],
       "from": [
        "S06-B2-p4"
       ]
      },
      {
       "text": "歌声又舒展开来，那份想要靠近的心情变得更加迫切。",
       "keys": [
        "想要靠近",
        "更加迫切",
        "更加迫切"
       ],
       "from": [
        "S06-B3-p2"
       ]
      }
     ],
     "lines": [
      {
       "text": "离开以后，难熬的时候常常只能自己扛，他才更明白有人在身边有多好。他很想再拥有那种不必多说也能亲近的陪伴，又怕以后再也遇不到。",
       "keys": [
        "只能自己扛",
        "有人在身边",
        "很想再拥有",
        "怕以后再也遇不到",
        "怕以后再也遇不到"
       ],
       "from": [
        "S06-2",
        "S06-3"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "轻柔的声音又像让人安静看着自己珍惜的东西，不必急着伸手把它抓回来。",
       "keys": [
        "珍惜的东西",
        "不必急着",
        "抓回来",
        "抓回来"
       ],
       "from": [
        "S06-B4-p1",
        "S06-B4-p2"
       ]
      }
     ],
     "lines": [
      {
       "text": "那样温暖的日子毕竟真实地有过。虽然现在不能重来，光是好好记着，他心里也能暖和一点。",
       "keys": [
        "真实地有过",
        "好好记着",
        "暖和一点",
        "暖和一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "beads": [
      {
       "text": "高处的声音忽然细细颤起来，像寒风猛地吹开窗户。后颈一凉，人仿佛一下从刚才的温暖中惊醒。",
       "keys": [
        "忽然细细颤起来",
        "后颈一凉",
        "惊醒",
        "惊醒"
       ],
       "from": [
        "S07-B1-p1",
        "S07-B1-p2",
        "S07-B1-p3",
        "S07-B1-p4"
       ]
      }
     ],
     "lines": [
      {
       "text": "刚有一点安心，他就猛然想到：以后再遇上难事，如果仍然只有自己，他真的撑得住吗？当初只顾着不再受委屈，没想到会这么孤单。",
       "keys": [
        "猛然想到",
        "只有自己",
        "撑得住吗",
        "这么孤单",
        "这么孤单"
       ],
       "from": [
        "S07-1",
        "S07-2"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "熟悉的舞步突然闯进来，像过去那些平常的生活又出现在眼前。声音虽然亲切，却没能让人安定。",
       "keys": [
        "熟悉的舞步",
        "过去那些平常的生活",
        "没能让人安定",
        "没能让人安定"
       ],
       "from": [
        "S07-B2-p2",
        "S07-B2-p3",
        "S07-B4-p1",
        "S07-B4-p3"
       ]
      }
     ],
     "lines": [
      {
       "text": "他想找回从前的亲近，又不甘心回去重新忍让。可现在连当初决定离开时的那份笃定，也找不着了。",
       "keys": [
        "想找回",
        "不甘心回去重新忍让",
        "笃定",
        "找不着了",
        "找不着了"
       ],
       "from": [
        "S07-2",
        "S07-3"
       ]
      }
     ]
    },
    {
     "beads": [
      {
       "text": "细细颤动的声音一阵接一阵，像心里有什么一直在发抖，想冲出去，却始终找不到出口。",
       "keys": [
        "一阵接一阵",
        "一直在发抖",
        "找不到出口",
        "找不到出口"
       ],
       "from": [
        "S07-B3-p1",
        "S07-B3-p3",
        "S07-B3-p4"
       ]
      }
     ],
     "lines": [
      {
       "text": "一想到以后可能还得独自面对困难，那阵慌张就很难退下去。他想回去，却也再无法放心回去。",
       "keys": [
        "独自面对困难",
        "慌张",
        "无法放心回去",
        "无法放心回去"
       ],
       "from": [
        "S07-1",
        "S07-3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "beads": [
      {
       "text": "熟悉的轻柔歌声短暂回来，像胸口终于吸进一口气。可还没来得及安顿下来，那份安静就又退去了。",
       "keys": [
        "短暂回来",
        "吸进一口气",
        "又退去了",
        "又退去了"
       ],
       "from": [
        "S08-B1-p1",
        "S08-B2-p1",
        "S08-B3-p1",
        "S08-B3-p2"
       ]
