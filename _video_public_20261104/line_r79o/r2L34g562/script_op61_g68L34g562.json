       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他还是得过眼下的日子，却不知道该把对那份归属的需要安放在哪里",
