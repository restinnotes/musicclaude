{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他已经离开熟悉的生活\",\n          \"accent\": \"离开\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S01-1\"]\n        },\n        {\n          \"text\": \"起初他觉得不用再委屈自己\",\n          \"accent\": \"不用再委屈自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\"]\n        },\n        {\n          \"text\": \"他像是挺直背脊却很想停下\",\n          \"accent\": \"很想停下\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-B2\"]\n        },\n        {\n          \"text\": \"他空落落的说不清舍不得什么\",\n          \"accent\": \"空落落\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S01-2\", \"S01-B3\"]\n        },\n        {\n          \"text\": \"他想往前过却不知怎样安心\",\n          \"accent\": \"不知怎样安心\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"尊严还在，方向和力气却不稳\",\n          \"after\": 2,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"分不清是愤怒、遗憾还是怀念\",\n          \"after\": 3,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"像从昏沉里醒来，四周冷空，仍没哭\",\n          \"after\": 3,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"胸口发紧，眼前模糊，伸手摸空\",\n          \"after\": 3,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"旧日声音光线回来，却回不到现在\",\n          \"after\": 4,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"9–17\"\n        },\n        {\n          \"text\": \"身体先于意识记起怎样迈步\",\n          \"after\": 4,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"18–23\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"开头沉重的一下之后，声音轻轻散向高处\",\n          \"from\": [\"S01-B1\", \"S01-B2\"],\n          \"bars\": \"1–6\"\n        },\n        {\n          \"text\": \"停顿里像还等着一个迟迟未来的回声\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–6\"\n        },\n        {\n          \"text\": \"短句刚冒出来，就被长停顿截断\",\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"旧日旋律的轮廓渐渐清楚\",\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"9–17\"\n        },\n        {\n          \"text\": \"舞曲的步态渐渐浮现\",\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"18–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"他舍不得从前自在的日子\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-1\"]\n        },\n        {\n          \"text\": \"想到以后不能那样过\",\n          \"accent\": \"不能那样过\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-1\"]\n        },\n        {\n          \"text\": \"他心里就有些慌\",\n          \"accent\": \"慌\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-1\"]\n        },\n        {\n          \"text\": \"他赶紧想起当初受过的气\",\n          \"accent\": \"受过的气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\"]\n        },\n        {\n          \"text\": \"他不甘心连好日子也要丢掉\",\n          \"accent\": \"不甘心\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-3\", \"S02-B5\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"远处旧歌像腿脚虚浮的舞步\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\", \"S02-B2\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"依稀记得，却只能模糊哼几句\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"他像整理衣服抬头，不让人看出动摇\",\n          \"after\": 3,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"起初还信我没事，后来越说越显在意\",\n          \"after\": 3,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"44–65\"\n        },\n        {\n          \"text\": \"悲伤还在，他不肯把自己交给悲伤\",\n          \"after\": 3,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"我不甘心就这样消亡\",\n          \"after\": 4,\n          \"from\": [\"S02-B5\"],\n          \"bars\": \"44–65\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"庄严的舞步下，藏着私人低声哼唱\",\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"伴奏里有细碎不安的声音游动\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"音乐猛地往上推，又退下来\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"38–43\"\n        },\n        {\n          \"text\": \"力量重新聚拢，最后仍没落稳\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"44–65\"\n        },\n        {\n          \"text\": \"连续的三连音把呼吸催得更急\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"56–65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他心里还憋着一股气\",\n          \"accent\": \"憋着一股气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S03-1\"]\n        },\n        {\n          \"text\": \"想起有人把他当自己人\",\n          \"accent\": \"当自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"]\n        },\n        {\n          \"text\": \"那点高兴很快又变酸\",\n          \"accent\": \"变酸\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S03-1\", \"S03-2\", \"S03-B2\"]\n        },\n        {\n          \"text\": \"从前的日子已经过不成\",\n          \"accent\": \"过不成\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S03-2\"]\n        },\n        {\n          \"text\": \"离开以后就一定更好过吗\",\n          \"accent\": \"一定更好过吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像故乡麦浪，也像亲近时无须防备\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"80–91\"\n        },\n        {\n          \"text\": \"像暂时聊别的或出去走走，躲开伤口\",\n          \"after\": 2,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"那一刻的轻松是真的，却没答案\",\n          \"after\": 2,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"我刚才真信了那些话吗\",\n          \"after\": 2,\n          \"from\": [\"S03-B5\"],\n          \"bars\": \"66–91\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"开头重击后，舞步转得灵活而不安\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"前半段显得急切\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"66–79\"\n        },\n        {\n          \"text\": \"后半段忽然柔和轻盈\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"80–91\"\n        },\n        {\n          \"text\": \"声音像耳边絮语，重心却像流沙漂移\",\n          \"from\": [\"S03-B4\"],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"昂扬慢慢退潮，声音变得流动含蓄\",\n          \"from\": [\"S03-B5\"],\n          \"bars\": \"66–91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"他真盼着还能亲近如从前\",\n          \"accent\": \"亲近如从前\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-1\"]\n        },\n        {\n          \"text\": \"旧日亲近鲜活委屈也翻上来\",\n          \"accent\": \"委屈也翻上来\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\", \"S04-B1\", \"S04-B2\"]\n        },\n        {\n          \"text\": \"他反复问自己当初走得对吗\",\n          \"accent\": \"走得对吗\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\", \"S04-B4\"]\n        },\n        {\n          \"text\": \"没走的话如今又会怎样\",\n          \"accent\": \"又会怎样\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\", \"S04-B4\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"回忆里有感激柔情和短暂幸福\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\"\n        },\n        {\n          \"text\": \"外面还在往前，心里却多了回声\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\"\n        },\n        {\n          \"text\": \"那份坚定或许只是他想成为的样子\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\"\n        },\n        {\n          \"text\": \"脚步急，心跳乱，像被时间追着跑\",\n          \"after\": 1,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92–115\"\n        },\n        {\n          \"text\": \"他不停往前赶，只为躲开停下\",\n          \"after\": 2,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94–115\"\n        },\n        {\n          \"text\": \"正因记忆太好，才更难回到从前\",\n          \"after\": 1,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"92–115\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的舞曲主题重新出现，语气更抒情\",\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\"\n        },\n        {\n          \"text\": \"温暖突然转为风暴般的紧绷\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108–115\"\n        },\n        {\n          \"text\": \"声音一路向下，像被撕扯着后退\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108–115\"\n        },\n        {\n          \"text\": \"细碎音符越来越急，像脚步不断追赶\",\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92–115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他仍觉得当初那些气不该忍\",\n          \"accent\": \"不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\", \"S05-B2\"]\n        },\n        {\n          \"text\": \"可过去开心的事他也想记得\",\n          \"accent\": \"开心的事\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S05-1\"]\n        },\n        {\n          \"text\": \"他跟自己争得渐渐没了力气\",\n          \"accent\": \"没了力气\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\", \"S05-B5\"]\n        },\n        {\n          \"text\": \"那股不服气慢慢淡了\",\n          \"accent\": \"慢慢淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-2\"]\n        },\n        {\n          \"text\": \"想到如今不在他们身边他很难受\",\n          \"accent\": \"不在他们身边\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"这件事不能就这样算了\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116–127\"\n        },\n        {\n          \"text\": \"旧日记忆又有了温度\",\n          \"after\": 1,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116–147\"\n        },\n        {\n          \"text\": \"可能是某个人，也可能是故乡或旧生活\",\n          \"after\": 1,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116–147\"\n        },\n        {\n          \"text\": \"想念里还带着失落\",\n          \"after\": 4,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116–147\"\n        },\n        {\n          \"text\": \"抵抗到这时已经很累，心里仍没想通\",\n          \"after\": 3,\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"约132–147\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌唱忽然柔和亲近，像换了个人开口\",\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"116–147\"\n        },\n        {\n          \"text\": \"两道声音像夜色里互相低语的影子\",\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"116–147\"\n        },\n        {\n          \"text\": \"柔和歌唱里仍有一股向前的压力\",\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116–127\"\n        },\n        {\n          \"text\": \"快速音型渐渐放慢变稀，最后只剩疏落和弦\",\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128–147\"\n        },\n        {\n          \"text\": \"旋律几乎单独露出来\",\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128–129、139–144\"\n        },\n        {\n          \"text\": \"声音稀疏下来，像几次深深叹息\",\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"144–147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"他这回没拿委屈压住想念\",\n          \"accent\": \"没拿委屈压住想念\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-1\"]\n        },\n        {\n          \"text\": \"离开后他才懂有人陪着多轻松\",\n          \"accent\": \"有人陪着多轻松\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-2\"]\n        },\n        {\n          \"text\": \"他想再有不用多说的亲近\",\n          \"accent\": \"不用多说的亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-3\"]\n        },\n        {\n          \"text\": \"可他怕以后再也遇不到\",\n          \"accent\": \"再也遇不到\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-3\"]\n        },\n        {\n          \"text\": \"想起自己曾拥有过他心里暖了\",\n          \"accent\": \"心里暖了\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-4\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像隔着玻璃罩，连呼吸都放轻\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"他终于不用解释难过，也不用装坚强\",\n          \"after\": 0,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"压住的愿望委屈和思念终于浮上来\",\n          \"after\": 0,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"像向远方祈求，却不知会否回应\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"远方忽然亮起，梦里看见家园\",\n          \"after\": 4,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"约160\"\n        },\n        {\n          \"text\": \"挽不回的珍贵，他只想轻轻看着\",\n          \"after\": 4,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"148–180\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌唱绵长舒缓，像世界忽然静下来\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"庄严的歌唱里又藏着私语般的柔软\",\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"歌唱还含蓄试探，像话还没说出口\",\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"148–151\"\n        },\n        {\n          \"text\": \"歌唱逐渐展开，随后变得更充实迫切\",\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"152–180\"\n        },\n        {\n          \"text\": \"临近结尾，像一句话说到一半停住\",\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"168–180\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"仿佛从甜梦里被猛地惊醒\",\n          \"accent\": \"猛地惊醒\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-B1\"]\n        },\n        {\n          \"text\": \"他怕以后难事还得独自扛\",\n          \"accent\": \"独自扛\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-1\", \"S07-B3\"]\n        },\n        {\n          \"text\": \"他当初离开只想不再受气\",\n          \"accent\": \"不再受气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-2\"]\n        },\n        {\n          \"text\": \"他没想到离开后会这么孤单\",\n          \"accent\": \"这么孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-2\", \"S07-B4\"]\n        },\n        {\n          \"text\": \"他想找回亲近却不愿再受气\",\n          \"accent\": \"不愿再受气\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"寒风吹开窗，后颈发凉，脉搏猛跳\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\"\n        },\n        {\n          \"text\": \"舞步突然闯来，像换了一个场景\",\n          \"after\": 0,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"事情像过去了，心里仍翻腾，找不到出口\",\n          \"after\": 1,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\"\n        },\n        {\n          \"text\": \"熟悉动作和舞蹈闯来，更显出失去\",\n          \"after\": 3,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181–205\"\n        },\n        {\n          \"text\": \"早知道会这么孤单，他还会走吗\",\n          \"after\": 3,\n          \"from\": [\"S07-2\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"当初离开时那股决心也找不着了\",\n          \"after\": 4,\n          \"from\": [\"S07-3\"],\n          \"bars\": \"\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高处忽然浮出一串细长颤音\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\"\n        },\n        {\n          \"text\": \"新的舞步突然闯入，打断前面的静谧\",\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"旧日舞曲的影子又出现，却不再完整\",\n          \"from\": [\"S07-B5\"],\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"连续颤音让紧张一层层累积\",\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"他先把回去的事放一边\",\n          \"accent\": \"放一边\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-1\"]\n        },\n        {\n          \"text\": \"想起被当作自己人心里暖了\",\n          \"accent\": \"心里暖了\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\", \"S08-B1\"]\n        },\n        {\n          \"text\": \"可回忆不能陪他面对以后难事\",\n          \"accent\": \"不能陪他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-2\"]\n        },\n        {\n          \"text\": \"那点暖意很快淡去心又悬起来\",\n          \"accent\": \"心又悬起来\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-2\", \"S08-B2\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像临走前回头再看一眼\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"206–213\"\n        },\n        {\n          \"text\": \"胸口像吸进一口气，只是短暂喘息\",\n          \"after\": 3,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"206–213\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"缓慢宽广的歌唱短暂回来\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"206–213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他忽然说不清为何想回去\",\n          \"accent\": \"说不清\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-1\"]\n        },\n        {\n          \"text\": \"他舍不得曾被当作自己人\",\n          \"accent\": \"当作自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S09-1\"]\n        },\n        {\n          \"text\": \"还是怕孤单到愿意再受委屈\",\n          \"accent\": \"愿意再受委屈\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"]\n        },\n        {\n          \"text\": \"这念头让他心慌得不敢再想\",\n          \"accent\": \"不敢再想\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-2\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从另一面重新看见同一扇门\",\n          \"after\": 0,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\"\n        },\n        {\n          \"text\": \"像重新遇见那个不知怎么办的自己\",\n          \"after\": 0,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–215\"\n        },\n        {\n          \"text\": \"这回他知道那人经历过什么\",\n          \"after\": 1,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–215\"\n        },\n        {\n          \"text\": \"最初的问题仍没有简单答案\",\n          \"after\": 3,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–215\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"巨大的颤音光晕里闪出开头的引子\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"206–215\"\n        },\n        {\n          \"text\": \"声音短暂落稳，又向高处漂去\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214–215\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他最舍不得被当作自己人\",\n          \"accent\": \"最舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"]\n        },\n        {\n          \"text\": \"可回去还能像从前那样吗\",\n          \"accent\": \"还能像从前那样吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-1\"]\n        },\n        {\n          \"text\": \"他不能当作那些委屈没发生\",\n          \"accent\": \"委屈没发生\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S10-2\"]\n        },\n        {\n          \"text\": \"他想得太累还是没有答案\",\n          \"accent\": \"太累\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S10-3\", \"S10-B3\", \"S10-B4\"]\n        },\n        {\n          \"text\": \"眼下的日子也过得不踏实\",\n          \"accent\": \"不踏实\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像忽然失重，整个人悬在半空\",\n          \"after\": 3,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"221–225\"\n        },\n        {\n          \"text\": \"他忍不住问自己以后该怎么过\",\n          \"after\": 3,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"216–225\"\n        },\n        {\n          \"text\": \"那段往事很重要，他却累得说不出来\",\n          \"after\": 3,\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"216–225\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的歌和舞曲都只剩零碎片段\",\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216–225\"\n        },\n        {\n          \"text\": \"摇篮曲破碎地重现，听来更凄婉\",\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216–225\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他明知未必找回亲近仍想万一\",\n          \"accent\": \"仍想万一\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-1\"]\n        },\n        {\n          \"text\": \"他不愿为一点盼头回去忍让\",\n          \"accent\": \"不愿回去忍让\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-2\"]\n        },\n        {\n          \"text\": \"他决定先把