      "S08-B1",
      "S08-B2"
     ],
     "pt": "",
     "bars": "206-213"
    }
   ]
  },
  {
   "sec": "S09",
   "big": [
    {
     "text": "他忽然说不清，想回去是舍不得被当作自己人的日子，还是怕孤单到连那些气也肯再受",
     "accent": "连那些气也肯再受",
     "emotion": "悬着",
     "from": [
      "S09-1"
     ],
     "at": 0
    },
    {
     "text": "这念头让他一阵心慌，连往下想都不敢了",
     "accent": "连往下想都不敢了",
     "emotion": "不安",
     "from": [
      "S09-2"
     ],
     "at": 4.0
    }
   ],
   "small": [
    {
     "text": "像兜了一圈又转回那扇熟悉的旧门前，双脚沉得迈不开步",
