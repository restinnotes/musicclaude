   },
   {
    "sec": "S11",
    "bars": "84–92",
    "relation": "没在想",
    "items": [
     {
      "id": "S11-1",
      "text": "熟悉的亲近补上先前未尽的欢喜。",
      "key": "熟悉的亲近补上先",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1"
      ]
     },
     {
      "id": "S11-2",
      "text": "他交出脆弱，尽情付出也安心收下温柔。",
      "key": "他交出脆弱，尽情",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-3"
      ]
     },
     {
      "id": "S11-3",
      "text": "旧酸楚未散，欢喜浓得发疼还想更深。",
      "key": "旧酸楚未散，欢喜",
      "follows": false,
      "explains": [],
      "cite": []
     }
    ],
    "because": [
     {
