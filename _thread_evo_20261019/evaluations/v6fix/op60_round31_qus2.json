      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S14",
    "bars": "111–116",
    "relation": "正在面对",
    "items": [
     {
      "id": "S14-1",
      "text": "他仍愿意留在已经袒露的亲近里，也愿意继续回应对方的需要。",
      "key": "他仍愿意留在已经",
      "follows": false,
      "explains": [],
      "cite": [
       "S12-3",
       "S13-2"
      ]
     },
     {
      "id": "S14-2",
      "text": "等心里慢慢安静下来，他又想起自己最初那份小心，仍然舍不得失去这份相互依靠。",
      "key": "等心里慢慢安静下",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2",
       "S13-1",
       "S13-3"
      ]
     },
     {
      "id": "S14-3",
      "text": "他把心里的话停在这里：眼前的幸福是真的，未来却没有保证。",
      "key": "他把心里的话停在",
      "follows": false,
