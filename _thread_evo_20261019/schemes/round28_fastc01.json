{
  "name": "round28_fastc01",
  "note": "证据准入而非选路背书：把ROUTES当作待落实的经历设计，在A4以人物实际能知道的程度写重要认识，可减轻未经铺垫的关键前提和后半段依赖错误。主要检验单独成立与前因完整性；风险是若上游路线全部缺乏可用依据，降低断言强度可能令发展变薄。",
  "steps": [
    {
      "id": "A1",
      "prompt_file": "Q6_A1.txt",
      "replace": {
        "{NAME}": "WORK_INFO",
        "{SECTIONS}": "SEGMENTS",
        "{K}": {
          "text": "3"
        },
        "{CENTER}": "CENTER"
      },
      "model": "g6",
      "after": []
    },
    {
      "id": "A2",
      "prompt_file": "Q6_A2.txt",
      "replace": {
        "{ROUTES}": "step:A1"
      },
      "model": "g6",
      "append": "\n\n【候选路线】\n{ROUTES}",
      "after": []
    },
    {
      "id": "A3",
      "prompt_file": "Q6_A3.txt",
      "replace": {
        "{SEGMENTS}": "SEGMENTS",
        "{BEADS_TEXT}": "BEADS_TEXT"
      },
      "model": "g6",
      "after": [
        "A1"
      ],
      "append": "\n\n【段落】\n{SEGMENTS}\n\n【珠子】\n{BEADS_TEXT}"
    },
    {
      "id": "A4",
      "prompt_file": "round28_fastc01_A4.txt",
      "replace": {
        "{SECTIONS}": "SEGMENTS",
        "{ROUTES}": [
          "step:A1",
          {
            "text": "\n\n【宏观评审结果】\n"
          },
          "step:A2"
        ],
        "{TARGETS}": "step:A3",
        "{CENTER}": "CENTER"
      },
      "model": "g6",
      "after": []
    }
  ],
  "final": "A4"
}