      "to": "S07-2",
      "rel": "引用"
     },
     {
      "from": "S06-3",
      "to": "S07-2",
      "rel": "引用"
     },
     {
      "from": "S07-1",
      "to": "S07-2",
      "rel": "引用"
     },
     {
      "from": "S01-1",
      "to": "S07-3",
      "rel": "引用"
     },
     {
      "from": "S07-2",
      "to": "S07-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "正在面对",
    "items": [
     {
      "id": "S08-1",
      "text": "他又沉进从前那种被当成自己人的暖意里，暂时不逼自己回答当初还会不会走。",
      "key": "他又沉进从前那种",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S07-1"
      ]
     },
     {
      "id": "S08-2",
      "text": "可这点安稳没留多久就淡了，他还是舍不得那些日子。",
      "key": "可这点安稳没留多",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-1",
      "to": "S08-1",
      "rel": "引用"
     },
     {
      "from": "S07-1",
      "to": "S08-1",
      "rel": "引用"
     },
     {
      "from": "S08-1",
      "to": "S08-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "还说不清",
    "items": [
     {
      "id": "S09-1",
      "text": "那点安慰过去，他又不知道该怎么让自己踏实下来，心里还压着一个人撑到现在的累。",
      "key": "那点安慰过去，他",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-3",
       "S06-2",
       "S08-2"
      ]
     },
     {
      "id": "S09-2",
      "text": "一想往后可能还得这样，他心里猛地一紧，过后又犹豫起来，不知道怎么办。",
      "key": "一想往后可能还得",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S09-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S01-3",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S06-2",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S08-2",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S07-1",
      "to": "S09-2",
      "rel": "引用"
     },
     {
      "from": "S09-1",
      "to": "S09-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "216–225",
    "relation": "正在面对",
    "items": [
     {
      "id": "S10-1",
      "text": "他想从回忆里找回原来那种能安心过下去的生活，可怎么想，留下来的都只是一些让他觉得暖心、熟悉的感觉。",
      "key": "他想从回忆里找回",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S09-1"
      ]
     },
     {
      "id": "S10-2",
      "text": "可当初那些委屈，哪怕现在一个人过得再难，他还是忍不了。",
      "key": "可当初那些委屈，",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S06-2"
      ]
     },
     {
      "id": "S10-3",
      "text": "刚离开时，他还能靠着总算不用忍了这点轻松撑着；现在知道少了从前那份踏实有多难受，却没法骗自己回去就会好。",
      "key": "刚离开时，他还能",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-2",
       "S03-4",
       "S06-2",
       "S10-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-1",
      "to": "S10-1",
      "rel": "引用"
     },
