       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里有东西却说不清是愤怒遗憾还是怀念。",
       "keys": [
        "愤怒",
        "遗憾",
        "怀念",
        "怀念"
       ],
       "from": [
        "S01-B3-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "撑住自己",
     "emotion": "不安",
     "lines": [
      {
       "text": "离开熟悉的生活后终于不用再一次次委屈自己。",
