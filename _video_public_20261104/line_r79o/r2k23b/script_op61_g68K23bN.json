 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "刚离开熟悉的生活，他觉得终于不用再委屈自己。",
       "keys": [
        "终于不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这份笃定很快散了，他心里空落落的，却说不清舍不得什么。",
       "keys": [
        "笃定很快散了",
        "说不清舍不得什么"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "短句像叹息，刚冒出来就被停顿截断",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "像刚醒来，胸口发紧，眼前还模糊",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他还想往前走，却不知靠什么安下心。",
       "keys": [
        "还想往前走",
        "靠什么安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "我不能倒下，可我其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "旧场景忽然清晰，过去却回不来",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "舍不得从前的自在，想到以后不能再那样过便发慌。",
       "keys": [
        "舍不得从前的自在",
        "便发慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "舞步清楚了，却不像英雄凯旋",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "腿脚发虚，还在挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "想念一来，他就拿受过的气提醒自己为何离开。",
       "keys": [
        "受过的气",
        "为何离开"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "反复说“我没事”，越说越显出在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他不甘心，难道好日子也要一并否定？",
       "keys": [
        "不甘心",
        "好日子也要一并否定"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "我不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "想起曾被当作自己人，他高兴过；旧日难再有，离开真会更好吗？",
       "keys": [
        "曾被当作自己人",
        "离开真会更好吗"
       ],
       "from": [
        "S03-1",
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像故乡夏日的麦浪与微风",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像暂时侧身离开沉重的问题，轻松是真的，却没带来答案",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前的亲近，他盼着还能那样相处。",
       "keys": [
        "从前的亲近",
        "还能那样相处"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧记忆里的亲密、感激和短暂幸福都鲜活起来",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可旧日委屈也翻上来：离开对吗？留下又会怎样？",
       "keys": [
        "旧日委屈也翻上来",
        "留下又会怎样"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不是记忆变坏，是那段日子太好了",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "脑子里反复转着：如果当时……",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他不替旧委屈开脱，也不再逼自己忘掉好时光。",
       "keys": [
        "不替旧委屈开脱",
        "不再逼自己忘掉好时光"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夜色里两个影子，彼此低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "这件事不能就这样算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "旧日记忆重新有了温度",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "争辩到累了，火气渐淡，只剩不在他们身边的难受。",
       "keys": [
        "火气渐淡",
        "不在他们身边的难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "几次深呼吸，像抵抗得累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "难受缓下来，他不再拿旧委屈压住这份想念。",
       "keys": [
        "难受缓下来",
        "不再拿旧委屈压住这份想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像被透明玻璃罩隔开的静谧",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "愿望朝远方发出，却没有回应的保证",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "离开后常得独自熬难事，他才懂有人陪着有多轻松。",
       "keys": [
        "独自熬难事",
        "有人陪着有多轻松"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "曾有过的默契让他宽慰，如今盼着再有，却怕难再遇。",
       "keys": [
        "曾有过的默契让他宽慰",
        "怕难再遇"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌唱渐渐展开，临近结束像话没说完",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "好好看着珍惜的东西，不急着抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "想到以后难事还得独自扛，他怕自己撑不住。",
       "keys": [
        "以后难事还得独自扛",
        "怕自己撑不住"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "寒风猛地吹开窗，后颈一凉",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "当初离开只为不再受气，如今孤单得又问自己还走不走。",
       "keys": [
        "只为不再受气",
        "孤单得又问自己还走不走"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像一个熟悉动作突然闯进来，反而照见失去什么",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      },
      {
       "text": "心里直想冲出去，却找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "想找回亲近，却不肯再受委屈，离开的决心也松了。",
       "keys": [
        "想找回亲近",
        "离开的决心也松了"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的舞曲气息回来，却不再完整",
       "keys": [],
       "from": [
        "S07-B5"
       ],
       "bead": "S07-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他先不把怀念当回头理由；可回忆不能陪他熬过未来难处，心仍悬着。",
       "keys": [
        "不把怀念当回头理由",
        "心仍悬着"
       ],
       "from": [
        "S08-1",
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "宽广的歌唱短暂回来，像临走前回头一眼",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "想回去，是舍不得亲近，还是怕孤单到愿再受委屈？心慌得不敢想。",
       "keys": [
        "舍不得亲近",
        "心慌得不敢想"
       ],
       "from": [
        "S09-1",
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "颤动的光晕里，开头那股沉重又阴冷地闪回",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "这次再看那个茫然的自己，已知道他经历过什么",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他最放不下那份亲近；旧委屈未消，回去未必如前，反复想仍难安。",
       "keys": [
        "最放不下那份亲近",
        "反复想仍难安"
       ],
       "from": [
        "S10-1",
        "S10-2",
        "S10-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的声音只剩碎片，重要的事已无力讲完",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "我究竟要怎样继续生活",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "明知回去未必恢复亲近，他仍忍不住盼着。",
       "keys": [
        "未必恢复亲近",
        "忍不住盼着"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "不肯只凭盼头回去；怕独自扛事，仍要先把眼下日子过稳",
       "keys": [],
       "from": [
        "S11-2"
       ],
       "bead": "S11-2"
      },
      {
       "text": "步子从试探慢慢聚拢；害怕还在，脚却往前",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "委屈不该忍，好日子也真有过；他不再逼自己选边。",
       "keys": [
        "委屈不该忍",
        "不再逼自己选边"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "可以决定怎样站立，不必假装没受过伤",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      },
      {
       "text": "仍怕独自熬，却不怪自己离开，也不为陪伴回头；带着想念过日子",
       "keys": [],
       "from": [
        "S12-2"
       ],
       "bead": "S12-2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "盼着再遇见自然亲近的人，他有劲头过日子，不再整天跟旧事较劲。",
       "keys": [
        "再遇见自然亲近的人",
        "不再整天跟旧事较劲"
       ],
       "from": [
        "S13-1",
        "S13-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "温柔的歌忽然站到明亮处，力量也涌起来",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "劲头稍退，他又怕还要等很久。",
       "keys": [
        "劲头稍退",
        "怕还要等很久"
       ],
       "from": [
        "S13-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "冲势收敛，既有一点不安，也像终于能喘口气",
       "keys": [],
       "from": [
        "S13-B3"
       ],
       "bead": "S13-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "若有人把他当自己人，他会珍惜；没有也好好过，不再忍气留人。",
       "keys": [
        "把他当自己人",
        "不再忍气留人"
       ],
       "from": [
        "S13-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "低处像吐出最后一口气，高处亮起孤悬寒星",
       "keys": [],
       "from": [
        "S13-B4"
       ],
       "bead": "S13-B4"
      },
      {
       "text": "最后那一下，可以是决定，也可以是梦醒",
       "keys": [],
       "from": [
        "S13-B5"
       ],
       "bead": "S13-B5"
      }
     ]
    }
   ]
  }
 ]
}