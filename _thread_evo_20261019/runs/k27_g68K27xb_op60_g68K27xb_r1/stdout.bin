{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然发现自己很想靠近对方\",\n          \"accent\": \"很想靠近\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"怕自己的需要成了负担，他只敢露出一点点喜欢\",\n          \"accent\": \"一点点喜欢\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 3\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"话到嘴边先沉默几秒，怕一说出口关系就变了\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1-3\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"这么一点亲近就让他觉得甜，下次能更坦白些吗？\",\n          \"after\": 0,\n          \"from\": [\"S01-3\"],\n          \"bars\": \"\",\n          \"at\": 12\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"两下和弦像烟花迸开，光点飘落后仍悬在水面上方\",\n          \"from\": [\"S01-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"1-3\"\n        },\n        {\n          \"text\": \"开头像刚踏上船板，微晃一下，还没交给水浪\",\n          \"from\": [\"S01-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"1-3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没有退开，他才慢慢放松下来\",\n          \"accent\": \"慢慢放松\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他也想趁着这份亲近再靠近些\",\n          \"accent\": \"再靠近些\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-2\"],\n          \"at\": 2\n        },\n        {\n          \"text\": \"有一阵子喜欢得几乎藏不住\",\n          \"accent\": \"藏不住\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"怕太急弄坏自在，他还是收住了\",\n          \"accent\": \"还是收住了\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"想到这样的好总会过去，他先有点舍不得\",\n          \"accent\": \"有点舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像贴耳低语，肩膀相挨，连呼吸和体温都融在一起\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6-16\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"夏末水面温热潮湿的风裹在皮肤上，有些黏稠\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6-16\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"脚下不用踩实地面，船底温柔托着人漂，水和时间却一直在走\",\n          \"after\": 0,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4-16\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"那股热切忽然涌上来，又像轻轻呼出一口气\",\n          \"after\": 2,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12-16\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"明明还甜着，心里却像扎了根温柔的刺，先有点鼻酸\",\n          \"after\": 4,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7-11\",\n          \"at\": 36\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"右手两条旋律贴得很近\",\n          \"from\": [\"S02-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"6-16\"\n        },\n        {\n          \"text\": \"左手像心跳，也像一阵阵水浪\",\n          \"from\": [\"S02-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"4-5\"\n        },\n        {\n          \"text\": \"歌声忽然往上涌了一次，随后又缓回柔和\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"12-16\"\n        },\n        {\n          \"text\": \"几次柔软落音，甜蜜里带着一点惆怅\",\n          \"from\": [\"S02-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"7-11\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不想以后，只想待在这份亲近里\",\n          \"accent\": \"待在这份亲近里\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想说喜欢，也想问对方是不是一样\",\n          \"accent\": \"是不是一样\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"还没想好怎么开口，念头就淡了\",\n          \"accent\": \"念头就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"水波托着人轻晃，像说完重要的话还陶醉在里面\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17-23\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"沉默也不尴尬，身体还在这里心却慢慢漂远\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17-23\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"像亲密谈话碰上心结，思绪像被暗流拖住的碎倒影\",\n          \"after\": 1,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17-23\",\n          \"at\": 22\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇曳里忽然冒出几句短促急切的声音\",\n          \"from\": [\"S03-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"20-21\"\n        },\n        {\n          \"text\": \"平稳流动忽然受阻，几处声音悬在半途\",\n          \"from\": [\"S03-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"20-22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又让他满心欢喜\",\n          \"accent\": \"满心欢喜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想起上回想说的话还是没说\",\n          \"accent\": \"还是没说\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-1\"],\n          \"at\": 2\n        },\n        {\n          \"text\": \"这回他几乎想把藏着的话全说出来\",\n          \"accent\": \"全说出来\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他盼着对方也喜欢自己坦白的样子\",\n          \"accent\": \"坦白的样子\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"怕说太多让对方为难，他还是留了些话\",\n          \"accent\": \"留了些话\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像聊起往事，本来一句够了，却忍不住越说越多\",\n          \"after\": 2,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24-34\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"夕阳最后一道金光亮得刺眼，深情却哽在喉咙口\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30-34\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"像不自觉握紧对方的手，越想抱牢当下船越颠簸\",\n          \"after\": 4,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24-34\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"明明还好好的，歌声越美越舍不得这一刻过去\",\n          \"after\": 0,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24-34\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"他盼着说出来能把眼下的好留得久一点，也怕弄丢两人原有的自在\",\n          \"after\": 4,\n          \"from\": [\"S04-3\"],\n          \"bars\": \"\",\n          \"at\": 32\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的歌声回来，花腔比第一次更繁密迫切\",\n          \"from\": [\"S04-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"24-34\"\n        },\n        {\n          \"text\": \"高处长颤音亮起，旋律攀升后又渐渐收弱\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"30-34\"\n        },\n        {\n          \"text\": \"句尾的摇晃渐渐放慢\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"32-34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"对方一直亲近，他这回没藏住喜欢\",\n          \"accent\": \"没藏住喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"被看出有多在乎，他心里空落落的\",\n          \"accent\": \"空落落的\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 1\n        },\n        {\n          \"text\": \"他怕对方会嫌自己太黏\",\n          \"accent\": \"太黏\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-3\"],\n          \"at\": 3\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"连怎么跟对方待着都拿不准，熟悉的亲近也像隔了一层\",\n          \"after\": 1,\n          \"from\": [\"S05-2\", \"S05-3\"],\n          \"bars\": \"\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"像忽然失去脚下支撑，漂进一片起雾的水域\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35-39\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"贴耳交谈忽然停了，心里闪过：这份幸福是真的吗，能维持多久？\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35-39\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"刚才想攥紧不放的冲动，这会儿像自己松开了手\",\n          \"after\": 2,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"35-39\",\n          \"at\": 15\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"丰满的声音忽然抽空，只剩单薄的旋律\",\n          \"from\": [\"S05-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"35-39\"\n        },\n        {\n          \"text\": \"贴耳交谈般的亲近感忽然中断\",\n          \"from\": [\"S05-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"35-39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他有多在乎后仍待他如常\",\n          \"accent\": \"仍待他如常\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他才又能像从前那样自在\",\n          \"accent\": \"自在\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 2\n        },\n        {\n          \"text\": \"安静下来，他还是想靠近又怕要得太多\",\n          \"accent\": \"怕要得太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他想对方会不会也舍不得结束这份亲近\",\n          \"accent\": \"舍不得结束\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 8\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"暖金水面滑进桥影，月光般清凉，像年少时初次心动\",\n          \"after\": 1,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40-50\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"心里刚说算了又放不下，低声说着也不再努力显得完整\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40-50\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"白天相处很好，夜里独处却泛起酸楚，眼前的好恍惚像回忆\",\n          \"after\": 2,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40-50\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"对方不知道他刚才多怕被嫌弃，他有点孤单，像谁也进不了心里每个角落\",\n          \"after\": 2,\n          \"from\": [\"S06-2\", \"S06-B3\"],\n          \"bars\": \"\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"气味、身体感觉、幻想、遗憾和快感混在一起，舒服得让人迷失方向\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40-50\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"左手波浪变薄，A大调新旋律清澈舒展\",\n          \"from\": [\"S06-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"40-50\"\n        },\n        {\n          \"text\": \"两条声线时而靠近时而退开，彼此纠缠\",\n          \"from\": [\"S06-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"40-50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他觉得对方有时也需要他陪着，也许能安心些\",\n          \"accent\": \"也需要他陪着\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到两人能互相依靠，他高兴得收不住\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他盼着对方以后还会想到自己，也能一直陪着\",\n          \"accent\": \"还会想到自己\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-3\"],\n          \"at\": 6\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"心里忽然一紧，他却还想这样待着\",\n          \"after\": 1,\n          \"from\": [\"S07-2\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"那股热度像情欲和执念，也像对活着的眷恋\",\n          \"after\": 1,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51-61\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"回想一段关系，气味、身体感觉、幻想和遗憾混在一起\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51-61\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"舒服得迷了方向，明知被卷进去却暂时不想出来\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51-61\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"这一刻再完美，也听得见时间正从身边经过\",\n          \"after\": 2,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53-61\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏音符变密，内声部像暗涌往上爬\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"51-61\"\n        },\n        {\n          \"text\": \"低音八度和切分像沉重的脉搏\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"51-61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"上回露了心意，对方依然愿意亲近\",\n          \"accent\": \"依然愿意亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想主动些，大大方方地回应\",\n          \"accent\": \"大大方方地回应\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他开始盼着两人能这样好很久\",\n          \"accent\": \"好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"可他心里没底，怕以后未必还会这样\",\n          \"accent\": \"未必还会这样\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"没有防备也不分析，只想痛痛快快地敞开\",\n          \"after\": 1,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62-70\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"像重新迎着阳光和风，身体恢复弹性，还带点调情的玩心\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62-70\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"快乐的余温还在，心头却已经泛起一阵怀念\",\n          \"after\": 3,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69-71\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旋律忽然舒展开，像歌剧里的咏叹调\",\n          \"from\": [\"S08-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"62-70\"\n        },\n        {\n          \"text\": \"歌声向上散开，随后戛然而止\",\n          \"from\": [\"S08-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"69-71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他开始怕对方哪天不再需要他陪\",\n          \"accent\": \"不再需要他陪\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"连和他待在一起也会觉得不自在\",\n          \"accent\": \"不自在\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 2\n        },\n        {\n          \"text\": \"想到这里他一下安静下来，不敢再往下想\",\n          \"accent\": \"不敢再往下想\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"对方一直没退开，他想也许对方喜欢他在身边\",\n          \"accent\": \"喜欢他在身边\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"],\n          \"at\": 6\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像两个人对视到呼吸都停了，渴望还在却引而不发\",\n          \"after\": 2,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72-77\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"像阳光被薄雾柔化，光还在却隔了一层\",\n          \"after\": 2,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72-77\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"他听着刚才的余响，心里问：那是真的吗？接下来怎么办？\",\n          \"after\": 2,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72-77\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"抬头看见夜空，觉得美好比愿望更大，不安暂时退开\",\n          \"after\": 3,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72-77\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"前面的势头忽然收住，熟悉的摇摆退开\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"72-77\"\n        },\n        {\n          \"text\": \"颤音和轻柔和弦悬在半空\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"76-77\"\n        },\n        {\n          \"text\": \"声音一层层下沉变暗，注意力慢慢收拢\",\n          \"from\": [\"S09-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"72-77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他决定暂时不再猜往后会怎样\",\n          \"accent\": \"暂时不再猜\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"先好好享受眼前的亲近\",\n          \"accent\": \"眼前的亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"紧绷松下来，他亮堂得想笑又想哭\",\n          \"accent\": \"想笑又想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 6\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"长长呼出一口气，胸口打开，眼泪也终于不必再忍\",\n          \"after\": 2,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78-83\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"心事还没解决，这一刻却不用强迫自己控制感受\",\n          \"after\": 2,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78-83\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"时间像松开了，旋律里忽然有了一小块空地\",\n          \"after\": 1,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78-83\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"身体轻得像灵魂飘在夏夜微风里\",\n          \"after\": 2,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78-83\",\n          \"at\": 16\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇荡像被一阵清风拨开，旋律短暂松出空地\",\n          \"from\": [\"S10-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"78-83\"\n        },\n        {\n          \"text\": \"高音细亮如银丝细雨，琶音像飞瀑落进水里\",\n          \"from\": [\"S10-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"80-83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他发现自己真的很需要对方\",\n          \"accent\": \"很需要对方\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他觉得对方有时也需要他陪着\",\n          \"accent\": \"也需要他陪着\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-1\"],\n          \"at\": 1\n        },\n        {\n          \"text\": \"就算对方不需要他，他也愿意陪着\",\n          \"accent\": \"愿意陪着\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他决定不再藏着这份喜欢\",\n          \"accent\": \"不再藏着\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"可对方以后还愿不愿意让他陪，他说了不算\",\n          \"accent\": \"他说了不算\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像终于敢说：这是我的感情，我不再为它道歉\",\n          \"after\": 3,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84-92\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"他高兴得顾不上害臊，觉得这么在乎也没什么不好\",\n          \"after\": 3,\n          \"from\": [\"S11-2\"],\n          \"bars\": \"\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"心里悬了很久的期待，仿佛终于得到某种满足\",\n          \"after\": 4,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"像落日烧得血红金亮，浓烈的喜悦压得胸口发痛\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84-92\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"像多年后重回旧屋，熟悉的温柔多了新的重量\",\n          \"after\": 0,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84-92\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"厚重和弦托起歌声，左手水波翻成跨八度惊涛\",\n          \"from\": [\"S11-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"84-92\"\n        },\n        {\n          \"text\": \"铺开的力量在高处短暂悬住\",\n          \"from\": [\"S11-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他顾不上对方是否一样在乎，只想把能给的都给对方\",\n          \"accent\": \"都给对方\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他知道再用心也没法保证以后\",\n          \"accent\": \"没法保证以后\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"可他还是想多陪对方一会儿\",\n          \"accent\": \"多陪对方一会儿\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他终于不再收着，痛痛快快地喜欢对方\",\n          \"accent\": \"痛痛快快地喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像被卷进一个比自己更大的世界，连自己都退到后面\",\n          \"after\": 3,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93-102\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"狂喜像高烧，也像久别重逢时紧紧抱住不放\",\n          \"after\": 3,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93-102\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"喉咙发紧眼眶湿润，分不清想笑还是想哭\",\n          \"after\": 3,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93-102\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"心里还想要更多，怎么也没法完全满足\",\n          \"after\": 2,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"93-102\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"晴朗的歌声放大到开阔，内声部彼此拉扯\",\n          \"from\": [\"S12-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"93-102\"\n        },\n        {\n          \"text\": \"旋律反复向上伸展，句尾仍有牵扯\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"96-100\"\n        },\n        {\n          \"text\": \"声浪在交界处得到一次重大释放\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"102-103\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"他更想听对方说以后也不会变\",\n          \"accent\": \"以后也不会变\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他喜欢和对方待着，时间却总过得太快\",\n          \"accent\": \"时间过得太快\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他更怕对方哪天不再需要自己\",\n          \"accent\": \"不再需要自己\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"连眼下这样的相处也会失去\",\n          \"accent\": \"也会失去\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"他早装不回不在乎，想对对方好是真心\",\n          \"accent\": \"是真心\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"就算听到保证，他心里还是会问：真能一直这样吗？\",\n          \"after\": 1,\n          \"from\": [\"S13-1\"],\n          \"bars\": \"\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"起初怕给对方添负担，如今怕他不再需要自己，少露点心意会不会少疼些？\",\n          \"after\": 2,\n          \"from\": [\"S13-2\"],\n          \"bars\": \"\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"幸福还在，心里却冒出一句可是，正因为相信过才这么疼\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\", \"S13-B3\"],\n          \"bars\": \"103-110\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"脚下明明踩得很稳，胸口却像叹息似的一沉再沉\",\n          \"after\": 1,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103-110\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"真要往回藏，自己反倒更难受\",\n          \"after\": 4,\n          \"from\": [\"S13-3\"],\n          \"bars\": \"\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"声音反复渐强往前推，后半段越绷越紧\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"103-110\"\n        },\n        {\n          \"text\": \"低音稳稳踩住，上方的声音一次次下落\",\n          \"from\": [\"S13-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"103-110\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"最初他连喜欢都不敢多露\",\n          \"accent\": \"不敢多露\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"如今两个人依然亲近，他心里又甜又酸\",\n          \"accent\": \"又甜又酸\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S14-1\"],\n          \"at\": 2\n        },\n        {\n          \"text\": \"他还是舍不得，也不知道以后会怎样\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他不再逼自己讨一句永远不变的保证\",\n          \"accent\": \"不再逼自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"喜欢既然被看见了，他就不再往回藏\",\n          \"accent\": \"不再往回藏\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S14-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从一场美梦里醒来，心里还留着梦里的光\",\n          \"after\": 1,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111-115\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"像铁锚落进水底，小船一下定住，人站起来关上门\",\n          \"after\": 4,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"最后一股浪头后，终结句渐渐松下来\",\n          \"from\": [\"S14-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"110-115\"\n        },\n        {\n          \"text\": \"左手内声部幽幽唱出一句，右手琶音像夜空水花\",\n          \"from\": [\"S14-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"113-115\"\n        },\n        {\n          \"text\": \"末尾几下和弦干脆沉重，低音骤然定住\",\n          \"from\": [\"S14-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"116\"\n        },\n        {\n          \"text\": \"尾声像隔着很远回应开头，最后和弦接住悬着的话\",\n          \"from\": [\"S14-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"113-116\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "b124d1af-ed72-4e78-b734-4608be7a0d92", "session