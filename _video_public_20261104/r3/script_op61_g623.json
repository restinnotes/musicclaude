    "S13"
   ]
  }
 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开了熟悉的生活，起初觉得自己总算不用再一次次委屈自己。",
       "keys": [
        "离开了熟悉的生活",
        "不用再一次次委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里就空落落的，一时说不清舍不得什么。",
       "keys": [
        "没撑多久",
        "空落落的"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起从前熟悉的日子，他还是想往前过，却不知道以后靠什么让自己安下心。",
       "keys": [
        "想往前过",
        "安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头那一下沉重、郑重，像终于要宣告一件重要的事。",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "紧接着的声音却像烟雾往高处散，越升越轻，悬在半空。",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "也像一次召唤，只是停顿里迟迟等不到回声。",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "像强迫自己挺直背脊，提醒自己不能倒下；心里却在说：我其实很想停下来。",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "短句刚像叹息一样冒出来，就被长停顿截断，余音在冷空气里慢慢散尽。",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "心里明明有东西，却分不清是愤怒、遗憾还是怀念，连失落也还没找到语言。",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "像刚从漫长的昏沉中醒来，四周冷而空，胸口发紧，眼前还模糊着。",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "伸出颤抖的手去摸，碰到的却只有虚空，连自己身在何处都还没弄清。",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "旧场景忽然清楚起来，声音、光线和熟悉感都回来了；可过去不会因此变成现在。",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "身体仿佛先于意识记起舞步，隐约知道该怎么迈步，却还没有真正站稳。",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他舍不得从前那些自在的时候，一想到以后不能再那样过，心里就有些慌。",
       "keys": [
        "舍不得",
        "有些慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可他赶紧想起受过的那些气，怕一心软，就忘了当初为什么要走。",
       "keys": [
        "受过的那些气",
        "为什么要走"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他还是不甘心：难道为了不再受那些气，就得把以前的好日子也一起丢掉吗？",
       "keys": [
        "不甘心",
        "好日子"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "舞步终于清楚，却不像英雄凯旋，更像一首从远处传来的旧歌，只能模糊哼出几句。",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "舞曲像面向众人的庄严，歌声却像记忆里只哼给自己听的声音。",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "不像士兵整齐前进，更像腿脚虚浮的人，还在记忆里挪动舞步。",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "表面的节奏挺拔甚至傲慢，旋律却脆弱凄婉，底下还有细碎的不安在蠕动。",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "音乐猛地往上推，却又退了下来，像快要鼓起劲，却没能站住。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "力量重新聚拢，越往后越焦灼，最后仍没有舒舒服服地落地。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "连绵的三连音把呼吸催得越来越急。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "像把衣服整理好、抬起头，不让别人看见自己动摇。",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "他一遍遍对自己说“我没事”：起初还信几分，后来越说越像在努力相信。",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "那股激昂也像一句：我不甘心就这样消亡；这不是轻松振作，而是还在负隅顽抗。",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他心里还憋着一股气，可想起曾有人把他当作自己人，竟又高兴了一小会儿。",
       "keys": [
        "憋着一股气",
        "自己人"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可那点高兴还没退，他心里就酸了：从前的日子过不成了，离开以后也未必更好过。",
       "keys": [
        "心里就酸了",
        "未必更好过"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那一下重击像重锤砸下，带着愤怒和抗拒。",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "忽强忽弱的起伏让人心里一悬，想往前走，却始终定不下方向。",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "前半段焦躁、急切，像一心想摆脱眼前的处境。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "后半段忽然柔和，像故乡夏日的麦浪与微风；越觉得亲近，越刺痛于它已经回不来。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像几个人在耳边低声絮语，彼此缠绕；脚下又像流沙，怎么也抓不住重心。",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "也像暂时侧身离场，不再直面伤口；那一刻的轻松可以是真的，却没有替心事找到答案。",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "那股昂扬像慢慢退潮，心里冒出一句：我刚才是真的相信，还是只在努力相信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起那些亲近的时候，他有一阵真盼着一切还能照从前那样继续。",
       "keys": [
        "真盼着",
        "照从前那样继续"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可越这么盼，他越怀疑当初是不是走错了；偏偏又想不出，要是没走如今会怎样。",
       "keys": [
        "怀疑当初是不是走错了",
        "想不出"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日亲近忽然鲜活，带来感激、柔情，甚至一小会儿的幸福。",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "熟悉的姿态还在向前，里面却多了回声，也变得更容易受伤。",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "温暖忽然转成风暴般的紧绷，像记忆太好了，才更刺痛地提醒人它回不来了。",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "往下坠的声音像在撕扯中步步后退，抵抗显得疲惫又仓促。",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "细碎音符像急促的脚步和乱拍的心跳，身体被追赶着往前跑，连停下来都难。",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "脑子里反复转着：如果当时……是不是还可以……究竟为什么会变成这样？",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他仍不服气，觉得当初那些气不该忍，可连过去开心的事都不敢多想，也太为难自己了。",
       "keys": [
        "仍不服气",
        "不敢多想"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "跟自己争得没了力气，那股不服气也渐渐淡了；想到如今已不在那些人身边，只觉得难受。",
       "keys": [
        "没了力气",
        "只觉得难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "语气像换了个人，柔和而亲近；两只手仿佛夜色里两个影子，彼此低声说话。",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "这份柔和里仍有向前的劲，像在说：这件事不能就这样算了。",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "旧日记忆重新有了温度，可能是某个人，也可能是故乡或过去的生活。",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "可越觉得亲近，越知道它已经过去，眷恋里仍带着失落。",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "原本不断向前的声音渐渐放缓、变稀，最后只剩疏落的和弦。",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "旋律几乎单独露出来，像脚下的地板忽然不见，只剩一个声音自己说话。",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "躁动和不安又慢慢加深，声音稀疏下来，心里却未必平静。",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      },
      {
       "text": "最后几次深呼吸般的松动，像不是想通了，而是抵抗得累了。",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "心里那阵难受慢慢缓下来，他又想起从前和人在一起、不必时时防备的时候。",
       "keys": [
        "难受慢慢缓下来",
        "不必时时防备"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "这回他没有急着拿受过的气压住想念，愿意先让那些好时光浮上来。",
       "keys": [
        "好时光"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "离开以后，遇上难熬的事，他常常只能自己挺过去，这才知道有人在身边能让自己轻松多少。",
       "keys": [
        "只能自己挺过去",
        "轻松多少"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他很想再过那种不用多说就知道彼此亲近的日子，又怕以后再也没有。",
       "keys": [
        "很想再过",
        "怕以后再也没有"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "不过，那样的日子自己毕竟真真切切过过，光是这么想着，心里也暖和了一点。",
       "keys": [
        "真真切切过过",
        "暖和了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音像忽然滑进另一片静谧，整个世界被透明玻璃罩隔开，连呼吸都不愿惊动它。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "又像母亲在耳边轻轻哼摇篮曲，温柔得让人暂时松开戒备。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "可这份安宁不是现实已经变好，也不是一个能永远停留的地方。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "近似圣咏的庄严里，又藏着只属于自己的秘密念头。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "终于不用向别人解释为什么难过，也不用维持“我应该坚强”的样子。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "像向一个遥远而不确定的对象祈求，愿望真切，却没有人保证会回应。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "远方忽然被照亮，像在梦里看见已经回不去的家园。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "起初含蓄试探，后来像终于鼓起勇气，把心里的话慢慢说出来。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "情感再次变得充实、迫切，临近尾声却像停在一句没说完的话上。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "明知有些事已经挽不回，便不急着抓住，只放轻声音，好好看着它。",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "刚有点安心，他却猛然想到：以后再遇上难事，要还是只能一个人顶着，他真的撑得住吗？",
       "keys": [
        "刚有点安心",
        "撑得住吗"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "当初离开时他只想着别再受那些气，没料到会这么孤单；早知道这样，自己还会走吗？",
       "keys": [
        "没料到会这么孤单",
        "还会走吗"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想找回从前那份亲近，又不甘心回去再受那些气，可连当初走时的决心也找不着了。",
       "keys": [
        "想找回从前那份亲近",
        "找不着了"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "长颤音像寒风猛地吹开紧闭的窗，把人从甜梦里拽回严寒；后颈一凉，脉搏猛跳。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "舞步突然闯进祈祷般的静谧，像换了一个场景，原先的思绪被截断。",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "新场景可以很鲜明，却不等于心情好转，内心仍未安定下来。",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "颤音一层层累积，思绪不停翻转，想停也停不下来。",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      },
      {
       "text": "心里有东西发颤，想冲出去，却始终找不到真正的出口。",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      },
      {
       "text": "熟悉的动作、舞蹈和日常细节忽然闯进来；越亲切，越提醒人已经失去什么。",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      },
      {
       "text": "先前带着宣告意味的舞步又出现了，却不再像最初那样完整地立起秩序。",
       "keys": [],
       "from": [
        "S07-B5"
       ],
       "bead": "S07-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他暂时把回不回去的事放到一边，想起从前那些亲近的时光，让自己暖和了一会儿。",
       "keys": [
        "放到一边",
        "暖和了一会儿"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可回忆没法陪着他熬过下一次难关，那点暖意一淡，心又悬了起来。",
       "keys": [
        "回忆没法陪着他",
        "心又悬了起来"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "缓慢而宽广的歌唱短暂回来，心里熟悉的柔软处又打开了。",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "像已经准备离开，却在最后一刻回头，再看一眼刚待过的地方；那一眼温柔又不舍。",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      },
      {
       "text": "激烈思绪之间像终于吸进一口气，胸口短暂松开；但这只是喘息，不是重新安顿。",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他忽然分不清，自己想回去究竟是舍不得以前的生活，还是难受的时候想有人陪。",
       "keys": [
        "分不清",
        "有人陪"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "这个念头让他一阵心慌，连往下想都不敢了。",
       "keys": [
        "一阵心慌",
        "不敢了"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "巨大的颤音光晕里，开头那份阴冷忽然闪现，却不再像郑重的召唤。",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "声音短暂落稳，又向高处漂去，刚有的一点稳定感随即散掉。",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "像从另一面重新看见同一扇门，真正向前的步伐还没有聚起来。",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "像重新遇见那个不知道怎么办的自己；只是现在已经知道他经历过什么，问题仍没有简单答案。",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他慢慢觉得，自己最舍不得的，还是从前有人把他当作自己人的日子。",
       "keys": [
        "最舍不得",
        "自己人"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可就算真的回去，还能像从前一样吗？那些让他难受的事，也不能当作没发生过。",
       "keys": [
        "还能像从前一样吗",
        "不能当作没发生过"
       ],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他翻来覆去想得很累，还是没有答案，连眼下的日子也过得不踏实。",
       "keys": [
        "想得很累",
        "不踏实"
       ],
       "from": [
        "S10-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的歌声和舞步只剩几块碎片，回来了一点，却没有完整铺开。",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "也像摇篮曲破碎地重现，声音变得更加凄厉、哀婉。",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "忽然像失去重量，整个人悬在半空，辨不清方向，也没有着落。",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "心里又递来那个问题：那么，我究竟要怎样继续生活？",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      },
      {
       "text": "像一个疲倦的人回想很重要的往事，却已经没有力气重新讲一遍。",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他明知道回去未必找得回那份亲近，却还是忍不住想：万一能呢？",
       "keys": [
        "未必找得回",
        "万一能呢"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可他不愿只凭这点指望，就回去过从前那种忍让的日子。",
       "keys": [
        "不愿只凭这点指望",
        "忍让的日子"
       ],
       "from": [
        "S11-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他决定先把眼下的日子过稳些；害怕仍在，这回却不想因为害怕就收回打算。",
       "keys": [
        "把眼下的日子过稳些",
        "不想因为害怕"
       ],
       "from": [
        "S11-3",
        "S11-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "低音像滚滚波涛，右手和弦一次次砸下；每次爆发之后，压力仍没有解除。",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      },
      {
       "text": "步子起初还在试探，随后一点点聚拢；害怕仍在，脚却已经往前走，停滞终于松开一点。",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他承认当初那些气确实不该忍，也承认和那些人在一起时确实开心过。",
       "keys": [
        "确实不该忍",
        "确实开心过"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "想念和怕孤单都还在；他不再怪自己当初离开，也不愿只为有人陪着就回头。",
       "keys": [
        "不再怪自己当初离开",
        "不愿只为有人陪着就回头"
       ],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他愿意带着想念继续过日子，不必假装自己从未受过伤。",
       "keys": [
        "带着想念继续过日子",
        "从未受过伤"
       ],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的主题以雷鸣般的声势占满前景，像沉重的步子终于踏实落地。",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      },
      {
       "text": "这份昂扬也像面向众人的公开姿态，带着一点集体的气势。",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      },
      {
       "text": "脚步正往前，地面却像短暂斜了一下；随后仍然继续向前。",
       "keys": [],
       "from": [
        "S12-B3"
       ],
       "bead": "S12-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起从前那些自然亲近的日子，他心里又热了起来，也盼着以后还能有那样的相处。",
       "keys": [
        "自然亲近的日子",
        "盼着以后"
       ],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "这么想着，他倒真有了劲头，想把往后的日子好好过起来，不再整天跟从前的事较劲。",
       "keys": [
        "真有了劲头",
        "好好过起来"
       ],
       "from": [
        "S13-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "劲头稍缓，他想到往后还会孤单，也不知何时再有人亲近，心里渐渐静了下来。",
       "keys": [
        "还会孤单",
        "渐渐静了下来"
       ],
       "from": [
        "S13-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "将来要是再有人愿意把他当自己人，他会好好珍惜；即使一直没有，他也愿意自己好好过下去，不再为了留住谁把那些委屈咽下去。",
       "keys": [
        "好好珍惜",
        "好好过下去"
       ],
       "from": [
        "S13-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "近乎祈祷的柔软歌唱忽然站到明亮开阔处，庄严得像一座宏大的殿堂。",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "密集的声音像激流向上喷涌，心脏仿佛以最高负荷跳动；柔软并没有被力量压下去。",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "这份公开的气势，也让人想到故土、共同记忆和希望。",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "快速八度像一股明亮的气流迎面推来，身体被带着向前跑，兴奋得来不及喘息。",
       "keys": [],
       "from": [
        "S13-B2"
       ],
       "bead": "S13-B2"
      },
      {
       "text": "冲势收敛后，颤动的装饰音轻轻发问：刚建立的成功，真的牢固了吗？",
       "keys": [],
       "from": [
        "S13-B3"
       ],
       "bead": "S13-B3"
      },
      {
       "text": "也可以听成事情已经说完，终于能停下来喘一口气。",
       "keys": [],
       "from": [
        "S13-B3"
       ],
       "bead": "S13-B3"
      },
      {
       "text": "狂潮退去，低处两记耳语般的和弦吐出最后一口气，高处却亮起一颗孤悬的寒星。",
       "keys": [],
       "from": [
        "S13-B4"
       ],
       "bead": "S13-B4"
      },
      {
       "text": "最后的高音和弦，既可以像一个终于落定的决定，也可以像忽然从梦中醒来。",
       "keys": [],
       "from": [
        "S13-B5"
       ],
       "bead": "S13-B5"
      }
     ]
    }
   ]
  }
 ]
}