      "bead_edges": [
        {
          "a": "S10-B1",
          "b": "S10-B4",
          "type": "可同时成立",
          "note": "胸腔打开、终于能够呼吸，是听者的身体反应；银丝细雨与飞瀑琶音，是耳朵可以直接追随的声音形态。二者属于同一段释放，却不互相替代。"
        },
        {
          "a": "S10-B1",
          "b": "S10-B2",
          "type": "重叠但新增",
          "note": "两者都有松绑感，但B1发生在肩膀、胸口和呼吸中，B3则让听者感觉原先不断推动船前行的时间和节奏暂时失去牵引力。"
        },
        {
          "a": "S10-B4",
          "b": "S10-B3",
          "type": "重叠但新增",
          "note": "B2是音符几乎没有重量，B4是听者想象自己的整个身体失去重量。一个是声音质地，一个是自身的漂浮感，这正是原阶梯低估的新增价值。"
        },
        {
          "a": "S10-B1",
          "b": "S10-B3",
          "type": "可同时成立",
          "note": "呼吸畅通与身体失重可以同时被感到，但不是同一件事。前者仍有明确的肩膀、胸口和眼泪，后者则像暂时越过了肉身的限制。"
        },
        {
          "a": "S10-B2",
          "b": "S10-B3",
          "type": "可同时成立",
          "note": "暂时不必随船向前的时间感，可以和整个人悬浮的感觉并存。没有依据把它们写成先发生B3、再进入B4的段内因果过程。"
        }
      ],
