<script>
  document.addEventListener('DOMContentLoaded', function () {
    const checkbox = document.getElementById('terms-checkbox');
    const buttons = document.querySelectorAll('button[data-add-to-cart]');
    const links = document.querySelectorAll('.member-login-link');
  
    function toggleControls() {
      const isChecked = checkbox.checked;
      buttons.forEach(btn => btn.disabled = !isChecked);
  
      links.forEach(link => {
        if (isChecked) {
          link.classList.remove('disabled-link');
          link.removeEventListener('click', preventLink);
        } else {
          link.classList.add('disabled-link');
          link.addEventListener('click', preventLink);
        }
      });
    }
  
    function preventLink(e) {
      e.preventDefault();
    }
  
    checkbox.addEventListener('change', toggleControls);
    toggleControls(); // initialize on page load
  });
</script>



