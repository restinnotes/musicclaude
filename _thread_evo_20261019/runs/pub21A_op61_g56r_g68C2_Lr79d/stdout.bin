\n      \"lines\": [\n        {\n          \"text\": \"离开后难事只能自己扛\",\n          \"point\": \"日子有多轻松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"才想起\"\n        },\n        {\n          \"text\": \"他想再遇到这样的默契\",\n          \"point\": \"心里暖了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可想到自己曾拥有过\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"轻得像游丝、却带着刺骨寒意的长颤音\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这样的亲切感未必安慰人；恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"事情表面上仿佛已经过去，身体和情绪却还没有完全相信一切已经结束\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他没料到离开后这么孤单\",\n          \"point\": \"撑得住吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"难事还得自己扛\"\n        },\n        {\n          \"text\": \"他想找回从前那份亲近\",\n          \"point\": \"早知道这样还会走吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可想到还得受气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一眼里有温柔，也有不舍\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只是瞬间的喘息，并不等于整个人重新安顿下来\",\n          \"carrier\": \"连接转折\",\n      