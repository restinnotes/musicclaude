{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"再一次次委屈自己\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"一次次\"\n        },\n        {\n          \"quote\": \"我不能倒下，可我其实很想停下来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"却很想停下\"\n        },\n        {\n          \"quote\": \"停顿里仿佛还等着回声\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开了熟悉的生活\",\n          \"point\": \"总算不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初觉得总算\"\n        },\n        {\n          \"text\": \"可这份笃定没撑多久\",\n          \"point\": \"不知道靠什么安下心\",\n          \"where\": \"后\",\n          \"waste\": \"很快\",\n          \"keep\": \"他一时说不清舍不得什么\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"腿脚虚浮的人，在记忆中挪动舞步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"腿脚虚浮\"\n        },\n        {\n          \"quote\": \"第一次还有几分相信，第二次开始努力让自己相信\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是轻松恢复自信，而是负隅顽抗\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他舍不得从前自在的日子\",\n          \"point\": \"心里就有些慌\",\n          \"where\": \"后\",\n          \"waste\": \"心里\",\n          \"keep\": \"想到以后不能再那样过\"\n        },\n        {\n          \"text\": \"他赶紧提醒自己受过的气\",\n          \"point\": \"怕