     ]
    },
    {
     "id": "S14-B2-p1",
     "bead": "S14-B2",
     "text": "就在声音渐渐变轻的时候，第113小节左手内声部幽幽地唱出一句，像男中音独自沉思。",
     "windows": [
      [
       482.5,
       488.54
      ]
     ],
     "local": true,
     "bars": [
      113,
      113
     ]
    },
    {
     "id": "S14-B2-p2",
     "bead": "S14-B2",
     "text": "先前熟悉的歌唱与摇荡，仿佛又回来了一次。",
     "windows": [
