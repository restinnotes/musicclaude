: [\"S11-2\"],\n          \"bars\": \"\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"两人未必总能这样亲近\",\n          \"after\": 3,\n          \"from\": [\"S11-3\"],\n          \"bars\": \"\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"前面悬着的期待，终于得到一点满足\",\n          \"after\": 0,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"夕阳烧得血红金亮，刺得人想流泪\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"旧房子没变，经历多了，温柔更有重量\",\n          \"after\": 0,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 12\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"厚重和弦托起歌声，水波翻成惊涛\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"铺开的力量在高处短暂悬停\",\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他顾不上对方是否也在乎\",\n          \"accent\": \"顾不上\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"只想把能给的都给对方\",\n          \"accent\": \"都给对方\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他明知用心也保不住以后\",\n          \"accent\": \"保不住以后\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"还是想多陪对方一会儿\",\n          \"accent\": \"多陪一会儿\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-2\"],\n          \"at\": 15\n        },\n        {\n          \"text\": \"他终于不再收着喜欢\",\n          \"accent\": \"不再收着\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-3\"],\n          \"at\": 21\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他只盼对方能安心\",\n          \"after\": 1,\n          \"from\": [\"S12-1\"],\n          \"bars\": \"\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"像被卷进比自己更大的世界\",\n          \"after\": 4,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"天地共振时，连自己都退到后面\",\n          \"after\": 4,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"狂喜像发高烧，喉咙发紧眼眶湿润\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"久别重逢般抱紧对方，快乐得分不清笑哭\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"明明已经很幸福，心里还想要更多\",\n          \"after\": 4,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"93–102\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"晴朗的歌被推到开阔处，声浪一层高过一层\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"旋律反复向上伸展，乐句末端仍有牵扯\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"96–100\"\n        },\n        {\n          \"text\": \"悬着的气息到段尾才得到释放\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"102–103\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"他更想听对方说以后也不变\",\n          \"accent\": \"以后也不变\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"即使听到保证 时间仍过得飞快\",\n          \"accent\": \"时间仍过得飞快\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"他如今更怕对方不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"少露些心意 会不会少疼些？\",\n          \"accent\": \"少疼些\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-2\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"他真心想对对方好 不愿再藏\",\n          \"accent\": \"不愿再藏\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 23\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"刚到浪峰，身后又有更大的浪推来\",\n          \"after\": 1,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"幸福里进了悲伤，握住珍贵才知留不住\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"刚说了是，心里马上追问可是呢\",\n          \"after\": 1,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"这句可是没有推翻先前的幸福\",\n          \"after\": 1,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"脚步稳稳踩地，上方落下，胸口沉了又沉\",\n          \"after\": 2,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"真要往回藏，他反倒会更难受\",\n          \"after\": 4,\n          \"from\": [\"S13-3\"],\n          \"bars\": \"\",\n          \"at\": 25\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"反复渐强，106后越绷越紧\",\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"明亮里渐渐掺进尖锐暗沉的成分\",\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"107–110\"\n        },\n        {\n          \"text\": \"低处节奏持续稳住，高处旋律反复下行\",\