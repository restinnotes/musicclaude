{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"accent\": \"很想靠近\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"怕给对方添负担只敢露一点喜欢\",\n          \"accent\": \"添负担\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"这一点亲近已经很甜\",\n          \"accent\": \"很甜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S01-3\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"下次能不能更坦白？\",\n          \"accent\": \"更坦白\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-3\"],\n          \"at\": 10\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"话到嘴边沉默几秒，怕开口改变关系\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"木板微晃，水波荡开，身体一瞬失重\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 8\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"和弦像烟花迸起又悬着，摇荡尚未成形\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没有退开他才慢慢放松\",\n          \"accent\": \"慢慢放松\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想靠得更近又怕打破自在\",\n          \"accent\": \"更近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"两个人待得越好他越舍不得\",\n          \"accent\": \"越舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"肩膀挨着肩膀，连呼吸都贴在一起\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"安静坐着也不用拼命找话题\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"夏末潮湿温热的风裹在皮肤上\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"脚下像不用踩实，船底轻轻托着人\",\n          \"after\": 2,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–5\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"水一直在流，时间也一直往前\",\n          \"after\": 2,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–5\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"甜蜜像根温柔的刺，鼻酸又盼慢些\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7–11\",\n          \"at\": 40\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"两条旋律贴得很近，像挨着耳语\",\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\"\n        },\n        {\n          \"text\": \"歌声未起，摇荡已一下一下开始\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–5\"\n        },\n        {\n          \"text\": \"歌声忽然上涌，随后又轻轻收回\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不去想两个人的以后\",\n          \"accent\": \"不去想\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"只想舒服地待在这份亲近里\",\n          \"accent\": \"舒服地\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他想说自己有多喜欢\",\n          \"accent\": \"有多喜欢\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S03-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"也想问对方是不是一样\",\n          \"accent\": \"是不是一样\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"没想好怎么开口念头就淡了\",\n          \"accent\": \"念头就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 17\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"水波托着身体摇晃漂浮，暂时不去哪里\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"亲密交谈后安静下来，沉默也很舒服\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"身体还在这里，心却慢慢漂远\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"急着表达的念头露一下头又沉下去\",\n          \"after\": 4,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20–21\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"风吹碎的倒影，闪着却拼不起来\",\n          \"after\": 4,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"亲密谈话碰到解不开的结\",\n          \"after\": 4,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\",\n          \"at\": 26\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇曳中忽然冒出几句短促声音\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20–21\"\n        },\n        {\n          \"text\": \"流动里几处声音像被暗流拖住\",\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20–22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又让他满心欢喜\",\n          \"accent\": \"满心欢喜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"上回想说的话还没出口\",\n          \"accent\": \"还没出口\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"这回几乎想把藏着的话说完\",\n          \"accent\": \"说完\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"盼对方喜欢他不再小心收着\",\n          \"accent\": \"不再小心收着\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-2\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"怕对方为难也怕失去自在\",\n          \"accent\": \"失去自在\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 28\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像讲起往事，越说越快又补上细节\",\n          \"after\": 2,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"想说到喉咙发颤，话像堵住了\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"手从轻握变成不自觉地握紧\",\n          \"after\": 4,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"想抱紧对方，水面却越晃越难稳\",\n          \"after\": 4,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"水一直向前，甜蜜里已有鼻酸\",\n          \"after\": 0,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"盼眼下的好久一点，最后仍留了些话\",\n          \"after\": 4,\n          \"from\": [\"S04-3\"],\n          \"bars\": \"\",\n          \"at\": 39\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉歌声重现，细密花腔闪动\",\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"高处长颤音亮起，旋律攀升后渐弱\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他没藏住喜欢对方已经看出来\",\n          \"accent\": \"已经看出来\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他空落落的连相处都拿不准\",\n          \"accent\": \"空落落\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"怕被嫌太黏亲近忽然隔了一层\",\n          \"accent\": \"隔了一层\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-3\"],\n          \"at\": 8\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"脚下忽然没了支撑，漂进雾里\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"话停了，他跌回心里：能维持多久？\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"像松开紧攥的手，长长吸口气\",\n          \"after\": 2,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"35–39\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"藏着时还能装作没那么在乎\",\n          \"after\": 1,\n          \"from\": [\"S05-2\"],\n          \"bars\": \"\",\n          \"at\": 12\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"饱满伴奏忽然撤去，只剩单薄旋律\",\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他的在乎相处却没变\",\n          \"accent\": \"相处却没变\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他终于又能自在地待在一起\",\n          \"accent\": \"自在\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"安静时他仍想靠近又怕要太多\",\n          \"accent\": \"怕要太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"],\n          \"at\": 11\n        },\n        {\n          \"text\": \"对方不知道他刚才多怕被嫌弃\",\n          \"accent\": \"多怕被嫌弃\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"对方会不会也舍不得结束？\",\n          \"accent\": \"舍不得结束\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 23\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"暖金水面滑进古桥阴影，空气凉了\",\n          \"after\": 1,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"清凉月光，想起童年或初次心动\",\n          \"after\": 1,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"算了又放不下，说着说着不再装完整\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"白天相处很好，夜里泛酸，好时光像回忆\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"再亲近也走不进心里每个角落\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"气味身体幻想遗憾快感交织，舒服得迷路\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 25\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇摆变轻，旋律清澈舒展\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"两条旋律时近时远，彼此纠缠\",\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他觉得对方也许也需要他陪\",\n          \"accent\": \"也需要他陪\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"两个人也许能互相依靠\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他高兴得收不住心里忽然一紧\",\n          \"accent\": \"心里忽然一紧\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"他盼对方以后还会想到自己\",\n          \"accent\": \"想到自己\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-3\"],\n          \"at\": 19\n        },\n        {\n          \"text\": \"自己也能一直陪在身边\",\n          \"accent\": \"一直陪\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-3\"],\n          \"at\": 25\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"跟他待在一起，也许也能安心些\",\n          \"after\": 0,\n          \"from\": [\"S07-1\"],\n          \"bars\": \"\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"气味身体感觉幻想遗憾快感混在一起\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"有一点情色的暖意，舒服得失去方向\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"明知被卷进去，暂时却不想出来\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"什么都还很好，却听见时间正在经过\",\n          \"after\": 4,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"再完美也没法让这一刻停住\",\n          \"after\": 4,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"清澈歌声重现，伴奏渐密，低音催促\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"他想大大方方回应这份亲近\",\n          \"accent\": \"大大方方\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"连往后的日子都开始期待\",\n          \"accent\": \"开始期待\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"可他心里没底以后未必这样\",\n          \"accent\": \"没底\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-3\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像重新碰到阳光和风\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"身体恢复弹性，带着一点玩心\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"轻快得像调情与回应\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"快乐余温还在，心头已泛起怀念\",\n          \"after\": 2,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\",\n          \"at\": 25\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌句越唱越开，摇荡轻轻催促\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌声向上散开，随后突然停住\",\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他开始怕对方不再需要他陪\",\n          \"accent\": \"不再需要他陪\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"甚至怕对方和他待着也不自在\",\n          \"accent\": \"不自在\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"他一下安静不敢再往远处想\",\n          \"accent\": \"一下安静\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S09-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"眼下两人还亲近这都是真的\",\n          \"accent\": \"都是真的\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S09-3\"],\n          \"at\": 16\n        },\n        {\n          \"text\": \"也许对方也喜欢他在身边\",\n          \"accent\": \"也许\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"],\n          \"at\": 21\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像对视到呼吸都停住，渴望仍悬着\",\n          \"after\": 3,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"像陷进低气压，阳光隔着薄雾\",\n          \"after\": 2,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"他听着自己的余响，刚才那是真的吗？\",\n          \"after\": 2,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"抬头看见夜空，美好比愿望更大\",\n          \"after\": 4,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 23\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉摇摆收住，轻柔颤音悬在半空\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他先不猜以后只享受眼前亲近\",\n          \"accent\": \"享受眼前亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"紧绷慢慢松开胸口也打开了\",\n          \"accent\": \"胸口也打开了\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"心里亮得想笑又有点想哭\",\n          \"accent\": \"想笑又有点想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 15\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"心事还没解决，眼泪却不必再忍\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"时间像被清风拨开，暂时有片空地\",\n          \"after\": 0,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"身体轻得像灵魂飘在夏夜微风里\",\n          \"after\": 2,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\",\n          \"at\": 17\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高音细碎如银丝飘落，琶音清亮倾泻\",\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"80–83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他需要对方对方有时也需要他\",\n          \"accent\": \"也需要他\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"就算对方不需要他他仍愿意陪\",\n          \"accent\": \"仍愿意陪\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他不再想把喜欢藏起来\",\n          \"accent\": \"不再\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\", \"S11-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"可对方以后还愿让他陪吗？\",\n          \"accent\": \"还愿让他陪吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-3\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"亲近未必长久欢喜压得心口疼\",\n          \"accent\": \"心口疼\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"悬在半空，像在等下一股更大的浪\",\n          \"after\": 3,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"约92\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"夕阳烧得血红金亮，刺眼得想流泪\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"喜悦浓到胸口发疼，身体几乎承受不住\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"像多年后重新走进一间旧房子\",\n          \"after\": 4,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"家具没变，可知道的事情已经太多\",\n          \"after\": 4,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"原来的温柔有了新重量，越珍贵越疼\",\n          \"after\": 4,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"厚重和弦托起歌声，低音翻成巨浪\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"铺开的力量短暂悬起，像等下一浪\",\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"约92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他顾不上对方是否也在乎\",\n          \"accent\": \"顾不上\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"只想把能给的都给对方\",\n          \"accent\": \"都给对方\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": 