      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S07",
    "bars": "51–61",
    "relation": "正在面对",
    "items": [
     {
      "id": "S07-1",
      "text": "剩下的共同时间里，空闲尽量留给对方，原本平常的相处也变得格外投入，不愿错过能一起的时刻。",
      "key": "剩下的共同时间里",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-2",
       "S06-3"
      ]
     },
     {
      "id": "S07-2",
      "text": "一天里的亲近会在之后反复回味，明知道越沉进去越舍不得，还是不急着抽离。",
      "key": "一天里的亲近会在",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1"
      ]
     },
     {
      "id": "S07-3",
      "text": "日子依旧开心，只是每次一天结束，都知道这种每天都能共享生活的状态不会一直延长。",
      "key": "日子依旧开心，只",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1",
       "S07-1"
      ]
     }
    ],
    "because": [
     {
