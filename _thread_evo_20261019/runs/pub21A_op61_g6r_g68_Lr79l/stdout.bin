{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"我不能倒下，可我其实很想停下来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不能倒下，却很想停下\"\n        },\n        {\n          \"quote\": \"紧接着的自由上行琶音却没把这份重量接住\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"琶音没接住重量\"\n        },\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"还没找到语言\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开熟悉生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"总算\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"不知如何安顿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想往前走又\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"那些自己珍惜的东西仿佛还在，却已经无法像从前那样拥有它们。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还在，却不能照旧拥有\"\n        },\n        {\n          \"quote\": \"底下的伴奏还有细碎、不安的半音在蠕动。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"反复说，本身就暴露在意\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到以后再没有\",\n          \"point\": \"以后再没有那样的日子\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"再没有\"\n        },\n        {\n          \"text\": \"他提醒自己受过的气\",\n          \"point\": \"不甘心连好日子也丢掉\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"提醒自己受过的气，却\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"温柔得让人心颤，也刺痛得让人绝望：越怀念，越能感觉它与眼前处境的距离。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"温柔却刺痛得绝望\"\n        },\n        {\n          \"quote\": \"那一刻的轻松可以是真的，并非假装；只是它没有替心里的事找到答案。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"我刚才是真的相信那些话，还是只是在努力让自己相信？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"刚才那些话，我真信吗？\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起有人把他当自己人\",\n          \"point\": \"把他当自己人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"一小会儿\"\n        },\n        {\n          \"text\": \"可那样的日子回不去\",\n          \"point\": \"离开后也未必更好过\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"未必\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"不是记忆变坏了，而是它太好了——过去无法原样回来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是变坏，是太好而回不来\"\n        },\n        {\n          \"quote\": \"外在的步伐还在向前，里面却有了更多回声。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"脚步向前，心里回声更多\"\n        },\n        {\n          \"quote\": \"表面上动作越来越多，实际上并没有真正抵达哪里；不停地往前赶，只是为了避免停下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起从前的亲近\",\n          \"point\": \"还能那样相处\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"真盼着\"\n        },\n        {\n          \"text\": \"可越想念\",\n          \"point\": \"怀疑当初那一步\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"越想念，他越想起委屈\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"可正因已经过去，眷恋里也带着失落。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"正因已过去，眷恋才带失落\"\n        },\n        {\n          \"quote\": \"像脚下原有的地板忽然不见了，只剩一个声音自己说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是想通，是抵抗累了\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他不服气\",\n          \"point\": \"受过的气不该忍，开心的事也不该抹掉\",\n          \"where\": \"中\",\n          \"waste\": \"他不服气\",\n          \"keep\": \"也不该抹掉\"\n        },\n        {\n          \"text\": \"争得没了力气\",\n          \"point\": \"已不在那些人身边\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"才发现\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"连呼吸都不愿惊动它。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"怕惊动它\"\n        },\n        {\n          \"quote\": \"那些压住的愿望、委屈和思念，终于有机会浮现。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"愿望真切，却没有许诺