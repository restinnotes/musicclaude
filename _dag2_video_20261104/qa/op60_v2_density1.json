      ],
      "bead_edges": [
        {
          "a": "S01-B1",
          "b": "S01-B2",
          "type": "可同时成立",
          "note": "B1呈现声音的冲击、展开、散落和悬置；B2把开口前的停顿理解为人际关系中的谨慎。音响运动和心理处境可以同时被感到，但不能断言开头的和弦是某个人因为不敢告白而产生的声音。"
        },
        {
          "a": "S01-B1",
          "b": "S01-B3",
          "type": "重叠但新增",
          "note": "两者指向同一个开场音型。B1给出烟花升落和悬空的空间画面，B3则把冲击与晃动转换为脚底踩上船板、重心短暂失去依托的身体感觉。烟花和登船可以作为不同感官联想并存；真正受到演奏条件制约的，是开头是否已经透出水面轻摇，而不是B1的全部声音动作。"
        },
        {
          "a": "S01-B2",
          "b": "S01-B3",
          "type": "可同时成立",
          "note": "谨慎地准备开口和身体短暂失重是不同层次的体验。可以同时感到，但没有证据将它们写成同一个人因登船而卸下戒备、继而终于敢说话的连续经历。"
        }
      ],
