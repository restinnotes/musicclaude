                <!-- Hanken Grotesk is used by exactly one rule (.stats-grid .value). It used
             to be requested from inside the summary element - i.e. from the body,
             after the head had already gone out - as the full 100..900 variable face
             in both styles, so it arrived late and swapped in over text that had
             already painted. Requested here in the head, and only in the weight that
             rule actually asks for. -->
        
        
        <style type="text/css">@font-face {font-family:'Hanken Grotesk';font-style:normal;font-weight:600;src:url(/cf-fonts/v/hanken-grotesk/5.2.8/cyrillic-ext/wght/normal.woff2);unicode-range:U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F;font-display:swap;}@font-face {font-family:'Hanken Grotesk';font-style:normal;font-weight:600;src:url(/cf-fonts/v/hanken-grotesk/5.2.8/vietnamese/wght/normal.woff2);unicode-range:U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB;font-display:swap;}@font-face {font-family:'Hanken Grotesk';font-style:normal;font-weight:600;src:url(/cf-fonts/v/hanken-grotesk/5.2.8/latin/wght/normal.woff2);unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;font-display:swap;}@font-face {font-family:'Hanken Grotesk';font-style:normal;font-weight:600;src:url(/cf-fonts/v/hanken-grotesk/5.2.8/latin-ext/wght/normal.woff2);unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;font-display:swap;}</style>
        <style>
        /* Metric-matched stand-in so the swap does not resize the stat values.
           Arial averages 0.583 em per glyph against Hanken Grotesk's 0.570, hence
           size-adjust 97.69%; the ascent/descent overrides are Hanken's own
           (1000/-303 per 1000 em) divided by that same factor. */
        @font-face {
            font-family: 'Hanken Grotesk Fallback';
            src: local('Arial'), local('Helvetica'), local('Liberation Sans');
            size-adjust: 97.69%;
            ascent-override: 102.36%;
            descent-override: 31.02%;
            line-gap-override: 0%;
        }
        </style>
