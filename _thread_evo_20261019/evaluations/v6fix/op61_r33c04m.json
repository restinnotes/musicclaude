      "to": "S07-3",
      "rel": "引用"
     },
     {
      "from": "S07-2",
      "to": "S07-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "正在面对",
    "items": [
     {
      "id": "S08-1",
      "text": "他又短暂地沉进那份被自然接纳的温暖，暂时不去逼自己回答会不会重新选择。",
      "key": "他又短暂地沉进那",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S07-1"
      ]
     },
     {
      "id": "S08-2",
      "text": "这点安宁才刚靠近便又淡了，留下的只是他仍舍不得那段日子。",
      "key": "这点安宁才刚靠近",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-1",
      "to": "S08-1",
