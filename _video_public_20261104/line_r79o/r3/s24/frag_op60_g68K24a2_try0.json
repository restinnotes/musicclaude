{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他忽然很想靠近这个人",
     "accent": "很想靠近",
     "emotion": "炽热",
     "from": [
      "S01-1"
     ],
     "at": 0
    },
    {
     "text": "怕自己太需要这份亲近",
     "accent": "太需要",
     "emotion": "不安",
     "from": [
      "S01-2"
     ],
     "at": 3
    },
    {
     "text": "只敢露出一点喜欢",
     "accent": "",
     "emotion": "不安",
     "from": [
      "S01-2"
     ],
     "at": 6
    },
    {
     "text": "这一点亲近已经很甜",
     "accent": "很甜",
     "emotion": "欢喜",
     "from": [
      "S01-3"
     ],
     "at": 9
    }
   ],
   "small": [
    {
     "text": "下次能否更坦白些，他还拿不准",
     "after": 3,
     "from": [
      "S01-3"
     ],
     "bars": "",
     "at": 12
    },
    {
     "text": "话到嘴边沉默几秒，怕关系因此改变",
     "after": 1,
     "from": [
      "S01-B2"
     ],
     "bars": "1–3",
     "at": 11
    },
    {
     "text": "刚踏上船板，木板微晃，身体一轻",
     "after": 0,
     "from": [
      "S01-B3"
     ],
     "bars": "1–3",
     "at": 14
    }
   ],
   "notes": [
    {
     "text": "和弦像烟花迸起，落下仍悬着，摇荡未成形",
     "from": [
      "S01-B1",
      "S01-B3"
     ],
     "bars": "1–3"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "对方没因他的在意退开",
     "accent": "没退开",
     "emotion": "亲密",
     "from": [
      "S02-1"
     ],
     "at": 0
    },
    {
     "text": "他这才慢慢放松下来",
     "accent": "放松",
     "emotion": "安心",
     "from": [
      "S02-1"
     ],
     "at": 5
    },
    {
     "text": "喜欢几乎藏不住他还是收住了",
     "accent": "藏不住",
     "emotion": "炽热",
     "from": [
      "S02-2"
     ],
     "at": 18
    },
    {
     "text": "眼下这么好他已先有些舍不得",
     "accent": "舍不得",
     "emotion": "悬着",
     "from": [
      "S02-3"
     ],
     "at": 32
    }
   ],
   "small": [
    {
     "text": "肩膀挨着肩膀，呼吸和体温都贴近",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "6–16",
     "at": 8
    },
    {
     "text": "像熟人安静坐着，沉默也不紧张",
     "after": 1,
     "from": [
      "S02-B1"
     ],
     "bars": "6–16",
     "at": 12
    },
    {
     "text": "夏末温热潮湿的风裹在皮肤上",
     "after": 1,
     "from": [
      "S02-B1"
     ],
     "bars": "6–16",
     "at": 16
    },
    {
     "text": "身体交给船底托着，水和时间仍在流",
     "after": 1,
     "from": [
      "S02-B2"
     ],
     "bars": "4–16",
     "at": 20
    },
    {
     "text": "喜欢忽然涌上来，连呼吸都变了",
     "after": 2,
     "from": [
      "S02-B3"
     ],
     "bars": "12–16",
     "at": 25
    },
    {
     "text": "甜蜜像根温柔的刺，鼻酸又想慢些",
     "after": 3,
     "from": [
      "S02-B4"
     ],
     "bars": "7–11",
     "at": 35
    }
   ],
   "notes": [
    {
     "text": "歌声未起，左手已一下一下摇着",
     "from": [
      "S02-B2"
     ],
     "bars": "4–5"
    },
    {
     "text": "两条旋律贴得很近，像耳边低语",
     "from": [
      "S02-B1"
     ],
     "bars": "6–16"
    },
    {
     "text": "歌声上涌后又轻轻收回",
     "from": [
      "S02-B3"
     ],
     "bars": "12–16"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他难得不去想两个人的以后",
     "accent": "不去想",
     "emotion": "安心",
     "from": [
      "S03-1"
     ],
     "at": 0
    },
    {
     "text": "只想舒服地待在这份亲近里",
     "accent": "舒服地",
     "emotion": "亲密",
     "from": [
      "S03-1"
     ],
     "at": 5
    },
    {
     "text": "想说喜欢也想问对方是否一样",
     "accent": "是否一样",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ],
     "at": 14
    },
    {
     "text": "没想好怎么开口念头就淡了",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ],
     "at": 23
    }
   ],
   "small": [
    {
     "text": "亲密交谈后安静下来，沉默很舒服",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23",
     "at": 7
    },
    {
     "text": "水波托着身体，摇晃漂浮不去哪里",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23",
     "at": 9
    },
    {
     "text": "身体还在这里，心却慢慢漂远",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23",
     "at": 12
    },
    {
     "text": "急着表达的念头露头又沉回去",
     "after": 2,
     "from": [
      "S03-B2"
     ],
     "bars": "20–21",
     "at": 18
    },
    {
     "text": "思绪像被风吹碎的倒影，粼粼难拼",
     "after": 3,
     "from": [
      "S03-B3"
     ],
     "bars": "17–23",
     "at": 25
    },
    {
     "text": "谈话碰到解不开的结，顺畅里生阻力",
     "after": 3,
     "from": [
      "S03-B3"
     ],
     "bars": "17–23",
     "at": 27
    }
   ],
   "notes": [
    {
     "text": "歌声渐退，只剩流动盘旋",
     "from": [
      "S03-B1"
     ],
     "bars": "17–23"
    },
    {
     "text": "摇曳中冒出几句短促急切的声音",
     "from": [
      "S03-B2"
     ],
     "bars": "20–21"
    },
    {
     "text": "流动忽然受阻，声音绕远滞留",
     "from": [
      "S03-B3"
     ],
     "bars": "20–22"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "熟悉的亲近又让他满心欢喜",
     "accent": "满心欢喜",
     "emotion": "欢喜",
     "from": [
      "S04-1",
      "S04-B1"
     ],
     "at": 0
    },
    {
     "text": "上回没说的话这次几乎冲出口",
     "accent": "冲出口",
     "emotion": "炽热",
     "from": [
      "S04-1",
      "S04-2"
     ],
     "at": 7
    },
    {
     "text": "他盼对方也喜欢他坦白些",
     "accent": "坦白些",
     "emotion": "欢喜",
     "from": [
      "S04-2"
     ],
     "at": 15
    },
    {
     "text": "又怕说太多让对方为难",
     "accent": "为难",
     "emotion": "不安",
     "from": [
      "S04-3"
     ],
     "at": 24
    },
    {
     "text": "怕失去自在最后还是留了话",
     "accent": "留了话",
     "emotion": "悬着",
     "from": [
      "S04-3"
     ],
     "at": 34
    }
   ],
   "small": [
    {
     "text": "两道声线贴耳低语，呼吸挨得很近",
     "after": 0,
     "from": [
      "S04-B1"
     ],
     "bars": "24–34",
     "at": 9
    },
    {
     "text": "像讲往事越说越快，忍不住补细节",
     "after": 1,
     "from": [
      "S04-B1"
     ],
     "bars": "24–34",
     "at": 12
    },
    {
     "text": "最后一道夕阳金光亮得几乎刺眼",
     "after": 2,
     "from": [
      "S04-B2"
     ],
     "bars": "30–34",
     "at": 18
    },
    {
     "text": "话到喉咙口，颤着声几乎哽咽",
     "after": 3,
     "from": [
      "S04-B2"
     ],
     "bars": "30–34",
     "at": 22
    },
    {
     "text": "手越握越紧，越想抱住当下越失衡",
     "after": 3,
     "from": [
      "S04-B3"
     ],
     "bars": "24–34",
     "at": 28
    },
    {
     "text": "美好还在，水波像倒数，越美越鼻酸",
     "after": 4,
     "from": [
      "S04-B4"
     ],
     "bars": "24–34",
     "at": 35
    }
   ],
   "notes": [
    {
     "text": "熟悉歌声重现，花腔更华丽急切",
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "高处长颤音悬住，随后渐渐收弱",
     "from": [
      "S04-B2"
     ],
     "bars": "30–34"
    },
    {
     "text": "左手水波不停向前，摇荡渐渐放慢",
     "from": [
      "S04-B2",
      "S04-B4"
     ],
     "bars": "24–34"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "喜欢没藏住对方看出他在乎",
     "accent": "看出他在乎",
     "emotion": "不安",
     "from": [
      "S05-1"
     ],
     "at": 0
    },
    {
     "text": "心里空落落连相处都拿不准",
     "accent": "空落落",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ],
     "at": 3
    },
    {
     "text": "怕对方嫌太黏亲近像隔层",
     "accent": "像隔层",
     "emotion": "不安",
     "from": [
      "S05-3"
     ],
     "at": 6
    }
   ],
   "small": [
    {
     "text": "小船像漂进起雾的水域",
     "after": 1,
     "from": [
      "S05-B1"
     ],
     "bars": "35–39",
     "at": 8
    },
    {
     "text": "交谈停了，他跌回自己的心里",
     "after": 1,
     "from": [
      "S05-B2"
     ],
     "bars": "35–39",
     "at": 10
    },
    {
     "text": "幸福是真的吗？能维持多久？",
     "after": 1,
     "from": [
      "S05-B2"
     ],
     "bars": "35–39",
     "at": 12
    }
   ],
   "notes": [
    {
     "text": "饱满摇荡忽然抽空，只剩单线旋律",
     "from": [
      "S05-B1"
     ],
     "bars": "35–39"
    },
    {
     "text": "贴近的耳语像突然中断",
     "from": [
      "S05-B2"
     ],
     "bars": "35–39"
    },
    {
     "text": "旋律像松开紧握的手，终于深吸气",
     "from": [
      "S05-B3"
     ],
     "bars": "35–39"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "对方看出他的在乎却一点没变",
     "accent": "一点没变",
     "emotion": "安心",
     "from": [
      "S06-1"
     ],
     "at": 0
    },
    {
     "text": "他终于又能像从前那样自在",
     "accent": "自在",
     "emotion": "安心",
     "from": [
      "S06-1"
     ],
     "at": 5
    },
    {
     "text": "安静时还想靠近又怕要太多",
     "accent": "怕要太多",
     "emotion": "不安",
     "from": [
      "S06-2"
     ],
     "at": 12
    },
    {
     "text": "他孤单地猜对方会不会舍不得",
     "accent": "会不会舍不得",
     "emotion": "孤单",
     "from": [
      "S06-2",
      "S06-3"
     ],
     "at": 20
    },
    {
     "text": "这份沉醉越舒服越失去方向",
     "accent": "失去方向",
     "emotion": "炽热",
     "from": [
      "S06-B4"
     ],
     "at": 28
    }
   ],
   "small": [
    {
     "text": "暖金水面滑入古桥阴影，空气凉了",
     "after": 1,
     "from": [
      "S06-B1"
     ],
     "bars": "40–50",
     "at": 8
    },
    {
     "text": "清凉月光般纯净，想起童年初恋",
     "after": 1,
     "from": [
      "S06-B1"
     ],
     "bars": "40–50",
     "at": 11
    },
    {
     "text": "心里反复说算了，可还是放不下",
     "after": 2,
     "from": [
      "S06-B2"
     ],
     "bars": "40–50",
     "at": 16
    },
    {
     "text": "说着说着，不再努力显得完整",
     "after": 2,
     "from": [
      "S06-B2"
     ],
     "bars": "40–50",
     "at": 23
    },
    {
     "text": "白天很好，夜里泛酸，时光恍惚像回忆",
     "after": 3,
     "from": [
      "S06-B3"
     ],
     "bars": "40–50",
     "at": 29
    },
    {
     "text": "气味身体幻想遗憾快感混在一起",
     "after": 4,
     "from": [
      "S06-B4"
     ],
     "bars": "40–50",
     "at": 30
    }
   ],
   "notes": [
    {
     "text": "摇摆变轻，伴奏碎成细密水纹",
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "旋律压低，另一条声线不时回应",
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "他开始觉得对方有时也需要他",
     "accent": "也需要他",
     "emotion": "亲密",
     "from": [
      "S07-1"
     ],
     "at": 0
    },
    {
     "text": "想到能互相依靠他高兴又心紧",
     "accent": "互相依靠",
     "emotion": "炽热",
     "from": [
      "S07-2"
     ],
     "at": 6
    },
    {
     "text": "他盼着对方以后还会想到自己",
     "accent": "想到自己",
     "emotion": "欢喜",
     "from": [
      "S07-3"
     ],
     "at": 15
    },
    {
     "text": "自己也想一直陪在对方身边",
     "accent": "一直陪",
     "emotion": "亲密",
     "from": [
      "S07-3"
     ],
     "at": 25
    }
   ],
   "small": [
    {
     "text": "安静享受已不够，深处渴望推着往前",
     "after": 1,
     "from": [
      "S07-B1"
     ],
     "bars": "51–61",
     "at": 8
    },
    {
     "text": "情欲执念和对生命的眷恋一齐翻涌",
     "after": 1,
     "from": [
      "S07-B1"
     ],
     "bars": "51–61",
     "at": 12
    },
    {
     "text": "气味身体感觉幻想遗憾快感混在一起",
     "after": 1,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61",
     "at": 18
    },
    {
     "text": "带着情色暖意，明知被卷入却不想出来",
     "after": 1,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61",
     "at": 22
    },
    {
     "text": "越舒服越失去方向",
     "after": 1,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61",
     "at": 28
    },
    {
     "text": "这一刻仍然很美，时间却一直经过",
     "after": 3,
     "from": [
      "S07-B3"
     ],
     "bars": "53–61",
     "at": 32
    }
   ],
   "notes": [
    {
     "text": "伴奏变密，低音像沉重脉搏，暗涌攀爬",
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "对方依然亲近他想大方回应",
     "accent": "大方回应",
     "emotion": "欢喜",
     "from": [
      "S08-1"
     ],
     "at": 0
    },
    {
     "text": "他开始盼着两个人能好很久",
     "accent": "好很久",
     "emotion": "欢喜",
     "from": [
      "S08-2"
     ],
     "at": 10
    },
    {
     "text": "眼下亲近不等于以后也会这样",
     "accent": "不等于",
     "emotion": "不安",
     "from": [
      "S08-3"
     ],
     "at": 22
    }
   ],
   "small": [
    {
     "text": "歌声像重新接触阳光和风",
     "after": 0,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70",
     "at": 12
    },
    {
     "text": "身体恢复弹性，带着一点玩心",
     "after": 0,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70",
     "at": 15
    },
    {
     "text": "像轻快的调情和回应",
     "after": 0,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70",
     "at": 18
    },
    {
     "text": "快乐余温还在，心里先泛起怀念",
     "after": 2,
     "from": [
      "S08-B3"
     ],
     "bars": "69–71",
     "at": 26
    }
   ],
   "notes": [
    {
     "text": "歌句舒展直接，情绪一再抬高",
     "from": [
      "S08-B1"
     ],
     "bars": "62–70"
    },
    {
     "text": "歌声向上散开，随后戛然而止",
     "from": [
      "S08-B3"
     ],
     "bars": "69–71"
    }
   ]
  },
  {
   "sec": "S09",
   "big": [
    {
     "text": "他忽然怕对方有天不再需要他",
     "accent": "不再需要他",
     "emotion": "不安",
     "from": [
      "S09-1"
     ],
     "at": 0
    },
    {
     "text": "连和他待着都不自在了呢？",
     "accent": "不自在",
     "emotion": "不安",
     "from": [
      "S09-1"
     ],
     "at": 5
    },
    {
     "text": "他一下安静下来不敢再想以后",
     "accent": "不敢再想",
     "emotion": "悬着",
     "from": [
      "S09-2"
     ],
     "at": 10
    },
    {
     "text": "可眼下对方没退开亲近是真的",
     "accent": "亲近是真的",
     "emotion": "安心",
     "from": [
      "S09-3"
     ],
     "at": 17
    },
    {
     "text": "也许对方也喜欢他在身边",
     "accent": "也许",
     "emotion": "欢喜",
     "from": [
      "S09-3"
     ],
     "at": 23
    }
   ],
   "small": [
    {
     "text": "像话到要紧处顿住，两人对视屏息",
     "after": 2,
     "from": [
      "S09-B1"
     ],
     "bars": "72–77",
     "at": 6
    },
    {
     "text": "强烈渴望还在，却引而不发",
     "after": 2,
     "from": [
      "S09-B1"
     ],
     "bars": "72–77",
     "at": 8
    },
    {
     "text": "阳光隔着薄雾，注意力反而集中",
     "after": 2,
     "from": [
      "S09-B2"
     ],
     "bars": "72–77",
     "at": 12
    },
    {
     "text": "他反复听着余响：刚才是真的吗？",
     "after": 2,
     "from": [
      "S09-B3"
     ],
     "bars": "72–77",
     "at": 18
    },
    {
     "text": "抬头看夜空，美好比自己的愿望更大",
     "after": 3,
     "from": [
      "S09-B4"
     ],
     "bars": "72–77",
     "at": 23
    },
    {
     "text": "不安还没得到回答，却暂时没占满心思",
     "after": 4,
     "from": [
      "S09-B4"
     ],
     "bars": "72–77",
     "at": 24
    }
   ],
   "notes": [
    {
     "text": "摇摆退开，颤音与轻和弦悬在半空",
     "from": [
      "S09-B1"
     ],
     "bars": "72–77"
    },
    {
     "text": "声音一层层下沉，明亮渐被薄雾遮住",
     "from": [
      "S09-B2"
     ],
     "bars": "72–77"
    }
   ]
  },
  {
   "sec": "S10",
   "big": [
    {
     "text": "他不再猜以后先享受眼前亲近",
     "accent": "享受眼前",
     "emotion": "安心",
     "from": [
      "S10-1"
     ],
     "at": 0
    },
    {
     "text": "绷紧的肩终于松开胸腔打开",
     "accent": "终于松开",
     "emotion": "安心",
     "from": [
      "S10-B1"
     ],
     "at": 7
    },
    {
     "text": "心里亮得几乎想笑也想哭",
     "accent": "想笑也想哭",
     "emotion": "欢喜",
     "from": [
      "S10-2",
      "S10-B1"
     ],
     "at": 14
    }
   ],
   "small": [
    {
     "text": "心事没解决，这一刻不必再忍着",
     "after": 1,
     "from": [
      "S10-B1"
     ],
     "bars": "78–83",
     "at": 9
    },
    {
     "text": "时间像空出一小块地方，暂时不用往前",
     "after": 0,
     "from": [
      "S10-B2"
     ],
     "bars": "78–83",
     "at": 16
    },
    {
     "text": "这片空地很短，像终于呼出一口气",
     "after": 1,
     "from": [
      "S10-B2"
     ],
     "bars": "78–83",
     "at": 19
    },
    {
     "text": "身体轻得像灵魂飘在夏夜微风里",
     "after": 2,
     "from": [
      "S10-B3"
     ],
     "bars": "78–83",
     "at": 20
    }
   ],
   "notes": [
    {
     "text": "高音细亮如银色蛛丝和细雨",
     "from": [
      "S10-B4"
     ],
     "bars": "78–83"
    },
    {
     "text": "一串琶音像飞瀑清亮落进水里",
     "from": [
      "S10-B4"
     ],
     "bars": "80–83"
    }
   ]
  },
  {
   "sec": "S11",
   "big": [
    {
     "text": "熟悉的亲近忽然变得异常真实",
     "accent": "异常真实",
     "emotion": "炽热",
     "from": [
      "S11-B1"
     ],
     "at": 0
    },
    {
     "text": "他需要对方对方有时也需要自己",
     "accent": "也需要自己",
     "emotion": "亲密",
     "from": [
      "S11-1"
     ],
     "at": 5
    },
    {
     "text": "对方不需要他他也愿意陪着",
     "accent": "也愿意陪着",
     "emotion": "亲密",
     "from": [
      "S11-1"
     ],
     "at": 11
    },
    {
     "text": "他不再藏着喜欢",
     "accent": "不再藏着",
     "emotion": "炽热",
     "from": [
      "S11-1",
      "S11-2"
     ],
     "at": 17
    },
    {
     "text": "往后还让不让他陪他做不了主",
     "accent": "做不了主",
     "emotion": "不安",
     "from": [
      "S11-3"
     ],
     "at": 24
    }
   ],
   "small": [
    {
     "text": "想到未必总能这样亲近，欢喜压得心口疼",
     "after": 4,
     "from": [
      "S11-3",
      "S11-B3"
     ],
     "bars": "84–92",
     "at": 8
    },
    {
     "text": "像血红金亮的夕阳，刺得人想流泪",
     "after": 0,
     "from": [
      "S11-B3"
     ],
     "bars": "84–92",
     "at": 13
    },
    {
     "text": "多年后重回旧房子，熟悉却有新重量",
     "after": 0,
     "from": [
      "S11-B4"
     ],
     "bars": "84–92",
     "at": 18
    },
    {
     "text": "知道它多珍贵，心里反而更容易疼",
     "after": 0,
     "from": [
      "S11-B4"
     ],
     "bars": "84–92",
     "at": 22
    },
    {
     "text": "等了很久的期待，像终于得到回应",
     "after": 0,
     "from": [
      "S11-B2"
     ],
     "bars": "92",
     "at": 26
    }
   ],
   "notes": [
    {
     "text": "厚重和弦托起歌声，水波翻成巨浪",
     "from": [
      "S11-B1"
     ],
     "bars": "84–92"
    },
    {
     "text": "铺开的力量短暂悬在半空",
     "from": [
      "S11-B2"
     ],
     "bars": "92"
    }
   ]
  },
  {
   "sec": "S12",
   "big": [
    {
     "text": "他只想把能给的都给对方",
     "accent": "都给对方",
     "emotion": "炽热",
     "from": [
      "S12-1"
     ],
     "at": 0
    },
    {
     "text": "他像被更大的世界整个卷进去",
     "accent": "更大的世界",
     "emotion": "炽热",
     "from": [
      "S12-B1"
     ],
     "at": 5
    },
    {
     "text": "明知用心也留不住以后的好",
     "accent": "留不住",
     "emotion": "悬着",
     "from": [
      "S12-2"
     ],
     "at": 12
    },
    {
     "text": "还是想多陪对方一会儿",
     "accent": "多陪一会儿",
     "emotion": "炽热",
     "from": [
      "S12-2"
     ],
     "at": 20
    },
    {
     "text": "高兴终于涌出来他不再收着",
     "accent": "不再收着",
     "emotion": "欢喜",
     "from": [
      "S12-3"
     ],
     "at": 27
    }
   ],
   "small": [
    {
     "text": "他顾不上对方是否同样在乎",
     "after": 0,
     "from": [
      "S12-1"
     ],
     "bars": "",
     "at": 3
    },
    {
     "text": "连自己都暂时退到后面",
     "after": 1,
     "from": [
      "S12-B1"
     ],
     "bars": "93–102",
     "at": 8
    },
    {
     "text": "狂喜像高烧，忽然抱紧久久不松手",
     "after": 4,
     "from": [
      "S12-B2"
     ],
     "bars": "93–102",
     "at": 14
    },
    {
     "text": "喉咙发紧眼眶湿润，分不清笑还是哭",
     "after": 4,
     "from": [
      "S12-B2"
     ],
     "bars": "93–102",
     "at": 19
    },
    {
     "text": "还想要更多，却始终不能完全满足",
     "after": 3,
     "from": [
      "S12-B3"
     ],
     "bars": "93–102",
     "at": 24
    }
   ],
   "notes": [
    {
     "text": "晴朗歌声放大，内声部彼此拉扯",
     "from": [
      "S12-B1"
     ],
     "bars": "93–102"
    },
    {
     "text": "旋律一次次向上伸展，迟迟不落定",
     "from": [
      "S12-B3"
     ],
     "bars": "96–100"
    },
    {
     "text": "悬着的气在最后交界处得到释放",
     "from": [
      "S12-B3"
     ],
     "bars": "102–103"
    }
   ]
  },
  {
   "sec": "S13",
   "big": [
    {
     "text": "他更想听对方说以后也不变",
     "accent": "以后也不变",
     "emotion": "悬着",
     "from": [
      "S13-1"
     ],
     "at": 0
    },
    {
     "text": "就算听到保证时间仍过得太快",
     "accent": "时间仍过得太快",
     "emotion": "悬着",
     "from": [
      "S13-1"
     ],
     "at": 7
    },
    {
     "text": "他怕对方哪天不再需要自己",
     "accent": "不再需要自己",
     "emotion": "不安",
     "from": [
      "S13-2"
     ],
     "at": 14
    },
    {
     "text": "少露些喜欢会不会少疼点？",
     "accent": "少疼点",
     "emotion": "不安",
     "from": [
      "S13-2"
     ],
     "at": 21
    },
    {
     "text": "藏回去更难受他还是想对他好",
     "accent": "更难受",
     "emotion": "炽热",
     "from": [
      "S13-3"
     ],
     "at": 28
    }
   ],
   "small": [
    {
     "text": "刚说出口的愿望，还怕一停下就消失",
     "after": 0,
     "from": [
      "S13-B1"
     ],
     "bars": "103–110",
     "at": 4
    },
    {
     "text": "幸福没消失，难过却进了幸福里面",
     "after": 1,
     "from": [
      "S13-B2"
     ],
     "bars": "103–110",
     "at": 10
    },
    {
     "text": "终于握住珍贵的东西，才知道留不住",
     "after": 1,
     "from": [
      "S13-B2"
     ],
     "bars": "103–110",
     "at": 15
    },
    {
     "text": "心里刚说了是，马上又冒出可是呢？",
     "after": 2,
     "from": [
      "S13-B3"
     ],
     "bars": "103–110",
     "at": 20
    },
    {
     "text": "这个可是没有推翻刚才的幸福",
     "after": 2,
     "from": [
      "S13-B3"
     ],
     "bars": "103–110",
     "at": 24
    },
    {
     "text": "脚步站得很稳，胸口却一沉再沉",
     "after": 4,
     "from": [
      "S13-B4"
     ],
     "bars": "103–110",
     "at": 30
    }
   ],
   "notes": [
    {
     "text": "反复渐强，106小节后越绷越紧",
     "from": [
      "S13-B1"
     ],
     "bars": "103–110"
    },
    {
     "text": "明亮里渐渐掺进尖锐暗沉",
     "from": [
      "S13-B2"
     ],
     "bars": "107–110"
    },
    {
     "text": "下方脚步稳住，上方声音一次次下落",
     "from": [
      "S13-B4"
     ],
     "bars": "103–110"
    }
   ]
  },
  {
   "sec": "S14",
   "big": [
    {
     "text": "最初他连喜欢都不敢多露",
     "accent": "不敢多露",
     "emotion": "不安",
     "from": [
      "S14-1"
     ],
     "at": 0
    },
    {
     "text": "仍然亲近又甜又酸他不后悔",
     "accent": "不后悔",
     "emotion": "欢喜",
     "from": [
      "S14-1"
     ],
     "at": 5
    },
    {
     "text": "他舍不得却不再讨永远的保证",
     "accent": "不再讨",
     "emotion": "悬着",
     "from": [
      "S14-2"
     ],
     "at": 12
    },
    {
     "text": "喜欢既已被看见他就不再藏",
     "accent": "不再藏",
     "emotion": "炽热",
     "from": [
      "S14-3"
     ],
     "at": 20
    },
    {
     "text": "以后怎样等到了那时再说",
     "accent": "再说",
     "emotion": "安心",
     "from": [
      "S14-3"
     ],
     "at": 26
    }
   ],
   "small": [
    {
     "text": "像从美梦醒来，还记得梦里的光",
     "after": 1,
     "from": [
      "S14-B1"
     ],
     "bars": "111–115",
     "at": 8
    },
    {
     "text": "心里仍温热，身体慢慢恢复平静",
     "after": 1,
     "from": [
      "S14-B1"
     ],
     "bars": "111–115",
     "at": 14
    },
    {
     "text": "低低一声回望后，夜空还有一闪",
     "after": 2,
     "from": [
      "S14-B2"
     ],
     "bars": "113–115",
     "at": 17
    },
    {
     "text": "最后像铁锚落水，把小船一下定住",
     "after": 3,
     "from": [
      "S14-B3"
     ],
     "bars": "116",
     "at": 22
    },
    {
     "text": "像整理衣服关上门，重新站稳",
     "after": 3,
     "from": [
      "S14-B3"
     ],
     "bars": "116",
     "at": 25
    },
    {
     "text": "尾声像接住开头那句悬着的话",
     "after": 4,
     "from": [
      "S14-B4"
     ],
     "bars": "113–116",
     "at": 27
    }
   ],
   "notes": [
    {
     "text": "低声歌唱与熟悉的摇荡短暂回来",
     "from": [
      "S14-B2"
     ],
     "bars": "113–115"
    },
    {
     "text": "细碎琶音像水花溅向夜空",
     "from": [
      "S14-B2"
     ],
     "bars": "115"
    },
    {
     "text": "最后几下和弦沉重落定",
     "from": [
      "S14-B3",
      "S14-B4"
     ],
     "bars": "116"
    }
   ]
  }
 ]
}