{"completed": true, "response": "<escape>{\n  \"add\": [\n    {\n      \"sec\": \"S02\",\n      \"row\": \"S02-r2\",\n      \"text\": \"像熟人安静坐着 偶尔对视也不尴尬\",\n      \"from\": \"S02-B1\"\n    },\n    {\n      \"sec\": \"S03\",\n      \"row\": \"S03-r2\",\n      \"text\": \"像一句重要的话说完了 人还在余味里发愣\",\n      \"from\": \"S03-B1\"\n    },\n    {\n      \"sec\": \"S04\",\n      \"row\": \"S04-r2\",\n      \"text\": \"一句话说完还忍不住折回来补细节\",\n      \"from\": \"S04-B1\"\n    },\n    {\n      \"sec\": \"S04\",\n      \"row\": \"S04-r4\",\n      \"text\": \"话到喉咙口忽然发紧\",\n      \"from\": \"S04-B2\"\n    },\n    {\n      \"sec\": \"S05\",\n      \"row\": \"S05-r4\",\n      \"text\": \"像终于能深吸一口气\",\n      \"from\": \"S05-B3\"\n    },\n    {\n      \"sec\": \"S06\",\n      \"row\": \"S06-r2\",\n      \"text\": \"忽然想起年少时第一次心动的下午\",\n      \"from\": \"S06-B1\"\n    },\n    {\n      \"sec\": \"S06\",\n      \"row\": \"S06-r4\",\n      \"text\": \"心里刚说算了 又忍不住放不下\",\n      \"from\": \"S06-B2\"\n    },\n    {\n      \"sec\": \"S08\",\n      \"row\": \"S08-r2\",\n      \"text\": \"熟悉的摇荡也轻轻催着人往前\",\n      \"from\": \"S08-B1\"\n    },\n    {\n      \"sec\": \"S09\",\n      \"row\": \"S09-r2\",\n      \"text\": \"那股想靠近的劲还绷着 没有真正松开\",\n      \"from\": \"S09-B1\"\n    },\n    {\n      \"sec\": \"S10\",\n      \"row\": \"S10-r2\",\n      \"text\": \"眼泪终于不用憋着了\",\n      \"from\": \"S10-B1\"\n    },\n    {\n      \"sec\": \"S11\",\n      \"row\": \"S11-r3\",\n      \"text\": \"像刚从梦里漂着 忽然一下落回现实\",\n      \"from\": \"S11-B1\"\n    },\n    {\n      \"sec\": \"S12\",\n      \"row\": \"S12-r2\",\n      \"text\": \"喉咙发紧 眼眶一下湿了\",\n      \"from\": \"S12-B2\"\n    },\n    {\n      \"sec\": \"S13\",\n      \"row\": \"S13-r2\",\n      \"text\": \"刚握到手里 才发现它留不住\",\n      \"from\": \"S13-B2\"\n    },\n    {\n      \"sec\": \"S14\",\n      \"row\": \"S14-r4\",\n      \"text\": \"像从一场美梦里醒来 还记得梦里的光\",\n      \"from\": \"S14-B1\"\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "91af628d-1a4b-4f8d-aed6-e9c752ffa6