正确填写您的 SN 号。"},"submit":"激活","supportText":"\u003c0\u003e如需帮助，请\u003c/0\u003e\u003c1\u003e联系客服\u003c/2\u003e\u003c3\u003e。\u003c/3\u003e","error":{"2000":"输入信息有误，请检查后重新提交","2001":"该SN输入有误，请检查后重新输入","2002":"查询商品信息异常，请稍后重试","2003":"该打印机已超出延保服务时间上限，请更换其他打印机重试","2004":"该打印机不满足打印时长要求，请更换其他打印机重试","2005":"该打印机打印时长信息异常，请联系客服处理","2006":"该打印机与购买的延保地区不一致","2007":"该打印机与购买的延保机型不一致","2008":"该打印机查询信息异常，请联系客服处理","2009":"未查询到订单号信息，请稍后再试","3001":"您的延保订单已成功激活，无需再次操作","orderNo":{"required":"订单号不能为空","error":"订单号不正确，请确认后重试。"},"sn":{"required":"SN 不能为空","error":"SN 不正确，请确认后重试。"},"default":"绑定失败，请稍后重试"}},"infoContent":{"title":"您已成功激活延保服务","boundModel":"绑定机型","sn":"序列号","type":"延保类型","usageGuides":"更多打印机使用知识"}}},"euPartnerProgram":{"title":"您好，来自 {{partnerName}} 的朋友们。","createForm":{"title":"创建或绑定您的 Bambu Lab 商城账户","forgetPassword":"忘记密码","partnerTermsLabel":"我同意 \u003c1\u003eEPP/SPP 项目的条款与条件\u003c/1\u003e。","privacyAndPartnerTermsCheckConfirmDesc":"请先同意 \u003c1\u003e用户协议\u003c/1\u003e、\u003c3\u003e隐私声明\u003c/3\u003e 和 \u003c5\u003eEPP/SPP 项目的条款与条件\u003c/5\u003e。"}},"trustCenter":{"meta":{"title":"拓竹信任中心","desc":"拓竹信任中心详细介绍了拓竹在努力与全球用户构建信任方面，在安全、隐私、认证和合作等四个维度所采取的具体行动。","keywords":"拓竹，拓竹信任中心，信任中心，信任，隐私，安全，合规，认证，合作，拓竹安全，拓竹隐私，3D 打印机，IoT 安全，IoT 隐私，信息安全，隐私保护，数据保护，用户隐私，安全白皮书，GDPR 合规"},"header":{"name":"信任中心","home":"首页","security":"安全","privacy":"隐私","certification":"认证","collaboration":"合作"},"home":{"banner":{"title":"对隐私和安全的长期承诺","desc":"我们深知每一次打印都承载着你的创意与信任，Bambu Lab 承诺始终守护你的隐私与数据安全，不辜负每一份托付。\n\n"},"buildingTrust":{"title":"Bambu Lab 如何构建信任","cards":{"1":{"title":"安全","desc":"产品与服务的安全性不是附加条件，而是一切创新与体验的根基，我们以此为本，精益求精。"},"2":{"title":"隐私","desc":"保护用户隐私不仅是承诺，更是我们不断打磨、持续改进的方向——只为做得更好，让你更安心。"},"3":{"title":"认证","desc":"通过第三方的独立认证，用事实证明我们的安全与隐私保护不仅可信，更获得了业界的广泛认可。"},"4":{"title":"合作","desc":"我们秉持开放合作的态度，积极听取业界专家的建议，不断改进我们的产品和服务。"}}},"announcement":{"title":"最新公告"},"contactUs":{"title":"联系我们","desc":"如有任何疑问与咨询，请通过电子邮件联系我们。","sendButton":"发送电子邮件"}},"security":{"banner":{"title":"安全","desc":"产品与服务的安全性不是附加条件，而是一切创新与体验的根基，我们以此为本，精益求精。"},"overview":{"title":"安全概览","cards":{"1":{"title":"设备安全","cards":{"1":{"title":"网络安全","items":{"1":"安全的网络协议","2":"设备安全上云"}},"2":{"title":"隐私保护","items":{"1":"局域网模式","2":"离线升级"}},"3":{"title":"系统安全","items":{"1":"验证启动","2":"文件系统加密","3":"安全升级","4":"安全调试"}},"4":{"title":"硬件安全","items":{"1":"安全启动","2":"安全引擎","3":"密钥管理","4":"可信执行环境"}}}},"2":{"title":"软件安全","cards":{"1":{"title":"开源","items":{"1":"Bambu Studio 开源"}},"2":{"title":"隐私控制","items":{"1":"应用程序隐私设置"}},"3":{"title":"软件加固","items":{"1":"虚拟机保护","2":"混淆保护","3":"反调试保护"}}}},"3":{"title":"云服务安全","cards":{"1":{"title":"用户数据隐私合规","items":{"1":"Truste","2":"ISO/IEC: 27001","3":"ISO/IEC: 27701"}},"2":{"title":"云端防护体系","items":{"1":"多层安全防护体系","2":"用户账号保护","3":"安全运维 \u0026 专业渗透"}}}}}},"device":{"title":"设备安全","cards":{"1":{"title":"硬件与芯片安全","desc":"拓竹采用业界先进的安全芯片、TEE（受信任执行环境）和硬件加解密引擎，严格遵循业界最佳实践，从芯片启动到数据加密全链路构建可信根，为隐私数据保护筑牢每一道防线。"},"2":{"title":"通信加密","desc":"拓竹全面采用 HTTPS、MQTTS，FTPS 等业界标准的加密协议，确保数据传输过程安全可靠，经得起时间与攻击的双重考验。"}}},"cloud":{"title":"云安全","cards":{"1":{"title":"账号安全","desc":"Bambu 账号 支持多种第三方账号登录，异常登录时自动触发双重认证，并提供一键注销账号功能，全面保障你的账户安全与自主控制权。"},"2":{"title":"多层安全防护 \u0026 数据加密","desc":"Bambu 云服务默认采用数据加密技术，同时在云端采用了多层安全防护，全面保护用户数据安全。"}}},"validation":{"title":"安全验证","cards":{"1":{"title":"Bug Bounty 项目","desc":"Bambu Lab 于 2023 年启动漏洞赏金计划 (BBP)，旨在鼓励安全漏洞的负责任披露。","button":"了解详情"},"2":{"title":"三方认证/渗透","desc":"通过三方认证，周期性进行渗透测试。","button":"了解详情"}}}},"privacy":{"banner":{"title":"隐私","desc":"保护用户隐私不仅是承诺，更是我们不断打磨、持续改进的方向——只为做得更好，让你更安心。"},"principles":{"title":"隐私保护原则","cards":{"1":{"title":"公开透明","desc":"我们努力使我们的数据处理实践保持公开透明，以便您做出明智的选择。"},"2":{"title":"开放合作","desc":"我们努力听取用户反馈，发觉其中的隐私安全改进点，并在产品和服务中不断改进。"},"3":{"title":"用户可控","desc":"我们力为用户提供简单易用的方法来帮助用户控制自己的信息。"},"4":{"title":"隐私合规","desc":"我们的隐私实践严格遵从当前隐私和数据安全法律和标准，并通过相关认证。"}},"buttons":{"1":"查看隐私声明","2":"查看隐私认证"}},"contactUs":{"sectionTitle":"联系隐私团队","title":"我们努力听取用户反馈，发觉其中的隐私安全改进点，并在产品和服务中不断改进。","desc":"如果您对我们的产品有任何隐私方面的顾虑或问题，都可以联系我们的隐私团队寻求进一步帮助。","button":"发送电子邮件"},"features":{"title":"产品隐私保护功能","desc":"您的隐私，您做主。我们的打印机内置多项隐私安全功能，让您可根据需求灵活设置，牢牢掌握数据安全的主动权。","cards":{"1":{"title":"局域网模式","desc":"不用联网即可使用打印机"},"2":{"title":"离线升级","desc":"不用联网即可升级设备"},"3":{"title":"日志导出加密","desc":"用户数据可选导出 \u0026 AES256加密"},"4":{"title":"恢复出厂设置","desc":"清除设备日志和用户数据"}},"button":"更多详情请参考"}},"certification":{"banner":{"title":"认证","desc":"通过第三方的独立认证，用事实证明我们的安全与隐私保护不仅可信，更获得了业界的广泛认可。"},"list":{"title":"认证列表"},"materials":{"title":"安全材料"}},"collaboration":{"banner":{"title":"合作 ","desc":"我们秉持开放合作的态度，积极听取业界专家的建议，不断改进我们的产品和服务。"},"bugBounty":{"title":"漏洞赏金项目","desc":"Bambu Lab 漏洞赏金计划是邀请安全专家识别 Bambu Lab 产品和平台的安全漏洞，并由 Bambu Lab 给予安全专家相应赏金的项目。这个项目也是 Bambu Lab 秉持开放合作的态度，跟业界建立公开合作以持续提升产品安全和数据隐私保护计划的一部分。","moreButton":"更多详细信息"},"thirdPartyIntegration":{"title":"三方集成项目","desc":"拓竹提供可本地部署的 HTTP 服务与对应的SDK，支持第三方开发者构建私有服务，实现多台打印机的自动化调度与管理。","cards":{"1":{"title":"如需查看技术细节","desc":"请参阅官方第三方集成说明。","buttonText":"查看集成文档"},"2":{"title":"想申请成为合作伙伴或获取 SDK","desc":"请访问权请通过官方合作申请页面提交请求。","buttonText":"申请成为合作方"}}}},"securityUpdate":{"title":"拓竹安全更新","desc":"为保护用户安全，在完成调查并提供适当的修复或发布版本之前，拓竹不会披露、讨论或确认安全漏洞的相关细节。安全信息仅在受影响产品可获取修复方案后才会发布。","subDesc":"*如果您认为在拓竹产品中发现了安全或隐私漏洞，请通过\u003cbugBountyLink\u003e拓竹漏洞赏金计划\u003c/bugBountyLink\u003e提交您的发现，该计划是我们接收和追踪漏洞报告的主要渠道。有关我们协调披露原则和报告期望的一般信息，请参阅我们的\u003cdisclosureLink\u003e漏洞披露政策\u003c/disclosureLink\u003e。","sectionTitle":"安全更新","sectionDesc":"本页面提供了拓竹官方版本（包括固件、桌面软件和移动应用）中已修复安全漏洞的参考表格。每个版本可能包含一个或多个安全问题的修复。\n如有可用的 CVE 标识符，漏洞将使用 CVE 编号引用。拓竹也可能使用内部追踪标识符来标记未分配 CVE 的问题。","table":{"productVersion":"产品版本","productModel":"产品型号","releaseDate":"发布日期","vulnerabilitiesFixed":"已修复漏洞","count":"数量"},"innerTable":{"vulnerabilityId":"漏洞 ID","type":"类型","component":"组件","description":"概要描述"},"pagination":{"pageInfo":"第 {{page}} 页，共 {{totalPages}} 页","prev":"上一页","next":"下一页"}}},"bugBounty":{"header":{"name":"漏洞赏金项目","overview":"概览","scopeAndBounty":"范围 \u0026 奖金","hallOfFame":"名人堂","announcement":"公告","myReport":"我的报告","button":"提交报告"},"overview":{"title":"拓竹漏洞赏金项目","desc":"在 Bambu Lab，安全是打造互联产品和服务过程中至关重要的一环。通过 Bug Bounty 计划，我们与安全社区展开合作，及早发现漏洞，持续提升系统的安全性与可靠性。"},"scope":{"title":"参加 Bug Bounty Program 很简单","button":"提交报告","guidelines":"上报指南","cards":{"1":{"title":"登录：管理你的漏洞报告","desc":"登录至我们专用的安全平台，集中提交、跟踪并管理你的漏洞报告，流程清晰且高效。"},"2":{"title":"上报阶段：提交漏洞报告","desc":"发现问题后，通过系统提交清晰、完整的漏洞报告。"},"3":{"title":"验证阶段：专家审核与反馈","desc":"专家团队将在 3-10 个工作日审核报告并回复（节假日可能延后）。"},"4":{"title":"奖励阶段：依据严重程度发放奖励","desc":"有效漏洞将按严重等级给予奖励，预计 1–3 个月内发放。"},"5":{"title":"解决阶段：漏洞修复与闭环处理","desc":"确认漏洞后，我们将尽快修复并完成闭环处理。"}}},"bounty":{"title":"提交漏洞报告，获得奖金奖励","desc":"我们将根据漏洞利用链在真实环境中的实际影响，对漏洞赏金进行评估，给与丰厚的漏洞奖金。对于在研究过程中取得重大突破，或对整体安全能力带来显著提升的安全研究成果，我们可能会额外提供奖金激励。 为防止测试行为超出授权范围，并确保完全符合法律与合规要求，本 Bug Bounty 计划对允许的安全测试范围进行了明确界定。 请参阅下方的详细测试范围与奖励规则说明。"},"hallOfFame":{"title":"名人堂","desc":"名人堂展示了为拓竹安全建设做出突出贡献的研究者。包含 贡献名单（Contribution List） 与 季度排行榜（Leaderboard） 两部分：贡献名单记录所有有效提交的安全研究者；季度排行榜则表彰当季贡献最突出的前三位研究者，以感谢他们的重要付出。"},"announcement":{"title":"公告","empty":"暂无公告"},"report":{"title":"我的报告","backText":"返回报告列表","loginDesc":"需要登录后才能查看相关信息","status":{"reviewing":{"name":"审核中","desc":"审核中：您的报告正在由我们的安全团队审核中。我们正在评估其影响，并会尽快向您更新进展。"},"rejected":{"name":"已拒绝","desc":"已拒绝：我们已审核您的报告，但其未达到接受或奖励的标准。感谢您的贡献。"},"confirmed":{"name":"已确认","desc":"已确认：恭喜！您的报告已被确认。我们正在安排漏洞修复及奖励发放。"},"awarded":{"name":"已授奖","desc":"已授奖：感谢您的贡献！您的奖励已发放。待修复完全部署后，我们将更新状态。"},"closed":{"name":"已关闭","desc":"已关闭：该问题已成功解决并完成验证。感谢您提供的宝贵报告。"}},"list":{"newReport":"新的报告","noReports":"没有报告","filterStatus":{"open":"进行中","closed":"已关闭","draft":"草稿"}},"create":{"title":"请输入报告标题","desc":"复现前置条件：\n1.\n2.\n3.\n\n复现步骤：\n1.\n2.\n3.","information":"添加更多信息","files":"点击或将文件拖拽到此处以上传 最大：500MB","privacy":"我已阅读并同意 Bambu Lab 漏洞悬赏计划及上述\u003ctermsLink\u003e条款与条件\u003c/termsLink\u003e。","allowRanking":"在名人堂展示我的昵称。","submit":"提交","delete":"删除","addComment":"添加评论","success":"提交成功","error":"提交失败，请重试。","tooMoreDrafts":"草稿已满，如需自动保存为草稿，请先清理草稿内容","validate":{"titleRequired":"请输入报告标题","titleMax":"报告标题不能超过{{max}}个字符","descRequir