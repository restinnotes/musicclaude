       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他很想告诉爱人自己有多珍惜这样的日子，又怕说得太郑重",
