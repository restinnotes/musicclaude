    <script>
        (function () {
            const dockSearchTrigger = document.querySelector('[data-mobile-dock-search]');
            const globalSearchTrigger = document.getElementById('erSearchTrigger');
            if (dockSearchTrigger) {
                dockSearchTrigger.addEventListener('click', function () {
                    if (globalSearchTrigger) {
                        globalSearchTrigger.click();
                        return;
                    }
                    window.location.href = "https:\/\/www.emergenresearch.com\/search-reports";
                });
            }

            const navTrack = document.querySelector('[data-report-nav-track]');
            const leftBtn = document.querySelector('[data-report-nav-scroll="left"]');
            const rightBtn = document.querySelector('[data-report-nav-scroll="right"]');

            if (!navTrack || !leftBtn || !rightBtn) return;

            function syncNavButtons() {
                const maxScroll = navTrack.scrollWidth - navTrack.clientWidth;
                leftBtn.disabled = navTrack.scrollLeft <= 4;
                rightBtn.disabled = navTrack.scrollLeft >= maxScroll - 4;
            }

            function scrollNav(direction) {
                navTrack.scrollBy({
                    left: direction * 240,
                    behavior: 'smooth'
                });
            }

            leftBtn.addEventListener('click', function () {
                scrollNav(-1);
            });

            rightBtn.addEventListener('click', function () {
                scrollNav(1);
            });

            navTrack.addEventListener('scroll', syncNavButtons, { passive: true });
            window.addEventListener('resize', syncNavButtons);
            syncNavButtons();
        })();
    </script>

    <script>
        (function () {
            const faqItems = Array.from(document.querySelectorAll('#emer-faq .faq-item'));
            if (!faqItems.length) return;

            function syncFaqIcons() {
                faqItems.forEach(function (item) {
                    const icon = item.querySelector('.faq-icon');
                    if (!icon) return;
                    icon.textContent = item.hasAttribute('open') ? '×' : '+';
                });
            }

            faqItems.forEach(function (item) {
                item.addEventListener('toggle', syncFaqIcons);
            });

            syncFaqIcons();
        })();
    </script>

    <script>
        (function () {
            const tierCards = Array.from(document.querySelectorAll('[data-license-tier]'));
            const buyLink = document.querySelector('[data-buy-report-link]');

            if (!tierCards.length || !buyLink) return;

            function setActiveTier(card) {
                tierCards.forEach(function (item) {
                    const isActive = item === card;
                    item.classList.toggle('is-selected', isActive);
                    item.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                });

                const buyUrl = card.getAttribute('data-buy-url');
                if (buyUrl) {
                    buyLink.setAttribute('href', buyUrl);
                }
            }

            tierCards.forEach(function (card) {
                card.addEventListener('click', function () {
                    setActiveTier(card);
                });

                card.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        setActiveTier(card);
                    }
                });
            });
        })();
    </script>

    <script>
        (function () {
            const sidebar = document.getElementById('emer-sidebar');
            const openBtn = document.getElementById('emer-sidebar-open');
            const closeBtn = document.getElementById('emer-sidebar-close');

            if (!sidebar || !openBtn) return;

            if (closeBtn) {
                closeBtn.addEventListener('click', function () {
                    sidebar.classList.add('hidden');
                    openBtn.classList.remove('hidden');
                });
            }

            openBtn.addEventListener('click', function () {
                sidebar.classList.remove('hidden');
                openBtn.classList.add('hidden');
            });
        })();
    </script>

    <script>
        (function () {
            const content = document.getElementById('report-content');
            const shareTarget = document.getElementById('sidebar-share');
            if (!content) return;

            const reportTitle = content.dataset.reportTitle || 'report';
            const reportSubtitle = content.dataset.reportSubtitle || '';
            const printUrl = content.dataset.printUrl || '';
            const pdfUrl = content.dataset.pdfUrl || '';
            const pageUrl = window.location.href;
            const getCsrfToken = function () {
                return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
                    || subscribeForm?.querySelector('input[name="_token"]')?.value
                    || window.__ER_CSRF_TOKEN
                    || 'i6SL3kVyJGgaoVJnxt7PM0dVOpKgUvcMjmLXWEQF';
            };

            function handlePrint() {
                if (!printUrl) return;
                window.open(printUrl + '?print=1', '_blank');
            }

            function handleDownload() {
                if (!pdfUrl) return;
                window.open(pdfUrl, '_blank');
            }

            function handleShare() {
                if (shareTarget) {
                    shareTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }

            function copyToClipboard(text) {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).catch(() => {});
                    return;
                }
                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.select();
                try { document.execCommand('copy'); } catch (_) {}
                document.body.removeChild(textarea);
            }

            function handleShareAction(type) {
                function buildUtmUrl(source) {
                    try {
                        const url = new URL(pageUrl);
                        url.searchParams.set('utm_source', source);
                        url.searchParams.set('utm_medium', 'share');
                        url.searchParams.set('utm_campaign', reportId);
                        return url.toString();
                    } catch (_) {
                        return pageUrl;
                    }
                }

                const shareUrl = {
                    email: buildUtmUrl('email'),
                    copy: buildUtmUrl('copy'),
                    facebook: buildUtmUrl('facebook'),
                    x: buildUtmUrl('x'),
                    linkedin: buildUtmUrl('linkedin')
                }[type] || pageUrl;

                const encodedUrl = encodeURIComponent(shareUrl);
                const encodedTitle = encodeURIComponent(reportTitle);
                const copyToast = document.getElementById('share-copy-toast');

                if (type === 'email') {
                    const subjectText = reportSubtitle ? `${reportTitle} - ${reportSubtitle}` : reportTitle;
                    const subject = encodeURIComponent(subjectText);
                    const bodyParts = [reportTitle];
                    if (reportSubtitle) bodyParts.push(reportSubtitle);
                    bodyParts.push(shareUrl);
                    const body = encodeURIComponent(bodyParts.join('\n'));
                    window.location.href = `mailto:?subject=${subject}&body=${body}`;
                    return;
                }

                if (type === 'copy') {
                    copyToClipboard(shareUrl);
                    if (copyToast) {
                        copyToast.classList.remove('hidden');
                        window.clearTimeout(copyToast._hideTimer);
                        copyToast._hideTimer = window.setTimeout(() => {
                            copyToast.classList.add('hidden');
                        }, 1500);
                    }
                    return;
                }

                if (type === 'facebook') {
                    window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`, '_blank', 'noopener');
                    return;
                }

                if (type === 'x') {
                    window.open(`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`, '_blank', 'noopener');
                    return;
                }

                if (type === 'linkedin') {
                    window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`, '_blank', 'noopener');
                    return;
                }
            }

            function handleRequestSample(btn) {
                const url = btn?.getAttribute('data-sample-url');
                if (url) window.location.href = url;
            }

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-action]');
                if (!btn) return;
                const action = btn.getAttribute('data-action');
                if (action === 'print') handlePrint();
                if (action === 'download') handleDownload();
                if (action === 'share') handleShare();
                if (action === 'request-sample') handleRequestSample(btn);
            });

            document.addEventListener('click', function (e) {
                const shareBtn = e.target.closest('[data-share]');
                if (!shareBtn) return;
                e.preventDefault();
                const type = shareBtn.getAttribute('data-share');
                handleShareAction(type);
            });

            const subscribeForm = document.querySelector('[data-subscribe-form]');
            const subscribeStatus = document.getElementById('subscribe-status');
            if (subscribeForm) {
                subscribeForm.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    if (subscribeStatus) {
                        subscribeStatus.classList.add('hidden');
                        subscribeStatus.textContent = '';
                    }
                    try {
                        const formData = new FormData(subscribeForm);
                        const response = await fetch(subscribeForm.action, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'X-CSRF-TOKEN': getCsrfToken()
                            },
                            body: formData
                        });
                        if (!response.ok) throw new Error('Request failed');
                        if (subscribeStatus) {
                            subscribeStatus.textContent = "Thanks for subscribing!";
                            subscribeStatus.classList.remove('hidden');
                        }
                        subscribeForm.reset();
                    } catch (_) {
                        if (subscribeStatus) {
                            subscribeStatus.textContent = "Please try again.";
                            subscribeStatus.classList.remove('hidden');
                        }
                    }
                });
            }
        })();
    </script>

    </div>
</section>
</section>
