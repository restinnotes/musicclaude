     "emotion": "安心",
     "from": [
      "S08-1"
     ]
    },
    {
     "kind": "line",
     "text": "他想主动些，大大方方地回应",
     "keys": [
      "大大方方地回应"
     ],
     "emotion": "炽热",
     "from": [
      "S08-1"
     ],
     "at": 8.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "旋律直接舒展，像意大利歌剧里的咏叹调",
       "bead": "S08-B1",
       "from": [
        "S08-B1"
       ],
       "bars": "62–70",
       "at": 3.0
      },
      {
       "text": "没有哲学和防卫，歌句越唱越开",
       "bead": "S08-B1",
       "from": [
        "S08-B1"
