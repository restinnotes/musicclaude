 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开了熟悉的生活 / 起初觉得总算不用再委屈自己",
       "keys": [
        "离开了熟悉的生活",
        "不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头那一下很沉，像逼着自己把背脊挺直。",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "可后面的声音像烟一样往高处散，悬在半空。",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "停顿里仿佛还在等一个回声。",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可这份笃定没撑多久 / 心里很快空了下来 / 他一时说不清舍不得什么 / 还想往前过，却不知道靠什么安下心",
       "keys": [
        "笃定没撑多久",
        "不知道靠什么安下心"
       ],
       "from": [
        "S01-2",
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "短句像叹息，刚冒出来就被长停顿截断。",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "余音在冷空气里慢慢散尽，连失落都还说不清。",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "胸口发紧，眼前模糊，伸手却只摸到虚空。",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "旧日的声音和光线忽然清楚起来，可过去回不来了。",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "身体像先于意识，隐约记起该怎么迈步。",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前自在的日子 / 想到以后不能再那样过 / 心里就有些慌",
       "keys": [
        "舍不得",
        "心里就有些慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像一首从远处传来的旧歌，只能模糊哼出几句。",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "庄严的步子底下，旋律却脆弱凄婉。",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他赶紧提醒自己受过的气 / 怕一心软，就忘了当初为什么离开",
       "keys": [
        "提醒自己受过的气",
        "为什么离开"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像整理好衣服、抬起头，不想让人看见动摇。",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "一遍遍说我没事，说得越多越显得在意。",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "可他还是不甘心 / 难道不再受那些气 / 就得把以前的好日子也丢掉吗",
       "keys": [
        "不甘心",
        "好日子也丢掉吗"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "音乐猛地往上推，又退了回来。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "后来力量重新聚拢，越往后越焦灼。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "连绵的节奏催得呼吸越来越急。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "那股激昂更像不肯认输，不是轻松恢复自信。",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他心里还憋着一股气 / 可想起从前有人把他当自己人 / 又高兴了一小会儿",
       "keys": [
        "憋着一股气",
        "当自己人"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "忽强忽弱的起伏让人心里一悬，像想往前却定不下方向。",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "前半段急切焦躁，像心里一直没法安静下来。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "后半段忽然柔和，像故乡夏日的麦浪和微风。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那点高兴还没退 / 他心里就酸了：离开以后 / 真的一定会过得更好吗",
       "keys": [
        "高兴还没退",
        "真的一定会过得更好吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像好几个人在耳边低声絮语，彼此缠着找不到出口。",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "那一刻的轻松可以是真的，只是没替心里的事找到答案。",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "也像刚才的昂扬慢慢退潮，他开始问自己是否真信过那些话。",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起那些亲近的时候 / 他真盼着一切还能照从前那样继续",
       "keys": [
        "亲近的时候",
        "照从前那样继续"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧记忆一下鲜活起来，连感激和短暂的幸福都回来了。",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "可熟悉的姿态里多了回声，也变得更容易受伤。",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可越盼着照旧 / 他越怀疑当初是不是走错了 / 却想不出没离开会怎样",
       "keys": [
        "怀疑当初是不是走错了",
        "想不出没离开会怎样"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不是记忆变坏了，而是它太好了，过去再也回不来。",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "脚步像越跑越急，心跳乱了拍，身体都停不下来。",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "脑子里反复问：如果当时、是不是还可以、为什么会这样。",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他还是不服气 / 觉得当初那些气不该忍 / 也不想连开心的事都不敢想",
       "keys": [
        "不服气",
        "开心的事都不敢想"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两只手像夜色里的影子，彼此低声说话。",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "柔和里仍有一股劲，像在说这事不能就这么算了。",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "旧日记忆重新有了温度，眷恋里却带着失落。",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可跟自己争得太久 / 那股不服气慢慢淡了 / 想到已不在他们身边，只觉得难受",
       "keys": [
        "争得太久",
        "慢慢淡了"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音慢慢放缓、变稀，最后只剩较疏的和弦。",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "几次深呼吸似的叹息，让紧绷暂时松开。",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      },
      {
       "text": "可这不是想通了，更像是抵抗得太累了。",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "心里那阵难受慢慢缓下来 / 他又想起从前有人在身边 / 这回没急着拿受过的气压住想念",
       "keys": [
        "难受慢慢缓下来",
        "没急着拿受过的气压住想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "四周像隔着透明玻璃，连呼吸都不敢惊动它。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "又像母亲在耳边轻轻哼摇篮曲，让人暂时放下戒备。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "离开以后遇上难熬的事 / 他常常只能自己挺过去 / 这才知道有人陪着时轻松多少",
       "keys": [
        "自己挺过去",
        "轻松多少"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "终于不用解释自己为什么难过，也不用装作坚强。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "愿望说得很真，却没有谁保证会回应。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "远方忽然亮起来，像梦里看见已经远去的家园。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他很想再过那种亲近的日子 / 又怕以后再也没有了",
       "keys": [
        "很想再过那种亲近的日子",
        "怕以后再也没有了"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "起初含蓄试探，后来才慢慢敢说心里话。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "歌唱逐渐展开，像终于鼓起勇气把话说出来。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "再往后情感更迫切，临近结尾却像话没说完。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "不过那样的日子他确实拥有过 / 光是这么想着 / 心里也暖和了一点",
       "keys": [
        "确实拥有过",
        "暖和了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "明知有些事挽不回，也可以放轻声音，好好看着它。",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心 / 他却想到以后再遇上难事 / 要是还得一个人顶，他撑得住吗",
       "keys": [
        "刚有点安心",
        "一个人顶"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "轻得像游丝的颤音，却带着刺骨寒意。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "像寒风吹开窗，后颈一凉，脉搏猛地跳起来。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "当初离开时 / 他只想着别再受那些气 / 没想到会这么孤单 / 早知道这样，他还会走吗",
       "keys": [
        "别再受那些气",
        "这么孤单"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "舞步忽然闯进来，像换了场景，刚才的思绪被截断。",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "熟悉的动作或舞蹈闯进来，反而让人更清楚失去了什么。",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想找回从前的亲近 / 又不甘心回去再受那些气 / 可当初离开的决心也找不着了",
       "keys": [
        "找回从前的亲近",
        "离开的决心"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里像有东西不停翻转，想停也停不下来。",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      },
      {
       "text": "事情像是过去了，身体却还不相信真的结束。",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      },
      {
       "text": "熟悉的舞曲又出现，却不再像最初那样完整有力。",
       "keys": [],
       "from": [
        "S07-B5"
       ],
       "bead": "S07-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他先把回不回去放到一边 / 想起从前亲近的时光 / 心里又暖和了一会儿",
       "keys": [
        "放到一边",
        "暖和了一会儿"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的、近乎祈求的歌唱一回来，心里柔软处也打开了。",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
