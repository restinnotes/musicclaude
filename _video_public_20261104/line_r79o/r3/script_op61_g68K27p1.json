       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争到没力气：不服气淡了，只剩离开他们的难受",
