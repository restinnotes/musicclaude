n/v.mp4"}}}},"head":{"default":"Bambu Lab","mwStoreSignIn":{"title":"Sign In / Sign Up | MakerMarket Creator Alliance"},"developer":{"fleetHub":{"developerAgreement":{"title":"Fleet Hub Developer Agreement"},"privacyStatement":{"title":"Fleet Hub Privacy Statement"},"index":{"title":"Fleet Hub Developer Center"}}},"product":{"fleetHub":{"index":{"title":"Bambu Lab Fleet Hub","description":"Offline Fleet Command. Seamless Enterprise Workflow."},"specs":{"title":"Bambu Lab Fleet Hub - Technical Specifications","description":"Tech Specs for Fleet Hub \u0026 corresponding add-on modules"}}},"index":{"title":"Bambu Lab | Unleash Your Creativity with Bambu Lab 3D Printers","description":"Bambu Lab builds state-of-the-art desktop 3D printers that break the barriers between the digital and physical worlds. Explore High performance 3D printers on Bambu Lab official website. "},"a1":{"title":"Bambu Lab A1 mini | Desktop 3D Printer | A1 series","description":"Ultimate performance in compact build volume, Bambu Lab A1 mini offers ease of use 3D printing with features once found only in high-end models for beginners."},"a1TechSpecs":{"title":"Bambu Lab A1 mini - Technical Specifications","description":"Technical Specifications. Body Build Volume: 180mm*180mm*180mm Chassis: Steel + Extruded Aluminum ToolHead Hot End: All-Metal Extruder Gears: Steel"},"a1Printer":{"title":"Bambu Lab A1 | Desktop 3D Printer | A1 series","description":"Fully automated, multi-color printing, full size bed-slinger with CoreXY speed, Bambu Lab A1 makes 3D printing better for beginners and enthusiasts alike."},"a1PrinterTechSpecs":{"title":"Bambu Lab A1 - Technical Specifications","description":"Technical Specifications. Body Build Volume: 256mm*256mm*256mm Chassis: Steel + Extruded Aluminum ToolHead Hot End: All-Metal Extruder Gears: Steel"},"x1":{"title":"Bambu Lab X1 Series | Desktop 3D Printer | X1C","description":"Bambu Lab X1 series are state-of-the-art desktop 3D printers with CoreXY high speed and multi-color capabilities, built for both beginners and professionals."},"x1e":{"title":"Bambu Lab X1E 3D Printer","description":"X1E inherits the stability and reliability of the X1 series, with optimized functionalities and network security for professional users and engineering applications."},"p1":{"title":"Bambu Lab P1 Series | Reliable Out-of-the-Box Performance","description":"With its CoreXY design and reliable performance, this series offers a seamless printing experience right out of the box and excellent value for its price."},"h2s":{"title":"Bambu Lab H2S Large Format 3D Printer | Fast. Precise. Full Color","description":"Experience large-format 3D printing with ultra-fast speed, advanced precision, and multi-color capabilities—create bigger, faster, better, and in full color."},"h2sTechSpecs":{"title":"Bambu Lab H2S - Technical Specifications","description":"Tech Specs for H2S \u0026 corresponding add-on modules"},"h2sFAQ":{"title":"Bambu Lab H2S - FAQ"},"h2c":{"warming":{"title":"Bambu Lab H2C: Uncompromising Multi-Material, Multi-Color 3D Printing","description":"Purge-saving. Multi-material. Multi-color. Powered by Vortek. See you on November 18."},"index":{"title":"Bambu Lab H2C: Uncompromising Multi-Material, Multi-Color 3D Printing","description":"Discover Bambu Lab H2C, a tool-changer 3D printer for purge-saving, automatic multi-material and multi-color printing with the Vortek System—fast, precise, and reliable."},"techSpecs":{"title":"Bambu Lab H2C - Technical Specifications","description":"Tech Specs for H2C \u0026 corresponding add-on modules"},"FAQ":{"title":"Bambu Lab H2C - FAQ"},"showcase":{"title":"Bambu Lab H2C Showcase: Multi-Material, Multi-Color 3D Printing in Action","desc":"See vivid multi-material, multi-color 3D models that demonstrate the full capabilities of your next 3D printing projects."}},"h2d":{"title":"Bambu Lab H2D|3D Printer|Laser Engrave Cut|Plotting All-in-one","description":"Bambu Lab H2D reimaging Personal Manufacturing, brings All-in-one capabilities(3D printing, Laser, Plotting) to your home studio"},"h2dTechSpecs":{"title":"Bambu Lab H2D - Technical Specifications","description":"Tech Specs for H2D \u0026 corresponding add-on modules"},"h2dFAQ":{"title":"Bambu Lab H2D - FAQ"},"h2dPro":{"title":"Bambu Lab H2D Pro|3D Printer","description":"Professional Dual-Nozzle 3D Printing Solution"},"h2dProTechSpecs":{"title":"Bambu Lab H2D Pro - Technical Specifications","description":"Tech Specs for H2D Pro \u0026 corresponding add-on modules"},"h2dProFAQ":{"title":"Bambu Lab H2D Pro - FAQ"},"warming":{"title":"Bambu Lab | Rethink Personal Manufacturing | March.25th"},"series":{"h2":{"title":"Bambu Lab H2 Series: 4-in-1 3D Printer, Laser Engraver, Cutter \u0026 Pen Plotter","desc":"Discover H2D, H2S, and the latest H2C for multi-color 3D printing, laser engraving, digital cutting, and pen plotting. Unlock versatile projects across all functions."}},"p2s":{"index":{"title":"Bambu Lab P2S: Reliable Multi-filament 3D Printing Made Simple","description":"Meet the all-new P2S 3D printer, redesigned with smarter control, stronger performance, and multi-material, multi-color freedom. Reliable 3D printing made future-proof."},"techSpecs":{"title":"Bambu Lab P2S - Technical Specifications","description":"Tech Specs for P2S \u0026 corresponding add-on modules"},"FAQ":{"title":"Bambu Lab P2S - FAQ"},"showcase":{"title":"Bambu Lab P2S Showcase | Meticulous Engineering, Quality Printing","desc":"See the Bambu Lab P2S up close in our showcase—fine-tuned design details and flawless 3D prints that inspire confidence in your next creation."}},"x2d":{"index":{"title":"Bambu Lab X2D: Affordable Dual Extruder 3D Printer for Easy Support Removal","description":"Meet Bambu Lab X2D, the best-value dual extruder 3D printer. Featuring an auxiliary nozzle for easy-to-remove supports, efficient multi-color and multi-material printing, and the Bambu experience."},"techSpecs":{"title":"Bambu Lab X2D - Technical Specifications","description":"Tech Specs for X2D \u0026 corresponding add-on modules"},"FAQ":{"title":"Bambu Lab X2D - FAQ"},"showcase":{"title":"Bambu Lab X2D Showcase: Inside the Dual - Extruder System","desc":"See every detail of the Bambu Lab X2D up close. Explore its printing performance and discover how the dual‑extruder system, Bambu Studio, and MakerWorld work together to elevate FDM 3D printing."}},"a2l":{"index":{"title":"Bambu Lab A2L: Affordable Large-format 3D Printer for Beginners","description":"Meet Bambu Lab A2L, an easy-to-use large-format 3D printer with CoreXY-level stability. Multi-color, blade cutting \u0026 pen plotting—creativity beyond 3D printing."},"techSpecs":{"title":"Bambu Lab A2L - Technical Specifications","description":"Tech Specs for A2L \u0026 corresponding add-on modules"},"FAQ":{"title":"Bambu Lab A2L - FAQ"}},"r1":{"index":{"title":"Bambu Lab R1: 55W Desktop CO2 Laser Cutter and Engraver","description":"Bambu Lab R1 is a 55W desktop CO2 laser cutter and engraver. Pro-level precision, ease of use. Cut and engrave wood, acrylic and more at unbeatable price."},"techSpecs":{"title":"Bambu Lab R1 - Technical Specifications","description":"Tech Specs for R1 \u0026 corresponding add-on modules"},"FAQ":{"title":"Bambu Lab R1 - FAQ"},"warming":{"title":"Bambu Lab R1 CO2 Laser Engraver \u0026 Cutter: Big job. Light work.","description":"Meet Bambu Lab R1, our first CO2 laser engraver and cutter. From 3D printing to laser, we make it easier to create with more materials. Coming September 22.","description-AU-JP":"Meet Bambu Lab R1, our first CO2 laser engraver and cutter. From 3D printing to laser, we make it easier to create with more materials. Coming September 23.","description-KR-BR-MX":"Meet Bambu Lab R1, our first CO2 laser engraver and cutter. From 3D printing to laser, we make it easier to create with more materials. Coming soon."}},"compare":{"title":"Compare all 3D printers","description":"Compare features and technical specifica