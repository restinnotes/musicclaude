.cn/media/Odin/images/Category/icon_18_35inch.svg","https://www.asus.com.cn/media/Odin/images/Category/icon_18_35inch_a.svg",[992,996],{"ImageLink":993,"Link":994,"LinkTarget":12,"Title":995,"NewsFlag":12},"https://dlcdnwebimgs.asus.com.cn/gain/d7bffbed-bbd3-405b-8505-e7da5e415efa/w185","https://www.asus.com.cn/displays-desktops/monitors/tuf-gaming/tuf-gaming-vg27uqel5a/","TUF GAMING VG27UQEL5A",{"ImageLink":997,"Link":998,"LinkTarget":12,"Title":999,"NewsFlag":12},"https://dlcdnwebimgs.asus.com.cn/gain/f7d07ea1-b937-42d7-bd7c-20d7454ab53c/w185","https://www.asus.com.cn/displays-desktops/monitors/tuf-gaming/tuf-gaming-vg259qmr5a/","TUF GAMING VG259QMR5A",{"IsShowVolumePurchase":8,"VolumePurchaseText":302,"VolumePurchaseLink":1001},"https://www.connect.asus.com/cn/VolumePurchase_ProductCard?productCategory=Displays-Desktops",{"Wording":12,"Icon":12,"hoverIcon":12,"Link":12},{"Name":1004,"WebPath":1005,"Link":1006,"CustomizeLink":1006,"LinkTarget":12,"PDLevel3":1007,"HotProducts":1022,"VolumePurchase":1023,"ACCYFinder":1024},"眼镜","Glasses","https://www.asus.com.cn/displays-desktops/glasses/all-series/",{"SeriesName":269,"Series":1008,"CategoryName":1020,"Category":1021},[1009,1011,1016],{"Name":436,"WebPath":1010,"Link":1006,"LinkTarget":12,"Desc":12,"CustomizeLink":1006,"UseLink":8,"Tooltip":12},"All-Series",{"Name":1012,"WebPath":1013,"Link":1014,"LinkTarget":12,"Desc":1015,"CustomizeLink":1014,"UseLink":8,"Tooltip":12},"AirVision  ","AirVision","https://www.asus.com.cn/displays-desktops/glasses/airvision/","智能眼镜改变了我们与技术和周围世界互动的方式。提供身临其境的体验，改善您的日常生活和工作。\n ",{"Name":1017,"WebPath":721,"Link":1018,"LinkTarget":12,"Desc":1019,"CustomizeLink":1018,"UseLink":8,"Tooltip":12},"ROG - 玩家国度","https://www.asus.com.cn/displays-desktops/glasses/rog-republic-of-gamers/","ROG 玩家国度十余年来深耕前沿显示创新技术，凭借过硬实力广受全球游戏爱好者青睐。这款新一代 AR 眼镜提供出色的使用体验，搭载多项突破性技术，重新定义沉浸式游戏体验。","按用途",[],[],{"IsShowVolumePurchase":8,"VolumePurchaseText":302,"VolumePurchaseLink":1001},{"Wording":12,"Icon":12,"hoverIcon":12,"Link":12},{"Name":1026,"WebPath":1027,"Link":1028,"CustomizeLink":1028,"LinkTarget":12,"PDLevel3":1029,"HotProducts":1053,"VolumePurchase":1062,"ACCYFinder":1063},"投影仪","Projectors","https://www.asus.com.cn/displays-desktops/projectors/all-series/",{"SeriesName":269,"Series":1030,"CategoryName":1020,"Category":1052},[1031,1032,1037,1042,1048],{"Name":436,"WebPath":288,"Link":1028,"LinkTarget":39,"Desc":12,"CustomizeLink":1028,"UseLink":8,"Tooltip":12},{"Name":1033,"WebPath":451,"Link":1034,"LinkTarget":39,"Desc":1035,"CustomizeLink":1034,"UseLink":8,"Tooltip":1036},"ProArt 系列","https://www.asus.com.cn/displays-desktops/projectors/proart/","ASUS ProArt 投影仪系列旨在为创意专业人士提供生动和逼真的视觉效果。ProArt 投影仪具有先进的色彩准确度、出厂预校准、广色域和广泛的连接性，是工作室、画廊即博物馆的理想之选。","准确色彩",{"Name":918,"WebPath":1038,"Link":1039,"LinkTarget":39,"Desc":1040,"CustomizeLink":1039,"UseLink":8,"Tooltip":1041},"Portable","https://www.asus.com.cn/displays-desktops/projectors/portable/","轻巧的华硕便携式投影仪，专为差旅人士设计，适合各种场景。可轻松放入公文包中，以便在会议室中进行简报，在家享受剧院级影像。特定的型号还配备内置电池，可长时间使用无线网络。","轻薄",{"Name":1043,"WebPath":1044,"Link":1045,"LinkTarget":39,"Desc":1046,"CustomizeLink":1045,"UseLink":8,"Tooltip":1047},"娱乐系列","Entertainment","https://www.asus.com.cn/displays-desktops/projectors/entertainment/","华硕娱乐投影机可提供令人沉浸其中的游戏及影片观看体验。它们可提供明亮生动的高分辨率的投影，其超短焦镜头实时在较近的投影距离内，也能确保投射大尺寸的影像。选择具备 Harmon Kardon 认证音效的机型以享受纯净的音质。","高亮度",{"Name":936,"WebPath":937,"Link":1049,"LinkTarget":39,"Desc":1050,"CustomizeLink":1049,"UseLink":8,"Tooltip":1051},"https://www.asus.com.cn/displays-desktops/projectors/business/","华硕商用投影仪专为教育和企业应用而设计。 易于设置、直观的 LAN 管理和全面的显示功能使其成为会议室、演讲厅和小型办公室的理想选择。","商用",[],[1054,1058],{"ImageLink":1055,"Link":1056,"LinkTarget":12,"Title":1057,"NewsFlag":12},"https://dlcdnwebimgs.asus.com.cn/gain/2a4214c9-7f90-4a81-9f09-a503450d0bdd/w185","https://www.asus.com.cn/displays-desktops/projectors/proart/proart-projector-a1/","ProArt Projector A1",{"ImageLink":1059,"Link":1060,"LinkTarget":12,"Title":1061,"NewsFlag":12},"https://dlcdnwebimgs.asus.com.cn/gain/f763cc24-0631-428c-bd20-5763dda842dc/w185","https://www.asus.com.cn/displays-desktops/projectors/portable/zenbeam-e2/","ZenBeam E2",{"IsShowVolumePurchase":8,"VolumePurchaseText":302,"VolumePurchaseLink":1001},{"Wording":12,"Icon":12,"hoverIcon":12,"Link":12},{"Name":1065,"WebPath":1066,"Link":1067,"CustomizeLink":1067,"LinkTarget":12,"PDLevel3":1068,"HotProducts":1084,"VolumePurchase":1093,"ACCYFinder":1094},"一体电脑","All-in-One-PCs","https://www.asus.com.cn/displays-desktops/all-in-one-pcs/all-series/",{"SeriesName":269,"Series":1069,"CategoryName":1020,"Category":1083},[1070,1071,1077],{"Name":436,"WebPath":288,"Link":1067,"LinkTarget":39,"Desc":12,"CustomizeLink":1067,"UseLink":8,"Tooltip":12},{"Name":1072,"WebPath":1073,"Link":1074,"LinkTarget":39,"Desc":1075,"CustomizeLink":1074,"UseLink":8,"Tooltip":1076},"华硕破晓系列","ASUS-AiO","https://www.asus.com.cn/displays-desktops/all-in-one-pcs/asus-aio/","华硕破晓系列是精雕细琢的工艺杰作，其灵感源自于禅 (Zen) 的精神。它结合纯铝合金的单纯性与先进技术的复杂性，为您的住家带来永恒而实用的美感。","时尚美型",{"Name":1078,"WebPath":1079,"Link":1080,"LinkTarget":39,"Desc":1081,"CustomizeLink":1080,"UseLink":8,"Tooltip":1082},"华硕弘道系列","ExpertCenter-AiO","https://www.asus.com.cn/displays-desktops/all-in-one-pcs/expertcenter-aio/","商用一体电脑","高效商务",[],[1085,1089],{"ImageLink":1086,"Link":1087,"LinkTarget":12,"Title":1088,"NewsFlag":12},"https://dlcdnwebimgs.asus.com.cn/gain/0d18d7cb-e82b-4b4a-b9cc-96e695d8e04e/w185","https://www.asus.com.cn/displays-desktops/all-in-one-pcs/asus-aio/asus-v400-aio-v440va/","华硕破晓 V440VA",{"ImageLink":1090,"Link":1091,"LinkTarget":12,"Title":1092,"NewsFlag":12},"https://dlcdnwebimgs.asus.com.cn/gain/a4d6e728-c26d-4ffc-93d1-e0179a6df553/w185","https://www.asus.com.cn/displays-desktops/all-in-one-pcs/asus-aio/asus-v400-aio-v470va/","华硕破晓 V470VA",{"IsShowVolumePurchase":8,"VolumePurchaseText":302,"VolumePurchaseLink":1001},{"Wording":12,"Icon":12,"hoverIcon":12,"Link":12},{"Name":1096,"WebPath":1097,"Link":1098,"CustomizeLink":1098,"LinkTarget":12,"PDLevel3":1099,