        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可眼前少了那种自然的支撑，他更清楚自己只能靠自己把分寸守住",
