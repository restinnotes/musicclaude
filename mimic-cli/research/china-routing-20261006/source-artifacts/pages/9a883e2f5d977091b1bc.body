<script defer>
    function emptyCart() {
        $('#removeCartPopup').modal('show');
    }
    function removeCart() {
        fetch('https://www.expertmarketresearch.com/cart/clear_cart')
            .then(response => response.json())
            .then(data => {
                if (data.status === 'success') {
                                            location.reload();
                    
                } else {
                    console.error('Failed to clear cart');
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
    }
</script>

