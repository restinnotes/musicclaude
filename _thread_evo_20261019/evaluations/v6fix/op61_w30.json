  "S03": {
   "edit": {
    "items": [
     {
      "id": "S03-1",
      "text": "那些珍贵的东西总把他的心思牵回去，让他拿不准该往哪使劲，心里恼火又不甘。",
      "key": "拿不准该往哪使劲",
      "follows": true,
      "causes": [
       "c1"
      ]
     },
     {
      "id": "S03-2",
      "text": "他想要自在亲近、不必时时防备的生活，想到它便暂时不再追问为何用力，可轻松退去后，眼前的难处仍没答案，他又怀疑刚才那股劲是不是真心。",
      "key": "自在亲近",
      "follows": true,
      "causes": [
       "c2"
      ]
     }
    ],
    "because": [
     {
      "from": "S02-2",
      "to": "S03-1",
      "rel": "限制"
     },
     {
      "from": "S02-3",
      "to": "S03-1",
