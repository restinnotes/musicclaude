      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "没在想",
    "items": [
     {
      "id": "S08-1",
      "text": "熟悉的柔软和安静短暂回来，心里那点期盼也重新有了位置，他被这份温和占住了一会儿。",
      "key": "熟悉的柔软和安静",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-3"
      ]
     },
     {
      "id": "S08-2",
      "text": "那点温柔很快又淡下去，留下不舍；紧绷也松开片刻，却没有真正安定下来。",
      "key": "那点温柔很快又淡",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1",
       "S07-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S07-3",
      "to": "S08-1",
      "rel": "引用"
     },
     {
      "from": "S08-1",
