     ],
     "pt": "",
     "bars": "182附近"
    },
    {
     "text": "带马祖卡色彩的舞步突然闯入，先前的波兰舞曲姿态也不再完整",
     "from": [
      "S07-B2",
      "S07-B5"
     ],
     "pt": "",
     "bars": "182-197"
    },
