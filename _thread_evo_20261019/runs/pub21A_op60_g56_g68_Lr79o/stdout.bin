{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"连自己也有点意外\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"关系会改变\"\n        },\n        {\n          \"quote\": \"刚刚踏上船板的感觉，还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现自己很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"忽然发现\"\n        },\n        {\n          \"text\": \"他怕显得太需要\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕显得太需要\"\n        },\n        {\n          \"text\": \"这点亲近已让他觉得甜\",\n          \"point\": \"下次还敢更坦白吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这点亲近已让他觉得甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"对方偶尔望来一眼，沉默也不让人紧张\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"温柔托着\"\n        },\n        {\n          \"quote\": \"因为太喜欢眼前的东西\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"太喜欢才舍不得\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"