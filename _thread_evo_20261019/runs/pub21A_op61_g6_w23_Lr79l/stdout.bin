n\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"正因太好才刺痛\"\n        },\n        {\n          \"quote\": \"表面上动作越来越多，实际上并没有真正抵达哪里；不停地往前赶，只是为了避免停下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起那些亲近的时候\",\n          \"point\": \"真盼着一切还能照从前那样继续\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"有一阵真盼着\"\n        },\n        {\n          \"text\": \"可这么盼着\",\n          \"point\": \"怀疑当初是不是走错了\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"这么盼着，却怎么也想不出\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"柔和的歌唱并没有抹掉向前的劲\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"柔和，却仍向前\"\n        },\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍不服气\",\n          \"point\": \"连过去开心的事都不敢多想，也太为难自己了\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"仍不服气，可\"\n        },\n        {\n          \"text\": \"跟自己争得没了力气\",\n          \"point\": \"想到自己如今已不在那些人身边，只觉得难受\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"跟自己争得没了力气，那股不服气也渐渐淡了\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"没有许诺回应\"\n        },\n        {\n          \"quote\": \"明知有些事已经挽不回，便放轻声音，好好看着它。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"挽不回也好好看着\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"心里那阵难受慢慢缓下来\",\n          \"point\": \"没急着拿受过的气压住这份想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这回没急着\"\n        },\n        {\n          \"text\": \"离开以后，遇上难熬的事\",\n          \"point\": \"从前有人在身边能让自己轻松多少\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"常常只能自己挺过去\"\n        },\n        {\n          \"text\": \"他很想再过上那种\",\n          \"point\": \"不用多说也知道彼此亲近的日子\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"又怕以后再也没有了\"\n        },\n        {\n          \"text\": \"不过，那样的日子自己毕竟\",\n          \"point\": \"光是这么想着，他心里也暖和了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"毕竟真真切切过过\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"后颈一凉，脉搏也剧烈跳动。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"新出现的舞步可以很鲜明，内心却未必因此安定下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"舞步鲜明，心里未安\"\n        },\n        {\n          \"quote\": \"这样的亲切感未必安慰人；恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"刚有点安心\",\n          \"point\": \"要还