{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他终于离开了",
     "accent": "",
     "emotion": "安心",
     "from": [
      "S01-1"
     ],
     "at": 0
    },
    {
     "text": "起初觉得不用再委屈自己",
     "accent": "不用再委屈",
     "emotion": "安心",
     "from": [
      "S01-1",
      "S01-B2"
     ],
     "at": 8
    },
    {
     "text": "可心里很快空落落的",
     "accent": "",
     "emotion": "孤单",
     "from": [
      "S01-2"
     ],
     "at": 32
    },
    {
     "text": "一时说不清舍不得什么",
     "accent": "",
     "emotion": "悬着",
     "from": [
      "S01-2",
      "S01-B3"
     ],
     "at": 48
    },
    {
     "text": "他想往前却不知靠什么安稳",
     "accent": "不知靠什么安稳",
     "emotion": "悬着",
     "from": [
      "S01-3"
     ],
     "at": 75
    }
   ],
   "small": [
    {
     "text": "我不能倒下可我想停下来",
     "after": 1,
     "from": [
      "S01-B2"
     ],
     "bars": "1–23",
     "at": 8
    },
    {
     "text": "怒意遗憾和怀念还分不清",
     "after": 3,
     "from": [
      "S01-B3"
     ],
     "bars": "1–23",
     "at": 48
    },
    {
     "text": "像刚从漫长昏沉中醒来",
     "after": 2,
     "from": [
      "S01-B4"
     ],
     "bars": "1–23",
     "at": 32
    },
    {
     "text": "四周冷空胸口发紧视线模糊",
     "after": 2,
     "from": [
      "S01-B4"
     ],
     "bars": "1–23",
     "at": 32
    },
    {
     "text": "伸出颤抖的手只摸到虚空",
     "after": 2,
     "from": [
      "S01-B4"
     ],
     "bars": "1–23",
     "at": 32
    },
    {
     "text": "旧日声光回来却仍回不到眼前",
     "after": 4,
     "from": [
      "S01-B5"
     ],
     "bars": "9–17",
     "at": 75
    }
   ],
   "notes": [
    {
     "text": "开头那一下声音沉重又郑重",
     "from": [
      "S01-B1"
     ],
     "bars": "1–6"
    },
    {
     "text": "琶音像烟雾一样散向高处",
     "from": [
      "S01-B1"
     ],
     "bars": "1–6"
    },
    {
     "text": "停顿里像还在等一个回声",
     "from": [
      "S01-B1"
     ],
     "bars": "1–6"
    },
    {
     "text": "短句像叹息刚冒出就被截断",
     "from": [
      "S01-B3"
     ],
     "bars": "1–23"
    },
    {
     "text": "余音在冷空气里慢慢散尽",
     "from": [
      "S01-B3"
     ],
     "bars": "1–23"
    },
    {
     "text": "熟悉的旋律轮廓渐渐清楚",
     "from": [
      "S01-B5"
     ],
     "bars": "9–17"
    },
    {
     "text": "舞步一点点浮出来像身体记起迈步",
     "from": [
      "S01-B5"
     ],
     "bars": "18–23"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "他舍不得从前的自在日子",
     "accent": "舍不得",
     "emotion": "亲密",
     "from": [
      "S02-1",
      "S02-B1"
     ],
     "at": 0
    },
    {
     "text": "想到以后不能那样过",
     "accent": "",
     "emotion": "孤单",
     "from": [
      "S02-1"
     ],
     "at": 10
    },
    {
     "text": "他心里发慌却不肯沉进悲伤",
     "accent": "不肯沉进悲伤",
     "emotion": "不安",
     "from": [
      "S02-1",
      "S02-B4"
     ],
     "at": 20
    },
    {
     "text": "他提醒自己受过的气",
     "accent": "受过的气",
     "emotion": "炽热",
     "from": [
      "S02-2",
      "S02-B4"
     ],
     "at": 35
    },
    {
     "text": "好日子也得一起丢掉吗？",
     "accent": "也得一起丢掉吗",
     "emotion": "悬着",
     "from": [
      "S02-3",
      "S02-B5"
     ],
     "at": 56
    }
   ],
   "small": [
    {
     "text": "珍惜的东西仿佛还在却难拥有",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "24–65",
     "at": 0
    },
    {
     "text": "他整理衣服抬头藏起动摇",
     "after": 2,
     "from": [
      "S02-B4"
     ],
     "bars": "24–65",
     "at": 20
    },
    {
     "text": "第一遍还信第二遍开始劝自己",
     "after": 2,
     "from": [
      "S02-B4"
     ],
     "bars": "44–65",
     "at": 35
    },
    {
     "text": "说到第三遍才露出在意",
     "after": 2,
     "from": [
      "S02-B4"
     ],
     "bars": "44–65",
     "at": 35
    },
    {
     "text": "不甘心就这样消亡",
     "after": 4,
     "from": [
      "S02-B5"
     ],
     "bars": "44–65",
     "at": 56
    },
    {
     "text": "怕一心软就忘了当初为何离开",
     "after": 3,
     "from": [
      "S02-2"
     ],
     "bars": "",
     "at": 35
    }
   ],
   "notes": [
    {
     "text": "庄严的舞步带着面向众人的气势",
     "from": [
      "S02-B1"
     ],
     "bars": "24–65"
    },
    {
     "text": "旋律像远处旧歌只能哼出几句",
     "from": [
      "S02-B1"
     ],
     "bars": "24–65"
    },
    {
     "text": "听来没有英雄凯旋的痛快劲",
     "from": [
      "S02-B1"
     ],
     "bars": "24–65"
    },
    {
     "text": "舞步不像士兵更像腿脚虚浮地挪动",
     "from": [
      "S02-B2"
     ],
     "bars": "24–65"
    },
    {
     "text": "底下细碎不安的声音一直在动",
     "from": [
      "S02-B2"
     ],
     "bars": "24–65"
    },
    {
     "text": "旋律猛地往上推又退回来",
     "from": [
      "S02-B3"
     ],
     "bars": "38–43"
    },
    {
     "text": "后半段力量聚拢却始终没落稳",
     "from": [
      "S02-B3"
     ],
     "bars": "44–65"
    },
    {
     "text": "连绵快速的音流把呼吸催得更急",
     "from": [
      "S02-B3"
     ],
     "bars": "56–65"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他心里还憋着一股气",
     "accent": "憋着一股气",
     "emotion": "炽热",
     "from": [
      "S03-1",
      "S03-B1"
     ],
     "at": 0
    },
    {
     "text": "想起曾被当作自己人",
     "accent": "自己人",
     "emotion": "亲密",
     "from": [
      "S03-1",
      "S03-B2"
     ],
     "at": 4
    },
    {
     "text": "他竟高兴了一小会儿",
     "accent": "高兴",
     "emotion": "欢喜",
     "from": [
      "S03-1",
      "S03-B2"
     ],
     "at": 8
    },
    {
     "text": "可那点高兴很快变酸",
     "accent": "变酸",
     "emotion": "悬着",
     "from": [
      "S03-2",
      "S03-B2",
      "S03-B5"
     ],
     "at": 15
    },
    {
     "text": "从前回不去离开后会更好吗？",
     "accent": "会更好吗",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ],
     "at": 25
    }
   ],
   "small": [
    {
     "text": "像故乡夏日麦浪和微风",
     "after": 2,
     "from": [
      "S03-B2"
     ],
     "bars": "80–91",
     "at": 15
    },
    {
     "text": "那时亲近得不用时时防备",
     "after": 2,
     "from": [
      "S03-B2"
     ],
     "bars": "80–91",
     "at": 15
    },
    {
     "text": "像聊点别的暂时离开伤口",
     "after": 3,
     "from": [
      "S03-B3"
     ],
     "bars": "66–91",
     "at": 15
    },
    {
     "text": "那一刻的轻松是真的却没答案",
     "after": 3,
     "from": [
      "S03-B3"
     ],
     "bars": "66–91",
     "at": 15
    },
    {
     "text": "昂扬退下去他问自己真信了吗",
     "after": 3,
     "from": [
      "S03-B5"
     ],
     "bars": "66–91",
     "at": 25
    }
   ],
   "notes": [
    {
     "text": "若那一下格外突出会像重锤砸下",
     "from": [
      "S03-B1"
     ],
     "bars": "66"
    },
    {
     "text": "忽强忽弱的起伏让心里一悬",
     "from": [
      "S03-B1"
     ],
     "bars": "66–91"
    },
    {
     "text": "端正步态忽然变得流动不安",
     "from": [
      "S03-B1"
     ],
     "bars": "66–91"
    },
    {
     "text": "前半焦躁后半忽然柔和轻盈",
     "from": [
      "S03-B2"
     ],
     "bars": "66–79；80–91"
    },
    {
     "text": "几个人像在耳边低声絮语",
     "from": [
      "S03-B4"
     ],
     "bars": "66–91"
    },
    {
     "text": "听感重心像流沙一样四处漂移",
     "from": [
      "S03-B4"
     ],
     "bars": "66–91"
    },
    {
     "text": "流动含蓄下来像昂扬慢慢退潮",
     "from": [
      "S03-B5"
     ],
     "bars": "66–91"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "想起从前亲近的日子",
     "accent": "亲近",
     "emotion": "亲密",
     "from": [
      "S04-1",
      "S04-B1"
     ],
     "at": 0
    },
    {
     "text": "他真盼着还能那样相处",
     "accent": "真盼着",
     "emotion": "欢喜",
     "from": [
      "S04-1",
      "S04-B1"
     ],
     "at": 6
    },
    {
     "text": "可旧委屈也跟着翻上来",
     "accent": "旧委屈",
     "emotion": "不安",
     "from": [
      "S04-2",
      "S04-B2"
     ],
     "at": 12
    },
    {
     "text": "他开始问那一步走对了吗？",
     "accent": "走对了吗",
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ],
     "at": 21
    },
    {
     "text": "没走的话如今又会怎样？",
     "accent": "又会怎样",
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ],
     "at": 31
    }
   ],
   "small": [
    {
     "text": "感激亲密和短暂幸福又鲜活",
     "after": 1,
     "from": [
      "S04-B1"
     ],
     "bars": "92–107",
     "at": 6
    },
    {
     "text": "那份坚定也许只是他想成为的样子",
     "after": 1,
     "from": [
      "S04-B1"
     ],
     "bars": "92–115",
     "at": 6
    },
    {
     "text": "记忆太好反而刺痛他让抵抗也疲惫",
     "after": 2,
     "from": [
      "S04-B2"
     ],
     "bars": "108–115",
     "at": 12
    },
    {
     "text": "像急促脚步和乱拍心跳",
     "after": 2,
     "from": [
      "S04-B3"
     ],
     "bars": "92–115",
     "at": 12
    },
    {
     "text": "他反复问如果当时换个做法呢",
     "after": 3,
     "from": [
      "S04-B4"
     ],
     "bars": "94–115",
     "at": 21
    },
    {
     "text": "他还在问究竟为什么会这样",
     "after": 4,
     "from": [
      "S04-B4"
     ],
     "bars": "94–115",
     "at": 31
    }
   ],
   "notes": [
    {
     "text": "旋律变得柔软像在独自说话",
     "from": [
      "S04-B1"
     ],
     "bars": "92–107"
    },
    {
     "text": "向下的声音像撕扯着步步后退",
     "from": [
      "S04-B2"
     ],
     "bars": "108–115"
    },
    {
     "text": "低沉的声音一路追赶急促音流",
     "from": [
      "S04-B3"
     ],
     "bars": "92–115"
    },
    {
     "text": "急促的声音一路往前赶却没抵达",
     "from": [
      "S04-B4"
     ],
     "bars": "94–115"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "他仍觉得那些气不该忍",
     "accent": "不该忍",
     "emotion": "炽热",
     "from": [
      "S05-1",
      "S05-B2"
     ],
     "at": 0
    },
    {
     "text": "可连开心的旧事都不敢多想",
     "accent": "不敢多想",
     "emotion": "不安",
     "from": [
      "S05-1"
     ],
     "at": 12
    },
    {
     "text": "跟自己争得渐渐没了力气",
     "accent": "没了力气",
     "emotion": "孤单",
     "from": [
      "S05-2",
      "S05-B5"
     ],
     "at": 24
    },
    {
     "text": "那股不服气也慢慢淡了",
     "accent": "慢慢淡了",
     "emotion": "悬着",
     "from": [
      "S05-2"
     ],
     "at": 38
    },
    {
     "text": "想到不在他们身边他很难受",
     "accent": "很难受",
     "emotion": "孤单",
     "from": [
      "S05-2",
      "S05-B3"
     ],
     "at": 52
    }
   ],
   "small": [
    {
     "text": "连开心的事都不敢想太为难自己",
     "after": 1,
     "from": [
      "S05-1"
     ],
     "bars": "",
     "at": 12
    },
    {
     "text": "这件事不能就这样算了",
     "after": 0,
     "from": [
      "S05-B2"
     ],
     "bars": "116–127",
     "at": 0
    },
    {
     "text": "愤怒悲伤里还想护住自己",
     "after": 0,
     "from": [
      "S05-B2"
     ],
     "bars": "116–127",
     "at": 0
    },
    {
     "text": "旧日记忆重新有了温度",
     "after": 4,
     "from": [
      "S05-B3"
     ],
     "bars": "116–147",
     "at": 52
    },
    {
     "text": "可能是某个人也可能是故乡或旧生活",
     "after": 4,
     "from": [
      "S05-B3"
     ],
     "bars": "116–147",
     "at": 52
    },
    {
     "text": "松动不是想通只是抵抗累了",
     "after": 3,
     "from": [
      "S05-B5"
     ],
     "bars": "132–147",
     "at": 38
    }
   ],
   "notes": [
    {
     "text": "两道声音像夜色里低声说话",
     "from": [
      "S05-B1"
     ],
     "bars": "116–147"
    },
    {
     "text": "快速音流渐渐放慢变稀最后疏落",
     "from": [
      "S05-B4"
     ],
     "bars": "128–147"
    },
    {
     "text": "旋律忽然单独露出来像地板消失",
     "from": [
      "S05-B4"
     ],
     "bars": "128–147"
    },
    {
     "text": "后段躁动和不安又渐渐加深",
     "from": [
      "S05-B5"
     ],
     "bars": "132–147"
    },
    {
     "text": "疏落的声音像几次深深呼吸",
     "from": [
      "S05-B5"
     ],
     "bars": "144–147"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "难受缓下来他没再压住想念",
     "accent": "没再压住想念",
     "emotion": "安心",
     "from": [
      "S06-1"
     ],
     "at": 0
    },
    {
     "text": "身边没人他才懂陪伴不用防备",
     "accent": "不用防备",
     "emotion": "孤单",
     "from": [
      "S06-1",
      "S06-2"
     ],
     "at": 16
    },
    {
     "text": "他想再有不用多说的亲近",
     "accent": "不用多说的亲近",
     "emotion": "亲密",
     "from": [
      "S06-3"
     ],
     "at": 32
    },
    {
     "text": "可他怕以后再也没有",
     "accent": "再也没有",
     "emotion": "不安",
     "from": [
      "S06-3"
     ],
     "at": 48
    },
    {
     "text": "想起那段日子心里暖一点",
     "accent": "暖一点",
     "emotion": "安心",
     "from": [
      "S06-4"
     ],
     "at": 68
    }
   ],
   "small": [
    {
     "text": "安宁不代表现实变好也不能久留",
     "after": 0,
     "from": [
      "S06-B1"
     ],
     "bars": "148–180",
     "at": 0
    },
    {
     "text": "终于不用解释难过也不用装坚强",
     "after": 1,
     "from": [
      "S06-B2"
     ],
     "bars": "148–180",
     "at": 16
    },
    {
     "text": "压住的愿望委屈和思念浮上来",
     "after": 1,
     "from": [
      "S06-B2"
     ],
     "bars": "148–180",
     "at": 16
    },
    {
     "text": "向遥远对象祈求却未必有回应",
     "after": 3,
     "from": [
      "S06-B2"
     ],
     "bars": "148–180",
     "at": 48
    },
    {
     "text": "远方家园在梦里忽然被照亮",
     "after": 3,
     "from": [
      "S06-B2"
     ],
     "bars": "约160",
     "at": 48
    },
    {
     "text": "想好好看着珍惜的东西不急着抓回",
     "after": 4,
     "from": [
      "S06-B4"
     ],
     "bars": "148–180",
     "at": 68
    }
   ],
   "notes": [
    {
     "text": "绵长安静的声音像隔着透明玻璃",
     "from": [
      "S06-B1"
     ],
     "bars": "148–180"
    },
    {
     "text": "歌声像母亲在耳边轻轻哼唱",
     "from": [
      "S06-B1"
     ],
     "bars": "148–180"
    },
    {
     "text": "庄严的歌声里藏着私下的低语",
     "from": [
      "S06-B2"
     ],
     "bars": "148–180"
    },
    {
     "text": "旋律起初含蓄像在试探",
     "from": [
      "S06-B3"
     ],
     "bars": "148–151"
    },
    {
