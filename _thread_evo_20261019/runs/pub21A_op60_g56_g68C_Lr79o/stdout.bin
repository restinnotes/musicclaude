{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"先向高处迸发，细碎的光点再缓缓飘落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"关系会改变\"\n        },\n        {\n          \"quote\": \"身体有一瞬失重\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现自己很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"忽然\"\n        },\n        {\n          \"text\": \"他怕显得太需要\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"太需要\"\n        },\n        {\n          \"text\": \"这点亲近已让他觉得甜\",\n          \"point\": \"下次还敢更坦白吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还敢\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"可以放弃对重力的控制，把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"水却一直在流，时间也一直在走\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"眼前的好还在，心里却已经有一点鼻酸\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开，仍愿意亲近\",\n          \"point\": \"仍愿意亲近\",\n          \"where\":