          ]\n        },\n        {\n          \"kind\": \"line\",\n          \"text\": \"他仍会舍不得，也仍不知道以后会怎样。\",\n          \"keys\": [\"舍不得\", \"不知道以后会怎样\"],\n          \"from\": [\"S14-2\"]\n        },\n        {\n          \"kind\": \"line\",\n          \"text\": \"但眼下还能亲近，他不再逼自己要一句永远不变的保证。\",\n          \"keys\": [\"眼下还能亲近\", \"不再逼自己\"],\n          \"from\": [\"S14-2\"]\n        },\n        {\n          \"kind\": \"feel\",\n          \"items\": [\n            {\n              \"text\": \"音乐没有像梦一样慢慢飘走\",\n              \"bead\": \"S14-B2\",\n              \"bars\": \"\"\n            },\n            {\n              \"text\": \"最后几下和弦干脆而沉重\",\n              \"bead\": \"S14-B2\",\n              \"bars\": \"\"\n            },\n            {\n              \"text\": \"低音像铁锚落入水底，定住小船\",\n              \"bead\": \"S14-B2\",\n              \"bars\": \"\"\n            }\n          ]\n        },\n        {\n          \"kind\": \"feel\",\n          \"items\": [\n            {\n              \"text\": \"像经历震荡后站起身，整理衣服关上门\",\n              \"bead\": \"S14-B2\",\n              \"bars\": \"\"\n            },\n            {\n              \"text\": \"最后一股浪头，仿佛又猛推了一下\",\n              \"bead\": \"S14-B3\",\n              \"bars\": \"\"\n            },\n            {\n              \"text\": \"进入终结句，音乐才真正松下来\",\n              \"bead\": \"S14-B3\",\n              \"bars\": \"\"\n            }\n          ]\n        },\n        {\n          \"kind\": \"feel\",\n          \"items\": [\n            {\n              \"text\": \"心里仍然温热，身体却慢慢平静\",\n              \"bead\": \"S14-B3\",\n              \"bars\": \"\"\n            },\n            {\n              \"text\": \"像从美梦里醒来，还记得梦里的光\",\n              \"bead\": \"S14-B3\",\n              \"bars\": \"\"\n            }\n          ]\n        },\n        {\n          \"kind\": \"line\",\n          \"text\": \"既然喜欢已经让对方看见，他就不往回藏了。\",\n          \"keys\": [\"已经让对方看见\", \"不往回藏\"],\n          \"from\": [\"S14-3\"]\n        },\n        {\n       