{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他忽然很想靠近",
     "accent": "很想靠近",
     "emotion": "炽热",
     "from": [
      "S01-1"
     ]
    },
    {
     "text": "他怕对方觉得负担太重",
     "accent": "负担太重",
     "emotion": "不安",
     "from": [
      "S01-2"
     ]
    },
    {
     "text": "他只敢露出一点喜欢",
     "accent": "一点喜欢",
     "emotion": "悬着",
     "from": [
      "S01-2"
     ]
    }
   ],
   "small": [
    {
     "text": "这点亲近很甜他还拿不准下次能否坦白",
     "after": 2,
     "from": [
      "S01-3"
     ],
     "bars": ""
    },
    {
     "text": "明知说出口会改变关系便先沉默",
     "after": 1,
     "from": [
      "S01-B2"
     ],
     "bars": "1–3"
    },
    {
     "text": "像刚踏上微晃船板一瞬失重",
     "after": 0,
     "from": [
      "S01-B3"
     ],
     "bars": "1–3"
    }
   ],
   "notes": [
    {
     "text": "两下和弦像夏夜烟花突然迸开",
     "from": [
      "S01-B1"
     ],
     "bars": "1–3"
    },
    {
     "text": "光点缓缓飘落仍悬着摇荡未成形",
     "from": [
      "S01-B1"
     ],
     "bars": "1–3"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "对方没有因他在意退开",
     "accent": "没有退开",
     "emotion": "安心",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "他这才慢慢放松下来",
     "accent": "放松下来",
     "emotion": "安心",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "他想更靠近几乎藏不住喜欢",
     "accent": "藏不住喜欢",
     "emotion": "炽热",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "又怕太急弄坏眼下的自在",
     "accent": "眼下的自在",
     "emotion": "不安",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "他还没分开就先舍不得",
     "accent": "先舍不得",
     "emotion": "悬着",
     "from": [
      "S02-3"
     ]
    }
   ],
   "small": [
    {
     "text": "两道旋律贴得像耳边低语",
     "after": 1,
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "夏末湿热的风裹着皮肤",
     "after": 1,
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "脚下像有心跳和水浪托着",
     "after": 1,
     "from": [
      "S02-B2"
     ],
     "bars": "4–5"
    },
    {
     "text": "船上舒服地漂着水和时间仍往前",
     "after": 4,
     "from": [
      "S02-B2"
     ],
     "bars": "4–16"
    },
    {
     "text": "柔软落音像甜蜜确认又有点鼻酸",
     "after": 4,
     "from": [
      "S02-B4"
     ],
     "bars": "约7–11"
    }
   ],
   "notes": [
    {
     "text": "两条旋律贴近交织",
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "歌声未浮出左手已一下一下摇动",
     "from": [
      "S02-B2"
     ],
     "bars": "4–5"
    },
    {
     "text": "歌声忽然上涌又轻轻呼出一口气",
     "from": [
      "S02-B3"
     ],
     "bars": "12–16"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他难得不去想以后",
     "accent": "不去想以后",
     "emotion": "安心",
     "from": [
      "S03-1"
     ]
    },
    {
     "text": "只想舒服地待在亲近里",
     "accent": "舒服地待着",
     "emotion": "亲密",
     "from": [
      "S03-1"
     ]
    },
    {
     "text": "他想说自己有多喜欢",
     "accent": "有多喜欢",
     "emotion": "炽热",
     "from": [
      "S03-2"
     ]
    },
    {
     "text": "也想问对方是否也喜欢这样",
     "accent": "是否也喜欢",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ]
    },
    {
     "text": "没想好怎么开口念头就淡了",
     "accent": "念头就淡了",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ]
    }
   ],
   "small": [
    {
     "text": "说完重要的话还沉浸着沉默也舒服",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23"
    },
    {
     "text": "身体还在这里心却慢慢漂远",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23"
    },
    {
     "text": "急切念头只在水面露一下头",
     "after": 2,
     "from": [
      "S03-B2"
     ],
     "bars": "约20–21"
    },
    {
     "text": "水波像被暗流拖住声音悬在半途",
     "after": 1,
     "from": [
      "S03-B3"
     ],
     "bars": "约20–22"
    },
    {
     "text": "风吹碎的倒影难拼也像谈话遇心结",
     "after": 3,
     "from": [
      "S03-B3"
     ],
     "bars": "17–23"
    }
   ],
   "notes": [
    {
     "text": "摇荡中忽然冒出几句短促声音",
     "from": [
      "S03-B2"
     ],
     "bars": "约20–21"
    },
    {
     "text": "流动像被暗流拖住有些声音悬着",
     "from": [
      "S03-B3"
     ],
     "bars": "约20–22"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "熟悉的亲近又让他欢喜",
     "accent": "又让他欢喜",
     "emotion": "欢喜",
     "from": [
      "S04-1"
     ]
    },
    {
     "text": "他想起上回有话没说",
     "accent": "有话没说",
     "emotion": "悬着",
     "from": [
      "S04-1"
     ]
    },
    {
     "text": "这回他几乎想把话全说出",
     "accent": "全说出",
     "emotion": "炽热",
     "from": [
      "S04-2"
     ]
    },
    {
     "text": "他盼对方喜欢坦白的自己",
     "accent": "坦白的自己",
     "emotion": "欢喜",
     "from": [
      "S04-2"
     ]
    },
    {
     "text": "他怕说太多最后还是收住",
     "accent": "最后还是收住",
     "emotion": "不安",
     "from": [
      "S04-3"
     ]
    }
   ],
   "small": [
    {
     "text": "说出来也许能把好时光留久些",
     "after": 3,
     "from": [
      "S04-3"
     ],
     "bars": ""
    },
    {
     "text": "怕让对方为难连原有自在也会丢",
     "after": 4,
     "from": [
      "S04-3"
     ],
     "bars": ""
    },
    {
     "text": "原本轻握的手不知不觉握得更紧",
     "after": 4,
     "from": [
      "S04-B3"
     ],
     "bars": "24–34"
    },
    {
     "text": "越想抱紧对方船身越颠簸",
     "after": 4,
     "from": [
      "S04-B3"
     ],
     "bars": "24–34"
    },
    {
     "text": "还没失去就已舍不得鼻酸",
     "after": 0,
     "from": [
      "S04-B4"
     ],
     "bars": "24–34"
    },
    {
     "text": "话越说越快深情却哽在喉咙",
     "after": 2,
     "from": [
      "S04-B1",
      "S04-B2"
     ],
     "bars": "24–34"
    }
   ],
   "notes": [
    {
     "text": "熟悉歌声重返转音更华丽更急切",
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "高处长颤音亮得刺眼随后渐弱",
     "from": [
      "S04-B2"
     ],
     "bars": "约30–34"
    },
    {
     "text": "摇荡到末尾渐渐慢下来",
     "from": [
      "S04-B2"
     ],
     "bars": "24–34"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "他不知不觉露出喜欢",
     "accent": "露出喜欢",
     "emotion": "炽热",
     "from": [
      "S05-1"
     ]
    },
    {
     "text": "对方看出他有多在乎",
     "accent": "多在乎",
     "emotion": "悬着",
     "from": [
      "S05-1"
     ]
    },
    {
     "text": "他怕太黏连相处都拿不准",
     "accent": "拿不准",
     "emotion": "不安",
     "from": [
      "S05-2",
      "S05-3"
     ]
    }
   ],
   "small": [
    {
     "text": "心里空落落熟悉的亲近像隔了一层",
     "after": 2,
     "from": [
      "S05-2",
      "S05-3"
     ],
     "bars": ""
    },
    {
     "text": "小船失了托举攥紧的手也松开",
     "after": 2,
     "from": [
      "S05-B1",
      "S05-B3"
     ],
     "bars": "35–39"
    },
    {
     "text": "幸福是真的吗还能维持多久？",
     "after": 2,
     "from": [
      "S05-B2"
     ],
     "bars": "35–39"
    }
   ],
   "notes": [
    {
     "text": "丰满伴奏忽然撤去只剩单线旋律",
     "from": [
      "S05-B1"
     ],
     "bars": "35–39"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "对方看出他在乎却没变",
     "accent": "却没变",
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "他才又能像从前那样自在",
     "accent": "自在",
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "安静时他仍想靠近又怕要太多",
     "accent": "怕要太多",
     "emotion": "不安",
     "from": [
      "S06-2"
     ]
    },
    {
     "text": "他猜对方也舍不得结束亲近",
     "accent": "也舍不得",
     "emotion": "悬着",
     "from": [
      "S06-3"
     ]
    }
   ],
   "small": [
    {
     "text": "对方不知道他刚才多怕被嫌弃",
     "after": 2,
     "from": [
      "S06-2"
     ],
     "bars": ""
    },
    {
     "text": "像月光照着年少初恋的下午",
     "after": 1,
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "心里刚说算了又放不下",
     "after": 2,
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    },
    {
     "text": "夜里泛酸好时光像回忆谁也进不了心底",
     "after": 2,
     "from": [
      "S06-B3"
     ],
     "bars": "40–50"
    },
    {
     "text": "回忆里气味和身体感觉都回来",
     "after": 2,
     "from": [
      "S06-B4"
     ],
     "bars": "40–50"
    },
    {
     "text": "幻想遗憾快感混在一起越舒服越迷失",
     "after": 2,
     "from": [
      "S06-B4"
     ],
     "bars": "40–50"
    }
   ],
   "notes": [
    {
     "text": "摇荡变轻左手波浪碎成细纹",
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "新旋律清澈舒展像一支牧歌",
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "另一条旋律不时插话又缠上来",
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "他觉得对方也许需要他陪",
     "accent": "需要他陪",
     "emotion": "亲密",
     "from": [
      "S07-1"
     ]
    },
    {
     "text": "和他在一起也能安心",
     "accent": "也能安心",
     "emotion": "安心",
     "from": [
      "S07-1"
     ]
    },
    {
     "text": "想到互相依靠他高兴又心紧",
     "accent": "互相依靠",
     "emotion": "欢喜",
     "from": [
      "S07-2"
     ]
    },
    {
     "text": "他盼对方想找人陪时会想到他",
     "accent": "会想到他",
     "emotion": "悬着",
     "from": [
      "S07-3"
     ]
    },
    {
     "text": "他也想一直陪在对方身边",
     "accent": "一直陪在身边",
     "emotion": "亲密",
     "from": [
      "S07-3"
     ]
    }
   ],
   "small": [
    {
     "text": "身体被情欲执念和生命眷恋推着走",
     "after": 2,
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    },
    {
     "text": "这股暖意带一点情色的快感",
     "after": 2,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61"
    },
    {
     "text": "明知被卷进去却暂时不想出来",
     "after": 2,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61"
    },
    {
     "text": "越舒服越让人失去方向",
     "after": 2,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61"
    },
    {
     "text": "美好还在时间却一直经过",
     "after": 4,
     "from": [
      "S07-B3"
     ],
     "bars": "53–61"
    }
   ],
   "notes": [
    {
     "text": "伴奏音符变密内层声音不断攀升",
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    },
    {
     "text": "低音反复重击像沉重脉搏催促",
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "上回露出心意对方仍亲近",
     "accent": "仍亲近",
     "emotion": "安心",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "他想大方回应这份亲近",
     "accent": "大方回应",
     "emotion": "炽热",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "他开始盼两人能好很久",
     "accent": "好很久",
     "emotion": "欢喜",
     "from": [
      "S08-2"
     ]
    },
    {
     "text": "可他没把握以后还会这样",
     "accent": "没把握",
     "emotion": "不安",
     "from": [
      "S08-3"
     ]
    }
   ],
   "small": [
    {
     "text": "身体像重新有了弹性",
     "after": 1,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70"
    },
    {
     "text": "轻快得像调情也像回应",
     "after": 1,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70"
    },
    {
     "text": "快乐余温还在心里已泛起怀念",
     "after": 3,
     "from": [
      "S08-B3"
     ],
     "bars": "69–71"
    }
   ],
   "notes": [
    {
     "text": "旋律忽然舒展直接像歌剧咏叹调",
     "from": [
      "S08-B1"
     ],
     "bars": "62–70"
    },
    {
     "text": "歌声向上散开后忽然戛然而止",
     "from": [
      "S08-B3"
     ],
     "bars": "69–71"
    }
   ]
  },
  {
   "sec": "S09",
   "big": [
    {
     "text": "他怕对方不再需要他陪",
     "accent": "不再需要他陪",
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "也怕对方和他待着不自在",
     "accent": "不自在",
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "他一下安静下来不敢想以后",
     "accent": "不敢想以后",
     "emotion": "悬着",
     "from": [
      "S09-2"
     ]
    },
    {
     "text": "对方一直没退开他有点高兴",
     "accent": "有点高兴",
     "emotion": "欢喜",
     "from": [
      "S09-3"
     ]
    }
   ],
   "small": [
    {
     "text": "也许对方喜欢他在身边",
     "after": 3,
     "from": [
      "S09-3"
     ],
     "bars": ""
    },
    {
     "text": "对视停住呼吸渴望仍悬着",
     "after": 2,
     "from": [
      "S09-B1"
     ],
     "bars": "72–77"
    },
    {
     "text": "听着余响心里问刚才是真的吗接下来呢",
     "after": 2,
     "from": [
      "S09-B3"
     ],
     "bars": "72–77"
    },
    {
     "text": "阳光隔着薄雾夜空比愿望更大",
     "after": 2,
     "from": [
      "S09-B2",
      "S09-B4"
     ],
     "bars": "72–77"
    }
   ],
   "notes": [
    {
     "text": "熟悉摇荡退开音乐忽然收住",
     "from": [
      "S09-B1"
     ],
     "bars": "72–75"
    },
    {
     "text": "轻柔和弦与颤音悬在半空",
     "from": [
      "S09-B1"
     ],
     "bars": "76–77"
    }
   ]
  },
  {
   "sec": "S10",
   "big": [
    {
     "text": "他暂时不猜以后怎样",
     "accent": "暂时不猜",
     "emotion": "安心",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "他先享受眼前的亲近",
     "accent": "眼前的亲近",
     "emotion": "亲密",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "紧绷松开他亮堂得想笑又想哭",
     "accent": "想笑又想哭",
     "emotion": "欢喜",
     "from": [
      "S10-2"
     ]
    }
   ],
   "small": [
    {
     "text": "心事没解决只是暂时不管",
     "after": 0,
     "from": [
      "S10-B1"
     ],
