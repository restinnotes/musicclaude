      "rel": "引用"
     },
     {
      "from": "S01-2",
      "to": "S02-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S03",
    "bars": "17–23",
    "relation": "正在面对",
    "items": [
     {
      "id": "S03-1",
      "text": "这份接纳在他心里留了下来，他在对方面前比先前少了些克制，终于能轻松一点。",
      "key": "这份接纳在他心里",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-1",
       "S02-2"
      ]
     },
     {
      "id": "S03-2",
      "text": "他仍有一部分依恋没有显露，偶尔也会冒出想让对方更了解自己的念头，却很快又收住。",
      "key": "他仍有一部分依恋",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S01-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S02-1",
      "to": "S03-1",
      "rel": "引用"
     },
     {
      "from": "S02-2",
      "to": "S03-1",
      "rel": "引用"
     },
     {
      "from": "S03-1",
      "to": "S03-2",
      "rel": "引用"
     },
     {
      "from": "S01-2",
      "to": "S03-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S04",
    "bars": "24–34",
    "relation": "正在面对",
    "items": [
     {
      "id": "S04-1",
      "text": "他开始觉得，只让对方看见自己控制过的一部分还不够，他希望对方真正知道自己有多依恋。",
      "key": "他开始觉得，只让",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2"
      ]
     },
     {
      "id": "S04-2",
      "text": "这个愿望越来越迫切；越想把心意显露完整，他越感到这份亲近对自己分量很重，热切里也掺进一点不安。",
      "key": "这个愿望越来越迫",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-1",
       "S03-1"
      ]
     }
    ],
    "because": [
     {
