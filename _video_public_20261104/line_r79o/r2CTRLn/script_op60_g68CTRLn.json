       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像谈话碰到了解不开的结，思绪如风吹碎的倒影",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
