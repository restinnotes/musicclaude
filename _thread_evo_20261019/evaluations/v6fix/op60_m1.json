      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "62–71",
    "relation": "还说不清",
    "items": [
     {
      "id": "S08-1",
      "text": "更深的亲近真的发生了，他只顾享受从未有过的满足。",
      "key": "更深的亲近真的发",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1"
      ]
     },
     {
      "id": "S08-2",
      "text": "欢喜稍稍平缓，他却空落，舍不得那样充盈的时刻过去。",
      "key": "欢喜稍稍平缓，他",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S08-3",
      "text": "他还觉得不够，为此有点委屈和羞愧，却说不清究竟缺什么。",
      "key": "他还觉得不够，为",
      "follows": false,
      "explains": [],
      "cite": []
     }
    ],
    "because": [
     {
