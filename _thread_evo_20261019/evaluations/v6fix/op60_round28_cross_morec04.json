      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S03",
    "bars": "17–23",
    "relation": "正在面对",
    "items": [
     {
      "id": "S03-1",
      "text": "那阵热切过后，我只想在余下的安稳里多停一会儿，暂时不问以后。",
      "key": "那阵热切过后，我",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-3"
      ]
     },
     {
      "id": "S03-2",
      "text": "偶尔想索性不再克制自己，那个念头却很快又缩了回去。",
      "key": "偶尔想索性不再克",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-2"
      ]
     },
     {
      "id": "S03-3",
      "text": "只是这样反反复复，舒服里渐渐有了说不清的堵，连我也难把自己的心思理顺。",
      "key": "只是这样反反复复",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S03-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S02-3",
      "to": "S03-1",
      "rel": "引用"
     },
     {
      "from": "S02-2",
      "to": "S03-2",
      "rel": "引用"
     },
