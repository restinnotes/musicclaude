       "from": [
        "S11-B1"
       ],
       "bars": "84-92",
       "at": 15.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "喜悦强烈得让他心里发酸，甚至带着一点快要承受不住的脆弱",
