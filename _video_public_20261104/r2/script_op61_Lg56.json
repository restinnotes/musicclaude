        "S03-B4-p2"
       ]
      },
      {
       "text": "心里的事没有答案",
       "keys": [],
       "from": [
        "S03-B4-p3"
       ]
      },
      {
       "text": "昂扬慢慢退潮",
       "keys": [],
       "from": [
        "S03-B5-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可从前的日子回不去了，离开以后也未必更好",
