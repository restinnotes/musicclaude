{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"细碎的光点再缓缓飘落\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"船歌那种稳定的摇荡感还没有真正成形\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现自己那么想靠近\",\n          \"point\": \"那么想靠近这个人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"连自己也有点意外\"\n        },\n        {\n          \"text\": \"他怕对方一看出自己\",\n          \"point\": \"只敢露出一点点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"就会觉得负担太重，所以\"\n        },\n        {\n          \"text\": \"只是这么一点亲近\",\n          \"point\": \"能不能更坦白些\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只是这么一点亲近就让他觉得甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"对方偶尔望来一眼，沉默也不让人紧张\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"可以放弃对重力的控制，把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"声音短暂落稳，又漂起来一点，没有把心事彻底说死\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"心事没说死\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有因为他露出在意\",\n