  {
   "bars": "148–180",
   "relation": "没在想",
   "items": [
    {
     "id": "I54",
     "text": "他怀念旧日那种一直有的安稳。",
     "key": "一直有的安稳",
     "kind": ""
    },
    {
     "id": "I55",
     "text": "他那时能放心交出自己的心意。",
     "key": "放心交出",
     "kind": ""
    },
    {
     "id": "I56",
     "text": "他也能安心接受别人的亲近。",
     "key": "安心接受",
     "kind": ""
    },
    {
     "id": "I57",
     "text": "他那时付出不必计算得失。",
     "key": "计算得失",
     "kind": ""
    },
    {
     "id": "I58",
     "text": "他那时接受不必觉得亏欠。",
     "key": "觉得亏欠",
     "kind": ""
    },
    {
     "id": "I59",
     "text": "他那时有骄傲，却无需时时防备。",
     "key": "无需时时防备",
     "kind": ""
    },
    {
     "id": "I60",
     "text": "他能亲近别人，也不觉得失去尊严。",
     "key": "不觉得失去尊严",
     "kind": ""
    },
    {
     "id": "I61",
     "text": "他仿佛又感到从前心里的宽阔。",
     "key": "心里的宽阔",
     "kind": ""
    },
    {
     "id": "I62",
     "text": "他重新为曾拥有那种生活而喜悦。",
     "key": "曾拥有那种生活",
     "kind": ""
    },
    {
     "id": "I63",
     "text": "失去的事实暂时从他心里退远。",
     "key": "心里退远",
     "kind": ""
    },
    {
     "id": "I64",
     "text": "他暂时不追问这一切能否回来。",
     "key": "能否回来",
     "kind": ""
    },
    {
     "id": "I65",
     "text": "他只想让这份温暖多停留一会儿。",
     "key": "多停留一会儿",
     "kind": ""
    },
    {
     "id": "I66",
     "text": "他一时几乎忘了自己为何愤怒。",
     "key": "一时几乎忘了",
     "kind": ""
    }
   ],
   "because": [
