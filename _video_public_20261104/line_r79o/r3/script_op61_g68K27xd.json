       "from": [
        "S02-2",
        "S02-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "一遍遍对自己说没事，说到第三次，反而露出了心里多在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "可难道为了不再受气，就得把以前的好日子也一起丢掉吗？",
