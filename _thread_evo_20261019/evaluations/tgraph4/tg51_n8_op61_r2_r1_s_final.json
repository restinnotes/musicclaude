{
 "center": "向外行动与旧梦都要求投入，却彼此牵制。",
 "segments": [
  {
   "bars": "1–23",
   "relation": "还说不清",
   "items": [
    {
     "id": "I1",
     "text": "起初他不知道自己究竟在等什么，心里却不肯就此算了，仿佛放任事情照旧就是默认它们本该如此。",
     "key": "不肯默认现状",
     "kind": "",
     "follows": false,
     "key_model": "不肯就此算了"
    },
    {
     "id": "I2",
     "text": "真要投入，他又怕会丢下什么。",
     "key": "怕投入会丢下什么",
     "kind": "",
     "follows": true,
     "key_model": "投入时怕失去"
    },
    {
     "id": "I2b",
     "text": "他有勇气，却也舍不得一些还说不清的东西。",
     "key": "有勇气也有不舍",
     "kind": "",
     "follows": true,
     "key_model": ""
    },
    {
     "id": "I3",
     "text": "他试着找个足以让自己不再犹豫的理由，刚觉得想通，另一番舍不得就浮上来。",
     "key": "寻找理由又生不舍",
     "kind": "",
     "follows": true,
     "key_model": "寻找前进理由"
    },
    {
     "id": "I4",
     "text": "他为自己的反复摇摆难堪，甚至怀疑自己得先想清心里一切才肯向前。",
     "key": "因反复摇摆而难堪",
     "kind": "",
     "follows": true,
     "key_model": "摇摆让他难堪"
    }
   ],
   "because": [],
   "relation_votes": {
    "还说不清": 6
   },
   "relation_model": "还说不清"
  },
  {
   "bars": "24–65",
   "relation": "正在面对",
   "items": [
    {
     "id": "I5",
     "text": "他受不了再拿没想清楚当作等待理由，决定先把自己能做的一份认下来。",
     "key": "不再以未想清为由等待",
     "kind": "",
     "follows": false,
     "key_model": "认下能做之事"
    },
    {
     "id": "I6",
     "text": "即使没有任何保证，心里的牵挂也没消失，他却真切地感到自己有了力量。",
     "key": "无保证仍感到力量",
     "kind": "",
     "follows": true,
     "key_model": "投入后有力量"
    },
    {
     "id": "I7",
     "text": "他从追问值不值得转为愿意尽力，也有些骄傲，觉得心里有疑虑也不必听它的。",
     "key": "不问值不值得而尽力",
     "kind": "",
     "follows": true,
     "key_model": "疑虑不再作主"
    },
    {
     "id": "I8",
     "text": "他投入得很热切，付出的过程本身让他快乐，心里的不满也似乎有了去处。",
     "key": "在付出中感到快乐",
     "kind": "",
     "follows": true,
     "key_model": "付出带来快乐"
    },
    {
     "id": "I9",
     "text": "他愿意给出更多，甚至有些贪恋全力以赴时那种畅快。",
     "key": "贪恋全力以赴的畅快",
     "kind": "",
     "follows": true,
     "key_model": "贪恋全力投入"
    },
    {
     "id": "I10",
     "text": "他不再时时审视自己，也不愿因一点软弱就停下来。",
     "key": "不再自审也不停步",
     "kind": "",
     "follows": true,
     "key_model": "不再反复审视"
    },
    {
     "id": "I11",
     "text": "用力到深处，他仍觉心里一小块没跟着昂扬，隐约知道坚决也没照顾到所有牵挂。",
     "key": "坚决仍照顾不到牵挂",
     "kind": "",
     "follows": true,
     "key_model": "牵挂没有消失"
    }
   ],
   "because": [
    {
     "from": "I4",
     "to": "I5",
     "rel": "改写",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 4,
    "还说不清": 2
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "66–91",
   "relation": "没在想",
   "items": [
    {
     "id": "I12",
     "text": "这点不安还没逼他停下。",
     "key": "不安尚未逼他停下",
     "kind": "",
     "follows": false,
     "key_model": "从自问里松开"
    },
    {
     "id": "I12b",
     "text": "认真投入过后，他反而能从反复自问里松开一点。",
     "key": "投入后暂时松开自问",
     "kind": "",
     "follows": true,
     "key_model": ""
    },
    {
     "id": "I13",
     "text": "他发现自己也会因不再畏缩而高兴，向前的热情还让他感到轻盈。",
     "key": "不再畏缩而高兴",
     "kind": "",
     "follows": true,
     "key_model": "热情带来轻盈"
    },
    {
     "id": "I14",
     "text": "偶尔忘了自己为何如此用力时，他觉得那不算背叛，反而像久违的自由。",
     "key": "忘却用力缘由也觉自由",
     "kind": "",
     "follows": true,
     "key_model": "偶尔感到自由"
    },
    {
     "id": "I15",
     "text": "他顺着自由走了一程，没有急着解释它。",
     "key": "顺着自由走一程",
     "kind": "",
     "follows": true,
     "key_model": "旧决定仍等着"
    },
    {
     "id": "I15b",
     "text": "快乐淡下去后，先前的决定仍等着他。",
     "key": "快乐淡去决定仍在",
     "kind": "",
     "follows": true,
     "key_model": ""
    }
   ],
   "because": [
    {
     "from": "I11",
     "to": "I12",
     "rel": "仍在起作用",
     "audit": "支持"
    },
    {
     "from": "I8",
     "to": "I13",
     "rel": "提供理由",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "没在想": 6
   },
   "relation_model": "没在想"
  },
  {
   "bars": "92–115",
   "relation": "正在面对",
   "items": [
    {
     "id": "I16",
     "text": "他仍愿意坚持先前的决定，因为那曾把他从动弹不得的犹豫里带出来。",
     "key": "坚持曾带他走出犹豫",
     "kind": "",
     "follows": false,
     "key_model": "坚持原先决定"
    },
    {
     "id": "I17",
     "text": "他不愿因心里仍有未满足的地方就认定先前全错，可坚定已不能让他安心。",
     "key": "坚定不再让他安心",
     "kind": "",
     "follows": true,
     "key_model": "坚定不再安稳"
    },
    {
     "id": "I18",
     "text": "他想确认自己仍有力量，却发现心里还有一种要求无法由力量替代。",
     "key": "力量无法替代内心要求",
     "kind": "办法的限度",
     "follows": true,
     "key_model": "行动值得却不够"
    },
    {
     "id": "I18b",
     "text": "行动值得，也仍不够。",
     "key": "行动值得却仍不够",
     "kind": "",
     "follows": true,
     "key_model": ""
    }
   ],
   "because": [
    {
     "from": "I15",
     "to": "I16",
     "rel": "唤起",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 4,
    "还说不清": 2
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "116–147",
   "relation": "正在面对",
   "items": [
    {
     "id": "I19",
     "text": "明知行动还不够，他仍不肯放手，怕此刻的失望意味着自己已经变了心。",
     "key": "怕失望意味着变心",
     "kind": "",
     "follows": false,
     "key_model": "怕失望意味着变心"
    },
    {
     "id": "I20",
     "text": "他把心里的难处当作能克服的迟疑，想停一停时又怕那就是退缩。",
     "key": "把难处当成迟疑来克服",
     "kind": "",
     "follows": true,
     "key_model": "把难处当迟疑"
    },
    {
     "id": "I21",
     "text": "他知道自己正在受苦，却想不出除了坚持，还有什么办法对得起最初的决定。",
     "key": "想不出坚持之外的办法",
     "kind": "",
     "follows": true,
     "key_model": "怕辜负最初决定"
    },
    {
     "id": "I22",
     "text": "原先让他昂然的要求，慢慢变成连脆弱也容不下的苛责。",
     "key": "坚强要求变成苛责",
     "kind": "",
     "follows": true,
     "key_model": "坚定变成苛责"
    },
    {
     "id": "I23",
     "text": "他发现自己像在勉强一个已经疲惫的人，终于不想再证明自己坚强。",
     "key": "不再证明自己坚强",
     "kind": "",
     "follows": true,
     "key_model": "不再证明坚强"
    },
    {
     "id": "I24",
     "text": "他暂时放下催逼，虽未安心，却有些松懈。",
     "key": "放下催逼却未安心",
     "kind": "",
     "follows": true,
     "key_model": "依恋重新回来"
    },
    {
     "id": "I24b",
     "text": "被压住的依恋回来，他也发现自己真舍不得一些东西。",
     "key": "依恋回来才知舍不得",
     "kind": "",
     "follows": true,
     "key_model": ""
    }
   ],
   "because": [
    {
     "from": "I16",
     "to": "I19",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I18",
     "to": "I19",
     "rel": "限制",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 4,
    "还说不清": 2
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "148–180",
   "relation": "没在想",
   "items": [
    {
     "id": "I25",
     "text": "放下催逼后，他才看清自己舍不得的生活：人与人不用时时防备。",
     "key": "舍不得无需防备的生活",
     "kind": "",
     "follows": false,
     "key_model": "不用防备的生活"
    },
    {
     "id": "I26",
     "text": "他曾自然相信，珍贵的东西不用争夺也能留下，付出出于喜欢，靠近无需先防着受伤。",
     "key": "珍贵之物无需争夺",
     "kind": "",
     "follows": true,
     "key_model": "不靠争夺保有"
    },
    {
     "id": "I27",
     "text": "这份盼望确实给过他快乐，让他觉得自己不只是凡事都得扛着、必须坚强的人。",
     "key": "盼望让他不必总坚强",
     "kind": "",
     "follows": true,
     "key_model": "旧愿曾给快乐"
    },
    {
     "id": "I28",
     "text": "他终于肯沉浸在这份盼望里，不急着问能否得到。",
     "key": "沉浸盼望不问结果",
     "kind": "",
     "follows": true,
     "key_model": "沉浸旧愿满足"
    },
    {
     "id": "I28b",
     "text": "仅仅去爱、去相信，就让他深深满足。",
     "key": "爱与相信带来满足",
     "kind": "",
     "follows": true,
     "key_model": ""
    }
   ],
   "because": [
    {
     "from": "I24",
     "to": "I25",
     "rel": "唤起",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "没在想": 4,
    "正在面对": 2
   },
   "relation_model": "没在想"
  },
  {
   "bars": "181–205",
   "relation": "正在面对",
   "items": [
    {
     "id": "I29",
     "text": "这份安宁如此真实，他不满足只在心里拥有它，也开始追问单靠怀念怎能改变威胁它的事。",
     "key": "追问怀念能否护住安宁",
     "kind": "满足照出未满足",
     "follows": false,
     "key_model": "安宁照出未满足"
    },
    {
     "id": "I30",
     "text": "他想起最初不肯被动等待，也是因为有些重要的东西不能任由它们受损。",
     "key": "不肯坐等重要之物受损",
     "kind": "",
     "follows": true,
     "key_model": "不甘心只怀念"
    },
    {
     "id": "I31",
     "text": "他一阵懊恼，几乎责怪自己刚沉浸满足，就忘了还有必须面对的事。",
     "key": "满足时忘了仍有要事",
     "kind": "",
     "follows": true,
     "key_model": "懊恼忘了要面对"
    },
    {
     "id": "I32",
     "text": "他试着重新振作，却怕再次投入艰难的争取，会一点点耗尽刚尝到的温柔。",
     "key": "怕争取耗尽温柔",
     "kind": "",
     "follows": true,
     "key_model": "怕温柔被耗尽"
    },
    {
     "id": "I33",
     "text": "想到安宁他舍不得，想到它受威胁又放不下。",
     "key": "珍惜安宁又怕它受威胁",
     "kind": "知道更多反而更尖锐",
     "follows": true,
     "key_model": "前进停留都不安"
    },
    {
     "id": "I33b",
     "text": "理由更多了，他心里反而更难平静。",
     "key": "理由增多心更难平静",
     "kind": "",
     "follows": true,
     "key_model": ""
    }
   ],
   "because": [
    {
     "from": "I28",
     "to": "I29",
     "rel": "动摇",
     "audit": "支持"
    },
    {
     "from": "I27",
     "to": "I32",
     "rel": "限制",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "206–213",
   "relation": "没在想",
   "items": [
    {
     "id": "I34",
     "text": "他明知不能久留，仍愿再爱惜温柔片刻，不拿它审问自己；欢喜里也已有不舍。",
     "key": "爱惜温柔片刻不自审",
     "kind": "",
     "follows": false,
     "key_model": "再爱惜温柔片刻"
    }
   ],
   "because": [
    {
     "from": "I33",
     "to": "I34",
     "rel": "唤起",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "没在想": 6
   },
   "relation_model": "没在想"
  },
  {
   "bars": "214–215",
   "relation": "正在面对",
   "items": [
    {
     "id": "I35",
     "text": "安静退去后，熟悉的迟疑又回来。",
     "key": "安静退去迟疑重来",
     "kind": "分清",
     "follows": false,
     "key_model": "迟疑里有旧愿"
    },
    {
     "id": "I35b",
     "text": "他如今知道，迟疑里也有不愿失去的生活希望。",
     "key": "迟疑里藏着生活希望",
     "kind": "",
     "follows": true,
     "key_model": ""
    }
   ],
   "because": [
    {
     "from": "I34",
     "to": "I35",
     "rel": "唤起",
     "audit": "支持"
    },
    {
     "from": "I26",
     "to": "I35",
     "rel": "改写",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "216–225",
   "relation": "正在面对",
   "items": [
    {
     "id": "I36",
     "text": "知道自己舍不得什么，并没让他立刻勇敢。",
     "key": "知道不舍仍未勇敢",
     "kind": "办法的限度",
     "follows": false,
     "key_model": "两种办法都有难处"
    },
    {
     "id": "I36b",
     "text": "决心和沉浸旧愿这两种办法都有难处。",
     "key": "决心与旧愿各有难处",
     "kind": "",
     "follows": true,
     "key_model": ""
    },
    {
     "id": "I37",
     "text": "他一时只盼着，继续争取时记得为何出发，爱惜安宁时也肯面对威胁它的事。",
     "key": "记得出发也面对威胁",
     "kind": "",
     "follows": true,
     "key_model": "同时争取与爱惜"
    },
    {
     "id": "I38",
     "text": "他还不知道怎样做到，只觉得反复想着这点心愿，似乎稍减了非得舍弃一边的逼迫。",
     "key": "想着心愿稍减两难逼迫",
     "kind": "",
     "follows": true,
     "key_model": "舍弃一边的逼迫"
    }
   ],
   "because": [
    {
     "from": "I35",
     "to": "I36",
     "rel": "限制",
     "audit": "支持"
    },
    {
     "from": "I26",
     "to": "I37",
     "rel": "提供理由",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "226–241",
   "relation": "正在面对",
   "items": [
    {
     "id": "I39",
     "text": "凭着这点还不牢靠的心意，他重新想自己还能怎么做。",
     "key": "带着未稳心意重新思考",
     "kind": "",
     "follows": false,
     "key_model": "重新想怎么办"
    },
    {
     "id": "I40",
     "text": "他亲身体会到，尽力做事能让人从无力里缓过来，却不能消除所有牵挂。",
     "key": "尽力缓解无力却留牵挂",
     "kind": "办法的限度",
     "follows": true,
     "key_model": "尽力不能消除牵挂"
    },
    {
     "id": "I41",
     "text": "他也尝过，心里的美好能安慰自己，却不能单靠安慰保护所爱的生活。",
     "key": "美好安慰不能保护生活",
     "kind": "办法的限度",
     "follows": false,
     "key_model": "安慰不能保护生活"
    },
    {
     "id": "I42",
     "text": "这两样收获都是真的，所以他不愿再简单否定其中任何一样。",
     "key": "不再否定任一收获",
     "kind": "",
     "follows": true,
     "key_model": "不再否定任一收获"
    },
    {
     "id": "I43",
     "text": "他想保有那份无需时时奋力的安宁，却知道为它争取也可能失去安宁。",
     "key": "争取可能失去安宁",
     "kind": "",
     "follows": true,
     "key_model": "争取可能失去安宁"
    },
    {
     "id": "I44",
     "text": "他渐渐明白，难受未必说明意志不够。",
     "key": "难受未必因为意志不足",
     "kind": "选择的代价",
     "follows": true,
     "key_model": "珍视的不止一种"
    },
    {
     "id": "I44b",
     "text": "他珍视的东西确实不止一种。",
     "key": "珍视的东西不止一种",
     "kind": "",
     "follows": true,
     "key_model": ""
    },
    {
     "id": "I45",
     "text": "他仍心疼可能失去的东西，也盼着有条轻松的路，却知道继续等不会让它出现。",
     "key": "等待不会带来轻松出路",
     "kind": "",
     "follows": true,
     "key_model": "等待不会带来轻松路"
    },
    {
     "id": "I46",
     "text": "他允许自己害怕、没把握，也带着不舍继续往前，不再让惧怕替自己决定。",
     "key": "带着害怕不舍继续前行",
     "kind": "",
     "follows": true,
     "key_model": "带着不舍前进"
    }
   ],
   "because": [
    {
     "from": "I38",
     "to": "I39",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I7",
     "to": "I40",
     "rel": "仍在起作用",
     "audit": "支持"
    },
    {
     "from": "I28",
     "to": "I41",
     "rel": "仍在起作用",
     "audit": "支持"
    },
    {
     "from": "I28",
     "to": "I43",
     "rel": "限制",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "242–253",
   "relation": "正在面对",
   "items": [
    {
     "id": "I47",
     "text": "既然不再等一个毫无损失的办法，他重新感到昂扬，也能带着脆弱继续。",
     "key": "不求无损仍带脆弱前行",
     "kind": "",
     "follows": false,
     "key_model": "重新昂扬不否认脆弱"
    },
    {
     "id": "I48",
     "text": "他仍愿尽力，却不再要求行动证明自己无所不能。",
     "key": "行动不再证明无所不能",
     "kind": "",
     "follows": true,
     "key_model": "不再证明无所不能"
    },
    {
     "id": "I48b",
     "text": "他知道自己要做什么，也知道为何舍不得。",
     "key": "知道该做什么也懂珍惜",
     "kind": "",
     "follows": true,
     "key_model": ""
    },
    {
     "id": "I49",
     "text": "他愿为真心爱惜的一切负责，不再把它们当作行动的拖累。",
     "key": "为所爱之物承担责任",
     "kind": "",
     "follows": true,
     "key_model": "为珍惜之物负责"
    },
    {
     "id": "I49b",
     "text": "即使仍犹疑，也允许自己坚定。",
     "key": "犹疑中也允许坚定",
     "kind": "",
     "follows": true,
     "key_model": ""
    }
   ],
   "because": [
    {
     "from": "I46",
     "to": "I47",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I44",
     "to": "I48",
     "rel": "改写",
     "audit": "支持"
    },
    {
     "from": "I46",
     "to": "I49",
     "rel": "仍在起作用",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "254–288",
   "relation": "正在面对",
   "items": [
    {
     "id": "I50",
     "text": "他重新向前时，旧愿似乎没有变远，反而比从前更亲近了。",
     "key": "旧愿反而更加亲近",
     "kind": "",
     "follows": false,
     "key_model": "旧愿反而更亲近"
    },
    {
     "id": "I51",
     "text": "过去他以为退回争取之外才能保住旧愿。",
     "key": "以为不争才能保住旧愿",
     "kind": "",
     "follows": true,
     "key_model": "不再任由旧愿受损"
    },
    {
     "id": "I51b",
     "text": "如今因知道它珍贵，他更不愿任由威胁它的事存在。",
     "key": "珍惜旧愿不容威胁",
     "kind": "",
     "follows": true,
     "key_model": ""
    },
    {
     "id": "I52",
     "text": "他觉得温柔也能成为不肯袖手旁观的理由。",
     "key": "温柔也让他不愿旁观",
     "kind": "",
     "follows": true,
     "key_model": "温柔成为行动理由"
    },
    {
     "id": "I52b",
     "text": "若争取时丢掉这份向往，坚强又有什么用？",
     "key": "丢掉向往则坚强无用",
     "kind": "",
     "follows": true,
     "key_model": ""
    },
    {
     "id": "I53",
     "text": "他仍想过不必拼命的日子，却愿为珍惜它而离开眼前的安宁。",
     "key": "为珍惜向往暂离安宁",
     "kind": "",
     "follows": true,
     "key_model": "离开眼前安宁"
    },
    {
     "id": "I54",
     "text": "他知道尽力未必能实现旧梦，心怀美好也得看清付出会不会伤到所爱。",
     "key": "尽力未必圆梦须顾所爱",
     "kind": "办法的限度",
     "follows": true,
     "key_model": "尽力不保证旧梦实现"
    },
    {
     "id": "I55",
     "text": "这些顾虑也提醒他该带着怎样的心继续坚持。",
     "key": "顾虑提醒他如何坚持",
     "kind": "",
     "follows": true,
     "key_model": "顾虑提醒怎样坚持"
    },
    {
     "id": "I56",
     "text": "两种心意终于一起帮他向前，他能珍惜依恋，也能继续做该做的事。",
     "key": "珍惜依恋也继续行动",
     "kind": "",
     "follows": true,
     "key_model": "两种心意共同支持"
    },
    {
     "id": "I56b",
     "text": "历经怀疑和疲惫后，他尝到更深的快乐。",
     "key": "历经疲惫怀疑后更快乐",
     "kind": "",
     "follows": true,
     "key_model": ""
    },
    {
     "id": "I57",
     "text": "喜悦平静后，他仍无答案：行动未必改变什么，安宁也没回来。",
     "key": "喜悦平静后仍无答案",
     "kind": "",
     "follows": true,
     "key_model": "喜悦后仍有未解之事"
    },
    {
     "id": "I57b",
     "text": "他往后仍会疲惫动摇，两种渴望仍会相互牵制。",
     "key": "疲惫时两种渴望相牵制",
     "kind": "",
     "follows": true,
     "key_model": ""
    },
    {
     "id": "I58",
     "text": "他愿意同时顾及两种需要，也珍惜已经得到的东西，即使其中一种仍未满足。",
     "key": "兼顾两种需要珍惜所得",
     "kind": "",
     "follows": true,
     "key_model": "不拿满足遮住需要"
    },
    {
     "id": "I59",
     "text": "过去的快乐、失望、疲惫和依恋，让他知道什么值得付出，什么不能轻易牺牲。",
     "key": "分清值得付出与不可舍",
     "kind": "",
     "follows": true,
     "key_model": "知道什么不能牺牲"
    },
    {
     "id": "I60",
     "text": "他仍向往安宁，也愿继续行动。",
     "key": "仍向往安宁也愿行动",
     "kind": "",
     "follows": true,
     "key_model": "带着不舍继续行动"
    },
    {
     "id": "I60b",
     "text": "虽不知最终能留下多少，他仍带着不舍向前，不再寻找更多证明。",
     "key": "带着不舍向前不再求证",
     "kind": "",
     "follows": true,
     "key_model": ""
    }
   ],
