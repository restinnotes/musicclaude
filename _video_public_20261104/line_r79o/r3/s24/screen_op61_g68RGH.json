       "bars": [
        221,
        225
       ]
      }
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "接下来怎么生活",
       "bead": "S10-B3",
       "bars": null
      },
      {
       "text": "经历过许多以后",
       "bead": "S10-B3",
       "bars": null
      }
     ]
    },
    {
     "kind": "line",
     "text": "他翻来覆去想得很累，仍没答案，连眼下的日子也过得不踏实。",
     "keys": [
      "没答案"
     ],
     "emotion": "悬着",
     "from": [
      "S10-3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像在回想旧事",
       "bead": "S10-B4",
       "bars": null
      },
      {
       "text": "却没力气讲完",
       "bead": "S10-B4",
       "bars": null
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "rows": [
    {
     "kind": "line",
     "text": "回去未必找得回亲近，他却还是忍不住想：万一能呢？",
     "keys": [
      "未必找得回"
     ],
     "emotion": "悬着",
     "from": [
      "S11-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "低音翻起波涛",
       "bead": "S11-B1",
       "bars": null
      },
      {
       "text": "和弦重重砸下",
       "bead": "S11-B1",
       "bars": null
      },
      {
       "text": "紧张没散干净",
       "bead": "S11-B1",
       "bars": null
      },
      {
       "text": "新的压力又来",
       "bead": "S11-B1",
       "bars": null
      },
      {
       "text": "像困兽挣扎",
       "bead": "S11-B1",
       "bars": null
      },
      {
       "text": "不是顺畅奔跑",
       "bead": "S11-B1",
       "bars": null
      },
      {
       "text": "一次次顶住",
       "bead": "S11-B1",
       "bars": null
      }
     ]
    },
    {
     "kind": "line",
     "text": "他再心动，也不愿只凭这点指望回去，过从前忍让的日子。",
     "keys": [
      "只凭这点指望"
     ],
     "emotion": "炽热",
     "from": [
      "S11-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "步子还没整齐",
       "bead": "S11-B2",
       "bars": null
      },
      {
       "text": "先试探前方",
       "bead": "S11-B2",
       "bars": null
      },
      {
       "text": "前面有没有路",
       "bead": "S11-B2",
       "bars": null
      },
      {
       "text": "步伐慢慢聚拢",
       "bead": "S11-B2",
       "bars": null
      },
      {
       "text": "越走越向前",
       "bead": "S11-B2",
       "bars": null
      },
      {
       "text": "旧舞步又回来",
       "bead": "S11-B2",
       "bars": null
      },
      {
       "text": "带着柔软的声音",
       "bead": "S11-B2",
       "bars": null
      }
     ]
    },
    {
     "kind": "line",
     "text": "他想把回去的事以后再说，先把眼下日子过稳些，也许更踏实。",
     "keys": [
      "先把眼下日子过稳些"
     ],
     "emotion": "安心",
     "from": [
      "S11-3"
     ]
    },
    {
     "kind": "line",
     "text": "他仍怕以后遇上难事只能自己扛，却不因害怕收回刚才的打算。",
     "keys": [
      "只能自己扛"
     ],
     "emotion": "炽热",
     "from": [
      "S11-4"
     ]
    },
    {
     "kind": "feel",
     "items": [
