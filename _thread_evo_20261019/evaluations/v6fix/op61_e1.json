      "follows": false,
      "explains": [],
      "cite": [
       "S06-2"
      ]
     },
     {
      "id": "S07-3",
      "text": "他为独立而骄傲，却从中得不到被温柔包容的满足。",
      "key": "他为独立而骄傲，",
      "follows": false,
