 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他冷不丁发现自己这么想挨近这个人，心头一热",
       "keys": [
        "这么想挨近这个人"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夏夜烟花缓缓飘落，又像刚踏上船板晃得一下失重",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他怕对方看出自己多渴望跟人亲近、会觉得是个累赘，便只敢露出一点点喜欢",
       "keys": [
        "只敢露出一点点喜欢"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话到嘴边先沉默几秒，怕一说出口关系就变了",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "光这么一点亲近就很甜，他还拿不准下次能不能更坦白些",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他流露了在乎，对方却照旧愿意跟他亲近、也没躲开，他这才慢慢放松下来",
       "keys": [
        "慢慢放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像紧挨着耳语连体温都融在一处，又像夏末微黏的暖风",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "也像熟人安静坐着不用找话，偶尔对望也不紧张",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "脚下不必踩实地面，把身体交给船底温柔地托着",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势再走近些，有一阵子喜欢得快兜不住了",
       "keys": [
        "喜欢得快兜不住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "终归怕太急会搅了两人现在舒舒服服待着的样子，还是收住了",
       "keys": [
        "怕太急会搅了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "两人一块儿待得这么舒心，他却偏偏想到这光景总有散的时候",
       "keys": [
        "总有散的时候"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "人还在一块儿就先有点舍不得了",
       "keys": [
        "先有点舍不得了"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "人在船上舒服地漂着不急着靠岸，水和时间却一直在走",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像扎了根温柔的刺，眼前的好还在却已经有点鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他难得把两人以后的事放一放，就想舒舒服服地跟对方待在一块儿",
       "keys": [
        "舒舒服服地跟对方待在一块儿"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像说完重要的话还陶醉在里头，有一点走神",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "又像交谈后安静下来也不尴尬，人还在心却慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想说自己多喜欢这样待着，也想问对方是不是一样",
       "keys": [
        "想说自己多喜欢这样待着"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "还琢磨着怎么开口，这念头倒先淡了",
       "keys": [
        "这念头倒先淡了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急着倾诉的念头只在水面露了下头，很快又沉了回去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像谈话碰到了解不开的结，思绪如风吹碎的倒影",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "两人又像往常那样亲近，他满心欢喜",
