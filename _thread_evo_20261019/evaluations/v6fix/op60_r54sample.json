      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "72–77",
    "relation": "没在想",
    "items": [
     {
      "id": "S09-1",
      "text": "他沉在彼此都愿意依靠对方的满足里，觉得自己既能让对方安心，也能从对方那里得到幸福。",
      "key": "他沉在彼此都愿意",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1"
      ]
     },
     {
      "id": "S09-2",
      "text": "想到自己也能成为对方的依靠，他心里涌起一种陌生而宽阔的满足，一时顾不上再要更多。",
      "key": "想到自己也能成为",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1"
      ]
     },
     {
      "id": "S09-3",
      "text": "他不再急着把亲近往前推，刚才的明朗慢慢收进心里，变成安静的满足。",
      "key": "他不再急着把亲近",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S07-1",
