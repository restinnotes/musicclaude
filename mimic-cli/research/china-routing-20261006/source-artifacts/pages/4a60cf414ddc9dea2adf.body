    <style>

        .modal-backdrop.in {
            opacity: 1 !important;
        }

        .modal-backdrop {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            z-index: 1040;
            background-color: #000000;
        }

        /* Bootstrap 5 renamed .close to .btn-close, so the old rule matched nothing
           and the button fell back to its default position inside the content. */
        .modal_for_zoom_img .btn-close {
            opacity: 1;
            position: fixed;
            top: 20px;
            right: 28px;
            width: 26px;
            height: 26px;
            padding: 0;
            background-color: transparent;
            z-index: 1060;
        }

        .modal_for_zoom_img .new_alert_thanks {
            margin-top: 50px;
        }
        
        /* The .modal element covers the viewport above the shared backdrop, so this
           lightens the surround for this modal alone without touching the others. */
        .modal_for_zoom_img {
            cursor: zoom-out;
            background: #ffffff;
        }

        .modal_for_zoom_img .modal-content {
            box-shadow: none;
            border: none;
        }
        /* .modal-lg caps itself at 800px in Bootstrap 5, which overrode the width below.
           The dialog hugs the artwork so the light frame stays even on all four sides. */
        .modal_for_zoom_img .modal-dialog {
            width: fit-content;
            max-width: 92%;
            margin: 40px auto;
        }

        .modal_for_zoom_img #modalRdImage {
            width: auto;
            height: auto;
            display: block;
        }

        .modal_for_zoom_img .modal_img_left {
            padding: 0px;
            background: transparent;
        }

        .modal_img_left {
            position: relative;
            padding: 0px;
            background: #fff;
            border-radius: 6px 6px;
            max-width: 1024px;
        }
        .modal_img_right {
            padding: 40px 20px;
        }
