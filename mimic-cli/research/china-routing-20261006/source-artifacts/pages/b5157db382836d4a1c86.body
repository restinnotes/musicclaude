        document.addEventListener('DOMContentLoaded', function () {
            const logolist = document.querySelector('.logolist');
            let lastScrollY = window.scrollY;
            const stickyThreshold = 50;
            window.addEventListener('scroll', function () {
                const currentScrollY = window.scrollY;
                if (currentScrollY > lastScrollY && currentScrollY > stickyThreshold) {
                    logolist.classList.add('sticky');
                } else if (currentScrollY < lastScrollY) {
                    logolist.classList.remove('sticky');
                }
                lastScrollY = currentScrollY;
            });
        });
    </script><!-- 处理器分类部分 --><div id="shopify-section-template--23713310933298__tab_fpg_wyfkFe" class="shopify-section"><style>
