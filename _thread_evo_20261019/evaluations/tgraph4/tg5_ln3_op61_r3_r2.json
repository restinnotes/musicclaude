   "relation": "正在面对",
   "items": [
    {
     "id": "I73",
     "text": "这次怀念出现时，他不再恼怒自己。",
     "key": "不再恼怒",
     "kind": ""
    },
    {
     "id": "I74",
     "text": "他觉得仍爱旧日幸福并不可耻。",
     "key": "并不可耻",
     "kind": ""
    },
    {
     "id": "I75",
     "text": "他尤其想念亲近中毫无隔阂的时刻。",
     "key": "毫无隔阂",
     "kind": ""
    },
