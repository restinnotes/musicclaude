  {
   "bars": "40–50",
   "relation": "没在想",
   "items": [
    {
     "id": "I24",
     "text": "难堪没减轻喜欢，却让他不愿再靠自己的慷慨来证明什么。",
     "key": "不再靠慷慨证明自己",
     "kind": "办法的限度",
     "key_model": "证明什么"
    },
    {
     "id": "I25",
     "text": "他不想总查对方是否在意，也不想强迫自己成为完全没有期待的人。",
     "key": "不查对方也不压掉期待",
     "kind": "",
     "key_model": "没有期待"
    },
    {
     "id": "I26",
     "text": "他转而只留意此刻愿意给出的关切，暂时不去想两个人以后会怎样。",
     "key": "只留意此刻愿给的关切",
     "kind": "",
     "key_model": "愿意给出"
    },
    {
     "id": "I27",
     "text": "希望对方好、安静地惦念，都能让他心里生出甜意，他不再用这些衡量关系。",
     "key": "不再用甜意衡量关系",
     "kind": "",
     "key_model": "生出甜意"
    },
    {
     "id": "I28",
     "text": "这份更隐秘的喜欢让他暂时忘了为何在意回应，只觉得细细喜欢一个人很甜。",
     "key": "细细喜欢一个人的甜",
     "kind": "",
     "key_model": "暂时忘了"
    }
   ],
