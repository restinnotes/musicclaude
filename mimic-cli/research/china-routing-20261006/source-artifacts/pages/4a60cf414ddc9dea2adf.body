                    '<a href="'+sample_url+'" class="reqest_copy_btn" target="_blank" rel="nofollow">Request a Free Sample Copy</a>' +
                    '</div>' +
                    '<div class="col-lg-7 col-md-6 top_summary_right_box">' +
