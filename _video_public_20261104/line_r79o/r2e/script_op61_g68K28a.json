 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他已经离开那段熟悉的生活，起初还觉得总算不用再一次次受委屈了",
       "keys": [
        "不用再一次次受委屈"
       ],
       "from": [
        "S01-1",
        "S01-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "强撑着提醒自己不能倒下，可心里其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里就空落落的，一时说不清到底舍不得什么",
       "keys": [
        "空落落的"
       ],
       "from": [
        "S01-2",
        "S01-B2",
        "S01-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉中醒来，四周又冷又空，胸口发紧、伸手只摸到空处",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "偶尔想起从前的日子，他还想往前过，却不知以后靠什么让自己安心",
       "keys": [
        "不知以后靠什么让自己安心"
       ],
       "from": [
        "S01-3",
        "S01-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "脑子还没想清楚，身体先隐约记起了怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前自在的时候，光想到以后不能再那样过，心里就有些慌",
       "keys": [
        "不能再那样过"
       ],
       "from": [
        "S02-1",
        "S02-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像腿脚发虚的人，还在记忆里勉强挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "呼吸像被催着一样，变得越来越急促",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "那份不舍一上来，他就赶紧提醒自己受过的气，怕心软忘了当初为什么走",
       "keys": [
        "受过的气"
       ],
       "from": [
        "S02-2",
        "S02-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像整理好衣服抬起头，不让人看出自己动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "一遍遍对自己说没事，说到后来反倒露出了自己有多在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "可他还是不甘心，难道为了不再受气，就得把以前的好日子也丢掉吗？",
       "keys": [
        "好日子"
       ],
       "from": [
        "S02-3",
        "S02-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "哪怕心里还在难受，也不甘心就这样垮下去",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他心里还憋着一股气，可想起从前有人拿他当自己人，竟又高兴了一小会儿",
       "keys": [
        "高兴了一小会儿"
       ],
       "from": [
        "S03-1",
        "S03-B1",
        "S03-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像回到故乡夏日的麦浪与微风里，温和又轻快",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像出去走走换个心情，轻松是真的，心结却还没解开",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "那点高兴还没退，他心里就发酸，从前那样的日子到底过不成了",
       "keys": [
        "过不成了"
       ],
       "from": [
        "S03-2",
        "S03-B2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可离开以后，日子就一定会更好过吗？",
       "keys": [
        "更好过吗"
       ],
       "from": [
        "S03-2",
        "S03-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "耳边像有人低声絮语，脚下像踩着流沙抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "我刚才是真信那些话，还是在勉强自己去信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想起从前亲近的日子，他一度真盼着还能那样相处",
       "keys": [
        "还能那样相处"
       ],
       "from": [
        "S04-1",
        "S04-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "表面还撑着从前坚定的样子，心却比以前更容易受伤了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可那份亲近刚鲜活起来，当初受过的委屈也跟着翻了上来",
       "keys": [
        "委屈"
       ],
       "from": [
        "S04-2",
        "S04-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "过去太好又回不去才最刺痛，像在拉扯中疲惫地步步后退",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他反复问自己，那一步走得对不对、后不后悔，要是没走如今又会怎样？",
       "keys": [
        "走得对不对、后不后悔"
       ],
       "from": [
        "S04-2",
        "S04-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像急促的脚步和乱了拍的心跳，被催着往前跑停不下来",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "脑子里还在问怎么会变成这样，不停往前赶只是不敢停下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他还是不服气，觉得当初那些气不该忍，可连开心的旧事都不敢想又太为难自己",
       "keys": [
        "太为难自己"
       ],
       "from": [
        "S05-1",
        "S05-B2",
        "S05-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里还憋着那股护住自己的劲：这件事不能就这么算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "让他惦记的像是某个人，又像是故乡或从前的日子",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他在心里跟自己争得没了力气，那股不服气的劲也渐渐淡了",
       "keys": [
        "没了力气"
       ],
       "from": [
        "S05-2",
        "S05-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "像脚下的地板忽然空了，只剩一个声音在自言自语",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "像长叹一口气松了下来，其实还没想通，只是争累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "这会儿想到自己已不在那些人身边，他只觉得难受",
       "keys": [
        "不在那些人身边"
       ],
       "from": [
        "S05-2",
        "S05-B3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "心里那阵难受慢慢缓下来，他又想起以前不用防备的日子，这回没拿受过的气压住想念",
       "keys": [
        "没拿受过的气压住想念"
       ],
       "from": [
        "S06-1",
        "S06-B1",
        "S06-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "世界像被透明玻璃罩隔开，像听着母亲哼摇篮曲，连呼吸都放轻",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "终于不用向人解释为什么难过，也不用再硬撑着装坚强",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "如今身边没了那些人，他才知道从前有人陪着能让自己轻松多少",
       "keys": [
        "能让自己轻松多少"
       ],
       "from": [
        "S06-1",
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他很想再过上那种不用多说也知道彼此亲近的日子，又怕以后再也没有了",
       "keys": [
        "彼此亲近的日子"
       ],
       "from": [
        "S06-3",
        "S06-B2",
        "S06-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像对着远方真切地祈求，却不知道会不会有回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "不过那样的日子毕竟真切过过，光是这么想着，他心里也暖和了一点",
       "keys": [
        "心里也暖和了一点"
       ],
       "from": [
        "S06-4",
        "S06-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "远去的家园像在梦里被照亮，虽然回不去，却远远看见了它",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "明知有些珍惜的事挽不回，便静静看着，不再急着抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心他却猛然想到，以后遇上难事要还得一个人顶着，自己真撑得住吗？",
       "keys": [
        "真撑得住吗"
       ],
       "from": [
        "S07-1",
        "S07-B1",
        "S07-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像寒风猛地吹开窗把人从好梦里拽醒，后颈一凉、脉搏乱跳",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "事情表面上好像过去了，心里却还翻腾着找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "走时他只想着别再受那些气，没料到会这么孤单，早知这样当初还会走吗？",
       "keys": [
        "当初还会走吗"
       ],
       "from": [
        "S07-2",
        "S07-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "一个熟悉的动作或舞步冷不防闯进来，反倒更看清失去了什么",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "如今他想找回从前那份亲近，又不甘心回去再受气，可连当初走时的决心也找不着了",
       "keys": [
        "找不着了"
       ],
       "from": [
        "S07-3",
        "S07-B2",
        "S07-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚才的思绪一下被打断，换了副热闹步子心里却安定不下来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他先把回去的事放一边，想起曾被当自己人心里一暖，却没因此想回头",
       "keys": [
        "没因此想回头"
       ],
       "from": [
        "S08-1",
        "S08-B1",
        "S08-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像准备离开的人在最后一刻回头，再看一眼待过的地方",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可暖意很快就淡了，真遇上难事回忆陪不了他，心又悬了起来",
       "keys": [
        "心又悬了起来"
       ],
       "from": [
        "S08-2",
        "S08-B2",
        "S08-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "激烈的思绪间胸口像终于吸进一口气，也只是瞬间的喘息",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他忽然说不清，想回去是舍不得被当自己人的日子，还是怕孤单到连那些气也肯再受",
       "keys": [
        "连那些气也肯再受"
       ],
       "from": [
        "S09-1",
        "S09-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从另一面又看见了当初那扇门，往前的步子还没聚起来",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "这念头让他一阵心慌，连再往下想都不敢了",
       "keys": [
        "连再往下想都不敢了"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像又遇见当初不知所措的自己，走过这一路问题还是没答案",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他最舍不得的还是曾被人当自己人，可真回去还能像从前那样吗？",
       "keys": [
        "还能像从前那样吗"
       ],
       "from": [
        "S10-1",
        "S10-B1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "何况难受的事不能当没发生过，光凭不舍，他还是没法放心回去",
       "keys": [
