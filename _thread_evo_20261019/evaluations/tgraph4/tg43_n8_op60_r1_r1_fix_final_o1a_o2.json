   ],
   "items_before_fix": [
    {
     "id": "I26",
     "text": "这份难堪没有让他不再喜欢，却使他不愿再用慷慨证明自己。",
     "key": "不再用慷慨证明",
     "kind": ""
    },
    {
     "id": "I27",
     "text": "他不想时时检查对方是否在意，也不逼自己变成完全没有期待的人。",
     "key": "不检查对方在意",
     "kind": "",
     "follows": true
    },
    {
     "id": "I28",
     "text": "他转而留心当下确实愿意给予的关切，不再忙着想两人以后会怎样。",
     "key": "只留心当下关切",
     "kind": "",
     "follows": true
    },
    {
     "id": "I29",
     "text": "他可以盼对方好、安静惦念，也因心里有这个人而生出柔和喜悦。",
     "key": "细细喜欢带来甜意",
     "kind": "",
     "follows": true
    },
    {
     "id": "I30",
     "text": "这种细细喜欢让他暂时忘了自己为何在意回应，只觉得它很甜。",
     "key": "暂忘为何在意回应",
     "kind": "",
     "follows": true
    }
   ],
   "relation_votes": {
    "没在想": 6
   },
   "relation_model": "没在想",
   "items_before_reorg": [
    {
     "id": "N25",
     "text": "这份难堪没让喜欢消失，却让他不想再靠慷慨证明自己有多真心。",
     "from": [
      "I22",
      "I23",
