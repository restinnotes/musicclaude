      "rel": "引用"
     },
     {
      "from": "S03-2",
      "to": "S03-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S04",
    "bars": "24–34",
    "relation": "正在面对",
    "items": [
     {
      "id": "S04-1",
      "text": "熟悉的亲近再一次变得格外动人，我想把眼前的好感受得再深一些。",
      "key": "熟悉的亲近再一次",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-1"
      ]
     },
     {
      "id": "S04-2",
      "text": "那份喜欢一度大到几乎让我忘记克制，转眼又因害怕承受不起而收住。",
      "key": "那份喜欢一度大到",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-1",
       "S01-2"
      ]
     },
     {
      "id": "S04-3",
      "text": "我越想靠克制替自己保留一点安稳，反而越觉得这份幸福脆弱。",
      "key": "我越想靠克制替自",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-2",
       "S03-3"
      ]
     },
     {
      "id": "S04-4",
      "text": "它明明还在让我幸福，我却已经隐约为它的短暂而难过。",
      "key": "它明明还在让我幸",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-1",
       "S04-3"
      ]
     }
    ],
    "because": [
     {
      "from": "S02-1",
      "to": "S04-1",
      "rel": "引用"
     },
     {
      "from": "S04-1",
      "to": "S04-2",
      "rel": "引用"
     },
     {
      "from": "S01-2",
      "to": "S04-2",
      "rel": "引用"
     },
     {
      "from": "S04-2",
      "to": "S04-3",
      "rel": "引用"
     },
     {
      "from": "S03-3",
      "to": "S04-3",
      "rel": "引用"
     },
     {
      "from": "S04-1",
      "to": "S04-4",
      "rel": "引用"
     },
     {
      "from": "S04-3",
      "to": "S04-4",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S05",
    "bars": "35–39",
    "relation": "正在面对",
    "items": [
     {
      "id": "S05-1",
      "text": "先前那种被幸福稳稳托住的感觉忽然松动，我一下不知道该把心放在哪里。",
      "key": "先前那种被幸福稳",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-3",
       "S02-1"
      ]
     },
     {
      "id": "S05-2",
      "text": "我发现自己光顾着预防以后会痛，已经不知不觉从眼前的快乐里退开了。",
      "key": "我发现自己光顾着",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1",
       "S02-2",
       "S04-3"
      ]
     },
     {
      "id": "S05-3",
      "text": "我试着不再这么用力防着，虽然一时还没底，心里却轻了一点。",
      "key": "我试着不再这么用",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S04-3",
      "to": "S05-1",
      "rel": "引用"
     },
     {
      "from": "S02-1",
