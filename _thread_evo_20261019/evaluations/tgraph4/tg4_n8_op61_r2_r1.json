    {
     "from": "I89",
     "to": "I102",
     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "214–215",
   "relation": "正在面对",
   "items": [
    {
     "id": "I103",
     "text": "安静退去后，他熟悉的迟疑又回来了。",
     "key": "迟疑又回来",
     "kind": ""
    },
    {
     "id": "I104",
     "text": "他仿佛走了很远仍回到原处。",
     "key": "回到原处",
     "kind": ""
    },
    {
     "id": "I105",
     "text": "他认出迟疑里有怯懦，也有不愿失去的生活希望。",
     "key": "生活希望",
     "kind": "分清"
    }
   ],
   "because": [
    {
     "from": "I94",
     "to": "I103",
     "rel": "仍在起作用"
    },
    {
     "from": "I4",
     "to": "I105",
     "rel": "改写"
    },
    {
     "from": "I62",
     "to": "I105",
     "rel": "提供理由"
    }
   ]
  },
  {
   "bars": "216–225",
   "relation": "正在面对",
   "items": [
    {
     "id": "I106",
     "text": "他知道舍不得什么后，仍没立刻勇敢起来。",
     "key": "没立刻勇敢",
     "kind": ""
    },
    {
     "id": "I107",
     "text": "他无法再只凭一股决心往前。",
     "key": "一股决心",
     "kind": "办法的限度"
    },
    {
     "id": "I108",
     "text": "他也无法再安心沉浸在旧愿里。",
     "key": "安心沉浸",
     "kind": "办法的限度"
    },
    {
     "id": "I109",
     "text": "他一时没力气再催自己做多大的改变。",
     "key": "一时没力气",
     "kind": ""
    },
    {
     "id": "I110",
     "text": "他希望争取时仍记得为何争取。",
     "key": "为何争取",
     "kind": ""
    },
    {
     "id": "I111",
     "text": "他希望爱惜安宁时也不放弃面对威胁。",
     "key": "面对威胁",
     "kind": ""
    },
    {
     "id": "I112",
     "text": "他还不知道怎样做到这两件事。",
     "key": "怎样做到",
     "kind": ""
    },
    {
     "id": "I113",
     "text": "他反复想着这个微弱的愿望。",
     "key": "微弱的愿望",
     "kind": ""
    },
    {
     "id": "I114",
     "text": "他心里非得舍弃一边的逼迫似乎轻了一些。",
     "key": "逼迫似乎",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I105",
     "to": "I106",
     "rel": "限制"
    },
    {
     "from": "I16",
     "to": "I107",
     "rel": "限制"
    },
    {
     "from": "I82",
     "to": "I108",
     "rel": "限制"
