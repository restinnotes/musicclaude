    },
    {
     "src": "SRC-gpt6w-web-3",
     "quote": "不是吵架，也不是离别",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt56w-web-2",
     "quote": "说过一句重要的话以后，一个人仍停留在那句话里面",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
