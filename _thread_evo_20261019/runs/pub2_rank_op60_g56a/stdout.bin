{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"groups\": [\n        {\n          \"label\": \"突然被点亮的心动\",\n          \"points\": [\"S01-B1-p1\", \"S01-B1-p2\", \"S01-B2-p1\"]\n        },\n        {\n          \"label\": \"尚未安稳、仍悬在半空\",\n          \"points\": [\"S01-B1-p3\", \"S01-B1-p4\", \"S01-B2-p2\", \"S01-B2-p3\"]\n        },\n        {\n          \"label\": \"想说却谨慎地停在开口之前\",\n          \"points\": [\"S01-B3-p1\", \"S01-B3-p2\"]\n        }\n      ],\n      \"tier_a\": [\"S01-B3-p2\"],\n      \"tier_b\": [\"S01-B1-p2\", \"S01-B2-p1\", \"S01-B3-p1\", \"S01-B1-p3\"],\n      \"only_one\": \"S01-B3-p2\",\n      \"line_order\": [\"S01-1\", \"S01-2\", \"S01-3\"],\n      \"line_a\": [\"S01-1\"]\n    },\n    {\n      \"sec\": \"S02\",\n      \"groups\": [\n        {\n          \"label\": \"贴近而安稳的亲密\",\n          \"points\": [\"S02-B1-p1\", \"S02-B1-p2\", \"S02-B1-p3\"]\n        },\n        {\n          \"label\": \"温热、黏稠的身体温存\",\n          \"points\": [\"S02-B1-p4\"]\n        },\n        {\n          \"label\": \"放下控制、把自己交给温柔的托举\",\n          \"points\": [\"S02-B2-p1\", \"S02-B2-p2\"]\n        },\n        {\n          \"label\": \"舒服地漂着，却感觉时间仍在流走\",\n          \"points\": [\"S02-B2-p3\"]\n        },\n        {\n          \"label\": \"感情短暂涌起，又轻轻收回\",\n          \"points\": [\"S02-B3-p1\", \"S02-B3-p2\", \"S02-B3-p3\"]\n        },\n        {\n          \"label\": \"甜蜜中已经生出舍不得\",\n          \"points\": [\"S02-B4-p1\", \"S02-B4-p2\", \"S02-B4-p3\"]\n        }\n      ],\n      \"tier_a\": [\"S02-B1-p1\", \"S02-B4-p2\"],\n      \"tier_b\": [\"S02-B1-p2\", \"S02-B1-p3\", \"S02-B2-p2\", \"S02-B2-p3\", \"S02-B3-p1\", \"S02-B3-p2\", \"S02-B4-p3\"],\n      \"only_one\": \"S02-B4-p2\",\n      \"line_order\": [\"S02-1\", \"S02-2\", \"S02-3\"],\n      \"line_a\": [\"S02-1\", \"S02-3\"]\n    },\n    {\n      \"sec\": \"S03\",\n      \"groups\": [\n        {\n          \"label\": \"安稳漂浮，不必去哪里\",\n          \"points\": [\"S03-B1-p1\