{"completed": true, "response": "<escape>{\n  \"items\": [\n    {\n      \"id\": \"S04-1\",\n      \"text\": \"他知道，对方也没答应过他什么。\",\n      \"key\": \"没答应过他什么\",\n      \"follows\": false,\n      \"src\": [\"S04-1\"]\n    },\n    {\n      \"id\": \"S04-2\",\n      \"text\": \"他把心思转去替对方高兴。\",\n      \"key\": \"替对方高兴\",\n      \"follows\": true,\n      \"src\": [\"S04-2\"]\n    },\n    {\n      \"id\": \"S04-3\",\n      \"text\": \"他告诉自己，真心盼对方好，自己也会开心。\",\n      \"key\": \"真心盼对方好\",\n      \"follows\": true,\n      \"src\": [\"S04-2\"]\n    },\n    {\n      \"id\": \"S04-4\",\n      \"text\": \"他暂时没那么担心自己在对方心里是否特别。\",\n      \"key\": \"是否特别\",\n      \"follows\": true,\n      \"src\": [\"S04-2\"]\n    },\n    {\n      \"id\": \"S04-5\",\n      \"text\": \"他不怕显得更在乎。\",\n      \"key\": \"不怕显得更在乎\",\n      \"follows\": true,\n      \"src\": [\"S04-2\"]\n    },\n    {\n      \"id\": \"S04-6\",\n      \"text\": \"他觉得自己还有许多心意可给。\",\n      \"key\": \"许多心意可给\",\n      \"follows\": false,\n      \"src\": [\"S04-2\"]\n    },\n    {\n      \"id\": \"S04-7\",\n      \"text\": \"他便放开些去喜欢。\",\n      \"key\": \"放开些去喜欢\",\n      \"follows\": true,\n      \"src\": [\"S04-2\"]\n    },\n    {\n      \"id\": \"S04-8\",\n      \"text\": \"他反倒更舍不得这一刻过去。\",\n      \"key\": \"舍不得这一刻过去\",\n      \"follows\": true,\n      \"src\": [\"S04-2\"]\n    },\n    {\n      \"id\": \"S04-9\",\n      \"text\": \"他怕自己的热切成了催促。\",\n      \"key\": \"成了催促\",\n      \"follows\": false,\n      \"src\": [\"S04-2\"]\n    },\n    {\n      \"id\": \"S04-10\",\n      \"text\": \"他只好把热切收住一点。\",\n      \"key\": \"收住一点\",\n      \"follows\": true,\n      \"src\": [\"S04-2\"]\n    },\n    {\n      \"id\": \"S04-11\",\n      \"text\": \"他把这阵轻松当成保证，以为尽情喜欢也不会失去眼前的亲近。\",\n      \"key\": \"当成保证\",\n      \"follows\": false,\n      \"src\": [\"S04-5\"]\n    }\n  ],\n  \"because\": [\n    {\n      \"from\": \"S03-3\",\n      \"to\": \"S04-1\",\n      \"rel\": \"说明\"\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "2b7ac0