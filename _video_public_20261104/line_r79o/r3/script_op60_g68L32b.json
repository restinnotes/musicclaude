       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像扎了根温柔的刺，眼前的好还在却已经有点鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
