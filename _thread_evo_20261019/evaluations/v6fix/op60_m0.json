   {
    "sec": "S14",
    "bars": "111–116",
    "relation": "正在面对",
    "items": [
     {
      "id": "I113",
      "text": "强烈情绪渐渐平缓，依恋却没减轻",
      "key": "依恋却没减轻",
      "follows": null
     },
     {
      "id": "I114",
      "text": "他已无法像起初那样轻松，仿佛幸福没有代价",
      "key": "幸福没有代价",
      "follows": null
     },
     {
      "id": "I115",
      "text": "他如今爱得更深，也更容易难受",
      "key": "更容易难受",
      "follows": null
     },
     {
      "id": "I116",
      "text": "得到过的快乐让他无法后悔敞开",
      "key": "无法后悔敞开",
      "follows": null
     },
     {
      "id": "I117",
      "text": "他不愿少爱一点来减少牵挂",
      "key": "减少牵挂",
      "follows": null
     },
     {
      "id": "I118",
      "text": "他不愿因终究留不住就轻看此刻幸福",
      "key": "轻看此刻幸福",
      "follows": null
     },
     {
      "id": "I119",
      "text": "他甚至比先前更喜欢那个人",
      "key": "比先前更喜欢",
      "follows": null
     },
     {
      "id": "I120",
      "text": "即使美好时刻不能停留，他仍想完整地爱",
      "key": "完整地爱",
      "follows": null
     }
