 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他离开熟悉生活，起初以为终于不用委屈自己；笃定很快松动，心里空落落的，说不清舍不得什么。",
       "keys": [
        "不用委屈自己",
        "说不清舍不得什么"
       ],
       "from": [
        "S01-1",
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头沉重和弦像宣告或召唤；自由上行琶音如烟雾散向高处，停顿里还等着回声",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "挺直背脊，尊严还在，心却没方向也没力气：不能倒下，又想停；刚站定又飘起来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "短句像叹息，被长停顿截断，余音散在冷空气里；分不清愤怒、遗憾还是怀念，连气谁、想谁都说不清",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "像从昏沉中醒来：四周冷空，胸口发紧、视线模糊，颤手摸到虚空；还没哭，连身在何处都不清",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "偶尔想起从前熟悉的日子，他仍想往前过，却不知以后靠什么安下心。",
       "keys": [
        "仍想往前过",
        "不知以后靠什么安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧场景忽然清晰，声音、光线和熟悉感都回来；可过去不会变回现在",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "波兰舞曲步态渐显，像身体先记起迈步；主题要到第24小节才站稳",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前那些自在时光，一想到以后不能再那样过，心里就慌。",
       "keys": [
        "舍不得从前那些自在时光",
        "心里就慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "步态清楚，却不像凯旋，旋律像远处旧歌，只能模糊哼几句；外层舞步庄严傲慢，里层歌声低哼，珍惜的东西似乎还在，却不能照旧拥有。旋律脆弱凄婉，不像士兵齐步，倒像腿脚发虚挪步，伴奏半音蠕动",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "舍不得一上来，他赶紧提醒自己受过的气，怕忘了当初为何离开。",
       "keys": [
        "提醒自己受过的气",
        "忘了当初为何离开"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "音乐猛推又退，随后再聚力，气氛更焦灼；连绵三连音催急呼吸，最后仍没落稳",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "整理衣服、抬起头，像强烈自控；反复说“我没事”：先还信，再努力信，第三遍连重复都露出在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他仍不甘心：难道不再受气，就得把以前的好日子也丢掉？",
       "keys": [
        "仍不甘心",
        "以前的好日子"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "激昂像在喊“我不甘心就这样消亡”；这是硬撑着抵抗，也和自我控制同时存在",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "憋着气，想起被当作自己人，竟短暂高兴。",
       "keys": [
        "憋着气",
        "被当作自己人"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "第66小节和弦若突出，像重锤；忽强忽弱、切分让心一悬，舞步流动不安，方向难定",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "前段焦躁急切",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "后段柔和轻盈，像故乡夏日麦浪微风，也像从前自在亲近的时刻；温柔得心颤，也因离眼前太远而刺痛",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "那点高兴未退，他已心酸：从前回不来，离开后就一定更好吗？",
       "keys": [
        "那点高兴未退",
        "离开后就一定更好吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "活动感像暂避伤口，出去走走、聊别的；轻松是真的，却没答案。昂扬退潮后问：刚才真信了，还是努力信",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "耳边几人低语缠绕；调性如流沙，抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想起从前亲近的日子，盼还能相处。",
       "keys": [
        "从前亲近的日子",
        "盼还能相处"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "主题重现，流动伴奏和装饰音像独自诉说；旧日亲密、感激、柔情、短暂幸福鲜活，步子向前却柔软易伤，心里回声更多；坚定也许只是他想成为的样子",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "亲近越鲜活，委屈越翻上来：走对了吗？后悔吗？若没走会怎样？",
       "keys": [
        "亲近越鲜活",
        "若没走会怎样"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "温暖没带来安稳；风暴骤起，越用力越不稳。记忆刺痛，只因太好、回不来了；半音下行像撕扯后退，抵抗又累又急",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "细碎音符像急促脚步、乱拍心跳；低音追赶、右手挣扎，像被时间催跑",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "反复问“如果当时……”“是不是还可以……”，思绪盘旋，不肯停",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他仍不服气，觉得当初那些气不该忍；可连过去开心的事都不敢多想，也太为难自己了。",
       "keys": [
        "那些气不该忍",
        "过去开心的事"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "第116小节像换了个人开口，歌唱柔和克制；两只手仿佛夜色里两个影子，彼此低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "柔和歌唱仍被压力推着走，像在说“这事不能就这样算了”；愤怒、悲伤和替自己争口气都在",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "旧日记忆重新有了温度，可能是某个人、故乡或过去的生活；眷恋里仍带失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争得没了力气，那股不服气渐渐淡了；想到如今已不在那些人身边，只觉得难受。",
       "keys": [
        "没了力气",
        "只觉得难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "快速音型渐慢、变稀，化成疏落和弦",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "旋律几乎独自露出，像脚下地板忽然消失，只剩一个声音说话",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "躁动和不安又加深；后来像几次深呼吸或深叹，紧绷短暂松开，更像抵抗累了，不是想通了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "难受缓下来，他想起从前在一起、不必时时防备；这回没拿受过的气压住想念。",
       "keys": [
        "不必时时防备",
        "没拿受过的气压住想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "静得呼吸放轻，像隔着透明玻璃，也像母亲在耳边轻哼的摇篮曲；圣咏般庄严，藏着心愿，不用解释难过、装坚强，委屈想念浮上来。向未知远方祈求，却无回应保证；安宁短暂，现实未必变好",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "如今遇难事，他常独自扛着，才知从前有人在身边多轻松。",
       "keys": [
        "独自扛着",
        "有人在身边多轻松"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "远方忽然亮起，梦里的家园显现；看得见，却回不去",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想再过那种不用多说就知道彼此亲近的日子，又怕再也没有了。",
       "keys": [
        "不用多说就知道彼此亲近",
        "又怕再也没有了"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "还含蓄试探",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "歌唱逐渐展开，像终于鼓起勇气开口",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "再次展开更充实迫切，近尾声像停在没说完的话上",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "那样的日子毕竟真真切切过过，想起来心里暖了一点。",
       "keys": [
        "真真切切过过",
        "心里暖了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "明知有些事挽不回，便放轻声音看着珍惜的东西，不必马上抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，他忽然想到：以后遇难事还得独自扛，他真撑得住吗？",
       "keys": [
        "独自扛",
        "他真撑得住吗"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "高音长颤音细如游丝却刺骨，像寒风猛地吹开窗，把人从甜梦拽回严寒；后颈发凉，脉搏猛跳，身体先惊醒",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "马祖卡舞步闯入，截断祈祷般静谧，像换了场景；舞步鲜明，心却未必安定",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "当初只想着别再受气，没料到这么孤单；早知道，还会走吗？",
       "keys": [
        "没料到这么孤单",
        "早知道，还会走吗"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的动作、舞蹈或日常忽然闯入；亲切未必安慰，细节反让失去更清楚",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      },
      {
       "text": "颤音让紧张层层累积，思绪翻转停不住；事情像过去了，身体却不信，想冲出去又找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想找回亲近，又不甘心回去受气，连当初离开的决心也找不着了。",
       "keys": [
        "想找回亲近",
        "离开的决心也找不着了"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "先前宣告般的波兰舞曲气息再现，却不再完整鲜明，立不起秩序",
       "keys": [],
       "from": [
        "S07-B5"
       ],
       "bead": "S07-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他先把回去放一边，想起曾被当作自己人，心暖了会儿，却没想回头。",
       "keys": [
        "把回去放一边",
        "没想回头"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "缓慢宽广的歌唱短暂回来，沉思如祈求；像离开前回望，温柔又不舍",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "暖意很快淡了；回忆陪不了未来的难处，心又悬起。",
       "keys": [
        "回忆陪不了未来的难处",
        "心又悬起"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "激烈思绪间，胸口像吸进一口气，只是瞬间喘息",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
