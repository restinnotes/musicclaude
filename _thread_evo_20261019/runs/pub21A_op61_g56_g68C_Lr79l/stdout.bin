     {\n          \"text\": \"可越想念从前\",\n          \"point\": \"怀疑当初那一步\",\n          \"where\": \"后\",\n          \"waste\": \"会\",\n          \"keep\": \"越想念从前\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"可正因已经过去，眷恋里也带着失落\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"因已过去\"\n        },\n        {\n          \"quote\": \"像脚下原有的地板忽然不见了，只剩一个声音自己说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"独自说话\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"并非想通\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他不服气，受过的气\",\n          \"point\": \"受过的气不该忍，开心的事也不该抹掉\",\n          \"where\": \"中\",\n          \"waste\": \"他不服气\",\n          \"keep\": \"受过的气不该忍\"\n        },\n        {\n          \"text\": \"他在心里争来争去\",\n          \"point\": \"没了力气才发现自己已不在那些人身边\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"争来争去\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不惊动它\"\n        },\n        {\n          \"quote\": \"它像是一个人终于不用再向别人解释自己为什么难过，也不必维持“我应该坚强”的姿态\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"向别人解释\"\n        },\n        {\n          \"quote\": \"音乐却没有许诺回应\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"这回想起从前\",\n          \"point\": \"没急