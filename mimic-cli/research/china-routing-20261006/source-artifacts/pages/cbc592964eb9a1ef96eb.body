<style>
  html,
  body {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  :root {
    --er-navy: #0d2b45;
    --er-navy-deep: #071825;
    --er-navy-mid: #0f3554;
    --er-teal: #007a90;
    --er-teal-bright: #00b8d4;
    --er-gold: #d6ad4f;
    --er-gold-soft: #f1de9a;
    --er-gold-deep: #b98c2c;
    --er-off: #eef3f7;
    --er-border: rgba(255, 255, 255, 0.08);
  }

  .er-header {
    position: fixed;
    inset: 0 0 auto 0;
    width: 100%;
    max-width: 100vw;
    z-index: 500;
    background: var(--er-navy);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 16px 42px rgba(2, 13, 24, 0.22);
    overflow: visible;
    visibility: visible;
  }

  .er-header__inner {
    width: 100%;
    max-width: 100vw;
    overflow: visible;
  }

  .er-nav-inner {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    height: 68px;
    gap: 18px;
    min-width: 0;
  }

  .er-nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    margin-right: 24px;
  }

  .er-nav-logo img {
    height: 32px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }

  .er-nav-desktop {
    flex: 1;
    min-width: 0;
  }

  .er-nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    flex-wrap: nowrap;
  }

  .er-nav-links > li {
    position: relative;
    min-width: 0;
  }

  .er-nav-link-featured {
    position: relative;
    display: inline-flex !important;
    align-items: center;
    height: 68px;
    padding: 0 15px 0 14px !important;
    text-decoration: none;
  }

  .er-nav-link-featured__text {
    display: inline-block;
    line-height: 1.05;
  }

  .er-nav-link-featured__badge {
    position: absolute;
    top: 7px;
    left: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 16px;
    padding: 0 6px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(214, 173, 79, 0.24) 0%, rgba(214, 173, 79, 0.12) 100%);
    border: 1px solid rgba(214, 173, 79, 0.38);
    color: var(--er-gold-soft);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .er-nav-link-featured__text {
    margin-top: 0;
  }

  .er-nav-links > li > a,
  .er-nav-links > li > button {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 68px;
    padding: 8px 13px;
    border: none;
    background: none;
    color: rgba(255, 255, 255, 0.74);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.01em;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .er-nav-links > li > a:hover,
  .er-nav-links > li > button:hover,
  .er-nav-links > li:hover > a,
  .er-nav-links > li:hover > button,
  .er-nav-links > li.er-nav-item--open > button {
    color: #fff;
  }

  .er-nav-chevron {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    opacity: 0.55;
    transition: transform 0.22s ease, opacity 0.22s ease;
  }

  .er-nav-item:hover .er-nav-chevron,
  .er-nav-item.er-nav-item--open .er-nav-chevron {
    transform: rotate(180deg);
    opacity: 0.9;
  }

  .er-nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    flex-shrink: 0;
    min-width: 0;
  }

  .er-nav-search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.55);
    font-size: 12.5px;
    font-weight: 300;
    padding: 7px 14px;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    min-width: 0;
    max-width: 180px;
    overflow: hidden;
  }

  .er-nav-search-trigger:hover {
    background: rgba(255, 255, 255, 0.11);
    border-color: rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.85);
  }

  .er-kbd {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.45);
    padding: 1px 6px;
  }

  .er-nav-action-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 2px;
    border: 1px solid rgba(214, 173, 79, 0.34);
    background: linear-gradient(180deg, var(--er-gold-soft) 0%, var(--er-gold) 100%);
    color: #10263b;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .er-nav-action-button:hover {
    background: linear-gradient(180deg, #f6e7b2 0%, #ddb55b 100%);
    border-color: rgba(221, 181, 91, 0.55);
    color: #10263b;
    transform: translateY(-1px);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.22);
  }

  .er-nav-search-mobile,
  .er-nav-hamburger {
    display: none;
    border: none;
    background: none;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    padding: 6px;
    flex-shrink: 0;
  }

  .er-nav-dropdown,
  .er-mega-wrap {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s ease;
  }

  .er-nav-item:hover .er-nav-dropdown,
  .er-nav-item.er-nav-item--open .er-nav-dropdown,
  .er-nav-item:hover .er-mega-wrap,
  .er-nav-item.er-nav-item--open .er-mega-wrap {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .er-nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 240px;
    padding: 8px 0;
    background: var(--er-navy-deep);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-top: 2px solid var(--er-teal-bright);
    box-shadow: 0 24px 56px rgba(0, 0, 0, 0.55);
    transform: translateY(-6px);
    z-index: 400;
  }

  .er-nav-item:hover .er-nav-dropdown,
  .er-nav-item.er-nav-item--open .er-nav-dropdown {
    transform: translateY(0);
  }

  .er-nav-dropdown--right {
    left: auto;
    right: 0;
  }

  .er-dd-label {
    padding: 10px 20px 6px;
    color: var(--er-teal-bright);
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .er-dd-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .er-dd-item:hover {
    background: rgba(0, 122, 144, 0.08);
  }

  .er-dd-icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: rgba(0, 122, 144, 0.1);
    border: 1px solid rgba(0, 122, 144, 0.2);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .er-dd-item:hover .er-dd-icon {
    background: rgba(0, 122, 144, 0.2);
    border-color: rgba(0, 184, 212, 0.35);
  }

  .er-dd-title {
    color: rgba(255, 255, 255, 0.82);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
  }

  .er-dd-desc {
    color: rgba(255, 255, 255, 0.42);
    font-size: 11px;
    font-weight: 300;
    line-height: 1.45;
    margin-top: 2px;
  }

  .er-dd-item:hover .er-dd-title {
    color: #fff;
  }

  .er-dd-footer {
    margin: 6px 12px 8px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(0, 122, 144, 0.1);
    border: 1px solid rgba(0, 122, 144, 0.2);
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .er-dd-footer:hover {
    background: rgba(0, 122, 144, 0.2);
  }

  .er-dd-footer__label {
    color: var(--er-teal-bright);
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .er-dd-footer__arrow {
    color: var(--er-teal-bright);
    font-size: 16px;
    line-height: 1;
  }

  .er-mega-wrap {
    position: absolute;
    top: 100%;
    left: 50%;
    width: min(1080px, 96vw);
    display: flex;
    flex-direction: column;
    background: var(--er-navy-deep);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-top: 2px solid var(--er-teal-bright);
    box-shadow: 0 28px 72px rgba(0, 0, 0, 0.65);
    transform: translateX(-50%) translateY(-8px);
    z-index: 380;
