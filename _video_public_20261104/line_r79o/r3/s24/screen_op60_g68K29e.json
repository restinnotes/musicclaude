       "from": [
        "S12-B1"
       ],
       "bars": "93-102",
       "at": 18.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "他明知再用心，也没法保证以后还这么好",
     "keys": [
      "没法保证以后还这么好"
     ],
     "emotion": "悬着",
     "from": [
      "S12-2"
     ],
     "at": 5.0
    },
    {
     "kind": "line",
     "text": "眼下这样的日子还是不够，他还想多陪对方一会儿",
