    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

<style>
  /* Critical header shell styles loaded before header markup to reduce flash */
  .er-header {
    position: fixed;
    inset: 0 0 auto 0;
    width: 100%;
    max-width: 100vw;
    z-index: 500;
    background: #0d2b45;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 16px 42px rgba(2, 13, 24, 0.22);
    overflow: visible;
    visibility: hidden;
  }

  .er-header__inner {
    width: 100%;
    max-width: 100vw;
    overflow: visible;
  }

  .er-nav-inner {
    width: 100%;
    max-width: 1180px;
    min-height: 68px;
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .er-nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    margin-right: 24px;
  }

  .er-nav-logo img {
    display: block;
    width: auto;
    height: 32px;
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }

  .er-nav-desktop {
    flex: 1;
  }

  .er-nav-links {
    display: flex;
    align-items: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .er-nav-links > li > a,
  .er-nav-links > li > button {
    display: flex;
    align-items: center;
    gap: 5px;
    min-height: 68px;
    padding: 8px 13px;
    border: none;
    background: none;
    color: rgba(255, 255, 255, 0.74);
    text-decoration: none;
