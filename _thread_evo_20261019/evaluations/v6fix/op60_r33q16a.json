      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "78–83",
    "relation": "正在面对",
    "items": [
     {
      "id": "S10-1",
      "text": "他想到对方也有自己的心思，并不是每件事都要由自己参与；可这并没有抹掉彼此的亲近。",
      "key": "他想到对方也有自",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S08-2"
      ]
     },
     {
      "id": "S10-2",
      "text": "他不必把对方的每一份心事都弄明白，也仍然可以珍惜这份相互依靠；想到这里，他心里忽然轻了一阵。",
      "key": "他不必把对方的每",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-1"
      ]
     }
    ],
    "because": [
     {
