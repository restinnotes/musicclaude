e\u003cspan style=\"white-space: pre-wrap;\"\u003e23%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e25%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e17%\u003c/span\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr class=\"border-b border-gray-300 dark:border-gray-600\"\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eMotorola\u003c/span\u003e\u003c/th\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e6%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e6%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e8%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e9%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e11%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e9%\u003c/span\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr class=\"border-b border-gray-300 dark:border-gray-600\"\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eGoogle\u003c/span\u003e\u003c/th\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e4%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e5%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e2%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e3%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e3%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e3%\u003c/span\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr class=\"border-b border-gray-300 dark:border-gray-600\"\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eOthers\u003c/span\u003e\u003c/th\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e16%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e11%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e11%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e10%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e8%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e9%\u003c/span\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003cp class=\"mb-2 relative\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e**Ranking is according to the latest quarter.\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\"text-2xl font-bold dark:text-white\"\u003e\u003cbr\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eQ3 2023 Highlights\u003c/span\u003e\u003c/h2\u003e\u003cfigure class=\"editor-image\" style=\"width: 100%;\"\u003e\u003cimg src=\"https://static.counterpointresearch.com/statics/images/admin/6afd8df0-ebc2-11f0-a69e-bf8970a85209.jpg\" alt=\"Source: Counterpoint Research\" data-caption=\"Source: Counterpoint Research\" class=\"w-full h-full\" data-full-width=\"true\"\u003e\u003cfigcaption data-caption=\"Source: Counterpoint Research\" class=\"text-sm text-gray-600 mt-2 text-center\"\u003eSource: Counterpoint Research\u003c/figcaption\u003e\u003c/figure\u003e\u003cp class=\"mb-2 relative\"\u003e\u003cbr\u003e\u003c/p\u003e\u003ch2 class=\"text-2xl font-bold dark:text-white\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eMarket Highlights\u003c/span\u003e\u003c/h2\u003e\u003cp class=\"mb-2 relative\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e• US smartphone shipments declined YoY for the fourth straight quarter in Q3 2023 amid weak consumer demand.\u003c/span\u003e\u003cbr\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e• Google, Samsung and TCL were among the brands recording the steepest YoY declines, while Motorola and Nokia HMD managed growth amid a challenging market environment. Motorola increased its shipment share to 11% in Q3.\u003c/span\u003e\u003cbr\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e• Apple’s iPhone shipments declined 11% YoY, in part due to the later launch date of the iPhone 15 series compared to the iPhone 14 series. Its sales share dropped to 53% in Q3 from 55% in Q2.\u003c/span\u003e\u003cbr\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e• Weak upgrade rates at the carriers were the main source of weak smartphone shipments, signaling that consumers are opting to hold on to their devices for longer.\u003c/span\u003e\u003c/p\u003e\u003ch3 class=\"text-xl font-bold dark:text-white\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eUS Smartphone Shipments Market Share (%)\u003c/span\u003e\u003c/h3\u003e\u003ctable class=\"border-collapse w-full my-4 border border-gray-300 dark:border-gray-600\" style=\"width: 100%;\"\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003ccol\u003e\u003ccol\u003e\u003ccol\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr class=\"border-b border-gray-300 dark:border-gray-600\"\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eBrands\u003c/span\u003e\u003c/th\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eQ2 2022\u003c/span\u003e\u003c/th\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eQ3 2022\u003c/span\u003e\u003c/th\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eQ4 2022\u003c/span\u003e\u003c/th\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eQ1 2023\u003c/span\u003e\u003c/th\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eQ2 2023\u003c/span\u003e\u003c/th\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eQ3 2023\u003c/span\u003e\u003c/th\u003e\u003c/tr\u003e\u003ctr class=\"border-b border-gray-300 dark:border-gray-600\"\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eApple\u003c/span\u003e\u003c/th\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e48%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e50%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e57%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e52%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e55%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e53%\u003c/span\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr class=\"border-b border-gray-300 dark:border-gray-600\"\u003e\u003cth class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px] bg-gray-50 dark:bg-gray-700 font-semibold\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start; background-color: rgb(242, 243, 245);\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eSamsung\u003c/span\u003e\u003c/th\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e30%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e24%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e20%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e27%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-2 text-left border border-gray-300 dark:border-gray-600 min-w-[100px]\" style=\"border: 1px solid black; width: 75px; vertical-align: top; text-align: start;\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003e23%\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"px-3 py-