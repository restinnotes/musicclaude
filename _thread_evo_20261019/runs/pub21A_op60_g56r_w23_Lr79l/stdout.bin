变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"快感也混在其中\"\n        },\n        {\n          \"quote\": \"音乐并没有彻底变暗，美也没有消失\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"美还在\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起这些日子对方总愿意跟他待在一起\",\n          \"point\": \"也许对方有时也需要他陪着\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"跟他在一起也能安心些\"\n        },\n        {\n          \"text\": \"这个念头让他高兴得有点收不住\",\n          \"point\": \"越舍不得从这份欢喜里抽身\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"越想着两个人这样亲近\"\n        },\n        {\n          \"text\": \"他真盼着\",\n          \"point\": \"往后对方想找人陪时还会想到自己\",\n          \"where\": \"中\",\n          \"waste\": \"他真盼着\",\n          \"keep\": \"自己也能一直陪在身边\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"没有哲学，没有防卫，没有分析\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连身体也像恢复了弹性，甚至带一点玩心；这份灵动，也像轻快的调情与回应\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正当你以为它还会继续唱下去，它却戛然而止，转入片刻静意\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"唱到一半忽然停\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"上回他无意间露了心意\",\n          \"point\": \"想主动些，大大方方地回应\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"见对方依然亲近\"\n        },\n        {\n          \"text\": \"这样想着\",\n          \"point\": \"觉得两个人说不定还能这么好很久\",\n          \"where\": \"后\",\n          \"waste\": \"这样想着\",\n          \"keep\": \"连往后的日子都开始盼了\"\n        },\n        {\n          \"text\": \"可