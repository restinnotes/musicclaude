count_unequal_text":"\u003c0\u003e您在\u003c/0\u003e\u003c1\u003e{{host}}\u003c/1\u003e\u003c2\u003e已登录其他账号，需要先点击下方的登出按钮以继续操作。\u003c/2\u003e","logout":"登出","accountTitle":"Bambu Lab \u0026 MakerWorld 账号","verificationCodeDialog":{"title":"验证码","content":"为确保您的账户安全，请输入发送至 {{account}} 的验证码。"},"mwStore":{"mw_creator_alliance":"MakerMarket 联盟","title":"\u003ckeywords\u003e欢迎来到\u003c/keywords\u003e\nMakerMarket 联盟","trackOrder":"查询订单","desc":{"1":"{{sellerName}} 由 MakerMarket 提供支持。","2":"注册/登录你的 MakerMarket 联盟账户，即可访问所有设计师店铺。","3":"查询订单、管理售后，并享受专属权益。","4":"你的数据和订单将依据 GDPR 受到保护。"},"iconDesc":{"1":"隐私安全","2":"可靠配送","3":"按需制作","4":"高品质保障"}},"delete":{"firstPage":{"title":"注销账号","desc":"我们很遗憾得知您要离开。在确认继续前，请知悉以下后果：","notice":"\u003cul\u003e\u003cli\u003e您的账号一经注销，与该账号关联的邮箱地址将无法在30天内用于注册新账号。\u003c/li\u003e\u003cli\u003e所有个人数据将被永久注销且无法恢复，包括：\u003cul\u003e\u003cli\u003e您在MakerWorld站内的全部数据\u003c/li\u003e\u003cli\u003e您在Bambu Lab官网上的全部数据\u003c/li\u003e\u003cli\u003e您在Bambu Lab商店中的全部数据\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e","reminder":"更多详情请阅读 \u003creminderLink\u003e《账号注销须知》\u003c/reminderLink\u003e","nextStepDesc":"如果您已确定要注销该账号，我们需要先对您进行身份验证。","continueText":"继续前往验证"},"verify":{"verify":"验证","otherLabel":"其他验证方式","change":"更换验证方式","resend":"重新发送","otherButton":{"email":"通过电子邮件验证","twoFactor":"通过双因素认证验证","phone":"通过手机验证"},"password":{"title":"身份验证","desc":"为保障您的账户安全，Bambu 需在继续操作前对您进行身份验证。","label":"请输入您的密码"},"email":{"title":"通过电子邮件验证","desc":"含有验证码的邮件已发送至您的注册邮箱： \u003caccount\u003e{{account}}\u003c/account\u003e","enterCode":"输入验证码"},"phone":{"title":"通过手机验证","desc":"一条包含验证码的消息已发送到您的手机号码：\u003caccount\u003e{{account}}\u003c/account\u003e","enterCode":"输入验证码"},"twoFactor":{"title":"通过双因素认证验证","desc":"请输入从身份认证App（如Google Authenticator, Duo Mobile）中获得的\u003cb\u003e6位验证码\u003c/b\u003e。"}},"finalPage":{"title":"注销账户 - 最终确认","desc":"继续注销流程即视为您已确认并同意以下事项：","notice":"\u003cul\u003e\u003cli\u003e您理解\u003cred\u003e该操作无法被撤销\u003c/red\u003e。\u003c/li\u003e\u003cli\u003e您理解该账号关联的邮箱地址将无法在30天内用于注册新账号。\u003c/li\u003e\u003cli\u003e您将\u003cred\u003e永久失去以下所有信息：\u003c/red\u003e\u003cul\u003e\u003cli\u003e您在MakerWorld站内的全部数据\u003c/li\u003e\u003cli\u003e您在Bambu Lab官网上的全部数据\u003c/li\u003e\u003cli\u003e您在Bambu Lab商店中的全部数据\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003e您已查阅\u003creminderLink\u003e《账号注销须知》\u003c/reminderLink\u003e。\u003c/li\u003e\u003c/ul\u003e","agree":"我已阅读并同意 \u003cterm\u003e《账号注销条例》\u003c/term\u003e","deleteButton":"注销我的账号"},"final":{"title":"删除您的 Bambu Lab 和 MakerWorld 账户","desc":"请仔细阅读以下内容：","notice":"您正在尝试删除您的 Bambu Lab 和 MakerWorld 账户，该账户用于访问各种 \u003cproductOrServicesLink\u003eBambu Lab 产品或服务\u003c/productOrServicesLink\u003e。一旦删除，您将无法继续使用任何这些产品或服务，您的账户及数据将被永久删除。请注意，账户删除后的 30 天内，您将无法使用同一电子邮箱地址重新注册新账户。","agree1":"我已阅读\u003cafterDeleteLink\u003e删除 Bambu Lab 和 MakerWorld 账户后的影响说明\u003c/afterDeleteLink\u003e。","agree2":"我确认希望永久删除 Bambu Lab 和 MakerWorld 账户及其所有数据。","deleteButton":"删除我的账户"}}},"area":{"name":{"AT":"奥地利","BE":"比利时","BG":"保加利亚","HR":"克罗地亚","CY":"塞浦路斯","CZ":"捷克","DE":"德国","DK":"丹麦","EE":"爱沙尼亚","FI":"芬兰","FR":"法国","GR":"希腊","HU":"匈牙利","IE":"爱尔兰","IT":"意大利","LV":"拉脱维亚","LT":"立陶宛","LU":"卢森堡","MT":"马耳他","NL":"荷兰","PL":"波兰","PT":"葡萄牙","RO":"罗马尼亚","SK":"斯洛伐克","SI":"斯洛文尼亚","ES":"西班牙","SE":"瑞典","US":"美国","CA":"加拿大"}},"store":{"usa":"美国","eu":"欧洲","ca":"加拿大","uk":"英国","au":"澳大利亚","jp":"日本","kr":"韩国","asia":"亚洲"},"common":{"complete":"完成","mins":"分钟","showMore":"展开","showLess":"收起","reason":"原因","more":"更多","upload":"上传","cancel":"取消","confirm":"确认","continue":"下一步","notice":"提示","delete":"删除","important":"重要","edit":"编辑","loading":"加载中","noOptions":"无可用选项","other":"其他","on":"开","off":"关","publish":"发布","save":"保存","submit":"提交","success":"成功","copySuccess":"复制成功!","copyFileLinkSuccess":"复制文件链接成功，请在浏览器打开","copyerror":"复制失败!","fileMaxSize":"文件大小必须小于 {{size}}.","tooManyFiles":"最大可上传文件数量：{{count}}","fileInvalidType":"文件类型错误","invalidFileName":"无效的文件名","uploadError":"上传失败","unknownError":"未知错误","endsInDate":"将于 {{date}} 失效","maintain":{"title":"网站维护中","desc":"网站目前正在进行定期维护。\n预计{{time}}小时后完成，感谢您的耐心等待。"},"submitSuccess":"提交成功","feedback":"反馈","languages":{"en":"英文","zh":"中文","fr":"法语","es":"西班牙语","de":"德语","it":"意大利语","ja":"日语","ko":"韩语","pt":"葡萄牙语","nl":"荷兰语","vi":"越南语","ru":"俄语","hu":"匈牙利语","pl":"波兰语","tr":"土耳其语","hi":"印度语","ar":"阿拉伯语"},"add":"添加","remove":"删除","learnMore":"了解更多","buyNow":"立即购买","watchVideo":"观看视频","subscribe":"订阅","comingSoon":"敬请期待","return":"返回","subscribeDialog":{"title":"订阅","desc":"立即订阅，第一时间获取产品信息更新！","placeholder":"请输入您的电子邮箱","button":"订阅","privacyPolicy":"\u003c0\u003e我同意 Bambu Lab \u003c/0\u003e\u003c1\u003e使用条款\u003c/1\u003e\u003c2\u003e和\u003c/2\u003e\u003c3\u003e隐私声明\u003c/3\u003e\u003c4\u003e。\u003c/4\u003e","validEmail":"请输入正确的邮箱","needAgreePrivacyPolicy":"您需要同意隐私声明","success":"感谢您的订阅"},"leaveDialog":{"title":"您有未保存的更改","content":"在退出之前，您是否想保存更改？","cancel":"取消","notSave":"不保存","saveDraft":"保存草稿","save":"保存"},"error":{"networkError":"网络错误","tooManyRequests":"您发送的请求太频繁，请稍后再试。"},"quarterSelect":{"yearLabel":"年份：","quarterLabel":"季度：","quarterValues":{"1":"第一季度","2":"第二季度","3":"第三季度","4":"第四季度"}},"subHeader":{"overview":"产品概览","diveIn":"深入了解","specs":"技术参数","faq":"常见问题","buy":"立即购买","contactUs":"联系我们"}},"product":{"fleetHub":{"common":{"subHeaderName":"Fleet Hub","name":"拓竹 Fleet Hub","contactUs":"联系我们","findReseller":"查找经销商","slogan":"离线集群管控，无缝企业流程。","developerLink":"开始使用\u003e"},"form":{"desc":"请描述您的预期用例、估计的打印机集群规模以及集成需求，以便我们更好地为您提供服务。"},"sections":{"1":{"sectionTitle":"基于本地网络的集群控制系统","title":"无需连接外部网络的打印机群控管理","desc":"在完全隔离的网络环境中统一群控设备集群。通过将控制面板、遥测数据及高保真实时监控视频流严格限定于本地网络，实现最高级别的业务隐私性与运行稳定性保障。"},"2":{"sectionTitle":"丝滑的 MES 与 ERP 系统集成","title":"面向工业自动化的标准化 API","desc":"采用提供即用型代码示例的标准化 API，帮助企业快速打通 3D 打印群控与原生产流程之间的数据链路。拓竹 Fleet Hub 支持原生低延迟嵌入现有 MES、ERP 或 PLM 系统，实现全链路生产追溯与自动化流程编排。"},"3":{"sectionTitle":"硬件级纵深防护体系","title":"以芯片级防护实现主动系统防御","desc":"拓竹 Fleet Hub 构建于硬件信任根（RoT）之上，部署了全面的安全架构。系统集成安全启动链、验证启动机制与可信执行环境（TEE），确保仅加密签名的固件能够运行。硬件隔离式安全引擎防护加密密钥免受软件攻击，强制访问控制（MAC）则实现架构级严格隔离。该分层防御策略有效遏制网络内横向渗透，确保单点的脆弱性不会引发系统性失陷。"},"4":{"sectionTitle":"专属加密网络","title":"全面符合 IT 安全审计标准","desc":"拓竹 Fleet Hub 严格遵循企业级安全规范设计——无例外条款、无规避方案、无策略调整。满足审计检查项的各种要求。"},"5":{"sectionTitle":"安全身份与访问管理","title":"私钥自主管控，访问持续防护","desc":"拓竹 Fleet Hub 整合客户自主控制的密钥所有权、绑定激活状态的证书验证及基于会话的授权机制，为经过认证的客户端提供可信访问。"},"6":{"sectionTitle":"完整数据主权保障","title":"全方位保护您的设计资产","desc":"拓竹 Fleet Hub 采用激活后全离线运行模式，实现数据零外传。3D 模型与图像数据经由双向 mTLS 加密通道传输，并存储于 40 GB 本地专属加密缓存中。从数字传输与物理存储双层面构筑知识产权保护屏障。"},"7":{"sectionTitle":"专属工程支持团队","title":"专家团队全程部署与维护支持","desc":"专属对接解决方案工程团队加速部署，提供从 API 集成、安全审计到持续运维的全周期专业支撑，确保关键业务系统最高可用性与可靠性。"}},"note":{"1":"以上信息概述了拓竹 Fleet Hub 的核心功能和特性。如需详细的技术规格、安全架构和合规文档，请参考 \u003cTechnicalLink\u003e《Fleet Hub 技术白皮书》\u003c/TechnicalLink\u003e和\u003cSecurityLink\u003e《安全白皮书》\u003c/SecurityLink\u003e。如需 API 文档，请访问\u003cStartedLink\u003e快速入门页面\u003c/StartedLink\u003e申请开发者权限。如有其他疑问，请通过 \u003cemail\u003edevpartner@bambulab.com\u003c/email\u003e 联系我们。","title":"备注"}}},"developer":{"fleetHub":{"public":{"banner":{"title":"开发者授权","desc":"开发者授权用于开通 FleetHub 技术接入能力。开通后，您可创建设备激活密钥，签发用于与 FleetHub API 建立安全通信的客户端证书，并访问 API 文档与示例代码，用于接口验证与集成开发。阅读并同意相关协议后，即可在线完成开通。\n如需商务合作，请通过技术支持与商务入口联系我们。","button":"申请授权","enterConsole":"进入控制台","agreement":"我已阅读并同意\u003cagreementLink\u003e《开发者协议》\u003c/agreementLink\u003e和\u003cprivacyLink\u003e《隐私声明》\u003c/privacyLink\u003e","checkAgreement":"请同意《开发者协议》和《隐私声明》","success":"开发者授权成功","error":"开发者授权失败"},"usageProcess":{"1":{"step":"第一步","title":"评估集成方案","desc":"查看相关技术文档，评估集成可行性。"},"2":{"step":"第二步","title":"准备开发环境","desc":"根据项目进度规划设备采购，或先完成授权，后采购设备。"},"3":{"step":"第三步","title":"激活开发者访问权限","desc":"在线审阅并同意《开发者协议》后，您可以通过自助服务完成开发者授权。"},"4":{"step":"第四步","title":"配置安全凭证","desc":"请按照快速入门指南配置您的密钥和证书。"},"5":{"step":"第五步","title":"开始构建","desc":"使用 API 文档和示例代码快速开始 API 集成和系统开发。"},"title":"使用流程"},"documentation":{"1":{"name":"安全白皮书"},"2":{"name":"技术白皮书"},"3":{"name":"固件版本和发布说明"},"title":"文档和支持"},"support":{"title":"技术与业务支持","desc":"如果您需要有关拓竹 Fleet Hub 技术解决方案、开发支持或商业合作的咨询，请随时通过以下方式联系我们：\u003cmailto\u003edevpartner@bambulab.com\u003c/mailto\u003e"}},"private":{"backText":"开始使用","activationKey":{"title":"激活密钥","desc":"用于拓竹 Fleet Hub 激活时访问云端服务的凭证。系统会在设备激活过程中使用该密钥提交激活所需的设备标识与证书信息，以获取激活所需数据并完成激活。该密钥不用于 Fleet Hub 本地 API 通信。","create":"生成激活密钥","reset":"重置激活密钥","dialog":{"create":{"title":"激活密钥","desc":"请妥善保管您的激活密钥。\n该密钥仅在本次生成后展示一次，关闭窗口后将无法再次查看。\n如后续遗失，您只能通过重置密钥生成新的密钥。","copy":"复制激活密钥"},"reset":{"title":"确认重置激活密钥","desc":"重置后，当前激活密钥将立即失效，无法再用于激活新的 Fleet Hub 设备。\n此操作不可恢复，系统将生成新的激活密钥。\n是否确认继续？"}}},"clientCertificate":{"create":{"title":"客户端证书颁发","desc":"上传客户端公钥后，系统将为该公钥签发客户端证书，用于客户端与 Fleet Hub API 建立安全通信。Fleet Hub 基于双向 TLS（mTLS）机制进行身份认证，通信过程中使用的终端证书为拓竹签发的 X.509 证书。","note":"请粘贴文本格式的公钥内容。当前最多支持签发并保存 5 个客户端证书。建议使用 RSA 4096 的签名算法。","button":"签发","placeholder":"在此粘贴您的公钥（-----BEGIN PUBLIC KEY-----）\n\n若要在本地生成密钥对，请运行：\nopenssl genrsa -out private.key 4096\nopenssl rsa -in private.key -pubout\n\n然后复制输出的公钥并粘贴到此处。"},"management":{"column":{"date":"签发日期","expiry":"到期日期","action":"操作"},"certificateName":"证书{{serialNumber}}","download":"下载","delete":"删除","deleteDialog":{"title":"删除客户端证书","desc":"删除证书后，该证书将无法再用于新的设备激活或新的客户端部署；但已安装该证书的客户端仍可继续与 Fleet Hub 通信。"},"title":"客户端证书"}},"documentation":{"1":{"name":"API 参考文档"},"2":{"name":"示例代码下载"},"title":"文档与支持"},"revokeAuthorization":{"revokeText":"解除开发者协议授权","desc":"如您不再需要 Fleet Hub 开发者接入能力，可解除开发者授权。","dialog":{"title":"确认解除开发者协议授权","desc":"解除开发者授权后，您在本页面创建的激活密钥和已签发的客户端证书将自动失效，且无法再用于激活新的设备。已部署设备如已使用此前签发的客户端证书完成配置，现有通信不受影响，仍可继续使用；如您不再需要相关能力，建议同步将设备恢复出厂设置。\n此外，自解除之日起\u003cb\u003e 30 天\u003c/b\u003e内，您将无法再次申请开发者授权。"}}}}},"header":{"collections":"我的收藏","creation":"我的作品","likes":"我的点赞","login":"登录","logout":"登出","print_history":"打印历史","sign_in":"登录","sign_in_or_sign_up":"登录 / 注册","sign_up":"注册","store":"商城","shopNow":"立即购买","support-tickets":"服务工单","profile-setting":"用户设置","betaFirmwareProgram":"Beta 固件计划","toBuy":"购买"},"schema":{"schemaName":{"defaultSchemaName":"应用","bambuForest":"拓竹农场管家","bambuConnect":"Bambu Connect"},"schemaCallback":{"success":{"title":"登录成功","desc":"\u003c0\u003e自动跳转到{{schemaName}}... 也可点击\u003c/0\u003e\u003c1\u003e手动跳转\u003c/1\u003e\u003c2\u003e\u003c/2\u003e"}}},"studio":{"studioCallback":{"error":{"title":"登录失败","desc":"登录失败，请返回 \u003c1\u003eBambu Studio\u003c/1\u003e 重新登录。","suiteDesc":"登录失败，请返回 \u003c1\u003eBambu Suite\u003c/1\u003e 重新登录。"},"success":{"title":"登录成功","desc":"登录成功，请进入 \u003c1\u003eBambu Studio\u003c/1\u003e 查看登录状态信息。","suiteDesc":"登录成功，请进入 \u003c1\u003eBambu Suite\u003c/1\u003e 查看登录状态信息。"}}},"trouble":{"technicalUploadPrivacy":"请勿上传任何与技术问题无关的文件，并注意不要上传任何敏感个人数据。","technicalPrivacyPolicy":{"desc1":"点击“提交”即表示您确认：拓竹将处理您在此表单中提交的信息，包括随请求提交的设备和应用日志、工单日志以及您的账户 ID，用于以下目的：","desc2":"提供售后服务、故障排查和诊断；","desc3":"改进我们的产品和服务，包括改进我们的 AI 服务和功能。设备和应用日志可能包括系统操作记录、设备控制记录、打印机摄像头生成的视频和图像数据，以及网络和应用事件信息。","desc4":"您可随时通过我们的《隐私声明》中提供的联系方式，选择不让我们为改进产品和服务而处理您的数据。关于我们如何处理您的个人数据的完整详情，请参阅我们的\u003c1\u003e《隐私声明》\u003c/1\u003e。"},"generalUploadPrivacy":"请勿在附件中上传与咨询无关的任何个人数据，并请注意不要上传敏感个人数据","generalPrivacyPolicy":"勾选此复选框即表示您同意拓竹可以根据其\u003c1\u003e《隐私声明》\u003c/1\u003e处理您在此表单中提交的个人数据，用于解决您的售后问题、验证您的身份、提供产品售后支持以及改进售后服务体验。","allTickets":"服务工单","Attachments":"附件","addDesc":"回复工单","problemSolved":"问题已解决","addFilament":"添加耗材","addMaterial":"添加材料","addFromSD":"创建工单","addSDLogOrVideo":"上传附件","afterSalesRecords":"查看服务工单","cancel":"取消","confirm":"确认","covidNote1":"由于当前客服资源有限，您的工单可能会稍晚回复。考虑到当前的积压工单，我们大概会在您提交工单后的1天内回复您。由此带来的不便，我们深感抱歉。","covidNote2":"请放心，我们会尽最大的努力帮助您尽快解决问题。温馨提示，参考\u003c3\u003e这里\u003c/3\u003e的建议提交工单可以帮助您获得更高效的服务，感谢您的理解与支持！","createWorkOrder":"技术咨询","createResellerTicket":"经销商咨询","technicalTicketPrinter":"技术工单（硬件）","technicalTicketSoftware":"技术咨询（软件）","technicalTicketFilament":"技术咨询（耗材 \u0026 创客宝库）","delete":"删除","deleteButton":"删除记录","detailsButton":"查看详情","addMoreButton":"回复","evaluateButton":"评价","device":"打印机","deviceId":"打印机序列号","SNAdnLink":"\u003c0\u003e设备序列号 \u003c/0\u003e\u003c1\u003e(\u003c/1\u003e\u003c2\u003e如何获取序列号？\u003c/2\u003e\u003c3\u003e)\u003c/3