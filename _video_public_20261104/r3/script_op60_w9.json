 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我忽然发现自己想靠近对方，心里一热，自己也意外。",
       "keys": [],
       "from": [
        "S01-1"
       ]
      },
      {
       "text": "这点亲近已让我觉得甜，却不知道下次能不能更坦白。",
       "keys": [],
       "from": [
        "S01-2",
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚踏上船板",
       "keys": [],
       "from": [
        "S01-B2-p1"
       ]
      },
      {
       "text": "身体一瞬失重",
       "keys": [],
       "from": [
        "S01-B2-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我怕对方看出我有多需要这份亲近、觉得负担太重，所以只敢露出一点喜欢。",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里清楚要说什么",
       "keys": [],
       "from": [
        "S01-B3-p1"
       ]
      },
      {
       "text": "怕改变关系而格外谨慎",
       "keys": [],
       "from": [
        "S01-B3-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没因为我露出在意而退开，仍愿意亲近我。",
       "keys": [],
       "from": [
        "S02-1"
       ]
      },
      {
       "text": "我才渐渐放松下来。",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩挨肩地耳语",
       "keys": [],
       "from": [
        "S02-B1-p4"
       ],
       "emotion": "亲密"
      },
      {
       "text": "呼吸体温贴在一起",
       "keys": [],
       "from": [
        "S02-B1-p4"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我也想再靠近些，喜欢几乎藏不住。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      },
      {
       "text": "可我怕太急破坏眼下的自在，还是收住了。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "喜欢忽然涌上来",
       "keys": [],
       "from": [
        "S02-B3-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "甜蜜确认仍在心里已有鼻酸",
       "keys": [],
       "from": [
        "S02-B3-p3"
       ],
       "emotion": "悬着"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "和对方待在一起这么好，我却想到这样的时刻总会过去，还没分开就先舍不得。",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "还没分开就舍不得",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ],
       "emotion": "亲密"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我难得不去想我们以后会怎样，只想舒服地待在这份亲近里。",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体晃着漂着",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "不必赶去哪里",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "亲密交谈后安静也舒服",
       "keys": [],
       "from": [
        "S03-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我一度想告诉对方，我多喜欢这样的相处。",
       "keys": [],
       "from": [
        "S03-2"
       ]
      },
      {
       "text": "我也想问对方是不是一样。",
       "keys": [],
       "from": [
        "S03-2"
       ]
      },
      {
       "text": "可还没想好怎么开口，念头就淡了。",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急着表达的念头闪过",
       "keys": [],
       "from": [
        "S03-B2-p3"
       ]
      },
      {
       "text": "很快又沉回心里",
       "keys": [],
       "from": [
        "S03-B2-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "熟悉的亲近又让我满心欢喜。",
       "keys": [],
       "from": [
        "S04-1"
       ]
      },
      {
       "text": "我想起上回想告诉对方，却没有开口。",
       "keys": [],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "忍不住再说一遍",
       "keys": [],
       "from": [
        "S04-B1-p6"
       ]
      }
     ]
    },
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "我几乎想把藏着的话全告诉对方。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      },
      {
       "text": "盼对方喜欢我不再小心收着的样子。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "最深情意哽在喉咙",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "右手悬停水波仍推着往前",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "还没失去就已舍不得",
       "keys": [],
       "from": [
        "S04-B3-p4"
       ],
       "emotion": "不安"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我盼着说出来，能让眼下的好留久些。",
       "keys": [],
       "from": [
        "S04-3"
       ]
      },
      {
       "text": "可我怕说太多让对方为难，也怕弄丢原有的自在。",
       "keys": [],
       "from": [
        "S04-3"
       ]
      },
      {
       "text": "我还是留了些话没说。",
       "keys": [],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "每一秒都在倒数",
       "keys": [],
       "from": [
        "S04-B4-p2"
       ]
      },
      {
       "text": "越美越想多留",
       "keys": [],
       "from": [
        "S04-B4-p4"
       ],
       "emotion": "亲密"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "前几次我想说又收住。",
       "keys": [],
       "from": [
        "S05-1"
       ]
      },
      {
       "text": "对方却一直愿意亲近我。",
       "keys": [],
       "from": [
        "S05-1"
       ]
      },
      {
       "text": "这回我没藏住喜欢，等我察觉，对方已看出我多在乎。",
       "keys": [],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "松开了手",
       "keys": [],
       "from": [
        "S05-B1-p2"
       ]
      },
      {
       "text": "攥紧的劲退了",
       "keys": [],
       "from": [
        "S05-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "藏着喜欢时，我还能装作不那么在乎。",
       "keys": [],
       "from": [
        "S05-2",
        "S05-3"
       ]
      },
      {
       "text": "如今对方看出来了，我心里空落落的，不知怎么相处。",
       "keys": [],
       "from": [
        "S05-2",
        "S05-3"
       ]
      },
      {
       "text": "我怕对方嫌我太黏，连原本的亲近都像隔了一层。",
       "keys": [],
       "from": [
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "托着身体的水波忽然抽走",
       "keys": [],
       "from": [
        "S05-B2-p1"
       ]
      },
      {
       "text": "从亲密中抽身跌回内心",
       "keys": [],
       "from": [
        "S05-B3-p3"
       ]
      },
      {
       "text": "重要的话悬在唇边",
       "keys": [],
       "from": [
        "S05-B3-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出我有多在乎，却待我如常，我才又能像从前一样自在相处。",
       "keys": [],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉摇荡又回来却不再沉重",
       "keys": [],
       "from": [
        "S06-B1-p2"
       ]
      },
      {
       "text": "想起年少时第一次心动",
       "keys": [],
       "from": [
        "S06-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "安静下来，我想到对方不知道我刚才有多怕被嫌弃，忽然觉得孤单。",
       "keys": [],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "回家独处时心头泛酸",
       "keys": [],
       "from": [
        "S06-B3-p4"
       ]
      },
      {
       "text": "亲密的人也走不进心里每个角落",
       "keys": [],
       "from": [
        "S06-B3-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我忍不住想，对方一直没有退开，会不会也舍不得结束这份亲近？",
       "keys": [],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的气味",
       "keys": [],
       "from": [
        "S06-B4-p2"
       ]
      },
      {
       "text": "越舒服越失去方向",
       "keys": [],
       "from": [
        "S06-B4-p3"
       ],
       "emotion": "悬着"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这些日子对方总愿和我待在一起。",
       "keys": [],
       "from": [
        "S07-1"
       ]
      },
      {
       "text": "我渐渐觉得，对方或许也需要我的陪伴，和我在一起也安心。",
       "keys": [],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "沉重脉搏催着身体向前",
       "keys": [],
       "from": [
        "S07-B1-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "渴望往上涌",
       "keys": [],
       "from": [
        "S07-B1-p2"
       ],
       "emotion": "炽热"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到这一点，我高兴得有些收不住。",
       "keys": [],
       "from": [
        "S07-2"
       ]
      },
      {
       "text": "我越想越舍不得从这份欢喜里抽身。",
       "keys": [],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "明知被卷入却暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2-p4"
       ],
       "emotion": "悬着"
      },
      {
       "text": "完美一刻也无法停住",
       "keys": [],
       "from": [
        "S07-B2-p4"
       ],
       "emotion": "悬着"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我盼着以后对方想找人陪时还会想到我，我也能一直陪在对方身边。",
       "keys": [],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "时间还在经过",
       "keys": [],
       "from": [
        "S07-B3-p1"
       ]
      },
      {
       "text": "美好还在眼前",
       "keys": [],
       "from": [
        "S07-B3-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "上回我无意间露了心意，这回见对方依然亲近，我想主动些，大方回应。",
       "keys": [],
       "from": [
        "S08-1",
        "S08-2"
       ]
      },
      {
       "text": "我也开始盼着我们能这样好很久。",
       "keys": [],
       "from": [
        "S08-1",
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体恢复弹性轻快地调情回应",
       "keys": [],
       "from": [
        "S08-B2-p1"
       ]
      },
      {
       "text": "没有哲学没有防卫没有分析",
       "keys": [],
       "from": [
        "S08-B2-p1"
       ]
      },
      {
       "text": "你来我往地逗趣",
       "keys": [],
       "from": [
        "S08-B2-p3"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可今天这样好，不代表以后也会这样，我顿时没了底。",
       "keys": [],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "快乐余温还在心头泛起怀念",
       "keys": [],
       "from": [
        "S08-B3-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "那点没底变得具体：我怕有天对方不再需要我陪。",
       "keys": [],
       "from": [
        "S09-1",
        "S09-2"
       ]
      },
      {
       "text": "也怕对方不愿再和我待在一起。",
       "keys": [],
       "from": [
        "S09-1",
        "S09-2"
       ]
      },
      {
       "text": "我一下安静下来，不敢再往后想。",
       "keys": [],
       "from": [
        "S09-1",
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "两人对视到呼吸停住",
       "keys": [],
       "from": [
        "S09-B1-p3"
       ],
       "emotion": "悬着"
      },
      {
       "text": "渴望仍在却引而不发",
       "keys": [],
       "from": [
        "S09-B1-p3"
       ],
       "emotion": "悬着"
      },
      {
       "text": "绷紧的劲还没松开",
       "keys": [],
       "from": [
        "S09-B1-p3"
       ],
       "emotion": "悬着"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "我想起对方一直没有退开，眼下也仍和我亲近。",
       "keys": [],
       "from": [
        "S09-3"
       ]
      },
      {
       "text": "也许对方也喜欢我陪着，想到这儿我还是有点高兴。",
       "keys": [],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "眼前美好比自己的愿望更大",
       "keys": [],
       "from": [
        "S09-B4-p1"
       ]
      },
      {
       "text": "不安暂时退到一旁",
       "keys": [],
       "from": [
        "S09-B4-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我怕再猜下去，今天也过不踏实。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      },
      {
       "text": "我暂时不想以后，只享受眼前的亲近。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      },
      {
       "text": "紧绷慢慢松开，我心里亮堂得想笑，也有点想哭。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "长长呼出一口气",
       "keys": [],
       "from": [
        "S10-B1-p1"
       ]
      },
      {
