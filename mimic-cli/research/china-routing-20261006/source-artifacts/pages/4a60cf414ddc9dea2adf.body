                            /* ============================================================
   GVR Market Highlights Widget
   Specificity: .report_summary #rprt_summary #gvr-mh-widget
   Upload to CDN and link before the widget HTML fragment.
   ============================================================ */

/* ── Outer wrapper ── */
.report_summary #rprt_summary #gvr-mh-widget {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  width: 1132px;
  max-width: 100%;
  margin: 0 auto;
  position: relative;
}

/* ── Card (section shell) ── */
.report_summary #rprt_summary #gvr-mh-widget .mhw-card {
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(26,26,46,.06), 0 1px 2px rgba(26,26,46,.04);
  background: #fff;
  border: 1px solid #E5E7EB;
}

/* ── Header ── */
.report_summary #rprt_summary #gvr-mh-widget .mhw-head {
  padding: 14px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-title-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-title-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 5px;
  background: #F0EBF8;
  color: #6B4EAF;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-title {
  font-size: 16px !important;
  font-weight: 700 !important;
  margin: 0 !important;
  padding: 0 !important;
  color: #1A1A2E !important;
  line-height: 1.3 !important;
  border: none !important;
  background: none !important;
  text-transform: none !important;
  letter-spacing: normal !important;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-period {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  padding: 4px 9px;
  border-radius: 4px;
  color: #6B4EAF;
  background: #F0EBF8;
}

/* ── Body grid ── */
.report_summary #rprt_summary #gvr-mh-widget .mhw-body {
  display: grid;
  grid-template-columns: 1fr 290px;
  gap: 0;
  border-top: 1px solid #E5E7EB;
}

/* ── Left panel ── */
.report_summary #rprt_summary #gvr-mh-widget .mhw-left {
  padding: 18px 20px;
  background: #FAFBFC;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

/* ── Segment card ── */
.report_summary #rprt_summary #gvr-mh-widget .mhw-lc {
  background: #fff;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  padding: 12px 12px 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-shadow: 0 1px 2px rgba(26,26,46,.04);
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-lc__tag {
  align-self: flex-start;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: #6B4EAF;
  background: #F0EBF8;
  padding: 3px 8px;
  border-radius: 999px;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-lc__text {
  font-size: 12.5px;
  margin: 0;
  line-height: 1.45;
  color: #4B5563;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-lc__text strong {
  color: #1A1A2E;
  font-weight: 600;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-lc__metric {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 11.5px;
  font-weight: 600;
  color: #10A876;
  margin-top: auto;
  padding-top: 6px;
  border-top: 1px dashed #F0F2F5;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-lc__metric object {
  flex-shrink: 0;
  display: inline-block;
  vertical-align: middle;
  pointer-events: none;
}

/* ── Analyst insight ── */
.report_summary #rprt_summary #gvr-mh-widget .mhw-insight {
  margin-top: 12px;
  background: #fff;
  border: 1px solid #E5E7EB;
  border-left: 4px solid #6B4EAF;
  border-radius: 6px;
  padding: 14px 14px 12px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-ins-icon {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: linear-gradient(135deg, #6B4EAF 0%, #4ECDC4 100%);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-ins-icon object {
  display: block;
  pointer-events: none;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-ins-body {
  flex: 1;
  min-width: 0;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-ins-label {
  font-size: 9px !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: .14em !important;
  color: #6B4EAF !important;
  margin: 0 0 5px !important;
  padding: 0 !important;
  border: none !important;
  background: none !important;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-ins-text {
  font-size: 12.5px;
  line-height: 1.55;
  color: #4B5563;
  margin: 0 0 8px;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-ins-text strong {
  color: #1A1A2E;
  font-weight: 600;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-ins-text em {
  font-style: normal;
  color: #6B4EAF;
  font-weight: 500;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-ins-author {
  font-size: 10.5px;
  color: #6B7280;
  margin: 0;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-ins-author strong {
  color: #1A1A2E;
  font-weight: 600;
}

/* ── Right panel ── */
.report_summary #rprt_summary #gvr-mh-widget .mhw-right {
  padding: 18px 20px;
  border-left: 1px solid #E5E7EB;
}

/* ── Section headings ── */
.report_summary #rprt_summary #gvr-mh-widget .mhw-section-title {
  font-size: 14px !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: .1em !important;
  color: #6B7280 !important;
  margin: 0 0 12px !important;
  padding: 0 0 8px !important;
  border-top: none !important;
  border-left: none !important;
  border-right: none !important;
  border-bottom: 1px solid #E5E7EB !important;
  background: none !important;
  line-height: 1.3 !important;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-qs-title {
  font-size: 15px !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: .1em !important;
  color: #6B7280 !important;
  margin: 0 0 10px !important;
  padding: 0 !important;
  border: none !important;
  background: none !important;
  line-height: 1.3 !important;
}

/* ── Forecast table ── */
.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table {
  width: 100% !important;
  border-collapse: collapse !important;
  font-size: 13px !important;
}

.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table caption {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}

.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table thead th {
  color: #6B7280 !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: .1em !important;
  padding: 11px 0 !important;
  border-bottom: 2px solid #1A1A2E !important;
  border-top: none !important;
  border-left: none !important;
  border-right: none !important;
  background: transparent !important;
}

.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table thead th:first-child {
  text-align: left !important;
}

.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table thead th:last-child {
  text-align: right !important;
}

.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table tbody th {
  text-align: left !important;
  font-weight: 500 !important;
  color: #4B5563 !important;
  padding: 11px 0 !important;
  font-size: 14px !important;
  border-bottom: 1px solid #F0F2F5 !important;
  border-top: none !important;
  border-left: none !important;
  border-right: none !important;
  background: transparent !important;
}

.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table tbody td {
  text-align: right !important;
  font-weight: 700 !important;
  color: #1A1A2E !important;
  padding: 11px 0 !important;
  border-bottom: 1px solid #F0F2F5 !important;
  font-size: 14px !important;
  background: transparent !important;
}

.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table tbody tr:last-child th,
.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table tbody tr:last-child td {
  border-bottom: none !important;
}

.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table tbody tr.mhw-cagr-row th,
.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table tbody tr.mhw-cagr-row td {
  color: #6B4EAF !important;
}

/* ── Quick stats ── */
.report_summary #rprt_summary #gvr-mh-widget .mhw-qs {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px dashed #E5E7EB;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-qs-list {
  list-style: none !important;
  padding: 0 !important;
  margin: 0 !important;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-qs-item {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 15px !important;
  gap: 8px;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-qs-lbl {
  color: #6B7280;
  flex-shrink: 0;
}

.report_summary #rprt_summary #gvr-mh-widget .mhw-qs-val {
  color: #1A1A2E;
  font-weight: 600;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* ── Responsive ── */
@media (max-width: 860px) {
  .report_summary #rprt_summary #gvr-mh-widget .mhw-body {
    grid-template-columns: 1fr;
  }
  .report_summary #rprt_summary #gvr-mh-widget .mhw-right {
    border-left: none;
    border-top: 1px solid #E5E7EB;
  }
  .report_summary #rprt_summary #gvr-mh-widget .mhw-cards-grid {
    grid-template-columns: 1fr;
  }
  .report_summary #rprt_summary #gvr-mh-widget .mhw-insight {
    flex-direction: column;
    gap: 10px;
  }
}

/* ── Additional overrides ── */

/* All td borders off */
.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table td {
  border: 0 !important;
}

/* First tbody row td borders off */
/*.report_summary #rprt_summary #gvr-mh-widget #gvr-forecast-table tbody tr:first-child td {
  border: 0 !important;
}*/

/* p em color */
.report_summary #rprt_summary #gvr-mh-widget p em {
  color: #10a876 !important;
}

</style>




