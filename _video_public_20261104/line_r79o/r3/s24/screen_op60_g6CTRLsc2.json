        "S08-B2"
       ],
       "bars": "62-70",
       "at": 15.0
      },
      {
       "text": "像指尖轻轻一弹，旋律里带着笑意",
       "bead": "S08-B2",
       "from": [
        "S08-B2"
       ],
       "bars": "62-70",
       "at": 18.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "这样想着，他连往后的日子都开始盼了，觉得两个人说不定还能这么好很久",
     "keys": [
      "还能这么好很久"
     ],
     "emotion": "欢喜",
     "from": [
      "S08-2"
     ],
     "at": 8.0
    },
    {
     "kind": "line",
     "text": "可眼下两个人都愿意亲近，以后未必还会这样，他心里没底",
     "keys": [
      "心里没底"
     ],
     "emotion": "不安",
     "from": [
      "S08-3"
     ],
     "at": 12.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "余温还贴在掌心，心口却先酸了一下",
       "bead": "S08-B3",
       "from": [
        "S08-B3"
       ],
       "bars": "69-71",
       "at": 21.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "旋律直接舒展如歌剧咏叹调，歌句越唱越开",
     "bars": "62-70",
     "from": [
      "S08-B1"
     ]
    },
    {
     "text": "歌声没有落定，向上散开后戛然而止",
     "bars": "69-71",
     "from": [
      "S08-B3"
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "rows": [
    {
     "kind": "line",
     "text": "那点没底越来越具体：要是哪天对方不再需要他陪，连和他待着都不自在了呢？",
     "keys": [
      "不再需要他陪"
     ],
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "kind": "line",
     "text": "他一下安静了，刚才还敢盼那么远，现在却不敢再往下想",
     "keys": [
      "不敢再往下想"
     ],
     "emotion": "悬着",
     "from": [
      "S09-2"
     ],
     "at": 5.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像高音悬在半空，迟迟没有落下来",
       "bead": "S09-B1",
       "from": [
        "S09-B1"
       ],
       "bars": "72-77",
       "at": 12.0
      },
      {
       "text": "像乌云压低了屋檐，光线也暗了一层",
       "bead": "S09-B2",
       "from": [
        "S09-B2"
       ],
       "bars": "72-77",
       "at": 15.0
      },
      {
       "text": "像余音在空房里打转，久久落不下来",
       "bead": "S09-B3",
       "from": [
        "S09-B3"
       ],
       "bars": "72-77",
       "at": 18.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "他想起对方一直没退开，两人眼下还亲近，这些都是真的",
     "keys": [
      "这些都是真的"
     ],
     "emotion": "安心",
     "from": [
      "S09-3"
     ],
     "at": 9.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像抬头看见星光，胸口也松开了一点",
       "bead": "S09-B4",
       "from": [
        "S09-B4"
       ],
       "bars": "72-77",
       "at": 21.0
      },
      {
       "text": "像听见熟悉的和弦，心口忽然亮了一点",
       "bead": "S09-3",
       "from": [
        "S09-3"
       ],
       "bars": "",
       "at": 24.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "熟悉的摇摆退到一旁，飘渺的颤音与和弦悬在半空",
     "bars": "72-77",
     "from": [
      "S09-B1"
     ]
    },
    {
     "text": "声音一层层下沉变暗，注意力反而收拢",
     "bars": "72-77",
     "from": [
      "S09-B2"
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "rows": [
    {
     "kind": "line",
     "text": "他想着，再猜下去连今天也过不踏实",
     "keys": [
      "连今天也过不踏实"
     ],
     "emotion": "不安",
     "from": [
      "S10-1"
     ]
    },
    {
     "kind": "line",
     "text": "便暂时不去管往后怎样，先好好享受眼前的亲近",
     "keys": [
      "享受眼前的亲近"
     ],
     "emotion": "安心",
     "from": [
      "S10-1"
     ],
     "at": 3.0
    },
    {
     "kind": "line",
     "text": "先前那阵紧绷慢慢松下去，他心里亮堂得几乎想笑，也有点想哭",
     "keys": [
      "几乎想笑，也有点想哭"
     ],
     "emotion": "欢喜",
     "from": [
      "S10-2"
     ],
     "at": 6.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像肩头卸下一块石头，长长吐出一口气",
       "bead": "S10-B1",
       "from": [
        "S10-B1"
       ],
       "bars": "78-83",
       "at": 9.0
      },
      {
       "text": "眼眶热热的，任由那点酸甜慢慢涌上来",
       "bead": "S10-B1",
       "from": [
        "S10-B1"
       ],
       "bars": "78-83",
       "at": 12.0
      },
      {
       "text": "像窗缝吹进一阵风，闷热散开一瞬",
       "bead": "S10-B2",
       "from": [
        "S10-B2"
       ],
       "bars": "78-83",
       "at": 15.0
      },
      {
       "text": "像脚尖离了地，整个人轻轻飘起来",
       "bead": "S10-B3",
       "from": [
        "S10-B3"
       ],
       "bars": "78-83",
       "at": 18.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "前行的摇荡被拨开，旋律像在时间里开出一小块空地",
     "bars": "78-83",
     "from": [
      "S10-B2"
     ]
    },
    {
     "text": "高音区织出细亮音符，像晨曦里的银丝与细雨",
     "bars": "78-83",
     "from": [
      "S10-B4"
     ]
    },
    {
     "text": "一串琶音如飞瀑从高处清亮落水",
     "bars": "80-83",
     "from": [
      "S10-B4"
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "rows": [
    {
     "kind": "line",
     "text": "他忽然想到自己需要对方，对方有时也需要他",
     "keys": [
      "有时也需要他"
     ],
     "emotion": "安心",
     "from": [
      "S11-1"
     ]
    },
    {
     "kind": "line",
     "text": "即使对方不需要他，他仍愿意陪着，不再藏着喜欢",
     "keys": [
      "不再藏着喜欢"
     ],
     "emotion": "炽热",
     "from": [
      "S11-1"
     ],
     "at": 3.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像憋了很久的一口气，终于慢慢呼出来",
       "bead": "S11-B1",
       "from": [
        "S11-B1"
       ],
       "bars": "84-92",
       "at": 15.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "这个念头一上来，他高兴得连害臊都顾不上了",
     "keys": [
      "高兴得连害臊都顾不上了"
     ],
     "emotion": "欢喜",
     "from": [
      "S11-2"
     ],
     "at": 6.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像等了很久的和弦终于落稳，心口一松",
       "bead": "S11-B2",
       "from": [
        "S11-B2"
       ],
       "bars": "92",
       "at": 18.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "可对方以后还愿不愿意让他陪在身边，不是他能说了算的",
     "keys": [
      "不是他能说了算的"
     ],
     "emotion": "不安",
     "from": [
      "S11-3"
     ],
     "at": 9.0
    },
    {
     "kind": "line",
     "text": "想到两人未必总能这样亲近，欢喜就压得他心口发疼",
     "keys": [
      "压得他心口发疼"
     ],
     "emotion": "悬着",
     "from": [
      "S11-3"
     ],
     "at": 12.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像夕照铺满眼底，亮得眼眶发烫",
       "bead": "S11-B3",
       "from": [
        "S11-B3"
       ],
       "bars": "84-92",
       "at": 21.0
      },
      {
       "text": "像旧屋被夕光照亮，熟悉里也有了重量",
       "bead": "S11-B4",
       "from": [
        "S11-B4"
       ],
       "bars": "84-92",
       "at": 24.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "谨慎收弱不见了，厚重和弦托起歌声，水波翻成惊涛",
     "bars": "84-92",
     "from": [
      "S11-B1"
     ]
    },
    {
     "text": "铺开的力量在高处短暂悬住，像等待下一股巨浪",
     "bars": "92",
     "from": [
      "S11-B2"
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "rows": [
    {
     "kind": "line",
     "text": "他顾不上对方是否也在乎他，只想把能给的都给对方，希望对方安心",
     "keys": [
      "把能给的都给对方"
     ],
     "emotion": "亲密",
     "from": [
      "S12-1"
     ]
    },
    {
     "kind": "line",
     "text": "可他明知再用心也没法保证以后还这么好，还是嫌这样的日子不够，想多陪对方一会儿",
     "keys": [
      "多陪对方一会儿"
     ],
     "emotion": "悬着",
     "from": [
      "S12-2"
     ],
     "at": 5.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像伸手接住一捧水，指缝里还是不停漏下",
       "bead": "S12-B3",
       "from": [
        "S12-B3"
       ],
       "bars": "93-102",
       "at": 15.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "那一阵高兴终于整个涌了出来，他不再强迫自己收着，只顾痛痛快快地喜欢对方",
     "keys": [
      "痛痛快快地喜欢"
     ],
     "emotion": "炽热",
     "from": [
      "S12-3"
     ],
     "at": 10.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像琴声一下漫过整间屋子，连呼吸都被淹没",
       "bead": "S12-B1",
       "from": [
        "S12-B1"
       ],
       "bars": "93-102",
       "at": 18.0
      },
      {
       "text": "像热浪扑面，整个人都被滚烫的旋律裹住",
       "bead": "S12-B2",
       "from": [
        "S12-B2"
       ],
       "bars": "93-102",
       "at": 21.0
      },
      {
       "text": "喉头发热，眼前亮得像蒙了一层水汽",
       "bead": "S12-B2",
       "from": [
        "S12-B2"
       ],
       "bars": "93-102",
       "at": 21.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "晴朗的歌放到最大，内声部彼此拉扯，声浪一浪高过一浪",
     "bars": "93-102",
     "from": [
      "S12-B1"
     ]
    },
    {
     "text": "旋律一次次向上伸展，句尾仍有牵扯与延迟",
     "bars": "96-100",
     "from": [
      "S12-B3"
     ]
    },
    {
     "text": "悬着的那口气在交界处得到重大释放",
     "bars": "102-103",
     "from": [
      "S12-B3"
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "rows": [
    {
     "kind": "line",
     "text": "高兴过后，他更想听对方说以后也不变",
     "keys": [
      "以后也不变"
     ],
     "emotion": "亲密",
     "from": [
      "S13-1"
     ]
    },
    {
     "kind": "line",
     "text": "他越喜欢跟对方待着，越觉得时间过得快",
     "keys": [
      "越觉得时间过得快"
     ],
     "emotion": "悬着",
     "from": [
      "S13-1"
     ],
     "at": 3.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像一声回音落下，耳边还留着空空的余响",
       "bead": "S13-1",
       "from": [
        "S13-1"
       ],
       "bars": "",
       "at": 15.0
      },
      {
       "text": "像浪尖刚托起身体，下一阵浪又迎面涌来",
       "bead": "S13-B1",
       "from": [
        "S13-B1"
       ],
       "bars": "103-110",
       "at": 18.0
      },
      {
       "text": "像刚落下一个明亮的和弦，尾音却微微发苦",
       "bead": "S13-B2",
       "from": [
        "S13-B2",
        "S13-B3"
       ],
       "bars": "103-110",
       "at": 21.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "起初他怕自己的需要给对方添负担，如今更怕对方哪天不再需要他，连这样待着都没了",
     "keys": [
      "更怕对方哪天不再需要他"
     ],
     "emotion": "不安",
     "from": [
      "S13-2"
     ],
     "at": 7.0
    },
    {
     "kind": "line",
     "text": "可他早不像最初那样能装作不在乎了，真要往回藏，自己反倒更难受",
     "keys": [
      "反倒更难受"
     ],
     "emotion": "炽热",
     "from": [
      "S13-3"
     ],
     "at": 12.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像指尖刚缩回去，又忍不住朝暖光伸开",
       "bead": "S13-2",
       "from": [
        "S13-2",
        "S13-3"
       ],
       "bars": "",
       "at": 24.0
      },
      {
       "text": "脚下沉沉的，胸口像有一口气慢慢坠下去",
       "bead": "S13-B4",
       "from": [
        "S13-B4"
       ],
       "bars": "103-110",
       "at": 27.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "声音在反复与渐强中往前推，后半段越绷越紧",
     "bars": "103-110",
     "from": [
      "S13-B1"
     ]
    },
    {
     "text": "明亮的声音里渐渐掺进尖锐暗沉的成分",
     "bars": "107-110",
     "from": [
      "S13-B2"
     ]
    },
    {
     "text": "低音牢牢踩住不退，上方的声音却一次次往下落",
     "bars": "103-110",
     "from": [
      "S13-B4"
     ]
    }
   ]
  },
  {
   "sec": "S14",
   "rows": [
    {
     "kind": "line",
     "text": "最初他连喜欢都不敢多露，如今两人还亲近",
     "keys": [
      "如今两人还亲近"
     ],
     "emotion": "亲密",
     "from": [
      "S14-1"
     ]
    },
    {
     "kind": "line",
     "text": "心里又甜又酸，却不后悔",
     "keys": [
      "又甜又酸，却不后悔"
     ],
     "emotion": "欢喜",
     "from": [
      "S14-1"
     ],
     "at": 3.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "胸口还留着暖意，耳边的余音渐渐平了",
       "bead": "S14-B1",
       "from": [
        "S14-B1"
       ],
       "bars": "111-115",
       "at": 15.0
      },
      {
       "text": "像醒来后眼前还留着一线柔光",
       "bead": "S14-B1",
       "from": [
        "S14-B1"
       ],
       "bars": "111-115",
       "at": 15.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "他还是会舍不得，也不知道以后怎样，却不想再逼自己讨一句永远不变的保证",
     "keys": [
      "不想再逼自己讨"
     ],
     "emotion": "安心",
     "from": [
      "S14-2"
     ],
     "at": 6.0
    },
    {
     "kind": "line",
     "text": "既然喜欢已经让对方看见，他就不往回藏了",
     "keys": [
      "他就不往回藏了"
     ],
     "emotion": "安心",
     "from": [
      "S14-3"
     ],
     "at": 9.0
    },
    {
     "kind": "line",
     "text": "往后会怎样，等真的到了那时再说",
     "keys": [
      "到了那时再说"
     ],
     "emotion": "安心",
     "from": [
      "S14-3"
     ],
     "at": 12.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像最后一个重音落地，余响慢慢收住",
       "bead": "S14-B3",
       "from": [
        "S14-B3"
       ],
       "bars": "116",
       "at": 18.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "最后一股浪头猛推一下后，终结句才真正松下来",
     "bars": "110-115",
     "from": [
      "S14-B1"
     ]
    },
    {
     "text": "左手内声部幽幽唱出一句，像男中音独自沉思",
     "bars": "113-115",
     "from": [
      "S14-B2"
     ]
    },
    {
     "text": "右手细碎琶音像水花溅落夜空，留下一闪",
     "bars": "115",
     "from": [
      "S14-B2"
     ]
    },
    {
     "text": "尾声上扬的和弦遥应开头，像终于把悬着的话说完",
     "bars": "113-116",
     "from": [
      "S14-B4"
     ]
    },
    {
     "text": "最后几下和弦干脆沉重，低音像铁锚落入水底定住小船",
     "bars": "116",
     "from": [
      "S14-B3"
     ]
    }
   ]
  }
 ]
}