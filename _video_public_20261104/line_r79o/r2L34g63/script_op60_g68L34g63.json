 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "这份亲近忽然把我触动得很深，我一阵兴奋",
       "keys": [
        "把我触动得很深"
       ],
       "from": [
        "S01-1"
