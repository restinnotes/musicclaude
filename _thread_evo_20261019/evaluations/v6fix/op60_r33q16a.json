     {
      "from": "S08-2",
      "to": "S12-2",
      "rel": "引用"
     },
     {
      "from": "S11-2",
      "to": "S12-2",
      "rel": "引用"
     },
     {
      "from": "S12-1",
      "to": "S12-3",
      "rel": "引用"
     },
