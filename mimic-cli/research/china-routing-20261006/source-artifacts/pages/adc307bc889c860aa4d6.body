            window.TRADEUP_INLINE_BOOTSTRAP = {"tradeInBaseUrl":"/shop/tradein-module?bfr=true&fae=true&pcat=tablet","tradeInDetailsUrl":"/shop/tradein-details?bfr=true&fae=true&pcat=tablet","modules":[{"module":"verify","moduleData":{"verification":{"sections":[{"fields":[[{"name":"sno","type":"text","label":"序列号","maxSize":"14","required":"true","rules":[{"type":"required","message":"请输入设备的序列号。"},{"type":"regex","message":"该序列号无效。请再试一次。","regEx":["^[a-zA-Z0-9]{8,14}$"]}]}]]}],"piplConsent":[{"disclaimer":"我同意<a href=\"https://support.apple.com/zh-cn/HT213840\" data-slot-name=\"tradeIn\" data-feature-name=\"Astro Link\" data-display-name=\"AOS: support.apple.com/zh-cn/HT213840\" class=\"icon icon-external\" target=\"_blank\">Apple 的隐私政策<span class=\"visuallyhidden\">(在新窗口中打开)</span></a>","param":"cp1"},{"disclaimer":"我了解，当我参与 Apple Trade In 换购计划时，有限的个人信息可能会在中国境外存储和处理。","param":"cp2"}]},"verifyUrl":"/shop/tradein-verify?bfr=true&cat=tablet&fae=true&product=mh394ch/a&pcat=tablet&bid=1","method":"POST"},"assets":{"tradein-verify-header":"输入你的 iPad 序列号。","tradein-verify-piplconsent-footer":"我们提供包括 Apple 隐私政策在内的更多信息。<a href=\"https://support.apple.com/zh-cn/HT213840\" data-slot-name=\"tradeIn\" data-feature-name=\"Astro Link\" data-display-name=\"AOS: support.apple.com/zh-cn/HT213840\" class=\"icon icon-external\" target=\"_blank\">进一步了解<span class=\"visuallyhidden\">Apple 隐私政策(在新窗口中打开)</span></a>。","tradein-verify-desc":"前往“设置”>“通用”>“关于本机”。此信息也可能镌刻在设备背面。","tradein-verify-success-message":"","tradein-verify-footer":"<div class=\"row as-tradeup-findserial\">\n\t<div class=\"column as-tradeup-findserial-details\">\n\t\t<h4 class=\"as-tradeup-findserial-header\">如何找到此信息</h4>\n\t\t<div class=\"as-tradeup-findserial-path\">前往“设置”<span>&gt;</span>“通用”<span>&gt;</span>“关于本机”。此信息可能镌刻在设备背面。你提供的数据将按照 <a href=\"https://www.apple.com.cn/legal/privacy/szh\" data-slot-name=\"tradeIn\" data-feature-name=\"Astro Link\" data-display-name=\"AOS: legal/privacy/szh\" target=\"privacynotice\">Apple&nbsp;隐私政策<span class=\"visuallyhidden\">(在新窗口中打开)</span></a>进行处理。</div>\n\t</div>\n  <div class=\"metrics\">\n    <div class=\"as-tradeup-findserial-header\"><br />Apple 和你的数据隐私</div>\n    <div><p>无论数据在何处进行处理和存储，Apple 始终遵守 Apple 隐私政策，并仅会收集开展服务运营和改进用户体验所必要的数据。</p>\n<p>遵照中国大陆隐私保护法律的要求，需要你签署本知情同意书。</p></div></div>\n\n</div>"},"remaining":3,"urlParameters":{"pcat":"tablet","cat":"tablet","bid":"1","bfr":true}}],"tradeInSelection":{"header":"Apple Trade In 换购计划：","subHeader":"换购新 iPad 可优惠 RMB 300-RMB 6650<as-footnote data-id=\"64dae4ad8f7828e82c803175386770f9\" data-assigned=\"true\"><sup data-autom=\"footnote-sub\" class=\"as-footnote as-footnote-symbol-large\"><span class=\"visuallyhidden\">&nbsp;脚注&nbsp;</span>**</sup></as-footnote>。","options":[{"text":"添加折抵设备","value":"tradeIn","selected":false,"priceMessage":null,"savingsMessage":null},{"text":"不折抵换购","value":"noTradeIn","selected":false,"priceMessage":null,"savingsMessage":null}]},"additionalContent":{"additionalData":{"tradein-shipping-reenter-address-button":"编辑地址","tradein-product-details-how-to-find":"如何找到此信息","tradein-buyflow-removed-message":"由于你选择了通过 iPhone 年年焕新计划进行升级，你的折抵设备已被移除。","tradein-verify-button-label":"验证","tradein-buyflow-initial-button":"立即开始<span class=\"visuallyhidden\">折抵换购</span>","tradein-shipping-confirm-address-header":"确认你的地址。","tradein-buyflow-device-summary-header":"你的折抵设备","tradein-inline-error":"你的请求出现问题。请稍后再试。","tradein-pincode-desc":"","tradein-location-header":"","tradein-shipping-unverified-address-button":"","tradein-products-display-label":"选择你的显示屏","tradein-questions-what-this-means":"如果以下情况全部符合，请选择“是”：","tradein-shipping-different-address-button":"输入其他地址","tradein-shipping-button-label":"完成","tradein-verified-label":"已验证","tradein-applegiveback":"Apple Trade In <span class=\"nowrap\">换购计划</span>","tradein-products-memory-label":"选择存储容量","tradein-shipping-provided-address-label":"你输入的地址","tradein-products-processor-label":"选择你的处理器","tradein-buyflow-remove-button":"删除",