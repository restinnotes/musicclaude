      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "78–83",
    "relation": "正在面对",
    "items": [
     {
      "id": "S10-1",
      "text": "有那么短短一阵，我终于不再紧盯以后会不会疼。",
      "key": "有那么短短一阵，",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-3"
      ]
     },
     {
      "id": "S10-2",
      "text": "我只觉得心里轻得不可思议，那份温柔也变得格外清亮。",
      "key": "我只觉得心里轻得",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-1"
      ]
     },
     {
      "id": "S10-3",
      "text": "这轻松并没有给我任何保证，却让我难得可以什么也不追着要。",
      "key": "这轻松并没有给我",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S09-3",
      "to": "S10-1",
      "rel": "引用"
     },
     {
      "from": "S10-1",
      "to": "S10-2",
      "rel": "引用"
     },
     {
      "from": "S10-2",
      "to": "S10-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S11",
    "bars": "84–92",
    "relation": "正在面对",
    "items": [
     {
      "id": "S11-1",
      "text": "当那份亲近又变得强烈，我这次没有像先前那样急着往后退。",
      "key": "当那份亲近又变得",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-2",
       "S10-3"
      ]
     },
     {
      "id": "S11-2",
      "text": "熟悉的幸福更沉也更热，欢喜大到几乎让我难受，我却宁愿完整地感受它。",
      "key": "熟悉的幸福更沉也",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-1",
       "S04-4"
      ]
     },
     {
      "id": "S11-3",
      "text": "我觉得自己终于做到了想做的事：没有因为怕留不住，就先少珍惜一点。",
      "key": "我觉得自己终于做",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2",
       "S11-1",
       "S11-2"
      ]
     },
     {
      "id": "S11-4",
      "text": "可我也知道，这只是眼下做到了，并不保证下一刻不会又害怕。",
      "key": "可我也知道，这只",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-3"
      ]
     }
    ],
    "because": [
     {
