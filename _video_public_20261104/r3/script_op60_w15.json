       ]
      }
     ]
    },
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "起初我怕给对方添负担，如今又怕有天对方不再需要我、连亲近也没了，便想藏回一点喜欢，少疼些；可我早已不能装作不在乎，刚才想对对方好也是真心的，真要收回反而难受。",
       "keys": [],
       "from": [
        "S13-2",
        "S13-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "幸福里掺进悲伤",
       "keys": [],
       "from": [
        "S13-B3-p3"
       ]
      },
      {
       "text": "握住才怕失去",
       "keys": [],
       "from": [
        "S13-B3-p4"
       ],
       "emotion": "不安"
      },
      {
       "text": "胸口一沉再沉",
