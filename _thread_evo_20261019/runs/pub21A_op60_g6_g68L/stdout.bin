e\": \"\",\n          \"keep\": \"他越想越高兴\"\n        },\n        {\n          \"text\": \"他盼着以后对方想有人陪时\",\n          \"point\": \"还会想到自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方想有人陪时\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"上回他无意间露了心意，这回见对方依然亲近\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"上次无意露意后\"\n        },\n        {\n          \"quote\": \"今天这样好不代表以后每天都能这样\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"今天好不等于天天好\"\n        },\n        {\n          \"quote\": \"快乐的余温尚在，心头却已泛起一阵怀念\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方仍愿意亲近\",\n          \"point\": \"想主动些\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"对方仍愿意亲近\"\n        },\n        {\n          \"text\": \"他甚至盼着\",\n          \"point\": \"能一直这样好下去\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"甚至盼着\"\n        },\n        {\n          \"text\": \"可一想到以后\",\n          \"point\": \"有点没底\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一想到以后\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"也许对方也喜欢有他陪着\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"也许也喜欢他陪着\"\n        },\n        {\n          \"quote\": \"强烈的渴望还在，却引而不发\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"眼前的美好其实比自己的愿望大得多\",\n          \"carrier\": \"比喻画面\",\n          \"screen