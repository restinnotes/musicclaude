       "from": [
        "S13-B4"
       ],
       "bead": "S13-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S14",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起最初的自己，他心里又软又酸。",
       "keys": [
        "最初的自己"
       ],
       "from": [
        "S14-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "就在要松下来的时候，最后那股浪又猛推了一下。",
       "keys": [],
       "from": [
        "S14-B3"
       ],
       "bead": "S14-B3"
      },
      {
       "text": "身体已经慢慢平静，心里却还留着那一点温热。",
       "keys": [],
       "from": [
        "S14-B3"
       ],
       "bead": "S14-B3"
      },
      {
       "text": "像刚刚从一场美梦里醒来，梦里的光还记得。",
       "keys": [],
       "from": [
        "S14-B3"
       ],
       "bead": "S14-B3"
      },
      {
       "text": "忽然有一句低低的歌，像有人独自沉思了一会儿。",
       "keys": [],
       "from": [
        "S14-B1"
       ],
       "bead": "S14-B1"
      },
      {
       "text": "像水面上最后一点水花，突然又闪出一点亮光。",
       "keys": [],
       "from": [
        "S14-B1"
       ],
       "bead": "S14-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不想再逼自己要永远的保证。",
