      linear-gradient(90deg, rgba(0,122,144,0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }
  .report-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 36px;
  }
  .report-category-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    padding: 7px 14px;
    border: 1px solid rgba(0,184,212,0.22);
    background: rgba(0,184,212,0.12);
    color: #00b8d4;
    font-family: "Sora", sans-serif;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .report-hero-title {
    max-width: 980px;
    margin-bottom: 16px;
    color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .report-hero-subtitle {
    max-width: 920px;
    margin-bottom: 24px;
    color: rgba(255,255,255,0.55);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.68;
  }
  .report-hero-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .hero-meta-item {
    display: flex;
    align-items: center;
    gap: 7px;
    color: rgba(255,255,255,0.58);
    font-size: 12px;
    line-height: 1;
  }
  .hero-meta-item svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    opacity: 0.72;
  }
  .hero-meta-label {
    color: rgba(255,255,255,0.66);
    font-weight: 500;
  }
  .hero-meta-value {
    color: rgba(255,255,255,0.84);
  }
  .report-nav {
    position: sticky;
    top: var(--er-header-offset);
    z-index: 70;
    position: sticky;
    background: #ffffff;
    border-bottom: 2px solid rgba(13,43,69,0.1);
    box-shadow: 0 2px 8px rgba(13,43,69,0.07);
    overflow: hidden;
  }
  .report-nav::before,
  .report-nav::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 44px;
    pointer-events: none;
    z-index: 1;
  }
  .report-nav::before {
    left: 0;
    background: linear-gradient(90deg, #ffffff 24%, rgba(255,255,255,0) 100%);
  }
  .report-nav::after {
    right: 0;
    background: linear-gradient(270deg, #ffffff 24%, rgba(255,255,255,0) 100%);
  }
  .report-nav-scroll {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid rgba(13,43,69,0.12);
    background: rgba(255,255,255,0.96);
    color: #506a80;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px rgba(13,43,69,0.08);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, opacity 0.2s ease;
  }
  .report-nav-scroll:hover {
    color: #0f8398;
    border-color: rgba(15,131,152,0.24);
    background: #ffffff;
  }
  .report-nav-scroll[disabled] {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }
  .report-nav-scroll--left {
    left: 10px;
  }
  .report-nav-scroll--right {
    right: 10px;
  }
  .report-nav-scroll svg {
    width: 12px;
    height: 12px;
  }
  .report-nav-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 56px;
    display: flex;
    align-items: center;
    gap: 2px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    mask-image: linear-gradient(to right, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
  }
  .report-nav-inner::-webkit-scrollbar {
    display: none;
  }
  .report-nav-link {
    flex: 0 0 auto;
    white-space: nowrap;
    padding: 16px 24px 14px;
    border-bottom: 2px solid transparent;
    color: #506a80;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .report-nav-link:hover {
    color: #007a90;
    border-color: #007a90;
  }
  .report-shell {
    max-width: 1560px;
    margin: 0 auto;
    padding: 26px 36px 40px;
    display: flex;
    flex-wrap: nowrap;
    gap: 28px;
    align-items: start;
  }
  .report-main-stack {
    flex: 1 1 auto;
    width: auto;
    max-width: none;
    min-width: 0;
  }
  .report-sidebar-stack {
    display: block;
    flex: 0 0 360px;
    width: 360px;
    max-width: 360px;
    min-width: 0;
    align-self: start;
    margin-left: auto;
  }
  .snapshot-bar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-bottom: 24px;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 18px 34px rgba(8, 28, 45, 0.16);
    overflow: hidden;
  }
  .snap-item {
    background: linear-gradient(180deg, #2e5273 0%, #355a7d 100%);
    padding: 14px 18px 12px;
    text-align: center;
    min-height: 86px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .snap-label {
    color: rgba(218, 231, 241, 0.72);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 6px;
    line-height: 1.35;
  }
  .snap-value {
    color: #05c3eb;
    font-family: "Sora", sans-serif;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  .snap-value.teal { color: #05c3eb; }
  .snap-value.gold { color: #f5a623; }
  .content-block {
    background: #ffffff;
    border: 1px solid rgba(13,43,69,0.1);
    padding: 32px;
    margin-bottom: 24px;
    box-shadow: 0 2px 8px rgba(13,43,69,0.07);
  }
  .exec-summary {
    position: relative;
    overflow: hidden;
    border: 0;
    padding: 36px 36px 32px;
    background: linear-gradient(135deg, #0d2b45 0%, #0f3554 100%);
  }
  .exec-summary::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #007a90, #00b8d4);
  }
  .section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    color: #0d2b45;
    font-family: "Sora", sans-serif;
    font-size: 22px;
    font-weight: 700;
  }
  .section-title::before {
    content: '';
    width: 4px;
    height: 22px;
    border-radius: 2px;
    background: #007a90;
    flex-shrink: 0;
  }
  .exec-summary .section-title {
    color: #ffffff;
  }
  .exec-summary .section-title::before {
    background: #00b8d4;
  }
  .body-text {
    color: rgba(255,255,255,0.8);
    font-size: 15px;
    line-height: 1.8;
  }
  .body-text + .body-text {
    margin-top: 12px;
  }
  .body-text strong {
    color: #00b8d4;
    font-weight: 700;
  }
  .exec-kpi-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 28px;
    background: rgba(255,255,255,0.08);
  }
  .exec-kpi {
    background: rgba(255,255,255,0.06);
    padding: 18px 16px 16px;
    text-align: center;
  }
  .exec-kpi-num {
    color: #00b8d4;
    font-family: "Sora", sans-serif;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.1;
  }
  .exec-kpi-lbl {
    margin-top: 6px;
    color: rgba(255,255,255,0.48);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .figure-block {
    background: transparent;
    border: 0;
    padding: 0;
    overflow: visible;
    margin-top: 24px;
  }
  .figure-block-inline {
    border: 0;
    background: transparent;
    overflow: visible;
    margin-top: 20px;
    margin-bottom: 24px;
  }
  .figure-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 24px 10px;
    border-bottom: 1px solid rgba(13,43,69,0.12);
    flex-wrap: wrap;
  }
  .figure-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #506a80;
    font-weight: 500;
  }
  .figure-source {
    font-size: 11px;
    color: #8aa0b2;
    font-style: italic;
  }
  .figure-heading {
    font-family: "Sora", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #0d2b45;
    padding: 16px 24px 12px;
    border-bottom: 1px solid rgba(13,43,69,0.12);
  }
  .figure-image-wrap {
    padding: 16px 18px;
    background: #ffffff;
  }
  .figure-image-frame {
    border: 1px dashed rgba(0,184,212,0.32);
    background: #fdfefe;
    padding: 0;
    min-height: 260px;
    aspect-ratio: 16 / 9;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .figure-image-frame .img-fluid,
  .figure-image-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }
  .figure-image-lightbox-trigger {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(13,43,69,0.14);
    border-radius: 999px;
    background: rgba(255,255,255,0.96);
    color: #0f8ea7;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 24px rgba(13,43,69,0.12);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
    z-index: 2;
  }
  .figure-image-lightbox-trigger:hover {
    transform: translateY(-1px);
    color: #14a8c3;
    box-shadow: 0 14px 28px rgba(13,43,69,0.16);
  }
  .figure-image-lightbox-trigger svg {
    width: 18px;
    height: 18px;
  }
  .figure-lightbox {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(4, 17, 31, 0.82);
    backdrop-filter: blur(5px);
    z-index: 9999;
  }
  .figure-lightbox.is-open {
    display: flex;
  }
  .figure-lightbox__backdrop {
    position: absolute;
    inset: 0;
  }
  .figure-lightbox__dialog {
    position: relative;
    z-index: 1;
    width: min(1100px, 100%);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .figure-lightbox__close {
    align-self: flex-end;
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 999px;
    background: rgba(255,255,255,0.14);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  .figure-lightbox__frame {
    background: #fff;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 28px 56px rgba(0,0,0,0.22);
    overflow: auto;
  }
  .figure-lightbox__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(90vh - 110px);
    object-fit: contain;
    margin: 0 auto;
  }
  .figure-cta-strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px 24px;
    padding: 20px 24px;
    background: linear-gradient(135deg, #f8fbfd 0%, #eef5f8 100%);
    border-top: 1px solid rgba(13,43,69,0.1);
  }
  .figure-cta-copy {
    min-width: 0;
  }
  .figure-cta-text {
    margin: 0;
    max-width: 700px;
    font-size: 14px;
    line-height: 1.7;
    color: #355166;
    font-style: normal;
  }
  .figure-cta-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    flex-wrap: wrap;
  }
  .figure-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 22px;
    border: 1px solid transparent;
    background: #0f8ea7;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 12px 24px rgba(15, 142, 167, 0.14);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .figure-cta-btn:hover {
    background: #10c5e8;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff;
    text-decoration: none;
    transform: translateY(-1px);
  }
  .figure-cta-btn--secondary {
    background: #ffffff;
    border-color: rgba(15, 142, 167, 0.28);
    color: #163a56 !important;
    -webkit-text-fill-color: #163a56;
    box-shadow: none;
  }
  .figure-cta-btn--secondary:hover {
    border-color: #0f8ea7;
    background: #ffffff;
    color: #0f8ea7 !important;
    -webkit-text-fill-color: #0f8ea7;
  }
  .figure-cta-strip .figure-cta-btn,
  .figure-cta-strip .figure-cta-btn:hover,
  .figure-cta-strip .figure-cta-btn:focus {
    text-decoration: none !important;
  }
  .figure-cta-strip--dark {
    display: block;
    position: relative;
    overflow: hidden;
    margin-top: 18px;
    padding: 16px 18px 15px;
    border: 0;
    border-left: 3px solid #0667ac;
    border-radius: 7px;
    background: #f1f4fb;
    box-shadow: none;
  }
  .figure-cta-strip--dark::before {
    display: none;
  }
  .figure-cta-strip--dark > * {
    position: static;
  }
  .figure-cta-strip--dark .figure-cta-text {
    max-width: none;
    color: #000000 !important;
    -webkit-text-fill-color: #000000;
    font-size: 16px;
    font-style: italic;
    font-weight: 700;
    line-height: 1.58;
    text-shadow: none;
  }
  .figure-cta-strip--dark .figure-cta-actions {
    display: block;
    margin-top: 4px;
    text-align: left;
  }
  .figure-cta-strip--dark .figure-cta-btn {
    display: inline;
    min-height: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #df240f !important;
    -webkit-text-fill-color: #df240f;
    font-size: 16px;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.58;
    text-transform: none;
    text-decoration: underline !important;
    box-shadow: none;
    white-space: normal;
  }
  .figure-cta-strip--dark .figure-cta-btn:hover {
    background: transparent;
    color: #b91c1c !important;
    -webkit-text-fill-color: #b91c1c;
    box-shadow: none;
    transform: none;
  }
  .company-overview-cta {
    position: relative;
    margin-top: 24px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid rgba(13,43,69,0.12);
    background:
      radial-gradient(circle at top right, rgba(0,184,212,0.16), transparent 34%),
      linear-gradient(135deg, #0a2238 0%, #0d2b45 54%, #163a56 100%);
    box-shadow: 0 22px 36px rgba(8, 28, 45, 0.18);
  }
  .company-overview-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 34px 34px;
    pointer-events: none;
  }
  .company-overview-cta__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px 24px;
    align-items: center;
    padding: 22px 24px;
  }
  .company-overview-cta__copy {
    min-width: 0;
    max-width: 100%;
  }
  .company-overview-cta__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: #8ddff0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .company-overview-cta__eyebrow::before {
    content: '';
    width: 26px;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }
  .company-overview-cta__text {
    margin: 0;
    max-width: 720px;
    color: #f4fbff !important;
    -webkit-text-fill-color: #f4fbff;
    opacity: 1;
    font-size: 14px;
    line-height: 1.75;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.08);
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .company-overview-cta__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-width: 0;
    max-width: 100%;
  }
  .company-overview-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    max-width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(0,184,212,0.34);
    background: linear-gradient(180deg, #11c2df 0%, #079dba 100%);
    color: #08384b !important;
    -webkit-text-fill-color: #08384b;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 14px 26px rgba(5,184,216,0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    overflow-wrap: anywhere;
  }
  .company-overview-cta__btn:hover {
    color: #062f3f !important;
    -webkit-text-fill-color: #062f3f;
    text-decoration: none;
    filter: brightness(1.06);
    transform: translateY(-1px);
    box-shadow: 0 18px 30px rgba(5,184,216,0.22);
  }
  .report-prose {
    color: #20364a;
    font-size: 15px;
    line-height: 1.82;
  }
  .report-prose > * + * {
    margin-top: 14px;
  }
  .report-prose h3 {
    font-family: "Sora", sans-serif;
    font-size: 15.5px;
    font-weight: 700;
    color: #0d2b45;
    line-height: 1.35;
    margin: 0 0 12px;
  }
  .report-prose h4 {
    font-size: 14px;
    font-weight: 700;
    color: #0d2b45;
    line-height: 1.35;
    margin: 20px 0 8px;
  }
  .report-prose p,
  .report-prose li {
    color: #20364a;
    font-size: 15px;
    line-height: 1.82;
  }
  .report-prose p + p {
    margin-top: 14px;
  }
  .market-size-prose h3 {
    color: #0d2b45;
    font-size: 16px;
    font-weight: 700;
    padding: 0;
    margin: 22px 0 10px;
  }
  .market-size-prose h3:first-child {
    margin-top: 0;
  }
  .market-size-prose ul {
    padding-left: 22px;
    margin: 12px 0 24px;
    list-style: disc;
  }
  .market-size-prose li {
    line-height: 1.55;
  }
  .market-size-prose li::marker {
    color: #20364a;
    font-size: 0.8em;
  }
  .report-prose ul,
  .report-prose ol {
    padding-left: 20px;
    margin: 14px 0;
  }
  .report-prose ul {
    list-style: disc;
  }
  .report-prose ol {
    list-style: decimal;
  }
  .report-prose li + li {
    margin-top: 8px;
  }
  .segmentation-scope ul {
    padding-left: 20px;
    margin-top: 16px;
    list-style: disc;
  }
  .segmentation-scope h3 {
    color: #1f2933;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.45;
    margin: 18px 0 6px;
    padding: 0;
    border-top: 0;
  }
  .segmentation-scope h3:first-child {
    margin-top: 0;
  }
  .segmentation-scope h3 + ul {
    margin-top: 4px;
    margin-bottom: 14px;
  }
  .report-prose.segmentation-scope > h3:not(:first-child),
  .report-prose.segmentation-scope > h4:not(:first-child) {
    padding-top: 0;
    border-top: 0;
  }
  .segmentation-scope li,
  .report-toc-source li {
    padding-left: 2px;
  }
  .segmentation-scope li::marker,
  .report-toc-source li::marker,
  .toc-list li::marker {
    color: #20364a;
    font-size: 0.8em;
  }
  .report-nested-list {
    padding-left: 22px;
    margin: 16px 0 0;
    list-style: disc;
  }
  .report-nested-list ul {
    padding-left: 30px;
    margin: 8px 0 14px;
    list-style: circle;
  }
  .report-nested-list ul ul {
    padding-left: 28px;
    list-style: square;
  }
  .report-nested-list li {
    color: #20364a;
    font-size: 15px;
    line-height: 1.65;
  }
  .report-nested-list li + li {
    margin-top: 7px;
  }
  .report-nested-list > li {
    margin-top: 13px;
  }
  .report-nested-list > li:first-child {
    margin-top: 0;
  }
  .report-nested-list strong {
    color: #1f2933;
    font-weight: 700;
  }
  .segmentation-scope .report-nested-list > li > .head,
  .report-toc-source .report-nested-list > li > .head {
    color: #1f2933;
    font-weight: 700;
  }
  .report-toc-source .report-toc-list {
    padding-left: 0;
    list-style: none;
  }
  .report-toc-source .report-toc-list > li {
    margin-top: 6px;
  }
  .report-toc-source .report-toc-list > li::marker {
    content: '';
  }
  .report-toc-source .report-toc-list > li > .head,
  .report-toc-source .report-toc-list > li > strong,
  .report-toc-source .report-toc-list > li > a.js-open-sample-toc {
    display: block;
    box-sizing: border-box;
    width: 100%;
    padding: 7px 10px;
    background: #f2f2f2;
    color: #062231;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.45;
    text-transform: uppercase;
  }
  .report-toc-source .report-toc-list > li > a.js-open-sample-toc {
    text-decoration: none;
  }
  .report-toc-source .report-toc-list > li > a.js-open-sample-toc:hover {
    color: #0b6b78;
  }
  .report-toc-source .report-toc-list > li.toc-is-collapsible > .head,
  .report-toc-source .report-toc-list > li.toc-is-collapsible > strong {
    cursor: pointer;
  }
  .report-toc-source .report-toc-list > li.toc-collapsed > ul {
    display: none;
  }
  .report-toc-source .report-toc-list > li > ul {
    margin: 7px 0 10px;
    padding-left: 36px;
  }
  .report-toc-source .report-toc-list > li > ul li {
    font-size: 13px;
    line-height: 1.55;
  }
  .report-prose hr {
    border: 0;
    border-top: 1px solid rgba(13,43,69,0.12);
    margin: 28px 0;
  }
  .report-prose > h3:not(:first-child),
  .report-prose > h4:not(:first-child) {
    padding-top: 28px;
    border-top: 1px solid rgba(13,43,69,0.12);
  }
  .company-chip-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 22px;
  }
  .company-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid rgba(13,43,69,0.14);
    background: #f8fbfd;
    color: #0d2b45;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
  }
  .company-rank {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: rgba(0,184,212,0.14);
    color: #00a3bd;
    font-size: 10px;
    font-weight: 700;
    flex: 0 0 auto;
  }
  .recent-dev-block {
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid rgba(13,43,69,0.12);
  }
  .recent-dev-heading {
    color: #0d2b45;
    font-family: "Sora", sans-serif;
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 14px;
  }
  .toc-block {
    margin-top: 32px;
  }
  .toc-list {
    margin: 18px 0 0;
    padding-left: 20px;
    list-style: disc;
  }
  .toc-list li + li {
    margin-top: 10px;
  }
  .toc-list a {
    color: #0d2b45;
    font-size: 15px;
    line-height: 1.65;
    text-decoration: none;
  }
  .toc-list a:hover {
    color: #007a90;
  }
  .toc-list__desc {
    display: block;
    color: #5a7185;
    font-size: 13px;
    line-height: 1.5;
    margin-top: 2px;
  }
  .toc-grid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(13,43,69,0.12);
    border-left: 1px solid rgba(13,43,69,0.12);
  }
  .toc-item {
    display: block;
    padding: 18px 20px 16px;
    border-right: 1px solid rgba(13,43,69,0.12);
    border-bottom: 1px solid rgba(13,43,69,0.12);
    text-decoration: none;
    background: #ffffff;
    transition: background 0.2s ease;
  }
  .toc-item:hover {
    background: #fbfdfe;
  }
  .toc-index {
    color: #0f9fcb;
    font-family: "Sora", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .toc-title {
    margin-top: 10px;
    color: #0d2b45;
    font-family: "Sora", sans-serif;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
  }
  .toc-desc {
    margin-top: 8px;
    color: #5a7185;
    font-size: 14px;
    line-height: 1.6;
  }
  .faq-block {
    margin-top: 32px;
  }
  .faq-list {
    margin-top: 10px;
  }
  .faq-item {
    border-bottom: 1px solid rgba(13,43,69,0.12);
    padding: 18px 0;
  }
  .faq-item[open] {
    padding-bottom: 20px;
  }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    cursor: pointer;
    list-style: none;
    color: #0d2b45;
    font-size: 15px;
    font-weight: 600;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 1px solid rgba(13,43,69,0.16);
    color: #0f8398;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    font-size: 18px;
    line-height: 1;
  }
  .faq-item[open] .faq-icon {
    background: #0f8398;
    border-color: #0f8398;
    color: #ffffff;
  }
  .faq-answer {
    margin-top: 18px;
    max-width: 92%;
    color: #506a80;
    font-size: 15px;
    line-height: 1.82;
  }
  .addresses-block {
    margin-top: 32px;
  }
  .addresses-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 18px;
  }
  .addr-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid rgba(13,43,69,0.12);
    background: #f8fbfd;
    color: #0d2b45;
    font-size: 15px;
    line-height: 1.55;
  }
  .addr-check {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: #0f8398;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    margin-top: 1px;
  }
  .addr-check svg {
    width: 11px;
    height: 11px;
  }
  .author-card {
    margin-top: 32px;
    padding: 24px 24px 22px;
    border: 1px solid rgba(13,43,69,0.12);
    background: #ffffff;
  }
  .author-card__inner {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }
  .author-card__avatar {
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: linear-gradient(135deg, #0f8398 0%, #11a6bf 100%);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Sora", sans-serif;
    font-size: 18px;
    font-weight: 700;
    flex: 0 0 auto;
    overflow: hidden;
  }
  .author-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .author-card__name {
    color: #0d2b45;
    font-family: "Sora", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
  }
  .author-card__name:hover {
    color: #0f8398;
  }
  .author-card__role {
    margin-top: 5px;
    color: #0f8398;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .author-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .author-card__profile-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 8px;
    color: #0f8398;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .author-card__profile-link:hover {
    color: #0d2b45;
  }
  .author-card__bio {
    margin-top: 10px;
    color: #506a80;
    font-size: 14px;
    line-height: 1.78;
    max-width: 760px;
  }
  .author-card__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .author-card__topic {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 12px;
    border: 1px solid rgba(15,131,152,0.18);
    background: rgba(15,131,152,0.06);
    color: #0f8398;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .author-card__meta {
    margin-top: 12px;
    color: #6b7f92;
    font-size: 13px;
  }
  .rd-inline-cta {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    margin: 22px 0 0;
    padding: 24px 26px;
    border: 1px solid rgba(15, 142, 167, 0.18);
    background: linear-gradient(135deg, #f8fcfd 0%, #eef7fa 72%, #e6f2f6 100%);
  }
  .rd-inline-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(16, 197, 232, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(16, 197, 232, 0.04) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }
  .rd-inline-cta__copy,
  .rd-inline-cta__actions {
    position: relative;
    z-index: 1;
  }
  .rd-inline-cta__copy {
    max-width: 760px;
  }
  .rd-inline-cta__label {
    display: inline-block;
    margin-bottom: 8px;
    font-family: "Sora", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #0f8398;
  }
  .rd-inline-cta__title {
    margin: 0 0 10px;
    font-family: "Sora", sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: #163a56;
  }
  .rd-inline-cta__text {
    margin: 0;
    color: #476178;
    font-size: 14px;
    line-height: 1.75;
  }
  .rd-inline-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .rd-inline-cta__btn,
  .rd-inline-cta__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    -webkit-text-fill-color: currentColor;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .rd-inline-cta__btn {
    background: #0f8ea7;
    color: #fff !important;
    -webkit-text-fill-color: #fff;
    box-shadow: 0 12px 24px rgba(15, 142, 167, 0.16);
  }
  .rd-inline-cta__btn:hover {
    background: #10c5e8;
    color: #fff !important;
    -webkit-text-fill-color: #fff;
    transform: translateY(-1px);
  }
  .rd-inline-cta__link {
    background: #fff;
    border: 1px solid rgba(15, 142, 167, 0.35);
    color: #163a56 !important;
    -webkit-text-fill-color: #163a56;
  }
  .rd-inline-cta__link:hover {
    border-color: #0f8ea7;
    color: #0f8ea7 !important;
    -webkit-text-fill-color: #0f8ea7;
  }
  .rd-inline-cta .rd-inline-cta__btn,
  .rd-inline-cta .rd-inline-cta__btn:hover,
  .rd-inline-cta .rd-inline-cta__btn:focus,
  .rd-inline-cta .rd-inline-cta__link,
  .rd-inline-cta .rd-inline-cta__link:hover,
  .rd-inline-cta .rd-inline-cta__link:focus {
    text-decoration: none !important;
  }
  .report-prose a,
  .mck-article a,
  table a {
    color: #0f8398;
    text-decoration: underline;
    text-decoration-color: rgba(15,131,152,0.24);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .report-prose a:hover,
  .mck-article a:hover,
  table a:hover {
    color: #0d2b45;
    text-decoration-color: rgba(13,43,69,0.35);
  }
  .report-citation {
    position: relative;
    display: inline-block;
    margin-left: 1px;
    font-size: 0.72em;
    line-height: 1;
    vertical-align: super;
  }
  .report-citation > span:first-child {
    color: #0f8398;
    cursor: pointer;
    font-weight: 700;
    text-decoration: none;
  }
  .report-citation > span:first-child:hover {
    color: #0d2b45;
    text-decoration: underline;
  }
  .report-citation__tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    z-index: 60;
    width: min(360px, calc(100vw - 32px));
    padding: 10px 12px;
    border: 1px solid rgba(13,43,69,0.16);
    background: #ffffff;
    box-shadow: 0 12px 34px rgba(13,43,69,0.18);
    color: #20364a;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.55;
    text-align: left;
    transform: translateX(-50%) translateY(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .report-citation__tooltip::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 8px;
    height: 8px;
    border-right: 1px solid rgba(13,43,69,0.16);
    border-bottom: 1px solid rgba(13,43,69,0.16);
    background: #ffffff;
    transform: translate(-50%, -4px) rotate(45deg);
  }
  .report-citation:hover .report-citation__tooltip,
  .report-citation:focus-within .report-citation__tooltip {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .report-reference-list {
    margin: 0;
    padding-left: 22px;
  }
  .report-reference-list li {
    color: #20364a;
    font-size: 14px;
    line-height: 1.7;
    padding-left: 4px;
  }
  .report-reference-list li + li {
    margin-top: 10px;
  }
  .report-sidebar-card {
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid rgba(13,43,69,0.12);
    background: #ffffff;
    box-shadow: 0 8px 40px rgba(13,43,69,0.14);
  }
  .report-sidebar-card__head {
    padding: 20px 24px 18px;
    border-top: 3px solid #00b8d4;
    background: #133a5a;
    color: #ffffff;
  }
  .report-sidebar-card__eyebrow {
    color: rgba(255,255,255,0.55);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .report-sidebar-card__title {
    font-family: "Sora", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
  }
  .report-sidebar-card__figures {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(255,255,255,0.08);
  }
  .report-sidebar-card__fig {
    background: rgba(255,255,255,0.08);
    padding: 14px 16px;
  }
  .report-sidebar-card__fig-label {
    color: rgba(255,255,255,0.42);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .report-sidebar-card__fig-value {
    color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.1;
  }
  .report-sidebar-card__fig-value.teal {
    color: #00b8d4;
  }
  .report-sidebar-card__body {
    box-sizing: border-box;
    padding: 24px;
  }
  .report-sidebar-card__section-title {
    margin-bottom: 14px;
    color: #0d2b45;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .license-tier {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 16px 14px;
    border: 1px solid rgba(13,43,69,0.12);
    margin-bottom: 10px;
    background: #ffffff;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .license-tier.is-selected {
    border-color: #00b8d4;
    box-shadow: inset 0 0 0 1px rgba(0,184,212,0.28);
    background: #f9fdff;
  }
  .license-tier__radio {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid rgba(13,43,69,0.18);
    position: relative;
  }
  .license-tier.is-selected .license-tier__radio {
    border-color: #009ab5;
  }
  .license-tier.is-selected .license-tier__radio::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: #009ab5;
  }
  .license-tier__name {
    color: #0d2b45;
    font-size: 15px;
    font-weight: 700;
  }
  .license-tier__desc {
    color: #0d2b45;
    font-size: 14px;
    font-weight: 600;
  }
  .license-tier__price {
    color: #0d2b45;
    font-family: "Sora", sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
  }
  .report-sidebar-card__cta {
    box-sizing: border-box;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 52px;
    margin-top: 12px;
    padding: 14px 18px;
    border-radius: 4px;
    background: linear-gradient(180deg, #1699af 0%, #0f8398 100%);
    color: #ffffff;
    text-decoration: none;
    font-family: "Sora", sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 10px 20px rgba(15, 131, 152, 0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .report-sidebar-card__cta:hover {
    background: linear-gradient(180deg, #1aa2ba 0%, #128da3 100%);
    transform: translateY(-1px);
    box-shadow: 0 14px 24px rgba(15, 131, 152, 0.22);
  }
  .report-sidebar-card__secondary {
    box-sizing: border-box;
    margin-top: 16px;
  }
  .report-sidebar-card__or {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 14px 0 16px;
    color: #7b8b9d;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .report-sidebar-card__or::before,
  .report-sidebar-card__or::after {
    content: '';
    flex: 1 1 auto;
    height: 1px;
    background: rgba(13,43,69,0.12);
  }
  .report-sidebar-card__ghost {
    box-sizing: border-box;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 50px;
    padding: 13px 18px;
    border: 1px solid rgba(15,131,152,0.28);
    border-radius: 4px;
    color: #0d6f82;
    text-decoration: none;
    font-family: "Sora", sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    background: #f8fcfe;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .report-sidebar-card__ghost + .report-sidebar-card__ghost {
    margin-top: 12px;
  }
  .report-sidebar-card__ghost.alt {
    border-color: rgba(13,43,69,0.18);
    color: #0d2b45;
    background: #ffffff;
  }
  .report-sidebar-card__ghost:hover {
    background: #eef7fa;
    border-color: rgba(15,131,152,0.42);
    transform: translateY(-1px);
  }
  .report-sidebar-card__ghost.alt:hover {
    background: #f6f9fb;
    border-color: rgba(13,43,69,0.28);
    transform: translateY(-1px);
  }
  .sidebar-analyst-card {
    border: 1px solid rgba(13,43,69,0.12);
    background: #ffffff;
    box-shadow: 0 8px 32px rgba(13,43,69,0.08);
  }
  .sidebar-trust-list {
    display: grid;
    gap: 16px;
  }
  .sidebar-trust-list--embedded {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid rgba(13,43,69,0.12);
  }
  .sidebar-trust-item {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    color: #5d7386;
    font-size: 15px;
    line-height: 1.6;
  }
  .sidebar-trust-icon {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: #f2f8fb;
    color: #0f8398;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sidebar-trust-item span {
    font-size: 13px;
  }
  .sidebar-trust-icon svg {
    width: 16px;
    height: 16px;
  }
  .sidebar-analyst-card {
    padding: 22px 20px 20px;
  }
  .sidebar-analyst-eyebrow {
    color: #0f8398;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .sidebar-analyst-head {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    margin-bottom: 14px;
  }
  .sidebar-analyst-avatar {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: #103a5c;
    color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: 18px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .sidebar-analyst-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sidebar-analyst-name {
    display: inline-block;
    color: #0d2b45;
    font-family: "Sora", sans-serif;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }
  .sidebar-analyst-name:hover {
    color: #0f8398;
  }
  .sidebar-analyst-role {
    margin-top: 4px;
    color: #6a7f92;
    font-size: 13px;
    line-height: 1.35;
  }
  .sidebar-analyst-copy {
    color: #5d7386;
    font-size: 13px;
    line-height: 1.7;
    margin-bottom: 16px;
  }
  .sidebar-analyst-cta {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    padding: 14px 18px;
    border: 1px solid rgba(13,43,69,0.22);
    border-radius: 4px;
    color: #0d2b45;
    background: #ffffff;
    text-decoration: none;
    font-family: "Sora", sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .sidebar-analyst-cta:hover {
    background: #f6f9fb;
    border-color: rgba(13,43,69,0.34);
    transform: translateY(-1px);
  }
  .sidebar-related-card {
    border: 1px solid rgba(13,43,69,0.12);
    background: #ffffff;
    box-shadow: 0 8px 32px rgba(13,43,69,0.08);
    padding: 18px 20px 10px;
  }
  .sidebar-related-eyebrow {
    color: #0f8398;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .sidebar-related-item {
    display: block;
    text-decoration: none;
    padding: 16px 0;
    border-top: 1px solid rgba(13,43,69,0.12);
  }
  .sidebar-related-item:first-of-type {
    border-top: 0;
    padding-top: 10px;
  }
  .sidebar-related-taxonomy {
    color: #0f8398;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .sidebar-related-title {
    margin-top: 8px;
    color: #0d2b45;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 500;
  }
  .sidebar-related-cagr {
    margin-top: 8px;
    color: #0d9b63;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
  }
  .sidebar-related-item:hover .sidebar-related-title {
    color: #0f8398;
  }
  .rd-similar-reports {
    background: #ffffff;
    border-top: 1px solid rgba(18,55,87,0.08);
    border-bottom: 1px solid rgba(18,55,87,0.08);
  }
  .rd-similar-reports__inner {
    max-width: 1304px;
    margin: 0 auto;
    padding: 30px 36px 34px;
  }
  .rd-similar-reports__heading {
    margin: 0 0 26px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #0a1f34;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
  }
  .rd-similar-reports__heading svg {
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    color: #0a1f34;
  }
  .rd-similar-reports__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 42px;
  }
  .rd-similar-reports__item {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    color: #102a43;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.45;
    text-decoration: none;
  }
  .rd-similar-reports__item:hover {
    color: #5b2a78;
  }
  .rd-similar-reports__item-icon {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    color: #0868ad;
  }
  .rd-similar-reports__arrow {
    margin-left: 4px;
    color: #5b2a78;
    font-weight: 500;
  }
  .report-cta-band {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(135deg, #0a2238 0%, #0d2b45 50%, #0f3554 100%);
    background-size: 64px 64px, 64px 64px, cover;
  }
  .report-cta-band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(9,31,49,0.16) 0%, rgba(9,31,49,0.02) 34%, rgba(9,31,49,0.14) 100%);
    pointer-events: none;
  }
  .report-cta-band__inner {
    position: relative;
    z-index: 1;
    max-width: 980px;
    margin: 0 auto;
    padding: 58px 24px 64px;
    text-align: center;
  }
  .report-cta-band__title {
    color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.04em;
    font-weight: 800;
    margin: 0;
  }
  .report-cta-band__accent {
    color: #05b8d8;
  }
  .report-cta-band__copy {
    max-width: 760px;
    margin: 20px auto 0;
    color: rgba(214,226,237,0.9);
    font-size: 16px;
    line-height: 1.65;
  }
  .report-cta-band__actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .report-cta-band__btn {
    min-width: 212px;
    min-height: 40px;
    padding: 12px 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: "Sora", sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 4px;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .report-cta-band__btn--primary {
    background: #0f8ea4;
    border: 1px solid #0f8ea4;
    color: #ffffff;
  }
  .report-cta-band__btn--primary:hover {
    background: #107f92;
    border-color: #107f92;
    transform: translateY(-1px);
  }
  .report-cta-band__btn--secondary {
    background: transparent;
    border: 1px solid rgba(214,226,237,0.28);
    color: #ffffff;
  }
  .report-cta-band__btn--secondary:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(214,226,237,0.42);
    transform: translateY(-1px);
  }
  .report-mobile-dock {
    box-sizing: border-box;
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    transform: none;
    width: 100%;
    padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
    background: #ffffff;
    border-top: 1px solid rgba(11, 31, 68, 0.08);
    border-radius: 0;
    box-shadow: none;
  }
  .report-mobile-dock__item {
    box-sizing: border-box;
    min-width: 0;
    min-height: 50px;
    padding: 5px 4px 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    text-align: center;
    text-decoration: none;
    border-radius: 14px;
    color: rgba(11, 31, 68, 0.74);
    background: transparent;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }
  .report-mobile-dock__item,
  .report-mobile-dock__item:focus-visible {
    outline: none;
  }
  .report-mobile-dock__item {
    appearance: none;
    border: 0;
    cursor: pointer;
  }
  .report-mobile-dock__item:hover {
    color: #0b1f44;
    background: rgba(15, 142, 164, 0.04);
    transform: translateY(-1px);
  }
  .report-mobile-dock__item--primary {
    background: rgba(15, 142, 164, 0.1);
    color: #ffffff;
  }
  .report-mobile-dock__item--primary:hover {
    background: rgba(15, 142, 164, 0.14);
  }
  .report-mobile-dock__icon {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 0;
    background: #f4f9fc;
    color: currentColor;
    flex-shrink: 0;
  }
  .report-mobile-dock__item--primary .report-mobile-dock__icon {
    border-color: rgba(15, 142, 164, 0.16);
    background: linear-gradient(135deg, #19a5bc 0%, #0f8ea4 100%);
    color: #ffffff;
    box-shadow: 0 8px 18px rgba(15, 142, 164, 0.2);
  }
  .report-mobile-dock__icon svg {
    width: 13px;
    height: 13px;
    stroke: currentColor;
  }
  .report-mobile-dock__label {
    display: block;
    font-family: "Sora", "Segoe UI", sans-serif;
    font-size: 9px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.01em;
  }
  .report-mobile-dock__item--primary .report-mobile-dock__label {
    color: #0b1f44;
  }
  .emer-sample-modal {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    overflow-x: hidden;
    box-sizing: border-box;
    contain: layout;
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s ease;
  }
  .emer-sample-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .emer-sample-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(7, 24, 37, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .emer-sample-modal__viewport {
    position: relative;
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
  }
  .emer-sample-modal__card {
    width: 100%;
    max-width: 500px;
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    overflow-x: hidden;
    background: #fff;
    box-shadow: 0 32px 80px rgba(7, 24, 37, 0.5);
    transform: translateY(20px) scale(0.975);
    opacity: 0;
    transition: transform .32s cubic-bezier(.22,.8,.3,1), opacity .28s ease;
    box-sizing: border-box;
  }
  .emer-sample-modal.is-open .emer-sample-modal__card {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  .emer-sample-modal__bar {
    height: 3px;
    background: linear-gradient(90deg, #00B8D4, #007A90);
  }
  .emer-sample-modal__header {
    position: relative;
    overflow: hidden;
    padding: 22px 26px 20px;
    background: #0D2B45;
  }
  .emer-sample-modal__header::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 184, 212, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 184, 212, 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }
  .emer-sample-modal__header-inner {
    position: relative;
    z-index: 1;
    padding-right: 40px;
  }
  .emer-sample-modal__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 11px;
    margin-bottom: 11px;
    background: rgba(0, 184, 212, 0.11);
    border: 1px solid rgba(0, 184, 212, 0.22);
  }
  .emer-sample-modal__eyebrow-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #00B8D4;
    animation: emerSampleBlink 2.2s ease-in-out infinite;
  }
  .emer-sample-modal__eyebrow-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 8.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #00B8D4;
  }
  @keyframes emerSampleBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.28; }
  }
  .emer-sample-modal__close {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 2;
    width: 30px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid rgba(255, 255, 255, 0.13);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    transition: all .18s ease;
  }
  .emer-sample-modal__close:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
    transform: rotate(90deg);
  }
  .emer-sample-modal__title {
    margin: 0 0 6px;
    font-family: 'Instrument Serif', serif;
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 400;
    color: #fff;
    line-height: 1.2;
  }
  .emer-sample-modal__title-em {
    font-style: italic;
    color: #00B8D4;
  }
  .emer-sample-modal__subtitle {
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
  }
  .emer-sample-modal__report-strip {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    width: 100%;
    box-sizing: border-box;
  }
  .emer-sample-modal__report-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #00B8D4;
    background: rgba(0, 184, 212, 0.1);
    border: 1px solid rgba(0, 184, 212, 0.2);
  }
  .emer-sample-modal__report-icon svg {
    width: 14px;
    height: 14px;
  }
  .emer-sample-modal__report-name {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.85);
  }
  .emer-sample-modal__report-meta {
    margin-top: 2px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.28);
  }
  .emer-sample-modal__form {
    padding: 22px 26px 26px;
    width: 100%;
    box-sizing: border-box;
  }
  .emer-sample-modal__field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
    align-items: start;
  }
  .emer-sample-modal__field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }
  .emer-sample-modal__field--full {
    margin-bottom: 16px;
  }
  .emer-sample-modal__label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3b556d;
  }
  .emer-sample-modal__required {
    color: #00B8D4;
    font-size: 13px;
  }
  .emer-sample-modal__input-wrap {
    position: relative;
    width: 100%;
  }
  .emer-sample-modal__input-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #8BA5BA;
    pointer-events: none;
    transition: color .18s ease;
  }
  .emer-sample-modal__input-wrap:focus-within .emer-sample-modal__input-icon {
    color: #007A90;
  }
  .emer-sample-modal__input,
  .emer-sample-modal__select {
    width: 100%;
    height: 46px;
    display: block;
    max-width: 100%;
    padding: 0 13px 0 40px;
    border: 1px solid #c9d6e2;
    border-radius: 8px;
    background: #f8fbfd;
    color: #1A2B3C;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    outline: none;
    transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
    -webkit-appearance: none;
    box-sizing: border-box;
  }
  .emer-sample-modal__input::placeholder {
    color: #7f93a7;
    font-weight: 400;
  }
  .emer-sample-modal__textarea {
    width: 100%;
    max-width: 100%;
    min-height: 118px;
    padding: 13px 14px;
    border: 1px solid #c9d6e2;
    border-radius: 8px;
    background: #f8fbfd;
    color: #1A2B3C;
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.5;
    outline: none;
    resize: vertical;
    transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
    box-sizing: border-box;
  }
  .emer-sample-modal__textarea::placeholder {
    color: #7f93a7;
    font-weight: 400;
  }
  .emer-sample-modal__input:focus,
  .emer-sample-modal__select:focus,
  .emer-sample-modal__textarea:focus {
    border-color: #007A90;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(0, 122, 144, 0.14);
  }
  .emer-sample-modal__phone-row {
    display: flex;
    gap: 8px;
    align-items: stretch;
    width: 100%;
    min-width: 0;
  }
  .emer-sample-modal__phone-code {
    width: 170px;
    flex-shrink: 0;
    padding: 0 30px 0 13px;
    background-image: url(\"data:image/svg+xml,%3Csvg width='9' height='6' viewBox='0 0 9 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L4.5 5L8 1' stroke='%238BA5BA' stroke-width='1.3' stroke-linecap='round'/%3E%3C/svg%3E\");
    background-repeat: no-repeat;
    background-position: right 10px center;
    cursor: pointer;
  }
  .emer-sample-modal__submit {
    width: 100%;
    max-width: 100%;
    margin-top: 18px;
    padding: 14px 20px;
    border: 0;
    border-radius: 2px;
    background: #007A90;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.03em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: background .2s ease, transform .15s ease, box-shadow .2s ease;
    box-sizing: border-box;
  }
  .emer-sample-modal__submit::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
    transition: left .55s ease;
  }
  .emer-sample-modal__submit:hover::before {
    left: 140%;
  }
  .emer-sample-modal__submit:hover {
    background: #00B8D4;
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(0, 184, 212, 0.28);
  }
  .emer-sample-modal__submit svg {
    width: 15px;
    height: 15px;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__backdrop {
    background: rgba(0, 0, 0, 0.68);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
