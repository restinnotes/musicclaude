     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "原先较集中的感觉慢慢散开，我沉进一阵松散的安静里",
       "keys": [
        "松散的安静里"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像说完重要的话还陶醉在里头，有一点走神",
