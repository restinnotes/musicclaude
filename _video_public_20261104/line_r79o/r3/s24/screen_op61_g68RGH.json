     "emotion": "安心",
     "from": [
      "S12-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "熟悉的舞曲回来",
       "bead": "S12-B1",
       "bars": null
      },
      {
       "text": "雷鸣般铺满全场",
       "bead": "S12-B1",
       "bars": null
      },
      {
       "text": "沉重脚步落地",
       "bead": "S12-B1",
       "bars": null
      },
