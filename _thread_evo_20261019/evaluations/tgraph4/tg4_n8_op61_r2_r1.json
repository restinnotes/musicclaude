    }
   ]
  },
  {
   "bars": "206–213",
   "relation": "没在想",
   "items": [
    {
     "id": "I95",
     "text": "他又感到那份温柔短暂贴近了自己。",
     "key": "短暂贴近",
     "kind": ""
    },
    {
     "id": "I96",
     "text": "他明知自己不能一直停留。",
     "key": "不能一直停留",
     "kind": ""
    },
    {
     "id": "I97",
     "text": "他仍不忍立刻推开这份温柔。",
     "key": "不忍立刻推开",
     "kind": ""
    },
    {
     "id": "I98",
     "text": "他不愿每次想起它都急着审问自己。",
     "key": "急着审问",
     "kind": ""
    },
    {
     "id": "I99",
     "text": "他愿意再爱惜片刻。",
     "key": "再爱惜片刻",
     "kind": ""
    },
    {
     "id": "I100",
     "text": "他暂时不想那些尚无答案的事。",
     "key": "尚无答案",
     "kind": ""
    },
    {
     "id": "I101",
     "text": "他仍因这点安静而欢喜。",
     "key": "安静而欢喜",
     "kind": ""
    },
    {
     "id": "I102",
     "text": "他的欢喜里已有不舍。",
     "key": "欢喜里",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I81",
     "to": "I97",
     "rel": "仍在起作用"
    },
    {
     "from": "I94",
     "to": "I100",
     "rel": "限制"
    },
    {
     "from": "I78",
     "to": "I101",
     "rel": "仍在起作用"
