    function getleadOptions(){
        $.get( "/ajax/lead_config", function( data ) {
            $("#phoneSelector").val('+1');

            $("#phoneSelector-d1").val('+1');

            $("#phoneSelector-d2").val('+1');

            $("#phoneSelector-d3").val('+1');
        });
    }
