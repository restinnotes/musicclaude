 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他已经离开那段熟悉的生活，起初觉得总算不用再一回回委屈自己",
       "keys": [
        "不用再一回回委屈自己"
