   "measures": "mm.32–34",
   "dimensions": [
    "身体与动作",
    "时间与变化",
    "动因与心理"
   ],
   "what": "高处声线像想停住、把当下多留一刻，低处船歌摇荡却不肯停，推人沿时间往前走；上下声部的方向矛盾产生眷恋中的无可挽回感。",
   "validity": "solid",
   "sources": [
