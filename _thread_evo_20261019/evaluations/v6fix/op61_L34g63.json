    ]
   },
   {
    "sec": "S07",
    "bars": "181–205",
    "relation": "正在面对",
    "items": [
     {
      "id": "S07-1",
      "text": "原本安静的心忽然断了，他先感到一阵惊惧，意识还没跟上，身体已经重新绷紧。",
      "key": "原本安静的心忽然",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1"
      ]
     },
     {
      "id": "S07-2",
      "text": "紧张拖了好一会儿才稍稍退下去，心里仍反复翻涌，没能恢复原先那点安稳。",
      "key": "紧张拖了好一会儿",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1"
      ]
     },
     {
      "id": "S07-3",
      "text": "熟悉的日常感又闪了一下，亲切感随即带出失落；他认得这是那份反复出现的想念，也没有因此撤回原来的选择。",
      "key": "熟悉的日常感又闪",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-1",
       "S03-1",
       "S06-1"
      ]
     }
    ],
    "because": [
