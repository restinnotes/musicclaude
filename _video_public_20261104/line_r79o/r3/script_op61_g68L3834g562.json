       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "早知道这样，自己还会走吗？",
       "keys": [
        "自己还会走吗"
       ],
       "from": []
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想找回从前那份亲近，又不甘心回去再受那些气，可连当初走时那股决心也找不着了",
       "keys": [
        "那股决心也找不着了"
       ],
       "from": []
      }
     ],
     "beads": [
      {
       "text": "刚才的思绪一下被打断，换了副热闹步子心里却安定不下来",
