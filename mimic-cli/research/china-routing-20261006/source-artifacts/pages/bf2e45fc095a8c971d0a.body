<style>
:root {
    --gh-fixed-header-height: 80px;
    --gh-fixed-header-gap: 16px;
    --gh-content-width: 840px;
    --gh-toc-width: 360px;
    --gh-toc-mobile-placeholder: 52px;
}

/* 只在 post 页面启用平滑滚动（通过 body 类判断） */
html:has(body.post-template) {
    scroll-behavior: smooth;
}

.post-template .gh-content {
    position: relative;
    a:not(.kg-btn) {
        color: inherit;
        text-decoration: underline;
    }
}

.gh-toc > .toc-list {
    position: relative;
}

.toc-list {
    overflow: hidden;
    list-style: none;
    padding-right: 6rem;
    .toc-list-item {
        &:hover, &.is-active-link {
            font-weight: 700;
        }
    }
    .toc-list-item + .toc-list-item {
        margin-top: 0rem;
    }
}

.gh-toc .toc-list-item > .toc-link {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 0.5em 0;
    color: inherit;
}

.gh-sidebar-title--desktop {
    display: none;
    margin: 0 0 1.6rem;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.02em;
}

.gh-toc-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin: 0;
    padding: 1.4rem 1.6rem;
    font: inherit;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-darker-gray);
    cursor: pointer;
    background: var(--color-white);
    border: 0;
    border-bottom: 1px solid var(--color-light-gray);
}

.gh-toc-toggle__icon {
    display: flex;
    flex-shrink: 0;
    margin-left: 1.2rem;
    transition: transform 0.2s ease;
}

.gh-sidebar-sticky.is-toc-collapsed .gh-toc-toggle__icon {
    transform: rotate(180deg);
}

/* 移动端样式 */
@media (max-width: 1299px) {
    .post-template .gh-main {
        overflow: visible;
    }

    .post-template .gh-article {
        overflow: visible;
    }

    .post-template .gh-content.gh-canvas {
        overflow: visible;
        padding-top: var(--gh-toc-mobile-placeholder);
    }

    /* 移动端：gh-sidebar fixed 定位 */
    .post-template .gh-sidebar {
        position: static;
        z-index: 95;
        margin: 0;
        min-height: 0;
    }

    .post-template .gh-sidebar-sticky {
        position: fixed;
        top: calc(var(--gh-fixed-header-height));
        left: 0;
        right: 0;
        width: 100%;
        max-width: 100%;
        margin: 0;
        background: var(--color-white);
        box-shadow: 0 1px 0 var(--color-light-gray);
        overflow: visible;
        z-index: 95;
    }

    .gh-toc-backdrop {
        position: fixed;
        inset: 0;
        z-index: 94;
        background: transparent;
    }

    .gh-toc,
    .gh-toc .toc-list {
        padding: 0;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }

    .gh-toc .toc-list-item {
        padding: 0;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        border-bottom: 1px solid var(--color-light-gray);
        .toc-link {
            padding: 0.8em 1em;
        }
    }

    .gh-toc .toc-list-item:last-child {
        border-bottom: 0;
    }

    .gh-toc .toc-link::before,
    .gh-toc .is-active-link::before {
        display: none !important;
        content: none !important;
    }

    .toc-list {
        padding-right: 1.6rem;
        padding-left: 0.4rem;
    }

    .gh-toc-panel {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1;
        background: var(--color-white);
        border-bottom: 1px solid var(--color-light-gray);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        max-height: calc(100vh - (var(--gh-fixed-header-height) + var(--gh-fixed-header-gap) + var(--gh-toc-mobile-placeholder)));
        transition: max-height 0.28s ease;
        will-change: max-height;
    }

    .gh-sidebar-sticky.is-toc-collapsed .gh-toc-panel {
        max-height: 0;
        border-bottom-width: 0;
        box-shadow: none;
    }

    .gh-toc-panel > .gh-toc {
        max-height: inherit;
        overflow: auto;
        -webkit-overflow-scrolling: touch;
        min-height: 0;
        padding-bottom: 0.4rem;
    }
}

/* PC 端样式 */
@media (min-width: 1300px) {
    /* 文章容器使用 flex 布局：sidebar + main 并排 */
    .post-template .gh-article {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 0;
        position: relative;
    }

    /* sidebar 固定宽度，跟随整篇文章高度 */
    .post-template .gh-article > .gh-sidebar {
        flex: 0 0 var(--gh-toc-width);
        width: var(--gh-toc-width);
        padding-right: 32px;
        box-sizing: border-box;
        align-self: stretch;
    }

    /* 主内容区域 */
    .post-template .gh-article > .gh-article-main {
        flex: 0 0 var(--gh-content-width);
        width: var(--gh-content-width);
        max-width: var(--gh-content-width);
    }

    /* header 和 content 不再需要复杂的 grid */
    .post-template .gh-article-header.gh-canvas,
    .post-template .gh-content.gh-canvas {
        display: block;
        max-width: 100%;
    }

    /* sticky 容器：跟随整篇文章滚动 */
    .post-template .gh-sidebar-sticky {
        position: sticky;
        top: calc(var(--gh-fixed-header-height) + var(--gh-fixed-header-gap));
    }

    .gh-toc-toggle {
        display: none;
    }

    .gh-sidebar-title--desktop {
        display: block;
    }

    .gh-toc-panel {
        display: block;
    }

    .gh-toc-panel > .gh-toc {
        overflow: visible;
    }

    .gh-toc .is-active-link::before {
        background-color: var(--ghost-accent-color);
    }

    .post-template .gh-content-body {
        margin-top: 0;
    }
}

.post-template .gh-content.gh-canvas {
    --content-width: var(--gh-content-width);
    --container-width: calc(var(--gh-content-width) + (var(--gh-toc-width) * 2));
}

.post-template .gh-content-body :is(h1, h2, h3, h4, h5, h6)[id] {
    scroll-margin-top: calc(var(--gh-fixed-header-height) + var(--gh-fixed-header-gap));
}

@media (max-width: 1299px) {
    .post-template .gh-content-body :is(h1, h2, h3, h4, h5, h6)[id] {
        scroll-margin-top: calc(
            var(--gh-fixed-header-height) + var(--gh-fixed-header-gap) + var(--gh-toc-mobile-placeholder)
        );
    }
}
</style>
