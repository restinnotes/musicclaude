   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "明知回去未必找得回那份亲近，他仍忍不住想：万一能呢？",
       "keys": [
        "回去未必找得回那份亲近",
        "万一能呢"
