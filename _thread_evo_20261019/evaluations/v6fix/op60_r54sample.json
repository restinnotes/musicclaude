      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S03",
    "bars": "17–23",
    "relation": "还说不清",
    "items": [
     {
      "id": "S03-1",
      "text": "他在这份被接纳的轻松里待得有些出神，原先紧绷的遮掩慢慢松了。",
      "key": "他在这份被接纳的",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-1"
      ]
     },
     {
      "id": "S03-2",
      "text": "偶尔又涌起想把更多依恋交出去的急切，可那股劲很快退了，剩下一点说不清的顾虑，和舒服的感觉搅在一起。",
      "key": "偶尔又涌起想把更",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2",
       "S02-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S02-1",
      "to": "S03-1",
