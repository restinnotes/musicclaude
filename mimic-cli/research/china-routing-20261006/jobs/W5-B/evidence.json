  "claims": [
    {
      "claim_id": "C01",
      "claim": "Superbuy标准平台代购公开采购服务费为0；国际运费仍受线路、实重/体积重、目的地和货物类型影响，最终账单会结算差额。",
      "classification": "FACT",
      "source_ids": [
        "S01",
        "S02"
      ],
      "confidence": "high",
      "counterevidence": "线路规则不同，不能把/6000或任何一条线路费率推广到全部线路。"
    },
    {
      "claim_id": "C02",
      "claim": "成熟代理基础设施能够支持逐单直寄消费者而非必须由研究方先物理聚合：BuckyDrop有自动履约/API；Superbuy商务页搜索提取显示可拆单寄不同用户。",
      "classification": "FACT",
      "source_ids": [
        "S03",
        "S05",
        "S06"
      ],
      "confidence": "medium",
      "counterevidence": "Superbuy商务页正文在本会话未完整渲染；能力存在不等于单位成本最优。"
    },
    {
      "claim_id": "C03",
      "claim": "BuckyDrop公开标准价包括Pro CNY199/月/店和CNY9.90/包裹履约费；公开页面同时称运费按承运商最终重量/体积结算并加固定CNY9.9服务费，二者是否同一费用需避免双计。",
      "classification": "FACT",
      "source_ids": [
        "S04"
      ],
      "confidence": "high",
      "counterevidence": "私有商务合同可能不同，页面两处9.9的关系需要书面澄清。"
    },
    {
      "claim_id": "C04",
      "claim": "Sugargoo公开搜索可发现计算器和企业服务，但本会话直接打开相关页面返回403，故具体费率/API/商务折扣均为UNVERIFIED。",
      "classification": "FACT",
      "source_ids": [
        "S07",
        "S08"
      ],
      "confidence": "high",
      "counterevidence": "登录态或不同网络环境可能可访问完整页面。"
    },
    {
      "claim_id": "C05",
      "claim": "截至2026-10-06，美国≤800美元de minimis行政豁免对非邮政与邮政均已暂停；旧的<$800自动免税假设不能用于当前landed cost。",
      "classification": "FACT",
      "source_ids": [
        "S09",
        "S10"
      ],
      "confidence": "high",
      "counterevidence": "具体SKU税率仍由HTSUS及适用贸易措施决定，暂停不等于统一税率。"
    },
    {
      "claim_id": "C06",
      "claim": "FY2027自2026-10-01起的CBP费率包括正式MPF 0.3464%（$34.58–$670.86）、非正式自动$2.77、非正式手工$8.30/$12.45、快件中心每运单$1.38；并非每票全部叠加。",
      "classification": "FACT",
      "source_ids": [
        "S10",
        "S11"
      ],
      "confidence": "high",
      "counterevidence": "邮政、快件、空运、海运和特定豁免对应不同费用组合。"
    },
    {
      "claim_id": "C07",
      "claim": "54个冻结SKU中实际ZIP10001 quote-grade国际运费=0个；冻结数据缺代理重打包后的精确重量/尺寸，且未获得当前线路的全部必收费项。",
      "classification": "FACT",
      "source_ids": [
        "S02",
        "S07",
        "S15"
      ],
      "confidence": "high",
      "counterevidence": "可另行人工补采包装数据和登录态报价，但本次没有。"
    },
    {
      "claim_id": "C08",
      "claim": "社区案例证明体积重惊喜和海关延迟/检查是现实风险，但不能估计总体发生率。",
      "classification": "FACT",
      "source_ids": [
        "S13",
        "S14"
      ],
      "confidence": "medium",
      "counterevidence": "社区存在严重选择偏差，线路和申报条件也不同。"
    },
    {
      "claim_id": "C09",
      "claim": "比较终点采用送达ZIP10001、美国州/地方sales/use tax之前；州税单列且不假定为0。",
      "classification": "FACT",
      "source_ids": [
        "S12"
      ],
      "confidence": "high",
      "counterevidence": "最终消费者仍可能有纽约州/地方税义务。"
    },
    {
      "claim_id": "C10",
      "claim": "公开资料没有给出1000个独立订单触发的物流阶梯折扣；Superbuy的≥30kg是单票/批货定制入口，BuckyDrop Pro的unlimited fulfillment也不是运价折扣。",
      "classification": "INFERENCE",
      "source_ids": [
        "S02",
        "S03",
        "S04",
        "S08"
      ],
      "confidence": "medium",
      "counterevidence": "未公开的商务合同可能存在按月票量/重量阶梯价。"
    },
    {
      "claim_id": "C11",
      "claim": "Superbuy公开可见的收费/收入杠杆包括非标准代购费、增值服务和国际运输中的操作费；其承运商采购价差或收入占比没有公开审计数据。",
      "classification": "FACT",
      "source_ids": [
        "S01"
      ],
      "confidence": "medium",
      "counterevidence": "公开费率结构不能证明公司实际利润构成。"
    }
  ],
