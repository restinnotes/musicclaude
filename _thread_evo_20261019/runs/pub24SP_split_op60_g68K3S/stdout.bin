{"completed": true, "response": "<escape>{\n  \"blocks\": [\n    {\n      \"id\": \"S01-r2-i1\",\n      \"items\": [\n        {\"text\":\"开头两下响亮的和弦\",\"pt\":\"S01-B1-p1\"},\n        {\"text\":\"有一点突然\",\"pt\":\"S01-B1-p1\"},\n        {\"text\":\"像夏夜威尼斯上空升起的烟花\",\"pt\":\"S01-B1-p2\"},\n        {\"text\":\"先向高处迸发\",\"pt\":\"S01-B1-p2\"},\n        {\"text\":\"细碎的光点缓缓飘落\",\"pt\":\"S01-B1-p2\"},\n        {\"text\":\"落下来以后还没有真正落稳\",\"pt\":\"S01-B1-p3\"},\n        {\"text\":\"仍悬在水面上方\",\"pt\":\"S01-B1-p3\"},\n        {\"text\":\"船歌那种稳定的摇荡感还没有真正成形\",\"pt\":\"S01-B1-p4\"}\n      ]\n    },\n    {\n      \"id\": \"S01-r2-i2\",\n      \"items\": [\n        {\"text\":\"像刚踏上小船\",\"pt\":\"S01-B3-p1\"},\n        {\"text\":\"木板微晃\",\"pt\":\"S01-B3-p1\"},\n        {\"text\":\"水波在脚下荡开\",\"pt\":\"S01-B3-p1\"},\n        {\"text\":\"身体一瞬失重\",\"pt\":\"S01-B3-p1\"}\n      ]\n    },\n    {\n      \"id\": \"S02-r2-i1\",\n      \"items\": [\n        {\"text\":\"左手像心跳\",\"pt\":\"S02-B2-p1\"},\n        {\"text\":\"也像无止境的水浪\",\"pt\":\"S02-B2-p1\"},\n        {\"text\":\"一下一下摇着\",\"pt\":\"S02-B2-p1\"},\n        {\"text\":\"身体仿佛可以交给船底托举\",\"pt\":\"S02-B2-p2\"},\n        {\"text\":\"水却一直在流\",\"pt\":\"S02-B2-p3\"}\n      ]\n    },\n    {\n      \"id\": \"S02-r2-i2\",\n      \"items\": [\n        {\"text\":\"右手两条旋律线贴得很近\",\"pt\":\"S02-B1-p1\"},\n        {\"text\":\"像肩膀挨着肩膀\",\"pt\":\"S02-B1-p1\"},\n        {\"text\":\"连呼吸都贴在一起\",\"pt\":\"S02-B1-p1\"},\n        {\"text\":\"体温也仿佛融在一处\",\"pt\":\"S02-B1-p1\"},\n        {\"text\":\"像夏末潮湿温热的风\",\"pt\":\"S02-B1-p4\"},\n        {\"text\":\"裹在皮肤上\",\"pt\":\"S02-B1-p4\"}\n      ]\n    },\n    {\n      \"id\": \"S02-r2-i3\",\n      \"items\": [\n        {\"text\":\"像熟人安静坐着\",\"pt\":\"S02-B1-p2\"},\n        {\"text\":\"偶尔对视也不尴尬\",\"pt\":\"S02-B1-p3\"}\n      ]\n    },\n    {\n      \"id\": \"S02-r2-i4\",\n      \"items\": [\n        {\"text\":\"几次柔软的落音\",\"pt\":\"S02-B4-p1\"},\n        {\"text\":\"像一根温柔的刺\",\"pt\":\"S02-B4-p1\"},\n        {\"text\":\"眼前的好还在\",\"pt\":\"S02-B4-p2\"},\n        {\"text\":\"心里却先有一点鼻酸\",\"pt\":\"S02-B4-p2\"}\n      ]\n    },\n    {\n      \"id\": \"S02-r4-i1\",\n      \"items\": [\n        {\"text\":\"歌声忽然往上涌了一次\",\"pt\":\"S02-B3-p1\"},\n        {\"text\":\"像感情终于忍不住说得热切了一些\",\"pt\":\"S02-B3-p1\"},\n        {\"text\":\"连呼吸都跟着改变\",\"pt\":\"S02-B3-p1\"},\n        {\"text\":\"又轻轻呼出一口气\",\"pt\":\"S02-B3-p2\"},\n        {\"text\":\"重新回到柔和\",\"pt\":\"S02-B3-p2\"},\n        {\"text\":\"没有把心事彻底说死\",\"pt\":\"S02-B3-p3\"}\n      ]\n    },\n    {\n      \"id\": \"S03-r2-i1\",\n      \"items\": [\n        {\"text\":\"持续摇曳中\",\"pt\":\"S03-B2-p1\"},\n        {\"text\":\"忽然冒出几句短促、急切的声音\",\"pt\":\"S03-B2-p1\"},\n        {\"text\":\"很快又沉了回去\",\"pt\":\"S03-B2-p2\"}\n      ]\n    },\n    {\n      \"id\": \"S03-r2-i2\",\n      \"items\": [\n        {\"text\":\"水波还在晃\",\"pt\":\"S03-B3-p1\"},\n        {\"text\":\"流动却像被水下暗流拖住\",\"pt\":\"S03-B3-p2\"},\n        {\"text\":\"声音绕远\",\"pt\":\"S03-B3-p2\"},\n        {\"text\":\"滞留在半途\",\"pt\":\"S03-B3-p2\"},\n        {\"text\":\"思绪像被风吹碎的倒影\",\"pt\":\"S03-B3-p3\"},\n        {\"text\":\"闪烁却难拼完整\",\"pt\":\"S03-B3-p3\"}\n      ]\n    },\n    {\n      \"id\": \"S03-r2-i3\",\n      \"items\": [\n        {\"text\":\"像一句重要的话说完了\",\"pt\":\"S03-B1-p2\"},\n        {\"text\":\"人还在余味里发愣\",\"pt\":\"S03-B1-p2\"}\n      ]\n    },\n    {\n      \"id\": \"S04-r2-i1\",\n      \"items\": [\n        {\"text\":\"熟悉的歌声又回来\",\"pt\":\"S04-B1-p1\"},\n        {\"text\":\"两道声线仍贴耳低语\",\"pt\":\"S04-B1-p2\"},\n        {\"text\":\"呼吸挨得很近\",\"pt\":\"S04-B1-p2\"},\n        {\"text\":\"这一遍更华丽\",\"pt\":\"S04-B1-p3\"},\n        {\"text\":\"更迫切\",\"pt\":\"S04-B1-p3\"},\n        {\"text\":\"花腔像水面晃眼的光斑\",\"pt\":\"S04-B1-p4\"}\n      ]\n    },\n    {\n      \"id\": \"S04-r2-i2\",\n      \"items\": [\n        {\"text\":\"一句话说完\",\"pt\":\"S04-B1-p6\"},\n        {\"text\":\"还忍不住折回来补细节\",\"pt\":\"S04-B1-p6\"}\n      ]\n    },\n    {\n      \"id\": \"S04-r4-i1\",\n      \"items\": [\n        {\"text\":\"高处的长颤音\",\"pt\":\"S04-B2-p1\"},\n        {\"text\":\"像夕阳切出的最后一道金光\",\"pt\":\"S04-B2-p1\"},\n        {\"text\":\"亮得几乎刺眼\",\"pt\":\"S04-B2-p1\"},\n        {\"text\":\"音乐一边奋力向高处攀升\",\"pt\":\"S04-B2-p3\"},\n        {\"text\":\"一边又渐渐收弱\",\"pt\":\"S04-B2-p3\"},\n        {\"text\":\"直到后来才慢下来\",\"pt\":\"S04-B2-p4\"}\n      ]\n    },\n    {\n      \"id\": \"S04-r4-i2\",\n      \"items\": [\n        {\"text\":\"话到喉咙口忽然发紧\",\"pt\":\"S04-B2-p2\"}\n      ]\n    },\n    {\n      \"id\": \"S04-r4-i3\",\n      \"items\": [\n        {\"text\":\"两道声线仍贴得那么近\",\"pt\":\"S04-B4-p2\"},\n        {\"text\":\"左手水波却一直向前\",\"pt\":\"S04-B4-p2\"},\n        {\"text\":\"仿佛每一秒都在倒数\",\"pt\":\"S04-B4-p2\"},\n        {\"text\":\"还没有失去什么\",\"pt\":\"S04-B4-p3\"},\n        {\"text\":\"就已经舍不得\",\"pt\":\"S04-B4-p3\"}\n      ]\n    },\n    {\n      \"id\": \"S05-r2-i1\",\n      \"items\": [\n        {\"text\":\"原来一直托着人的水波和摇晃\",\"pt\":\"S05-B1-p1\"},\n        {\"text\":\"忽然像被抽掉\",\"pt\":\"S05-B1-p1\"},\n        {\"text\":\"只剩一条单薄旋律\",\"pt\":\"S05-B1-p2\"},\n        {\"text\":\"在雾里的水域\",\"pt\":\"S05-B1-p4\"},\n        {\"text\":\"漫无目的地游走\",\"pt\":\"S05-B1-p2\"}\n      ]\n    },\n    {\n      \"id\": \"S05-r2-i2\",\n      \"items\": [\n        {\"text\":\"刚才还像两个人贴近耳语\",\"pt\":\"S05-B2-p1\"},\n        {\"text\":\"交谈却戛然而止\",\"pt\":\"S05-B2-p1\"},\n        {\"text\":\"心里闪过一句\",\"pt\":\"S05-B2-p3\"},\n        {\"text\":\"这份幸福真实吗？\",\"pt\":\"S05-B2-p3\"},\n        {\"text\":\"能维持多久？\",\"pt\":\"S05-B2-p4\"}\n      ]\n    },\n    {\n      \"id\": \"S05-r4-i1\",\n      \"items\": [\n        {\"text\":\"此前那阵想攥紧不放的冲动\",\"pt\":\"S05-B3-p1\"},\n        {\"text\":\"到了这里音乐自己松开了手\",\"pt\":\"S05-B3-p2\"},\n        {\"text\":\"轻轻退下去\",\"pt\":\"S05-B3-p3\"}\n      ]\n    },\n    {\n      \"id\": \"S05-r4-i2\",\n      \"items\": [\n        {\"text\":\"像终于能深吸一口气\",\"pt\":\"S05-B3-p2\"}\n      ]\n    },\n    {\n      \"id\": \"S06-r2-i1\",\n      \"items\": [\n        {\"text\":\"熟悉的摇摆回来了\",\"pt\":\"S06-B1-p2\"},\n        {\"text\":\"却不再沉甸甸\",\"pt\":\"S06-B1-p2\"},\n        {\"text\":\"左手的波浪变薄\",\"pt\":\"S06-B1-p2\"},\n        {\"text\":\"碎成细密的小纹\",\"pt\":\"S06-B1-p2\"},\n        {\"text\":\"光线从暖金色的水面滑入古桥阴影\",\"pt\":\"S06-B1-p3\"},\n        {\"text\":\"空气一下凉了\",\"pt\":\"S06-B1-p3\"},\n        {\"text\":\"新旋律清澈得像月光\",\"pt\":\"S06-B1-p5\"}\n      ]\n    },\n    {\n      \"id\": \"S06-r2-i2\",\n      \"items\": [\n        {\"text\":\"忽然想起年少时第一次心动的下午\",\"pt\":\"S06-B1-p5\"}\n      ]\n    },\n    {\n      \"id\": \"S06-r4-i1\",\n      \"items\": [\n        {\"text\":\"旋律压低声音\",\"pt\":\"S06-B2-p2\"},\n        {\"text\":\"另一条声线不时回应\",\"pt\":\"S06-B2-p2\"},\n        {\"text\":\"不时插话\",\"pt\":\"S06-B2-p2\"},\n        {\"text\":\"又纠缠回来\",\"pt\":\"S06-B2-p2\"},\n        {\"text\":\"像一个念头刚安静下去\",\"pt\":\"S06-B2-p3\"},\n        {\"text\":\"又浮上来\",\"pt\":\"S06-B2-p3\"}\n      ]\n    },\n    {\n      \"id\": \"S06-r4-i2\",\n      \"items\": [\n        {\"text\":\"心里刚说算了\",\"pt\":\"S06-B2-p3\"},\n        {\"text\":\"又忍不住放不下\",\"pt\":\"S06-B2-p3\"}\n      ]\n    },\n    {\n      \"id\": \"S06-r4-i3\",\n      \"items\": [\n        {\"text\":\"白天和某个人相处得很好\",\"pt\":\"S06-B3-p2\"},\n        {\"text\":\"独处时心头泛酸\",\"pt\":\"S06-B3-p2\"},\n        {\"text\":\"美好时光恍惚间像已经成了回忆\",\"pt\":\"S06-B3-p4\"}\n      ]\n    },\n    {\n      \"id\": \"S06-r4-i4\",\n      \"items\": [\n        {\"text\":\"更贴身的沉醉\",\"pt\":\"S06-B4-p1\"},\n        {\"text\":\"气味一层层荡开\",\"pt\":\"S06-B4-p2\"},\n        {\"text\":\"身体感觉一层层荡开\",\"pt\":\"S06-B4-p2\"},\n        {\"text\":\"幻想一层层荡开\",\"pt\":\"S06-B4-p2\"},\n        {\"text\":\"遗憾一层层荡开\",\"pt\":\"S06-B4-p2\"},\n        {\"text\":\"快感一层层荡开\",\"pt\":\"S06-B4-p2\"},\n        {\"text\":\"越舒服越失去方向\",\"pt\":\"S06-B4-p3\"}\n      ]\n    },\n    {\n      \"id\": \"S07-r2-i1\",\n      \"items\": [\n        {\"text\":\"歌声再回来\",\"pt\":\"S07-B1-p1\"},\n        {\"text\":\"清澈底下却越来越不安分\",\"pt\":\"S07-B1-p1\"},\n        {\"text\":\"伴奏音符变密\",\"pt\":\"S07-B1-p1\"},\n        {\"text\":\"低音像沉重的脉搏在催促\",\"pt\":\"S07-B1-p1\"},\n 