{
 "graph": {
  "center": "亲密的幸福与留不住它的痛楚难以分开",
  "segments": [
   {
    "sec": "S01",
    "bars": "1–3",
    "relation": "没在想",
    "items": [
     {
      "id": "I1",
      "text": "起初他没觉得这有什么了不得",
      "key": "没觉得",
      "follows": null
     },
     {
      "id": "I2",
      "text": "想到那个人，他惯常的紧绷松了一点",
      "key": "紧绷松了",
      "follows": null
     },
     {
      "id": "I3",
      "text": "这点松动还不足以让他相信什么",
      "key": "相信什么",
      "follows": null
     },
     {
      "id": "I4",
      "text": "他已经舍不得离开这种感觉",
      "key": "舍不得离开",
      "follows": null
     },
     {
      "id": "I5",
      "text": "他暂时不急着表现得更好",
      "key": "表现得更好",
      "follows": null
     },
     {
      "id": "I6",
      "text": "他暂时不急着藏起自己的需要",
      "key": "藏起自己的需要",
      "follows": null
     }
    ],
    "because": []
   },
   {
    "sec": "S02",
    "bars": "4–16",
    "relation": "没在想",
    "items": [
     {
      "id": "I7",
      "text": "这份轻松渐渐让他觉得可以依靠",
      "key": "可以依靠",
      "follows": null
     },
     {
      "id": "I8",
      "text": "起初他仍不敢显露太多欢喜",
      "key": "不敢显露",
      "follows": null
     },
     {
      "id": "I9",
      "text": "他仍为依恋留几分余地",
      "key": "留几分余地",
      "follows": null
     },
     {
      "id": "I10",
      "text": "他怕显露需要会成为别人的负担",
      "key": "别人的负担",
      "follows": null
     },
     {
      "id": "I11",
      "text": "他渐渐更愿向那个人敞开",
      "key": "更愿向那个人敞开",
      "follows": null
     },
     {
      "id": "I12",
      "text": "他喜欢自己的欢喜有了去处",
      "key": "欢喜有了去处",
      "follows": null
     },
     {
      "id": "I13",
      "text": "他脆弱时不必马上变回独自承受的人",
      "key": "独自承受",
      "follows": null
     },
     {
      "id": "I14",
      "text": "亲近没有让他觉得欠下什么",
      "key": "欠下什么",
      "follows": null
     },
     {
      "id": "I15",
      "text": "他能自然地喜欢、需要和给予",
      "key": "自然地喜欢",
      "follows": null
     },
     {
      "id": "I16",
      "text": "他曾羞于承认的依恋也变得可爱",
      "key": "依恋也变得可爱",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I2",
      "to": "I7",
      "rel": "提供理由",
      "how": ""
     },
     {
      "from": "I3",
      "to": "I8",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I6",
      "to": "I11",
      "rel": "提供理由",
      "how": ""
     }
    ]
   },
   {
    "sec": "S03",
    "bars": "17–23",
    "relation": "没在想",
    "items": [
     {
      "id": "I17",
      "text": "他开始盼望更多亲近",
      "key": "盼望更多亲近",
      "follows": null
     },
     {
      "id": "I18",
      "text": "他想把还没说清的感受交给对方",
      "key": "还没说清",
      "follows": null
     },
     {
      "id": "I19",
      "text": "他想让彼此尚未触及的部分渐渐熟悉",
      "key": "尚未触及",
      "follows": null
     },
     {
      "id": "I20",
      "text": "他仿佛觉得眼下很好，往后还能更好",
      "key": "往后还能更好",
      "follows": null
     },
     {
      "id": "I21",
      "text": "他如今为心里有这么多爱意而高兴",
      "key": "这么多爱意",
      "follows": null
     },
     {
      "id": "I22",
      "text": "每多一分亲近，他就多一分愿意",
      "key": "多一分愿意",
      "follows": null
     },
     {
      "id": "I23",
      "text": "对未来的期待让眼前幸福更加鲜亮",
      "key": "未来的期待",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I12",
      "to": "I17",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I11",
      "to": "I18",
      "rel": "唤起",
      "how": ""
     },
     {
      "from": "I10",
      "to": "I21",
      "rel": "改写",
      "how": "他开始喜欢自己有这么多需要和爱意"
     },
     {
      "from": "I15",
      "to": "I22",
      "rel": "仍在起作用",
      "how": ""
     }
    ]
   },
   {
    "sec": "S04",
    "bars": "24–34",
    "relation": "还说不清",
    "items": [
     {
      "id": "I24",
      "text": "他开始毫无保留地享受亲近",
      "key": "毫无保留",
      "follows": null
     },
     {
      "id": "I25",
      "text": "他喜欢上亲近时敞开的自己",
      "key": "敞开的自己",
      "follows": null
     },
     {
      "id": "I26",
      "text": "他不用时时猜自己是否值得被爱",
      "key": "值得被爱",
      "follows": null
     },
     {
      "id": "I27",
      "text": "他不再刚一欢喜就顾虑重重",
      "key": "顾虑重重",
      "follows": null
     },
     {
      "id": "I28",
      "text": "他仿佛还有无数温柔可以给予",
      "key": "无数温柔",
      "follows": null
     },
     {
      "id": "I29",
      "text": "他每次给予都感到幸福更丰盛",
      "key": "幸福更丰盛",
      "follows": null
     },
     {
      "id": "I30",
      "text": "快乐太满的一瞬，他忽然舍不得",
      "key": "忽然舍不得",
      "follows": null
     },
     {
      "id": "I31",
      "text": "那一刻他明明什么也不缺，心口却收紧",
      "key": "心口却收紧",
      "follows": null
     },
     {
      "id": "I32",
      "text": "他担心这样的亲近往后能否一直如此",
      "key": "往后能否一直如此",
      "follows": null
     },
     {
      "id": "I33",
      "text": "那个念头没停留多久",
      "key": "没停留多久",
      "follows": null
     },
     {
      "id": "I34",
      "text": "他隐约感觉自己比想象中更在乎这份亲密",
      "key": "更在乎这份亲密",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I11",
      "to": "I24",
      "rel": "仍在起作用",
      "how": ""
     },
     {
      "from": "I13",
