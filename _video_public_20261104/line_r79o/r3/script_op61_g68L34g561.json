       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "压着的委屈、愿望和对旧日归属的思念慢慢浮上来，他心里仍留着一点遥远的盼望",
       "keys": [
        "留着一点遥远的盼望"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像对着远方真切地祈求，却不知道会不会有回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "情绪越来越充实，也越来越迫切，却仍然没有完全落定",
