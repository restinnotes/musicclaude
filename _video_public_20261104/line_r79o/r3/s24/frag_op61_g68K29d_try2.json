     "from": [
      "S10-1"
     ],
     "at": 0
    },
    {
     "text": "可就算回去，还能像从前那样吗？",
     "accent": "还能像从前那样吗？",
     "emotion": "悬着",
     "from": [
      "S10-1"
     ],
     "at": 4
    },
