      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "还说不清",
    "items": [
     {
      "id": "S08-1",
      "text": "慌乱稍退，他想起从前那些亲近的日子，有那么一会儿只顾着回味那些好。",
      "key": "慌乱稍退，他想起",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2",
       "S07-2"
      ]
     },
     {
      "id": "S08-2",
      "text": "可那点暖和没留多久就淡了，他心里酸楚，还是舍不得。",
      "key": "可那点暖和没留多",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1"
      ]
     }
    ],
    "because": [
