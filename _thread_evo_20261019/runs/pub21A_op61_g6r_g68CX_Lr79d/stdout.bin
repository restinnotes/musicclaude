: \"后\",\n          \"waste\": \"\",\n          \"keep\": \"真盼着\"\n        },\n        {\n          \"text\": \"那些委屈让他拿不准\",\n          \"point\": \"拿不准离开对不对\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"也想不出当初没走会怎样\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像脚下原有的地板忽然不见了，只剩一个声音自己说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍不服气\",\n          \"point\": \"受的那些气不该忍\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"仍不服气\"\n        },\n        {\n          \"text\": \"他不想忘掉开心的过去\",\n          \"point\": \"离开了他们，心里还难受\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"不想忘掉开心的过去\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"连呼吸都不愿惊动它。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那些压住的愿望、委屈和思念，终于有机会浮现。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开后难事只能自己