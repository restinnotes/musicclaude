{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他忽然很想靠近",
     "accent": "很想",
     "emotion": "炽热",
     "from": [
      "S01-1"
     ],
     "at": 0
    },
    {
     "text": "心里一下热起来",
     "accent": "热起来",
     "emotion": "欢喜",
     "from": [
      "S01-1"
     ],
     "at": 2
    },
    {
     "text": "可他怕显得太需要",
     "accent": "太需要",
     "emotion": "不安",
     "from": [
      "S01-2"
     ],
     "at": 5
    },
    {
     "text": "只敢露出一点喜欢",
     "accent": "一点喜欢",
     "emotion": "悬着",
     "from": [
      "S01-2"
     ],
     "at": 8
    },
    {
     "text": "这点亲近已经很甜",
     "accent": "很甜",
     "emotion": "欢喜",
     "from": [
      "S01-3"
     ],
     "at": 11
    }
   ],
   "small": [
    {
     "text": "有句话想了很久，出口会改变关系",
     "after": 2,
     "from": [
      "S01-B2"
     ],
     "bars": "1–3",
     "at": 6
    },
    {
     "text": "像刚踏上微晃的船板",
     "after": 0,
     "from": [
      "S01-B3"
     ],
     "bars": "1–3",
     "at": 0
    },
    {
     "text": "身体一瞬间失了重",
     "after": 0,
     "from": [
      "S01-B3"
     ],
     "bars": "1–3",
     "at": 0
    },
    {
     "text": "这里还没稳稳摇起来",
     "after": 0,
     "from": [
      "S01-B3"
     ],
     "bars": "1–3",
     "at": 0
    },
    {
     "text": "有的演奏开头已经轻摇",
     "after": 0,
     "from": [
      "S01-B3"
     ],
     "bars": "1–3",
     "at": 2
    },
    {
     "text": "他还拿不准下次能否更坦白",
     "after": 4,
     "from": [
      "S01-3"
     ],
     "bars": "",
     "at": 14
    }
   ],
   "notes": [
    {
     "text": "两下响亮和弦像烟花迸起，碎光落下仍悬着",
     "from": [
      "S01-B1"
     ],
     "bars": "1–3"
    },
    {
     "text": "水波刚荡开，摇摆还没有稳定下来",
     "from": [
      "S01-B3"
     ],
     "bars": "1–3"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "对方没退开，他才放松",
     "accent": "没退开",
     "emotion": "安心",
     "from": [
      "S02-1"
     ],
     "at": 0
    },
    {
     "text": "他喜欢得几乎藏不住",
     "accent": "藏不住",
     "emotion": "炽热",
     "from": [
      "S02-2"
     ],
     "at": 6
    },
    {
     "text": "却怕太急弄坏眼下自在",
     "accent": "太急",
     "emotion": "不安",
     "from": [
      "S02-2"
     ],
     "at": 13
    },
    {
     "text": "这么好的时刻总会过去",
     "accent": "总会过去",
     "emotion": "悬着",
     "from": [
      "S02-3"
     ],
     "at": 21
    },
    {
     "text": "还没分开他就有点舍不得",
     "accent": "舍不得",
     "emotion": "孤单",
     "from": [
      "S02-3"
     ],
     "at": 28
    }
   ],
   "small": [
    {
     "text": "像肩挨肩耳语，呼吸和体温都贴近",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "6–16",
     "at": 2
    },
    {
     "text": "熟人安静坐着，沉默也不紧张",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "6–16",
     "at": 5
    },
    {
     "text": "夏末湿热的风黏在皮肤上",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "6–16",
     "at": 8
    },
    {
     "text": "脚下像心跳和水浪，身体被船托着",
     "after": 0,
     "from": [
      "S02-B2"
     ],
     "bars": "4–5",
     "at": 3
    },
    {
     "text": "水一直流，时间也不停",
     "after": 4,
     "from": [
      "S02-B2"
     ],
     "bars": "4–16",
     "at": 30
    },
    {
     "text": "甜蜜里有点鼻酸，盼这一刻慢些",
     "after": 4,
     "from": [
      "S02-B4"
     ],
     "bars": "7–11",
     "at": 32
    }
   ],
   "notes": [
    {
     "text": "两道贴近的旋律像耳语，几乎没有空隙",
     "from": [
      "S02-B1"
     ],
     "bars": "6–16"
    },
    {
     "text": "歌声还没浮出，摇荡已经先响起",
     "from": [
      "S02-B2"
     ],
     "bars": "4–5"
    },
    {
     "text": "歌声忽然上涌，随后轻轻呼回",
     "from": [
      "S02-B3"
     ],
     "bars": "12–16"
    },
    {
     "text": "几次柔软落音，甜里带着一点惆怅",
     "from": [
      "S02-B4"
     ],
     "bars": "7–11"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他难得不去想以后",
     "accent": "不去想",
     "emotion": "安心",
     "from": [
      "S03-1"
     ],
     "at": 0
    },
    {
     "text": "只想舒服地待在亲近里",
     "accent": "舒服地",
     "emotion": "亲密",
     "from": [
      "S03-1"
     ],
     "at": 4
    },
    {
     "text": "心里闪过一句想说的话",
     "accent": "想说的话",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ],
     "at": 11
    },
    {
     "text": "他还想问对方是不是也一样",
     "accent": "是不是也一样",
     "emotion": "不安",
     "from": [
      "S03-2"
     ],
     "at": 17
    },
    {
     "text": "可没想好怎么开口念头淡了",
     "accent": "念头淡了",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ],
     "at": 23
    }
   ],
   "small": [
    {
     "text": "亲密后的沉默反而很舒服",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23",
     "at": 4
    },
    {
     "text": "身体还在这里，心却慢慢漂远",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23",
     "at": 7
    },
    {
     "text": "像说完重要的话，还陶醉地走神",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23",
     "at": 9
    },
    {
     "text": "短促的念头像要出口，又沉了回去",
     "after": 3,
     "from": [
      "S03-B2"
     ],
     "bars": "20–21",
     "at": 18
    },
    {
     "text": "风吹碎的倒影，闪着却拼不起来",
     "after": 2,
     "from": [
      "S03-B3"
     ],
     "bars": "17–23",
     "at": 12
    },
    {
     "text": "像水下暗流拖住，声音绕远滞留",
     "after": 2,
     "from": [
      "S03-B3"
     ],
     "bars": "20–22",
     "at": 17
    }
   ],
   "notes": [
    {
     "text": "短促的声音忽然冒出，又很快沉下去",
     "from": [
      "S03-B2"
     ],
     "bars": "20–21"
    },
    {
     "text": "流动忽然受阻，像被水下暗流拖住",
     "from": [
      "S03-B3"
     ],
     "bars": "20–22"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "熟悉的亲近又回来了",
     "accent": "回来了",
     "emotion": "欢喜",
     "from": [
      "S04-1"
     ],
     "at": 0
    },
    {
     "text": "他想起上回还是没说出口",
     "accent": "没说出口",
     "emotion": "悬着",
     "from": [
      "S04-1"
     ],
     "at": 6
    },
    {
     "text": "这回几乎想把心里话全说出",
     "accent": "全说出",
     "emotion": "炽热",
     "from": [
      "S04-2"
     ],
     "at": 13
    },
    {
     "text": "他盼着对方喜欢真实的自己",
     "accent": "真实的自己",
     "emotion": "亲密",
     "from": [
      "S04-2"
     ],
     "at": 21
    },
    {
     "text": "又怕说太多连自在也失去",
     "accent": "自在也失去",
     "emotion": "不安",
     "from": [
      "S04-3"
     ],
     "at": 30
    }
   ],
   "small": [
    {
     "text": "像讲起往事，越说越快又补上细节",
     "after": 2,
     "from": [
      "S04-B1"
     ],
     "bars": "24–34",
     "at": 15
    },
    {
     "text": "像夕阳最后一道金光，亮得刺眼",
     "after": 2,
     "from": [
      "S04-B2"
     ],
     "bars": "30–34",
     "at": 24
    },
    {
     "text": "话到喉咙口，颤着又哽住",
     "after": 3,
     "from": [
      "S04-B2"
     ],
     "bars": "30–34",
     "at": 27
    },
    {
     "text": "手从轻轻握着，变成不自觉握紧",
     "after": 4,
     "from": [
      "S04-B3"
     ],
     "bars": "24–34",
     "at": 32
    },
    {
     "text": "越想抱紧，船身越颠，平衡越脆",
     "after": 4,
     "from": [
      "S04-B3"
     ],
     "bars": "24–34",
     "at": 35
    },
    {
     "text": "还没失去就已鼻酸，想多留一会儿",
     "after": 4,
     "from": [
      "S04-B4"
     ],
     "bars": "24–34",
     "at": 40
    }
   ],
   "notes": [
    {
     "text": "熟悉的歌声再现，细碎花腔闪烁起来",
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "高处的颤音亮起，随后渐渐收弱",
     "from": [
      "S04-B2"
     ],
     "bars": "30–34"
    },
    {
     "text": "贴近的歌声仍在，底下摇荡始终向前",
     "from": [
      "S04-B4"
     ],
     "bars": "24–34"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "这回他没藏住喜欢",
     "accent": "没藏住",
     "emotion": "炽热",
     "from": [
      "S05-1"
     ],
     "at": 0
    },
    {
     "text": "对方已经看出他多在乎",
     "accent": "多在乎",
     "emotion": "悬着",
     "from": [
      "S05-1"
     ],
     "at": 3
    },
    {
     "text": "他心里忽然空落落的",
     "accent": "空落落",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ],
     "at": 6
    },
    {
     "text": "连该怎么相处都拿不准",
     "accent": "拿不准",
     "emotion": "不安",
     "from": [
      "S05-2"
     ],
     "at": 9
    },
    {
     "text": "他怕对方嫌他太黏",
     "accent": "太黏",
     "emotion": "不安",
     "from": [
      "S05-3"
     ],
     "at": 12
    }
   ],
   "small": [
    {
     "text": "脚下支撑忽然抽走，只剩孤单旋律",
     "after": 2,
     "from": [
      "S05-B1"
     ],
     "bars": "35–39",
     "at": 7
    },
    {
     "text": "像小船漂进起雾的水域",
     "after": 2,
     "from": [
      "S05-B1"
     ],
     "bars": "35–39",
     "at": 7
    },
    {
     "text": "耳边的交谈戛然而止，话悬在唇边",
     "after": 3,
     "from": [
      "S05-B2"
     ],
     "bars": "35–39",
     "at": 10
    },
    {
     "text": "这份幸福是真的吗？能维持多久？",
     "after": 3,
     "from": [
      "S05-B2"
     ],
     "bars": "35–39",
     "at": 11
    },
    {
     "text": "刚才攥紧不放的劲，终于松了",
     "after": 4,
     "from": [
      "S05-B3"
     ],
     "bars": "35–39",
     "at": 14
    },
    {
     "text": "熟悉的亲近忽然像隔了一层",
     "after": 4,
     "from": [
      "S05-3"
     ],
     "bars": "",
     "at": 15
    }
   ],
   "notes": [
    {
     "text": "丰满的声音忽然只剩一条单薄旋律",
     "from": [
      "S05-B1"
     ],
     "bars": "35–39"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "对方没变，他才又自在",
     "accent": "没变",
     "emotion": "安心",
     "from": [
      "S06-1"
     ],
     "at": 0
    },
    {
     "text": "安静时他还是想靠近",
     "accent": "想靠近",
     "emotion": "亲密",
     "from": [
      "S06-2"
     ],
     "at": 7
    },
    {
     "text": "可他怕自己要得太多",
     "accent": "太多",
     "emotion": "不安",
     "from": [
      "S06-2"
     ],
     "at": 14
    },
    {
     "text": "他孤单地猜对方也会舍不得",
     "accent": "也会舍不得",
     "emotion": "悬着",
     "from": [
      "S06-2",
      "S06-3"
     ],
     "at": 22
    },
    {
     "text": "舒服得像水波一层层荡开",
     "accent": "一层层荡开",
     "emotion": "炽热",
     "from": [
      "S06-B4"
     ],
     "at": 29
    }
   ],
   "small": [
    {
     "text": "暖金水面滑入古桥阴影，空气凉了",
     "after": 0,
     "from": [
      "S06-B1"
     ],
     "bars": "40–50",
     "at": 3
    },
    {
     "text": "像清凉月光，也像童年初次心动",
     "after": 0,
     "from": [
      "S06-B1"
     ],
     "bars": "40–50",
     "at": 6
    },
    {
     "text": "心里反复响着：算了，可还是放不下",
     "after": 2,
     "from": [
      "S06-B2"
     ],
     "bars": "40–50",
     "at": 16
    },
    {
     "text": "像说着说着，忘了还被人看着",
     "after": 2,
     "from": [
      "S06-B2"
     ],
     "bars": "40–50",
     "at": 19
    },
    {
     "text": "回家后心酸，亲近的人也进不了心里",
     "after": 3,
     "from": [
      "S06-B3"
     ],
     "bars": "40–50",
     "at": 24
    },
    {
     "text": "气味、身体、幻想、遗憾和快感交叠",
     "after": 4,
     "from": [
      "S06-B4"
     ],
     "bars": "40–50",
     "at": 31
    }
   ],
   "notes": [
    {
     "text": "清澈的歌声响起，摇荡变得细碎轻柔",
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "低声旋律与另一道声音时近时远地交缠",
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "他想起对方总愿意陪他",
     "accent": "总愿意",
     "emotion": "亲密",
     "from": [
      "S07-1"
     ],
     "at": 0
    },
    {
     "text": "也许对方有时也需要他",
     "accent": "也需要他",
     "emotion": "欢喜",
     "from": [
      "S07-1"
     ],
     "at": 7
    },
    {
     "text": "想到能互相依靠他很欢喜",
     "accent": "互相依靠",
     "emotion": "欢喜",
     "from": [
      "S07-2"
     ],
     "at": 14
    },
    {
     "text": "心里忽然一紧还是想留下",
     "accent": "一紧",
     "emotion": "悬着",
     "from": [
      "S07-2"
     ],
     "at": 22
    },
    {
     "text": "他盼着对方以后还会找他",
     "accent": "还会找他",
     "emotion": "亲密",
     "from": [
      "S07-3"
     ],
     "at": 30
    }
   ],
   "small": [
    {
     "text": "清澈底下的暗涌越来越急",
     "after": 2,
     "from": [
      "S07-B1"
     ],
     "bars": "51–61",
     "at": 15
    },
    {
     "text": "热度像情欲、执念和对生命的眷恋",
     "after": 2,
     "from": [
      "S07-B1"
     ],
     "bars": "51–61",
     "at": 18
    },
    {
     "text": "气味、身体、幻想、遗憾和快感交叠",
     "after": 3,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61",
     "at": 23
    },
    {
     "text": "明知被卷进去，暂时不想出来",
     "after": 3,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61",
     "at": 26
    },
    {
     "text": "美还在，时间却已经经过",
     "after": 4,
     "from": [
      "S07-B3"
     ],
     "bars": "53–61",
     "at": 33
    }
   ],
   "notes": [
    {
     "text": "伴奏越来越密，低沉脉搏不断催促",
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "他见对方仍然亲近",
     "accent": "仍然亲近",
     "emotion": "安心",
     "from": [
      "S08-1"
     ],
     "at": 0
    },
    {
     "text": "这回想大方地回应",
     "accent": "大方地回应",
     "emotion": "欢喜",
     "from": [
      "S08-1"
     ],
     "at": 7
    },
    {
     "text": "连往后的日子也开始期待",
     "accent": "开始期待",
     "emotion": "欢喜",
     "from": [
      "S08-2"
     ],
     "at": 14
    },
    {
     "text": "他觉得两人或许能好很久",
     "accent": "好很久",
     "emotion": "亲密",
     "from": [
      "S08-2"
     ],
     "at": 22
    },
    {
     "text": "可以后还会不会这样他没底",
     "accent": "没底",
     "emotion": "不安",
     "from": [
      "S08-3"
     ],
     "at": 30
    }
   ],
   "small": [
    {
     "text": "像重新碰到阳光和风，身体有了弹性",
     "after": 1,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70",
     "at": 8
    },
    {
     "text": "带着一点轻快的调情和回应",
     "after": 1,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70",
     "at": 12
    },
    {
     "text": "快乐余温还在，心里先泛起怀念",
     "after": 4,
     "from": [
      "S08-B3"
     ],
     "bars": "69–71",
     "at": 32
    }
   ],
   "notes": [
    {
     "text": "歌句越唱越开，情绪一层层抬高",
     "from": [
      "S08-B1"
     ],
     "bars": "62–70"
    },
    {
     "text": "歌声向上散开，正要继续时忽然停住",
     "from": [
      "S08-B3"
     ],
     "bars": "69–71"
    }
   ]
  },
  {
   "sec": "S09",
   "big": [
    {
     "text": "他怕对方哪天不再需要他",
     "accent": "不再需要他",
     "emotion": "不安",
     "from": [
      "S09-1"
     ],
     "at": 0
    },
    {
     "text": "连和他待着也不自在？",
     "accent": "不自在",
     "emotion": "悬着",
     "from": [
      "S09-1"
     ],
     "at": 5
    },
    {
     "text": "他一下安静下来",
     "accent": "安静下来",
     "emotion": "孤单",
     "from": [
      "S09-2"
     ],
     "at": 11
    },
    {
     "text": "刚才还敢盼很远现在不敢想",
     "accent": "不敢想",
     "emotion": "不安",
     "from": [
      "S09-2"
     ],
     "at": 17
    },
    {
     "text": "可眼下的亲近仍是真的",
     "accent": "仍是真的",
     "emotion": "安心",
     "from": [
      "S09-3"
     ],
     "at": 24
    }
   ],
   "small": [
    {
     "text": "像对视到呼吸都停了，渴望还在",
     "after": 2,
     "from": [
      "S09-B1"
     ],
     "bars": "72–77",
     "at": 12
    },
    {
     "text": "像阳光隔着薄雾，光还在",
     "after": 3,
     "from": [
      "S09-B2"
     ],
     "bars": "72–77",
     "at": 19
    },
    {
     "text": "他反复问：刚才是真的吗？接下来呢？",
     "after": 3,
     "from": [
      "S09-B3"
     ],
     "bars": "72–77",
     "at": 20
    },
    {
     "text": "抬头望见夜空，眼前美好比愿望更大",
     "after": 4,
     "from": [
      "S09-B4"
     ],
     "bars": "72–77",
     "at": 25
    },
    {
     "text": "也许对方也喜欢他陪着，他有点高兴",
     "after": 4,
     "from": [
      "S09-3"
     ],
     "bars": "",
     "at": 27
    }
   ],
   "notes": [
    {
     "text": "明亮渐渐收走，声音一层层下沉",
     "from": [
      "S09-B2"
     ],
     "bars": "72–77"
    },
    {
     "text": "轻柔颤音和和弦悬在半空",
     "from": [
      "S09-B1"
     ],
     "bars": "76–77"
    }
   ]
  },
  {
   "sec": "S10",
   "big": [
    {
     "text": "他不再猜往后会怎样",
     "accent": "不再猜",
     "emotion": "安心",
     "from": [
      "S10-1"
     ],
     "at": 0
    },
    {
     "text": "先好好享受眼前的亲近",
     "accent": "眼前的亲近",
     "emotion": "亲密",
     "from": [
      "S10-1"
     ],
     "at": 6
    },
    {
     "text": "绷紧的肩膀终于松开",
     "accent": "终于松开",
     "emotion": "安心",
     "from": [
      "S10-2"
     ],
     "at": 13
    },
    {
     "text": "心里亮得想笑也想哭",
     "accent": "想笑也想哭",
     "emotion": "欢喜",
     "from": [
      "S10-2"
     ],
     "at": 20
    }
   ],
   "small": [
    {
     "text": "胸口一下打开，眼泪也不必再忍",
     "after": 2,
     "from": [
      "S10-B1"
     ],
     "bars": "78–83",
     "at": 14
    },
    {
     "text": "水波像被清风拨开，时间松了一会儿",
     "after": 1,
     "from": [
      "S10-B2"
     ],
     "bars": "78–83",
     "at": 8
    },
    {
     "text": "身体像失了重量，飘在夏夜微风里",
     "after": 3,
     "from": [
      "S10-B3"
     ],
     "bars": "78–83",
     "at": 18
    },
    {
     "text": "压在身上的负担仿佛碰不到自己",
     "after": 3,
     "from": [
      "S10-B3"
     ],
     "bars": "78–83",
     "at": 19
    },
    {
     "text": "细亮音符像银丝，也像轻轻落下的雨",
     "after": 3,
     "from": [
      "S10-B4"
     ],
     "bars": "78–83",
     "at": 21
    },
    {
     "text": "一串琶音像飞瀑，从高处清亮落进水里",
     "after": 3,
     "from": [
      "S10-B4"
     ],
     "bars": "80–83",
     "at": 23
    }
   ],
   "notes": [
    {
     "text": "高处细亮的音符织起，随后一串清亮倾泻",
     "from": [
      "S10-B4"
     ],
     "bars": "80–83"
    }
   ]
  },
  {
   "sec": "S11",
   "big": [
    {
     "text": "他承认自己需要对方",
     "accent": "需要对方",
     "emotion": "亲密",
     "from": [
      "S11-1"
     ],
     "at": 0
    },
    {
     "text": "也觉得对方有时需要他",
