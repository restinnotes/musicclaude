{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"我不能倒下，可我其实很想停下来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"可其实想停下来\"\n        },\n        {\n          \"quote\": \"究竟是愤怒、遗憾还是怀念\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"是气、悔，还是想念？\"\n        },\n        {\n          \"quote\": \"像身体先于意识，隐约记起了该如何迈步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开了熟悉的生活\",\n          \"point\": \"不用再委屈自己了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初觉得总算\"\n        },\n        {\n          \"text\": \"可这份笃定没撑多久\",\n          \"point\": \"说不清自己到底舍不得什么\",\n          \"where\": \"后\",\n          \"waste\": \"自己\",\n          \"keep\": \"这份笃定没撑多久\"\n        },\n        {\n          \"text\": \"他还是想往前过\",\n          \"point\": \"不知道以后靠什么让自己安下心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还是想往前过\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"舞曲带着一点面向众人的庄严，歌声却像私人记忆里的低声哼唱\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"庄严向外，旧歌向内\"\n        },\n        {\n          \"quote\": \"像腿脚虚浮的人，在记忆中挪动舞步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"第一次还有几分相信，第二次开始努力让自己相信\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越说“我没事”，越显在意\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他舍不得从前那些自在日子\",\n          \"point\": \"心里就发慌\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一想到以后不能再那样过\"\n        },\n        {\n          \"text\": \"一心软，他就赶紧\",\n          \"point\": \"赶紧想起受过的气\",\n          \"where\": \"中\",\n          \"waste\": \"自己\",\n          \"keep\": \"怕自己忘了当初为什么离开\"\n        },\n        {\n          \"text\": \"可他还是不甘心\",\n          \"point\": \"就非得把以前的好日子也丢掉吗\",\n          \"where\": \"后\",\n          \"waste\": \"可他还是不甘心\",\n          \"keep\": \"难道不再受气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"温柔得让人心颤，也刺痛得让人绝望\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越温柔，越刺痛\"\n        },\n        {\n          \"quote\": \"调性又像流沙，抓不住重心\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"我刚才是真的相信那些话，还是只是在努力让自己相信？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还是逼自己相信？\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他心里还憋着一股气\",\n          \"point\": \"还憋着一股气\",\n          \"where\": \"前\",\n          \"waste\": \"受过的委屈还没有过去\",\n          \"keep\": \"还憋着\"\n        },\n        {\n          \"text\": \"可一想起从前有人\",\n          \"point\": \"有人把他当作自己人\",\n          \"where\": \"中\",\n          \"waste\": \"从前\",\n          \"keep\": \"竟又高兴了一小会儿\"\n        },\n        {\n          \"text\": \"可那点高兴还没退\",\n          \"point\": \"离开以后就一定会更好吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"那点高兴还没退\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"原来的姿态回来，却显得更柔软、更容易受伤\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"姿态一样，心更脆了\"\n        },\n        {\n          \"quote\": \"不是记忆变坏了，而是它太好了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不停地往前赶，只是为了避免停下来\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"越赶，越不敢停\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起那些亲近的时候\",\n          \"point\": \"盼着一切还能像从前那样继续\",\n          \"where\": \"后\",\n          \"waste\": \"一切\",\n          \"keep\": \"真盼着\"\n        },\n        {\n          \"text\": \"可越盼着，他越怀疑\",\n          \"point\": \"怀疑当初是不是走错了\",\n          \"where\": \"中\",\n          \"waste\": \"当初\",\n          \"keep\": \"却怎么也想不出没走会怎样\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"歌唱变得亲近，却仍然克制\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像脚下原有的地板忽然不见了，只剩一个声音自己说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍不服气\",\n          \"point\": \"那些气确实不该忍\",\n          \"where\": \"后\",\n          \"waste\": \"当初\",\n          \"keep\": \"仍不服气\"\n        },\n        {\n          \"text\": \"可他也不想连从前\",\n          \"point\": \"连从前开心的事都不敢想\",\n          \"where\": \"中\",\n          \"waste\": \"他也不想\",\n          \"keep\": \"那样太为难自己了\"\n        },\n        {\n          \"text\": \"他跟自己争得没了力气\",\n          \"point\": \"只剩下离开他们后的难受\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"跟自己争得没了力气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"连呼吸都不愿惊动它\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"明知有些事已经挽不回，便放轻声音，好好看着它\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"有些事拿不回来\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"心里的难受慢慢缓下来\",\n          \"point\": \"没再拿受过的气压住想念\",\n          \"where\": \"后\",\n          \"waste\": \"心里的\",\n          \"keep\": \"这回没再\"\n        },\n        {\n          \"text\": \"离开以后，难熬的事\",\n          \"point\": \"有人陪着有多轻松\",\n          \"where\": \"后\",\n          \"waste\": \"离开以后\",\n          \"keep\": \"难熬的事常常只能自己扛\"\n        },\n        {\n          \"text\": \"他很想再过那种\",\n          \"point\": \"不用多说就知道彼此亲近\",\n          \"where\": \"中\",\n          \"waste\": \"那种\",\n          \"keep\": \"又怕再也没有了\"\n        },\n        {\n          \"text\": \"不过，那样的日子\",\n          \"point\": \"光是想起来，心里也暖了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"确实经历过\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"轻得像游丝、却带着刺骨寒意\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"轻若游丝，却刺骨\"\n        },\n        {\n          \"quote\": \"这样的亲切感未必安慰人\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"事情表面上仿佛已经过去，身体和情绪却还没有完全相信一切已经结束\",\n 