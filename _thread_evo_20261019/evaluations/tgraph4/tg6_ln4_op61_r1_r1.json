  {
   "bars": "254–288",
   "relation": "正在面对",
   "items": [
    {
     "id": "I111",
     "text": "他仍想回到无需戒备的亲近中。",
     "key": "无需戒备",
     "kind": ""
    },
    {
     "id": "I112",
     "text": "他仍向往能尽情付出也能安心接受。",
     "key": "尽情付出",
     "kind": ""
    },
    {
     "id": "I113",
     "text": "他知道那种生活无法轻易重来。",
     "key": "无法轻易重来",
     "kind": ""
    },
    {
     "id": "I114",
     "text": "他并未因此变得冷淡。",
     "key": "变得冷淡",
     "kind": ""
    },
    {
     "id": "I115",
     "text": "他发觉旧日愿意信赖的热切仍在。",
     "key": "愿意信赖",
     "kind": ""
    },
    {
     "id": "I116",
     "text": "他心里仍有真诚相待的柔软。",
     "key": "真诚相待",
     "kind": ""
    },
    {
     "id": "I117",
     "text": "他仍保留着不愿被轻慢的骄傲。",
     "key": "不愿被轻慢",
     "kind": ""
    },
    {
     "id": "I118",
     "text": "他依然会因失去而疼痛和舍不得。",
     "key": "疼痛和舍不得",
     "kind": ""
    },
    {
     "id": "I119",
     "text": "他渴望有人让他不必独自忍受孤单。",
     "key": "独自忍受孤单",
     "kind": ""
    },
    {
     "id": "I120",
     "text": "他不愿靠损伤自己来结束孤单。",
     "key": "结束孤单",
     "kind": ""
    },
    {
     "id": "I121",
     "text": "他不愿伤害旧日留在自己身上的那份骄傲。",
     "key": "那份骄傲",
     "kind": ""
    },
    {
     "id": "I122",
     "text": "他重新感到向前走的力量。",
     "key": "向前走的力量",
     "kind": ""
    },
    {
     "id": "I123",
     "text": "他向前时仍带着旧日的温暖。",
     "key": "旧日的温暖",
     "kind": ""
    },
    {
     "id": "I124",
     "text": "他向前时也带着失去它的悲伤。",
     "key": "失去它的悲伤",
     "kind": ""
    },
    {
     "id": "I125",
     "text": "他不必说过去不值得留恋，也能继续向前。",
     "key": "不值得留恋",
     "kind": ""
    },
    {
     "id": "I126",
     "text": "他明知继续向前仍会疼痛。",
     "key": "仍会疼痛",
     "kind": ""
    },
    {
     "id": "I127",
     "text": "他还是不肯退让。",
     "key": "不肯退让",
     "kind": ""
    },
    {
     "id": "I128",
     "text": "他终于能怀着全部不舍继续向前。",
     "key": "全部不舍",
     "kind": ""
    },
    {
     "id": "I129",
     "text": "他最想要的生活里可以深爱别人。",
     "key": "深爱别人",
     "kind": ""
    },
    {
     "id": "I130",
     "text": "他也想在这样的生活里不必贬低自己。",
     "key": "不必贬低自己",
     "kind": ""
    },
    {
     "id": "I131",
     "text": "他明白靠卑微换回亲近，也得不到怀念的那种生活。",
     "key": "怀念的那种生活",
     "kind": "选择的代价"
    }
