ter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"半音阶下行又带来另一股反向的力，像在撕扯中步步后退。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起那些亲近的时候\",\n          \"point\": \"一切还能照从前那样继续\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"有一阵真盼着\"\n        },\n        {\n          \"text\": \"可这么盼着\",\n          \"point\": \"要是没走，如今会怎样\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可这么盼着\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"眷恋里也带着失落。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍不服气\",\n          \"point\": \"也太为难自己了\",\n          \"where\": \"后\",\n          \"waste\": \"觉得\",\n          \"keep\": \"连过去开心的事都不敢多想\"\n        },\n        {\n          \"text\": \"跟自己争得没了力气\",\n          \"point\": \"已不在那些人身边\",\n          \"where\": \"中\",\n          \"waste\": \"如今\",\n          \"keep\": \"跟自己争得没了力气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它也像母亲在耳畔轻轻哼唱的摇篮曲。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"摇篮曲\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"音乐没有许诺\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"心里那阵难受慢慢缓下来\",\n          \"point\": \"没急着拿受过的气压住这份想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这回没急着\"\n        },\n        {\n          \"text\": \"离开以后\",\n          \"point\": \"有人在身边能让自己轻松多少\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"常常只能自己挺过去\"\n        },\n        {\n          \"text\": \"他很想再过上那种\",\n          \"point\": \"不用多说也知道彼此亲近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"又怕以后再也没有了\"\n        },\n        {\n          \"text\": \"不过，那样的日子自己毕竟\",\n          \"point\": \"心里也暖和了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"毕竟真真切切过过\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"把人从甜梦里生生拽回严寒。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"拽回严寒\"\n        },\n        {\n          \"quote\": \"事情表面上仿佛已经过去，身体和情绪却还没有完全相信一切已经结束。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"情绪也还不信\"\n        },\n        {\n          \"quote\": \"这样的亲切感未必安慰人；恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"刚有点安心\",\n          \"point\": \"他真的撑得住吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"刚有点安心\"\n        },\n        {\n          \"text\": \"当初走时他只想着\",\n          \"point\": \"早知道这样，自己还会走吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只想着别再受那些气\"\n        },\n        {\n          \"text\": \"他想找回从前那份亲近\",\n          \"point\": \"连当初走时那股决心也找不着了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又不甘心回去再受那些气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"像一个人已经准备离开，却在最后一刻回过头，再看一眼刚才待过的地方；那一眼里有温柔，也有不舍。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"胸口仿佛终于吸进一口气。它只是瞬间的喘息，并不等于整个人重新安顿下来。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他暂时把回不回去的事放到一边\",\n          \"point\": \"心里又暖和了一会儿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"暂时把回不回去的事放到一边\"\n        },\n        {\n          \"text\": \"可那点暖意很快就淡了\",\n          \"point\": \"回忆没法陪着他\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"以后真遇上难事\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"开头沉重的引子从中阴冷地闪现回来，却不再像最初那样郑重召唤。\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"开头引子阴冷地闪回\"\n        },\n        {\n          \"quote\": \"声音短暂落稳，又向高处漂去，刚有的一点稳定感随即散掉。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"只是这一次，你已经知道那个过去的自己经历