     "bars": "32-34",
     "from": [
      "S04-B2"
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "rows": [
    {
     "kind": "line",
     "text": "这回他没藏住喜欢，等察觉时，对方已经看出他有多在乎",
