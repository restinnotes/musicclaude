   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "还舍不得离开刚才的安宁。",
      "key": "还舍不得离开刚才",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1",
       "S07-1",
       "S08-1"
      ]
     },
     {
      "id": "S09-2",
      "text": "可我无法再信想通就不用面对缺憾。",
      "key": "可我无法再信想通",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-3",
