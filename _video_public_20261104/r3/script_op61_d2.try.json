 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "kind": "说不清的失落",
     "emotion": "孤单",
     "lines": [
      {
       "text": "笃定很快散了心里空落落的却说不清舍不得什么。",
