{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"细碎的光点再缓缓飘落。落下来以后，却还没有真正落稳，仿佛仍悬在水面上方\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"缓缓落下，却还未落稳\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变，所以格外谨慎。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现自己那么想靠近这个人\",\n          \"point\": \"那么想靠近这个人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"连自己也有点意外\"\n        },\n        {\n          \"text\": \"他怕对方一看出自己有多需要这份亲近\",\n          \"point\": \"只敢露出一点点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"就会觉得负担太重\"\n        },\n        {\n          \"text\": \"只是这么一点亲近就让他觉得甜\",\n          \"point\": \"下次自己能不能更坦白些\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只是这么一点亲近就让他觉得甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"夏末水面潮湿、温热的微风，裹在皮肤上有些黏稠。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"潮湿、黏稠\"\n        },\n        {\n          \"quote\": \"可以放弃对重力的控制，把身体交给船底温柔的托举。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"放弃对重力的控制\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有因为他露出在意就退开\",\n          \"point\": \"仍愿意跟他亲近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"没有因为他露出在意就退开\"\n        },\n        {\n          \"text\": \"他也想顺势靠得更近\",\n          \"point\": \"最后还是收住了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕太急弄坏眼下的自在\"\n        },\n        {\n          \"text\": \"两个人待在一起这么好\",\n          \"point\": \"还没分开就先有一点舍不得\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这样的时刻总会过去\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"身体还在这里，心却已经慢慢漂远。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"音乐并未走向悲剧，却在那份顺畅之中生出了阻力。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是悲剧，只是有了阻力\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他难得不去琢磨两个人往后会怎样\",\n          \"point\": \"只想舒舒服服地待在这份亲近里\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"难得不去琢磨两个人往后会怎样\"\n        },\n        {\n          \"text\": \"中间他忽然想告诉对方自己多喜欢这样\",\n          \"point\": \"念头就淡了\",\n          \"where\": \"后\",\n          \"waste\": \"中间\",\n          \"keep\": \"可还没想好怎么开口\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"本来一句话已经够了，却忍不住再说一遍，又折回来补上更多细节。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"又折回来补上更多细节\"\n        },\n        {\n          \"quote\": \"自己也许还没有意识到在害怕什么，动作已经先透露了出来。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"动作先泄露了害怕\"\n        },\n        {\n          \"quote\": \"每一秒都在倒数。还没有失去什么，就已经舍不得了；歌声越美，越让人想多留在这一刻。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"熟悉的亲近又让他满心欢喜\",\n          \"point\": \"上回明明想告诉对方却没有开口\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"明明想告诉对方却没有开口\"\n        },\n        {\n          \"text\": \"他几乎想把藏着的话全说出来\",\n          \"point\": \"对方也喜欢他不再小心收着的样子\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"几乎想把藏着的话全说出来\"\n        },\n        {\n          \"text\": \"他甚至盼着说出来能把眼下的好留得久一点\",\n          \"point\": \"最后还是留了些话没说\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕一下说得太多让对方为难，连两个人原有的自在也弄丢\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"丰满的声音只剩下一条单薄、孤零零的旋律，在空中漫无目的地游走。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"只剩一条单薄、孤零零的旋律\"\n        },\n        {\n          \"quote\": \"一个人从“我与你”的亲密中抽身，转而跌回自己的内心\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"从“我与你”退回自己\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"前几次想说又收住\",\n          \"point\": \"对方已经看出他有多在乎\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"不知不觉就忘了藏好喜欢\"\n        },\n        {\n          \"text\": \"先前藏着时还能装作没那么在乎\",\n          \"point\": \"连怎么跟对方待着都拿不准\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"先前藏着时还能装作没那么在乎，如今对方看出来了\"\n        },\n        {\n          \"text\": \"他忍不住担心对方会嫌自己太黏\",\n          \"point\": \"在他心里也像忽然隔了一层\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"连原本熟悉的亲近，在他心里也像忽然隔了一层\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"左手的波浪变薄、碎成细密的小纹。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"波浪变薄，碎成细纹\"\n        },\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"气味、身体感觉、幻想、遗憾、快感混在一起。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"这回对方看出他有多在乎\",\n          \"point\": \"才又能像从前那样自在地待着\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"跟他相处却一点没变\"\n        },\n        {\n          \"text\": \"安静下来以后\",\n          \"point\": \"忽然觉得有点孤单\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方根本不知道他刚才有多怕被嫌弃\"\n        },\n        {\n          \"text\": \"他又忍不住想\",\n          \"point\": \"舍不得结束这份亲近\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"既然一直没有退开\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"伴奏音符变密，内声部像水底的暗涌不断攀爬，低音的八度与切分像沉重的脉搏在催促。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"你明知道自己正在被卷进去，却暂时不想出来。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"音乐并没有彻底变暗，美也没有消失；只是这一刻纵然完美，你也没有办法让它停住。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"美还没有暗下去，时间却不停\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起这些日子对方总愿意跟他待在一起\",\n          \"point\": \"对方有时也需要他陪着\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"这些日子对方总愿意跟他待在一起\"\n        },\n        {\n          \"text\": \"这个念头让他高兴得有点收不住\",\n          \"point\": \"越舍不得从这份欢喜里抽身\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"高兴得有点收不住\"\n        },\n        {\n          \"text\": \"他真盼着\",\n          \"point\": \"