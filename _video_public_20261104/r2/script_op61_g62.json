 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开了那段熟悉的生活，起初还觉得总算不用再委屈自己。",
       "keys": [
        "离开了",
        "不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里空落落的，说不清舍不得什么。",
       "keys": [
        "笃定",
        "空落落"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他仍想往前过，却不知道以后靠什么才能让自己安下心。",
       "keys": [
        "往前过",
        "安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头那一下沉得郑重，后面的声音却像烟雾，轻轻散到半空。",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "短短一句刚冒出来，就被长停顿截断，只剩余音在冷空气里散尽。",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "像刚从昏沉里醒来，胸口发紧，伸手去摸却只碰到虚空。",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "旧日场景忽然清晰起来，可再熟悉，也回不到眼前。",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "身体仿佛先记起了舞步，心里却还没真正决定往哪走。",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他舍不得从前那些自在的日子，一想到以后不能再那样过，心里就慌。",
       "keys": [
        "舍不得",
        "心里就慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他赶紧想起受过的气，提醒自己别因一时心软，忘了当初为什么走。",
       "keys": [
        "受过的气",
        "为什么走"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可他仍不甘心：难道不再受委屈，就得连从前的好日子也丢掉？",
       "keys": [
        "不甘心",
        "好日子"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的旋律像远处传来的旧歌，记得它，却只能模糊地哼几句。",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "步子看着庄严，心里却虚浮；底下那点不安始终没有停。",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "刚往上提起的情绪又退下来，始终没能稳稳落地。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "呼吸像被越催越急，心里的焦灼也跟着加深。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "一遍遍说“我没事”，起初还相信，后来连自己也要勉强。",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他心里还憋着一股气，却因想起曾被当作自己人，短暂地高兴起来。",
       "keys": [
        "憋着一股气",
        "自己人"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可那点高兴很快变酸：从前回不去了，离开后也未必更好过。",
       "keys": [
        "变酸",
        "未必更好过"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那份亲切温柔得让人心颤，越怀念，越觉得它离眼前很远。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "那一刻的轻松可以是真的，只是暂时绕开伤口，并没有解开它。",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起那些亲近的时候，他真盼着一切还能照从前那样继续。",
       "keys": [
        "盼着一切",
        "照从前那样"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可越是盼，他越怀疑当初是否走错，却想不出没走会怎样。",
       "keys": [
        "怀疑当初是否走错",
        "想不出"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那些回忆重新有了温度，亲密和柔情也让他更容易受伤。",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "记忆越美好，眼前的失去越刺痛，越用力越不安稳。",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "脚步和心跳都像乱了拍，仿佛被时间催着，根本停不下来。",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "脑子里反复转着“如果当时……”，想弄明白，却始终停不下来。",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他仍觉得当初那些委屈不该忍，也不愿连开心的往事都不敢想。",
       "keys": [
        "委屈不该忍",
        "开心的往事"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可争得筋疲力尽后，那股不服气淡了，只剩离开他们的难受。",
       "keys": [
        "筋疲力尽",
        "不服气淡了"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "两只手像夜色里的两个影子，彼此低声说话，亲近却克制。",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "柔和里仍有一股顶着压力往前的劲，像在说：不能就这样算了。",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "声音渐渐稀下来，像脚下的地板忽然不见，只剩自己开口。",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "紧绷终于松了一口气，却更像抵抗累了，并不是已经想通。",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "难受慢慢缓下来，他重新想起从前亲近的日子，这回没急着压住想念。",
       "keys": [
        "亲近的日子",
        "没急着压住想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "离开后遇上难事，他常常只能独自撑过去，才懂得有人陪有多轻松。",
       "keys": [
        "独自撑过去",
        "有人陪有多轻松"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他很想再过那种不用多说也彼此亲近的日子，又怕以后再也没有。",
       "keys": [
        "不用多说",
        "怕以后再也没有"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "不过，那样的日子他毕竟真切过，光是想起，心里也暖了一点。",
       "keys": [
        "真切过",
        "心里也暖了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "四周像罩着一层透明玻璃，安静得连呼吸都不愿惊动。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "终于不用向别人解释为什么难过，也不必再装作坚强。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "远方的家园忽然亮起来，只能在梦里远远看见。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "心里的话终于慢慢展开，像鼓起勇气把它说出来。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "情感越说越满、越迫切，却仍像停在一句没说完的话上。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "明知有些事挽不回，便不急着抓住，只是轻轻看着它。",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "刚有点安心，他却想到：以后再遇上难事，还得一个人扛吗？",
       "keys": [
        "有点安心",
        "一个人扛"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "当初离开时只想着不再受气，没料到会这么孤单；早知道还会走吗？",
       "keys": [
        "不再受气",
        "这么孤单"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想找回从前的亲近，又不甘心回去受委屈，连当初的决心也找不着了。",
       "keys": [
        "找回从前的亲近",
        "决心也找不着了"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "一阵寒意像猛地吹开窗，把人从甜梦里拽回严寒。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "后颈一凉，脉搏突然快起来，身体比心思更早惊醒。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "眼前像突然换了场景，原先的思绪被截断，却没有因此安定。",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "紧张一层层翻上来，思绪停不住，身体也不肯相信事情已结束。",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      },
      {
       "text": "熟悉的动作和日常忽然闯进来，亲切得反而更显出失去了什么。",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他暂时把回不回去放到一边，想起从前亲近的时光，心里暖了一会儿。",
       "keys": [
        "放到一边",
        "暖了一会儿"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可暖意很快淡了：回忆不能陪他熬过下一次难关，心又悬起来。",
       "keys": [
        "暖意很快淡了",
        "心又悬起来"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "激烈的思绪之间，他像终于吸进一口气，却只是短暂喘息。",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他忽然说不清，想回去是舍不得从前，还是难受时只想有人陪。",
       "keys": [
        "说不清",
        "有人陪"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "这个念头让他一阵心慌，连往下想都不敢了。",
       "keys": [
        "一阵心慌",
        "不敢了"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚有一点稳定感，声音又向上散开，像门重新出现，路却还没成形。",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "他像重新遇见那个不知所措的自己，只是这回记得自己走过什么。",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "最舍不得的，还是从前有人把他当作自己人。",
       "keys": [
        "最舍不得",
        "自己人"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "可回去也未必能回到从前，那些委屈不能当没发生。",
       "keys": [
        "回到从前",
        "不能当没发生"
       ],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想得筋疲力尽，仍没答案，眼下也过得不踏实。",
       "keys": [
        "筋疲力尽",
        "不踏实"
       ],
       "from": [
        "S10-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的声音只剩几块碎片，像重要的往事，却已拼不成完整的话。",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "忽然像失了重量，悬在半空，连身体也找不到着落。",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他明知回去未必找得回亲近，仍忍不住盼一盼，却不肯再忍让。",
       "keys": [
        "找得回亲近",
        "不肯再忍让"
       ],
       "from": [
        "S11-1",
        "S11-2"
       ]
      }
     ],
