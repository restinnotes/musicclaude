 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现，自己竟这么想靠近这个人，心里一下热起来。",
       "keys": [
        "这么想靠近",
        "心里一下热起来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕对方看出自己有多需要这份亲近，会觉得负担太重；话到嘴边先沉默几秒，只敢露出一点喜欢。",
       "keys": [
        "负担太重",
        "只敢露出一点喜欢"
       ],
       "from": [
        "S01-2",
        "S01-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "这么一点亲近已经让他觉得甜，下次能不能更坦白，他还拿不准",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他露出在意，对方仍愿亲近、没有退开，他才慢慢放松。",
       "keys": [
        "没有退开",
        "慢慢放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两道旋律贴耳低语，肩膀挨着肩膀，呼吸和体温都贴在一起；像熟人安静坐着，偶尔对视也不尴尬，夏末湿热的风裹着皮肤",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想靠得更近，喜欢一度几乎藏不住；怕太急弄坏眼下的自在，最后还是收住了。",
       "keys": [
        "最后还是收住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待得这么好，他却想到这一刻总会过去，还没分开就先舍不得。",
       "keys": [
        "这一刻总会过去",
        "先舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不想两个人以后会怎样，只想舒服地待在这份亲近里；歌声退远，水波托着身体，像说完重要的话还在余味里发愣，沉默也很舒服，心却慢慢漂远。",
       "keys": [
        "舒服地待在这份亲近里",
        "心却慢慢漂远"
       ],
       "from": [
        "S03-1",
        "S03-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "20–21小节，持续摇曳中忽然冒出几句急切的声音，像一个念头露了一下头，很快又沉回去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水波还在晃，却像被水下暗流拖住；思绪成了风吹碎的倒影，闪烁着，却拼不完整",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想告诉对方自己有多喜欢，也想问对方是否一样；没想好怎么说，念头就淡了。",
       "keys": [
        "有多喜欢",
        "是否一样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他满心欢喜；上回没说出口的话，这次又涌上心头。",
       "keys": [
        "满心欢喜",
        "没说出口的话"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的歌声又回来，两道声线贴耳低语，这一遍更华丽、更迫切；花腔像水面晃眼的光斑，一句话说完还忍不住补细节",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想把藏着的话全说出来，也盼对方喜欢自己不再收着的样子。",
       "keys": [
        "把藏着的话全说出来",
        "不再收着的样子"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "还没弄清怕什么，手已从轻握变得更紧；想抱牢当下，水面却更颠，船舱也更难稳",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "两道声线仍贴得很近，水波却像在倒数；美好还在，鼻子已经发酸，还没失去就舍不得",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想把眼下的好留久一点，又怕说得太多让对方为难、弄丢原有的自在，最后还是留了些话没说。",
       "keys": [
        "把眼下的好留久一点",
        "留了些话没说"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "前几次想说又收住，对方却一直愿意亲近；这回他忘了藏好喜欢，对方已经看出他有多在乎。",
       "keys": [
        "忘了藏好喜欢",
        "看出他有多在乎"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波和摇晃忽然被抽掉，只剩一条孤零零的旋律；像漂进雾里，脚下突然没了支撑",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "贴近的耳语戛然而止，从「我与你」跌回自己心里：这份幸福是真的吗？能维持多久",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "先前想攥紧不放的劲，忽然像松开了手，终于能深吸一口气",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "被看出来后，他心里空落落的，怕对方嫌自己太黏，连怎么相处都拿不准。",
       "keys": [
        "心里空落落的",
        "嫌自己太黏"
       ],
       "from": [
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他有多在乎，却一点没变；他终于又能像从前那样自在地待着。",
       "keys": [
        "一点没变",
        "自在地待着"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "安静下来，他还想靠近，却怕自己要得太多；对方不知道他刚才多怕被嫌弃，他有点孤单。",
       "keys": [
        "还想靠近",
        "有点孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "低声旋律旁，另一条声线不时回应、插话，又纠缠回来；刚说算了，心里又放不下。像一个人说着说着，忘了自己正被别人看着，不再努力显得完整",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "白天相处得很好，独自回家心头却泛酸；再亲近的人，也走不进心里的每个角落，美好时光恍惚间已像回忆",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "也有人听到的不是欲望退潮，而是更贴身的沉醉：气味、身体感觉、幻想、遗憾和快感混在一起，舒服得失去方向",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他又忍不住想，对方一直没有退开，会不会也舍不得结束这份亲近？",
       "keys": [
        "一直没有退开",
        "舍不得结束这份亲近"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这些日子对方总愿意陪他，他渐渐觉得，对方或许也需要他，跟他在一起能安心些。",
       "keys": [
        "总愿意陪他",
        "或许也需要他"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声再回来，伴奏变密，内声部像暗涌攀爬，低音八度和切分像沉重脉搏；清澈底下的渴望推着身体往前，像情欲、执念和对生命的眷恋一起涌来",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "气味、身体感觉、幻想、遗憾和快感混在一起；明知正被卷进去，却暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到两个人也许能互相依靠，他高兴得有点收不住，心里却忽然一紧。",
       "keys": [
        "互相依靠",
        "高兴得有点收不住"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他盼着以后对方想找人陪时，还会想到自己，自己也能一直陪在身边。",
       "keys": [
        "还会想到自己",
        "一直陪在身边"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "美还在，时间却正在经过；再完美的一刻，也没有办法让它停住",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "上回无意间露了心意，这回见对方仍亲近，他想主动些，大大方方地回应。",
       "keys": [
        "仍亲近",
        "大大方方地回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声像咏叹调般直接舒展，没有防卫，歌句越唱越开，熟悉的摇荡轻轻催着人往前",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "像重新碰到阳光和风，身体恢复弹性，带着一点玩心和调情般的回应",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他开始盼往后的日子，觉得两个人说不定还能这样好很久。",
       "keys": [
        "盼往后的日子",
        "好很久"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可眼下两个人都愿意亲近，以后未必还会这样，他心里没底。",
       "keys": [
        "以后未必还会这样",
        "心里没底"
       ],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他开始怕：哪天对方不再需要他陪，连跟他待着都觉得不自在呢？",
       "keys": [
        "不再需要他陪",
        "都觉得不自在呢"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "前冲的势头忽然收住，熟悉的摇摆退开；76–77小节颤音和轻柔和弦悬在半空，像对视到呼吸都停了，渴望还在，绷紧的劲没有松开",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "明朗像隔了一层薄雾，声音一层层下沉、变暗，光还在，只是柔化了",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他一下安静了，像听着刚才说过的话的余响，心里还在问：那是真的吗？接下来怎么办？",
       "keys": [
        "一下安静了",
        "接下来怎么办"
       ],
       "from": [
        "S09-2",
        "S09-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "激动地说了很多话后，忽然抬头看见夜空；眼前的美好似乎比自己的愿望更大，不安还没答案，却暂时不再占满心思",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "可对方一直没退开，两人眼下仍亲近；也许对方也喜欢他在身边，他有点高兴。",
       "keys": [
        "一直没退开",
        "有点高兴"
       ],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "再猜下去，连今天都过不踏实；他先不管以后，只想好好享受眼前的亲近。",
       "keys": [
        "连今天都过不踏实",
        "享受眼前的亲近"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "紧绷的肩膀终于松开，胸口也打开；心里亮得想笑，也有点想哭，眼泪终于不用憋着。",
       "keys": [
        "肩膀终于松开",
        "眼泪终于不用憋着"
       ],
       "from": [
        "S10-2",
        "S10-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "清风像拨开水波，时间空出一小块地方；身体也失去重量，像灵魂飘在夏夜微风里，重担暂时碰不到自己。这只是一口气，不是能久留的避风处",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想到自己需要对方，对方有时也需要他；即使对方不需要，他仍愿意陪着。",
       "keys": [
        "自己需要对方",
        "仍愿意陪着"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他不再藏着喜欢，甚至顾不上害臊，觉得这么在乎对方没什么不好。",
       "keys": [
        "不再藏着喜欢",
        "没什么不好"
       ],
       "from": [
        "S11-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "灿烂像夕阳沉下前血红金亮的天空，刺眼得让人想流泪，胸口反而被压得发痛",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      },
      {
       "text": "像多年后重新走进旧房子：熟悉的温柔还在，可知道它有多珍贵以后，心里反而更容易发疼",
       "keys": [],
       "from": [
        "S11-B4"
       ],
       "bead": "S11-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可对方以后还愿不愿让他陪，不由他说了算；想到两人未必总能这样亲近，欢喜就压得心口发疼。",
       "keys": [
        "不由他说了算",
        "压得心口发疼"
       ],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他顾不上对方是否也在乎，只想把能给的都给对方，让对方安心。",
       "keys": [
        "把能给的都给对方",
        "让对方安心"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那支温柔晴朗的歌被放大到开阔的尺度，内声部彼此拉扯，一浪高过一浪；像整个人被卷进比自己更大的世界，连「我」都暂时退到后面",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      },
      {
       "text": "狂喜像高烧，也像久别重逢：忽然抱紧对方，久久不愿松手；喉咙发紧，眼眶湿润，快乐到分不清想笑还是想哭",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他明知再用心也不能保证以后仍这么好，还是嫌日子不够，想多陪对方一会儿。",
       "keys": [
        "不能保证以后仍这么好",
        "多陪对方一会儿"
       ],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "那阵高兴终于整个涌出来，他不再收着，只想痛痛快快地喜欢对方。",
       "keys": [
        "高兴终于整个涌出来",
        "痛痛快快地喜欢对方"
       ],
       "from": [
        "S12-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他更想听对方说以后也不变；就算听到了，待在一起时也总觉得时间过得飞快，真能一直这样吗？",
       "keys": [
        "以后也不变",
        "真能一直这样吗"
       ],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "起初怕自己的需要成了负担，如今更怕对方不再需要他，连这样待着都没了。",
       "keys": [
        "成了负担",
        "不再需要他"
       ],
       "from": [
        "S13-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像刚刚坚定地说了一声「是」，心里马上又追问：「可是呢？」这份怀疑没有抹掉先前的幸福，只有真正相信过，才会这么疼",
       "keys": [],
       "from": [
        "S13-B3"
       ],
       "bead": "S13-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "少露些心意，会不会少疼些？可刚才想对对方好是真心的；早已装不回不在乎，真往回藏反而更难受。",
       "keys": [
        "少露些心意",
        "往回藏反而更难受"
       ],
       "from": [
        "S13-2",
        "S13-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S14",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "最初他连喜欢都不敢多露，如今两人仍然亲近；心里又甜又酸，他却不后悔。",
       "keys": [
        "又甜又酸",
        "却不后悔"
       ],
       "from": [
        "S14-1"
       ]
      }
