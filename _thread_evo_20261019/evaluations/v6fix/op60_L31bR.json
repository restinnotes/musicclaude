      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "62–71",
    "relation": "正在面对",
    "items": [
     {
      "id": "S08-1",
      "text": "他想起当时的自己并没有时时担心这份亲密会结束，而是能够自然地生活在其中。",
      "key": "他想起当时的自己",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S02-1"
      ]
     },
     {
      "id": "S08-2",
      "text": "这段具体回忆让他看见当时的自在，却仍不能准确判断自己当时是否充分意识到这份幸福的珍贵。",
      "key": "这段具体回忆让他",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1",
       "S07-1"
      ]
     },
     {
      "id": "S08-3",
      "text": "回想那种自在时，他短暂感到轻快、少防备，但这份明亮很快退去，怀念随之浮现。",
      "key": "回想那种自在时，",
