 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他已经离开那段熟悉的生活，起初总算不用再一次次委屈自己。",
       "keys": [
        "离开那段熟悉的生活",
        "不用再一次次委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像强迫自己挺直背脊：我不能倒下，可其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "尊严还在，行动方向和力气却不稳，刚要站定，心又飘起来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里空落落的，连舍不得什么都说不清。",
       "keys": [
        "笃定没撑多久",
        "舍不得什么都说不清"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "短句像叹息，刚冒头就被长停顿截断，余音散在冷空气里",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "我到底在气谁，又在想谁",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "还分不清是愤怒、遗憾，还是怀念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "像刚从昏沉中醒来，四周冷而空，胸口发紧、视线模糊，伸手只摸到虚空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "想起从前熟悉的日子，他仍想往前过，却不知道以后靠什么让自己安下心。",
       "keys": [
        "仍想往前过",
        "不知道以后靠什么让自己安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前自在的日子，一想到以后不能再那样过，心里就慌。",
       "keys": [
        "舍不得从前自在的日子",
        "心里就慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "舞步不像英雄凯旋：外头像面向众人的庄严，心里只哼得出几句远处旧歌",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "珍惜的东西仿佛还在，却已不能像从前那样拥有",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "腿脚发虚还在挪舞步；节奏庄严傲慢，旋律脆弱凄婉，伴奏里的半音细碎蠕动",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "那份舍不得一上来，他赶紧提醒自己受过的气，怕忘了当初为何离开。",
       "keys": [
        "受过的气",
        "当初为何离开"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像把衣服理整齐、抬起头，不让别人看出动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "反复说“我没事”：第一遍还有几分信，第二遍开始硬劝自己，第三遍连反复说都露出在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "激昂像在喊：我不甘心就这样消亡；这更像硬撑着抵抗",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他还是不甘心：难道不再受那些气，就得连以前的好日子也丢掉？",
       "keys": [
        "还是不甘心",
        "以前的好日子"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他心里还憋着一股气，可想起有人曾把他当作自己人，还是高兴了一小会儿。",
       "keys": [
        "憋着一股气",
        "当作自己人"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "那点高兴还没退，他心里就酸了：从前的日子回不来，离开后就一定更好过吗？",
       "keys": [
        "那点高兴还没退",
        "离开后就一定更好过吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "活动感像暂时侧身离开沉重的问题，出去走走、聊点别的；那一刻的轻松是真的，却没替心事找到答案",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "昂扬慢慢退潮，心里忍不住问：刚才是真的相信，还是只在努力让自己相信",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他一度真盼着还能那样相处。",
       "keys": [
        "从前亲近的日子",
        "还能那样相处"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧主题像在独自说话，亲密、感激、柔情和短暂幸福一下鲜活起来",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "外面的步伐还向前，心里却有了更多回声，也更容易受伤",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "这份坚定也许只是他努力想成为的样子",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可那份亲近越鲜活，当初的委屈也跟着翻上来。",
       "keys": [
        "亲近越鲜活",
        "委屈也跟着翻上来"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "那一步走对了吗、后悔吗？若没走，如今又会怎样？",
       "keys": [
        "那一步走对了吗",
        "若没走"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他仍不服气，觉得当初那些气不该忍；可连过去开心的事都不敢多想，实在太为难自己。",
       "keys": [
        "那些气不该忍",
        "开心的事都不敢多想"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两只手像夜色里两个影子，柔和而克制地低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "柔和的歌唱仍被压力推着走，像在说：这件事不能就这样算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "委屈和火气都在，还想替自己争口气",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "旧日记忆重新有了温度，可能是某个人，也可能是故乡或过去的生活；眷恋里仍带着失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争到没力气，那股不服气也渐渐淡了。",
       "keys": [
        "争到没力气",
        "不服气也渐渐淡了"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "想到如今已不在那些人身边，他只觉得难受。",
       "keys": [
        "不在那些人身边",
        "只觉得难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "难受慢慢缓下来，他又想起从前不必时时防备的日子，这回没拿受过的气压住想念。",
       "keys": [
        "不必时时防备",
        "没拿受过的气压住想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像隔着透明玻璃罩，连呼吸都不愿惊动；又像母亲在耳边轻哼摇篮曲",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "温柔让人暂时松开戒备；这份安宁不代表现实变好，也不是能永远停留的地方",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "圣咏般庄严里藏着秘密念头，终于不用解释难过，也不用维持坚强",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "压住的愿望、委屈和思念浮上来，像向遥远而不确定的对象祈求，却没有回应的保证",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "离开后遇上难熬的事，他常得独自挺过去，才知道有人在身边有多轻松。",
       "keys": [
        "独自挺过去",
        "有人在身边有多轻松"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他很想再过上不用多说就知道彼此亲近的日子，又怕以后再也没有。",
       "keys": [
        "不用多说就知道彼此亲近",
        "怕以后再也没有"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "那样的日子他毕竟真真切切过过，光是想起来，心里也暖和了一点。",
       "keys": [
        "真真切切过过",
        "心里也暖和了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "放轻声音，好好看着珍惜的东西；明知挽不回，也不必立刻把它抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，他猛然想到：以后遇上难事若还得一个人顶，他真撑得住吗？",
       "keys": [
        "猛然想到",
        "他真撑得住吗"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "马祖卡色彩的舞步突然闯入，截断祈祷般的静谧，像换了一个场景；波兰舞曲气息也再次浮现，却不再完整鲜明地建立秩序。突转不等于心情好转",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "当初只想着别再受气，没料到会这么孤单；早知道这样，还会走吗？",
       "keys": [
        "没料到会这么孤单",
        "早知道这样，还会走吗"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的动作、一次舞蹈或习以为常的生活忽然闯进来；越亲切具体，越看清自己失去了什么",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      },
      {
       "text": "连续颤音让紧张一层层堆高，思绪翻转停不下来；身体还不信事情已经过去，心里想冲出去却找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想找回从前的亲近，又不甘心回去再受那些气，连当初离开的决心也找不着了。",
       "keys": [
        "想找回从前的亲近",
        "连当初离开的决心也找不着了"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他先把回去的事放一边，想起曾被当作自己人，心里暖了一会儿，却没想回头。",
       "keys": [
        "把回去的事放一边",
        "没想回头"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "缓慢、宽广的歌唱短暂回来，像熟悉的柔软处重新打开，带着沉思和近乎祈求的气息",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "安静停得太短，像准备离开的人最后回头看一眼；那一眼里有温柔，也有不舍",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      },
      {
       "text": "激烈思绪间忽然吸进一口气，胸口松开一瞬；只是短暂喘息，还没真正安顿下来",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "那点暖意很快淡了；想到以后遇上难事，回忆没法陪他，心又悬起来。",
       "keys": [
        "暖意很快淡了",
        "回忆没法陪他"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他忽然说不清，想回去是舍不得被当作自己人的日子，还是怕孤单到连那些气也肯再受。",
       "keys": [
        "舍不得被当作自己人的日子",
        "连那些气也肯再受"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "双手铺开巨大的颤音光晕，开头沉重的引子从中阴冷闪现；声音短暂落稳，又向高处漂去，像从另一面重新看见同一扇门，前进的步子还没聚起来",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "像重新遇见那个不知道怎么办的自己；这一次，已经知道他经历过什么，最初的问题又浮上来，却仍没有简单答案",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "这念头让他一阵心慌，连往下想都不敢了。",
       "keys": [
        "一阵心慌",
        "连往下想都不敢了"
       ],
       "from": [
        "S09-2"
       ]
