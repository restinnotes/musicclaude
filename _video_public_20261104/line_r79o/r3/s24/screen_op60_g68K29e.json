     "bars": "69-71",
     "from": [
      "S08-B3"
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "rows": [
    {
     "kind": "line",
     "text": "那点没底越来越具体：要是哪天对方不再需要他陪，连和他待着都不自在了呢？",
     "keys": [
      "不再需要他陪"
     ],
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "kind": "line",
     "text": "他一下安静了，刚才还敢盼那么远，现在却不敢再往下想",
     "keys": [
      "不敢再往下想"
     ],
     "emotion": "悬着",
     "from": [
      "S09-2"
     ],
     "at": 5.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像话到要紧处顿住，两人对视到呼吸都停了，渴望仍绷着",
