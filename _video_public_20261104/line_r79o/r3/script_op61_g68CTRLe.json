       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他把今后能求助的办法列好，没再把沉默当成自己的过错",
