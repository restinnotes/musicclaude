     "bars": "32-34",
     "from": [
      "S04-B2"
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "rows": [
    {
     "kind": "line",
     "text": "他还在体会这份亲近，原本熟悉的安稳却忽然松动，心里一下没了着落",
