       "S05-1",
       "S05-2",
       "S02-2"
      ]
     },
     {
      "id": "S06-2",
      "text": "至少他确定，自己确实感受过被接纳、被理解和满足；这份确认让他稍稍安定，心里却仍会被未能还原的部分牵动。",
      "key": "至少他确定，自己",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1",
       "S02-1"
      ]
     }
    ],
    "because": [
     {
