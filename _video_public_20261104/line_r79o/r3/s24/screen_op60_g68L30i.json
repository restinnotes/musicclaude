        "S04-3",
        "S04-B3"
       ],
       "bars": "24-34",
       "at": 28.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "熟悉的歌声更迫切，细密花腔像水面光斑晃眼",
