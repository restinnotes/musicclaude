{"completed": true, "response": "<escape>{\n  \"blocks\": [\n    {\"id\":\"S01-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S01-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S01-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-1-1\",\"a\":\"偏了\",\"b\":\"对上\",\"lost\":\"甲把轻轻呼气、回到柔和理解成主动收住靠近冲动；原稿没有这个克制动机。\"},\n    {\"id\":\"S02-2-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-2-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-0-0\",\"a\":\"偏了\",\"b\":\"对上\",\"lost\":\"甲加入了亲近关系和不想未来的意思；原稿重点是身体随水波摇晃、漂浮，暂时没有目的地。\"},\n    {\"id\":\"S03-1-0\",\"a\":\"偏了\",\"b\":\"对上\",\"lost\":\"甲把急切表达具体成向对方告白；原稿只写短促急切的声音，没有限定表达的是喜欢。\"},\n    {\"id\":\"S03-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S04-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S04-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S04-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S04-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S04-2-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S05-0-0\",\"a\":\"偏了\",\"b\":\"对上\",\"lost\":\"甲把攥紧不放的冲动误作不敢表露喜欢；乙抓住了那股紧绷、克制的劲逐渐退去。\"},\n    {\"id\":\"S05-1-0\",\"a\":\"偏了\",\"b\":\"对上\",\"lost\":\"甲把脚下失去支撑的失重感转成面对对方时缺乏底气；原稿强调突然失去支撑、时间感松开。\"},\n    {\"id\":\"S05-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S05-1-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S06-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S06-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S06-1-0\",\"a\":\"偏了\",\"b\":\"对上\",\"lost\":\"甲把无法被陪伴、理解的内在孤独具体成没人知道自己的恐惧；乙抓住了内心无法被完全理解的孤独感。\"},\n    {\"id\":\"S06-2-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S07-0-0\",\"a\":\"偏了\",\"b\":\"偏了\",\"lost\":\"两人都把音乐中沉重、催促的脉搏感归因于对方需要自己；原稿没有这个关系判断，重点是暗涌和脉搏般的催促感。\"},\n    {\"id\":\"S07-0-1\",\"a\":\"偏了\",\"b\":\"偏了\",\"lost\":\"两人都把原稿未具体说明的深层渴望限定为陪伴对方、希望被需要；原稿只表达渴望变强并推动人向前。\"},\n    {\"id\":\"S07-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S07-2-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S08-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S08-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S08-0-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S08-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S09-0-0\",\"a\":\"偏了\",\"b\":\"对上\",\"lost\":\"甲把尚未释放的渴望和紧绷感解释成害怕失去；原稿重点是渴望仍在，却被压住、没有释放。\"},\n    {\"id\":\"S09-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S09-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S10-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S10-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S10-0-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S11-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S11-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S11-1-0\",\"a\":\"偏了\",\"b\":\"偏了\",\"lost\":\"两人都把胸口压迫疼痛具体归因于害怕失去对方；原稿只呈现胸口被压迫的沉重和疼痛，没有交代这一原因。\"},\n    {\"id\":\"S12-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S12-0-1\",\"a\":\"偏了\",\"b\":\"偏了\",\"lost\":\"两人都把被更大世界卷入、暂时忘我的状态缩窄成只顾对对方好；原稿强调的是自我暂时退居后面，而非单纯付出或忽略自身安危。\"},\n    {\"id\":\"S12-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S12-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S12-2-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S13-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S13-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S13-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S13-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S13-1-2\",\"a\":\"对上\",\"b\"