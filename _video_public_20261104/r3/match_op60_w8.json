   "lost": ""
  },
  {
   "id": "S07-0-2",
   "a": "偏了",
   "b": "偏了",
   "lost": "两人都说到了情欲和执念，却遗漏了对生命本身的眷恋也是一同翻涌的力量。"
  },
  {
   "id": "S07-1-0",
   "a": "对上",
   "b": "对上",
   "lost": ""
