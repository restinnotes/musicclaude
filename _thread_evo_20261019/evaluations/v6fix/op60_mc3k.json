     },
     {
      "from": "S05-1",
      "to": "S07-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "62–71",
    "relation": "还说不清",
    "items": [
     {
      "id": "S08-1",
      "text": "他们真的更亲近了，他只顾享受从未有过的满足。",
      "key": "他们真的更亲近了",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1"
      ]
     },
     {
      "id": "S08-2",
      "text": "欢喜稍稍平缓，他心里却空落落的，舍不得那份充盈过去。",
      "key": "欢喜稍稍平缓，他",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S08-3",
      "text": "他还觉得不够，有点委屈和羞愧，却说不清究竟缺什么。",
      "key": "他还觉得不够，有",
      "follows": false,
      "explains": [],
      "cite": []
     }
    ],
    "because": [
     {
      "from": "S07-1",
      "to": "S08-1",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "72–77",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "满足过仍难受，更多温柔也不够。",
      "key": "满足过仍难受，更",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1"
      ]
     },
     {
      "id": "S09-2",
      "text": "他想幸福时不惦记它会过去，却留不住最好的时候。",
      "key": "他想幸福时不惦记",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-2"
      ]
     },
     {
      "id": "S09-3",
      "text": "彼此再珍惜也留不住，他无措又怪不了谁。",
      "key": "彼此再珍惜也留不",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S09-4",
      "text": "好得难以置信，他暂忘了不安。",
      "key": "好得难以置信，他",
      "follows": false,
      "explains": [],
      "cite": []
     }
    ],
    "because": [
     {
      "from": "S08-1",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S08-2",
      "to": "S09-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "78–83",
    "relation": "正在面对",
    "items": [
     {
      "id": "S10-1",
      "text": "怪不了对方，他更疼惜，不让对方担他的不安。",
      "key": "怪不了对方，他更",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-3"
      ]
     },
     {
      "id": "S10-2",
      "text": "他珍惜不施压的自在，不用依恋束缚对方。",
      "key": "他珍惜不施压的自",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-2"
      ]
     },
     {
      "id": "S10-3",
      "text": "亲近仍让他欢喜。心酸时他也喜欢自己这样爱。",
      "key": "亲近仍让他欢喜。",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S10-4",
      "text": "他不再压着泪意，身心忽然轻快得不像平时。",
      "key": "他不再压着泪意，",
      "follows": false,
      "explains": [],
      "cite": []
     }
    ],
    "because": [
     {
