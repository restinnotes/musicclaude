 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他已经离开了那段熟悉的生活",
       "detail": "起初，他觉得终于不用再一次次委屈自己。",
       "keys": [],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "挺直背脊 不能倒下",
       "keys": [],
       "from": [
        "S01-B1-p1"
       ]
      },
      {
       "text": "很想停下来",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ]
      },
      {
       "text": "找不到方向",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ]
      },
      {
       "text": "内心游移",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他还说不清，自己究竟舍不得什么",
       "detail": "离开时的笃定没能维持多久。",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "生气还是想念？",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "伸手只摸到虚空",
       "keys": [],
       "from": [
        "S01-B4-p2"
       ]
      },
      {
       "text": "停顿里等回声",
       "keys": [],
       "from": [
        "S01-B2-p2"
       ]
      },
      {
       "text": "胸口发紧",
       "keys": [],
       "from": [
        "S01-B4-p1"
       ]
      },
      {
       "text": "遗憾",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "尚未找到对象和语言的失落",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "恍惚",
       "keys": [],
       "from": [
        "S01-B4-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他还想往前过，却不知道以后怎样才能安心",
       "detail": "",
       "keys": [],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "记得清楚却回不去",
       "keys": [],
       "from": [
        "S01-B5-p2"
       ]
      },
      {
       "text": "身体先记起迈步",
       "keys": [],
       "from": [
        "S01-B5-p3"
       ]
      },
      {
       "text": "旧场景忽然回来",
       "keys": [],
       "from": [
        "S01-B5-p1"
       ]
      },
      {
       "text": "当时的声音和光线",
       "keys": [],
       "from": [
        "S01-B5-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他舍不得从前自在的日子",
       "detail": "一想到以后不能再那样生活，他就有些慌。",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "记得却不能再拥有",
       "keys": [],
       "from": [
        "S02-B1-p4"
       ]
      },
      {
       "text": "腿脚虚浮",
       "keys": [],
       "from": [
        "S02-B2-p1"
       ]
      },
      {
       "text": "远处旧歌 只哼几句",
       "keys": [],
       "from": [
        "S02-B1-p2"
       ]
      },
      {
       "text": "呼吸越来越急",
       "keys": [],
       "from": [
        "S02-B3-p3"
       ]
      },
      {
       "text": "最后还是没落稳",
       "keys": [],
       "from": [
        "S02-B3-p2"
       ]
      },
      {
       "text": "面向众人的庄严",
       "keys": [],
       "from": [
        "S02-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他提醒自己，当初离开是因为受够了委屈",
       "detail": "他怕一心软，就忘了为什么要走。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "越说没事越在意",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "整理衣服 抬起头",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      },
      {
       "text": "不让人看出动摇",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      },
      {
       "text": "第一次还信自己没事",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "第二次努力相信",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "不肯把自己交给悲伤",
       "keys": [],
       "from": [
        "S02-B4-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他不甘心把过去的好日子也一并舍弃",
       "detail": "不再受那些气，难道就只能连从前的快乐也丢掉吗？",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "还不肯认输",
       "keys": [],
       "from": [
        "S02-B5-p1"
       ]
      },
      {
       "text": "这股劲还在",
       "keys": [],
       "from": [
        "S02-B5-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "想起曾被当作自己人，他还是会短暂地高兴",
