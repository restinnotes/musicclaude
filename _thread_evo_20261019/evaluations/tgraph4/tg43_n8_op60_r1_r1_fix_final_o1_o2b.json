   ],
   "items_before_fix": [
    {
     "id": "I52",
     "text": "不再强迫自己消除渴望后，他重新感到亲近一个人的快乐。",
     "key": "重新感到亲近快乐",
     "kind": ""
    },
    {
     "id": "I53",
     "text": "他尝过期待的紧张、无从确认的难堪，也知道深情不能替对方作答，却仍愿意喜欢。",
     "key": "知道深情不能代答",
     "kind": "",
     "follows": true
    },
    {
     "id": "I54",
     "text": "他不必再用无所求证明体贴，也不因偶尔想被珍惜就怀疑感情的真诚。",
     "key": "想被珍惜不损真诚",
     "kind": "分清",
     "follows": true
    },
    {
     "id": "I55",
     "text": "他不再躲避感情的深度，也不为热切羞怯，并因犹疑后仍能高兴而感动。",
     "key": "不再为热切羞怯",
     "kind": "",
     "follows": true
    },
    {
     "id": "I56",
     "text": "过去让他警惕的愿望，如今都可以与喜欢一同存在。",
     "key": "警惕的愿望也能共存",
     "kind": "",
     "follows": true
    },
    {
     "id": "I57",
     "text": "他知道自己仍可能受伤，心里并未变得无忧无虑，仍愿充分承认幸福。",
     "key": "知晓会伤仍承认幸福",
     "kind": "",
     "follows": true
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对",
   "items_before_reorg": [
    {
     "id": "N55",
     "text": "不再逼自己消除渴望后，他又尝到最初亲近一个人的快乐。",
     "from": [
      "I52"
     ],
     "key": "",
     "kind": "",
     "follows": false
    },
    {
     "id": "N56",
     "text": "这一次，他尝过期待的紧张和求证的难堪，也知道再深的喜欢替不了对方作决定，却仍愿意喜欢。",
     "from": [
      "I53"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N57",
     "text": "于是无需再用无所求证明体贴，也不必因想被珍惜就怀疑真心。",
     "from": [
      "I54"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N58",
     "text": "他不再躲着这份感情，也不为自己的热切害羞；犹疑了这么久仍能高兴，让他感动。",
     "from": [
      "I55"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N59",
     "text": "从前让他警惕的愿望，如今也能和喜欢一起存在。",
     "from": [
      "I56"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N60",
     "text": "他并未变得无忧无虑，只是知道可能受伤，仍愿把幸福充分认下来。",
     "from": [
      "I57"
     ],
     "key": "",
     "kind": "",
     "follows": true
    }
   ]
  },
  {
   "bars": "93–102",
   "relation": "没在想",
   "items": [
    {
     "id": "R56",
     "text": "渴望不再遮掩后，他反而更清楚：自己有多想亲近这个人。",
     "from": [
      "N61"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "R57",
     "text": "他想把攒下的温柔都交给对方，也想让亲密不只停在自己的愿望里。",
     "from": [
      "N62"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "R58",
     "text": "他想被同样深切地珍惜，也想知道两人共同拥有的幸福能有多丰盛。",
     "from": [
      "N63"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "R59",
     "text": "这些愿望曾令他紧张、难堪，如今仍在，却暂时不再像缺憾那样折磨他。",
     "from": [
      "N64"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "R60",
     "text": "此刻他觉得自己有许多爱可给、许多感情值得珍惜，仿佛再没什么需要增加。",
     "from": [
      "N65"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "R61",
     "text": "想靠近、想被爱、想把自己全交给这份亲近，满足几乎满得让他招架不住；对方却没给新保证。",
     "from": [
      "N66"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "R62",
     "text": "他顾不上以后，只想让这一刻的幸福完整地停留。",
     "from": [
      "N67"
     ],
     "key": "",
     "kind": "",
     "follows": true
    }
   ],
   "because": [
    {
     "from": "R54",
     "to": "R56",
     "rel": "提供理由",
     "audit": "支持",
     "old": [
      "N59",
      "N61"
     ]
    }
   ],
   "items_before_fix": [
    {
     "id": "I58",
     "text": "他不再遮掩渴望后，更清楚地感到自己多么想亲近这个人。",
     "key": "更清楚想要亲近",
     "kind": ""
    },
    {
     "id": "I59",
     "text": "他想把积攒的温柔都给对方，也想让珍贵的亲密不只停在自己的愿望里。",
     "key": "想把积攒温柔给出",
     "kind": "",
     "follows": true
    },
    {
     "id": "I60",
     "text": "他想被同样深切地珍惜，也想知道两人共同的幸福能有多丰盛。",
     "key": "想被同样深切珍惜",
     "kind": "",
     "follows": true
    },
    {
     "id": "I61",
     "text": "这些愿望曾让他紧张、难堪并不得不克制，如今仍在，却暂时不再折磨他。",
     "key": "愿望暂时不再折磨",
     "kind": "",
     "follows": true
    },
    {
     "id": "I62",
     "text": "他觉得自己有许多感情可以给予，也有许多值得珍惜的东西，仿佛无需再增加什么。",
     "key": "觉得已有许多可珍惜",
     "kind": "",
     "follows": true
    },
    {
     "id": "I63",
     "text": "那一刻，他仿佛觉得所有心愿都已得到抒发，尽管没有任何新的保证。",
     "key": "仿佛心愿同时抒发",
     "kind": "",
     "follows": true
    },
    {
     "id": "I64",
     "text": "他一时顾不上以后会怎样，只愿让这份幸福完整地留在此刻。",
     "key": "只愿幸福留在此刻",
     "kind": "",
     "follows": true
    }
   ],
   "relation_votes": {
