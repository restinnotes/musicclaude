{
 "uniform": true,
 "sections": [
  {
   "sec": "S01",
   "rows": [
    {
     "kind": "line",
     "text": "他离开了熟悉的生活",
     "keys": [
      "离开"
     ],
     "emotion": "炽热",
     "from": [
      "S01-1"
     ]
    },
    {
     "kind": "line",
     "text": "起初觉得终于不用委屈自己",
     "keys": [
      "不用委屈自己"
     ],
     "emotion": "安心",
     "from": [
      "S01-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "我不能倒下，可我很想停下来",
       "bead": "S01-B2",
       "from": [
        "S01-B2"
       ],
       "bars": "1–23"
      }
     ]
    },
    {
     "kind": "line",
     "text": "心里空落落说不清舍不得什么",
     "keys": [
      "空落落"
     ],
     "emotion": "孤单",
     "from": [
      "S01-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "分不清是愤怒遗憾还是怀念",
       "bead": "S01-B3",
       "from": [
        "S01-B3"
       ],
       "bars": "1–23"
      },
      {
       "text": "像刚醒来，四周冷空，胸口发紧",
       "bead": "S01-B4",
       "from": [
        "S01-B4"
       ],
       "bars": "1–23"
      },
      {
       "text": "视线模糊，手发抖，伸出去只摸到虚空",
       "bead": "S01-B4",
       "from": [
        "S01-B4"
       ],
       "bars": "1–23"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他想往前走却不知怎样安心",
     "keys": [
      "不知怎样安心"
     ],
     "emotion": "悬着",
     "from": [
      "S01-3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "身体先于意识记起怎么迈步",
       "bead": "S01-B5",
       "from": [
        "S01-B5"
       ],
       "bars": "18–23"
      }
     ]
    },
    {
     "kind": "line",
     "text": "旧日的声音和光线又回来了",
     "keys": [
      "又回来了"
     ],
     "emotion": "亲密",
     "from": [
      "S01-3",
      "S01-B5"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "记忆清楚，过去却回不到现在",
       "bead": "S01-B5",
       "from": [
        "S01-B5"
       ],
       "bars": "9–17"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "重和弦后琶音像烟雾向上散",
     "bars": "1–6",
     "from": [
      "S01-B1"
     ]
    },
    {
     "text": "开头的停顿像在等待回声",
     "bars": "1–6",
     "from": [
      "S01-B1"
     ]
    },
    {
     "text": "短句刚起便被长停顿截断",
     "bars": "1–23",
     "from": [
      "S01-B3"
     ]
    },
    {
     "text": "旧日旋律的轮廓渐渐清楚",
     "bars": "9–17",
     "from": [
      "S01-B5"
     ]
    },
    {
     "text": "波兰舞曲的步态逐渐浮现",
     "bars": "18–23",
     "from": [
      "S01-B5"
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "rows": [
    {
     "kind": "line",
     "text": "他舍不得从前自在的日子",
     "keys": [
      "舍不得"
     ],
     "emotion": "亲密",
     "from": [
      "S02-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像远处传来的旧歌，只能模糊哼几句",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24–65"
      },
      {
       "text": "珍惜的东西仿佛还在，却不能照旧拥有",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24–65"
      },
      {
       "text": "像腿脚虚浮地在记忆里挪舞步",
       "bead": "S02-B2",
       "from": [
        "S02-B2"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想到以后不能那样过就心慌",
     "keys": [
      "心慌"
     ],
     "emotion": "不安",
     "from": [
      "S02-1"
     ]
    },
    {
     "kind": "line",
     "text": "他赶紧想起受过的那些气",
     "keys": [
      "受过的那些气"
     ],
     "emotion": "炽热",
     "from": [
      "S02-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "整理好衣服抬起头，不让人看出动摇",
       "bead": "S02-B4",
       "from": [
        "S02-B4"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他怕一心软就忘了为何离开",
     "keys": [
      "为何离开"
     ],
     "emotion": "不安",
     "from": [
      "S02-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "一遍遍说我没事，反倒显出还很在意",
       "bead": "S02-B4",
       "from": [
        "S02-B4"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他不甘心连好日子也要丢掉",
     "keys": [
      "不甘心"
     ],
     "emotion": "炽热",
     "from": [
      "S02-3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "心里像在说：我不甘心就这样消亡",
       "bead": "S02-B5",
       "from": [
        "S02-B5"
       ],
       "bars": "44–65"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "舞步庄严，旋律却脆弱凄婉",
     "bars": "24–65",
     "from": [
      "S02-B1",
      "S02-B2"
     ]
    },
    {
     "text": "伴奏里细碎半音不安地蠕动",
     "bars": "24–65",
     "from": [
      "S02-B2"
     ]
    },
    {
     "text": "音乐猛地上推又退回",
     "bars": "38–43",
     "from": [
      "S02-B3"
     ]
    },
    {
     "text": "力量再次聚拢，后段更焦灼",
     "bars": "44–65",
     "from": [
      "S02-B3"
     ]
    },
    {
     "text": "连绵三连音催得呼吸急促",
     "bars": "56–65",
     "from": [
      "S02-B3"
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "rows": [
    {
     "kind": "line",
     "text": "他心里还憋着一股气",
     "keys": [
      "憋着一股气"
     ],
     "emotion": "炽热",
     "from": [
      "S03-1"
     ]
    },
    {
     "kind": "line",
     "text": "想起曾被当作自己人",
     "keys": [
      "自己人"
     ],
     "emotion": "亲密",
     "from": [
      "S03-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "那时自在亲近，不必时时防备",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "80–91"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他竟又高兴了一小会儿",
     "keys": [
      "高兴"
     ],
     "emotion": "欢喜",
     "from": [
      "S03-1",
      "S03-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像暂时出去走走，轻松是真的却没答案",
       "bead": "S03-B3",
       "from": [
        "S03-B3"
       ],
       "bars": "66–91"
      }
     ]
    },
    {
     "kind": "line",
     "text": "那份温柔让他心颤又遥远",
     "keys": [
      "心颤"
     ],
     "emotion": "孤单",
     "from": [
      "S03-2",
      "S03-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像故乡夏日的麦浪和微风",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "80–91"
      },
      {
       "text": "耳边像几个人低声絮语，彼此缠绕",
       "bead": "S03-B4",
       "from": [
        "S03-B4"
       ],
       "bars": "66–91"
      },
      {
       "text": "脚下像流沙，怎么也抓不住重心",
       "bead": "S03-B4",
       "from": [
        "S03-B4"
       ],
       "bars": "66–91"
      }
     ]
    },
    {
     "kind": "line",
     "text": "离开以后真的会更好吗？",
     "keys": [
      "更好吗"
     ],
     "emotion": "悬着",
     "from": [
      "S03-2",
      "S03-B5"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "我刚才真信了吗，还是在努力说服自己？",
       "bead": "S03-B5",
       "from": [
        "S03-B5"
       ],
       "bars": "66–91"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "开头和弦若突出，会像重锤砸下",
     "bars": "66",
     "from": [
      "S03-B1"
     ]
    },
    {
     "text": "忽强忽弱和切分让步态不安",
     "bars": "66–91",
     "from": [
      "S03-B1"
     ]
    },
    {
     "text": "前半急切，后半转为柔和轻盈",
     "bars": "66–91",
     "from": [
      "S03-B2"
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "rows": [
    {
     "kind": "line",
     "text": "他真盼着还能像从前那样亲近",
     "keys": [
      "真盼着"
     ],
     "emotion": "亲密",
     "from": [
      "S04-1",
      "S04-B1"
     ]
    },
    {
     "kind": "line",
     "text": "亲近一鲜活委屈就翻上来",
     "keys": [
      "委屈就翻上来"
     ],
     "emotion": "不安",
     "from": [
      "S04-2",
      "S04-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "过去太好，回不来才更刺痛",
       "bead": "S04-B2",
       "from": [
        "S04-B2"
       ],
       "bars": "92–115"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他反复问当初离开对不对",
     "keys": [
      "对不对"
     ],
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "如果当时……是不是还能不一样？",
       "bead": "S04-B4",
       "from": [
        "S04-B4"
       ],
       "bars": "94–115"
      },
      {
       "text": "究竟为什么会变成这样？",
       "bead": "S04-B4",
       "from": [
        "S04-B4"
       ],
       "bars": "94–115"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他忍不住想没走的话会怎样",
     "keys": [
      "会怎样"
     ],
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ]
    },
    {
     "kind": "line",
     "text": "他脑子里停不下这些追问",
     "keys": [
      "停不下"
     ],
     "emotion": "不安",
     "from": [
      "S04-2",
      "S04-B4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像被时间催着跑，身体也停不下来",
       "bead": "S04-B3",
       "from": [
        "S04-B3"
       ],
       "bars": "92–115"
      },
      {
       "text": "他不停往前赶，只为不必停下来",
       "bead": "S04-B4",
       "from": [
        "S04-B4"
       ],
       "bars": "94–115"
      },
      {
       "text": "思绪盘旋着，始终抵达不了答案",
       "bead": "S04-B4",
       "from": [
        "S04-B4"
       ],
       "bars": "94–115"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "熟悉主题回来，伴奏更流动抒情",
     "bars": "92–107",
     "from": [
      "S04-B1"
     ]
    },
    {
     "text": "装饰音让旋律像独自说话",
     "bars": "92–107",
     "from": [
      "S04-B1"
     ]
    },
    {
     "text": "温暖忽然转成风暴般的紧绷",
     "bars": "108–115",
     "from": [
      "S04-B2"
     ]
    },
    {
     "text": "半音阶下行带着声音步步后退",
     "bars": "108–115",
     "from": [
      "S04-B2"
     ]
    },
    {
     "text": "细碎音符急促，低音不断追赶",
     "bars": "92–115",
     "from": [
      "S04-B3"
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "rows": [
    {
     "kind": "line",
     "text": "他仍觉得当初那些气不该忍",
     "keys": [
      "不该忍"
     ],
     "emotion": "炽热",
     "from": [
      "S05-1",
      "S05-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "心里像在说：这件事不能就这样算了",
       "bead": "S05-B2",
       "from": [
        "S05-B2"
       ],
       "bars": "116–127"
      },
      {
       "text": "那股劲里有愤怒悲伤，也想护住自己",
       "bead": "S05-B2",
       "from": [
        "S05-B2"
       ],
       "bars": "116–127"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他也不想连开心回忆都不敢想",
     "keys": [
      "开心回忆"
     ],
     "emotion": "亲密",
     "from": [
      "S05-1",
      "S05-B3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "两只手像夜色里两个影子低声说话",
       "bead": "S05-B1",
       "from": [
        "S05-B1"
       ],
       "bars": "116–147"
      },
      {
       "text": "可能是某个人，也可能是故乡或旧生活",
       "bead": "S05-B3",
       "from": [
        "S05-B3"
       ],
       "bars": "116–147"
      },
      {
       "text": "记忆重新有了温度，眷恋里仍有失落",
       "bead": "S05-B3",
       "from": [
        "S05-B3"
       ],
       "bars": "116–147"
      }
     ]
    },
    {
     "kind": "line",
     "text": "跟自己争得渐渐没了力气",
     "keys": [
      "没了力气"
     ],
     "emotion": "孤单",
     "from": [
      "S05-2",
      "S05-B5"
     ]
    },
    {
     "kind": "line",
     "text": "那股不服气慢慢淡了下去",
     "keys": [
      "慢慢淡了"
     ],
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像深深叹口气，抵抗累了却未想通",
       "bead": "S05-B5",
       "from": [
        "S05-B5"
       ],
       "bars": "144–147"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想到已不在他们身边他很难受",
     "keys": [
      "很难受"
     ],
     "emotion": "孤单",
     "from": [
      "S05-2",
      "S05-B3"
     ]
    }
   ],
   "notes": [
    {
     "text": "歌唱忽然柔和，语气亲近克制",
     "bars": "116–147",
     "from": [
      "S05-B1"
     ]
    },
    {
     "text": "柔和旋律里仍有向前的压力",
     "bars": "116–127",
     "from": [
      "S05-B2"
     ]
    },
    {
     "text": "快速音型逐渐变稀，最后只剩疏和弦",
     "bars": "128–147",
     "from": [
      "S05-B4"
     ]
    },
    {
     "text": "旋律几乎单独露出来",
     "bars": "128–129、139–144",
     "from": [
      "S05-B4"
     ]
    },
    {
     "text": "躁动加深，最后像几次深呼吸",
     "bars": "132–147",
     "from": [
      "S05-B5"
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "rows": [
    {
     "kind": "line",
     "text": "他心里的难受慢慢缓了下来",
     "keys": [
      "慢慢缓了下来"
     ],
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像隔着透明玻璃罩，连呼吸都放轻",
       "bead": "S06-B1",
       "from": [
        "S06-B1"
       ],
       "bars": "148–180"
      },
      {
       "text": "又像母亲在耳边轻轻哼着摇篮曲",
       "bead": "S06-B1",
       "from": [
        "S06-B1"
       ],
       "bars": "148–180"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他想起从前不必时时防备",
     "keys": [
      "不必时时防备"
     ],
     "emotion": "亲密",
     "from": [
      "S06-1",
      "S06-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "终于不用解释难过，也不用装坚强",
       "bead": "S06-B2",
       "from": [
        "S06-B2"
       ],
       "bars": "148–180"
      }
     ]
    },
    {
     "kind": "line",
     "text": "如今才知有人相伴多轻松",
     "keys": [
      "多轻松"
     ],
     "emotion": "安心",
     "from": [
      "S06-2",
      "S06-B2"
     ]
    },
    {
     "kind": "line",
     "text": "他想再亲近又怕以后再没有",
     "keys": [
      "怕以后再没有"
     ],
     "emotion": "悬着",
     "from": [
      "S06-3",
      "S06-B3"
     ]
    },
    {
     "kind": "line",
     "text": "想起真切拥有过心里暖了一点",
     "keys": [
      "暖了一点"
     ],
     "emotion": "安心",
     "from": [
      "S06-4",
      "S06-B4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像向遥远的人祈求，不知会不会回应",
