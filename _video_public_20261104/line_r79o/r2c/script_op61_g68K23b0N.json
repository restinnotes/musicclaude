       "from": [
        "S12-1",
        "S12-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "雷鸣般的舞步终于落地，像一个人站出来，也像一群人抬头",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      }
     ]
    }
   ]
  },
  {
