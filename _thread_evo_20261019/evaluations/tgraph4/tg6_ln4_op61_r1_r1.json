  {
   "bars": "206–213",
   "relation": "正在面对",
   "items": [
    {
     "id": "I77",
     "text": "他一时几乎顾不上先前的骄傲。",
     "key": "顾不上",
     "kind": ""
    },
    {
     "id": "I78",
     "text": "他急切地想重新感到亲近。",
     "key": "重新感到亲近",
     "kind": ""
    },
    {
     "id": "I79",
     "text": "他觉得哪怕一点真实回应也足以令他心软。",
     "key": "一点真实回应",
     "kind": ""
    },
    {
     "id": "I80",
     "text": "一想到可能再受委屈，他又感到痛苦。",
     "key": "可能再受委屈",
     "kind": ""
    },
    {
     "id": "I81",
     "text": "他更受不了靠卑微换回旧日的亲近。",
     "key": "靠卑微换回",
     "kind": ""
    },
    {
     "id": "I82",
     "text": "他想靠近的急切使抗拒更痛。",
     "key": "抗拒更痛",
     "kind": ""
    }
   ],
