<script>

(function() {
  // 配置项
  const TOKEN_KEY = 'visit_token'; // 存储token的key
  const PAGE_COUNT_KEY = 'open_page_count'; // 打开页面数的key

  // 1. 生成唯一token（没有就生成）
  function generateToken() {
    // 简单UUID生成，也可以用后端返回的真实token
    const token = 'visit_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
    localStorage.setItem(TOKEN_KEY, token);
    return token;
  }

  // 2. 获取当前token
  function getToken() {
    return localStorage.getItem(TOKEN_KEY);
  }

  // 3. 初始化页面计数
  function initPageCount() {
    // sessionStorage 仅当前标签页有效
    let count = sessionStorage.getItem(PAGE_COUNT_KEY);
    
    if (!count) {
      // 新打开的标签页：页面数+1
      let currentCount = Number(localStorage.getItem(PAGE_COUNT_KEY) || 0);
      currentCount++;
      
      localStorage.setItem(PAGE_COUNT_KEY, currentCount);
      sessionStorage.setItem(PAGE_COUNT_KEY, '1');
    }
  }

  // 4. 页面关闭时减少计数，最后一页关闭则删除token
  function handlePageClose() {
    window.addEventListener('beforeunload', function() {
      let currentCount = Number(localStorage.getItem(PAGE_COUNT_KEY) || 0);
      currentCount--;
      
      if (currentCount <= 0) {
        // 最后一个页面关闭：删除token和计数
        localStorage.removeItem(TOKEN_KEY);
        localStorage.removeItem(PAGE_COUNT_KEY);
      } else {
        // 更新剩余页面数
        localStorage.setItem(PAGE_COUNT_KEY, currentCount);
      }
    });
  }

  // ========== 执行初始化 ==========
  // 初始化页面计数
  initPageCount();
  
  // 获取或生成token
  const visitToken = getToken() || generateToken();
  
  // 绑定页面关闭事件
  handlePageClose();

  // 把token暴露到全局，方便打点接口使用
  window.VISIT_TOKEN = visitToken;
  
  console.log('当前会话token：', visitToken);
})();

</script>



<script>

        /* ===================== 右下角悬浮客服 ===================== */
        const floatingSupport = document.getElementById('floatingSupport');
        const floatingHeadset = document.getElementById('floatingHeadset');
        floatingHeadset.addEventListener('click', e => {
            e.stopPropagation();
            floatingSupport.classList.toggle('active');
        });
        document.addEventListener('click', e => {
            if (!floatingSupport.contains(e.target)) {
                floatingSupport.classList.remove('active');
            }
        });


        /* ===================== 回到顶部 / 到达底部 ===================== */
        function resetScrollBtn(btn) {
            if (!btn) return;
            btn.classList.remove('is-active');
            btn.blur();
        }

        function scrollToTarget(targetTop, btn) {
            btn.classList.add('is-active');

            const getScrollTop = () => window.scrollY || document.documentElement.scrollTop;
            const isAtTarget = () => Math.abs(getScrollTop() - targetTop) <= 3;

            if (isAtTarget()) {
                resetScrollBtn(btn);
                return;
            }

            window.scrollTo({ top: targetTop, behavior: 'smooth' });

            const startTime = Date.now();
            const maxWait = 2500;

            function waitForScrollEnd() {
                if (isAtTarget() || Date.now() - startTime > maxWait) {
                    resetScrollBtn(btn);
                    return;
                }
                requestAnimationFrame(waitForScrollEnd);
            }

            if ('onscrollend' in window) {
                const onScrollEnd = () => {
                    window.removeEventListener('scrollend', onScrollEnd);
                    resetScrollBtn(btn);
                };
                window.addEventListener('scrollend', onScrollEnd, { once: true });
                setTimeout(() => resetScrollBtn(btn), maxWait);
            } else {
                requestAnimationFrame(waitForScrollEnd);
            }
        }

        const scrollTopBtn = document.getElementById('scrollTopBtn');
        const scrollBottomBtn = document.getElementById('scrollBottomBtn');

        function bindScrollBtn(btn, getTargetTop) {
            if (!btn) return;
            btn.addEventListener('click', (e) => {
                scrollToTarget(getTargetTop(), e.currentTarget);
            });
        }

        bindScrollBtn(scrollTopBtn, () => 0);
        bindScrollBtn(scrollBottomBtn, () => Math.max(
            document.documentElement.scrollHeight - window.innerHeight,
            0
        ));

        /* ===================== 搜索下拉：点击空白处收起 ===================== */
        function hideSearchResults() {
            const results = document.getElementById('search-result');
            if (!results) return;
            results.innerHTML = '';
            results.style.display = '';
        }

        function showSearchResults() {
            const results = document.getElementById('search-result');
            if (!results) return;
            results.style.display = '';
        }

        function isInsideSearchArea(target) {
            return target && target.closest && target.closest(
                '.hero-search-box, .hero-search-wrapper, .content-search-box, .search-input, .help-search-wrap, .content-sticky-header'
            );
        }

        document.addEventListener('click', function (e) {
            if (!isInsideSearchArea(e.target)) {
                hideSearchResults();
            }
        });

        document.addEventListener('focusin', function (e) {
            const input = e.target;
            if (!input || !input.matches) return;
            if (input.matches('#search-input, .hero-search-input, .content-search-input')) {
                const results = document.getElementById('search-result');
                if (results && input.value.trim()) {
                    results.style.display = '';
                    input.dispatchEvent(new Event('keyup', { bubbles: true }));
                }
            }
        });

</script>

<script type="text/babel">
    //初始化值
    let input = document.querySelector('#search-input')
    let allSearchPosts = []

    console.log(input, 'input')

    let ghostSearch = new GhostSearch({
        url: window.location.href.match('help.dsers.com') ? 'https://help.dsers.com' : 'https://help-dev.dsers.com',
        key: window.location.href.match('help.dsers.com') ? 'aba8f27e3ca137ee6541fd9a7c' : '193ea68ee8e27bfc6cdf440768',
        version: 'v3',
        input: '#search-input',
        results: '#search-result',
        template: function (result) {
            if (/^[ ]+$/g.test(document.getElementById('search-input').value)) {
                return
            }
            let url = [location.protocol, '//', location.host].join('');
            return '<a class="search-result-item" href="' + url + '/' + result.slug + '">' + result.title + '</a>';
        },
        options: {
            keys: ['title', 'custom_excerpt'],
            threshold: -10000,
            // 先多取，再按发布时间截断前 8
            limit: 10000
        },
        api: {
            resource: 'posts',
            parameters: {
                limit: 'all',
                fields: ['title', 'slug', 'custom_excerpt', 'published_at'],
                order: 'published_at desc'
            }
        },
        on: {
            afterFetch: function (posts) {
                (posts || []).forEach(function (post) {
                    post.custom_excerpt = post.custom_excerpt || '';
                });
                allSearchPosts = posts || [];
            },
            afterDisplay: function () {
                const inputValue = document.getElementById('search-input').value;
                const kw = inputValue.trim().toLowerCase();
                const resultsElement = document.getElementById('search-result');

                console.log(kw, 'kw_er')

                if (kw !== '') {
                    showSearchResults();
                }

                // title 或 custom_excerpt 包含关键词；按 published_at 降序；下拉只展示 title
                const matched = allSearchPosts.filter(function (post) {
                    const title = (post.title || '').toLowerCase();
                    const customExcerpt = (post.custom_excerpt || '').toLowerCase();
                    return title.indexOf(kw) !== -1 || customExcerpt.indexOf(kw) !== -1;
                }).sort(function (a, b) {
                    return new Date(b.published_at) - new Date(a.published_at);
                });
                const topResults = matched.slice(0, 8);

                resultsElement.innerHTML = '';

                if (topResults.length === 0 && kw !== '') {
                    let e = document.createElement('span');
                    e.innerHTML = `No relevant content, DSers provide 24/7 live chat support service. <a href="https://www.messenger.com/t/DSersOfficial?text=${kw}" target="_blank" rel="noopener noreferrer" style="color:#ff8f00;text-decoration:underline;">Click here</a>.`;
                    e.setAttribute('style', 'margin:10px;display:block;line-height:1.5;')
                    const contactLink = e.querySelector('a');
                    if (contactLink) {
                        contactLink.addEventListener('click', function () {
                            eventCollect({
                                module: 'help_center',
                                name: 'click',
                                action: 'help_center_no_result_contact_click',
                                params: {
                                    keyword: kw,
                                    source: 'landing_page'
                                }
                            });
                        });
                    }
                    resultsElement.appendChild(e);
                    return;
                }

                if (topResults.length !== 0 && kw !== '') {
                    let url = [location.protocol, '//', location.host].join('');
                    topResults.forEach(function (item) {
                        let a = document.createElement('a');
                        a.className = 'search-result-item';
                        a.href = url + '/' + item.slug;
                        a.textContent = item.title;
                        resultsElement.appendChild(a);
                    });

                    let e = document.createElement('div');
                    e.setAttribute('class', 'search-result-seeall')
                    e.onclick = function () {
                        console.log('cccc-1')

            eventCollect({
      module: 'help_center',
      name: 'click',
      action: 'help_center_search',
      params: {
        keyword: input.value.toLowerCase(),
        ts: Math.floor(Date.now() / 1000)
      },
    });

                        window.location.href = `/search/?search_text=${input.value.toLowerCase()}`
                    }
                    e.innerHTML = 'See all search results';
                    resultsElement.appendChild(e);
                }
            }
        }
    })


</script>
<script type="text/babel">
    init()

    function init() {
        [].slice.call($('a')).map(item => item.getAttribute('href') && item.getAttribute('href').includes('http:') && item.setAttribute('href', item.getAttribute('href').replace('http:', 'https:')));
        [].slice.call($('img')).map(item => item.getAttribute('src') && item.getAttribute('src').includes('http:') && item.setAttribute('src', item.getAttribute('src').replace('http:', 'https:')))
    }

    $(document).ready(function () {

        if (window.location.hostname === 'help.dsers.com' && window.location.protocol == 'http:') {
            window.location.href = window.location.href.replace(/^http/, 'https')
        }
        // Mobile Menu Trigger
        $('.gh-burger').click(function () {
            $('body').toggleClass('gh-head-open');
        });
        // FitVids - Makes video embeds responsive
        $(".gh-content").fitVids();
    });
</script>
