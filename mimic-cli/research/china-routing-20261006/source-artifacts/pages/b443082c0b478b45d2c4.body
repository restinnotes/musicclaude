        $(".kg-image").css({ 'cursor': 'zoom-in' })
        $(".kg-image").on('click', function (e) {
            var imgSrc = e.target.src;
            var imgMaskHtml = '<div id="imgMask" style="position:fixed;top:0;left:0;width:100%;height:100%;bottom:0;right:0;background:rgba(0,0,0,.56);z-index:9999;">';
            imgMaskHtml += '<img style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);cursor:zoom-out" id="maskImg" src="' + imgSrc + '"></img>';
            imgMaskHtml += '</div>';
            $(".viewport").append(imgMaskHtml)

            $('#maskImg').on('click', function () {
                $("#imgMask").remove()
            })
        })

        let isMigration = $('.tagsPostItem').text().split(',').map(function (item) { return item.replace(/(^\s*)|(\s*$)/g, "") }).indexOf('MIGRATION') !== -1;
        // ------------新增迁移模块逻辑---------------       
        isMigration ? $('.containerMigration').css({ 'display': 'block' }) :
            $('.containerClassical').css({ 'display': 'block' })
        // --------------------------------------
        $('.header_box').css({ 'position': 'fixed' });
        attachvMigration(isMigration);
        $(".copy-input").attr('value', location.href);
        $(".search-copy").on('click', function () {
            $('.search-mask').css('display', 'block');
        })
        $(".close-search").on('click', function () {
            $('.search-mask').css('display', 'none');
        })

        $('#copy').on('click', function () {
            $('#copy-input').select();//获取文本框id
            document.execCommand("Copy"); //原生copy方法执行浏览器复制命令
            alert("The content is copied successfully. Go and paste it!"); //弹窗
        })
        if (localStorage.getItem('tags_name') != 'migration') {
            let list = Array.prototype.slice.call(document.querySelectorAll('#post-card-content-link-list')).filter(function (i) {
                return i.textContent == document.querySelector('.article-title-dz').textContent
            })[0];
            if (list) {
                list.setAttribute('style', 'color: #705cd7 !important;font-weight: 600;');
            }
        } else {
            let list = Array.prototype.slice.call(document.querySelectorAll('#post-card-migration-link')).filter(function (i) {
                return i.textContent == document.querySelector('.article-title-dz').textContent
            })[0];
            if (list) {
                list.setAttribute('style', 'color: #705cd7 !important');
            }
        }

        $('.post-card-point-link-list').click(function (item, index) {
            $('.post-card-point-link-list').css({ "color": "#7f7f7f" });
            $(this).css({ "color": "#705cd7" })
        })

        const list = document.querySelectorAll('.recommend-text')
        // list.forEach(function (i) {
        //     i.setAttribute('href', document.querySelector('.recommend-text').getAttribute('href').replace(/http:/, 'https:'))
        // })
        for (var i = 0; i < list.length; i++) {
                var item = list[i];
                item.setAttribute('href', document.querySelector('.recommend-text').getAttribute('href').replace(/http:/, 'https:'));
            }
        $("#facebook-share").attr('href', 'http://www.facebook.com/sharer/sharer.php?u=' + location.href)
        $("#twitter-share").attr('href', 'https://twitter.com/share?url=' + location.href)
        $("#instaggram-share").attr('href', 'https://linkedin.com/shareArticle?mini=true&url=' + location.href)

        // 滚动吸顶效果
        let articleScrollHeight = document.documentElement.scrollHeight || document.body.scrollHeight;
        let articleClientHeight = document.documentElement.clientHeight || document.body.clientHeight;
        let titleHeight = document.querySelector('.title-left').clientHeight;
        let footerHeight = 0;
        let gapDis = isMigration ? -200 : 0
        setTimeout(function () {
            changeMaxHeight();
        }, 100)

        window.onscroll = function (e) {
            //针对迁移用户吸顶的效果展示
            let footerHeight = document.getElementById('main-footer').offsetTop;
            let scrollingHeight = document.documentElement.scrollTop || document.body.scrollTop;
            articleClientHeight = document.documentElement.clientHeight || document.body.clientHeight;
            let TopDistance = footerHeight - articleClientHeight > 0 ? footerHeight - articleClientHeight : 0;
            if (footerHeight < articleClientHeight) {
                gapDis = 0
            }
            //兼容短篇文章效果
            if (scrollingHeight > 210) {
                //$('.migrationLeft').css({'position':'fixed'})
                $('.migrationBanner').css({ 'display': 'none' })
            } else {
                //$('.migrationLeft').css({'position':'static'})
                $('.migrationBanner').css({ 'display': 'block' })
            }
            //优化 旧版滚动监听
            if (scrollingHeight + articleClientHeight >= footerHeight) {
                $('.title-list').css({ 'position': 'static', 'margin-top': TopDistance + gapDis })
            } else if (scrollingHeight > 210) {
                $('.title-list').css({ 'position': 'fixed', 'margin-top': gapDis })
            } else {
                isMigration ? $('.title-list').css({ 'position': 'static', 'margin-top': 0 }) : $('.title-list').css({ 'position': 'fixed', 'margin-top': 0 })
            }
        }
        // 改变左侧 nav 的最大距离
        function changeMaxHeight() {
            let standardHeight = 0;
            let clientHeight = document.documentElement.clientHeight;
            let footerHeight = document.getElementById('main-footer').offsetTop;
            if (clientHeight > footerHeight) {
                standardHeight = document.documentElement.clientHeight - (clientHeight - footerHeight) - 275
            } else {
                standardHeight = document.documentElement.clientHeight - 275;
            }
            let maxHeight = standardHeight - (3 * titleHeight) + gapDis;
            $('.title-page').css({ 'max-height': maxHeight < 40 ? 40 : maxHeight + 'px' })
        }
        window.onresize = function () {
            changeMaxHeight();
        }

        //切换左侧nav导航条
        let tags_faq = localStorage.getItem('tags_name_2') && localStorage.getItem('tags_name_2').toLowerCase();
        $('#no_faq').css('display', 'block');
        $('#faq').css('display', 'none');
        $('.title-page').css('display', 'none')
        if ($('.tagsPostItem').text() != 'MIGRATION') {
            $('#title-' + tags_faq).css('display', 'block')
            $('#title-' + tags_faq + '-part').find('.nav-title-sign').css('display', 'block')
            $('#title-' + tags_faq + '-part').find('.chevron-right').addClass('chevron-right-expend')
            $('#title-' + tags_faq + '-part').find('.title-left').css('color', '#000000')
        }

        $(".title-header").on('click', function (e) {
            
            if ($('#' + $(e.target).attr('title-tag')).css('display') !== 'none') {
                $('#' + $(e.target).attr('title-tag')).css('display', 'none')
                $(this).find('.nav-title-sign').css('display', 'none')
                $(this).find('.chevron-right').removeClass('chevron-right-expend')
                $(this).find('.title-left').css('color', '#9D9D9D')
            } else {
                $('.nav-title-sign,.title-page').css('display', 'none')
                $('.chevron-right').removeClass('chevron-right-expend')
                $('.title-left').css('color', '#9D9D9D')
                $('#' + $(e.target).attr('title-tag')).css('display', 'block')
                $(this).find('.nav-title-sign').css('display', 'block')
                $(this).find('.chevron-right').addClass('chevron-right-expend')
                $(this).find('.title-left').css('color', '#000000')
            }
        })

        function attachvMigration(isMigration) {
            //Array.prototype.slice.call($('.post-card-content-link')).forEach(function (item) {
            //    if (window.location.href.indexOf($(item).attr('href')) > -1) {
            //        localStorage.setItem('tags_name_2', $(item).attr('list-tag'))
            //    }
            //})
            var postCardContentLinks = $('.post-card-content-link');
            var postCardContentLinksArray = Array.prototype.slice.call(postCardContentLinks);

            for (var i = 0; i < postCardContentLinksArray.length; i++) {
                var item = postCardContentLinksArray[i];
                if (window.location.href.indexOf($(item).attr('href')) > -1) {
                    localStorage.setItem('tags_name_2', $(item).attr('list-tag'));
                }
            }
            if (isMigration) {
                localStorage.setItem('tags_name', 'Migration')
            } else {
                if (localStorage.getItem('tags_name') == 'Migration') {
                    localStorage.removeItem('tags_name')
                }
            }
        }
    </script>

<script>
document.onreadystatechange = function() {
  switch (document.readyState) {
    case 'interactive':


      console.log("DOM 加载完成");
      break;
    case 'complete':



           // 文章id
    const id = document.getElementById('post_id') && document.getElementById('post_id').innerText
    const articleTitle = document.getElementById('articleTitle') && document.getElementById('articleTitle').innerText



// 广告A
const adA = `
<div class="shopify-ad" aria-label="Start your online store with Shopify" id="advertising" data-id="ADV-002" data-title="Shopify affiliate">
    <span class="material-icons-round shopify-ad-icon">shopping_cart</span>
    <div class="shopify-ad-title">Start Your Online Store</div>
    <div class="shopify-ad-desc">Build and launch your dropshipping business on Shopify — the #1 e-commerce platform.</div>
        <a 
        class="shopify-ad-btn" 
        href="https://shopify.pxf.io/L0njrO" 
        target="_blank" 
        rel="noopener noreferrer"
    >
        Try Shopify Free
        <span class="material-icons-round">arrow_forward</span>
    </a>
</div>
`;

// 广告B
const adB = `
<div class="slide_banner_box_top" id="slide_banner_box_top advertising" data-id="ADV-001" data-title="DSers subscribe">
  <div class="title">Grow Your Dropshipping Sales in a Few Clicks</div>
  <div class="content">
    <div>30k+ 5-star reviews on Shopify</div>
    <div>Free plan available lifetime</div>
    <div>24/7 customer support</div>
  </div>
  <a class="btn" onclick="ga('send','event','dsapp','register','sidebanner');" href="https://www.dsers.com/partner/SEO-01">
    TRY IT NOW
  </a>
</div>
`;


// 1. 渲染广告
const container = document.getElementById('ab-test-container');
container.innerHTML = Math.random() > 0.5 ? adA : adB;

// 2. 延迟确保 DOM 渲染完成（防获取不到）

  const adElement = container.querySelector('[data-id]');
  console.log(adElement, 'adElement')
  if (!adElement) return;

  const adId = adElement.dataset.id;
  const adTitle = adElement.dataset.title;


  function generateOrGetCode() {
    // 先判断 storage 里有没有 code
    let code = sessionStorage.getItem('uniqueCode');

    // 如果没有，才生成 18 位随机字符串
    if (!code) {
        code = generate16DigitString();
        sessionStorage.setItem('uniqueCode', code);
        console.log('✅ 首次生成 18 位 code：', code);
    } else {
        console.log('✅ 读取已有 code：', code);
    }

    return code;
    }

    // 生成 18 位随机字符串（字母+数字，安全通用）
    function generate16DigitString() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    let result = '';
    for (let i = 0; i < 18; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return result;
    }

    if (id && articleTitle) {
    eventCollect({
      module: 'help_center',
      name: 'click',
      action: 'help_center_article_ad_exp',
      params: { id: id,
        title: articleTitle, ad_id: adId, ad_title: adTitle, article_code: generateOrGetCode() },
    });
    }


  if (adId === 'ADV-002') {
    const btnLink = adElement.querySelector('.shopify-ad-btn');
    if (btnLink) {
      btnLink.addEventListener('click', function (e) {
        if (id && articleTitle) {
        eventCollect({
            module: 'help_center',
            name: 'click',
            action: 'help_center_article_ad_click',
            params: { id: id,
        title: articleTitle,ad_id: adId, ad_title: adTitle, article_code: generateOrGetCode() },
        });
        }
        
      });
    }
  }

  // ====================
  // 广告B：整区点击打点（保留原有跳转）
  // ====================
  if (adId === 'ADV-001') {
    adElement.addEventListener('click', function () {
      console.log('✅ 广告B点击', { ad_id: adId, ad_title: adTitle });
      if (id && articleTitle) {
        eventCollect({
            module: 'help_center',
            name: 'click',
            action: 'help_center_article_ad_click',
            params: { id: id,
        title: articleTitle,ad_id: adId, ad_title: adTitle, article_code: generateOrGetCode() },
        });
      }
      // trackEvent('ad_click', { ad_id: adId, ad_title: adTitle });
    });
  }



  function generateOrGetCode() {
    // 先判断 storage 里有没有 code
    let code = sessionStorage.getItem('uniqueCode');

    // 如果没有，才生成 18 位随机字符串
    if (!code) {
        code = generate16DigitString();
        sessionStorage.setItem('uniqueCode', code);
        console.log('✅ 首次生成 18 位 code：', code);
    } else {
        console.log('✅ 读取已有 code：', code);
    }

    return code;
    }

    // 生成 18 位随机字符串（字母+数字，安全通用）
    function generate16DigitString() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    let result = '';
    for (let i = 0; i < 18; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return result;
    }

const article = document.getElementById('articleContent');

// 事件委托：监听容器内 **所有 a 标签点击**（包括动态加载的链接）
article.addEventListener('click', function (e) {
  // 找到被点击的 a 标签
  const link = e.target.closest('a');
  
  // 如果确实点击了 a 标签
  if (link && id && articleTitle) {
        eventCollect({
      module: 'help_center',
      name: 'click',
      action: 'help_center_article_click',
      params: {
        id: id,
        title: articleTitle,
        ts: Math.floor(Date.now() / 1000),
        article_code: generateOrGetCode()
      },
    });
  }
});

    const secondTime = Math.floor(Date.now() / 1000);
    if (id && articleTitle) {
    eventCollect({
      module: 'help_center',
      name: 'click',
      action: 'help_center_article_exp',
      params: {
        id: id,
        title: articleTitle,
        ts: secondTime,
        article_code: generateOrGetCode()
      },
    });
    }
     console.log("页面完全加载完成");



    // 页面卸载前上报（关闭、刷新、跳转都会触发）
    window.addEventListener('beforeunload', () => {



        if (id && articleTitle) {
    eventCollect({
      module: 'help_center',
      name: 'click',
      action: 'help_center_article_leave',
      params: {
        id: id,
        title: articleTitle,
        ts: Math.floor(Date.now() / 1000),
        article_code: generateOrGetCode()
      },
    });
        }
         sessionStorage.removeItem('uniqueCode');
    });

      break;
  }
};





</script>


    <style>


/* ===================== 顶部横幅（优化版）===================== */
.slide_banner_box_top {
  width: 100%;
  flex-shrink: 0;
  /* 统一渐变风格 + 主色调 */
background-image: linear-gradient(rgb(0 150 136) 0%, rgba(251, 251, 251, 0.1) 100%), linear-gradient(90deg, #32c5ff, #ff8f00) !important;
 
  border-radius: var(--radius-md, 12px);
  overflow: hidden;
  padding: 24px 20px;
  z-index: 1000;
  color: #fff;
  text-align: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2px 8px rgba(0, 150, 136, 0.15);
  position: relative;
  box-sizing: border-box;
}

/* 装饰圆点（和广告位风格统一） */
.slide_banner_box_top::before {
  content: "";
  position: absolute;
  top: -40px;
  right: -20px;
  width: 100px;
  height: 100px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}
.slide_banner_box_top::after {
  content: "";
  position: absolute;
  bottom: -20px;
  left: -15px;
  width: 60px;
  height: 60px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

/* 悬停效果 */
.slide_banner_box_top:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 150, 136, 0.25);
}

/* 标题样式 */
.slide_banner_box_top .title {
  font-weight: 700;
  font-size: 28px;
  line-height: 1.3;
  position: relative;
  z-index: 1;
  margin: 0;
}

/* 内容描述 */
.slide_banner_box_top .content {
  font-size: 14px;
  line-height: 1.5;
  margin-top: 12px;
  color: rgba(255, 255, 255, 0.9);
  position: relative;
  z-index: 1;
}

/* 按钮样式（完全对齐广告位风格） */
.slide_banner_box_top a {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 20px !important;
  background: #fff !important;
  color: #00796b !important;
  border-radius: var(--radius-sm, 8px) !important;
  font-size: 14px;
  font-weight: 700;
  font-family: "Rubik", sans-serif;
  cursor: pointer;
  transition: all 0.3s ease;
  margin: 20px auto 8px !important;
  position: relative;
  z-index: 1;
  border: none;
  width: fit-content !important;
  text-decoration: none;
  letter-spacing: 0.5px;
}

/* 按钮悬停 */
.slide_banner_box_top a:hover {
  background: #e0f2f1 !important;
  transform: translateY(-2px);
  color: #004d40 !important;
}

/* 暗色模式适配 */
[data-theme="dark"] .slide_banner_box_top {
  background: linear-gradient(135deg, #4db6ac 0%, #26a69a 50%, #00897b 100%);
}
[data-theme="dark"] .slide_banner_box_top a {
  color: #004d40;
}

.displaynNone {
    display: none;
}


.tocbot_title {
    margin-bottom: 12px;
}

/* ===================== 文章页移动端适配 ===================== */
@media (max-width: 900px) {
    .post-page.containerClassical,
    .post-page.containerMigration {
        padding: 0 16px 32px;
    }

    .post-page .article-header,
    .post-page .article-tags-wrap,
    .post-page .content-area {
        overflow: visible;
    }

    .post-page .article-breadcrumb-bar {
        margin: 0 -16px;
        width: calc(100% + 32px);
    }

    .post-page .article-breadcrumb {
        padding: 10px 16px;
        flex-wrap: wrap;
        align-items: center;
        row-gap: 6px;
        white-space: normal;
        overflow: visible;
    }

    .post-page .article-breadcrumb-current {
        white-space: normal;
        word-break: break-word;
        max-width: 100%;
        overflow: visible;
        text-overflow: unset;
    }

    .post-page #page_tag {
        display: contents;
    }

    .post-page .article-breadcrumb-sep {
        flex-shrink: 0;
    }

    .post-page .main-layout {
        flex-direction: column;
        padding: 0;
        gap: 0;
    }

    .post-page .content-area {
        width: 100%;
        max-width: none;
        padding: 20px 0 16px;
        border-right: none;
        order: 1;
    }

    .post-page .right-sidebar {
        position: static;
        width: 100%;
        max-width: none;
        max-height: none;
        top: auto;
        padding: 0 0 24px;
        order: 2;
        gap: 16px;
        display: flex;
    }

    .post-page .article-header {
        margin-bottom: 20px;
        padding-bottom: 16px;
        overflow: visible;
    }

    .post-page .article-tags-wrap {
        gap: 6px;
        margin-bottom: 12px;
        overflow: visible;
        width: 100%;
    }

    .post-page .article-category-tag {
        display: inline-flex;
        align-items: center;
        margin-bottom: 0;
        margin-right: 0;
        font-size: 11px;
        line-height: 1.5;
        max-width: 100%;
        width: auto;
        height: auto;
        white-space: normal;
        word-break: break-word;
        overflow-wrap: anywhere;
        overflow: visible;
        text-overflow: unset;
        flex: 0 1 auto;
        align-self: flex-start;
    }

    .post-page .article-title1 {
        font-size: 28px;
        line-height: 1.25;
        margin-bottom: 12px;
        word-break: break-word;
    }

    .post-page .article-meta {
        gap: 10px;
        font-size: 13px;
    }

    .post-page .article-content {
        font-size: 15px;
        line-height: 1.75;
        overflow-wrap: break-word;
        word-break: break-word;
    }

    .post-page .article-content h2 {
        font-size: 20px;
        margin-top: 32px;
        margin-bottom: 12px;
    }

    .post-page .article-content h3 {
        font-size: 18px;
        margin-top: 24px;
        margin-bottom: 12px;
    }

    .post-page .article-content h4 {
        font-size: 16px;
        margin-top: 20px;
    }

    .post-page .article-content pre,
    .post-page .article-content table,
    .post-page .gh-content-dz pre,
    .post-page .gh-content-dz table {
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .post-page .article-content img,
    .post-page .gh-content-dz img {
        max-width: 100%;
        height: auto;
    }

    .post-page .tocbot_content {
        padding: 16px;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        background: var(--gray-50);
    }

    .post-page .tocbot_title {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--gray-500);
    }

    .post-page .shopify-ad,
    .post-page .slide_banner_box_top {
        padding: 18px 14px;
    }

    .post-page .slide_banner_box_top .title {
        font-size: 20px;
    }

    .post-page .article-feedback {
        margin-top: 32px;
        padding-top: 24px;
    }

    .post-page .feedback-question {
        font-size: 16px;
    }

    .post-page .feedback-buttons {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 12px;
    }

    .post-page .feedback-btn {
        flex: 0 1 auto;
        justify-content: center;
        padding: 12px 20px;
        font-size: 14px;
    }

    .post-page .drawer-toggle-btn {
        width: 44px;
        height: 44px;
        top: auto;
        bottom: 120px;
        transform: none;
        border-left: 1.5px solid var(--gray-200);
        border-radius: 0 var(--radius-md) var(--radius-md) 0;
        z-index: 9996;
    }

    .post-page .right-drawer-toggle-btn {
        width: 44px;
        height: 44px;
        top: auto;
        bottom: 176px;
        transform: none;
        border-right: 1.5px solid var(--gray-200);
        border-radius: var(--radius-md) 0 0 var(--radius-md);
        z-index: 9996;
    }

    .post-page .drawer-panel {
        width: min(300px, 88vw);
    }

    .post-page .modal-content {
        padding: 20px 16px;
        width: calc(100% - 32px);
        max-width: none;
    }

    .post-page .modal-footer {
        flex-direction: column-reverse;
        gap: 8px;
    }

    .post-page .modal-btn {
        width: 100%;
        justify-content: center;
    }

    /* Migration 布局 */
    .post-page .migrationBanner {
        width: calc(100% - 32px);
        left: 16px;
        height: 120px;
        top: 60px;
    }

    .post-page .migrationContent {
        flex-direction: column;
        margin: 140px auto 32px;
        align-items: stretch;
    }

    .post-page .migrationLeft {
        float: none;
        width: 100%;
        margin-right: 0;
        margin-bottom: 16px;
        position: static;
    }

    .post-page .migrationRight {
        float: none;
        width: 100%;
        padding: 24px 16px;
        margin-bottom: 32px;
    }

    .post-page .article-title-dz {
        font-size: 26px;
        line-height: 1.3;
        word-break: break-word;
    }

    .post-page .share-container {
        flex-wrap: wrap;
        gap: 12px;
    }
}

@media (max-width: 480px) {
    .post-page.containerClassical,
    .post-page.containerMigration {
        padding: 0 12px 24px;
    }

    .post-page .article-breadcrumb-bar {
        margin: 0 -12px;
        width: calc(100% + 24px);
    }

    .post-page .article-breadcrumb {
        padding: 10px 12px;
        font-size: 12px;
        gap: 4px;
    }

    .post-page .article-title1 {
