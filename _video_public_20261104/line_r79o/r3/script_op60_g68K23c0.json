 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "想靠近的热意忽然涌上来，连自己也意外。",
       "keys": [
        "热意忽然涌上来",
        "连自己也意外"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "怕自己的需要成负担，只敢露出一点喜欢",
       "keys": [],
       "from": [
        "S01-2"
       ],
       "bead": "S01-2"
      },
      {
       "text": "话到嘴边先沉默几秒",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "刚踏上船板，脚下微晃",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "一点亲近很甜，下次能否坦白",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有退开，他才敢慢慢放松。",
       "keys": [
        "没有退开",
        "慢慢放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩膀挨着肩膀，连呼吸都贴近",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "身体交给船底托举，水却一直在流",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "想靠近，喜欢几乎藏不住，还是收住了",
       "keys": [],
       "from": [
        "S02-2"
       ],
       "bead": "S02-2"
      },
      {
       "text": "还没分开就舍不得，心里像被温柔刺了一下",
       "keys": [],
       "from": [
        "S02-3"
       ],
       "bead": "S02-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不想以后，只想舒服地待在亲近里。",
       "keys": [
        "不想以后",
        "舒服地待在亲近里"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "沉默也舒服，心却慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "想说喜欢，也想问对方是否一样",
       "keys": [],
       "from": [
        "S03-2"
       ],
       "bead": "S03-2"
      },
      {
       "text": "急切的念头刚冒头，又沉了下去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水下暗流拖住思绪，像碎开的倒影",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他想把话说开，盼对方喜欢坦白的他，也留住眼下的好。",
       "keys": [
        "喜欢坦白的他",
        "留住眼下的好"
       ],
       "from": [
        "S04-2",
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "上回明明想说，最后还是没开口",
       "keys": [],
       "from": [
        "S04-1"
       ],
       "bead": "S04-1"
      },
      {
       "text": "越想抱牢当下，手越不自觉握紧",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "怕说太多让对方为难、弄丢自在，还是留了些话",
       "keys": [],
       "from": [
        "S04-3"
       ],
       "bead": "S04-3"
      },
      {
       "text": "还没失去就舍不得，每秒都像倒数",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他没藏住喜欢，对方看出他的在乎；他空落落，不知怎么相处。",
       "keys": [
        "没藏住喜欢",
        "看出他的在乎"
       ],
       "from": [
        "S05-1",
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "怕对方嫌他太黏，亲近像隔了一层",
       "keys": [],
       "from": [
        "S05-3"
       ],
       "bead": "S05-3"
      },
      {
       "text": "支撑忽然抽走，像漂进雾里",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "贴近耳语忽然停了：幸福是真的吗",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "被看出在乎，对方仍如常，他才自在；安静时还想靠近，却怕要太多。",
       "keys": [
        "对方仍如常",
        "才自在"
       ],
       "from": [
        "S06-1",
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "怕被嫌弃，仍想靠近却不敢要太多",
       "keys": [],
       "from": [
        "S06-2"
       ],
       "bead": "S06-2"
      },
      {
       "text": "白天相处很好，独处时心头泛酸",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "气味、身体感觉、幻想、遗憾和快感缠在一起",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      },
      {
       "text": "对方会不会也舍不得结束亲近",
       "keys": [],
       "from": [
        "S06-3"
       ],
       "bead": "S06-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到能互相依靠，他高兴得收不住，心里一紧。",
       "keys": [
        "互相依靠",
        "高兴得收不住"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "对方总愿陪他，也许也需要他、靠着他安心",
       "keys": [],
       "from": [
        "S07-1"
       ],
       "bead": "S07-1"
      },
      {
       "text": "气味、身体感觉、幻想、遗憾和快感缠在一起",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "盼对方想找人陪时，还会想到自己",
       "keys": [],
       "from": [
        "S07-3"
       ],
       "bead": "S07-3"
      },
      {
       "text": "美还在，时间却一直经过",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他见对方依然亲近，想大方回应，连以后都开始盼。",
       "keys": [
        "依然亲近",
        "大方回应"
       ],
       "from": [
        "S08-1",
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体恢复弹性，带着玩心回应",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      },
      {
       "text": "眼下亲近，以后未必还会这样",
       "keys": [],
       "from": [
        "S08-3"
       ],
       "bead": "S08-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他怕对方不再需要他；想起对方没退开，也许喜欢他在身边。",
       "keys": [
        "不再需要他",
        "也许喜欢他在身边"
       ],
       "from": [
        "S09-1",
        "S09-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "前面的冲劲忽然收住，像对视时屏住呼吸",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "明朗隔着薄雾，光还在",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      },
      {
       "text": "刚才那是真的吗？接下来怎么办",
       "keys": [],
       "from": [
        "S09-B3"
       ],
       "bead": "S09-B3"
      },
      {
       "text": "抬头看夜空，眼前美好比愿望更大",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不再猜以后，先享受亲近，心里亮得想笑又想哭。",
       "keys": [
        "先享受亲近",
        "想笑又想哭"
       ],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩膀松开，胸腔打开，眼泪不用憋着",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "时间松开，只够呼出一口气",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "身体失去重量，悬在夏夜微风里",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "即使对方不需要，他仍愿意陪着，不再为喜欢道歉。",
       "keys": [
        "仍愿意陪着",
        "不再为喜欢道歉"
       ],
       "from": [
        "S11-1",
        "S11-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他需要对方，对方有时也需要他",
       "keys": [],
       "from": [
        "S11-1"
       ],
       "bead": "S11-1"
      },
      {
       "text": "高兴得顾不上害臊，觉得在乎没什么不好",
       "keys": [],
       "from": [
        "S11-2"
       ],
       "bead": "S11-2"
      },
      {
       "text": "以后未必总能这样亲近，他说了不算",
       "keys": [],
       "from": [
        "S11-3"
       ],
       "bead": "S11-3"
      },
      {
       "text": "旧房子仍熟悉，知道珍贵后反而心疼",
       "keys": [],
       "from": [
        "S11-B4"
       ],
       "bead": "S11-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他顾不上对方是否也在乎，只想把能给的都给出去，让他安心。",
       "keys": [
        "顾不上对方是否也在乎",
        "让他安心"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像被卷进比自己更大的世界",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      },
      {
       "text": "像久别重逢，忽然抱紧久久不松",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      },
      {
       "text": "明知以后难保证，还是想多陪一会儿",
       "keys": [],
       "from": [
        "S12-2"
       ],
       "bead": "S12-2"
      },
      {
       "text": "高兴终于涌出来，不再强迫自己收着",
       "keys": [],
       "from": [
        "S12-3"
       ],
       "bead": "S12-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "起初怕添负担，如今更怕对方不再需要自己；藏回喜欢更难受。",
       "keys": [
        "怕添负担",
        "不再需要自己"
       ],
       "from": [
        "S13-2",
        "S13-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "想听一句以后不变，越喜欢越觉时间快",
       "keys": [],
       "from": [
        "S13-1"
       ],
       "bead": "S13-1"
      },
      {
       "text": "幸福里渐渐掺进尖锐的苦涩",
       "keys": [],
       "from": [
        "S13-B2"
       ],
       "bead": "S13-B2"
      },
      {
       "text": "刚说了「是」，心里马上追问「可是呢？」",
       "keys": [],
       "from": [
        "S13-B3"
       ],
       "bead": "S13-B3"
      },
      {
       "text": "少露些心意，会不会少疼些",
       "keys": [],
       "from": [
        "S13-2"
       ],
       "bead": "S13-2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S14",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两人还亲近，他心里又甜又酸，却不后悔。",
       "keys": [
        "又甜又酸",
        "却不后悔"
       ],
       "from": [
        "S14-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "还会舍不得，却不再讨永远不变的保证",
       "keys": [],
       "from": [
        "S14-2"
       ],
       "bead": "S14-2"
      },
      {
       "text": "喜欢既已被看见，就不再往回藏",
       "keys": [],
       "from": [
        "S14-3"
       ],
       "bead": "S14-3"
      },
      {
       "text": "以后怎样，等真的到了再说",
       "keys": [],
       "from": [
        "S14-3"
       ],
       "bead": "S14-3"
      },
      {
       "text": "像从美梦醒来，还记得梦里的光",
       "keys": [],
       "from": [
        "S14-B1"
       ],
       "bead": "S14-B1"
      }
     ]
    }
   ]
  }
 ]
}