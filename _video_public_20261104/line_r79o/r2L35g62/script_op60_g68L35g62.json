     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "心里却一直舍不得这份亲近",
       "keys": [
        "一直舍不得这份亲近"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话说到要紧处顿住，对视到呼吸都停了，渴望仍紧绷着",
