   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "安稳一退，他又清楚地感到，当初那道去留之问还悬着。",
      "key": "安稳一退，他又清",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S08-2"
      ]
     },
     {
      "id": "S09-2",
      "text": "疑虑忽然尖锐了一瞬，随即又沉下去，他仍没有答案。",
      "key": "疑虑忽然尖锐了一",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S07-1",
      "to": "S09-1",
