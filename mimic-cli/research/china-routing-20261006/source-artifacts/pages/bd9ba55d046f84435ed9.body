equired"},"buySpareParts":{"privacyPolicy":"By clicking the checkbox, you consent to Bambu Lab using the data you fill in the form to help select spare parts and fulfill transactions. See our \u003c1\u003ePrivacy Notice\u003c/1\u003e for details.","title":"Buy Spare Parts","linkText":"Learn More","uploadSuccess":"Submitted successfully","uploadSuccessDesc":"Your application has been submitted successfully and you can check the progress of your application in Support Ticket.","step1":"Select Model","step2":"Get Spare Parts Prices","step3":"Submit a purchase request","column1":"Name of spare part","column2":"Price of spare part","shopBtn":"Buy Now","shopTips":"If purchase link is unavailable, submit request to buy.","email":{"label":"Email","placeholder":"Please fill in your Email","validate":"Email format is incorrect, please verify and try again"},"phone":{"label":"Phone","placeholder":"Please fill in your Phone","validate":"Phone format is incorrect, please verify and try again"},"orderNo":{"label":"Order ID and Channel","placeholder":"Please fill in your Order ID","validate":"Information does not match, please verify and try again"},"orderPlatform":{"placeholder":"Please select or enter the Order Channel"},"deviceModel":{"label":"Printer Model (or Product)","placeholder":"Please select the Printer Model (or Product)"},"product":{"label":"Product","placeholder":"Please select the Product"},"productName":{"label":"Parts collection","placeholder":"Please select the Parts collection","options":["Consumables","Hotend Parts","Extruder Parts","PTFE Tubing","Spare Screws","Cooling Fans","Toolhead Parts","Cables","Circuit Boards","Heatbed Parts","Housing Parts","Motors","XYZ Axis Parts","Screen/Camera/Light"],"other":"Others"},"attachments":{"label":"Attachment","placeholder":"Upload Attachment","subLabel":"(Damaged partonitem/the position where it was installed) (2 pictures required)","validate":"Attachments (Upload at least two)"},"countryCode":{"label":"Country / Region","placeholder":"Please select the Country / Region"},"address":{"label":"Address","placeholder":"Please fill in your Address"},"remark":{"label":"Please provide specific details of the situation","placeholder":"Please fill in details"},"findOrderId":"How to get Order ID?"},"myServicePortal":{"title":"My Service Portal","linkText":"Check Now","SNRecord":{"title":"Serial Number Registration Records","registerSN":"Register SN","snRegistration":"SN Registration","oldSN":"Old Serial Number","newSN":"New Serial Number","submitTime":"Submission Date","effectiveTime":"Registration Date","ticketOrOrder":"Ticket ID/Order ID","PrinterType":"Printer Type","status":"Status","waiting":"Waiting for registration","approved":"Registered","rejected":"Rejected"}}},"beginnerTutorial":{"return":"Return","title":"Beginner Tutorial","like":"Yes","dislike":"No","isHelpful":"Was this helpful?","previousPage":"Previous page","nextPage":"Next page","finish":"Finish"},"howToHub":{"title":"Video Collection","list":{"0":{"title":"How-to Guides"},"1":{"title":"X1 Series"},"2":{"title":"P1 Series"},"3":{"title":"A1 Series"},"4":{"title":"Bambu Prints"},"5":{"title":"P2S"},"6":{"title":"H2C"},"7":{"title":"H2S"},"8":{"title":"H2D"},"9":{"title":"Workshop Guides"},"10":{"title":"A2L"},"11":{"title":"X2D"}}},"contactUs":{"supportIconTips":"Click for Assistance","supportIconGuide":"Find answers for technical questions, or get connected with support","liveChat":{"title":"Live Chat","desc":"For product and general inquiries, such as specifications, promotions, payment methods, invoices, tax, policies, and order modification requests, \u003c1\u003eplease contact us via Live Chat\u003c/1\u003e.","onlineTime":"Online time: \u003c1\u003e24/7\u003c/1\u003e"},"generalTicket":{"title":"General Ticket","desc":"For accessories/filament issues, shipping/delivery issues, such as missing or incorrect items, undelivered/damaged packages, and account issues, \u003c1\u003eplease submit a General Ticket\u003c/1\u003e.","onlineTime":"Expected response time: within 24 hours"},"techTicket":{"title":"Technical Ticket","desc":"For any printer/AMS technical issues, such as hardware/firmware/software/network issues, print quality, \u003c1\u003eplease submit a Technical Ticket\u003c/1\u003e.","onlineTime":"Expected response time: within 24 hours"},"supportTicket":{"title":"Support Ticket","desc":"For general issues such as orders, shipping, delivery, account issues, or for technical issues related to printers (hardware/firmware/software/network), AMS, accessories, filaments, Maker's Supply, or print quality, \u003cSupportTicketLink\u003eplease submit a Support Ticket\u003c/SupportTicketLink\u003e.","desc1":"For general issues such as orders, shipping, delivery (e.g., package lost, damaged, or missing items), account issues, or for technical issues related to printers, lasers, AMS, filaments, Maker's Supply, or print quality, \u003cSupportTicketLink\u003eplease submit a Support Ticket\u003c/SupportTicketLink\u003e.","desc2":"For registration or login issues (e.g. account access), \u003cAccountIssueLink\u003eplease contact us here\u003c/AccountIssueLink\u003e.","slaHint":"Response times may vary by ticket type.","slaEntry":"Response times by ticket type","slaEntryAria":"View response time details","slaClose":"Close","sla":{"popoverTitle":"Response times by ticket type are as follows:","table":{"ticketType":"Ticket Type","technicalPrinter":"Technical Ticket (Printer)","technicalSoftware":"Technical Ticket (Software)","technicalFilament":"Technical Ticket (Filament \u0026 Maker's Supply)","general":"General Ticket","nonGerman":"Non-German, Japanese \u0026 Korean","german":"German, Japanese \u0026 Korean"},"exceptions":{"title":"Exceptions to Response Time","nonBusinessDays":{"label":"Non-Business Days","body":"Including weekends and statutory holidays, including but not limited to Christmas Day, New Year's Day, Thanksgiving Day, and Independence Day;"},"forceMajeure":{"label":"Force Majeure Events","body":"Including but not limited to acts of God (e.g., typhoons, earthquakes), cyberattacks, or system outages;"},"scheduledMaintenance":{"label":"Scheduled Maintenance","body":"Pre-announced system upgrades or maintenance windows;"},"highTicketVolume":{"label":"High Ticket Volume","body":"Such as during new product launches or major promotional events."}}}},"banner":{"title":"We're here to help!","desc":"Our international support team is ready to answer your questions and provide assistance, to quickly address your requests.","buttonText":"Contact Us"},"title":"Contact Us","list":{"0":{"title":"General lnquiry","desc":"Pre-sale; Product Features; Order-related; Logistics Issue; Account issue; Cooperation; Suggestions."},"1":{"title":"Technical Support","desc":"X1, P1, \u0026A1 Series; AMS; AMS lite; Troubleshooting; Error Code; Maintenance; Handy \u0026 Studio; Filaments."}}},"afterSalePolicy":{"title":"After-sales policy"},"deliveryAndReturn":{"title":"Order Delivery \u0026 Returns","desc":"Delivery information, returns \u0026 refunds policy varies by country and region.","shippingInformation":"See shipping information:","ReturnsAndRefundsPolicy":"See returns \u0026 refunds policy:"},"businessCustomer":{"title":"Support for business customers","desc":"If you are a business/professional customer, please use the details below for dedicated business/professional support."},"faq":{"title":"General Inquiry FAQ","desc":"A comprehensive guide to frequently asked questions about our products.","linkText":"Learn more","list":{"0":{"title":"Corporate Sales","list":{"0":{"ques":"Q1: I want to place a purchase order/ apply for a tax-exemption account(B2B Tax-free account)","ans":"A: Apply for a \u003ca href=\"https://bambulab.com/en/corporate-sales\" target=\"_blank\"\u003etax-exempt account\u003c/a\u003e (B2B) to shop on the official website. Bank transfers are not accepted.\u003cbr /\u003e Submit a \u003ca href=\"https://bambulab.com/en/corporate-sales\" target=\"_blank\"\u003epurchase order\u003c/a\u003e and authorized resellers will assist you in the purchasing process. Bank transfers are accepted."},"1":{"ques":"Q2: I applied for a tax-exempt account. How many days does it take to proceed?","ans":"A: After submitting your application, we will process your B2B account within 3 business days and send you a confirmation email once it's completed. We appreciate your patience, and kindly refrain from submitting duplicate requests."},"2":{"ques":"Q3: I have a tax-exempt account. Why is it still showing taxes?","ans":"A: To access the business account, please click the \u003cb\u003ebutton\u003c/b\u003e in the \u003cb\u003eB2B email\u003c/b\u003e. Once logged in, you can find a green B2B symbol in the top right corner of your page. On the checkout page, the final amount will be displayed as the pre-tax amount."},"3":{"ques":"Q4: Can I get the tax refund after my order has been fulfilled?","ans":"A: Please understand that we are \u003cb\u003eunable\u003c/b\u003e to refund taxes for previous orders if your account wasn't tax-exempt, or if you didn't log in with B2B account during the purchase. We can provide invoices. For a refund, kindly reach out to your local tax agency."},"4":{"ques":"Q5: I need to download the invoice","ans":"The \u003cbutton style=\"outline: none; border: none; background: #1c7cfa; color: #fff; padding:3px; border-radius:3px; font-size: 10px;\"\u003eDownload Invoice\u003c/button\u003e button will appear in your account after the order is fulfilled. Upon delivery of your package, we will also send a confirmation email with a download link for the invoice \u003cbutton style=\"outline: none; border: none; background: #00AE42; color: #fff; padding:3px; border-radius:3px; font-size: 10px;\"\u003eDownload My Invoice\u003c/button\u003e. Please note we cannot provide the invoice before shipment."}}},"1":{"title":"Filament Discount","list":{"0":{"ques":"Q1: Filament discount for everyone","ans":"A: The filaments discount is now available to all customers without credit limits. You can enjoy discounted prices even if you want to purchase more than 8 rolls/month. We've also added a discount option for PETG Translucent. Please note that there is no discount for single-roll purchases. For more pricing information, please check \u003ca href=\"https://store.bambulab.com/pages/bambu-filament\" target=\"_blank\"\u003ethis page\u003c/a\u003e."},"1":{"ques":"Q2: Trails of new filament","ans":"A: By subscribing to Bambu Lab's newsletter, you'll have the chance to participate in trials of new filaments before their official launch."}}},"2":{"title":"Payment","list":{"0":{"ques":"Q1: Failed Payment","ans":"A: The following steps may help to resolve the issue:\u003cbr /\u003e1. Update your billing address: Ensure that the billing address you entered during the payment process matches the address associated with your payment card.\u003cbr /\u003e2. Check your shipping address: Make sure there are no abbreviations or errors in your shipping address that could cause issues.\u003cbr /\u003e3. Try a different payment card: If you have another payment card available, try using it to see if the payment goes through.\u003cbr /\u003e4. Clear browser cache: Clear your browser cache before attempting the payment again.\u003cbr /\u003eIf you have followed these steps and are still experiencing payment failure, we recommend contacting your bank for further assistance."},"1":{"ques":"Q2: What are the available payment options, and is it possible to pay in installments?","ans":"A: For details on payment options and \"Buy now, pay later,\" please check the \u003ca href=\"https://us.store.bambulab.com/pages/payment-help#Menu-Payment-help\" target=\"_blank\"\u003ePayment Help\u003c/a\u003e. We offer various payment options, including credit card payments for quick and secure transactions, installment plans for flexible budgeting, and an e-wallet option for easy checkout with a few taps."},"2":{"ques":"Q3: My card has been charged, but I have not received the order confirmation email.","ans":"A: You can check the order history and order number within \"My account\". The email may have been filtered to your spam folder."}}},"3":{"title":"Order Status","list":{"0":{"ques":"Q1: Change/add products to the original order","ans":"A: Once the order processing has started, we cannot make changes to the order. However, if it has been less than two hours since you placed the order, you can cancel it by visiting the \"My Account\" section."},"1":{"ques":"Q2: Change shipping address for order","ans":"A: If it's been less than 2 hours since your order, we suggest canceling it and placing a new one with the correct details.\u003cbr /\u003eIf it's been over 2 hours, you can contact us to try modifications, but we can't guarantee success.\u003cbr /\u003eOnce processing starts, we can only change the name or house number, not the street, district, or city."},"2":{"ques":"Q3: Is it possible to cancel my order","ans":"A: If it has been less then 2 hours since you placed the order, you can cancel it by going to the \"My Account\" section.\u003cbr /\u003eIf your order is not yet confirmed or has not been shipped with an ETD(Estimated Time of Departure), you can contact customer service to attempt a cancellation.\u003cbr /\u003eOnce an order is confirmed, we cannot make any changes to it. If you still want to cancel, you have the option to refuse the delivery. Please note that in the case of a non-defective return, you will be responsible for the round-trip shipping fees."}}},"4":{"title":"Shipping","list":{"0":{"ques":"Q1: No shipping movement for days.","ans":"A: You can access the latest tracking information for your order \u003ca href=\"https://support.bambulab.com/en/orderInquiry\" target=\"_blank\"\u003eHERE\u003c/a\u003e.\u003cbr /\u003eIf your order hasn't shipped, please check the order confirmation email for the Estimated Date of Departure (ETD). We schedule shipments based on this date, and orders with printers and accessories may be sent separately.\u003cbr /\u003eIf your packages have been shipped, shipping status updates may experience delays, particularly during cross-border transportation or handover to the logistics company."},"1":{"ques":"Q2: My region is not within the store's delivery range. How can I purchase a printer?","ans":"A: Please check with authorized dealers for possible delivery options.\u003cbr /\u003eIf you want delivery to a specific area using forwarding, please note that any product issues or accessory needs can only be addressed to the initially provided address and not directly to your country. Additionally, as the shipment is sent to a third-party address, in case of damage during forwarding, investigation and confirmation may not be possible, leading to potential additional expenses. Therefore, we do not recommend this method.\u003cbr /\u003eLink: \u003ca href=\"https://bambulab.com/dealer\" target=\"_blank\"\u003ehttps://bambulab.com/dealer\u003c/a\u003e"}}}}},"wiki":{"title":"Official Wiki","desc":"The authoritative knowledge source about our products, including but not limited to user manuals, maintenance, troubleshooting, and more.","linkText":"Learn more"},"documentation":{"title":"Documentation and User Manuals","desc":"Download product guides and user manuals. Learn how to get your Bambu Lab printer working to its full potential.","linkText":"See all","download":"Download"},"warranty":{"title":"The Bambu Lab Warranty","desc":"All Bambu Lab printers come with a hassle-free warranty. This includes the repair or replacement and ongoing support of your printer. We want to ensure a great service experience for our customers. For this purpose, we have prepared a warranty statement to inform you of our procedures and how we intend to handle warranty requests.","linkText":"Learn more"},"generalInquiry":{"title":"General Inquiry","desc":"Submit a help request and get answers to your questions about our products, order related information. Our customer support team will get back to you as soon as possible.","linkText":"Submit a request"},"technicalSupport":{"title":"Technical Support","desc":"Our technical support team is here to help you resolve any issues with our products, including printers, accessories, filaments, or software. Please let us know what's going on, and we will help you find the best solution here.","linkText":"Start Now"},"forum":{"title":"Official Community Forum","desc":"Share your Bambu Lab experience, prints, ideas and connect with other 3D printing enthusiasts. Join the Official Bambu Lab Community Forum.","linkText":"Join the Forum"},"corporateSales":{"title":"Corporate Sales","desc":"\u003c0\u003eSubmit a \u003c/0\u003e\u003c1\u003eB2B Purchase Order\u003c/1\u003e\u003c2\u003e or apply for a \u003c/2\u003e\u003c3\u003eTax-Exempt online business account\u003c/3\u003e\u003c4\u003e.\u003c/4\u003e","linkText":"Business purchases"},"businessCustomerPortal":{"title":"Business Customer Service","desc":"Our knowledgeable technical support team is committed to providing exceptional service and helping to ensure seamless operations and maximum efficiency. Please contact your sales representative for an immediate solution."},"list":{"0":{"title":"FAQ","desc":"You could find common problems and solutions for X1 series, Filament, Accessories.","buttonText":"Learn more"},"1":{"title":"Official Wiki","desc":"You could find knowledge about Bambu Lab here, including but not limited to user manual, maintenance, troubleshooting, and more.","buttonText":"Learn more"},"2":{"title":"Technical Support","desc":"If you encounter any technical issues regarding our products, including printers, accessories, filaments, or software, please let us know what's going on, and we will help you find the best solution here.","buttonText":"Start Now"},"3":{"title":"Documentation And Manuals","desc":"You can view or download the product description, accessory description and other documents here.","buttonText":"Learn more"},"4":{"title":"Official Community Forum","desc":"You can join the discussion in our Official Community Forum to share ideas, prints and interact with other 3D printing enthusiasts.","buttonText":"Start now"},"5":{"title":"General Inquiry","desc":"If you want to know more about our products or encounter any problems with your order status (payment, logistics, etc.), contact us here and we will reply to you as soon as possible.","buttonText":"Start now"}},"category":{"emptyText":"The current page is empty","support":"Support","h5EmptyText":"Click Here Again","h5EmptyDesc":"Page has been opened"},"articleDetail":{"emptyText":"Oh no, the content has been abducted by aliens. Check out other content."},"nook":{"title":"Fresh Start Guide","list":{"0":"Bambu Handy Quick Start Guide","1":"Bambu Studio Quick Start Guide","2":"Printer Start Guides"}},"buyingGuideEntry":{"title":"FAQs Before Purchase","desc":"Your Essential Pre-Purchase Guide for Bambu Lab Personal Manufacturing Devices","link":"View"},"warrantyEntrance":{"sectionTitle":"Extended Warranty Service","title":"Extra Peace of Mind for Your Worry-Free Creative Journey","subTitle":"The Extended Warranty Service offers additional coverage for your 3D printer once the standard warranty expires, ensuring peace of mind for your creative journey.","desc":{"supportPrinter":"*Currently, this service is available for Bambu Lab H2C, H2D, H2S, P2S, X2D and R1 in our \u003c0\u003eAU, CA, and EU stores\u003c/0\u003e. We are actively working to expand support to more models and regions soon!","agreement":"\u003c0\u003e*Click to view \u003c/0\u003e\u003c1\u003ethe Bambu Lab Extended Warranty Agreement\u003c/1\u003e\u003c2\u003e for more details.\u003c/2\u003e"},"link":{"inquiry":"Service Inquiry","bind":"Activate Now","claim":"Claim Now"}},"buyingGuide":{"return":"Return","title":"FAQs Before Purchase"},"questionnaire":{"dialogTitle":"Feedback","submit":"Submit","success":"Submission successful","title":"Please rate your overall experience","subTitle":"We value your feedback, please feel free to share","feel":{"1":"Very Bad","2":"Bad","3":"Average","4":"Good","5":"Very Good"},"feelRequired":"please select the option","question":{"1":{"title":"Did you find what you were looking for?","options":{"yes":"Yes","no":"No","notFound":"Not Found yet","notFoundPlaceholder":"What would you like us to include?"}},"2":{"title":"How can we make your support center experience better?","options":{"chatbot":"Chatbot","userInterface":"User Interface","content":"Content","videos":"Videos","other":"Other","otherPlaceholder":"Please enter your suggestions or comments.","otherRequired":"Content required for submission"}}}}},"firmware":{"title":"Firmware Download","backText":"Return to Firmware Download","dialog":{"title":"Download Firmware","desc":"Download on the computer for a better experience.","button":"Proceed to download"},"list":{"version":"Version {{version}}","download":"Download","learnMore":"Learn more","historicVersion":"Previous releases"},"faq":{"type":"Information","name":"FAQ"}},"faq":{"head":"Frequently Asked Questions","clickText":{"close":"Click for more","open":"Hide"}},"download":{"download":"Download","learnMore":"Learn more","mainFeatures":"Main features","downloadApp":"Download App","androidVersionText":"Android {{version}} or above.","iosVersionText":"iOS {{version}} or above.","windowsVersionText":"Windows {{version}} (64-bit) or above.","macVersionText":"macOS {{version}} or above.","suite":{"download":"Download Bambu Suite","appName":"Bambu Suite","desc":"Bambu Suite is an intuitive and powerful software that supports laser cutting, blade cutting, pen drawing and so much more. From design and layout to final production, the entire process is seamlessly integrated into a single workflow. Its user-friendly interface and smart guidance make operation easy, while computer-vision-based alignment ensures precision and efficiency at every step, what-you-see-is-what-you-get.","windowsDownloadText":"Bambu Suite (Win)","windowsVersionText":"Windows 10 (64-bit) or above.","macDownloadText":"Bambu Suite (Mac)","macVersionText":"mac os 11.7 or above.","releaseNote":"Release note and historic versions"},"studio":{"download":"Download Bambu Studio","appName":"Bambu Studio","desc":"Bambu Studio is an open-source, cutting-edge, feature-rich slicing software. It contains project-based workflows, systematically optimized slicing algorithms, and an easy-to-use graphical interface, bringing users an incredibly smooth printing experience.","windowsDownloadText":"Bambu Studio (Win)","windowsVersionText":"Windows 10 (64-bit) or above.","macDownloadText":"Bambu Studio (Mac)","macVersionText":"macOS 10.15 or above.","foundOnGithub":"Release history can be found on \u003c1\u003eGithub\u003c/1\u003e","releaseNote":"Download the Linux version from GitHub, or check the latest release notes","lastVersion":"\u003c0\u003eThe latest version of Bambu Studio supports P1S: \u003c/0\u003e\u003c1\u003eWindows\u003c/1\u003e\u003c2\u003e / \u003c/2\u003e\u003c3\u003eMac\u003c/3\u003e\u003c4\u003e.\u003c/4\u003e","munuDesc":"Bambu Studio is an open-source, cutting-edge, feature-rich slicing software. It brings users an incredibly smooth printing experience."},"app":{"download":"Download Bambu Handy","appName":"Bambu Handy","desc":"Bambu Handy is an all-in-one mobile app designed specifically for Bambu Lab 3D printers. With Bambu Handy, you can control your printer anytime anywhere. It makes your printing at hand and at ease.","desc2":"Bambu Handy app is a one-stop 3D printing service platform designed to offer a convenient, seamless, and enjoyable 3D printing experience. With Bambu Handy, you can control printers anywhere, connect to the MakerWorld models library, and print your favorite designs easily!","iosDownloadText":"App Store","iosVersionText":"iOS 13.0 or above.","androidDownloadText":"Android","androidVersionText":"Android 6.0 or above.","munuDesc":"Bambu Handy is an all-in-one mobile app designed specifically for Bambu Lab 3D printers. You can control your printer anytime anywhere."},"cyberbrick":{"mobile":{"title":"CyberBrick Mobile App","subTitle":"Browse, load, and tune—on the go.","desc":"Designed for beginners and hobbyists, the mobile app lets you easily explore ready-to-play community projects.\nFlash your controller core right beside your built model, and wirelessly fine-tune control parameters in real time as you play."},"desktop":{"title":"CyberBrick Desktop App","subTitle":"Create, edit, and publish with efficiency.","desc":"The desktop app offers a spacious interface for full configuration editing, and keeps everything you need—from CAD software to Bambu Studio Slicer—conveniently within reach on your computer.\nPerfect your project, then upload directly to MakerWorld to share it with the community."},"versionText":{"windowsVersionText":"Windows {{version}} or later (ARM processors not supported)","macVersionTextARM":"macOS {{version}} (Big Sur) or above","macVersionTextX86":"macOS {{version}} (El Capitan) or above"},"appName":"CyberBrick Apps","desc":"CyberBrick offers powerful desktop and mobile apps that help creators and players from building to tuning. Create or browse projects, load them into the controller core, and wirelessly tune key parameters in real time.","windowsDownloadText":"Windows","windowsVersionText":"Windows 10 or later (ARM processors not supported)","macDownloadText":"MacOS","macDownloadTextARM":"macOS (Apple Silicon)","macDownloadTextX86":"macOS (Intel or AMD)","macVersionText":"macOS 10.11 (El Capitan) or above","macVersionTextARM":"macOS 11 (Big Sur) or above","macVersionTextX86":"macOS 10.11 (El Capitan) or above","iosDownloadText":"iOS","iosVersionText":"iOS 13.0 or above.","androidDownloadText":"Android","androidVersionText":"Android 6.0 or above."}},"home":{"ksEmail":{"placeholder":"Enter Your Email","subscribe":"Subscribe","privacyPolicy":"I agree to comply with the \u003c2\u003eBambu Lab Privacy Notice\u003c/2\u003e and \u003c5\u003eTerms of use\u003c/5\u003e.","required":"Email is Required","validEmail":"Email must be a valid email","needAgreePrivacyPolicy":"You need agree to Privacy Notice","success":"Thanks for Subscribing"},"X1SeriesSection1":{"buy":"Shop Now","title":"\u003c0\u003eBambu Lab X1 \u003c/0\u003e\u003c1\u003eSeries\u003c/1\u003e","advantages":{"1":{"title":"16 Multi Color","value":"16","key":"Multi Color"},"2":{"title":"7 μm Lidar Resolution","value":"7 μm","key":"Lidar Resolution"},"3":{"title":"CoreXY 20 m/s² Acceleration","value":"20 m/s²","key":"CoreXY"},"4":{"title":"Dual Auto Bed Leveling","value":"Dual-ABL","key":"Auto Bed Leveling"}}},"KickStarterSection2":{"preOrder":"Pre-order for X1C Combo is Open!","subscribe":"Subscribe to receive the latest updates from Bambu Lab."},"X1SeriesSection2":{"title":"\u003c1\u003ePrologue:\u003c/1\u003e\u003c2\u003eWe hated 3D printing\u003c/2\u003e\u003c3\u003eas much as we loved It.\u003c/3\u003e","goalsTitle":"We set 5 goals before we set off on this journey 22 months ago:","goals":{"0":"No more Bed-Slingers","1":"No more bloodshed during support removal","2":"Sleep soundly during over-night prints","3":"Bring color back into the community","4":"Stiff PA-CF parts for my Nerf blaster"}},"Chapter1Section1":{"chapter1":"Chapter 1:","chapter1Text":"Colors \u0026 Beyond"},"Chapter1Section2":{"desc":"\u003c0\u003eColor\u003c/0\u003e\u003c1\u003e, the ultimate expression of emotions, is brought to you by Bambu Lab's\u003c/1\u003e\u003c2\u003e Automatic Material System (AMS).\u003c/2\u003e\u003c3\u003e You can now enjoy \u003c/3\u003e\u003c4\u003e printing freely in multiple colors and materials, \u003c/4\u003e\u003c5\u003e a 3D Printing Maestro.\u003c/5\u003e","iconDesc":{"1":"Airtight","2":"Humidity Sensor","3":"Parallel 4*4","4":"2-Stage Feeding","5":"Filament Buffer"}},"Chapter1Section3":{"swiperOptions":{"1":{"title":"Neuschwanstein Castle"},"2":{"title":"Ossum Rear Axle Mk III"},"3":{"title":"Kaiju"},"4":{"title":"Differential Gear"},"5":{"title":"Raspberry Pi 4 Case \u0026 Stands"},"6":{"title":"Jet Engine"}}},"Chapter1Section4":{"title":"Removing supports has never been easier.","subTitle":"Bambu Lab X1 can use snap-away support material or dissolvable filament to minimize the pain of removing supports."},"Chapter1Section5":{"title":"Advanced processes enable advanced materials.","subTitle":"Breaking free from low temperature and easy print PLA and PETG, the X1 unlocks more demanding material by utilizing advanced parts and sophisticated thermal control.","swpierLabel":{"1":"All-Metal Hotend","2":"Hardened Steel Nozzle","3":"Hotbed","4":"Chamber Temperature","5":"Auxiliary Part Cooling Fan"}},"Chapter1Section6":{"title":"Advanced materials empower advanced projects.","swpierItem":{"1":{"label":"PA-CF","value":"Super rigid but abrasive\ncarbon fiber filament"},"2":{"label":"PA","value":"Tough and self-lubricating\nbut highly hydroscopic PA"},"3":{"label":"PC","value":"Highly temperature resistant\nbut easily warped PC"},"4":{"label":"Polymers","value":"Multiple polymers for multiple\napplications in one project"}}},"Chapter2Section1":{"title":"Chapter 2:","subTitle":"AI-Powered Evolution","iconDesc":{"1":"Micro lidar","2":"IMU","3":"2Tops NPU","4":"quad core  ARM"}},"Chapter2Section2":{"title":"\u003c0\u003eA Lidar that measures \u003c/0\u003e\u003c1\u003edepth in micrometers.\u003c/1\u003e","subTitle":"Bambu Micro Lidar brings micrometer level precision into 3D printing. The system probes the nozzle height, calibrates the flow, and scans the first layer, so the possibilities are endless."},"Chapter2Section3":{"title":"Dual automated bed leveling for doubly guaranteed prints.","subTitle":"Bambu Lab X1 utilizes two sets of independent sensors and an algorithm to measure the height of the nozzle relative to the bed. The lidar and analog force sensors crosscheck for an extra layer of redundancy in bed leveling."},"Chapter2Section5":{"title":"AI inspected first layer.","subTitle":"Tired of waiting out that first layer? Bambu Lab X1 has got your back. The lidar sensor can check your first layer so that you can get back to doing…anything else.","tagOptions":{"1":{"label":"Higher than the first layer height."},"2":{"label":"Lower than the first layer height."}}},"Chapter2Section6":{"title":"Spaghetti detection.","subTitle":"Our AI keeps an eye out for Spaghetti monsters, so you can sleep easy in the knowledge that your printer is safe from this scourge.","tagOptions":{"1":{"label":"A spaghetti failure is detected with confidence of 86%."}}},"Chapter2Section7":{"title":"Stay in the loop.","subTitle":"Wherever you go, warnings are pushed to your mobile phone, and you can access the video feed from anywhere."},"Chapter3Section1":{"title":"Chapter 3:","subTitle":"Designed for Speed","paramsOptions":{"1":{"value":"CoreXY","label":"Welded Chassis"},"2":{"value":"\u003c0\u003e32 mm\u003c/0\u003e\u003c1\u003e3\u003c/1\u003e\u003c2\u003e/s\u003c/2\u003e","label":"Flow"},"3":{"value":"\u003c0\u003e20 m/s\u003c/0\u003e\u003c1\u003e2\u003c/1\u003e","label":"Acceleration"},"4":{"value":"500 mm/s","label":"Velocity"}}},"Chapter3Section2":{"demo":{"1":{"label":"Kaiju: 85 x 26 x 42 cm ","value":"70 hours"},"2":{"label":"Benchy","value":"16 mins 30 s"},"3":{"label":"Dragon","value":"3 hours"}}},"Chapter3Section3":{"title":"\u003c0\u003eHow did we get\u003c/0\u003e \u003c1\u003esuch a speed boost?\u003c/1\u003e","optionsText":{"1":"\u003c0\u003eUltra Lightweight\u003c/0\u003e \u003c1\u003eCarbon Rail\u003c/1\u003e","2":"\u003c0\u003e40 W Ceramic\u003c/0\u003e \u003c1\u003eHeater\u003c/1\u003e","3":"\u003c0\u003ePowerful 12 W\u003c/0\u003e \u003c1\u003eCooling Fan\u003c/1\u003e","4":"\u003c0\u003eWelded Steel\u003c/0\u003e \u003c1\u003eXY Chassis\u003c/1\u003e"}},"Chapter3Section4":{"title":"\u003c0\u003eSpeed \u003c/0\u003e\u003c1\u003emeans \u003c/1\u003e\u003c2\u003ea lot.\u003c/2\u003e","desc":{"1":"\u003c0\u003eUse one printer to\u003c/0\u003e\u003c1\u003e replace several \u003c/1\u003e\u003c2\u003eand \u003c/2\u003e\u003c3\u003ehave the same productivity.\u003c/3\u003e","2":"\u003c0\u003e\u003c/0\u003e\u003c1\u003eLess waiting time \u003c/1\u003e\u003c2\u003e means \u003c/2\u003e\u003c3\u003efast iteration. \u003c/3\u003e","3":"\u003c0\u003eUse 0.1 mm layer height by default\u003c/0\u003e\u003c1\u003e without worrying about the print time. \u003c/1\u003e","4":"\u003c0\u003e\u003c/0\u003e\u003c1\u003eLess time means less carbon emission\u003c/1\u003e\u003c2\u003e to keep the bed hot.\u003c/2\u003e"}},"Chapter4Section1":{"title":"Chapter 4:","subTitle":"Redefine Smooth"},"Chapter4Section2":{"title":"The secret behind the smoothness.","swiperOptions":{"1":{"label":"Active Vibration\nCompensation (XY)"},"2":{"label":"Precise Layer\nHeight (Z)"},"3":{"label":"High Bandwidth\nFlow Control (E)"},"4":{"label":"Smoothness"}}},"Chapter4Section3":{"title":"\u003c0\u003eBy the way, we can now \u003c/0\u003e\u003c1\u003ecut print time in half \u003c/1\u003e\u003c2\u003ewhile keeping layer height \u003c/2\u003e\u003c3\u003eat 0.1 mm.\u003c/3\u003e"},"Chapter5Section1":{"title":"Chapter 5:","subTitle":"A Printer for Everyone"},"Chapter5Section2":{"title":"Out of the box","subTitle":"The X1 is assembled, tuned, calibrated, and tested before being shipped to you, so you can enjoy printing right out of the box."},"Chapter5Section3":{"title":"Print from anywhere with any device","subTitle":"You can send prints by Bambu Studio ，and you can control your printer anytime anywhere  with Bambu Handy ,also we support SD card and  local network to print the projects"},"Chapter5Section4":{"title":"It's time to embrace 3MF.","subTitle":"In the STL era, you had to manage model files, printing parameters, assembly instructions, license information, and model pictures in different places with different software. With natively supported 3MF being its default, the X1 saves you all this trouble, and you can now manage your whole project on one cloud."},"Chapter6Section1":{"title":"Chapter 6:","subTitle":"\u003c0\u003eEco-Friendly Printing \u003c/0\u003e\u003c1\u003ein Mind\u003c/1\u003e"},"Chapter6Section2":{"list":{"1":{"title":"80% Cut","subTitle":"Carbon Footprint"},"2":{"title":"20%","subTitle":"Plastic Saved"},"3":{"title":"50dB","subTitle":"In Silent Mode"},"4":{"title":"VOCs Filter","subTitle":"Activated Carbon Filter Absorbs VOCs"}}},"KickStarterSection1":{"title":"Epilogue:","subTitle":"The Beginning of a New Era","questions":{"1":{"question":"Do all those smart features completely eliminate tinkering and tuning?","answer":"No."},"2":{"question":"Is this printer as reliable as a photo copier?","answer":"No."},"3":{"question":"Is this the printer you guys dream of?","answer":"Not there yet."},"answer":""},"title2":"But we are proud of X1!","subTitle2":"We are still far from our final goal, but the X1 makes the first step, a very daring leap. We hope the X1 will be a milestone leading to a new era in 3D printing."},"KickStarterSection3":{"title":"Tech specs of the X1 Series","learnMore":"Learn more"},"KickStarterSection4":{"title":"Acknowledgement","desc1":"We express our thanks to the 3D printing community. We have learned a lot about 3D printing from YouTube channels, Reddit discussions, and open source projects. We would like to thank Teaching Tech; his calibration page inspired us to implement the Lidar to do the all important calibrations automatically. We would also like to thank MirageC. If it had not been for his HevORT's stunning performance, we would not have set our target acceleration to 20 m/s^2 two years ago. Finally, we would like to thank the Voron team. We have done many feasibility analyses and evaluation experiments on a Voron 1.8 during the early days of this project.","desc2":"Creative Commons licensed models are the cornerstones of desktop 3D printing. Countless times, we used these models to test our prototypes, to benchmark their performance, and now to promote features. We list all the attributions of all the models used in this web page below:"}},"homePage":{"email":{"placeholder":"Enter Your Email","subscribe":"Subscribe","privacyPolicy":"\u003c0\u003eI agree to \u003c/0\u003e\u003c1\u003eTerms of Use\u003c/1\u003e\u003c2\u003e and \u003c/2\u003e\u003c3\u003ePrivacy Notice\u003c/3\u003e\u003c4\u003e.\u003c/4\u003e","marketingConsent":"\u003c0\u003eI consent to receive marketing emails about Bambu Lab \u0026 MakerWorld's products, services and more. To understand our privacy practice, see \u003c/0\u003e\u003c1\u003ePrivacy Notice\u003c/1\u003e\u003c2\u003e.\u003c/2\u003e","required":"Email is Required","validEmail":"Email must be a valid email","needAgreePrivacyPolicy":"You need agree to Privacy Notice","success":"Thanks for Subscribing"},"inspirations":{"sectionTitle":"What You Can Do with 3D Printing","title":"Inspirations","desc":"Explore the unleashed creativity of our beloved users from around the world!"},"freshStart":{"sectionTitle":"New to 3D Printing? \nThis Is the Place to Start","title":"Fresh Start","desc":"New to 3D printing? This is the place to start."},"awards":{"title":"Awards \u0026 Reviews"},"videos":{"sectionTitle":"Check Out What the Pros Are Saying","title":"Inspirations From Content Creators","desc":"Checkout some of the most interesting projects \u0026 stories."},"blogs":{"title":"Bambu Lab Blog","learnMore":"Learn more"}},"qrCode":{"appName":"Bambu Handy","downloadText":"Download APP","appsInstalled":"App already installed?","openNow":"Open Now","openNowVersion":"Bambu Handy 1.0.7 or above.","termsAndConditionsTitle":"Terms And Conditions","termsAndConditions":"Thank you for purchasing a Bambu Lab device. Please read the following terms before using your device. By clicking \"Agree\" or by using your Bambu Lab device, you agree to be bound by the \u003c1\u003ePrivacy Notice\u003c/1\u003e and \u003c3\u003eEnd-User Software Licensing Agreement\u003c/3\u003e (together, the \"Terms\").If you are not eligible or do not agree to any of the Terms or the Bambu Privacy Notice, then you may not use the service, and do not use the Bambu Lab device."},"footer":{"email":{"title":"Be the first to receive our latest product updates, newest offerings, free product trials and more.","placeholder":"Enter Your Email","subscribe":"Sign Up","required":"Email is Required","validEmail":"Email must be a valid email","success":"Thanks for Sign Up – Please Check Your Email"}},"index":{"printer":{"title":"3D Printer","desc":"Advanced printers empower advanced projects","link1":"Learn more","link2":"Buy now"},"filament":{"title":"Filament","desc":"3D printing materials with excellent quality, performance \u0026 ease of use","link1":"Buy now"},"ams":{"title":"AMS \u0026 Accessories","desc":"Upgrade your printer with advanced parts","link1":"Buy now"},"gallery":{"title":"Bambu Lab Gallery","desc":"Share your prints on social media with #bambutiful or #bambuseful for a chance to be seen here.","swiper":{"createdBy":"Model created by ","printedBy":"Printed by "}},"videoContent":{"title":"We hated 3D printing as much as we loved It.","desc":"We set 5 goals before we set off on this journey, and we are still far from our final destination.  We made the first step, a very daring leap leading to a new era in 3D printing.","playText":"Watch Video","buttonText":"Read X1 Story"},"awards":{"title":"Awards \u0026 Reviews","desc":"\"Not only because it offers a fresh take on what a 3D printer could and should be but because it has shown that more is possible.\" — ALL3DP "}},"x1":{"printer":{"title":"Bambu Lab X1 Series"}},"p1":{"printer":{"title":"Bambu Lab P1P","richTitle":"\u003c0\u003eBambu Lab \u003c/0\u003e\u003c1\u003eP1P\u003c/1\u003e","desc":"Your one-of-a-kind 3D Printer","descUS":"Receive early bird gifts with purchase.","earlyBird":"Early Bird","price":"$699","priceCN":"3999","buyNow":"Buy now","subTitle":"Be the first to know when it's ready. Get priority access and receive early bird gifts on launch day. ","successTitle":"\u003c1\u003eYou're on the list! \u003c/1\u003e\u003c2\u003eShare the news with your friends.\u003c/2\u003e","desc1":"Open frame that opens up possibilities for endless customization.","desc2":"","emailText":"Subscribe to receive the latest updates from Bambu Lab"},"email":{"placeholder":"Enter Your Email","subscribe":"Sign Up"},"video":{"desc":"Almost every 3D printing maker started with a fantasy of printing amazing things. With the new Bambu Lab P1P,  it has never been easier to 3D print your dream and customize your own 3D printer."},"mainFeature":{"title3":"Advanced Technologies","images":{"1":{"title":"Right out of the box","value":"15 mins","desc":"You don't have to LOVE the tinkering process. It just works right out of the box. Enjoy happy printing every day and great all-around quality."},"2":{"title":"Multi-color Capability","value":"16 Colors","desc":"Enjoy up to 16 color-printing with the connection of Bambu Lab Automatic Material System (AMS). Get colorful prints with easy plug-and-play."},"3":{"title":"Bambu Lab Quality","value":"18 mins 24 s","desc":"It is not only ultra-fast but also prints in exceptional quality."},"4":{"title":"with Bambu Official Enclosure","value":"Expand printing possibilities","desc":"The enclosure allows you to print advanced filaments with ease, giving you the freedom to explore new materials and designs."}},"data":{"1":{"title":"CoreXY up to 20000 mm/s² Acceleration","desc":"The P1 series inherits the proven kinematics and motion control system of the Bambu Lab Flagship printer. It prints with a top speed of 500 mm/s, the acceleration from zero to 500 mm/s takes just 0.025 seconds."},"2":{"title":"Vibration Compensation \u0026 Pressure Advance","desc":"The active vibration compensation (XY) algorithm and pressure advance guarantees extra smoothness and gets you good prints."},"3":{"title":"Direct-drive Extruder","desc":"With the design that the motor is directly connected to the extruder, P1 series has better control on the extrusion and retraction of flexible filaments. Precise and consistent extrusion for smooth and no-blur prints."},"4":{"title":"Succeed with a Perfect First Layer","desc":"The automatic bed leveling(ABL) sensor calibrates and levels the bed properly, making you a perfect first layer for every 3D print."},"5":{"title":"Bambu Studio \u0026 Handy","desc":"Connect with Bambu slicing software and mobile app to control your printer and monitor the prints.","linkText":"Learn more"}},"more":{"1":{"title":"\u003c0\u003eAll-metal \u003c/0\u003e\u003c1\u003eHotend\u003c/1\u003e","desc":"Durable material made to support long-time 3D printing filaments including ABS, carbon fiber at high temperatures. It provides accurate and smooth extrusion to achieve quality printing performance."},"2":{"title":"\u003c0\u003eFilament Run-out \u003c/0\u003e\u003c1\u003eSensor\u003c/1\u003e","desc":"Eliminate the problem of empty spools during printing. Change filament when empty and Resume."},"3":{"title":"\u003c0\u003ePower Loss \u003c/0\u003e\u003c1\u003eRecovery\u003c/1\u003e","desc":"Worry-free from a power cut-off, you can resume the print from where it left off."},"4":{"title":"\u003c0\u003eSemi-automatic \u003c/0\u003e\u003c1\u003eBelt Tensioning\u003c/1\u003e","desc":"The tension of the belt is essential for ensuring dimensional accuracy. Resonance frequency identification runs every time to help maintain the correct tension."},"5":{"title":"\u003c0\u003eFans with  \u003c/0\u003e\u003c1\u003eSpeed Feedback\u003c/1\u003e","desc":"The speed feedback sensor monitors the fan's speed ensuring that the fan is able to operate at its optimal speed at all times."},"6":{"title":"\u003c0\u003eLiveview \u003c/0\u003e\u003c1\u003e\u0026Time-lapse\u003c/1\u003e","desc":"The built-in chamber camera enables easy print monitoring on Bambu Studio and Handy, and timelapse video creation."}},"advanced":{"title":"\u003c0\u003eAdvanced \u003c/0\u003e\u003c1\u003eUpgrades Available\u003c/1\u003e","desc":"Upgrade P1P with advanced parts to make it even better. Get essential electronic components from the official store and 3D print the other parts to assemble them yourself.","buttonText":"Download Printable Parts"}},"compare":{"buildVolume":"Body","speed":"Speed","toolhead":"Toolhead","cooling":"Cooling \u0026 Filtration","supportedFilaments":"Supported Filaments"},"review":{"title":"Bambu Lab P1P Review","desc":"Customize and 3D print the side panels of P1P with your magic touch. Select a Modplate template to print or design your one-of-a-kind side panels.","card":{"1":{"text":"I'm into 3d printing for many years and I had very good results. But the X1 is a mindbending miraculous machine. The speed, the quality, the ease of use, the speed again, the leap in technology and the speed... What did the other manufacturers even do the last five years? It feels like driving a tesla when you're used to horse riding."},"2":{"text":"Received my printer this week and I have a problem with it and wanted to know if anyone else is in the same boat as me. My issue is it works straight out the box with no countless hours lost messing about with the settings and I’ve already gone through 2kg of filament printing models that were near impossible on my old fdm printers. There should be a warning on the box that it’s going to cost a lot of money for more rolls of filament"},"3":{"text":"In my mind, this printer/team has redefined what an off-the-shelf printer is, challenged the current standards, and begun a new level of expectations in the industry."},"4":{"text":"I don't want to screw around with a machine, I went to design and bring those designs to life."},"5":{"text":"I cannot wait to see what this team comes up with next."}}},"customizePrinter":{"title":"Made by Bambu Lab Created by You","desc":"Customize and 3D print the side panels of P1P with your magic touch. Select a Modplate template to print or design your one-of-a-kind side panels.","downloadButton1":"Download Modplate","downloadButton2":"Download P1P Model","printer":{"1":"Pixel Modplate","2":"Armor Modplate","3":"Pegboard","4":"Artistry Modplate","1-1":"Flowing Flame","1-2":"Autumn Flowers","2-1":"Lake Blue","2-2":"Meteorite Grey","2-3":"Hot Rod Red ","2-4":"Earth Brown ","3-1":"White","3-2":"Black","4-1":"Bambu Lab Edition","4-2":"Lily"}},"events":{"1":{"title":"\u003c1\u003eComing soon before Christmas.\u003c/1\u003e\u003c2\u003eJoin our waitlist to know when we launch.\u003c/2\u003e","desc":"And receive early bird gifts on launch day!"},"title":"Latest Events","seeMore":"Learn more"},"techSpecs":{"title":"Tech Specs","compare":"Compare all printers","buyNow":"Buy now"},"questions":{"title":"Frequently Asked Questions","learnMore":"Learn more"},"shareContent":{"shareText":"Discuss more about the P1P in the community","facebook":"@bambulab3D launches a new 3D printer P1P! Go check it out.","twitter":"@BambulabGlobal launches a new 3D printer P1P! Go check it out. ","weibo":"Bambu Lab发布了新品3D打印机P1P，快来围观！","emailTitle":"Bambu Lab will be launching a new 3D printer P1P!","emailContent":"Join the waiting list to get notified about it when ready and priority in the pre-order announcement, including early bird gifts on launch day! "},"videoSwiper":{"title":"Ways to Get Started"}},"p1s":{"printer":{"title":"Bambu Lab P1S","desc1":"Fully enclosed body which improves print performance for advanced filaments.","richTitle":"\u003c0\u003eBambu Lab \u003c/0\u003e\u003c1\u003eP1S\u003c/1\u003e","emailSubTitle":"Be the first to know when it's ready. Stay tuned for updates.","footerDesc":"Well-polished and matured hardware and software based on real-world feedback."},"email":{"success":"You're on the list- Please check your email for updates!"}},"a1":{"printer":{"title":"Bambu Lab A1","richTitle":"\u003c0\u003eBambu Lab \u003c/0\u003e\u003c1\u003eA1\u003c/1\u003e","desc":"A Colorful Gateway to 3D Printing","footerDesc":"Buy now in official store","buyNow":"Buy now","preOrderFooterDesc":"Pre-order in official store","preOrder":"Pre-order"},"header":{"overview":"Overview","moreToKnow":"Tech Details","funFacts":"Fun Facts","addOn":"Add-on","techSpecs":"Tech Specs","buy":"Buy","faq":"FAQ"},"banner":{"watchVideo":"Watch video","buyNow":"Buy now","preOrder":"Pre-order"},"gallery":{"title":"See What You Can Do \nWith A1","card":{"1":{"name":"「Panzerkampfwagen IV」","author":"Model available in MakerWorld","time":"13 hours"},"2":{"name":"「Marble Run」","author":"Mystery Box Model","time":"1 day 13 hours"},"3":{"name":"「LED Lamp」","author":"Mystery Box Model","time":"6 hours"},"4":{"name":"「Air Command Tower - Wireless Charger」","author":"Model created by @30 3D Print - YouTube","time":"6 hours"},"5":{"name":"「Good Vibes Only LightBox」","author":"Model created by @braga3dprint","time":"4.5 hours"},"6":{"name":"「Phone Rig Set - Cage/Filter ring/Handle」","author":"Model created by @Zemister/@plucbernier/@FF3D","time":"5 hours"},"7":{"name":"「RC Santa Snowcat」","author":"Model created by Bambu Lab","time":"1 day "},"8":{"name":"「Triple-axis Tourbillon」","author":"Mystery Box Model by mcmaven","time":"1.5 day "}}},"amslite":{"sectionTitle":"AMS lite","title":"Multi-Color Printing For Everyone","desc":"The all-new AMS lite is elegant and reliable, making multi-color 3D printing accessible to everyone.","createBy1":"Model created by @Terrain2STL","createBy2":"Model created by @CMDesigns","createBy3":"Model created by @Flexifactory","createBy4":"Model created by @KOZA","createBy5":"Model created by @Sid Naique","createBy6":"Model created by @3_D_M_A"},"fullAutoCalibrations":{"1":{"sectionTitle":"Full-Auto Calibration","title":"Goodbye to Tedious Manual Calibration And Tuning","desc":"A1 handles various calibrations all by itself. It meticulously calibrates the Z-offset, bed-level, vibration resonance and nozzle pressure for EVERY print job, automatically."},"2":{"sectionTitle":"Auto Bed-Level","title":"Goodbye to Tedious Manual Calibration And Tuning","desc":"A1 handles various calibrations all by itself. It meticulously calibrates the Z-offset, bed-level, vibration resonance and nozzle pressure for EVERY print job, automatically. "},"3":{"sectionTitle":"Auto Z-Offset","title":"No More \"Paper Method\"","desc":"A1 probes the bed with the nozzle to measure the absolute Z-offset. No need to stick a paper as reference."},"4":{"sectionTitle":"Auto Vibration Calibration","title":"Auto Tune Both X \u0026 Y Resonance Before Every Print","desc":"A1 has sensors in toolhead and heatbed. One of the very first bed-slinger printers to run auto resonance calibration on both X \u0026 Y axes.","watchVideo":"Watch video"},"5":{"sectionTitle":"Auto Flow Dynamics","title":"Fully Automated PA (Pressure Advanced) Calibration","desc":"First of its kind, A1 runs the nozzle pressure based flow dynamics calibration algorithm. No need to draw any pattern or get any manual pick \u0026 match involved, A1 handles Pressure Advanced calibration automatically."},"6":{"sectionTitle":"Auto Belt Tension","title":"Auto Monitoring And Adjusting The Belts","desc":"A1 can check the belt tension automatically through the vibration frequency calibration. If the belt tension is loose the HMS system will notify you to adjust the auto belt tensioner."},"7":{"sectionTitle":"Auto Filament Loading","title":"Load/Unload Filament With One Touch","desc":"No manual setting involved, A1 fully automated the filament load/unload process."}},"compensation":{"sectionTitle":"Active Flow Rate Compensation","title":"Print Smooth At Every Corner, Always","desc":"The A1 revolutionizes flow control in 3D printing. It utilizes a high-resolution, high-frequency eddy current sensor to measure the pressure in the nozzle. Our algorithm actively compensates the flow rate according to the readings to extrude with accuracy."},"highSpeedPrecision":{"sectionTitle":"High-speed Precision","title":"Bed Slinger with CoreXY Speed And Quality","desc":"Full-metal Rails, Rigid frame, nozzle pressure sensor, accelerometers, powerful MCU, and above all, an advanced motion control system that utilizes these features to print a 14-minute benchy with quality and following all the speed benchy rules straight out of the box without using specialized filaments."},"intuitiveUI":{"sectionTitle":"Intuitive UI","title":"As Easy As Your Smart Phone","desc":"A1 now has a simplified touchscreen UI system that walks you through all the hurdles. You don't have to be a 3D printing expert to use the A1. "},"worryFreePrinting":{"sectionTitle":"Worry-free Printing","title":"Start And Relax","desc":"Bambu Lab printers are well known for the worry-free printing experience that has been widely praised by our fantastic userbase. Check out what our users have to say about our printers on the market!","comment":{"1":"The A1 Mini is an exceptional printer, very quiet, very good print quality. I have just printed the Bambu Lab Christmas Cabin on it, it took around 19 hours to print on 9 plates and 3 hours to glue it together, but it is very nice. Even the very small items stick very well to the bed. ","2":"Well finally finished a larger print! Printed most of this one with the A1 mini since the P1P was turning into a P1S. Lol. Turned out awesome! Printed at a 100% and it’s pretty big! Printed amazing! Now I need a good shelf to display it!","author1":"——Facebook User Group","author2":"——Facebook User Group"}},"makerWorld":{"sectionTitle":"MakerWorld","title":"1-Click Away From Printing","desc":"Introducing MakerWorld, the next-gen 3D model platform with 1-click printing straight from the Bambu Handy App. In addition to this new platform, you can always use Bambu Studio and Bambu Handy App to manage your printers anytime, anywhere.","learnMore":"Learn more"},"printSilently":{"sectionTitle":"Print Silently","title":"Active Motor Noise Canceling","desc":"Active Motor Noise Canceling and Silent Mode can bring down the noise level to under 48 dB making A1 one of the quietest 3D printers on the market, so you can take a nap while your printer is working hard."},"swiftMaintenance":{"1":{"sectionTitle":"Swift Maintenance","title":"Quick Swap Nozzles","desc":"All-new quick swap hotend design, the hotend pops in and out with just 1 clip. "}},"privacy":{"1":{"sectionTitle":"Privacy","title":"Easy To Use Off The Internet","desc":"If you do not like the concept of Cloud printing, you can use LAN mode for remote control / live view and send jobs to your A1 without the need for cloud communication."},"2":{"sectionTitle":"Privacy","title":"Camera Lens Cover","desc":"Forget about the sticker, physically block the camera with a simple mechanism."}},"reliability":{"sectionTitle":"Reliability","title":"All-Metal Frame, Bearings and Rails","desc":"We spent extra to bring you the most reliable All-metal rails and cover protected drive system. You get Bambu Lab performance out of the box, designed for consistency and longevity."},"cardSection":{"1":{"title":"All-metal Rail System","desc":"The rails are the most important factor affecting the lifespan and accuracy in 3D printers, as they need to ensure the system's rigidity during the printing process, while constantly withstanding the wear brought by high-speed motion. The A1 utilizes all-metal rails, incorporating high-quality linear rail on the X axis, twin all-metal linear rods on the Z axis and a twin row all-metal linear guide on the Y axis. These rail systems ensure that the A1 doesn't require frequent adjustments by the users; regular lubrication alone can guarantee the printer's precision and lifespan."},"2":{"title":"Active Vibration Compensation","desc":"Active Vibration Compensation, similar to Input Shaping found in other firmwares, is the key to fast printing. To compensate for the vibration of the printer, the control system needs to know the vibration characteristics of the system, such as the natural frequency and amplitude of all axes. You can set the parameters when the printer is produced and adhere to them. However, these parameters may drift due to environmental temperature fluctuations, changes in belt tension, or even variations in the mass of the build plate. To guarantee the optimal parameters for superior print quality, we have installed sensors on both the toolhead and the heatbed, allowing for the measurement of the parameters of the X and Y axes before every print."},"3":{"title":"Comprehensive Filament Monitoring","desc":"Everyone knows that a clogged nozzle or a tangled spool of filament can ruin an entire fine print.Traditional filament run out sensor can only cover a limited number of failure scenarios. In the A1 and AMS lite, we have introduced a comprehensive filament monitoring system. This includes a filament tension sensor on the toolhead, a filament position sensor before the extruder, and a nozzle pressure sensor situated between the extruder and the nozzle. Additionally, the AMS lite is equipped with a filament odometer. These sensors, combined with advanced algorithms, can promptly detect potential issues such as filament tangling and breakage, and extruder skipping, safeguarding the quality of each print."},"4":{"title":"RFID Sync","desc":"While AMS lite is compatible with most filaments brands on the market, it uses RFID to detect Bambu Filament with RFID tag, and automatically apply the best suited settings for them. It also enable you to monitor the filament usage, remotely."},"5":{"title":"Full-Auto Leveling","desc":"The A1's full-auto ABL uses nozzle as the probe, which measures absolute distance. Bed leveling is fully automatic with zero manual adjustment needed."},"6":{"title":"Active Flow Rate Compensation","desc":"Unlike the linear and Newtonian movement of the XYZ axes, the viscous flow of the melted plastic is non-Newtonian. The amount of plastic pushed into the hot end by the extruder doesn't necessarily equate to the amount flowing out of the nozzle, especially at high accelerations. This discrepancy can lead to swollen corners and artifacts where the speed changes. This is where active flow rate compensation comes into play. It helps to predict and adjust the flow of the molten plastic, facilitating more accurate extrusion. Previously, we used to print straight lines with acceleration and measure the line's width to calibrate the parameters for compensation - a process that was time-consuming and wasted space on the build plate. In the A1, we employ a novel method to measure the nozzle pressure, allowing us to directly obtain the necessary parameters before each print, saving time and preserving build plate space."},"7":{"title":"Active Motor Noise Canceling","desc":"The stepper motor tends to be noisy, particularly at high speeds. By using the motor drive to inject specific high-frequency movements into the motor, we can negate a substantial portion of the noise, provided we understand the detailed characteristics of each motor. However, every motor has its own unique noise fingerprint. The A1 is equipped with sensors and algorithms capable of identifying the minute individual differences in each motor during calibration. This information is then utilized to cancel out a portion of the noise generated by the motor."},"8":{"title":"Real-time Monitoring","desc":"You can remotely control and monitor your A1 with the Bambu Handy App or Bambu Studio. You can see what's going on even if you're not on site."}},"highlightOverview":{"title":"Highlight Overview","card":{"1":{"title":"AMS lite","desc":"Print Multi-Color"},"2":{"title":"Full-Auto Calibration","desc":"No Manual Adjustment"},"3":{"title":"Active Flow Rate Compensation","desc":"Smooth At Every Corner"},"4":{"title":"High-Speed Precision","desc":"10000 mm/s² Acceleration"},"5":{"title":"Print Silently","desc":"Silent Mode Under 48 dB"},"6":{"title":"Reliability","desc":"Bambu Lab Quality You Can Trust"},"7":{"title":"MakerWorld","desc":"Start Printing With A Single Click"}}},"optionalAMSTopMount":{"sectionTitle":"Optional AMS Top Mount","title":"One More Thing","desc":"For those who want to install their AMS lite unit on top of their A1 printer, we offer the top mount bracket set. This set of printable components allows you to safely mount your AMS lite on top of the A1.","downloadModel":"Download Model"},"techSpec":{"title":"Technical Specifications","name":"A1"}},"a1Mini":{"printer":{"title":"Bambu Lab A1 mini","richTitle":"\u003c0\u003eBambu Lab \u003c/0\u003e\u003c1\u003eA1 mini\u003c/1\u003e","buyNow":"Buy now","preOrder":"Pre-order"},"gallery":{"title":"See What You Can Do \nWith A1 mini"},"amslite":{"desc":"The all-new AMS lite is elegant and reliable, making multi-color 3D printing accessible to everyone."},"plugNPlay":{"sectionTitle":"Plug-N-Play","title":"Turn the once steep learning curve into a enjoyable journey","desc":"The A1 mini comes to you pre-assembled, pre-squared, and pre-tuned with precision. It only takes about 20 minutes to set up for your first print."},"fullAutoCalibrations":{"1":{"desc":"A1 mini handles various calibrations all by itself. It meticulously calibrates the Z-offset, bed-level, vibration resonance and nozzle pressure for EVERY print job, automatically. "},"2":{"desc":"A1 mini handles various calibrations all by itself. It meticulously calibrates the Z-offset, bed-level, vibration resonance and nozzle pressure for EVERY print job, automatically. "},"3":{"desc":"A1 mini probes the bed with the nozzle to measure the absolute z-offset. No need to stick a paper as reference."},"4":{"desc":"A1 mini has sensors in toolhead and heatbed. One of the very first bed-slinger printers to run auto resonance calibration on both X \u0026 Y axes."},"5":{"desc":"First of its kind, A1 mini runs the nozzle pressure based flow dynamics calibration algorithm. No need to draw any pattern or get any manual pick \u0026 match involved, A1 mini handles Pressure Advanced calibration automatically."},"6":{"desc":"A1 mini can check the belt tension automatically through the vibration frequency calibration. If the belt is loose, the HMS system will notify you to use the auto belt tensioner to set the belt to the right tension."},"7":{"desc":"No manual setting involved, A1 mini fully automated the filament load/unload process."}},"compensation":{"desc":"The A1 mini revolutionizes flow control in 3D printing. It utilizes a high-resolution, high-frequency eddy current sensor to measure the pressure in the nozzle. Our algorithm actively compensates the flow rate according to the readings to extrude with accuracy."},"highSpeedPrecision":{"desc":"Full-metal Rails, Rigid frame, nozzle pressure sensor, accelerometers, powerful MCU, and above all, an advanced motion control system that utilizes these features to print a 14-minute benchy with quality and following all the speed benchy rules straight out of the box without using specialized filaments."},"intuitiveUI":{"desc":"A1 mini now has a simplified touchscreen UI system that walks you through all the hurdles. You don't have to be a 3D printing expert to use the A1 mini."},"worryFreePrinting":{"comment":{"1":"\"Have a Bambu Lab among 15 other printers of various manufacturers. The Bambulab is my go to. Just works right from the box. Sturdy, simple, reliable.\"","2":"\"Changed your hobby from 'tinkering' to 'printing'.\"","3":"\"New to this group and I just wanted to say that, I love this printer! In the last eleven years this is my first printer that does not need any tinkering and just gets the job done. Reliable. Precise. Fun.\""}},"printSilently":{"desc":"Active Motor Noise Canceling and Silent Mode can bring down the noise level to under 48 dB, making A1 mini one of the quietest 3D printers on the market, so you can take a nap while your printer is working hard."},"privacy":{"1":{"desc":"If you do not like the concept of Cloud printing, you can use LAN mode to remote control / live view and send jobs to your A1 mini without the need of cloud communication."}},"reliability":{"desc":"We spent extra to bring you the most reliable All-metal rails and cover protected drive system. You get Bambu Lab performance out of the box, designed for consistency and longevity."},"cardSection":{"1":{"title":"Linear Rails","desc":"The rails are the most important factor affecting the lifespan and accuracy in 3D printers, as they need to ensure the system's rigidity during the printing process, while constantly withstanding the wear brought by high-speed motion. The A1 mini utilizes all-metal rails, incorporating high-quality linear rails on the X and Z axes, and a all-metal Linear Guide on the Y axis. These rail systems ensure that the A1 mini doesn't require frequent adjustments by the users; regular lubrication alone can guarantee the printer's precision and lifespan."},"2":{"desc":"Active Vibration Compensation, similar to Input Shaping found in other firmware, is the key to fast printing. To compensate for the vibration of the printer, the control system needs to know the vibration characteristics of the system, such as the natural frequency and amplitude of all axes. You can set the parameters when the printer is produced and adhere to them. However, these parameters may drift due to environmental temperature fluctuations, changes in belt tension, or even variations in the mass of the build plate. To guarantee the optimal parameters for superior print quality, we have installed sensors on both the toolhead and the heatbed, allowing for the measurement of the parameters of the X and Y axes before every print."},"3":{"desc":"Everyone knows that a clogged nozzle or a tangled spool of filament can ruin an entire fine print.Traditional filament run out sensor can only cover a limited number of failure scenarios. In the A1 mini and AMS lite, we have introduced a comprehensive filament monitoring system. This includes a filament tension sensor on the toolhead, a filament position sensor before the extruder, and a nozzle pressure sensor situated between the extruder and the nozzle. Additionally, the lite is equipped with a filament odometer. These sensors, combined with advanced algorithms, can promptly detect potential issues such as filament tangling and breakage, and extruder skipping, safeguarding the quality of each print."},"4":{"desc":"While AMS lite is compatible with most filaments on the market, it uses RFID to detect Bambu Filament with RFID tag, and automatically apply the best suited settings for them. It also enable you to monitor the filament usage, remotely."},"5":{"desc":"The A1 mini's full-auto ABL uses nozzle as the probe, which measures absolute distance. Bed leveling is fully automatic with zero manual adjustment needed."},"6":{"desc":"Unlike the linear and Newtonian movement of the XYZ axes, the viscous flow of the melted plastic is non-Newtonian. The amount of plastic pushed into the hot end by the extruder doesn't necessarily equate to the amount flowing out of the nozzle, especially at high accelerations. This discrepancy can lead to swollen corners and artifacts where the speed changes. This is where active flow rate compensation comes into play. It helps to predict and adjust the flow of the molten plastic, facilitating more accurate extrusion. Previously, we used to print straight lines with acceleration and measure the line's width to calibrate the parameters for compensation - a process that was time-consuming and wasted space on the build plate. In the A1 mini, we employ a novel method to measure the nozzle pressure, allowing us to directly obtain the necessary parameters before each print, saving time and preserving build plate space."},"7":{"desc":"The stepper motor tends to be noisy, particularly at high speeds. By using the motor drive to inject specific high-frequency movements into the motor, we can negate a substantial portion of the noise, provided we understand the detailed characteristics of each motor. However, every motor has its own unique noise fingerprint. The A1 mini is equipped with sensors and algorithms capable of identifying the minute individual differences in each motor during calibration. This information is then utilized to cancel out a portion of the noise generated by the motor."},"8":{"desc":"You can remotely control and monitor your A1 mini with the Bambu Handy App or Bambu Studio. You can see what's going on even if you're not on site."}},"mysteryBox":{"1":{"name":"V-Twin Engine"},"2":{"name":"LED Lamp"},"3":{"name":"Marble Run"},"4":{"name":"Wireless Mouse"},"sectionTitle":"Fun Facts","title":"Mystery Box","desc":"A random mystery box is included in the packaging of every A1 mini combo, while supplies last. Good luck!"},"printerMelody":{"title":"Printer Melody","desc":"The A1 mini sings electronic music with no speaker! The A1 mini can drive the 3 motors that generate certain vibration frequencies to play up to 3 sound tracks at the same time. Try with your own MIDI Files with the Web MIDI to GCode Generator so that your A1 mini can show it's appreciation for you with a jingle.","learnMore":"Learn more"},"techSpec":{"title":"Technical Specifications","name":"A1 mini"}},"a2l":{"header":{"overview":"Overview","diveIn":"Dive In","specs":"Specs","faq":"FAQ","buy":"Buy"},"banner":{"name":"Bambu Lab A2L","slogan":"Creative Playground. \nExtra Large.","imgAlt":"Bambu Lab A2L Affordable Large-format 3D Printer"},"highlight":{"1":"Extra Large Build Volume","2":"Modular Add-ons","3":"Smart Blade Cutting","4":"Stability Enhancements"},"gallery":{"sectionTitle":"MakerWorld Keeps Your Playground Loaded.","title":"Printing Is a Blast When There's Always Something New on the Menu","mainFeature":{"1":"Top Creators","2":"2M+ Models","3":"One Click Away"},"buttonLabel":"Explore MakerWorld"},"buildVolume":{"sectionTitle":"Oversized Build Volume","title":"Extra Large Volume for Extra Bold Ideas","desc":"330 × 320 × 325 mm. That's 105% more space than the 256 mm class. A full-scale helmet, in one piece. A batch of 40 fidget toys, in one run. The kind of project that used to mean slicing your model into chunks—or starting over when the seams didn't line up—now just fits."},"modular":{"sectionTitle":"Modular Add-ons\u003csup\u003e1\u003c/sup\u003e","title":"Add a New Dimension with Blade Cutting","desc":"Swap the toolhead cover for the cutting module, and the A2L isn't just a printer anymore—it cuts. Stickers, leather, fabric, paper. Custom livery for your model plane? Done. A leather wrap for the handle of your Excalibur? Done.","tags":{"1":"Alignment by Smart Phone","2":"Decal Cutting","3":"Pen Drawing"},"case":{"1":{"name":"Anaglyph 3D Glasses"},"2":{"name":"Sticker Vinyl"},"3":{"name":"Ocean Waves Mandalay"},"4":{"name":"911 Blueprint"},"processType":{"digitalCutting":"Digital \nCutting","penDrawing":"Pen \nDrawing"}}},"stability":{"sectionTitle":"Engineered for Stability","title":"A Bed-Slinger As Stable As CoreXY","sections":{"1":{"title":"Adaptive Vibration Compensation","desc":"A model gets taller. It gets heavier. The way the machine vibrates changes with it. Most printers run input shaping once at startup and call it done. The A2L runs \u003ckeywords\u003eAdaptive Vibration Compensation\u003c/keywords\u003e—a real-time calibration matrix that factors in both toolhead position and shifting bed load, retuning the resonance model layer by layer as the print grows. The last layer comes out as clean as the first."},"2":{"title":"Granular Damper","desc":"Software handles the vibration it can predict. Hardware handles the rest. Inside the A2L's gantry sit two \u003ckeywords\u003eGranular Dampers\u003c/keywords\u003e—sealed chambers packed with fine particles that dissipate vibration through countless micro-collisions. It's a damping technique borrowed from aerospace and precision machinery, rarely seen in desktop 3D printers. The result: surface ripples and ghost lines stay out of your prints, even at full build height."}}},"ams":{"sectionTitle":"Automatic Material System\u003csup\u003e2\u003c/sup\u003e","title":"Multi-Color Made Easy","desc":"Multi-color printing isn't new. Doing it thousands times in a row, without a single jam, is. That's the bar AMS lite is built to clear. Over a million users worldwide have put it through long, color-heavy prints—the kind where one bad swap ruins twelve hours of work—and it keeps swapping.","case":{"1":{"name":"Relic Rush Board Game","author":"@MaKim"},"2":{"name":"Maglev Hot Air Balloon","author":"@fana"},"3":{"name":"Nordschleife 3D Miniature","author":"@jarvizar"},"4":{"name":"Uno Box","author":"@GameBox"}},"ams2Pro":{"title":"Support 2nd-Gen AMS","desc":"Pair the A2L with the 2nd-Gen AMS, and your filament gets a sealed, climate-controlled home—dried on demand before each print, kept airtight between them. Need more colors? Need different material types running side by side? AMS lite and the 2nd-Gen AMS share the same embedded buffer system, so you can stack and mix them: four spools, eight spools, sixteen spools—whatever your project asks for, fed cleanly through one queue.","icons":{"1":"19-Color Printing","2":"Filament Drying","3":"Enclosed Storage"},"labels":{"amslite":"Filament x 3","ams2pro":"Filament x 16"}}},"monitoring":{"sectionTitle":"Intelligent Print Monitoring","title":"Put Your Printing on Autopilot\u003csup\u003e3\u003c/sup\u003e","desc":"Most print failures happen quietly—the nozzle keeps moving, but the part stopped forming hours ago. Sensors along the extrusion path, paired with the PMSM extruder as a feedback node, feed a Bambu-trained algorithm that catches filament tangle, runout, nozzle clumping, and air printing—then pauses A2L and guides you through the fix on Bambu Handy.","labels":{"1":"Nozzle Clumping Detector","2":"Filament Grinding","3":"Air Printing"}},"dynamicsCalibration":{"sectionTitle":"Auto Flow Dynamics Calibration","title":"Repeatable Sharp Print Details","desc":"Most printers calibrate flow once and trust it for every print after. A2L recalibrates every time. Before each job, Flow Dynamics Calibration measures how filament actually flows through this nozzle, with this spool, today—and builds a nonlinear model of the entire extrusion path. Nozzle wear, filament moisture, a fresh roll—all factored in before the first layer goes down. Sharp corners. Clean details. Print after print.","a2l":"A2L","otherPrinters":"Other Printers","note1":"Worn nozzle (20% out-spec), Damp filament, Nozzle residue\u003csup\u003e4\u003c/sup\u003e","note2":"A2L VS. Printer without Auto Flow Dynamics Calibration"},"certified":{"sectionTitle":"UL GREENGUARD Certified","title":"Print with Confidence, Breathe with Peace of Mind","desc":"The A2L is certified under the UL 2904 standard for 3D printing indoor air quality when used with official filaments. Testing with our core lineup—including Bambu PLA Basic, PLA Pure, and PETG Basic—confirms ultra-low emissions, making the A2L safe for indoor use."},"silence":{"sectionTitle":"Engineered for Silence","title":"Print Quietly. Work Comfortably.","desc":"The A2L uses active motor noise cancellation, precision linear rails, and intelligent fan scaling to deliver a seamless experience. In Silent Mode, it operates at just 49dB\u003csup\u003e5\u003c/sup\u003e—as peaceful as a quiet library."},"connectivity":{"sectionTitle":"Connectivity \u0026 Privacy","title":"Connect Your Way","desc":"Your printer, your privacy. Use Bambu Cloud for effortless cross-device connectivity, or switch to LAN-only mode for a secure, local-network experience. Total control over how you connect."},"note":{"1":"Modular add-ons are sold separately. Please ensure you select the specific modules required for your desired features.","2":"The AMS and AMS lite systems are available as standalone purchases or as part of select printer Combos. Please ensure you select the appropriate version to enjoy the features advertised here.","3":"Push notifications require the use of Bambu Handy and cloud connectivity.","4":"Results may vary depending on usage conditions.","5":"Background noise: 25 dB; Test distance: 1 m.","title":"Note:","credit":"Big thanks to everyone who created these amazing projects: Print-in-place Marble Run by @WillCAD; Knitted Gingerbread Man - Christmas by @Smoggy3D; Donut Disturb - Door Hanger by @Collecticraft; Comic Book SPLAT sign by @Justin Barnhill; Generative 3D Floor Maps by @Meezi; Customizable Parametric Wall Home Decor Art Tiles by @Azizmaker; Map my memories by @ozarkexpeditions; FruitSpin by @Dot Design; The Ultimate Candy Machine V2 by @Cayden3D; Skadis Parametric bin generator by @Moss 3D; Long Sword 1.5m by @卡卡; Thunderfury, Blessed Blade of the Windseeker by @Sarwtin; BeyBlade Kit Card by @Toast_Channel; Vault Assault - Unique, Fully Printable Board Game by @Applepie; Army Truck Kit Card by @agepbiz; F-14 TOMCAT Plane Kit Card by @PB94; Pixel Sword by @Creat3DWorks; Ocean Waves Mandalay by @LeVanilleShop; Sticker Vinyl by @looqpl; Cockatiel (Realistic Version) by @Pandabear; Nordschleife 3D Miniature v2 by @jarvizar; Relic run board game by @MaKim; Uno Card Box by @GameBox; Maglev Hot Air Balloon by @fana; Big Ben by @MiniWorld3D; Shenzhen Ping An Building by @popuui; Empire State Building Scale Model Display by @maximdivirgilio; Taipei 101 by @maximdivirgilio; Floreal Easter Egg by @Losco Makes; Montessori Spiral Ball Toy by @Gallus Design"}},"x1e":{"printer":{"title":"Bambu Lab X1E","richTitle":"\u003c0\u003eBambu Lab \u003c/0\u003e\u003c1\u003eX1E\u003c/1\u003e","desc":"For professionals and engineering applications","contactButtonText":"Contact Us","resellerButtonText":"Find a Reseller","includedAMS":"*AMS included","priceText":"MSRP: {{price}}(before tax)"},"section1":{"sectionTitle":"Stable Ethernet Connection, WPA2-Enterprise Authentication Wi-Fi Connection","title":"Enhanced And More Connection Options","desc":"The X1E offers the option to connect to your devices through its newly added Ethernet port, ensuring robust network communication in complex environments. Ethernet connectivity can also be used in crowded wireless signal environments. Additionally, the X1E provides WPA2-Enterprise Wi-Fi Authentication (EAP-PEAP/EAP-TLS/EAP-TTLS) and individual physical kill switches for both Wi-Fi and Ethernet, meeting stringent network security requirements."},"section2":{"sectionTitle":"Fully Functional With LAN Only Mode","title":"Off-Cloud Operation","desc":"The X1E can operate independently without a connection to Bambu Cloud Service, fully functional within your local network. Customers can remotely control the X1E through LAN communication without requiring an Internet connection. For additional customization details, please contact your regional reseller."},"section3":{"sectionTitle":"Effectively Filter Particulates And VOCs Generated by 3D Printing","title":"Heavy Duty Air Filtration","desc":"We combined a G3 pre-filter, an H12 HEPA filter, and a high-quality coconut shell activated carbon filter to provide optimal air filtration. Enhanced filtration can effectively reduce excessive odors and particulates when printing in less ventilated environments."},"section4":{"sectionTitle":"Reduce Warping, Improve Layer Bonding","title":"Active Heating And Controlled Chamber Temp","desc":"The X1E can actively heat and regulate the chamber temperature. Accurately controlled chamber temperature (up to 60°C or 140°F) improves print quality, especially for filaments prone to warping such as ABS and PC."},"section5":{"sectionTitle":"More Heat For Higher Temperature Materials","title":"320 °C (608 °F) Nozzle Temp","desc":"Higher nozzle temperature make possible to print higher performance materials such as PPA-CF/GF, PPS and PPS-CF. These new materials have better dimensional stability, heat resistance and mechanical performance."},"section6":{"sectionTitle":"Super Fast And Rigid Structure For Continuous High Speed Printing","title":"Robust High Speed CoreXY","desc":"The superior carbon-fiber rods in the CoreXY motion structure enable the X1E to achieve a toolhead acceleration of 20,000 mm/s² by reducing the weight of moving parts. This faster acceleration allows the X1E to maintain its maximum travel speed of 500 mm/s for longer periods, significantly reducing overall print time."},"section7":{"sectionTitle":"Stable \u0026 Quality Prints Even At Higher Speeds","title":"Vibration And Extrusion Compensation","desc":"X1E can actively compensate for XY-axis vibrations and extrusion issues to ensure exceptionally smooth print quality. All measurements are fully automatic, eliminating the need for manual adjustments."},"section8":{"sectionTitle":"Reduce Filament Wastage And Machine Downtime","title":"AI Failure Detection","desc":"The X1E's AI algorithm can detect first-layer imperfections and spaghetti failures with the assistance of Lidar and computer vision. It then automatically pauses the print to prevent catastrophic failures."},"section9":{"sectionTitle":"Supports Auto Filament Reload and Enables Multi-Material Printing with Support Material for Improved Surface Quality","title":"Intelligent Filament Management","desc":"X1E can parallel connect 4 Bambu AMS systems to print with up to 16 spools of filaments, good for printing dedicated support materials for seamless surface and printing multi-color. The AMS system also supports automatic filament reload to make sure you use all the filament on your spool before switching to a new one."},"inTheBox":{"1":"X1E","2":"AMS","3":"Build Plate","4":"PAHT-CF, PLA-CF\nSupport for PA/PET","5":"Replacement Filter","6":"Filament Swatch","7":"Accessory Box","title":"What's in the Box"},"compare":{"downloadText":"Download TDS"},"contactUsModal":{"title":"Contact Us","name":"Full Name","email":"Business Email","job":"Job Title","company":"Company Name","website":"Company Website","region":"Region","country":"Country / Region","desc":"Please specify your use cases, printing materials, purchase quantity, and other details for us to better assist you.","phone":"Phone Number","province":"State / Province","privacyPolicy":"\u003c0\u003eI agree to receive communications from Bambu Lab or its authorized reseller, and I understand Bambu Lab will process my personal information in accordance with Bambu Lab's \u003c/0\u003e\u003c1\u003ePrivacy Notice\u003c/1\u003e\u003c2\u003e.\u003c/2\u003e"}},"r1":{"banner":{"name":"Bambu Lab R1","slogan":"Big job. Light work.","imgAlt":"Bambu Lab R1 CO2 Laser Engraver and Cutter"},"highlight":{"1":{"title":"55W CO2. Cuts deeper. Cuts more.","desc":"Cut and engrave wood, clear acrylic, leather, and more, with materials up to 20 mm¹ thick in a single pass."},"2":{"title":"No manual calibration.","desc":"No thermal paper. No test shots. No manual tuning. R1 aligns the optical path automatically — a first for a laser cutter."},"3":{"title":"What you mark is what you cut.","desc":"Cameras, lasers, and encoders work together to place every cut exactly where you set it."},"4":{"title":"Smoke cleared across the work area.","desc":"Crossflow ventilation drives air directly through the chamber, clearing smoke quickly and evenly from the work area."},"5":{"title":"Fast, without losing detail.","desc":"Reach speeds up to 1000 mm/s and finish jobs nearly 3× faster, while keeping fine details sharp.²"},"6":{"title":"Taller. Rounder. Longer. Thicker.","desc":"Add risers for taller pieces, a rotary for round objects, longer-focus lenses for thicker stock, and a conveyor³ for boards up to 3 meters long."}},"materials":{"1":{"title":"PlayDeck – Modular Play Table \u0026 Stool Set @janberrydesign","line1":"Laser cut \u0026 engraved: Tabletop \u0026 stool seats","line2":"3D printed: Table \u0026 stool legs","tab1":"Full","tab2":"Detail"},"2":{"title":"Crystal Canyon Mine – Marble Run @Daniel4d","line1":"Laser cut \u0026 engraved: Track, mine cart \u0026 crystals","line2":"3D printed: House \u0026 canyon landscape","tab1":"Full","tab2":"Detail"},"3":{"title":"Prairie Lamp @Makim","line1":"Laser cut \u0026 engraved: Frame \u0026 outer acrylic shade","line2":"3D printed: Inner diffuser","tab1":"Full","tab2":"Detail"},"4":{"title":"Sunflower Painting @miyabi","line1":"Laser cut: Layered frame \u0026 cardstock petals","line2":"3D printed: Clay-look vase","tab1":"Full","tab2":"Detail"},"5":{"title":"Thundercloud – Layered Acrylic Lamp @Daniel4d","line1":"Laser cut \u0026 engraved: Acrylic panels","line2":"3D printed: Base","tab1":"Full","tab2":"Detail"},"6":{"title":"Layered Clock @Bambu Lab","line2":"Laser material: Translucent acrylic","tab1":"Full","tab2":"Detail"},"title":"Warm wood. Crystal-clear acrylic. Textured cork.","desc":"See what R1 can make."},"chapters":{"1":{"title":"CO₂ laser. Wood to glass. \u003cblue\u003eTabletop decor to furniture.\u003c/blue\u003e","desc":"Laser on — board falls. Cut clean in a single pass, leaving the material's natural character intact. Bambu motion control keeps every run precise and consistent. \u003ckeywords\u003eThis is Bambu Lab R1. Serious CO₂ laser capability, made easier to work with.\u003c/keywords\u003e","section1":{"1":{"material":"Wood"},"2":{"material":"Transparent acrylic","tag":"CO2 Only"},"3":{"material":"Glass","tag":"CO2 Only"},"4":{"material":"Fabric"},"5":{"material":"Leather"},"6":{"material":"Anodized aluminum"},"7":{"material":"Slate"},"title":"Bring out the best in every material.","desc":"Powered by a 55W CO₂ laser, R1 works across a wide range of materials — from wood and acrylic to glass, leather, fabric, and more — each bringing its own character to the piece.","action":{"label":"Full material list","dialogTitle":"The full material list."},"table":{"remark":"*Max thickness varies by lens (short / medium / long focus). Thickness and surface finish affect results; please always follow the recommended settings.","header":{"1":"Material","2":"Cut","3":"Engrave","4":"Max cut thickness / Note"},"row":{"1":{"1":"Plywood","4":"up to ~18mm*"},"2":{"1":"Acrylic (opaque)","4":"up to ~20mm*"},"3":{"1":"Clear acrylic","4":"up to ~20mm* · CO2 only"},"4":{"1":"Leather","4":"varies by type"},"5":{"1":"Paper \u0026 cardboard"},"6":{"1":"Fabric \u0026 felt"},"7":{"1":"Glass","4":"surface engraving only"},"8":{"1":"Ceramic","4":"surface engraving only"},"9":{"1":"Stone \u0026 slate","4":"surface engraving only"},"10":{"1":"Coated / anodized metal (anodized aluminum, powder-coated, painted)","4":"surface marking only"},"11":{"1":"Bare metal (raw aluminum, stainless steel)","4":"not supported — CO2 marks coated surfaces only"},"12":{"1":"PVC, vinyl \u0026 other chlorine-containing materials","4":"never process — releases harmful fumes"}}}},"section2":{"title":"Thick cuts with one pass.","desc":"The 55W CO₂ laser cuts up to 18 mm black walnut plywood and 20 mm acrylic¹ in a single pass — fast, clean, and without the extra passes that slow you down."},"section3":{"title":"Go furniture-scale.","desc":"With the auto-feed conveyor³, R1 handles material up to 3 meters long. Pass-through feeding and deep cutting turn full-length panels into tables, shelving and furniture."}},"2":{"title":"Every line, \u003cblue\u003esharp and clean.\u003c/blue\u003e","desc":"Drop in your workpiece — crooked, curved, or tiny. R1 locates it, reads the surface, and tracks every move as it works, so every line lands exactly where you set it. \u003ckeywords\u003eThis is TriSense. What you mark is what you cut.\u003c/keywords\u003e","hotspots":{"text1":"\u003cblue\u003eBirdsEye Camera\u003c/blue\u003e captures the full workspace.","text2":"\u003cblue\u003ePinpoint Laser\u003c/blue\u003e marks the spot on the material.","text3":"\u003cblue\u003eDistance Measurement Laser\u003c/blue\u003e reads the height and sets focus.","text4":"\u003cblue\u003eToolhead Camera\u003c/blue\u003e locates exactly what you're cutting.","text5":"\u003cblue\u003eXY encoders\u003c/blue\u003e track the toolhead’s position in real time."},"section1":{"1":{"title":"Follows the curve.","desc":"From curved cups and spheres to uneven surfaces. Height sensing follows every rise and fall to keep the engraving sharp and consistent across the entire surface.⁴"},"2":{"title":"Stays accurate on clear materials.","desc":"R1 keeps surface measurement accurate even on transparent materials like glass and clear acrylic, so engraving stays precisely placed."},"3":{"title":"Finds the tiny stuff.","desc":"The Toolhead Camera pinpoints small objects and places fine detail exactly where you want it."},"4":{"title":"Traces the line.","desc":"Cut around a printed design, trim a sticker, or follow a drawn outline. The Toolhead Camera traces the edge and keeps the cut precisely on path."},"title":"Where precision pays off."},"section2":{"1":{"title":"Crisp lines, even after the turn.","desc":"When the toolhead changes direction, a split-second shake can ripple the line that follows. R1's vibration compensation cancels it out, keeping lines crisp right out of the turn — the same technology as in our 3D printers."},"2":{"title":"Even tone at 1000mm/s.","desc":"Higher speeds usually mean shallower engraving. R1 compensates as it moves, keeping engraving depth consistent at up to 1,000 mm/s — while completing the same job nearly 3× as fast.²"},"3":{"title":"Stays accurate over time.","desc":"Mechanical accuracy can drift with use. The Vision Encoder⁵ corrects for it, keeping absolute motion accuracy within 0.1 mm across the full work area. Draw 300 mm. Cut 300 mm."},"title":"The motion control that keeps our printers precise. Now in R1.","desc":"The same motion control and intelligent algorithms behind Bambu Lab printers now power R1 — bringing faster movement, finer detail, and more precise cuts."}},"3":{"title":"Tricky setup? \u003cblue\u003eSolved.\u003c/blue\u003e","desc":"Usually, aligning the optical path meant test shots, manual adjustments, and trial and error — with no telling how long it might take. With R1, that chore comes down to one small sensor. Mount the Laser Alignment Sensor on the toolhead, and \u003ckeywords\u003eit measures the beam, detects the misalignment, and corrects the path automatically, in just one minute.\u003c/keywords\u003e","section1":{"1":{"title":"See the alignment."},"2":{"title":"Check what's left."},"3":{"title":"Watch it run."},"title":"Follow it on the screen.","desc":"R1 puts a touchscreen right on the machine. Follow every job in real time, watch the optical path calibrate, and check the machine's health status — all without a computer."},"section2":{"title":"Drop in the material. Skip the settings.","desc":"R1 recognizes Bambu Lab material automatically and applies the right power and speed, so you can skip test grids and manual parameter setup."}},"4":{"title":"\u003cblue\u003eSafer by design.\u003c/blue\u003e \u003cbr\u003eMade for everyday spaces.","section1":{"1":{"title":"Everyday cutting","overallDesc":"Air sweeps continuously across the work area toward the exhaust, reducing dead zones where smoke can collect and helping keep the chamber clear as you cut."},"2":{"title":"With long stock","overallDesc":"When a long board passes through the opening, incoming air forms a curtain across the gap, helping keep smoke inside the chamber and direct it toward the exhaust."},"title":"Crossflow ventilation, from corner to corner.","desc":"Most lasers rely on a single exhaust fan. R1 brings fresh air in from one side and exhausts smoke from the other, creating a steady crossflow through the entire chamber."},"section2":{"title":"E1 Pro Air Purifier. Cleaner air, back in the room.","desc":"Built for R1, E1 Pro⁶ connects directly to R1's exhaust outlet and pulls smoke out at the source. Multiple filter layers, with activated carbon, catch smoke and fine particles and reduce odors."},"section3":{"title":"Class 1 laser safety.","desc":"R1 is Class 1 under IEC 60825-1 in standard enclosed use. Laser radiation stays contained inside the enclosure, so no safety goggles or dedicated laser room are needed.⁷"},"section4":{"1":{"title":"Lid-open stop","overallDesc":"Open the lid and the laser stops immediately. It stays disabled while the lid is open."},"2":{"title":"Flame detection","overallDesc":"Built-in sensors monitor for signs of flame and respond when flame is detected."},"3":{"title":"Auto fire suppression","overallDesc":"If a fire is detected, R1 automatically activates fire suppression to help extinguish it.⁸"},"4":{"title":"Emergency stop","overallDesc":"One press cuts power to the machine immediately."},"5":{"title":"Protective viewing window","overallDesc":"The window filters harmful laser radiation while keeping the job clearly visible."},"title":"Multiple layers of protection.","desc":"Laser work means heat. R1 layers multiple safeguards around every job, detecting potential issues early and responding quickly when needed."}}},"scene":{"title":"Part of the Bambu Experience.","desc":"Same MakerWorld. Same Bambu account. Same familiar workflow. R1 fits right into the Bambu ecosystem, so there's less to learn and more you can start making right away.","section1":{"title":"Same work area. Smaller footprint.","desc":"R1 delivers the same working area as a typical CO₂ laser while taking up about a third less space.⁹"},"section2":{"1":{"title":"Riser Base","desc":"Raises R1 to create clearance for taller objects. Also required for the Conveyor and Rotary."},"2":{"title":"Conveyor","desc":"Automatically feeds long stock through R1, letting you cut and engrave boards up to 3 meters long."},"3":{"title":"Rotary Attachment","desc":"Rotates round objects for full 360° engraving on bottles, bowls, cups, and more. Requires the Riser Base."},"4":{"title":"Focus lenses (Medium / Long)","desc":"Greater depth of focus for cleaner cuts through thicker materials — up to 20 mm with the long-focus lens."},"title":"Go taller. Rounder. Longer. Thicker.","desc":"Add the setup you need for taller objects, round pieces, thicker stock, and extra-long boards.³"},"section3":{"title":"See what R1 can make.","desc":"Watch Phil turn raw material into a finished project with R1."}},"remarks":{"1":"Requires the medium- or long-focus lens, sold separately; all references to wood refer to plywood.","2":"Based on image engraving at maximum speed and acceleration settings: R1 at 1,000 mm/s and 20,000 mm/s², compared with a typical CO₂ laser at its maximum settings.","3":"Riser base, Rotary, medium- and long-focus lenses, and Conveyor are sold separately.","4":"At launch, only Cylinder Processing is supported. Revolve Shape Processing will be added in a future firmware update.","5":"Vision Encoder sold separately.","6":"E1 Pro sold separately.","7":"Filtration efficiency is based on internal testing conducted by Bambu Lab.","8":"Important: When used with the riser base or the auto-feed accessory, the enclosure is no longer complete and the laser cutter changes from an enclosed Class 1 device to a Class 4 device, requiring CO2 laser-safety eyewear, and is intended for professional use by trained personnel only.","9":"Auto Fire Extinguishing System sold separately.","10":"Comparison based on external footprint vs. representative consumer CO2 lasers with equivalent working area, as measured by Bambu Lab. Actual size varies by model.","11":"Creator projects are provided for illustrative purposes only. Bambu Lab does not endorse, and disclaims any representations or warranties regarding creator projects, including, without limitation, the safety, marketability, or usability of any 3D printed works based on such projects. See our Terms of Service for more information.","12":"All product data for the R1 is based on Bambu Lab's internal testing. Actual results may vary due to individual product differences, user habits, and environmental conditions. Please refer to actual usage for reference.","13":"Big thanks to everyone who created these amazing projects: PlayDeck – Modular Play Table \u0026 Stool Set @janberrydesign; Crystal Canyon Mine – Marble Run @Daniel4d; Prairie Lamp @Makim; Sunflower Painting @miyabi; Thundercloud – Layered Acrylic Lamp @Daniel4d; Piano @3D_Sfera; Mini Hooded Jacket @lhy1999","title":""}},"x2d":{"printer":{"name":"Bambu Lab X2D","slogan":"Xcellence made simple"},"header":{"overview":"Overview","diveIn":"Dive In","showcase":"Showcase","specs":"Specs","faq":"FAQ","buy":"Buy"},"banner":{"name":"Bambu Lab X2D","slogan":"Xcellence made simple","imgAlt":"Bambu Lab X2D Affordable Dual Extruder 3D Printer"},"highlight":{"1":{"title":"\u003ckeywords\u003eDual nozzle.\u003c/keywords\u003e Multi-material made simple."},"2":{"title":"\u003ckeywords\u003eAI Monitoring.\u003c/keywords\u003e Your built-in backup."},"3":{"title":"\u003ckeywords\u003eActive heating.\u003c/keywords\u003e Stronger parts."},"4":{"title":"\u003ckeywords\u003eDual-intake cooling.\u003c/keywords\u003e Crisp details."},"5":{"title":"\u003ckeywords\u003eServo Extruder.\u003c/keywords\u003e Smooth surfaces at full speed."},"6":{"title":"\u003ckeywords\u003eAdaptive Calibration.\u003c/keywords\u003e Lasting precision."},"7":{"title":"\u003ckeywords\u003eEmission certified.\u003c/keywords\u003e Designed for your home."},"title":"Get the highlights"},"experience":{"title":"This is the \nBambu Experience.","desc":"\u003ckeywords\u003eDual nozzles.\u003c/keywords\u003e Supports that peel away effortlessly, leaving a silky-smooth finish every time.\n\u003ckeywords\u003eSmarter software.\u003c/keywords\u003e Precise results, print after print.\n\u003ckeywords\u003eOne ecosystem.\u003c/keywords\u003e From idea to object in hand. All with just a few taps."},"features":{"chapterTitle":"MakerWorld","chapterDesc":"Start with the best design.","mw1":{"1":{"userName":"@sarwtin","userDesc":"Senior Art Director at a major AAA game studio"},"2":{"userName":"@Makim","userDesc":"Product Manager | Hit Interactive Toy \u0026 Functional Model Maker"},"3":{"userName":"@CrazyJN","userDesc":"Independent IP Creator | Senior Prototype Artist | Promotional Illustration Expert"},"4":{"userName":"@Daniel4d","userDesc":"Post-Production Studio Owner | Senior 3D \u0026 VFX Artist"},"title":"Best design. From the best designers.","desc":"The world's \u003ckeywords\u003etop creators\u003c/keywords\u003e publish their \u003ckeywords\u003emost iconic\u003c/keywords\u003e models on MakerWorld - often first, often exclusive. Print yourself a design you can't find anywhere else.","highlight":{"1":"400K+ Exclusive Designs","2":"Free to Download"}},"mw2":{"title":"Every model you want. It's on MakerWorld.","desc":"From home decor to engineering parts, MakerWorld \u003ckeywords\u003ecovers the full range.\u003c/keywords\u003e\nBrowse by style, print time, or color and find something to print today.","highlight":{"1":"World's Fastest Growing 3D Printing Library¹","2":"20,000+ New Models Weekly"}},"mw3":{"title":"Tap. Print. Done. Only with Bambu.","desc":"Already picked a model on your phone? You're halfway to a finished print. A global community of creators on MakerWorld upload their models with \u003ckeywords\u003eprint profiles already tuned for your machine\u003c/keywords\u003e - no more fiddling with settings. Pick a design, tap print, hold the finished piece. Only with Bambu Lab.","highlight":{"1":"Phone-to-Printer in Three Taps","2":"Pre-Tuned Profiles for Every Printer"},"btn":"Explore MakerWorld"}},"bambuStudio":{"chapterTitle":"Bambu Studio","title":"Great prints don't come from random profiles.","desc1":"They come from profiles tuned to your exact machine, material, and nozzle - and that's what separates a reliable print from an inconsistent one.","desc2":"Bambu Studio is more than a path generator - it's a parameter system built on extensive testing and validation. ","desc3":"\u003ckeywords\u003eWell-tuned profiles help overhang hold, corners stay sharp, and bridges land clean.\u003c/keywords\u003e","features":{"title":"Great profiles come from careful tuning.*","subtitle":"*Recommend printing with official materials for better results.","list":{"cooling":{"title":"Cooling","desc":"Fan behavior is tuned for different materials and overhang geometries, balancing surface detail and structural integrity."},"speed":{"title":"Speed","desc":"Print speed is adjusted based on material, layer height, and geometry - balancing efficiency with surface quality."},"support":{"title":"Support","desc":"Support parameters are calibrated around strength, removability, and contact surface quality to reduce post-processing effort."},"retraction":{"title":"Retraction","desc":"Retraction settings are optimized for different material and printer combinations to help reduce stringing and surface artifacts."}}},"compare":{"title":"Detail wins."},"timeline":{"title":"A system that never stops improving...","subtitle":"New algorithms, smarter toolpaths…You don't need to understand the tech. Bambu Studio optimizes in the background - you just get better prints.","list":{"v2_1":{"version":"Bambu Studio 2.1.0","features":"\u003cul\u003e\u003cli\u003eLocked Zag infill pattern, balancing appearance and strength\u003c/li\u003e\u003cli\u003eOptimized \"Avoid crossing wall\" to reduce stringing\u003c/li\u003e\u003c/ul\u003e"},"v2_2":{"version":"Bambu Studio 2.2.0","features":"\u003cul\u003e\u003cli\u003eHelio Additive Simulation Integration for thermal simulation\u003c/li\u003e\u003cli\u003eRemote Object Skipping\u003c/li\u003e\u003cli\u003eSeam Avoidance on Overhangs\u003c/li\u003e\u003c/ul\u003e"},"v2_3":{"version":"Bambu Studio 2.3.0","features":"\u003cul\u003e\u003cli\u003eSkips unnecessary color-change flush\u003c/li\u003e\u003cli\u003eOverhang segmentation optimization\u003c/li\u003e\u003c/ul\u003e"},"v2_4":{"version":"Bambu Studio 2.4.0","features":"\u003cul\u003e\u003cli\u003eAlign \u0026 distribute objects or parts\u003c/li\u003e\u003cli\u003eOuter wall \u0026 infill interlocking for higher robustness\u003c/li\u003e\u003c/ul\u003e"}}}},"dualNozzle":{"chapterTitle":"Dual Nozzle System","chapterDesc":"Stop overthinking with support - start peeling it off clean.","section1Desc":"\u003ckeywords\u003eThe main nozzle prints the part. The auxiliary nozzle handles the support²\u003c/keywords\u003e. X2D hands all the messy support work to a helper nozzle with its own material.","section2Desc":"Wrap steep overhangs, fabric folds, and internal channels with full support, then peel it away clean.","compareCards":{"1":{"title":"Zodiac: IronSoul","metric1Title":"Material saved","metric1Desc":"less material","metric1Machine1":"X1C","metric1Machine2":"X2D","metric2Title":"Print time saved","metric2Desc":"faster","metric2Machine1":"X1C","metric2Machine2":"X2D","materialModel":"Model: PLA","materialSupport":"Support: PVA"},"2":{"title":"TPU Sneaker","metric1Title":"Material saved","metric1Desc":"less material","metric1Machine1":"X1C","metric1Machine2":"X2D","metric2Title":"Print time saved","metric2Desc":"faster","metric2Machine1":"X1C","metric2Machine2":"X2D","materialModel":"Model: TPU","materialSupport":"Support: PLA"},"3":{"title":"Hunting Bow Riser","metric1Title":"Material saved","metric1Desc":"less material","metric1Machine1":"X1C","metric1Machine2":"X2D","metric2Title":"Print time saved","metric2Desc":"faster","metric2Machine1":"X1C","metric2Machine2":"X2D","materialModel":"Model: PAHT-CF","materialSupport":"Support: ASA"}},"button":"Find the perfect support match","dialog":{"title":"Support Compatibility","supportCompatibility":{"1":{"filament":"PLA","support":"PVA \nSupport for PLA \nSupport for PLA/PETG"},"2":{"filament":"PETG","support":"Support for PLA/PETG"},"3":{"filament":"TPU","support":"PLA"},"4":{"filament":"ABS/ASA","support":"Support for ABS"},"5":{"filament":"PA6-CF, PET-CF, PAHT-CF, PPA-CF, PPS-CF","support":"ASA"},"6":{"filament":"PA6-GF","support":"ABS"}}}},"printingApplications":{"chapterTitle":"Dual Nozzle Applications","chapterDesc":"Add more color, more details and more fun.","blocks":{"hardSoft":{"title":"Break the limits of one single material.","desc":"A hanging planter that sways without snapping. A bag with zippers and decors. An action figure with joints that move the way joints should. \n\u003ckeywords\u003eTPU for flex. PLA for strength.\u003c/keywords\u003e In one print."},"details":{"title":"Pack microscopic details into palm-sized prints.","desc":"Switch to \u003ckeywords\u003e0.2 mm nozzles on both the main and auxiliary hotend\u003c/keywords\u003e to push detail even further. \nCarve intricate patterns onto palm-sized models, and print tabletop miniatures with facial expressions that actually come to life!"},"colors":{"title":"Swap colors in a snap.","desc":"Terrified by tons of wasted filament? With the X2D's dual-nozzle system, you don't have to be. \nThe nozzles switch in a split second. Bambu Studio smartly manages the color split, giving you \u003ckeywords\u003efaster color changes\u003c/keywords\u003e, razor-sharp transitions, and significantly less filament waste³."}}},"printingPerformance":{"chapterTitle":"Printing Performance","chapterDesc":"Finer. Sharper. True to the design.","section1":{"title":"The lightest dual nozzle system ever. For the \u003ckeywords\u003efinest\u003c/keywords\u003e finish⁴.","desc1":"Tap. Switch. Done.\nUnlike traditional motor-driven systems, X2D packs a \u003ckeywords\u003eGear-and-Trigger\u003c/keywords\u003e mechanism into the toolhead. The nozzle-change lever taps the trigger arm, driving an internal gear train to change the nozzle. \u003ckeywords\u003eNo extra weight. Just a clean swap.\u003c/keywords\u003e","desc2":"A lighter toolhead means \u003ckeywords\u003eless inertia and vibration\u003c/keywords\u003e. Even at full speed, surfaces stay flawless - all the way to the top."},"section2":{"title":"The right temperature at the right time. So details stay \u003ckeywords\u003esharp\u003c/keywords\u003e.","coolModeTitle":"Cool it. Before gravity makes it droop.","coolModeDesc":"\u003ckeywords\u003eTwo intakes are always better than one.\u003c/keywords\u003e Freshly extruded filament is soft, but the X2D instantly flushes the chamber with cool air from dual left and right intakes. This constant air exchange stabilizes each layer for low-temperature filaments like PLA, cooling every line at exactly the right moment. So even on tricky angles, overhangs stay sharp and bridges stay clean.","coolMode":"X2D Cooling","standard":"Typical Cooling","heatModeTitle":"Hot enough isn't enough. Heat it even.","heatModeDesc":"The X2D pairs a 300 °C nozzle with a 65 °C actively heated chamber - hot enough for the majority of engineering filaments like ABS, ASA, and nylon. But temperature alone isn't the point - \u003ckeywords\u003ethe active chamber distributes heat evenly\u003c/keywords\u003e, so layers bond strongly from edge to edge. Your large engineering prints come out strong and flat.","heatMode":"X2D Heating","noChamberHeat":"Typical Heating","on":"ON","off":"OFF"},"section3":{"title":"Snap and fit. Every part, true to the design.","desc1Title":"Holes that round. Edges that align. Parts click together like a well-made kit.","desc1":"Materials shrink as they cool. With \u003ckeywords\u003eAuto Hole and Contour Compensation⁵\u003c/keywords\u003e, X2D compensates automatically, so holes print to spec and edges land precisely where they should - for a tighter, cleaner fit with standard hardware. Powered by Bambu Studio.","desc2Title":"Vision Encoder. Precision that doesn't drift.","desc2":"Belts stretch. Mechanical parts drift over time. The Vision Encoder⁶ catches and compensates for it - maintaining \u003ckeywords\u003e50-micron accuracy\u003c/keywords\u003e across the full build volume. Large parts stay accurate. And the machine stays sharp - not just the first day, but for years."}},"bambuAlgorithms":{"chapterTitle":"Bambu Algorithms","chapterDesc":"Great results should be repeatable.","section1":{"title":"Calibration adapts to wear and material changes.","desc":"Most printers calibrate flow with a single K factor and use it in all scenarios. Bambu Lab doesn't. Flow Dynamics Calibration⁷ builds a \u003ckeywords\u003etime-varying, nonlinear model\u003c/keywords\u003e of your entire extrusion system. So whether there's minor residue inside the nozzle, gradual nozzle wear, or slightly damp filament, the system detects, calibrates, and compensates. Smooth surfaces and sharp edges stop being luck. They repeat.","x2d":"X2D","otherPrinters":"Other Printers⁸","picText":"\u003ckeywords\u003eWorn nozzle\u003c/keywords\u003e (0.48 mm, +20% over spec)\n\u003ckeywords\u003eDamp filament\u003c/keywords\u003e (4.13% moisture)\n\u003ckeywords\u003eNozzle residue\u003c/keywords\u003e"},"section2":{"title":"PMSM Servo System: Smoother surfaces start inside the extruder.","desc":"Extruder gears grind into filament as they feed it, causing small pressure fluctuations that show up as tiny lines on the surface. \u003ckeywords\u003eExclusive to Bambu Lab\u003c/keywords\u003e, the PMSM servo system⁹ counters this in real time. With resistance and position sampling at 20 kHz, it adjusts electromagnetic torque on the fly, smoothing out every micro-fluctuation before it reaches the surface.","subTitle":"Smooth surface quality.","subDesc":"Extrusion pressure stays precisely controlled, so flow stays stable and surface finish remains clean and uniform, print after print.","label1":"Bambu PMSM Extruder","label2":"Standard Extruder","on":"ON","off":"OFF"},"section3":{"title":"Compensation makes corners sharp and details clean.","desc":"Ringing and ghosting blur edges at high speed. \u003ckeywords\u003eActive Vibration Compensation\u003c/keywords\u003e cancels them in real time - so edges print crisp, no matter how fast.","on":"ON","off":"OFF"}},"autopilot":{"chapterTitle":"Put your printing on Autopilot.","section1":{"title":"AI Camera keeps an eye on your prints.","desc":"Before printing, \u003ckeywords\u003ethe AI Liveview Camera and Toolhead Camera scan\u003c/keywords\u003e the build plate for foreign objects and verify plate placement. During printing, they watch for spaghetti, nozzle clumping, and purge-chute jams in real time - pausing the job before it wastes hours of time and filament.","tabs":{"startCheck":"Start Check","spaghetti":"Spaghetti","nozzleClumping":"Nozzle Clumping","purgeChuteJamming":"Purge Chute Jam"}},"section2":{"title":"Fully-equipped sensors cover every critical stage.","desc":"\u003ckeywords\u003e31 sensors span the entire system\u003c/keywords\u003e - monitoring the feeding path, printing process, thermal environment, and machine safety in real time. Every variable that affects your print is measured, checked, and acted on.","block1":{"title":"Filament Path Monitoring","desc":"The sensors \u003ckeywords\u003etrack\u003c/keywords\u003e feeding status, \u003ckeywords\u003edetect\u003c/keywords\u003e tangles risk, \u003ckeywords\u003emeasure\u003c/keywords\u003e filament usage, and \u003ckeywords\u003econfirm\u003c/keywords\u003e tool readiness - every tool in place, every move under control. Start a 12-hour print. Walk away. \u003ckeywords\u003eCome back to a finished part.\u003c/keywords\u003e"},"block2":{"title":"Thermal Control","desc":"Ten temperature sensors \u003ckeywords\u003espan\u003c/keywords\u003e the nozzle, heatbed, and chamber. Paired with \u003ckeywords\u003eairflow sensors\u003c/keywords\u003e, they keep heat steady throughout the entire print. Corners don't lift. Layers don't split. \u003ckeywords\u003eThe first layer bonds like the last.\u003c/keywords\u003e"}}},"designedForHome":{"chapterTitle":"All the must-haves for everyday use.","cleanAir":{"title":"Clean air. Always.","desc":"X2D runs a \u003ckeywords\u003e three-stage filtration system\u003c/keywords\u003e every time it prints. A G3 pre-filter, an H12 HEPA filter, and a coconut-shell activated carbon layer work together to reduce odors and airborne particles. The same trusted filtration system used in H Series printers. Quiet. Clean. Ready for everyday spaces¹⁰."},"cards":{"safe":{"title":"Safe for your living room.","desc":"The X2D is \u003ckeywords\u003eUL 2904 certified\u003c/keywords\u003e for indoor air quality when printing with Bambu PLA Basic and PETG Basic. Confirmed for low particle and VOC emissions - so you can print in your personal space with peace of mind."},"nozzle":{"title":"Tool-free nozzle swap.","desc":"\u003ckeywords\u003eSwap nozzles in seconds.\u003c/keywords\u003e No tools, no hassle. Easy for first-time users."},"quiet":{"title":"Quiet enough for overnight prints.","desc":"\u003ckeywords\u003eActive Motor Noise Canceling\u003c/keywords\u003e and a noise-optimized air duct keep X2D below 50 dB in Silent Mode. Quiet enough for overnight printing¹¹."},"camera":{"title":"See every detail, remotely.","desc":"\u003ckeywords\u003eBrighter chamber lighting\u003c/keywords\u003e makes Live View and time-lapse clearer than ever, so you can check on prints from anywhere."},"durability":{"title":"One million switches. Still smooth.","desc":"X2D's dual-nozzle system completed over \u003ckeywords\u003e1,000,000\u003c/keywords\u003e switch cycles in life-cycle testing, maintaining smooth and consistent motion throughout. Built for years of dependable use."}},"updates":{"title":"A printer that updates like your phone.","desc":"X2D prints beautifully the day it arrives. And it gets better with every update. Major firmware updates land roughly \u003ckeywords\u003eevery three months¹²\u003c/keywords\u003e - new features, better performance, all pushed straight to your machine.","list":{"1":"Motor Noise Cancellation","2":"Drying While Printing (AMS 2 Pro)","3":"VFA Optimization","4":"Plate Position Detect","5":"AI Clump Detect","6":"Lube Reminders","7":"Remote Object Skip","8":"Printer Farm Mode"}}},"showcase":{"title":"Take a closer look","seeMore":"See More","design":{"title":"Design of X2D","desc":"X2D inherits Bambu Lab's signature design language, flawlessly balancing structural rigidity with visual refinement. The compact dual-nozzle system showcases the relentless pursuit of mechanical perfection. Enhanced with beginner-friendly features and brighter chamber lighting, it is thoughtfully crafted to make professional-grade dual-extrusion distinctly accessible for every home.","download":"Download Render"},"model":{"title":"X2D Quality Prints","desc":"The X2D is the ultimate expression of Bambu Lab's extreme print quality. By unleashing the full potential of dual-nozzle printing, the X2D delivers unparalleled results. It consistently achieves silky smooth finishes, perfectly crisp details, and flawless support interfaces. This isn't just a dual-color printer; it's a meticulously calibrated machine dedicated to preserving the absolute integrity of your multi-material designs.","download":"Download","models":{"1":{"nameAndAuthor":"Coral Jade·Hunting Recurve Riser @SophieXi"},"2":{"nameAndAuthor":"Chongqing street scene @考不上小学不改名"},"3":{"nameAndAuthor":"SVEINS ZIP 1 @riccky.svg"}}}},"compare":{"title":"Compare","compareAll":"Compare All Product","downloadPdf":"Download PDF","buyNow":"Buy now","x2d":{"bodyDualNozzle":"Dual Nozzle¹³"}},"buySection":{"brand":"Bambu Lab X2D","slogan":"Xcellence made simple","buyNow":"Buy now","showcase":"Showcase"},"remarks":{"1":"Based on year-over-year growth in monthly visits tracked by third-party analytics platforms (e.g., SimilarWeb).","2":"In actual testing, print quality from the auxiliary nozzle is slightly lower than that of the main nozzle.","3":"Recommended to use official Bambu Lab filaments with the auxiliary nozzle, especially official PLA for model printing. Third-party filaments on the auxiliary nozzle may not deliver optimal print quality. For a full list of compatible materials, refer to the Spec Sheet.","4":"\"Lightest\" compared with other Bambu Lab dual-nozzle toolheads; \"finest finish\" compared within the Bambu Lab X series.","5":"Auto Hole/Contour Compensation: Auto Hole/Contour Compensation must be enabled in Bambu Studio and requires the use of designated Bambu filaments; Currently, only vertical circular holes are supported - horizontal, angled, or non-circular holes are not yet supported.","6":"Vision Encoder: Vision Encoder needs to be purchased separately on the Bambu Lab Store.","7":"Flow Dynamics Calibration on X2D applies to the main nozzle only.","8":"\"Other Printers\" shown for illustrative purposes only. Results may vary by printer model and configuration; not all printers exhibit this behavior.","9":"PMSM servo motor is equipped on the main extruder only.","10":"For optimal performance, replace filters according to the recommended maintenance schedule.","11":"Suitable for overnight printing when the printer is placed in a separate room from the sleeping area. Individual noise perception may vary.","12":"Based on the average update cadence across Bambu Lab printers. Actual timing may vary.","13":"X2D features a main nozzle and an auxiliary nozzle with different filament capabilities. See Spec Sheet for full compatibility details.","14":"Creator projects are provided for illustrative purposes only. Bambu Lab does not endorse, and disclaims any representations or warranties regarding creator projects, including, without limitation, the safety, marketability, or usability of any 3D printed works based on such projects. See our Terms of Service for more information.","15":"All product data for the X2D is based on Bambu Lab's internal testing. Actual results may vary due to individual product differences, user habits, and environmental conditions. Please refer to actual usage for reference.","16":"Big thanks to everyone who created these amazing projects: X Armor, Battle Suit of the Bicycle Knight - MWH @sarwtin; Wanderer of the Sand Sea @CrazyJN; Zodiac of The Horse：Ironsoul @SophieXi; Formism Arc Package - Sneaker @FORMISM; Coral Jade·Hunting Recurve Riser @SophieXi; SVEINS ZIP 1 @riccky.svg; Net Planter @Beeaver; Heavy Second Core Mecha by @Kit Crafters; TideSquare @LimeStar; Marble Track Zoetrope Spinner \u0026 Tea Cups Zoetrope Spinner @aPyroDesign; Beauty and the Beast Rose Suncatcher Stained Glass @jamisonusmc; Duality Faces Sculpture @Sculturissimo3D; Go-Kart @2040085396 (大琢磨); Rose @Crow_ck; 2026 Year of the Horse Decorative Ornament @Ansuz; Chevrolet Camaro RS/SS Kit Card @theKitCardGuy.","title":"Note"}},"series":{"h2":{"bannerSection":{"title":"Bambu Lab H2 Series","warmingBanner":{"title":"Vortek Hotend Change System","desc":"2025 Q4, Embark The New Era of Multi-Material Printing"},"h2c":{"title":"Bambu Lab H2C","desc":"Uncompromising Multi-Material."}},"cardSection":{"title":"Why Choose Bambu Lab H2 Series?","cards":{"1":"Four-in-One, Multifunctional","2":"The New Flagship, Packed with Only the Best and Latest","3":"Bambu Lab's Largest Series","4":"The Most Comprehensive AI Assistant for 3D Printing"}},"compare":{"title":"Explore Specs","compareAll":"Compare All Models","attr":{"nozzleNumber":"Nozzle Number","buildVolume":"Build Volume","attachmentCompatibility":"Attachment Compatibility","maxNozzleTemp":"Max Nozzle Temp","maxBuildPlateTemp":"Max Build Plate Temp","AMSCompatibility":"AMS Compatibility","liveviewCamera":"Liveview Camera","toolheadCamera":"Toolhead Camera","birdsEyeCamera":"BirdsEye Camera","nozzleCamera":"Nozzle Camera","motionSystem":"Motion System","supportFilament":"Support Filament","sensors":"Sensors"},"value":{"h2d":{"nozzleNumber":"Dual","buildVolume":"Single: 325mm*320mm*325mm\nDual: 300mm*320mm*320mm\nTotal: 350mm*320mm*320mm","attachmentCompatibility":{"laser":"10W/40W Laser","cutting":"Digital Cutting","pen":"Pen Drawing"},"maxNozzleTemp":"350 °C","maxBuildPlateTemp":"120 ℃","AMSCompatibility":"AMS 2 Pro; AMS; AMS HT","liveviewCamera":"1080P","birdsEyeCamera":"(Equipped with Laser Edition)","motionSystem":"CoreXY","supportFilament":"PLA, PETG, TPU, PVA, BVOH, ABS, ASA, PC, PA, PET, Carbon/Glass Fiber Reinforced PLA, PETG, PA, PET, PC, ABS, ASA, PPA-CF/GF, PPS, PPS-CF/GF","sensors":"36 Sensors"},"h2s":{"nozzleNumber":"Single","buildVolume":"340mm*320mm*340mm","attachmentCompatibility":{"laser":"10W Laser","cutting":"Digital Cutting","pen":"Pen Drawing"},"maxNozzleTemp":"350 °C","maxBuildPlateTemp":"120 ℃","AMSCompatibility":"AMS 2 Pro; AMS; AMS HT","liveviewCamera":"1080P","birdsEyeCamera":"(Equipped with Laser Edition)","motionSystem":"CoreXY","supportFilament":"PLA, PETG, TPU, PVA, BVOH, ABS, ASA, PC, PA, PET, Carbon/Glass Fiber Reinforced PLA, PETG, PA, PET, PC, ABS, ASA, PPA-CF/GF, PPS, PPS-CF/GF","sensors":"23 Sensors"},"h2c":{"nozzleNumber":"Up to 7","buildVolume":"Single: 325mm*320mm*320mm (Left)\nSingle: 305mm*320mm*325mm (Right)\nDual: 300mm*320mm*320mm\nTotal: 330mm*320mm*320mm","attachmentCompatibility":{"laser":"10W/40W Laser","cutting":"Digital Cutting","pen":"Pen Drawing"},"maxNozzleTemp":"350 °C","maxBuildPlateTemp":"120 ℃","AMSCompatibility":"AMS 2 Pro; AMS; AMS HT","liveviewCamera":"1080P","birdsEyeCamera":"(Equipped with Laser Edition)","motionSystem":"CoreXY","supportFilament":"PLA, PETG, TPU, PVA, BVOH, ABS, ASA, PC, PA, PET, Carbon/Glass Fiber Reinforced PLA, PETG, PA, PET, PC, ABS, ASA, PPA-CF/GF, PPS, PPS-CF/GF","sensors":"59 Sensors"}}}}},"h2s":{"header":{"overview":"Overview","diveIn":"Dive In","specs":"Specs","faq":"FAQ","buy":"Buy"},"printer":{"name":"Bambu Lab H2S"},"banner":{"title":"Your Personal Manufacturing Hub","buyNow":"Buy now","watchVideo":"Watch video","bannerAlt":"Bambu Lab H2S Large Format 3D Printer"},"recap":{"title":"Get the Highlights","items":{"1":{"keywords":"20,000 Times/Sec","title":"Extrusion Torque Regulation"},"2":{"keywords":"\u003c 50 μm","title":"Motion Accuracy"},"3":{"keywords":"AI Detection","title":"23 Sensors \u0026 3 Cameras"},"4":{"keywords":"Auto Venting","title":"Filament Drying"},"5":{"keywords":"340mm*320mm*340mm","title":"Large Volume"},"6":{"keywords":"Up to 30%","title":"Faster Print Speed"},"7":{"keywords":"65 °C","title":"Active Heated Chamber"},"8":{"keywords":"10W 455nm","title":"Laser Cutting"}}},"gallery":{"title":"Your Go-To\nPersonal Manufacturing Hub"},"processType":{"printing":"3D Printing","multiColorPrinting":"Multi-Color \n3D Printing","laserCutting":"Laser Cutting","engraving":"Laser \nEngraving","cutting":"Digital \nCutting","drawing":"Drawing"},"chapters":{"1":{"title":"Accuracy That \nWorks for You","sections":{"1":{"title":"\u003ckeywords\u003eCorrect\u003c/keywords\u003e Mechanical Deviations","desc":"Even the printer comes out of the factory with superb accuracy, mechanical wear and variances over time are inevitable—but now, \u003ckeywords\u003efirst time in the industry\u003c/keywords\u003e, there’s a solution.\nWith the Vision Encoder⁽¹⁾, the H2S achieves distance-independent \u003ckeywords\u003emotion accuracy under 50 μm\u003c/keywords\u003e—thinner than a human hair. During calibration, it automatically compensates for mechanical drift, ensuring consistent precision and peak performance over time."},"2":{"title":"\u003ckeywords\u003eOne Print.\u003c/keywords\u003e Perfect Fit.","desc":"Bambu Lab's Auto Hole/Contour Compensation⁽²⁾ minimizes printing tolerances, delivering machine-shop-level precision for hole dimensions. \u003ckeywords\u003eDesign fit-critical parts\u003c/keywords\u003e with confidence—integrate shafts, bearings, and fasteners without trial and error. Post-print assembly has never been easier."},"3":{"title":"Ready for \u003ckeywords\u003eEngineering\u003c/keywords\u003e Filaments","desc":"Featuring a 350 °C hotend and a 65 °C actively heated chamber, it supports the entire Bambu filament lineup—from PLA and PETG to PC and PPA. With closed-loop fan control and precise thermal management, the H2S minimizes warping and deformation while improving layer adhesion. Build \u003ckeywords\u003elarge, high-performance parts\u003c/keywords\u003e that are as functional as they are strong.","tabs":{"1":"350 °C Hotend","2":"65 °C Heated Chamber"}},"4":{"title":"Even Surfaces, \u003ckeywords\u003eCrisp Edges\u003c/keywords\u003e","desc":"H2S uses both the sensing capability of its servo motor on the extruder and the high-resolution eddy current sensors on the nozzle to precisely control extrusion by measuring nozzle pressure and calibrating PA parameters for each filament, improving surface smoothness and edge sharpness."},"5":{"title":"\u003ckeywords\u003ePrecision\u003c/keywords\u003e in Motion","desc":"Active Vibration Compensation neutralizes micro-vibrations and resonance in real time, enabling premium print quality at higher speeds."},"6":{"title":"Print Functional Designs","labels":{"1":"Go-Kart Frame: PAHT-CF","2":"Handbag: TPU for AMS","3":"Seed Starter: PA6-GF","4":"RC Plane: PLA Tough+"}}}},"2":{"title":"Intelligence That's Got Your Back","sections":{"1":{"title":"\u003ckeywords\u003e20,000\u003c/keywords\u003e Checks Per Second","subTitle":"Closed-Loop Feedback, Real-Time Control","desc":"Bambu Lab's proprietary PMSM servo system enables 20 kHz resistance and position sampling to dynamically modulate electromagnetic torque vectors. It stabilizes extrusion and actively detects grinding⁽³⁾ or clogs in real time.","labels":{"1":"Filament grinding","2":"Clogging"}},"2":{"title":"\u003ckeywords\u003e23\u003c/keywords\u003e Sensors + 3 Cameras","subTitle":"Each Potential Risk Has Its Own Detector","tabs":{"1":{"title":"Vision System","desc":"With AI-driven real-time monitoring, the vision system detects clumping, spaghetti and purge chute jamming as they happen, helping prevent failed prints before they start. This same vision system powers advanced features like Live Spatial Alignment, allowing precise laser and cutting calibration, and Vision Encoder technology, which enhances positional accuracy."},"2":{"title":"Feeding","desc":"Filament-path sensors work in unison to monitor feeding speed and position, detect filament tangles and grinding risks, track filament mileage and spool usage, and ensure tool readiness across the AMS, buffer, cutter, and feeding paths, making sure every tool is in place and every move is under control."},"3":{"title":"Thermal Control","desc":"Five NTC temperature sensors are strategically placed across the nozzle, heatbed, and chamber. Paired with integrated airflow sensors, the system actively monitors and adjusts internal temperatures and circulation, maintaining the ideal print environment through real-time feedback control."},"4":{"title":"Safety","desc":"The H2S features five flame sensors, front-door and top-cover sensors, and emergency stop button to form a complete safety system. It detects fire risks, monitors enclosure alignment, and allows instant shutdown when needed—protecting your projects and your workspace at all times."}}},"3":{"title":"Pre-Flight \u003ckeywords\u003eChecklist\u003c/keywords\u003e by AI","desc":"Prior to each operational cycle, the H2S vision system initiates a comprehensive pre-flight checklist: Chamber Integrity Scan – Detects debris across the entire print surface. Hardware Configuration Audit – Instantly identifies build plate properties."},"4":{"title":"\u003ckeywords\u003eFlap Switch\u003c/keywords\u003e Airflow \u0026 Filtration System","subTitle":"3D Printing \u0026 Laser Cutting. 3 Modes, All-in-One","cards":{"1":{"title":"High-Temp Printing","desc":"Chamber sealed. Internal air recirculates through the Air Filter and the heater to stabilize high-temp conditions. Print large engineering parts without warping."},"2":{"title":"Low-Temp Printing","desc":"Top Vent opens to bring in cool air, while maintaining a filtered exhaust⁽⁴⁾. Print PLA and PETG without opening the door, and handle overhangs and bridging with ease."},"3":{"title":"Laser Cutting/Engraving","desc":"Top Vent and Filter Switch Flap open. Fumes are channeled efficiently to the ventilation system, keeping your workspace safe and clean."}}}}},"3":{"title":"Bigger. Faster. Better.","sections":{"1":{"title":"\u003ckeywords\u003eMaximum Volume.\u003c/keywords\u003e Maximum Productivity.","desc":"With a build volume of \u003ckeywords\u003e340mm*320mm*340mm\u003c/keywords\u003e, the H2S offers the largest print space among all Bambu Lab printers. Your Vision. Fully Realized \u003ckeywords\u003ein One Print.\u003c/keywords\u003e","imgs":{"1":{"title":"120% Larger Build Volume","subTitle":"Than the X1 Carbon"},"2":{"title":"Full Scale Printing","subTitle":"Print bigger, with fewer plates"}}},"2":{"title":"\u003ckeywords\u003eTop Speed.\u003c/keywords\u003e More Reliable Than Ever.","desc":"Bambu Lab’s proprietary PMSM⁽⁵⁾ servo extrusion system delivers \u003ckeywords\u003e67% more extrusion force\u003c/keywords\u003e, providing solid support to high flow⁽⁶⁾ printing. Paired with up to 1000 mm/s toolhead speed and up to 20,000 mm/s² acceleration, your H2S can finally go full throttle—\u003ckeywords\u003ecutting your printing time by up to 30%\u003c/keywords\u003e⁽⁷⁾—while maintaining top-tier quality.","imgs":{"1":{"title":"DynaSense Extruder","subTitle":"PMSM servo extruder delivers up to 10kg of extrusion force—67% more than regular stepper motors, delivering the strongest support for high-flow printing."},"2":{"time":"1 day 7 hours","title":"12.3% Faster Than X1C"},"3":{"time":"1 day 1 hour","title":"11.2% Faster Than X1C"},"4":{"time":"6 days","title":"22.2% Faster Than X1C"}}}}},"4":{"title":"Cut. Engrave. Draw.","sections":{"1":{"title":"Compact. Capable. \u003ckeywords\u003eAll in One.\u003c/keywords\u003e","cards":{"1":{"title":"Live Spatial Alignment","subTitle":"Top-down BirdsEye camera⁽⁸⁾ and onboard toolhead camera enable Live Spatial Alignment, letting you preview the toolpath directly on your material with 0.3 mm accuracy. What you see is what you get."},"2":{"title":"Auto Arrangement","subTitle":"Bambu Suite automatically arranges your project shapes to make the most of every sheet—smart, efficient, and effortless."},"3":{"title":"10W 455nm Laser Power","subTitle":"Slice through up to 5 mm plywood, acrylic, or PU with ease—clean, fast, and precise."},"4":{"title":"Air Assist","subTitle":"Air Assist keeps your lines crisp by blowing away smoke and char while cooling the surface—preventing soot buildup and beam distortion for sharp, clean results."},"5":{"title":"Digital Cutting","subTitle":"Effortlessly cut through paper, vinyl, PU leatherette, and more—clean, accurate, and ready to apply."},"6":{"title":"Drawing","subTitle":"Use the drawing module to automate linework, sketches, or handwritten notes—precise, repeatable, and hands-free."}}},"2":{"title":"Not a Toolkit. \nA Production-Ready Platform."}}},"5":{"title":"Protected Inside \nand Out","sections":{"1":{"title":"Safety, Built In","labels":{"1":{"title":"Laser Safety Window","desc":"Shields your eyes from the 455 nm laser beam while keeping your workspace clear and visible."},"2":{"title":"Five Flame Sensors","desc":"Advanced sensors continuously monitor for fire risks. If an issue is detected, a loud buzzer and mobile alert⁽⁹⁾ notify you immediately—so you can act fast and stay safe."},"3":{"title":"Flame-Retardant Chamber","desc":"Constructed with fire-resistant materials throughout, the chamber provides passive protection for added safety."},"4":{"title":"Emergency Stop","desc":"Immediately halt operations if something feels off—giving you full control and added peace of mind."}}},"2":{"title":"Connectivity, By All Means \n\u003ckeywords\u003ePrivacy, By Design\u003c/keywords\u003e","desc":"The H2S offers seamless cloud connectivity for convenient remote control from any device. For security-sensitive applications, it also delivers complete offline functionality, ensuring physically isolated operation. Users can control the printer, send files, and upgrade firmware—no internet required. Additionally, Developer Mode unlocks MQTT port access, empowering developers and integrators to connect third-party components and custom software with ease.⁽¹⁰⁾"}}},"6":{"title":"Accessible. Comfortable. Made to Last.","sections":{"1":{"title":"Quick-Swap Nozzle","desc":"Swap nozzles in seconds—no tools, no hassle. Whether you're switching to a high flow hotend or a different nozzle size, the redesigned hotend makes it easy and intuitive, even for first-time users."},"2":{"title":"Quiet by Design","desc":"With Active Motor Noise Canceling and specialized air duct noise-reduction technology, the H2S operates \u003ckeywords\u003ebelow 50 dB\u003c/keywords\u003e⁽¹¹⁾. Print overnight or in shared spaces without disrupting your environment."},"3":{"title":"All-Metal, Die-Cast Body","desc":"The integrated die-cast aluminum alloy chassis delivers a sturdy, stable structure that provides a rigid foundation for high-speed, large-format printing, while minimizing accuracy loss caused by micro-twisting."}}},"7":{"title":"Multi-Color Printing and Drying, All-in-One","amsCard":{"1":{"title":"AMS 2 Pro","buttonText":"Learn More"},"2":{"title":"AMS HT","buttonText":"Learn More"}},"sections":{"1":{"title":"Electro-Magnetic Air Vent","desc":"Automated venting facilitates dehumidification during drying and airtight sealing for weeks of quality printing."},"2":{"title":"Auto-Rotate Drying","desc":"During the drying process, the filament spools rotate automatically to provide more even drying."},"3":{"title":"RFID Sync","desc":"AMS 2 Pro uses RFID to auto-match drying settings for Bambu official filaments, no manual input needed."}}},"8":{"title":"Endless Models to Print","sections":{"1":{"sectionTitle":"MakerWorld","title":"Over a Million Models at Your Fingertips","desc":"On \u003ckeywords\u003eMakerWorld\u003c/keywords\u003e, you'll find an endless supply of great models, all ready for your H2S. With \u003ckeywords\u003eseamless integration\u003c/keywords\u003e, you can skip the hassle of figuring out settings or slicing. The perfect print profiles for your specific printer and filaments are already in place. Simply \u003ckeywords\u003ehit print and get started!\u003c/keywords\u003e This kind of effortless printing is standard on MakerWorld, so you'll always have something new to try, and your printer can keep busy!"},"2":{"sectionTitle":"MakerLab","title":"AI Assisted 3D Modeling Tools, Bring Your Vision to Life","desc":"Transform your favorite artwork into a personalized lightbox, turn a beloved photo into a relief sculpture, or create one-of-a-kind PrintMon figurines from a simple prompt. With Bambu Lab MakerLab, you can \u003ckeywords\u003edesign and customize without any 3D modeling skills\u003c/keywords\u003e. Create a bookmark with your favorite anime characters, or an organizer tailored to your desk, with the perfect spot for sticky notes. Whatever you envision, you can create."},"3":{"sectionTitle":"Maker's Supply","title":"Go-To Source for Parts that Bring 3D Prints to Life","desc":"\u003ckeywords\u003eMaker's Supply provides all the non-3D printed hardware you need for your projects, from motors and LEDs to bolts and magnets\u003c/keywords\u003e. Every pre-tested kit precisely matches the Bill of Materials (BOM) for your chosen MakerWorld project. Just print, assemble, and enjoy!"}}},"9":{"title":"Integrated Ecosystem, End-to-End Support","sections":{"1":{"sectionTitle":"Software Ecosystem","title":"Control \u0026 Browse From Any Device, Anywhere","desc":"\u003ckeywords\u003eBambu Studio, Bambu Handy, and Bambu Suite create a seamless ecosystem, letting you manage and control your printer, and browse MakerWorld content from anywhere, on any device.\u003c/keywords\u003e Our integrated account system links all your activities, so you never have to worry about losing progress when switching devices or locations."},"2":{"sectionTitle":"Bambu Lab Academy","title":"Master Your Printer with Easy-to-follow Lessons","desc":"Whether you're just starting your 3D printing journey or aiming for professional mastery, \u003ckeywords\u003eBambu Academy offers tailored lessons for you and your specific printer model.\u003c/keywords\u003e Our carefully designed curriculum caters to all skill levels, helping you quickly gain knowledge and know-how to make the most of your printer."},"3":{"sectionTitle":"Bambu Lab Wiki","title":"Find Answers to Every Printing Problem","desc":"No matter what problem you encounter, you can find the answer here. From handling nozzle clogging and filament clumping to maintaining worn printer parts, Bambu Lab Wiki offers \u003ckeywords\u003e step-by-step guides with clear instructions and helpful graphics.\u003c/keywords\u003e Whether you're troubleshooting or simply want to understand your printer better, you'll find the detailed guidance here."}}},"video":{"title":"See What You Can Do With 3D Printing"}},"note":{"1":"1. Vision Encoder: Vision Encoder needs to be purchased separately on the Bambu Lab Store.","2":"2. Auto Hole/Contour Compensation: Auto Hole/Contour Compensation must be enabled in Bambu Studio and requires the use of designated Bambu filaments.","3":"3. Filament grinding detection on the DynaSense Extruder may vary depending on filament type.","4":"4. Filter Mode for low-temperature printing is optional and is expected to launch as early as Q1 2026.","5":"5. Permanent Magnet Brush-less Servo Motor.","6":"6. High Flow Hotend are optional equipment and can be purchased from the official store.","7":"7.  When using Bambu Lab PLA Basic to print a 200mm*200mm*200mm cube with 15% infill, the printing time can be reduced by up to 30% compared to Bambu Lab X1C. Actual time savings may vary depending on the model, infill, and filament used.","8":"8. The laser and digital cutting functions are all controlled and visualized through Bambu Suite. Live Spatial Alignment is enabled by the BirdsEye Camera. The BirdsEye Camera comes standard with the H2S Laser Edition, or can be added via the Laser Upgrade Kit.","9":"9. Push notifications require the use of Bambu Handy and cloud connectivity.","10":"10. Due to safety protocol, Developer mode cannot be enabled when using Laser and Cutting functions.","11":"11. Background noise: 40 dB; Test distance: 1 m.","12":"12. The go-kart frame shown in the picture is merely a component of the complete vehicle. Its usability and durability are limited by the overall design and construction of the vehicle. It cannot be used on the road until permission is obtained from the local relevant authorities. When conducting any operations, please strictly abide by the applicable local laws, regulations and safety standards to avoid risks or damages.","13":"13.  Creator projects are provided for illustrative purposes only. Bambu Lab does not endorse, and disclaims any representations or warranties regarding creator projects, including, without limitation, the safety, marketability, or usability of any 3D printed works based on such projects. See our Terms of Service for more information.","14":"14. Ensure that a person must be present at all times to closely monitor the machine during laser engraving and cutting operations. Do not open the laser safety window while the machine is operating. The laser process should only be observed through the designated laser safety window. Individuals with medical conditions or sensitivities (e.g., to strong light or smoke) must strictly follow professional medical advice before operating or approaching the machine.\nFor safety instructions regarding laser use, refer to the Laser Module Safety Guidelines Wiki (https://wiki.bambulab.com/en/h2/manual/imp-info-laser) and the Laser Safety Document (https://wiki.bambulab.com/en/h2/laser-safety-document).","15":"15. All product data for the H2S, such as PMSM extrusion force improvement and model print times, is based on Bambu Lab’s internal testing. Actual results may vary due to individual product differences, user habits, and environmental conditions. Please refer to actual usage for reference.","16":"16. Big thanks to everyone who created these amazing projects: Crimson Shadow, Sword of the Dark Knight, Shadowforged Armor @sarwtin; Pacific Clipper @Rarecho Studio; CyberTrack @CyberBrick™; Truck, Sport Car @SophieBigRat @jinghai; MODCASE HYPER @HaydnBao; Fishcaster-Lite Electric Guitar @user_2955528674 (翻滚吧咸鱼); Storage Toolbox @schuylab; Standard Gridfinity Bin Set @Finneas; Go-Kart @2040085396 (大琢磨); \"Growing Taller\" Small Bag @riccky.svg; Self Watering Seed Starter @Meyui; Small FPV Aircraft @LaoYan FPV; Classic Roadster @21CNCStudio; Pen Holder @yanribing; Folding Wooden Box @woodbear; Round Box @brandon8747; Candy Carrying Tricycle @garagem 167; Floral Keepsake Box @MetaImi; Football Helmet @animuL67; Side Table @AEKI; Mini Catmaw - CyberBrick Edition @polymech3d; The Grand Budapest Hotel @雅杰不加班.","title":"*Footnotes:","richText":"1. Vision Encoder: Vision Encoder needs to be purchased separately on the Bambu Lab Store.\n2. Auto Hole/Contour Compensation: Auto Hole/Contour Compensation must be enabled in Bambu Studio and requires the use of designated Bambu filaments.\n3. Filament grinding detection on the DynaSense Extruder may vary depending on filament type.\n4. Filter Mode for low-temperature printing is optional and is expected to launch as early as Q1 2026.\n5. Permanent Magnet Brush-less Servo Motor.\n6. High Flow Hotend are optional equipment and can be purchased from the official store.\n7.  When using Bambu Lab PLA Basic to print a 200mm*200mm*200mm cube with 15% infill, the printing time can be reduced by up to 30% compared to Bambu Lab X1C. Actual time savings may vary depending on the model, infill, and filament used.\n8. The laser and digital cutting functions are all controlled and visualized through Bambu Suite. Live Spatial Alignment is enabled by the BirdsEye Camera. The BirdsEye Camera comes standard with the H2S Laser Edition, or can be added via the Laser Upgrade Kit.\n9. Push notifications require the use of Bambu Handy and cloud connectivity.\n10. Due to safety protocol, Developer mode cannot be enabled when using Laser and Cutting functions.\n11. Background noise: 40 dB; Test distance: 1 m.\n12. The go-kart frame shown in the picture is merely a component of the complete vehicle. Its usability and durability are limited by the overall design and construction of the vehicle. It cannot be used on the road until permission is obtained from the local relevant authorities. When conducting any operations, please strictly abide by the applicable local laws, regulations and safety standards to avoid risks or damages.\n13.  Creator projects are provided for illustrative purposes only. Bambu Lab does not endorse, and disclaims any representations or warranties regarding creator projects, including, without limitation, the safety, marketability, or usability of any 3D printed works based on such projects. See our Terms of Service for more information.\n14. Ensure that a person must be present at all times to closely monitor the machine during laser engraving and cutting operations. Do not open the laser safety window while the machine is operating. The laser process should only be observed through the designated laser safety window. Individuals with medical conditions or sensitivities (e.g., to strong light or smoke) must strictly follow professional medical advice before operating or approaching the machine.\nFor safety instructions regarding laser use, refer to the Laser Module Safety Guidelines Wiki (https://wiki.bambulab.com/en/h2/manual/imp-info-laser) and the Laser Safety Document (https://wiki.bambulab.com/en/h2/laser-safety-document).\n15. All product data for the H2S, such as PMSM extrusion force improvement and model print times, is based on Bambu Lab’s internal testing. Actual results may vary due to individual product differences, user habits, and environmental conditions. Please refer to actual usage for reference.\n16. Big thanks to everyone who created these amazing projects: Crimson Shadow, Sword of the Dark Knight, Shadowforged Armor @sarwtin; Pacific Clipper @Rarecho Studio; CyberTrack @CyberBrick™; Truck, Sport Car @SophieBigRat @jinghai; MODCASE HYPER @HaydnBao; Fishcaster-Lite Electric Guitar @user_2955528674 (翻滚吧咸鱼); Storage Toolbox @schuylab; Standard Gridfinity Bin Set @Finneas; Go-Kart @2040085396 (大琢磨); \"Growing Taller\" Small Bag @riccky.svg; Self Watering Seed Starter @Meyui; Small FPV Aircraft @LaoYan FPV; Classic Roadster @21CNCStudio; Pen Holder @yanribing; Folding Wooden Box @woodbear; Round Box @brandon8747; Candy Carrying Tricycle @garagem 167; Floral Keepsake Box @MetaImi; Football Helmet @animuL67; Side Table @AEKI; Mini Catmaw - CyberBrick Edition @polymech3d; The Grand Budapest Hotel @雅杰不加班"}},"h2d":{"header":{"overview":"Overview","diveIn":"Dive In","specs":"Specs","faq":"FAQ","buy":"Buy","personalManufacturing":"Personal Manufacturing Hub","accuracy":"Accuracy","dualNozzle":"Dual-Nozzle","intelligence":"Perception Drives Intelligence","bigger":"Bigger \u0026 Better","safety":"Safety","ams":"All-New AMS"},"printer":{"name":"Bambu Lab H2D"},"banner":{"title":"Rethink \nPersonal Manufacturing","buyNow":"Buy now","watchVideo":"Watch video"},"highlight":{"1":{"title":"Revolutionizing Accuracy","desc":"One order of magnitude higher motion accuracy."},"2":{"title":"All-In-One Personal Manufacturing Hub","desc":"Integrated 3D printing, laser engraving/cutting, and  digital cutting/plotting in a unified platform."},"3":{"title":"Dual-Nozzle, Double Flexibility","desc":"Fast and efficient multi-material printing!","author":"3D Printed Shoes by @马黛"},"4":{"title":"AI-Powered Simplicity","desc":"4 computer vision cameras*, 36 sensors, 2 servo motors united by sophisticated algorithm for your simplicity."},"5":{"title":"Next-Gen Filament Management","desc":"Drying, feeding and storage in a single package.","note":"*AMS HT sold separately"}},"gallery":{"1":{"title":"Shoes","author":"3D Printed Shoes - WhaleBerry @CloudBerry"},"2":{"title":"Bionic Butterfly Lamp","author":"Butterfly Lamp @MakerWorld"},"3":{"title":"Bike Saddle","author":"Bike Saddle @八宝"},"4":{"title":"Bike Helmet","author":"Bike Helmet @CloudBerry"},"5":{"title":"Armor Suit","author":"Assassin Armor @寺工"},"6":{"title":"Birthday Card","author":"Birthday Card @Viktor Losev "},"title":"\u003c0\u003eEndless Possibilities of \u003c/0\u003e\u003c1\u003ePersonal Manufacturing\u003c/1\u003e\u003c2\u003e\u003c/2\u003e","processType":{"3DPrinting":"3D Printing","multiMaterial":"Multi-material \n3D Printing","dualColor":"Dual-color \n3D printing","digitalCutting":"Digital \nCutting","laserEngraving":"Laser \nEngraving","laserCutting":"Laser \nCutting"}},"accuracy":{"section":{"1":{"title":"Revolutionizing Accuracy","desc":"With a motion system that is \u003cgreen\u003e 10 times more accurate\u003c/green\u003e, H2D significantly \u003cgreen\u003e reduces the hassle\u003c/green\u003e of tweaking designs and settings to \u003cgreen\u003eaccommodate standard components\u003c/green\u003e or \u003cgreen\u003efitting printed parts\u003c/green\u003e together."},"2":{"sectionTitle":"Our Secret Weapon:Vision Encoder","title":"50µm ultra-fine motion accuracy","desc":"An ultra-accurate vision encoder plate, combined with 5µm resolution optical measurements to track and correct toolhead motion, enables the H2D to achieve consistent and reliable distance-independent 50μm motion accuracy across the entire workspace, one order of magnitude better than its predecessor. (*Vision Encoder sold separately)"},"3":{"sectionTitle":"Auto Hole/Contour Compensation","title":"Perfect fit, first time, every time – no adjustments needed","desc":"Thanks to H2D's enhanced motion accuracy and Bambu Studio's specialized calibration for selected Bambu Lab filaments, you can achieve perfect fits with standard parts like steel shaft every time—no more tedious gap adjustments needed."},"4":{"sectionTitle":"Dual-Nozzle, \u003c25μm Offset","title":"Two nozzles that print like one","desc":"Our state-of-the-art nozzle sensing technology provides fast and reliable calibration, aligning both nozzles before each print. The non-contact measurements are robust and unaffected by nozzle contamination.","media":{"1":"H2D","2":"Competitor"},"text":{"1":"H2D Dual-nozzle ","2":"Others"}}},"more":{"card1":{"sectionTitle":"Nozzle pressure sensing and Active Flow Rate Compensation","title":"Smooth surfaces, sharp edges","desc":"H2D uses both the sensing capability of its servo motor on the extruder and the high-resolution eddy current sensors on the nozzle to precisely control extrusion by measuring nozzle pressure and calibrating PA parameters for each filament, improving surface smoothness and edge sharpness."},"card2":{"sectionTitle":"Active Vibration Compensation","title":"Silky smooth at lightning speed","desc":"To minimize banding artifacts during high-speed printing, H2D employs automatic vibration compensation. Using toolhead sensors, the system recalibrates parameters before each print for consistently smooth and stable results."},"card3":{"sectionTitle":"Floating Damper Feet","title":"Isolate unwanted vibration for better print quality","desc":"The H2D employs floating damper feet with a precisely tuned resonance frequency to effectively decouple the machine from desktop vibrations. This vibration isolation system ensures consistent print quality even in the presence of external vibration sources."}}},"personalManufacturing":{"section":{"1":{"title":"Personal Manufacturing Hub","desc":"H2D is not only a 3D printer, it adds \u003cgreen\u003elaser\u003c/green\u003e engraving and cutting, \u003cgreen\u003edigital cutting and plotting\u003c/green\u003e to your studio, unlocking new creative possibilities."},"2":{"sectionTitle":"Live Spatial Alignment","title":"What-You-See-Is-What-You-Get ","desc":"The H2D’s BirdsEye camera, combined with computer vision algorithms, delivers top-view alignment accuracy up to 0.3mm. This advanced spatial alignment allows users to place the tool path at the right position on the material – truly \"what-you-see-is-what-you-get.\""},"3":{"sectionTitle":"Print-Then-Cut","title":"Make colorful projects with ease","desc":"Instantly transform graphic prints into precise cuts. Design and print with Bambu Suite and your graphic printer, then use the H2D to cut it out. Its AI camera automatically aligns the cutting path to the graphic, ensuring perfect registration with minimal effort."},"4":{"sectionTitle":"Auto Arrangement","title":"Maximize material efficiency, minimize waste","desc":"Leveraging real-time images from the BirdsEye camera, Bambu Suite can automatically arrange your project according to the shape of your material, i.e left over plywood from the previous project. This feature helps you to get the most out of every material.","key":"Arrange"}},"swiper":{"1":{"title":"Laser","desc":"10W and 40W 455nm Laser for engraving \u0026 cutting"},"2":{"title":"Digital Cutting","desc":"Precise cutting on variety of materials"},"3":{"title":"Pen Drawing","desc":"Drawing and writing"},"createdBy":"Model created by {{author}}"},"cardSection":{"1":{"title":"Bye-bye to manual laser focusing and thickness setting","cards":{"1":{"title":"Material CodeSync","desc":"The H2D automatically scans the QR code on your material to load the perfect preset."},"2":{"title":"Full-Auto Calibration","desc":"A single tap initiates automated laser focus verification and material measurement, eliminating manual adjustments."}}},"2":{"title":"A Hard Core Laser Machine","cards":{"1":{"title":"High Power 455nm Laser","desc":"Cut 5mm plywood with the 10W laser, and 15mm plywood with the 40W laser."},"2":{"title":"Air Assist","desc":"Improve surface quality by directing high-speed air to cool the laser path, ensuring cleaner and more precise results."},"3":{"title":"Contact-less 3D Mesh","desc":"Advanced optical height measurement creates a detailed 3D mesh without physical contact, enabling precise laser work on curved surfaces."},"4":{"title":"Rotary Attachment","desc":"Expand your capabilities with the rotary attachment, allowing laser engraving on cylinders, spheres, and rings."},"5":{"title":"Laser Safety Windows","desc":"Operate and monitor laser projects safely without the need for goggles."},"6":{"title":"Air Purifier","desc":"An optional air purifier ensures clean air, even during indoor laser operations."}}}}},"dualNozzle":{"section":{"1":{"title":"Dual-Nozzle Double Flexibility","desc":"Experience the artistry of mechanics and the full potential of \u003cgreen\u003emulti-material printing\u003c/green\u003e with H2D's groundbreaking dual-nozzle switching system.  \u003cgreen\u003eLightweight, precise and reliable\u003c/green\u003e, it enables worry-free material changes, unlocking a world of creative possibilities.","nozzle":{"left":"Left Nozzle","right":"Right Nozzle"}},"2":{"sectionTitle":"Full-Auto Dual-Nozzle Offset Calibration","title":"No manual tuning, no calibration tools","desc":"Experience hassle-free accuracy with eddy current sensing technology, delivering fast, contact-free, and fully automatic dual-nozzle offset calibration. Immune to nozzle debris, this system eliminates the need for manual tools or guides, streamlining your workflow."}},"cardSection":{"1":{"cards":{"1":{"sectionTitle":"Multi-Material Printing","title":"Flexible and rigid, low cost and exotic materials in one print","desc":"Combine flexible and rigid materials in a single print to create impressive interlocking structures and innovative designs beyond traditional manufacturing. Pairing high-performance materials with standard ones further reduces costs and boosts material efficiency by using premium materials only where necessary.","author":"MOCA Pro @thrutheframe "},"2":{"sectionTitle":"Dedicated Support Material","title":"Perfect supports with minimal waste, purging and reloading","desc":"Print with support is no longer a headache. With H2D’s dual-nozzle setup, one nozzle can be reserved for dedicated support material, allowing secured print and perfect support interface.","author":"AirPods Max Case @设计发射塔"},"3":{"sectionTitle":"Efficient Multi-Color Printing","title":"Fast and efficient multi-color printing","desc":"Dual-nozzle printing reduces purge cycles in multi-color prints. H2D's smart algorithms optimize filament use, maximizing dual-nozzle efficiency to save time and materials."}}}}},"intelligence":{"section":{"1":{"title":"Perception Drives Intelligence","desc":"H2D redefines \u003cgreen\u003esensor supremacy\u003c/green\u003e in personal manufacturing. This technological orchestrator integrates a \u003cgreen\u003equad-camera\u003c/green\u003e computer vision system* with an array of \u003cgreen\u003e36 sensors\u003c/green\u003e, all harmonized through our proprietary \u003cgreen\u003eneural algorithm\u003c/green\u003e – delivering \u003cgreen\u003emicron-level measurement\u003c/green\u003e accuracy, self-optimizing calibration protocols, and \u003cgreen\u003ereal-time diagnostic\u003c/green\u003e intelligence."},"2":{"sectionTitle":"Pre-Flight Checklist by AI","title":"Peace of mind, every time you print","desc":"Prior to each operational cycle, H2D's vision system initiates a comprehensive pre-flight checklist: Chamber Integrity Scan – Detects debris across the entire print surface. Hardware Configuration Audit – Instantly identifies nozzle dimensions and build plate properties."},"3":{"sectionTitle":"DynaSense Extruder","title":"Intelligent sensing for precise extrusion control","desc":"Bambu Lab's proprietary PMSM servo architecture establishes an intelligent extrusion governance system. It executes 20kHz Torque/Resistance and position sampling to dynamically modulate electromagnetic torque vectors. Stabilizing extrusion and detecting filament grinding and clogging. "},"4":{"sectionTitle":"SOTA Filament Monitoring","title":"Intelligent sensing for precise extrusion control","desc":"Bambu Lab's proprietary PMSM servo architecture establishes an intelligent extrusion governance system. It executes 20kHz Torque/Resistance and position sampling to dynamically modulate electromagnetic torque vectors. Stabilizing extrusion and detecting filament grinding and clogging. "},"5":{"sectionTitle":"SOTA Filament Monitoring","title":"15 sensors on one filament path","desc":"Unlike legacy systems with single filament run-out detectors, the H2D features comprehensive material flow monitoring. Throughout the AMS-to-nozzle path, 15 strategic sensors form an intelligent network, continuously tracking five key parameters: feeding velocity, tension, filament tip location, extruder thermal environment, and dynamic extrusion pressure. This establishes an industry-leading filament behavior control system."},"6":{"sectionTitle":"Health Management System 2.0","title":"Full support from start to finish","desc":"The HMS system uses sensors and cameras to pinpoint printing issues with advanced logic, similar to car diagnostics codes. It provides clear, detailed troubleshooting guidance, allowing you to quickly resolve problems and get back to your creative work."}},"expandVideoSection":{"sectionTitle":"Nozzle Camera","title":"Monitor extrusion at the nozzle tip","desc":"The H2D features an AI-backed nozzle camera with macro lens. This intelligent monitoring system continuously tracks extrusion patterns, immediately detecting material accumulation, filament deviations, and extrusion failures.","videoLabel1":"Nozzle Clumping","videoLabel2":"Air Printing","videoLabel3":"Spaghetti"}},"bigger":{"section":{"1":{"title":"Bigger, Faster, Better","desc":"The H2D delivers an \u003cgreen\u003eexpanded build volume, faster speeds\u003c/green\u003e, and enhanced capability to work with \u003cgreen\u003ehigh-performance materials\u003c/green\u003e. It opens up new creative opportunities while broadening your material options, empowering you to take your projects to the next level."},"2":{"sectionTitle":"King-Size Work Zone","title":"Break free from size constraints","desc":"With a print volume up to 350mm*320mm*320mm*, creating large-scale projects has never been easier! From laser engraving on sizable objects to printing oversized models, the expanded capacity empowers you to bring even your most ambitious ideas to life.","media":{"1":"Max","2":"Single-nozzle","3":"Dual-nozzle"}},"3":{"sectionTitle":"350°C Hotend \u0026 65°C Chamber Heating","title":"Unleash the full potential of high-performance materials","desc":"Equipped with 65°C active chamber heating and a high-temperature hotend reaching up to 350°C, the H2D delivers precise closed-loop temperature control. This advanced system effectively eliminates warping and deformation in high-performance materials, ensuring superior layer bonding and maximizing their full potential.","media":{"1":"High-temp Hotend","2":"Chamber Heating"}},"4":{"sectionTitle":"REAL High-Flow Hotend","title":"Consistently print at 600mm/s","desc":"The H2D’s purpose-built high-flow hotend ensures reliable, high-speed printing at 600mm/s. Designed for consistent performance, it eliminates mid-print flowrate restrictions, enabling uninterrupted high-speed printing regardless of the print size or complexity."}},"more":{"card1":{"sectionTitle":"Hardened Steel Extruder and Nozzle","title":"Reliable for fiber-reinforced material printing","desc":"H2D’s extrusion system and nozzle are crafted from hardened steel, offering exceptional durability and wear resistance. Designed specifically for stable, long-term printing of high-performance fiber-reinforced materials."},"card2":{"sectionTitle":"Full-Metal Frame \u0026 Die-cast Chassis","title":"Solid for high-speed \u0026 accuracy","desc":"The integrated die-cast aluminum alloy chassis offers a sturdy and stable structure, provides rigid foundation for high-speed, large-format printing while minimizing accuracy loss due to micro-twisting. "},"card3":{"sectionTitle":"Quick-Swap Nozzle","title":"Nozzle change with 1-clip","desc":"Achieve truly tool-free, hassle-free hotend replacement with a simple lock clip – easy to operate, quick, and convenient without the need to unplug wires."}}},"safety":{"chapter":{"title":"Safety, Checked!","desc":"H2D's \u003cgreen\u003eupgraded safety\u003c/green\u003e design enhances user confidence. Utilizing internal sensors, it provides sensitive \u003cgreen\u003eactive protection, preventing potential issues\u003c/green\u003e. The specialized \u003cgreen\u003eair circulation\u003c/green\u003e and \u003cgreen\u003elaser safety\u003c/green\u003e systems ensure optimal safety and a superior operating environment in \u003cgreen\u003eall conditions\u003c/green\u003e."},"section":{"1":{"title":"Laser Protection","desc":"The H2D Laser Edition comes standard with laser safety windows designed to enhance the safety of user observing laser operation. Additionally, doors are equipped with sensor that trigger and emergency stop if opened during laser operation."},"2":{"title":"Emergency Stop \u0026 Loud Buzzer","desc":"H2D Laser Edition is equipped with an emergency stop and audible alarm, designed to help users quickly identify safety issues and easily pause the machine's operation."},"3":{"title":"Flame-Retardant Chamber","desc":"The H2D features flame-retardant material through the chamber designed to provide passive fire safety protection."},"4":{"title":"Flame Sensor","desc":"The H2D chamber is equipped with flame sensors that are designed to quickly detect fire. In the event a fire is detected, the H2D unit can sound a buzzer, and can be configured to send push notifications to help minimize potential risks."},"5":{"title":"Auto Fire Extinguishing System","desc":"An optional CO2 fire extinguisher system is available, which can be activated by the flame sensor in order to more quickly extinguish fire, adding extra peace of mind."},"6":{"title":"Multi-Sensor Closed-loop Temperature Control","desc":"H2D features a closed-loop temperature control system for all heating components, constantly adjusting temperatures based on real-time sensor data. This ensures stable and precise thermal management, keeping the device running efficiently and consistently within optimal temperature ranges."},"7":{"title":"Adaptive Airflow","desc":"Utilizing three mode-switch air flaps and chamber intake/exhaust, H2D's Adaptive Airflow system delivers versatile air management for diverse operational needs. The system intelligently transitions between internal and external circulation, and provides selectable air filtration or heating, resolving challenges such as laser processing odors and dust, 3D printing fume filtration and chamber temperature control, offering a custom air quality solution for your personal manufacturing hub."},"8":{"title":"Seamless Cloud Connectivity \u0026 Off-The-Grid Isolation, For You to Choose","desc":"The H2D offers convenient \u003cgreen\u003ecloud connectivity\u003c/green\u003e for remote control from \u003cgreen\u003eany device\u003c/green\u003e. For \u003cgreen\u003esecurity-sensitive\u003c/green\u003e applications, it also provides full \u003cgreen\u003eoffline functionality\u003c/green\u003e, ensuring \u003cgreen\u003ephysically isolated\u003c/green\u003e security. Users can \u003cgreen\u003econtrol the printer, send files, and upgrade firmware\u003c/green\u003e without an internet connection. Additionally, \u003cgreen\u003eDeveloper Mode\u003c/green\u003e enables MQTT port access for tinkerers who wish to integrate \u003cgreen\u003ethird-party\u003c/green\u003e components and software."}}},"ams":{"section":{"1":{"title":"AMS, Evolved.","desc":"The all-new \u003cgreen\u003e2nd-generation\u003c/green\u003e AMS systems, including the \u003cgreen\u003eAMS 2 Pro\u003c/green\u003e and \u003cgreen\u003eAMS HT\u003c/green\u003e, feature brushless servo feeding motors that significantly boost filament \u003cgreen\u003efeeding efficiency\u003c/green\u003e, accelerating multi-color and multi-material printing. Even better, the 2nd-generation AMS introduces a \u003cgreen\u003efilament drying\u003c/green\u003e function with \u003cgreen\u003eactive air vent\u003c/green\u003e on a fully sealed system, greatly enhancing \u003cgreen\u003edrying efficiency\u003c/green\u003e and maintaining \u003cgreen\u003eoptimal filament conditions\u003c/green\u003e for extended periods.","card":{"1":{"sectionTitle":"Rethink Personal Manufacturing","title":"Bambu Lab AMS 2 Pro","buttonText":"Learn More"},"2":{"sectionTitle":"Rethink Personal Manufacturing","title":"Bambu Lab AMS HT","buttonText":"Learn More"}}},"2":{"title":"Why You Need an All-In-One Manufacturing Hub? ","card":{"1":{"sectionTitle":"Accurate temperature and humidity sensor for clearer readings","title":"Unlock new creative possibilities with hybrid processes"},"2":{"sectionTitle":"Space Saving","title":"Space-saving all-in-one machine: Reclaim your workspace"},"3":{"sectionTitle":"More Bang-for-the-buck","title":"One machine, the value of four"}}},"3":{"title":"Dry Filament Quickly and Intelligently","section":{"1":{"sectionTitle":"Electro-Magnetic Air Vent","title":"Automated venting facilitates dehumidification during drying and airtight sealing for weeks of quality printing."},"2":{"sectionTitle":"Auto-Rotate Drying","title":"During the drying process, the filament spools rotate automatically to provide more even drying."},"3":{"sectionTitle":"RFID Sync","title":"AMS 2 Pro uses RFID to auto-match drying settings for Bambu official filaments, no manual input needed."}}},"4":{"title":"Speed Up! Faster Multi-Material Printing!","cards":{"1":{"title":"Powerful Bambu permanent magnet synchronous servo motor sped-up the filament feeding by 60%"},"2":{"title":"Average 10min saved per 100 filament changes"},"3":{"title":"Faster multi-color printing"}}},"5":{"title":"Evolved, Polished Design Details","section":{"1":{"sectionTitle":"Tool-Free Filament Tubes Access","title":"Removing snapped filament from the first-gen AMS requires extracting all spools and disassembling the shell with two screws, taking 3-5 minutes. In contrast, the AMS 2 Pro offers direct, tool-free access to filament tubes from the top."},"2":{"sectionTitle":"Ceramic Inlet","title":"Ceramic filament inlets with Vickers hardness of 1200 significantly enhances durability."},"3":{"sectionTitle":"Direct Drive Feeding","title":"Brushless motor drives the feeding directly, eliminating gear noise"},"4":{"sectionTitle":"Accurate Temp Sensor","title":"Accurate temperature and humidity sensor for clearer readings"}}}}},"priceContent":{"title":"Bambu Lab H2D","desc":"Rethink \nPersonal Manufacturing","buttonText":"Buy Now"},"note":{"1":"3D mesh feature will be available shortly after the product release through firmware update. ","2":"Rotary Attachment is an optional equipment will be available soon, buy at official store.","3":"Air Purifier is an optional equipment, buy at official store.","4":"BirdsEye camera is only equipped with H2D laser edition, or can be added with laser upgrade kit.","5":"Material CodeSync only works with Bambu official materials.","6":"The optional Vision Encoder is required for Motion Accuracy Enhancement.","7":"Auto Holes-contour Compensation must be enabled in Bambu Studio, and designated Bambu filament must be used.","8":"350mm*320mm*320mm print volume is enable by using identical filaments in both nozzles and print with both nozzles.","9":"High-flow Hotends are optional equipments, buy at official store.","10":"Auto Fire Extinguisher is an optional equipment, will be available soon after the product release.","11":"Due to safety protocol, Developer mode cannot be enabled when using Laser and Cutting functions.","12":"Big thanks to everyone who created these amazing projects.: Automata by @Ross McSweeney; Hand Bag by @file4laser; 3D Printed Shoes - WhaleBerry @CloudBerry; Butterfly Lamp @Darts_3D; Bike Saddle @八宝; Bike Helmet @CloudBerry; Assassin Armor @寺工; Birthday Card @Viktor Losev; Automata by @Ross McSweeney; Birthday Card @popupcardKagisippo; MOCA Pro by @thrutheframe; AirPods Max Case by @设计发射塔; Tesla Model S Plaid by @Mr.Rod; 小米Su7 Ultra Prototype @大匠","title":"Note","0-1":"2 servo motors include the one on the AMS 2 Pro.","8-1":"DynaSense Extruder filament grinding feature limited by filament type.","9-1":"The 600mm/s print speed refering is by using Bambu PLA Matte filament. ","10-1":"Filter Mode for low-temperature printing is optional and is expected to launch as early as Q1 2026.","11-1":"Push notifications require use of Bambu Handy and cloud connectivity.","11-2":"Creator projects are provided for illustrative purposes only. Bambu Lab does not endorse, and disclaims any representations or warranties regarding creator projects, including, without limitation, the safety, marketability, or usability of any 3D printed works based on such projects. See our Terms of Service for more information.","11-3":"The mapping relationship between AMS units and nozzles is one-to-one; filaments in a specific AMS unit can only be printed with the nozzle connected to that AMS unit."},"techTitle":"Bambu Lab H2D - Technical Specifications"},"h2dPro":{"header":{"overview":"Overview","specs":"Specs","faq":"FAQ","contactUs":"Contact Us"},"printer":{"name":"Bambu Lab H2D Pro"},"banner":{"title":"Professional Dual-Nozzle 3D Printing Solution","contactUs":"Contact Us","findReseller":"Find a Reseller"},"chapter":{"service":{"1":{"sectionTitle":"Professional Connection Options","title":"Stable Ethernet Connection, WPA2-Enterprise Authentication Wi-Fi Connection","desc":"The H2D Pro offers the option to connect to your devices through its newly added Ethernet port, ensuring robust network communication in complex environments. Ethernet connectivity can also be used in crowded wireless signal environments. Additionally, the H2D Pro provides WPA2-Enterprise Wi-Fi Authentication (EAP-PEAP/EAP-TLS/EAP-TTLS) and individual physical kill switches for Wi-Fi, meeting stringent network security requirements."},"2":{"sectionTitle":"Enterprise Integration Support","title":"Tailor Solution For Printer Management","desc":"Bambu Lab provides professional support for enterprises to custom-develop efficient printer fleet management tools, meeting their business integration needs. Our expert software R\u0026D team offers full technical assistance to help clients achieve their required customized functionalities. (For more details, please contact your local reseller)"},"3":{"sectionTitle":"Dedicated Service Team","title":"Local response and loaner machines: minimizing your downtime","desc":"Our dedicated weekday support team provides fast response, accurately identifies issues, and offers professional solutions. Local teams are available for on-site service, and for equipment requiring off-site repair, they even can arrange a loaner to ensure your business operations remain seamless."}},"dualNozzle":{"1":{"sectionTitle":"Multi-Material Printing","title":"Flexible and rigid, low cost and exotic materials in one print","desc":"Combine flexible and rigid materials in a single print to create impressive interlocking structures and innovative designs beyond traditional manufacturing. Pairing high-performance materials with standard ones further reduces costs and boosts material efficiency by using premium materials only where necessary."},"2":{"sectionTitle":"Dedicated Support Material","title":"Efficient Support Printing \u0026 Perfectly Smooth Interface","desc":"Print with support is no longer a headache. With H2D’s dual-nozzle setup, one nozzle can be reserved for dedicated support material, allowing secured print and perfect support interface."},"3":{"sectionTitle":"Efficient Multi-Color Printing","title":"Fast and efficient multi-color printing","desc":"Dual-nozzle printing reduces purge cycles in multi-color prints. H2D's smart algorithms optimize filament use, maximizing dual-nozzle efficiency to save time and materials."},"title":"Dual-Nozzle, Enhanced Productivity"},"highTemperature":{"1":{"sectionTitle":"350℃ (662°F) High-Temperature Nozzle","title":"Print engineering filaments better","desc":"Unlock the full potential of your high-temperature engineering filaments with a 350℃ (662°F) nozzle. Experience improved layer bonding when printing demanding materials like PPA-CF, PPS, and PPS-CF at higher temperatures, leading to stronger and more reliable parts."},"2":{"sectionTitle":"65℃ (149°F) Active Chamber Heating \u0026 Cooling","title":"Less failure, stronger prints","desc":"Equipped with a 65°C active chamber heater and adaptive air circulation, the H2D Pro intelligently manages chamber temperature for optimal printing. Active flaps control internal/external airflow based on filament type, preventing low-temp clogs, reducing high-temp warping, improving layer bonding, and fully leveraging each material's strengths."},"3":{"sectionTitle":"Toolhead Enhanced Cooling Fan","title":"Improving high-temperature reliability","desc":"A new high-performance fan integrated into the toolhead front cover effectively cools the extruder and hotend heatsink. This intelligent temperature control mitigates potential clogging and filament jaming in challenging environments, enabling a 3°C increase in the recommended printer operating temperature."},"title":"Professional High-Temperature Printing Solution"},"components":{"1":{"sectionTitle":"Tungsten Carbide Super Durable Nozzle","title":"HRA 90 Tougher nozzle, lower maintainance","desc":"With HRA 90 compared to hardened steel's 74, the H2D Pro's tungsten carbide nozzle provides exceptional wear resistance. This results in a 50% increase in lifespan when printing abrasive, high-performance fiber-reinforced filaments."},"2":{"sectionTitle":"Vision Encoder","title":"50µm ultra-fine motion accuracy","desc":"The H2D Pro comes standard with an ultra-high precision vision encoder plate, utilizing 5µm resolution optical measurement to calibrate toolhead movement. This advanced system ensures consistent and distance-independent 50µm motion accuracy across the entire build area, lay down strong foundation for producing highly accurate prints."},"3":{"sectionTitle":"Heavy Duty Air Filtration","title":"Effectively Filter Particulates And VOCs Generated by 3D Printing","desc":"For optimal air filtration, we've integrated a G3 pre-filter, an H12 HEPA filter, and a premium coconut shell activated carbon filter. This enhanced system effectively minimizes excessive odors and particulates, particularly beneficial when printing in less ventilated spaces."}},"box":{"title":"What In The Box","items":{"1":"Bambu Lab H2D Pro","2":"Bambu Lab AMS 2 Pro","3":"Bambu Lab AMS HT","4":"Vision Encoder Plate","5":"Emergency Stop Button","6":"Textured PEI Build Plate"}}}},"h2c":{"header":{"overview":"Overview","diveIn":"Dive In","showcase":"Showcase","specs":"Specs","faq":"FAQ","buy":"Buy"},"printer":{"name":"Bambu Lab H2C","learnMore":"Learn more"},"banner":{"title":"Uncompromising Multi-Material.","buyNow":"Buy now","watchVideo":"Watch video","bannerAlt":"Bambu Lab H2C Large Format 3D Printer"},"iconSection1":{"title":"Revolutionize How You Print Your Projects"},"models":{"1":{"title":"Paint No More, Print 7 Colors in One-Piece.","name":"Geminaraptor","author":"@FireBird(Sophie)","printing":{"title":"Purge Saving Multi-Color Printing","desc":"Painting intricate models is a thing of the past — the H2C brings your designs to life with six-color printing and a versatile seventh nozzle for support or an additional color. This whole thing is printed in 2 parts. The main raptor is 6-color and the base is another 6-color."}},"2":{"title":"Bring Your Ideas to Life in Full Color with Minimal Waste.","name":"Bambu Lab Racer","author":"@Mr.Rod","printing":{"title":"Purge Saving Multi-Color Printing","desc":"A race car with racing stripes? Yes, you can print it straight out! Forget the hassle of painting or wasting tons of filament."}},"3":{"title":"7 Colors. One Print. No Paint.","name":"Blériot Rider - XI ","author":"@CrazyJN","printing":{"title":"Purge Saving Multi-Color Printing","desc":"An anime-style fighter plane in full color — no paintbrushes, no glue, no fuss.Simply load your filaments and print a flawless one-piece model in no time."}},"4":{"title":"Print Durable Joints — Built Right Into the Parts.","name":"Heavy Second Core Mecha","author":"@Kit Crafters","printing":{"title":"Integrated TPU Joints for Multi-Color Parts","desc":"Print durable TPU ball joints for your robot models — flexible, long-lasting, and built for endless motion."},"materials":{"1":{"name":"TPU for AMS","desc":"Joints"},"2":{"name":"PLA Matte","desc":"Main Body"}}},"5":{"title":"No More Assembly — Print Multi-Material Parts in One Piece.","name":"Aero Mobius Drone Frame","author":"@极尘悦","printing":{"title":"Purge Saving Multi-Material Printing","desc":"With the H2C, you can print up to seven different materials in a single run — no nozzle purging required. Combine multiple material properties in one seamless structure and take integrated design to a whole new level."},"materials":{"1":{"name":"PA6-GF","desc":"Structural rigidity"},"2":{"name":"TPU for AMS","desc":"Impact absorbing"},"3":{"name":"PC FR","desc":"Fire Retardant"}}},"6":{"title":"Bring Color to Flexible Prints.","name":"Multi-Color Sneaker","author":"@CloudBerry","printing":{"title":"Multi-Color TPU Printing","desc":"Bring color and creativity to 3D-printed footwear.With the H2C, you can blend TPU 90A and TPU for AMS to produce multi-color, flexible sneakers that stand out."},"materials":{"1":{"name":"TPU 90A","desc":"Main Body"},"2":{"name":"TPU for AMS","desc":"Colorway \u0026 Torsional Rigidity"}}},"purgeWaste":"Purge and Prime Tower Waste","printTime":"Print Time"},"whatVortek":{"chapterTitle":"Vortek Hotend Change System","cards":{"1":{"title":"Multi-Material Printing with Minimal Purge Waste","desc":"In traditional single-nozzle multi-material printing, purging is needed to clear leftover material between filament changes.Vortek changes that with an intelligent hotend-swapping system that replaces the entire hotend — delivering faster, cleaner prints with minimal waste."},"2":{"title":"Fully Automatic Filament Change","desc":"The Vortek system works seamlessly with our highly reliable AMS (Automatic Material System), making the entire filament change process fully automatic — no need to manually load each filament into the toolhead."},"3":{"title":"Always Delivering the Most Efficient Combination","desc":"The Vortek system can store filament information in the hotend’s memory, ensuring the correct filament is matched to each hotend. If you are printing with more than seven filament types, the system can calculate the optimal combination to minimize purge waste."}}},"whyVortek":{"chapterTitle":"Why Vortek?","cards":{"1":{"title":"Small Form Factor, More Filaments","desc":"Because only the hotend is swapped, the system can house up to six replaceable hotends without significantly reducing the build volume.That means more materials, more colors, and more possibilities — all in one print."},"2":{"title":"8-Second Induction Heating","desc":"Our industry-leading induction heating technology brings the nozzle to temperature in 8-sec, significantly reducing the preheating time for each material swap compared to traditional methods."},"3":{"title":"Contactless Design For Reliability","desc":"Our high standards for reliability led us to move away from contact-based metal pins, which are prone to oxidation and unstable connections.We developed a contactless solution that ensures a stable, high-frequency connection — the foundation for precise temperature control and intelligent hotend sync."},"4":{"title":"Enclosed for High-Performance Printing","desc":"With its seamless enclosure and adaptive airflow system, the H2C maintains a stable chamber temperature for high-performance materials and filters the air to keep your workspace clean and safe."},"5":{"title":"Colors Are No Longer Limited By How Many Toolheads You Have","desc":"Unlike traditional toolchanger printers that limit color count by the number of toolheads, the H2C supports up to 24 materials in a single print through parallel-connected AMS units. Its intelligent algorithm optimizes filament-to-hotend allocation to minimize purge waste while delivering outstanding multi-color and multi-material results."},"6":{"title":"Fully Automatic Nozzle Offset Calibration","desc":"Our inductive nozzle offset calibration is fully automated — no manual steps, no calibration plates, no extra setup. In just a few minutes, the H2C precisely calibrates nozzle offset to within 25 microns.*"},"7":{"title":"Dedicated Hotends for Specific Filaments","desc":"The H2C's Vortek system lets you dedicate one of its six interchangeable hotends to specific filaments — a game-changer for valuable engineering materials.This ensures superior consistency and reliability across prints. Each hotend can even automatically store filament information, so the next time you load that material, it's instantly matched to the correct hotend."}}},"iconSection2":{"title":"Not A Toy, A Serious Production Powerhouse"},"chapters":{"1":{"title":"Superior Print Quality, All Times","sections":{"1":{"title":"Better High-Speed Reliability \u0026 Real-Time Error Detection.","desc":"The PMSM servo extruder delivers up to 10 kg of maximum extrusion force—70% more than stepper motor—dramatically improves high-flowrate extrusion stability. Our proprietary servo architecture samples resistance and position at 20 kHz, actively detecting filament grinding and clogs in real time."},"2":{"title":"50µm Ultra-Fine Motion Accuracy*","desc":"With its Vision Encoder, the H2C achieves a distance-independent motion accuracy of less than 50 μm—thinner than human hair. The system automatically compensates for any mechanical drift during calibration, ensuring consistent precision and peak performance over time.*"},"3":{"title":"Smooth Surface, Sharp Edges","desc":"The H2C leverages both the servo motor on the extruder and the high-resolution eddy current sensors on the nozzle to sense extrusion dynamics. This enables precise extrusion control and automatic calibration of Pressure Advance (PA) parameters for each filament, resulting in smoother surfaces and cleaner, sharper edges.","on":"ON","off":"OFF"}}},"2":{"title":"Engineering Materials Ready","sections":{"1":{"title":"Unleash The Full Potential of High-Performance Materials","desc":"All seven nozzles in the system can reach a maximum temperature of 350 °C, allowing you to print with our entire filament lineup using any nozzle you choose."},"2":{"title":"65 °C Active Heated Chamber","desc":"The H2C's 65 °C actively heated chamber minimizes warping and deformation while enhancing layer adhesion for high-performance, high-temperature filaments."},"3":{"title":"Best-In-Class Air Filtration","desc":"The H2C's three-stage filtration system is essential for printing with engineering filaments. This powerful combination of a G3 pre-filter, an H12 HEPA filter, and a coconut shell activated carbon filter effectively minimizes the odors and harmful particulates often released by engineering materials."}}},"3":{"title":"AI-Powered Simplicity","sections":{"1":{"title":"Comprehensive Print Monitoring","desc":"The H2C is equipped with an array of 59 sensors* and a quad-camera computer vision system, all orchestrated by our proprietary neural algorithm. During printing, this system delivers intelligent, real-time diagnostics that can detect even the most subtle print anomalies as they happen. You don't have to be an expert to solve problems—your printer does the job for you."},"2":{"title":"Nozzle Camera","desc":"The H2C features an AI-backed nozzle camera with macro lens. This intelligent monitoring system continuously tracks extrusion patterns, immediately detecting material accumulation, filament deviations, and extrusion failures.","tabs":{"1":"Spaghetti","2":"Nozzle Clumping","3":"Air Printing"}},"3":{"title":"Pre-Flight Checklist","desc":"Before each print, the H2C's vision system runs a full pre-flight inspection — scanning the build surface for debris and confirming your print start settings. Everything is verified automatically, so every print starts perfectly."}}},"4":{"title":"Safety, Checked!","sections":{"1":{"title":"Fire-Retardant Construction","desc":"The H2C's chamber is constructed entirely with flame-retardant material, providing robust, passive fire safety protection across the entire enclosure."},"2":{"title":"Multi-Sensor Closed-Loop Temperature Control","desc":"The H2C utilizes a sophisticated closed-loop temperature control system for all heating components. By constantly cross-referencing real-time data from multiple sensors, the system ensures stable, precise thermal management, allowing the device to run efficiently and consistently within optimal temperature ranges."},"3":{"title":"Flexible Network Security \u0026 Connectivity","desc":"The H2C offers convenient cloud connectivity for remote control from any device.For security-sensitive applications, it also provides full offline functionality, ensuring complete physical isolation. Users can operate the printer, send files, and update firmware without an internet connection.For advanced users, Developer Mode enables MQTT port access for integrating third-party components and software.*"}}}},"note":{"1":"* All the demonstrated print time \u0026 purge waste data are calculated results by Bambu Studio.","2":"* The advertised Vortek features \u0026 advantages are based on fully utilizing 6 induction hotends of same diameter and corresponding AMS units.","3":"* All product data for the H2C is based on Bambu Lab’s internal testing. Actual results may vary due to individual product differences, user habits, and environmental conditions. Please refer to actual usage for reference.","4":"* The optional Vision Encoder is required for Motion Accuracy Enhancement.","5":"* Auto Holes-contour Compensation must be enabled in Bambu Studio, and designated Bambu filament must be used.","6":"* DynaSense Extruder filament grinding feature limited by filament type.","7":"* \"59 sensors\" is refer to fully equipped H2C Laser Edition with Bird's Eye camera and 6 induction hotends.","8":"* High-flow Hotends are optional equipments, buy at official store.","9":"* Due to safety protocol, Developer mode cannot be enabled when using Laser and Cutting functions.","10":"* Push notifications require use of Bambu Handy and cloud connectivity.","11":"* Creator projects are provided for illustrative purposes only. Bambu Lab does not endorse, and disclaims any representations or warranties regarding creator projects, including, without limitation, the safety, marketability, or usability of any 3D printed works based on such projects. See our Terms of Service for more information.","12":"* The 8-second heating time for induction hotend is based on Bambu PLA Basic printing temperature.","13":"* The “no purging” claim does not include the initial purge required when loading a brand-new filament into a hotend.","14":"* The fire-retardant chamber is made using UL94 V-0 grade materials.","15":"* All induction hotends come with a voluntary one-time replacement within 2 years. For details, please refer to the policy page.","16":"* Big thanks to everyone who created these amazing projects: Geminaraptor by @FireBird(Sophie); Bambu Lab Racer by @Mr.Rod; Blériot Rider - XI by @CrazyJN; Heavy Second Core Mecha by @Kit Crafters; Aero Mobius Drone Frame by @极尘悦; Multi-color Sneaker by @CloudBerry; Gridfinity Anatomical Kidney by @Azrael; Plant Cell by @suezou; EV Charger by @Bambu Lab.","title":"Note:"},"showcase":{"model":{"title":"H2C Innovative Prints","desc":"Fully unlock the potential of \u003ckeywords\u003emulti-color, multi-material\u003c/keywords\u003e printing — the H2C revolutionizes how you approach your 3D printing projects.\nMore colors, more integration — welcome to the new era of \u003ckeywords\u003epersonal manufacturing\u003c/keywords\u003e.","download":"Download","models":{"1":{"name":"GeminaRaptor by @FireBird(Sophie)"},"2":{"name":"Aero Mobius Drone by @极尘悦"},"3":{"name":"Heavy Second Core Mecha by @Kit Crafters"},"4":{"name":"Blériot Rider - XI by @CrazyJN"},"5":{"name":"Bambu Lab Racer by @Mr.Rod"}}}}},"p2s":{"header":{"overview":"Overview","diveIn":"Dive In","showcase":"Showcase","specs":"Specs","faq":"FAQ","buy":"Buy"},"printer":{"name":"Bambu Lab P2S"},"banner":{"title":"The Icon, Redefined.","buyNow":"Buy now","watchVideo":"Watch video","imgAlt":"Bambu Lab P2S Multi Filament 3D Printer"},"typingSection":{"title":"The Icon, Redefined.","desc1":"The iconic \u003ckeywords\u003eBambu Lab P1S\u003c/keywords\u003e revolutionized the 3D printing landscape. Its \u003ckeywords\u003espeed, reliability, and value\u003c/keywords\u003e quickly became the default choice for print farms and enthusiasts, creating the \u003ckeywords\u003elargest wave of popularity\u003c/keywords\u003e in the industry's history.","desc2":"Building on that solid foundation, the evolved \u003ckeywords\u003eP2S\u003c/keywords\u003e now features Bambu Lab's \u003ckeywords\u003e2nd-Gen technologies\u003c/keywords\u003e. It offers a user experience polished to the finest detail and reliably provides the \u003ckeywords\u003etop-quality prints\u003c/keywords\u003e only Bambu Lab can deliver."},"swiperSections":{"user":{"title":"What Makes the P Series Iconic?","cards":{"1":{"user":"Califryburger","desc":"\"I've been running P-series printers since the beta. The Bambu ecosystem feels like the Apple of 3D printing, with the printer, slicer, app, and cloud all working seamlessly. This lets me iterate faster and keep material costs down. My P1S setup and other P-series machines have been rock-solid for two and a half years, still running like day one.\""},"2":{"user":"The Duty Printer","desc":"\"It shouldn't have worked, but it did! Mostly. Me being a moron, I forgot to support the MASSIVE bridge at the top. But the ole P1S just did it anyway! 280mm X 225mm frame with a 1mm width edge contacting the build plate.\""},"3":{"user":"War_Poodle","desc":"\"Since getting my P1S, I've been shocked by how easy it is to try new materials. My sister jokingly sent me a Crocs STL. I tried printing it with generic TPU, no adjustments needed. Twelve hours later, she's wearing a printed Crocs, claiming it's 'more comfortable than a real Crocs.' It's amazing how simple it was to go from an idea to a wearable print!\""},"4":{"user":"TaterTotterer1","desc":"\"I've been running six Bambu Lab P1S printers for a few years now and they've been rock solid. They're easy to maintain and the print quality is always beautiful. I've been really impressed with how consistent they are hour after hour, print after print. For me, reliability is important, and these machines deliver every time.\""},"5":{"user":"DerangedKangaru","desc":"\"Well, today, my kid decided to tip over my workbench, and sent my P1S and AMS flying across the garage. The glass shattered everywhere, the front screen was destroyed, and the printer and AMS looked like they got hit by an RPG. I put the printer back on the workbench, plugged it in, and sent a print over to see how bad the damage was. Flawless, no issues with printing. I am truly amazed at the engineering of the P1S.\""}}},"media":{"cards":{"1":{"desc":"\"Bambu Lab is at it again, producing a near-perfect printer that impressed us with its speed, quality and ability to handle a vast array of materials.\""},"2":{"desc":"\"The Bambu Lab P1S is \u003ckeywords\u003ean easy recommendation for a lot of different situations\u003c/keywords\u003e. For beginners, it's a streamlined experience that \u003ckeywords\u003erequires little effort or prior knowledge from users to achieve great results\u003c/keywords\u003e. For more experienced makers, it's a reliable machine that requires little input when you need a high-quality print quickly.\""},"3":{"desc":"\"All things considered, the combination of \u003ckeywords\u003espeed, quality, ease of use, and price point\u003c/keywords\u003e make the Bambu Lab P1S a \u003ckeywords\u003ehighly recommended printer for anyone\u003c/keywords\u003e in the market.\""},"4":{"desc":"\"Right from unpacking, it's clear that \u003ckeywords\u003ethis printer has been meticulously crafted\u003c/keywords\u003e, from design to protection during transport. The Bambu Lab P1S represents \u003ckeywords\u003eexcellent value for money\u003c/keywords\u003e. Its competitive price, combined with solid performance and well-designed features, make it an attractive option for 3D printing enthusiasts.\""}}},"perfection":{"title":"Perfection, Detail by Detail.","desc":"The P2S features numerous refinements that enhance the user experience. While these incremental improvements may not be immediately apparent, they embody the level of perfection Bambu Lab constantly pursues.","cards":{"1":{"title":"Built-in 2-in-1 Buffer (equipped with AMS combo)","desc":"Effortlessly switch between your AMS and external filament spools for maximum flexibility."},"2":{"title":"Flat Base Plate","desc":"The smooth, flat surface makes it simple to swipe out all residue, keeping your printer clean."},"3":{"title":"Integrated Lift Handles","desc":"Designed for safe and easy transport, these sturdy handles protect your hands and provide a secure grip when moving the printer."},"4":{"title":"Shatter-Safe Front Glass","desc":"Engineered for safety, the front glass is protected by a film built in case of shattering, protecting you and your workspace."}}}},"sections":{"1":{"title":"The User Experience As Good As A Smartphone.","desc":"The P2S features a fully upgraded \u003ckeywords\u003etouchscreen\u003c/keywords\u003e and a \u003ckeywords\u003epowerful processor\u003c/keywords\u003e, running our new intuitive \u003ckeywords\u003esecond-generation UI\u003c/keywords\u003e. Enjoy smoother interactions, richer graphics, and clearer step-by-step instructions.","mainFeatures":{"1":"5-inch Touch Screen","2":"2nd-Gen UI"}},"2":{"title":"70% More Extrusion Force  \u0026 Real-Time Error Detection.","desc":"The \u003ckeywords\u003ePMSM\u003c/keywords\u003e servo extruder delivers up to \u003ckeywords\u003e8.5 kg\u003c/keywords\u003e of maximum extrusion force—\u003ckeywords\u003e70% more\u003c/keywords\u003e than its predecessor—dramatically improves high-flowrate \u003ckeywords\u003eextrusion stability\u003c/keywords\u003e. Our proprietary servo architecture samples resistance and position at \u003ckeywords\u003e20 kHz\u003c/keywords\u003e, actively detecting filament grinding and clogs in real time.","mainFeatures":{"1":"PMSM Servo Architecture","2":"DynaSense Extruder"}},"3":{"title":"Print Smooth At Every Corner, Always.","desc":"The P2S uses a high-resolution, high-frequency \u003ckeywords\u003eeddy current sensor\u003c/keywords\u003e to calibrate flow dynamics. Intelligent algorithms actively adjust the \u003ckeywords\u003eflow rate\u003c/keywords\u003e based on these readings, provide precise, consistent extrusion across every layer and corner.","mainFeatures":{"1":"Active Flowrate Compensation","2":"Eddy Current Pressure Sensor"}},"4":{"sectionTitle":"Adaptive Airflow System","title":"Perfect Overhang No Matter the Filament or Temperature.","desc":"Unlike traditional cooling systems that recirculate hot air, the P2S's Adaptive Airflow System draws in \u003ckeywords\u003ecool air\u003c/keywords\u003e directly from \u003ckeywords\u003eoutside the chamber\u003c/keywords\u003e. This significantly improves \u003ckeywords\u003ecooling efficiency\u003c/keywords\u003e, letting you confidently print low-temperature filaments with the \u003ckeywords\u003edoor closed\u003c/keywords\u003e—without worrying about overhang quality or nozzle clogs.","mainFeatures":{"1":"Cold-Air Intake","2":"Cooling Mode"}},"5":{"sectionTitle":"Adaptive Airflow System","title":"50°C Chamber Ready For Engineering-Grade Filaments.","desc":"The P2S features a \u003ckeywords\u003eflap-controlled\u003c/keywords\u003e Adaptive Airflow System that efficiently \u003ckeywords\u003eseals heat\u003c/keywords\u003e within the chamber while actively filtering the internal air through a high-performance \u003ckeywords\u003ecarbon filter\u003c/keywords\u003e. This allows you to confidently print demanding engineering filaments prone to warping, all while maintaining clean, \u003ckeywords\u003esafe air quality\u003c/keywords\u003e in your workspace.","mainFeatures":{"1":"Heat Preservation","2":"Carbon Filter"}},"6":{"title":"Peace Of Mind, Everytime You Print.","desc":"The P2S introduces advanced \u003ckeywords\u003eAI computer vision\u003c/keywords\u003e that actively detects common \u003ckeywords\u003eprinting issues\u003c/keywords\u003e such as spaghetti, nozzle blobbing. It also checks your print start settings, ensuring a safe and accurate start to every print job.","mainFeatures":{"1":"AI Error Detection","2":"2 TOPS NPU"},"tabs":{"1":"AI Detection","2":"Start Check","3":"Spaghetti","4":"Nozzle Clumping","5":"Purge Chute Jam"}},"7":{"title":"30-Second Nozzle Swap.","desc":"The P2S features a \u003ckeywords\u003equick-swap hotend\u003c/keywords\u003e design with a simple \u003ckeywords\u003eone-clip\u003c/keywords\u003e mechanism that releases the entire nozzle and heatsink assembly—\u003ckeywords\u003eno wiring disconnection\u003c/keywords\u003e required. This drastically reduces nozzle change time and eliminates the risk of wiring errors.","mainFeatures":{"1":"Quick Swap Hotend","2":"1-Clip Design"}},"8":{"title":"No-Lag Liveview \u0026 High-Quality Timelapse.","desc":"Enhanced LED lighting dramatically improves the \u003ckeywords\u003eclarity\u003c/keywords\u003e of your liveview video and timelapses. Paired with a \u003ckeywords\u003ehigh-frame-rate camera \u0026 Dual-band Wi-Fi\u003c/keywords\u003e, you can comfortably monitor your printer remotely and capture \u003ckeywords\u003ebeautifully illuminated\u003c/keywords\u003e timelapses perfect for sharing on social media.","mainFeatures":{"1":"\"Stage\" Lighting","2":"1080P High-Rate Camera"}},"9":{"title":"Reliable for Fiber-Reinforced Material Printing.","desc":"P2S's extrusion system and nozzle are crafted from \u003ckeywords\u003ehardened steel\u003c/keywords\u003e, offering exceptional \u003ckeywords\u003edurability\u003c/keywords\u003e and \u003ckeywords\u003ewear resistance\u003c/keywords\u003e. Designed specifically for stable, long-term printing of \u003ckeywords\u003ehigh-performance fiber-reinforced\u003c/keywords\u003e materials.","mainFeatures":{"1":"Hardened Steel Nozzle","2":"Hardened Steel Extruder Gear"}},"10":{"sectionTitle":"AMS 2 Pro","title":"Multi-Color Printing \u0026 Filament Drying, All in One Box.","desc":"Experience our \u003ckeywords\u003emost reliable multi-color\u003c/keywords\u003e printing system yet. The AMS 2 Pro features an enhanced design for a better user experience and, crucially, introduces long-awaited \u003ckeywords\u003efilament drying\u003c/keywords\u003e. A pioneering \u003ckeywords\u003eactive venting system\u003c/keywords\u003e dries filament \u003ckeywords\u003e30% faster\u003c/keywords\u003e than sealed heating, maintaining low humidity for superior storage and print quality.","mainFeatures":{"1":"Auto Venting Filament Drying","2":"Multi-Color Printing"}},"11":{"title":"Over A Million High-Quality Models For You to Print.","cards":{"1":{"sectionTitle":"MakerWorld","title":"Over a Million Models at Your Fingertips","desc":"On \u003ckeywords\u003eMakerWorld\u003c/keywords\u003e, you'll find an endless supply of great models, all ready for your P2S. With \u003ckeywords\u003eseamless integration\u003c/keywords\u003e, you can skip the hassle of figuring out settings or slicing. The perfect print profiles for your specific printer and filaments are already in place. Simply \u003ckeywords\u003ehit print and get started!\u003c/keywords\u003e This kind of effortless printing is standard on MakerWorld, so you'll always have something new to try, and your printer can keep busy!"},"2":{"sectionTitle":"MakerLab","title":"AI Assisted 3D Modeling Tools, Bring Your Vision to Life","desc":"Transform your favorite artwork into a personalized lightbox, turn a beloved photo into a relief sculpture, or create one-of-a-kind PrintMon figurines from a simple prompt. With Bambu Lab MakerLab, you can \u003ckeywords\u003edesign and customize without any 3D modeling skills\u003c/keywords\u003e. Create a bookmark with your favorite characters, or an organizer tailored to your desk, with the perfect spot for sticky notes. Whatever you envision, you can create. "},"3":{"sectionTitle":"Maker's Supply","title":"Go-To Source for Parts that Bring 3D Prints to Life","desc":"\u003ckeywords\u003eMaker's Supply provides all the non-3D printed hardware you need for your projects, from motors and LEDs to bolts and magnets\u003c/keywords\u003e. Every pre-tested kit precisely matches the Bill of Materials (BOM) for your chosen MakerWorld project. Just print, assemble, and enjoy!"}}},"highlights":{"title":"Highlights","cards":{"1":{"title":"5-inch Refreshed Touchscreen"},"2":{"title":"Cold-Air Cooling"},"3":{"title":"Engineering Filaments Ready"},"4":{"title":"Quick-Swap Nozzle"},"5":{"title":"PMSM Servo Extruder"},"6":{"title":"Silky-Smooth Liveview"},"7":{"title":"Auto Flow Dynamics Calibration"},"8":{"title":"Active Venting Filament Drying"},"9":{"title":"AI Error Detection"}}},"gallery":{"title":"The Icon in Action","desc":"The P2S is the gateway to new lifestyles, giving you the effortless creative power to explore new possibilities. You want it, you get it!","models":{"1":{"name":"SVF1 Race Car"},"2":{"name":"3D Printed Slides"},"3":{"name":"Another Lamp"},"4":{"name":"Thirst Zapper Water Shooter"},"5":{"name":"Pietone Keyboard"}}},"10-1":{"title":"Electromagnetic Air Vent","desc":"Automated venting facilitates dehumidification during drying and airtight sealing for weeks of quality printing.","labels":{"dry":"Dry","moist":"Moist"}},"10-2":{"title":"Faster Multi-Color Printing","desc":"The PMSM feeding motor accelerates filament feeding by 60%, saving an average of 10 minutes for every 100 filament changes.","models":{"1":{"name":"Formula Race Car"},"2":{"name":"Steering Wheel"},"3":{"name":"P51 Mustang"}}}},"note":{"title":"Note","richText":"Big thanks to everyone who created these amazing projects: 911 Turbo by @Mr.Rod; SVF1 by @Ouky1991; Another Lamp by @lautaro.id; 3D printed slides by @CloudBerry; Pietone 3D Printing Keyboard by @Makesenstudio; Thirst Zapper water shooter by @Neebick; Machinist Infinity Cube by @Franken 3D; Minecraft TNT by 星云丿长歌; Formula race car by @SAMPAN棱界复刻; Steering Wheel by @Marconooren; P51 Mustang by @Planes01; House scene by @BambuLab; AM Vantage by @Cormango; A1 Robot by @洞洞脑子研造社; Plant Pot Stratum by @Hplnvent.\nAll product data for the P2S is based on Bambu Lab’s internal testing. Actual results may vary due to individual product differences, user habits, and environmental conditions. Please refer to actual usage for reference.\nCreator projects are provided for illustrative purposes only. Bambu Lab does not endorse, and disclaims any representations or warranties regarding creator projects, including, without limitation, the safety, marketability, or usability of any 3D printed works based on such projects. See our Terms of Service for more information.\nFilament grinding detection on the DynaSense Extruder may vary depending on filament type.\nPush notifications require use of Bambu Handy and cloud connectivity.\nThe claimed performance of P2S is based on testing results under the recommended operation environment on the spec sheet.","store":"\u003ckeywords\u003eNote:\u003c/keywords\u003e The standalone \u003ckeywords\u003eP2S\u003c/keywords\u003e (without AMS) does \u003ckeywords\u003enot include a filament buffer.\u003c/keywords\u003e\nPlease be aware that the absence of the filament buffer will affect \u003ckeywords\u003ethe accuracy of filament tangle detection feature.\u003c/keywords\u003e\nIf you require a filament buffer, you can \u003ckeywords\u003eadd it to your shopping cart below.\u003c/keywords\u003e"},"showcase":{"design":{"title":"Design of P2S","desc":"Bambu Lab's \u003ckeywords\u003eP2S\u003c/keywords\u003e embodies a \"\u003ckeywords\u003eFunction Over Form\u003c/keywords\u003e\" philosophy. Its minimalist design conceals meticulous engineering, with every detail fine-tuned to deliver a \u003ckeywords\u003equality\u003c/keywords\u003e that is truly distinct. This isn't just a printer; it's a testament to how \u003ckeywords\u003epurposeful design\u003c/keywords\u003e can elevate the entire creative experience.","download":"Download Render"},"model":{"title":"P2S Quality Prints","desc":"The P2S embodies Bambu Lab's \u003ckeywords\u003ehigh standard of print quality\u003c/keywords\u003e. We have meticulously fine-tuned its performance across all print types, ensuring \u003ckeywords\u003esuperior detail preservation, sharp edges, and flawless surfaces\u003c/keywords\u003e to meet our customers' high expectations.","download":"Download","models":{"1":{"nameAndAuthor":"AM Vantage by @Cormango"},"2":{"nameAndAuthor":"BambuBot A1 by @洞洞脑子研造社"},"3":{"nameAndAuthor":"House Scene by  @BambuLab"}}}}},"compare":{"printer":{"title":"Compare Bambu Lab printers","showDifference":"Differences","guideTitle":"Which 3D printer is right for me?","guideDesc":"Take a quick quiz for recommendations tailored for you.","helpMeChoose":"Help me choose","attributes":{"body":"Body","buildVolume":"Build Volume","enclosed":"Enclosed","dualNozzleAndToolChanger":"Dual-Nozzle \u0026 Tool Changer","materials":"Materials","laserSafetyWindow":"Laser Safety Window","modularAddOns":"Modular Add-ons","laser":"10W/40W Laser","digitalCutting":"Digital Cutting","penDrawing":"Pen Drawing","toolhead":"Toolhead","extruderGears":"Extruder Gears","nozzle":"Nozzle","maxNozzleTemperature":"Max Nozzle Temperature","heatbed":"Heatbed","maxBuildPlateTemperature":"Max Build Plate Temperature","physicalDimensions":"Physical Dimensions","supportedFilament":"Supported Filament","filamentPla":"PLA, PETG, TPU, PVA","filamentFiber":"Carbon/Glass Fiber Reinforced PLA/PETG","filamentAbs":"ABS, ASA, PA, PAHT, PC, PET, PPA, Carbon/Glass Fiber Reinforced Polymer","filamentPps":"PPS-CF, PPS-GF","filamentDrying":"Filament Drying","cooling":"Cooling","fans":"Fans","airFilter":"Air Filter","airAssistPump":"Air Assist Pump","sensors":"Sensors","calibrationByVisionEncoder":"Calibration by Vision Encoder","filamentRunOutSensor":"Filament Run Out Sensor","filamentOdometry":"Filament Odometry","powerLossRecover":"Power Loss Recover","filamentTangleSensor":"Filament Tangle Sensor","bambuMicroLidar":"Bambu Micro Lidar","camera":"Camera","electronics":"Electronics","display":"Display","connectivity":"Connectivity","storage":"Storage","controlInterface":"Control Interface","ledLighting":"LED Lighting","neuralNetworkProcessingUnit":"Neural-Network Processing Unit","usbOutputPower":"USB Output Power","softwareUpdateSupport":"Software Update Support","bugAndFeatureUpdatesUntil":"Bug \u0026 Feature Updates Until","securityPatchUpdatesUntil":"Security Patch Updates Until","softwareUpdateDesc":"\u003c0\u003eWe would also like to inform our customers that after the period of guaranteed Software Update Support, the Bambu Lab products will continue to work for their entire lifetime, with the same feature availability. Please check the \u003c/0\u003e\u003c1\u003eterms of use\u003c/1\u003e\u003c2\u003e for more detail.\u003c/2\u003e"}},"title":"Compare Bambu Lab printers","x1c":"Bambu Lab X1C","x1":"Bambu Lab X1","p1p":"Bambu Lab P1P","x1cButton":"Buy now","x1Button":"Buy now","p1pButton":"Coming soon","body":"Body","toolHead":"Toolhead","hotBed":"Heatbed","cooling":"Cooling","supportedFilament":"Supported Filament","sensors":"Sensors","physicalDimensions":"Physical Dimensions","electronics":"Electronics","additionalInformation":"Software Update Support","softwareUpdateDesc":"\u003c0\u003eWe would also like to inform our customers that after the period of guaranteed Software Update Support, the Bambu Lab products will continue to work for their entire lifetime, with the same feature availability. Please check the \u003c/0\u003e\u003c1\u003eterms of use\u003c/1\u003e\u003c2\u003e for more detail.\u003c/2\u003e"},"dealer":{"title":"Where to buy","desc":"Find an authorized dealer in your area for Bambu Lab 3D printers and accessories, after-sales service \u0026 technical support. Our official partners are ready to help you.","selectPlaceholder":"Select your country / region","allCountry":"All","contactUsText":"\u003c0\u003eIf you're a reseller wishing to collaborate with us \nand help build an amazing customer experience in your region, please \u003c/0\u003e\u003c1\u003econtact us\u003c/1\u003e."},"warming":{"email":{"placeholder":"Enter your email","button":"Stay tuned!","subscribe":"Subscribe","privacyPolicy":"\u003c0\u003eI consent to the \u003c/0\u003e\u003c1\u003eTerms of use\u003c/1\u003e\u003c2\u003e and \u003c/2\u003e\u003c3\u003ePrivacy Notice\u003c/3\u003e\u003c4\u003e.\u003c/4\u003e","validEmail":"Please enter a valid email","needAgreePrivacyPolicy":"You need agree to Privacy Notice","success":"Thanks for Subscribing"},"h2c":{"title":"Bambu Lab H2C","desc":"Uncompromising Multi-Material.","time":"November 18th, 2025, at 3:00 PM CET"},"h2d":{"title":"Rethink \nPersonal Manufacturing","desc":"March. 25th 2025 3PM CET","email":{"placeholder":"Enter your email","button":"Stay tuned!","validEmail":"Please enter a valid email","success":"Thanks for Subscribing"},"dialog":{"name":"Bambu Lab H2D","title":"Rethink Personal Manufacturing","time":"March. 25th"}},"h2s":{"metaTitle":"Up Scale Your 3D Printing Experience","metaDesc":"Big Ideas. Big Solutions. Big Printer. See you on 8.26.","title":"In a BIG Way","time":"August 26, 2025 · 3 PM CEST"},"p2s":{"metaTitle":"Bambu Lab P2S 3D Printer: The Classic Remains and Upgrades","metaDesc":"Fast, Reliable, Timeless, See You on October 14th.","title":"Refresh","time":"October 14th, 2025 · 9 AM EDT"},"new":{"metaTitle":"Xcellence made simple.","metaDesc":"See you on April 14th.","metaDescOther":"See you on April 15th.","title":"Xcellence made simple.","time":"April 14, 2026, 4 PM CEST","timeOther":"April 15, 2026, 4 AM CEST"},"a2l":{"metaTitle":"Bambu Lab A2L: Creative Playground. Extra Large.","metaDesc":"Bring Your Bigger Ideas to Life. See you on June 1st.","metaDescOther":"Bring Your Bigger Ideas to Life. See you on June 2nd.","title":"Creative Playground. Extra Large.","time":"June 1, 2026 · 4 PM CEST","timeOther":"June 2, 2026 · 4 AM CEST"},"r1":{"title":"Bambu Lab R1","desc":"Big job. Light work."}},"wheretobuy":{"title":"Where to buy","desc":"Discover the best ways to purchase our products, whether online or at retail locations near you.","searchResellers":"Search for Resellers in your area","onlineStore":{"title":"Online Shop","desc":"Browse and purchase our full range of products anytime, anywhere at our / partner online shop.","buyButton":"Buy now"},"offlineStore":{"title":"Offline Retail Store","desc":"Visit our / partner offline stores to explore our products in person and receive personalized service."},"authorizedStore":{"title":"Authorized 3D printer Resellers","desc":"Shop with our authorized resellers for local availability, expert guidance, and reliable after-sales support."}},"dealerMap":{"title":"Authorized Resellers","desc":"Find an authorized dealer in your area for Bambu Lab 3D printers and accessories, after-sales service \u0026 technical support. Our official partners are ready to help you.","selectLabel":"Authorized 3D printer Resellers","selectPlaceholder":"Select a country/region","selectRegionPlaceholder":"Select a region","selectCountryPlaceholder":"Select a country","noFoundReseller":"*No resellers found in your region?","countInGlobal":"{{count}} Resellers found in Global","countInCountry":"{{count}} Resellers found in The {{country}}","all":"All","emptyText":"No resellers are available in this Category"},"b2b":{"privacyPolicy":"\u003c0\u003eI agree to receive communications from Bambu Lab, and I understan