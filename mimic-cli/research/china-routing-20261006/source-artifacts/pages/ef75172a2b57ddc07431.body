<script>
    (function () {
        function getSearchTarget(value) {
            var val = (value || '').trim();
            if (!val) {
                return '';
            }
            return './search_prod?search=' + encodeURIComponent(val);
        }

        function trimTrailingSlash(pathname) {
            if (!pathname) {
                return '';
            }
            return pathname.length > 1 ? pathname.replace(/\/+$/, '') : pathname;
        }

        function getPathnameFromHref(href) {
            if (!href) {
                return '';
            }
            try {
                return trimTrailingSlash(new URL(href, window.location.origin).pathname || '');
            } catch (err) {
                var normalized = href.split('#')[0].split('?')[0];
                if (!normalized) {
                    return '';
                }
                if (normalized.indexOf('http://') === 0 || normalized.indexOf('https://') === 0) {
                    return '';
                }
                return trimTrailingSlash(normalized.charAt(0) === '/' ? normalized : '/' + normalized);
            }
        }

        function isPathMatch(currentPath, targetPath) {
            if (!currentPath || !targetPath) {
                return false;
            }
            if (targetPath === '/') {
                return currentPath === '/';
            }
            return currentPath === targetPath || currentPath.endsWith(targetPath);
        }

        function markActiveNavItem(anchor) {
            if (!anchor) {
                return;
            }
            anchor.classList.add('is-active');
            anchor.setAttribute('aria-current', 'page');
            var desktopNavItem = anchor.closest('.nav-item');
            if (desktopNavItem) {
                desktopNavItem.classList.add('is-active');
            }
            var mobileAccordion = anchor.closest('.mobile-accordion');
            if (mobileAccordion) {
                mobileAccordion.classList.add('is-active');
            }
        }

        function syncNavActiveState() {
            var currentPath = trimTrailingSlash(window.location.pathname || '');
            if (!currentPath) {
                return;
            }
            // 首页不做任何菜单高亮，避免 index 页面误命中其它导航项。
            if (currentPath === '/index' || currentPath === '/index.html' || currentPath === '/') {
                document.querySelectorAll('.aqara-nav-header a[data-nav-href]').forEach(function (anchor) {
                    anchor.classList.remove('is-active');
                    anchor.removeAttribute('aria-current');
                });
                document.querySelectorAll('.aqara-nav-header .nav-item, .aqara-nav-header .mobile-accordion').forEach(function (item) {
                    item.classList.remove('is-active');
                });
                return;
            }

            document.querySelectorAll('.aqara-nav-header a[data-nav-href]').forEach(function (anchor) {
                anchor.classList.remove('is-active');
                anchor.removeAttribute('aria-current');
            });
            document.querySelectorAll('.aqara-nav-header .nav-item, .aqara-nav-header .mobile-accordion').forEach(function (item) {
                item.classList.remove('is-active');
            });

            document.querySelectorAll('.aqara-nav-header a[data-nav-href]').forEach(function (anchor) {
                var targetPath = getPathnameFromHref(anchor.getAttribute('data-nav-href') || anchor.getAttribute('href'));
                if (!targetPath) {
                    return;
                }
                if (isPathMatch(currentPath, targetPath)) {
                    markActiveNavItem(anchor);
                }
            });
        }

        function bindNavTracking() {
            document.querySelectorAll('.aqara-nav-header a[data-nav-id]').forEach(function (anchor) {
                anchor.addEventListener('click', function () {
                    if (!window.navTopClick) {
                        return;
                    }
                    var navId = anchor.getAttribute('data-nav-id') || '';
                    var navHref = anchor.getAttribute('data-nav-href') || anchor.getAttribute('href') || '';
                    var navTitle = anchor.getAttribute('data-nav-title') || '';
                    setTimeout(function () {
                        window.navTopClick(navId, navHref, navTitle);
                    }, 0);
                });
            });
        }

        function closeAllPanels() {
            document.querySelectorAll('.aqara-nav-header .search-overlay, .aqara-nav-header .js-lang-dropdown, .aqara-nav-header .js-mobile-menu-panel, .aqara-nav-header .js-mobile-search-panel, .aqara-nav-header .js-mobile-lang-panel')
                .forEach(function (panel) {
                    panel.classList.remove('is-open');
                });
            var desktopSearchBtn = document.querySelector('.aqara-nav-header .js-search-open');
            if (desktopSearchBtn) {
                desktopSearchBtn.classList.remove('is-open');
                desktopSearchBtn.setAttribute('aria-expanded', 'false');
            }
            document.querySelectorAll('.aqara-nav-header .js-mobile-menu-open, .aqara-nav-header .js-mobile-search-open, .aqara-nav-header .js-mobile-lang-open').forEach(function (btn) {
                btn.classList.remove('is-open');
                btn.setAttribute('aria-expanded', 'false');
            });
            var backdrop = document.querySelector('.aqara-nav-header .js-nav-backdrop');
            if (backdrop) {
                backdrop.classList.remove('is-open');
            }
            document.body.classList.remove('nav-overlay-open');
        }

        function openPanel(selector, useBackdrop) {
            closeAllPanels();
            var panel = document.querySelector(selector);
            if (panel) {
                panel.classList.add('is-open');
            }
            if (selector === '.js-search-overlay') {
                var desktopSearchBtn = document.querySelector('.aqara-nav-header .js-search-open');
                if (desktopSearchBtn) {
                    desktopSearchBtn.classList.add('is-open');
                    desktopSearchBtn.setAttribute('aria-expanded', 'true');
                }
            } else if (selector === '.js-mobile-menu-panel') {
                var mobileMenuOpen = document.querySelector('.aqara-nav-header .js-mobile-menu-open');
                if (mobileMenuOpen) {
                    mobileMenuOpen.classList.add('is-open');
                    mobileMenuOpen.setAttribute('aria-expanded', 'true');
                }
            } else if (selector === '.js-mobile-search-panel') {
                var mobileSearchOpen = document.querySelector('.aqara-nav-header .js-mobile-search-open');
                if (mobileSearchOpen) {
                    mobileSearchOpen.classList.add('is-open');
                    mobileSearchOpen.setAttribute('aria-expanded', 'true');
                }
            } else if (selector === '.js-mobile-lang-panel') {
                var mobileLangOpen = document.querySelector('.aqara-nav-header .js-mobile-lang-open');
                if (mobileLangOpen) {
                    mobileLangOpen.classList.add('is-open');
                    mobileLangOpen.setAttribute('aria-expanded', 'true');
                }
            }
            if (useBackdrop !== false) {
                var backdrop = document.querySelector('.aqara-nav-header .js-nav-backdrop');
                if (backdrop) {
                    backdrop.classList.add('is-open');
                }
            }
            document.body.classList.add('nav-overlay-open');
            refreshSearchBoxState();
        }

        function refreshSearchBoxState() {
            var searchBox = document.querySelector('.aqara-nav-header .js-search-overlay .search-box');
            var input = document.querySelector('#seek1');
            if (!searchBox || !input) {
                return;
            }
            if (input.value && input.value.trim()) {
                searchBox.classList.add('has-value');
            } else {
                searchBox.classList.remove('has-value');
            }
        }

        function bindSearch(inputSelector) {
            var input = document.querySelector(inputSelector);
            if (!input) {
                return;
            }
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.keyCode === 13) {
                    var target = getSearchTarget(input.value);
                    if (target) {
                        window.location.href = target;
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            bindSearch('#seek1');
            bindSearch('#seek2');
            bindNavTracking();
            refreshSearchBoxState();
            syncNavActiveState();

            var desktopSearchInput = document.querySelector('#seek1');
            if (desktopSearchInput) {
                desktopSearchInput.addEventListener('input', refreshSearchBoxState);
            }

            var searchClearBtn = document.querySelector('.js-search-clear');
            if (searchClearBtn) {
                searchClearBtn.addEventListener('click', function () {
                    var input = document.querySelector('#seek1');
                    if (!input) {
                        return;
                    }
                    input.value = '';
                    refreshSearchBoxState();
                    input.focus();
                });
            }

            var desktopSearchBtn = document.querySelector('.js-search-open');
            if (desktopSearchBtn) {
                desktopSearchBtn.addEventListener('click', function () {
                    var overlay = document.querySelector('.js-search-overlay');
                    if (overlay && overlay.classList.contains('is-open')) {
                        closeAllPanels();
                        return;
                    }
                    openPanel('.js-search-overlay', false);
                    var input = document.querySelector('#seek1');
                    if (input) {
                        setTimeout(function () {
                            input.focus();
                        }, 50);
                    }
                });
            }

            var langSelector = document.querySelector('.aqara-nav-header .lang-selector');
            var langDropdown = document.querySelector('.aqara-nav-header .js-lang-dropdown');
            if (langSelector && langDropdown) {
                langSelector.addEventListener('mouseenter', function () {
                    langDropdown.classList.add('is-open');
                });
                langSelector.addEventListener('mouseleave', function () {
                    langDropdown.classList.remove('is-open');
                });
            }

            var mobileMenuOpen = document.querySelector('.js-mobile-menu-open');
            if (mobileMenuOpen) {
                mobileMenuOpen.addEventListener('click', function () {
                    var panel = document.querySelector('.js-mobile-menu-panel');
                    if (panel && panel.classList.contains('is-open')) {
                        closeAllPanels();
                        return;
                    }
                    openPanel('.js-mobile-menu-panel', true);
                });
            }

            var mobileSearchOpen = document.querySelector('.js-mobile-search-open');
            if (mobileSearchOpen) {
                mobileSearchOpen.addEventListener('click', function () {
                    var panel = document.querySelector('.js-mobile-search-panel');
                    if (panel && panel.classList.contains('is-open')) {
                        closeAllPanels();
                        return;
                    }
                    openPanel('.js-mobile-search-panel', true);
                    var input = document.querySelector('#seek2');
                    if (input) {
                        setTimeout(function () {
                            input.focus();
                        }, 50);
                    }
                });
            }

            var mobileLangOpen = document.querySelector('.js-mobile-lang-open');
            if (mobileLangOpen) {
                mobileLangOpen.addEventListener('click', function () {
                    var panel = document.querySelector('.js-mobile-lang-panel');
                    if (panel && panel.classList.contains('is-open')) {
                        closeAllPanels();
                        return;
                    }
                    openPanel('.js-mobile-lang-panel', true);
                });
            }

            document.querySelectorAll('.js-mobile-close').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    closeAllPanels();
                });
            });

            var navBackdrop = document.querySelector('.js-nav-backdrop');
            if (navBackdrop) {
                navBackdrop.addEventListener('click', closeAllPanels);
            }

            document.querySelectorAll('.mobile-accordion-toggle').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var accordion = btn.closest('.mobile-accordion');
                    if (!accordion) {
                        return;
                    }
                    accordion.classList.toggle('open');
                });
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeAllPanels();
                }
            });

            document.addEventListener('click', function (e) {
                var inside = e.target.closest('.aqara-nav-header');
                if (!inside) {
                    return;
                }
                if (e.target.closest('.search-overlay') || e.target.closest('.mobile-panel') || e.target.closest('.nav-backdrop')) {
                    return;
                }
                var openPanelEl = inside.querySelector('.search-overlay.is-open, .js-lang-dropdown.is-open, .js-mobile-menu-panel.is-open, .js-mobile-search-panel.is-open, .js-mobile-lang-panel.is-open');
                if (!openPanelEl) {
                    return;
                }
                if (
                    e.target.closest('.js-search-open') ||
                    e.target.closest('.js-lang-open') ||
                    e.target.closest('.js-mobile-menu-open') ||
                    e.target.closest('.js-mobile-search-open') ||
                    e.target.closest('.js-mobile-lang-open')
                ) {
                    return;
                }
                if (!e.target.closest('.nav-item') && !e.target.closest('.lang-selector')) {
                    closeAllPanels();
                }
            });
        });
    })();
</script>
<!--header end-->

