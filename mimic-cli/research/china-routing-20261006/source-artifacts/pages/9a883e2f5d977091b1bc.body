        color: #b71c1c;
        border: 1px solid #f5c6cb;
        border-radius: 6px;
        padding: 7px 11px;
        font-size: 11.5px;
        margin-top: 10px;
    }

    /* Stack label + input + button on small screens so none get cramped.
