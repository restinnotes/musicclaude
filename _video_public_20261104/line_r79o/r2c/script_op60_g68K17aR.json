 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近这个人，心里一下热起来；这感觉像有句话想了很久，到了嘴边却先沉默。",
       "keys": [
        "那么想靠近这个人",
        "心里一下热起来"
       ],
       "from": [
        "S01-1",
        "S01-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "怕对方觉得负担太重",
       "keys": [],
       "from": [
        "S01-2"
       ],
       "bead": "S01-2"
      },
      {
       "text": "只敢露出一点点喜欢",
       "keys": [],
       "from": [
        "S01-2"
       ],
       "bead": "S01-2"
      },
      {
       "text": "这么一点亲近就让他觉得甜",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      },
      {
       "text": "还拿不准，下次能不能更坦白些",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      },
      {
       "text": "关系就会改变",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "对方没有因为他露出在意就退开，仍愿意跟他亲近，他才渐渐放松；两个人挨得很近，像耳语时肩膀相贴，连呼吸都贴在一起。",
       "keys": [
        "仍愿意跟他亲近",
        "肩膀相贴"
       ],
       "from": [
        "S02-1",
        "S02-B1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他也想顺势靠得更近，有一阵喜欢得几乎藏不住；可怕太急弄坏眼下的自在，还是收住了。两个人待得这么好，他却想到这样的时刻总会过去，还没分开就先舍不得。",
       "keys": [
        "喜欢得几乎藏不住",
        "还没分开就先舍不得"
       ],
       "from": [
        "S02-2",
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "夏末水面潮湿、温热的微风",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "水一直在流，时间也一直在走",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像一根温柔的刺",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "连呼吸都跟着改变",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不去琢磨两个人往后会怎样，只想舒服地待在这份亲近里；这份安静像说过一句重要的话以后，还停留在那句话里面。",
       "keys": [
        "不去琢磨两个人往后会怎样",
        "舒服地待在这份亲近里"
       ],
       "from": [
        "S03-1",
        "S03-B1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想说有多喜欢，也想问对方是否一样；没想好怎么开口，念头就淡了。",
       "keys": [
        "想说有多喜欢",
        "是否一样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急于表达的念头",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像被水下暗流拖住",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "风吹碎的倒影",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他满心欢喜；想起上回明明想告诉对方，却没有开口。这一回，他几乎想把藏着的话全说出来，盼着对方也喜欢他不再小心收着的样子。",
       "keys": [
        "满心欢喜",
        "把藏着的话全说出来"
       ],
       "from": [
        "S04-1",
        "S04-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他甚至盼着说出来能把眼下的好留久一点；可又怕说得太多让对方为难，连原有的自在也弄丢，最后还是留了些话没说；眼下的美好仿佛每一秒都在倒数。",
       "keys": [
        "把眼下的好留久一点",
        "最后还是留了些话没说"
       ],
       "from": [
        "S04-3",
        "S04-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "本来一句话已经够了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "忍不住再说一遍",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "夕阳在水面切出的最后一道金光",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "喉咙口颤抖、哽咽",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "原本只是轻轻握着另一个人的手",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "越用力，水面的颠簸就越剧烈",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "前几次想说又收住，对方却一直亲近；这回他不知不觉没藏住喜欢，对方看出来了。",
       "keys": [
        "不知不觉没藏住喜欢",
        "对方看出来了"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里空落落的，像忽然失去脚下支撑",
       "keys": [],
       "from": [
        "S05-2"
       ],
       "bead": "S05-2"
      },
      {
       "text": "连怎么跟对方待着都拿不准",
       "keys": [],
       "from": [
        "S05-2"
       ],
       "bead": "S05-2"
      },
      {
       "text": "怕对方嫌自己太黏",
       "keys": [],
       "from": [
        "S05-3"
       ],
       "bead": "S05-3"
      },
      {
       "text": "熟悉的亲近像隔了一层",
       "keys": [],
       "from": [
        "S05-3"
       ],
       "bead": "S05-3"
      },
      {
       "text": "这份幸福是真的吗",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    }
   ]
