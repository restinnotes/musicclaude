{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"声音轻了、远了，悬在半空\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"轻了、远了，悬在半空\"\n        },\n        {\n          \"quote\": \"伸出颤抖的手去摸，摸到的却只有虚空\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他已经离开那段熟悉的生活\",\n          \"point\": \"不用再一次次委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初还觉得\"\n        },\n        {\n          \"text\": \"可这份笃定没撑多久\",\n          \"point\": \"说不清到底舍不得什么\",\n          \"where\": \"后\",\n          \"waste\": \"心里\",\n          \"keep\": \"没撑多久；一时说不清\"\n        },\n        {\n          \"text\": \"偶尔想起从前熟悉的日子\",\n          \"point\": \"不知道以后靠什么让自己安下心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还是想往前过，却不知道\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"模糊地\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"第三次，连重复本身都露出在意\"\n        },\n        {\n          \"quote\": \"不是轻松恢复自信，而是负隅顽抗。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是恢复自信，是负隅顽抗\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他舍不得从前那些自在的时候\",\n          \"point\": \"心里就有些慌\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"光是想到以后不能再像那样过日子\"\n        },\n        {\n          \"text\": \"那份舍不得一上来\",\n          \"point\": \"连当初为什么要走都忘了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕一心软\"\n        },\n        {\n          \"text\": \"可他还是不甘心\",\n          \"point\": \"把以前的好日子也一起丢掉吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"为了不再受那些气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"温柔得让人心颤，也刺痛得让人绝望：越怀念，越能感觉它与眼前处境的距离。\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"多个人在耳边低声絮语，彼此缠绕，找不到出口\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"彼此缠绕\"\n        },\n        {\n          \"quote\": \"我刚才是真的相信那些话，还是只是在努力让自己相信？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还是只是在努力让自己相信\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他心里还憋着一股气\",\n          \"point\": \"有人把他当作自己人，竟又高兴了一小会儿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还憋着一股气，可；一小会儿\"\n        },\n        {\n          \"text\": \"可那点高兴还没退\",\n          \"point\": \"离开以后就一定会更好过吗\",\n          \"where\": \"后\",\n          \"waste\": \"他心里\",\n          \"keep\": \"那点高兴还没退；从前那样的日子过不成了\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"这份坚定也可能是他努力想成为的样子，而不再是一个毫无疑问的事实。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还只是努力想成为的样子\"\n        },\n        {\n          \"quote\": \"越是用力，反而越不安稳\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"表面上动作越来越多，实际上并没有真正抵达哪里；不停地往前赶，只是为了避免停下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不停往前，只是为了避免停下来\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起那些亲近的时候\",\n          \"point\": \"真盼着一切还能照从前那样继续\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"有一阵\"\n        },\n        {\n          \"text\": \"可这么盼着\",\n          \"point\": \"要是没走，如今会怎样\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可这么盼着；却怎么也想不出\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"只剩一个声音自己说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"只剩一个声音自己说话\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍不服气\",\n          \"point\": \"连过去开心的事都不敢多想\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"仍不服气；可连过去开心的事都不敢多想\"\n        },\n        {\n          \"text\": \"跟自己争得没了力气\",\n          \"point\": \"那股不服气也渐渐淡了\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"跟自己争得没了力气；如今已不在那些人身边\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"这份安宁并不意味着现实已经变好，也不是一个能永远停留的地方。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"现实并没有因此变好\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"愿望真切，却未许诺回应\"\n        },\n        {\n          \"quote\": \"已经远去的家园在梦里显现——虽然无法回到那里，却远远地看见了它。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"看见了，却无法回去\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"心里那阵难受慢慢缓下来\",\n          \"point\": \"没急着拿受过的气压住这份想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这回没急着\"\n        },\n        {\n          \"text\": \"离开以后\",\n          \"point\": \"从前有人在身边能让自己轻松多少\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"常常只能自己挺过去；这才知道\"\n        },\n        {\n          \"text\": \"他很想再过上那种\",\n          \"point\": \"不用多说也知道彼此亲近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"又怕以后再也没有了\"\n        },\n        {\n          \"text\": \"不过，那样的日子\",\n          \"point\": \"光是这么想着，他心里也暖和了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"毕竟真真切切过过；光是这么想着\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"这种突兀的换向并不等于情绪好转；新出现的舞步可以很鲜明，内心却未必因此安定下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"换向不等于好转\"\n        },\n        {\n          \"quote\": \"事情表面上仿佛已经过去，身体和情绪却还没有完全相信一切已经结束。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这样的亲切感未必安慰人；恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"刚有点安心\",\n          \"point\": \"他真的撑得住吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"刚有点安心；要还是只能一个人顶着\"\n        },\n        {\n          \"text\": \"当初走时他只想着别再受那些气\",\n          \"point\": \"早知道这样，自己还会走吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没料到会这么孤单\"\n        },\n        {\n          \"text\": \"他想找回从前那份亲近\",\n          \"point\": \"那股决心也找不着了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又不甘心回去再受那些气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"像一个人已经准备离开，却在最后一刻回过头，再看一眼刚才待过的地方；那一眼里有温柔，也有不舍。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"将离开时回头再看一眼\"\n        },\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只是瞬间的喘息，并不等于整个人重新安顿下来。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不等于重新安顿\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他暂时把回不回去的事放到一边\",\n          \"point\": \"心里又暖和了一会儿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"暂时把回不回去的事放到一边\"\n        },\n        {\n          \"text\": \"可那点暖意很快就淡了\",\n          \"point\": \"回忆没法陪着他\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"很快就淡了；真遇上难事\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"开头沉重的引子从中阴冷地闪现回来，却不再像最初那样郑重召唤。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"开头引子阴冷地闪回\"\n        },\n        {\n 