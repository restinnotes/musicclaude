    line-height: 1.55;
  }
  .rd-sidebar-sample__field {
    margin-bottom: 12px;
  }
  .rd-sidebar-sample__label {
    display: block;
    margin: 0 0 7px;
    color: #36536d;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.25;
    text-transform: uppercase;
  }
  .rd-sidebar-sample__input {
    width: 100%;
    max-width: 100%;
    height: 38px;
    padding: 0 12px;
    border: 1px solid #c8d7e7;
    border-radius: 8px;
    background: #f8fbfd;
    color: #071d2f;
    font-size: 13px;
    outline: 0;
    box-sizing: border-box;
    transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
  }
  .rd-sidebar-sample__input:focus {
    border-color: #0868ad;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(8, 114, 186, 0.12);
  }
  .rd-sidebar-sample__submit {
    width: 100%;
    min-height: 38px;
    margin-top: 6px;
    border: 1px solid #ff6b1a;
    border-radius: 7px;
    background: #ff6b1a;
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, box-shadow .18s ease, transform .18s ease;
  }
  .rd-sidebar-sample__submit:hover {
    background: #e95b0c;
    border-color: #e95b0c;
    box-shadow: 0 10px 22px rgba(255, 107, 26, 0.22);
