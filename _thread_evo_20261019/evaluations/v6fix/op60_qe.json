      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S05",
    "bars": "35–39",
    "relation": "正在面对",
    "items": [
     {
      "id": "S05-1",
      "text": "他还是试着照那个念头做了，原本想表达的亲近，被他有意压回去一些。",
      "key": "他还是试着照那个",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-1"
      ]
     },
     {
      "id": "S05-2",
      "text": "少了那份急切，他一时似乎松了些，可紧接着又觉得空落落的；对方明明还在眼前，他却不能像刚才那样自在地亲近了。",
      "key": "少了那份急切，他",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S04-1",
      "to": "S05-1",
      "rel": "引用"
     },
     {
      "from": "S02-1",
      "to": "S05-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S06",
    "bars": "40–50",
    "relation": "正在面对",
    "items": [
     {
      "id": "S06-1",
      "text": "他继续少表达一些，心里却时而安静下来，时而又被想靠近的念头牵住。",
      "key": "他继续少表达一些",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1",
       "S05-2"
      ]
     },
     {
      "id": "S06-2",
      "text": "他开始怀念先前不用反复克制的自在；此刻仍有亲近可享，自己却因为不能尽情回应那份亲近而感到一点孤单。",
      "key": "他开始怀念先前不",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S05-1",
