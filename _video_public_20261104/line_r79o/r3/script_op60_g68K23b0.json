    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "对方依然亲近，他想主动些，大方回应。",
       "keys": [
        "依然亲近",
        "大方回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌句越唱越开，直接又舒展",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "身体恢复弹性，带着一点玩心",
