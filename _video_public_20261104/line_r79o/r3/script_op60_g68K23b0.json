       "bead": "S09-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他不敢再想远处；眼下仍亲近，也许对方喜欢他在身边。",
       "keys": [
        "不敢再想远处",
        "也许对方喜欢他在身边"
       ],
       "from": [
        "S09-2",
        "S09-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚才那是真的吗？接下来怎么办",
       "keys": [],
       "from": [
        "S09-B3"
       ],
       "bead": "S09-B3"
      },
      {
       "text": "像激动过后抬头看夜空，美好比愿望更大",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      }
