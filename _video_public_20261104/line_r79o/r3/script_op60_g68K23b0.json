  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方总愿意陪他；他开始觉得，对方也需要他。",
       "keys": [
        "总愿意陪他",
        "对方也需要他"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "气味、身体感觉、幻想、遗憾和快感混在一起",
