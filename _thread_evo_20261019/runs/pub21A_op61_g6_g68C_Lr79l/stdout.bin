{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"胸口有些发紧，视线还模糊着；伸出颤抖的手去摸，摸到的却只有虚空。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没找到语言\"\n        },\n        {\n          \"quote\": \"身体先于意识，隐约记起了该如何迈步。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"先于意识\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开熟悉的生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"总算不用再\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"不知如何安顿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可心里很快空了\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"主旋律更像一首从远处传来的旧歌，你依稀记得它，却只能模糊地哼出几句。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"第一次还有几分相信，第二次开始努力让自己相信\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"说到第三次\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到以后再没有那样的日子\",\n          \"point\": \"心慌\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"以后再没有那样的日子\"\n        },\n        {\n          \"text\": \"他提醒自己受过的气\",\n          \"point\": \"忘了当初为什么离开\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕一心软\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"温柔得让人心颤，也刺痛得让人绝望：越怀念，越能感觉它与眼前处境的距离。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"绝望\"\n        },\n        {\n          \"quote\": \"那一刻的轻松可以是真的，并非假装；只是它没有替心里的事找到答案。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"我刚才是真的相信那些话，还是只是在努力让自己相信？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"刚才\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起有人把他当自己人\",\n          \"point\": \"有人把他当自己人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"高兴了一小会儿\"\n        },\n        {\n          \"text\": \"可那样的日子回不去\",\n          \"point\": \"离开后也未必更好过\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可那样的日子回不去\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"不是记忆变坏了，而是它太好了——过去无法原样回来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是变坏，是太好\"\n        },\n        {\n          \"quote\": \"外在的步伐还在向前，里面却有了更多回声。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不停地往前赶，只是为了避免停下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起从前的亲近\",\n          \"point\": \"还能那样相处\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"真盼着\"\n        },\n        {\n          \"text\": \"可越想念从前\",\n          \"point\": \"怀疑当初那一步\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"越想念从前，他越会想起受过的委屈\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"可正因已经过去，眷恋里也带着失落。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"因为已经过去\"\n        },\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这一下松动，也像是“不是已经想通了，而是抵抗得累了”。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他不服气\",\n          \"point\": \"受过的气不该忍\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"开心的事也不该抹掉\"\n        },\n        {\n          \"text\": \"他在心里争来争去\",\n          \"point\": \"已不在那些人身边\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没了力气才发现\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"也不必维持“我应该坚强”的姿态。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"我应该\"\n        },\n        {\n          \"quote\": \"向某个遥远、并不确定的对象祈求，愿望真切，音乐却没有许诺回应。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"明知有些事已经挽不回，便放轻声音，好好看着它。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"这回想起从前\",\n          \"point\": \"没急着拿受过的气压住想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这回\"\n        },\n        {\n          \"text\": \"独自熬过难处后\",\n          \"point\": \"有人陪着有多轻松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"独自熬过难处后，他才懂\"\n        },\n        {\n          \"text\": \"他怕再也没有那份亲近\",\n          \"point\": \"因曾拥有而暖了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕再也没有那份亲近，却\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"把人从甜梦里生生拽回严寒。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"生生拽回\"\n        },\n        {\n          \"quote\": \"事情表面上仿佛已经过去，身体和情绪却还没有完全相信一切已经结束。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"情绪也不信\"\n        },\n        {\n          \"quote\": \"恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"具体又熟悉\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他刚安心一点\",\n          \"point\": \"还得独自扛\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"刚安心一点，就想到\"\n        },\n        {\n          \"text\": \"他想找回那份亲近\",\n          \"point\": \"离开的决心也松了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又怕回去还要受气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一眼里有温柔，也有不舍。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在