{"completed": true, "response": "<escape>{\n  \"blocks\": [\n    {\"id\":\"S01-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S01-0-1\",\"a\":\"对上\",\"b\":\"偏了\",\"lost\":\"乙把身体短暂失重、脚下摇晃的感觉转成了心动，混入了原稿没有明确表达的情感。\"},\n    {\"id\":\"S01-0-2\",\"a\":\"对上\",\"b\":\"没对上\",\"lost\":\"乙不知道。甲抓住了尚未落稳、仍然漂浮悬置的感觉。\"},\n    {\"id\":\"S01-0-3\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S01-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S01-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-3\",\"a\":\"偏了\",\"b\":\"偏了\",\"lost\":\"两人都只理解为温暖舒服或亲近，缺少夏末潮湿、温热、略带黏稠的微风贴着皮肤的感官质地。\"},\n    {\"id\":\"S02-0-4\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-5\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-6\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-1-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-2-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-2-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-2-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-0-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-0-3\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-1-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-1-3\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-1-4\",\"