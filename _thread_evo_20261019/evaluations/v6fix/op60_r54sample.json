      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S07",
    "bars": "51–61",
    "relation": "正在面对",
    "items": [
     {
      "id": "S07-1",
      "text": "对方也会向他寻求亲近与依靠，他第一次觉得自己不只是被接纳，也确实被需要。",
      "key": "对方也会向他寻求",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1"
      ]
     },
     {
      "id": "S07-2",
      "text": "他想更充分地回应这份需要，心里涌起很热的满足，几乎舍不得从这种彼此依靠里抽身。",
      "key": "他想更充分地回应",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1"
      ]
     },
     {
      "id": "S07-3",
      "text": "他沉在这份满足里，心里已经隐约舍不得它只属于眼前这一刻。",
      "key": "他沉在这份满足里",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S06-1",
      "to": "S07-1",
      "rel": "引用"
