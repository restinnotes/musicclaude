{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他离开了熟悉的生活\",\n          \"accent\": \"离开\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"起初总算不用再反复委屈自己\",\n          \"accent\": \"不用再反复委屈自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"像硬撑着不倒下却很想停\",\n          \"accent\": \"很想停\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-B2\"],\n          \"at\": 24\n        },\n        {\n          \"text\": \"心里空落落说不清舍不得什么\",\n          \"accent\": \"空落落\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S01-2\"],\n          \"at\": 40\n        },\n        {\n          \"text\": \"他想往前走却不知怎样安心\",\n          \"accent\": \"不知怎样安心\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-3\"],\n          \"at\": 56\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"尊严还在，方向和力气却不稳\",\n          \"after\": 2,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"\",\n          \"at\": 29\n        },\n        {\n          \"text\": \"分不清是愤怒遗憾还是怀念\",\n          \"after\": 3,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"\",\n          \"at\": 45\n        },\n        {\n          \"text\": \"刚醒来般恍惚，四周冷空胸口发紧\",\n          \"after\": 3,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"1-23\",\n          \"at\": 62\n        },\n        {\n          \"text\": \"眼前模糊，颤手摸空，还没哭出来\",\n          \"after\": 3,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"1-23\",\n          \"at\": 74\n        },\n        {\n          \"text\": \"旧日声音光线回来，却回不到从前\",\n          \"after\": 4,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"9-17\",\n          \"at\": 82\n        },\n        {\n          \"text\": \"身体先于意识，隐约记起舞步\",\n          \"after\": 4,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"18-23\",\n          \"at\": 88\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"沉重和弦后琶音散开，停顿像还等回声\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1-6\"\n        },\n        {\n          \"text\": \"短句刚冒出就被长停顿截断\",\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1-23\"\n        },\n        {\n          \"text\": \"旋律渐清，波兰舞曲步态逐渐浮现\",\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"9-23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"他舍不得从前自在的日子\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到以后不能那样过就心慌\",\n          \"accent\": \"心慌\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-1\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"他提醒自己受过的气\",\n          \"accent\": \"受过的气\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 22\n        },\n        {\n          \"text\": \"怕一心软就忘了为何离开\",\n          \"accent\": \"为何离开\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 34\n        },\n        {\n          \"text\": \"不受那些气就得丢掉好日子？\",\n          \"accent\": \"丢掉好日子\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-3\"],\n          \"at\": 46\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"远处旧歌般熟悉，只能模糊哼几句\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24-65\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"珍惜的东西还在，却不能照旧拥有\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24-65\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"舞步庄严，歌声像私下哼唱\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24-65\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"腿脚虚浮，像在记忆里挪舞步\",\n          \"after\": 1,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24-65\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"呼吸被连绵音符催得越来越急\",\n          \"after\": 1,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"56-65\",\n          \"at\": 40\n        },\n        {\n          \"text\": \"第三遍说没事，露出在意仍不甘消亡\",\n          \"after\": 4,\n          \"from\": [\"S02-B4\", \"S02-B5\"],\n          \"bars\": \"44-65\",\n          \"at\": 52\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"节奏庄严傲慢，旋律却脆弱凄婉\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24-65\"\n        },\n        {\n          \"text\": \"伴奏底下细碎声音不安地蠕动\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24-65\"\n        },\n        {\n          \"text\": \"旋律先上推又退下，随后再次聚拢\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"38-65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他还憋着一股气\",\n          \"accent\": \"一股气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起有人把他当自己人\",\n          \"accent\": \"当自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他短暂高兴又很快心酸\",\n          \"accent\": \"短暂高兴\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-1\", \"S03-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"从前那样的日子回不去了\",\n          \"accent\": \"回不去了\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S03-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"离开以后就一定更好过吗？\",\n          \"accent\": \"一定更好过吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像故乡麦浪微风，也像从前自在亲近\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"80-91\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"温柔得心颤，偏偏又刺痛绝望\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"80-91\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"像出去走走，轻松是真的，心事仍没答案\",\n          \"after\": 4,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"66-91\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"耳边像多人低声絮语，脚下像流沙\",\n          \"after\": 3,\n          \"from\": [\"S03-B4\"],\n          \"bars\": \"66-91\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"刚才那股昂扬，我真信了还是硬撑？\",\n          \"after\": 4,\n          \"from\": [\"S03-B5\"],\n          \"bars\": \"66-91\",\n          \"at\": 25\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"第66小节和弦若突出，会像重锤砸下\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66\"\n        },\n        {\n          \"text\": \"忽强忽弱的起伏让节奏忽然悬起来\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66-91\"\n        },\n        {\n          \"text\": \"前半急切，后半旋律转柔和轻盈\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"66-91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"想起从前亲近的日子\",\n          \"accent\": \"亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他一度真盼着还能那样相处\",\n          \"accent\": \"真盼着\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"可当初受过的委屈也翻上来\",\n          \"accent\": \"委屈\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他反复问那一步走对了吗？\",\n          \"accent\": \"走对了吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"没走的话如今又会怎样？\",\n          \"accent\": \"又会怎样\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"感激亲密和短暂幸福都涌回来\",\n          \"after\": 1,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92-107\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"步子还向前，心里却有更多回声\",\n          \"after\": 1,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92-107\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"那份坚定或许只是他想成为的样子\",\n          \"after\": 1,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92-107\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"过去太好，想到它反而刺痛\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108-115\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"脚步心跳乱了，脑子不停问如果当时\",\n          \"after\": 3,\n          \"from\": [\"S04-B3\", \"S04-B4\"],\n          \"bars\": \"92-115\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"不停往前赶，只为不让自己停下来\",\n          \"after\": 4,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94-115\",\n          \"at\": 28\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"温柔旋律忽然转为风暴般紧绷\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108-115\"\n        },\n        {\n          \"text\": \"旋律一路向下，像被撕扯着后退\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108-115\"\n        },\n        {\n          \"text\": \"低音不断追赶，旋律急促挣扎\",\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92-115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他仍觉得当初那些气不该忍\",\n          \"accent\": \"不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可他连过去开心的事都不敢多想\",\n          \"accent\": \"不敢多想\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他跟自己争得渐渐没了力气\",\n          \"accent\": \"没了力气\",\n          \"emotion\": \"疲惫\",\n          \"from\": [\"S05-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"那股不服气慢慢淡了\",\n          \"accent\": \"慢慢淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"想到已不在那些人身边他难受\",\n          \"accent\": \"不在那些人身边\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"夜色里两个影子低声私语\",\n          \"after\": 4,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"116-147\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"柔和歌唱里仍有句不能就此算了\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116-127\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"愤怒悲伤里还想维护自己\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116-127\",\n          \"at\": 33\n        },\n        {\n          \"text\": \"某个人或故乡旧生活，眷恋里有失落\",\n          \"after\": 4,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116-147\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"脚下像没了地板，只剩一个声音\",\n          \"after\": 4,\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128-129,139-144\",\n          \"at\": 39\n        },\n        {\n          \"text\": \"深呼吸般松了一下，其实只是累了\",\n          \"after\": 3,\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"144-147\",\n          \"at\": 42\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"快速音流渐渐放慢变稀，最后化成疏落和弦\",\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128-147\"\n        },\n        {\n          \"text\": \"旋律几乎单独露出来\",\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128-129,139-144\"\n        },\n        {\n          \"text\": \"躁动之后声音逐渐稀疏下来\",\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"132-147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"他想起从前无需时时防备\",\n          \"accent\": \"无需时时防备\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他很想再有那种默契的亲近\",\n          \"accent\": \"默契的亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-3\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"可他怕以后再也没有\",\n          \"accent\": \"再也没有\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-3\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"想起真有过的日子心里暖了\",\n          \"accent\": \"心里暖了\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-4\"],\n          \"at\": 21\n        },\n        {\n          \"text\": \"安宁短暂现实并没有变好\",\n          \"accent\": \"现实并没有变好\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-B1\"],\n          \"at\": 28\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"身边少了他们，才知从前多轻松\",\n          \"after\": 0,\n          \"from\": [\"S06-2\"],\n          \"bars\": \"\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"这回没拿受过的气压住想念\",\n          \"after\": 0,\n          \"from\": [\"S06-1\"],\n          \"bars\": \"\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"玻璃罩般静谧，像母亲轻哼摇篮曲\",\n          \"after\": 4,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148-180\",\n          \"at\": 40\n        },\n        {\n          \"text\": \"圣咏般庄严，藏着心事也不必装坚强\",\n          \"after\": 4,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148-180\",\n          \"at\": 44\n        },\n        {\n          \"text\": \"委屈愿望思念浮起，祈求未必有回应\",\n          \"after\": 4,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148-180\",\n          \"at\": 48\n        },\n        {\n          \"text\": \"远去家园梦里亮起，只远远看着不去抓\",\n          \"after\": 3,\n          \"from\": [\"S06-B2\", \"S06-B4\"],\n          \"bars\": \"160\",\n          \"at\": 52\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"绵长的歌唱让周围忽然安静下来\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148-180\"\n        },\n        {\n          \"text\": \"歌唱由试探渐渐展开，临近结尾仍未收住\",\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"148-180\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他刚有点安心\",\n          \"accent\": \"安心\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"以后难事还得独自扛吗？\",\n          \"accent\": \"独自扛吗\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"当初只想不再受那些气\",\n          \"accent\": \"不再受那些气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"他没料到离开后这么孤单\",\n          \"accent\": \"这么孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-2\"],\n          \"at\": 15\n        },\n        {\n          \"text\": \"他想找回亲近却不愿再受气\",\n          \"accent\": \"不愿再受气\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"早知道会这么孤单，他还会走吗？\",\n          \"after\": 3,\n          \"from\": [\"S07-2\"],\n          \"bars\": \"\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"寒风猛地吹开窗，后颈发凉脉搏急跳\",\n          \"after\": 1,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"忽然换了场景，心里却未必好转\",\n          \"after\": 3,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182-197\",\n          \"at\": 31\n        },\n        {\n          \"text\": \"事像过去了，心里翻转想冲却无出口\",\n          \"after\": 4,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198-205\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"离开时的决心也找不着了\",\n          \"after\": 4,\n          \"from\": [\"S07-3\"],\n          \"bars\": \"\",\n          \"at\": 39\n        },\n        {\n          \"text\": \"熟悉动作和舞蹈闯进来，反而照出失去\",\n          \"after\": 4,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181-205\",\n          \"at\": 43\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高处忽然响起一串细长的颤动声\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182\"\n        },\n        {\n          \"text\": \"舞步突然闯入，熟悉的舞曲气息却不再完整\",\n          \"from\": [\"S07-B2\", \"S07-B5\"],\n          \"bars\": \"182-197\"\n        },\n        {\n          \"text\": \"连续细颤一层层把紧张堆高\",\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198-205\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"他先把回去的事放一边\",\n          \"accent\": \"放一边\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起曾被当作自己人心里暖了\",\n          \"accent\": \"心里暖了\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"这点暖意没让他想回头\",\n          \"accent\": \"没让他想回头\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"可暖意很快就淡了\",\n          \"accent\": \"很快就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"想到以后难事他心又悬起来\",\n          \"accent\": \"心又悬起来\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-2\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"柔软处重新打开，像离开前回头一眼\",\n          \"after\": 1,\n          \"from\": [\"S08-B1\", \"S08-B2\"],\n          \"bars\": \"206-213\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"回忆陪不了难处，胸口只喘了一口气\",\n          \"after\": 4,\n          \"from\": [\"S08-2\", \"S08-B3\"],\n          \"bars\": \"206-213\",\n          \"at\": 14\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"缓慢宽广的歌唱短暂返回\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"206-213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他想回去究竟为了什么？\",\n          \"accent\": \"为了什么\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"舍不得被当作自己人的日子\",\n          \"accent\": \"当作自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S09-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"还是怕孤单到愿意再受气？\",\n          \"accent\": \"愿意再受气\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"这念头让他心慌得不敢再想\",\n          \"accent\": \"不敢再想\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-2\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"同一扇门重现，刚有的稳定感又散掉\",\n          \"after\": 3,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214-215\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"像又遇见那个无措的自己\",\n          \"after\": 0,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214-215\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"这回知道那时的自己经历过什么\",\n          \"after\": 0,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214-215\",\n          \"at\": 20\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"沉重引子在颤音光晕中闪回，声音又向高处漂去\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214-215\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他最舍不得被当作自己人\",\n          \"accent\": \"最舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可回去还能像从前那样吗？\",\n          \"accent\": \"像从前那样吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"受过的委屈不能当没发生\",\n          \"accent\": \"不能当没发生\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他想得很累始终没答案\",\n          \"accent\": \"始终没答案\",\n          \"emotion\": \"疲惫\",\n          \"from\": [\"S10-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"舍不得也不敢放心回去，眼下也不踏实\",\n          \"after\": 2,\n          \"from\": [\"S10-2\", \"S10-3\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"熟悉声音碎成片段，摇篮曲也碎裂哀婉\",\n          \"after\": 3,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216-225\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"忽然失重，整个人悬在半空\",\n          \"after\": 3,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"221-225\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"怎样继续生活，重要往事也没力气重讲\",\n          \"after\": 3,\n          \"from\": [\"S10-B3\", \"S10-B4\"],\n          \"bars\": \"216-225\",\n          \"at\": 19\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的如歌旋律和舞曲主题只剩碎片\",\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216-225\"\n        },\n        {\n          \"text\": \"声音零碎飘忽，忽然像失去了着落\",\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"221-225\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他知道回去未必找回亲近\",\n          \"accent\": \"未必找回亲近\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"却还是忍不住想万一能呢？\",\n          \"accent\": \"万一能呢\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 2\n        },\n        {\n          \"text\": \"他不愿只凭希望回去忍让\",\n          \"accent\": \"不愿只凭希望\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他决定先把眼下日子过稳\",\n          \"accent\": \"过稳\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-3\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"怕难处独自扛也不收回打算\",\n          \"accent\": \"不收回打算\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-4\"],\n          \"at\": 8\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像困兽一次次顶住，压力没有散\",\n          \"after\": 4,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226-237\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"祈祷渐渐带回脚步，意志慢慢聚拢\",\n          \"after\": 3,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"226-241\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"怕还在，脚往前走，停滞终于松一点\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"226-241\",\n          \"at\": 14\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"低音波涛反复涌起，重和弦接连砸下\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226-237\"\n        },\n        {\n          \"text\": \"舞曲步子从试探渐渐聚拢\",\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"226-241\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他不逼自己选边也不怪离开\",\n          \"accent\": \"不逼自己选边\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-1\", \"S12-2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他不愿只为有人陪就回头\",\n          \"accent\": \"不愿回头\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他愿带着想念继续过日子\",\n          \"accent\": \"带着想念\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"像经历动摇后仍选择站稳\",\n          \"accent\": \"选择站稳\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-B2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"像不必假装自己从没受过伤\",\n          \"accent\": \"不必假装\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-B2\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"气不该忍，开心也是真的，仍怕独自熬\",\n          \"after\": 2,\n          \"from\": [\"S12-1\", \"S12-2\"],\n          \"bars\": \"\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"沉重步子落地，集体昂扬中一斜仍向前\",\n          \"after\": 3,\n          \"from\": [\"S12-B1\", \"S12-B3\"],\n          \"bars\": \"242-253\",\n          \"at\": 17\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的舞曲主题轰然铺满整个声音\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"242-253\"\n        },\n        {\n          \"text\": \"昂扬的声音忽然换了颜色\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"249-253\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"想起从前亲近心里又热起来\",\n          \"accent\": \"心里又热起来\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他盼以后还能那样相处\",\n          \"accent\": \"还能那样相处\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S13-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"他有了劲头不再跟从前较劲\",\n          \"accent\": \"有了劲头\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"他怕还要等很久才遇上亲近的人\",\n          \"accent\": \"等很久\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-3\"],\n          \"at\": 15\n        },\n        {\n          \"text\": \"有人再把他当自己人他会珍惜\",\n          \"accent\": \"他会珍惜\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S13-4\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"若一直没有，也愿意自己好好过\",\n          \"after\": 4,\n          \"from\": [\"S13-4\"],\n          \"bars\": \"\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"不再为了留住谁把委屈咽下去\",\n          \"after\": 4,\n          \"from\": [\"S13-4\"],\n          \"bars\": \"\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"故土记忆和希望涌来，心跳到极限\",\n          \"after\": 2,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254-270\",\n          \"at\": 29\n        },\n        {\n          \"text\": \"像被气流推着跑，兴奋得来不及喘\",\n          \"after\": 2,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"269-280\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"心渐渐静了，成功未必稳，也终于能歇息\",\n          \"after\": 3,\n          \"from\": [\"S13-3\", \"S13-B3\"],\n          \"bars\": \"281-287\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"高音像寒星钟响，也像决定或梦醒\",\n          \"after\": 4,\n          \"from\": [\"S13-B4\", \"S13-B5\"],\n          \"bars\": \"286-288\",\n          \"at\": 40\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"柔软歌声进入宏大明亮的音响，快速音流随后冲出\",\n          \"from\": [\"S13-B1\", \"S13-B2\"],\n          \"ba