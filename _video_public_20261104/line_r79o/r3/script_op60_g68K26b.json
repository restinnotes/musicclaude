 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然想靠近这个人",
       "keys": [
        "想靠近"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "怕显得太需要而只露一点喜欢，像话卡在唇边",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "一点亲近很甜，下次敢说吗",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      },
      {
       "text": "威尼斯烟花悬在水面，踏船一晃失重",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有退开，他才慢慢放松下来",
       "keys": [
        "没有退开"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他几乎藏不住喜欢又怕太急弄坏自在，未分开已先舍不得",
       "keys": [],
       "from": [
        "S02-2"
       ],
       "bead": "S02-2"
      },
      {
       "text": "肩挨肩低语，沉默也舒服得像湿热的风",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "左手像心跳托着身体漂，水却一直往前流",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "歌声忽然涌高，又轻轻呼气般退回",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "柔软落音像温柔的刺，甜里泛酸想慢些",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他难得不想以后，只想安静待着",
       "keys": [
        "只想安静待着"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声退远，身体随水波漂在余韵里",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "亲密后的沉默很舒服，心却慢慢走远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "想说喜欢也想问是否一样，念头又淡了",
       "keys": [],
       "from": [
        "S03-2"
       ],
       "bead": "S03-2"
      },
      {
       "text": "急着表达的念头冒头，很快沉下去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水下暗流拖住流动，倒影碎得难拼",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他欢喜，他想把心里话说出来",
       "keys": [
        "把心里话说出来"
       ],
       "from": [
        "S04-1",
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "盼说出口能留住这份好，又怕对方为难、弄丢自在",
       "keys": [],
       "from": [
        "S04-3"
       ],
       "bead": "S04-3"
      },
      {
       "text": "他盼对方也喜欢自己不再小心收着的样子",
       "keys": [],
       "from": [
        "S04-2"
       ],
       "bead": "S04-2"
      },
      {
       "text": "歌声更华丽急切，像往事越讲越快也越让人舍不得",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "高处颤音像夕阳金光，喉咙也像哽住",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "手越握越紧，水面越晃船舱越难站稳",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他没藏住喜欢，对方看见他多在乎",
       "keys": [
        "看见他多在乎"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "空落落又怕被嫌太黏，连相处都像隔层纱",
       "keys": [],
       "from": [
        "S05-2"
       ],
       "bead": "S05-2"
      },
      {
       "text": "水波抽走后耳语停了手也松开，幸福能多久？",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看见他在乎，仍照旧亲近",
       "keys": [
        "仍照旧亲近"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "对方不知他怕要太多，他孤单也猜对方舍不得",
       "keys": [],
       "from": [
        "S06-2"
       ],
       "bead": "S06-2"
      },
      {
       "text": "清澈新歌像月光，照见童年初次心动",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "低声说算了又放不下，终于不再装得完整",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "夜里独处没人能进心底，白天的好时光也像回忆",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "气味、身体、幻想、遗憾和情色暖意交缠，舒服得迷失方向",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他渐渐觉得，对方有时也需要他陪",
       "keys": [
        "也需要他陪"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "也许自己能让对方安心，想到互相依靠心里一紧",
       "keys": [],
       "from": [
        "S07-2"
       ],
       "bead": "S07-2"
      },
      {
       "text": "他盼对方想找人陪时想到自己，自己能一直陪着",
       "keys": [],
       "from": [
        "S07-3"
       ],
       "bead": "S07-3"
      },
      {
       "text": "清澈歌声底下，情欲、执念和生的眷恋翻涌",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "气味、身体、幻想、遗憾和快感交缠，舒服得不想抽身",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "一切还很好，他却听见时间正在经过",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "上回露了心意后对方仍亲近，他想大方回应",
       "keys": [
        "大方回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他开始盼两个人能好很久，心里却没底",
       "keys": [],
       "from": [
        "S08-2"
       ],
       "bead": "S08-2"
      },
      {
       "text": "歌句越唱越开，直接得像一段咏叹调",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "身体重新有弹性，轻快得像调情回应",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      },
      {
       "text": "歌声向上散开后忽然停住，余温里泛起怀念",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方有天不再需要他，忽然不敢再想远",
       "keys": [
        "不再需要他"
       ],
       "from": [
        "S09-1",
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "眼下两人仍亲近，也许对方喜欢他在身边",
       "keys": [],
       "from": [
        "S09-3"
       ],
       "bead": "S09-3"
      },
      {
       "text": "话到要紧处停住，他听着余响问是真的吗",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "明亮被薄雾隔开，四周仍留着光",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      },
      {
       "text": "抬头望见夜空，眼前美好比愿望更大",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他先不猜以后，只享受眼前亲近",
       "keys": [
        "享受眼前亲近"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩膀松开，亮得想笑也想哭",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "清风拨开摇荡，时间短暂松开",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "身体失去重量，像灵魂飘在夏夜风里",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      },
      {
       "text": "高音像银丝细雨，一串音符像瀑布落水",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他不再藏着喜欢，即使对方不需要也愿陪着",
       "keys": [
        "不再藏着喜欢"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他高兴得顾不上害臊，也不再为喜欢道歉",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      },
      {
       "text": "厚重和弦托起歌声，水波翻成惊涛",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      },
      {
       "text": "力量悬在半空，像等着下一股浪潮",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "以后对方还愿不愿让他陪，不由他决定",
       "keys": [
        "不由他决定"
       ],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧房子没变，知道太多后夕阳刺眼得心疼",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他顾不上对方是否也在乎，只想让对方安心",
       "keys": [
        "只想让对方安心"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他明知以后难保证仍想多陪一会儿，也不再收着喜欢",
       "keys": [],
       "from": [
        "S12-2"
       ],
       "bead": "S12-2"
      },
      {
       "text": "他像被卷进更大的世界，连自己都退到后面",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      },
      {
       "text": "狂喜像高烧，重逢时抱紧不放连笑哭都分不清",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      },
      {
       "text": "旋律一次次向上恳求，始终还差一点",
       "keys": [],
       "from": [
        "S12-B3"
       ],
       "bead": "S12-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想听对方保证，以后也不会变",
       "keys": [
        "保证"
       ],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "越喜欢越觉时间飞快，刚说是又问可是又怕一停失去",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "如今更怕对方不再需要他，想少露些喜欢",
       "keys": [],
       "from": [
        "S13-2"
       ],
       "bead": "S13-2"
      },
      {
       "text": "可他装不回不在乎，往回藏反而更难受",
       "keys": [],
       "from": [
        "S13-3"
       ],
       "bead": "S13-3"
      },
      {
       "text": "幸福里渐渐掺进尖锐的悲伤，得到也会疼",
       "keys": [],
       "from": [
        "S13-B2"
       ],
       "bead": "S13-B2"
      },
      {
       "text": "脚步踩稳不动，上方声音一再坠落让胸口一沉",
       "keys": [],
       "from": [
        "S13-B4"
       ],
       "bead": "S13-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S14",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他舍不得，不再逼对方保证永远不变",
       "keys": [
        "不再逼对方保证永远不变"
       ],
       "from": [
        "S14-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "以后到了再说，喜欢被看见就不再藏",
       "keys": [],
       "from": [
        "S14-2"
       ],
       "bead": "S14-2"
      },
      {
       "text": "最初不敢露喜欢，如今仍亲近又甜又酸却不后悔",
       "keys": [],
       "from": [
        "S14-1"
       ],
       "bead": "S14-1"
      },
      {
       "text": "身体渐渐平静，梦里的光还留着",
       "keys": [],
       "from": [
        "S14-B1"
       ],
       "bead": "S14-B1"
      },
      {
       "text": "低声熟曲回应开头，细碎音符像夜空水花",
       "keys": [],
       "from": [
        "S14-B2"
       ],
       "bead": "S14-B2"
      },
      {
       "text": "铁锚般和弦定住船，也像整理衣服关门",
       "keys": [],
       "from": [
        "S14-B3"
       ],
       "bead": "S14-B3"
      }
     ]
    }
   ]
  }
 ]
