{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"紧接着的自由上行琶音却没把这份重量接住\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经哭出来的悲伤，而是连自己身在何处都还没弄清的恍惚\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"身体先于意识，隐约记起了该如何迈步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开熟悉的生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初觉得\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"不知怎样安定下来\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想继续过日子，却\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"主旋律更像一首从远处传来的旧歌，你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"依稀认得\"\n        },\n        {\n          \"quote\": \"节奏本身庄严、傲慢，旋律却脆弱凄婉\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"反复说才露馅\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到再不能自在地过日子\",\n          \"point\": \"心里就慌\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"再不能自在地过日子\"\n        },\n        {\n          \"text\": \"他提醒自己