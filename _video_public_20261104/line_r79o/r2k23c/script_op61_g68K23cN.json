   ]
  },
  {
   "label": "越想念越被现实刺痛",
   "emotion": "不安",
   "sections": [
    "S04",
    "S05",
    "S06",
    "S07"
   ]
  },
  {
   "label": "暖意退去答案仍悬着",
   "emotion": "悬着",
   "sections": [
    "S08",
    "S09",
    "S10"
   ]
  },
  {
   "label": "不急着回头先把日子过好",
   "emotion": "安心",
   "sections": [
    "S11",
    "S12",
    "S13"
   ]
  }
 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "离开熟悉生活后，他因不用再受委屈而松了口气。",
       "keys": [
        "不用再受委屈",
        "松了口气"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "笃定很快散了，舍不得旧日却不知如何安定",
       "keys": [],
       "from": [
        "S01-2"
       ],
       "bead": "S01-2"
      },
      {
       "text": "背脊刚挺直，心又飘起来：我其实想停下",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "像刚醒来，胸口发紧，视线还模糊",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "旧场景忽然清晰，声音和光线都回来了",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "想到以后不能再像从前那样自在，他心里发慌。",
       "keys": [
        "不能再像从前那样自在",
        "心里发慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他拿受过的气提醒自己为何离开，越说没事越显在意",
       "keys": [],
       "from": [
        "S02-2"
       ],
       "bead": "S02-2"
      },
      {
       "text": "可他不甘心，难道好日子也得一起舍弃",
       "keys": [],
       "from": [
        "S02-3"
       ],
       "bead": "S02-3"
      },
      {
       "text": "舞步虽已清楚，心里却只哼得出几句旧歌",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "步子庄严傲慢，旋律却脆弱凄婉",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想起曾被当作自己人，他在怨气里短暂欢喜。",
       "keys": [
        "当作自己人",
        "短暂欢喜"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "可旧日难再，他又怀疑离开后真会更好过吗",
       "keys": [],
       "from": [
        "S03-2"
       ],
       "bead": "S03-2"
      },
      {
       "text": "和弦若被突出，像重锤砸下",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "暂时侧身离开问题，耳边絮语缠绕，像流沙般没重心",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "昂扬退潮，他又问：刚才是真的相信了吗",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他一度真盼着还能那样相处。",
       "keys": [
        "从前亲近的日子",
        "还能那样相处"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日的亲密、感激和短暂幸福又鲜活起来",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "记忆太好，委屈也翻上来：那一步走对了吗？没走会怎样",
       "keys": [],
       "from": [
        "S04-2"
       ],
       "bead": "S04-2"
      },
      {
       "text": "细碎音符像急促脚步，心跳也乱了拍",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "脑子停不下‘如果当时……是不是还可以……’",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他觉得当初那些气不该忍，也不想躲开开心回忆。",
       "keys": [
        "那些气不该忍",
        "开心回忆"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "争得没力气，不服气淡了，只剩不在他们身边的难受",
       "keys": [],
       "from": [
        "S05-2"
       ],
       "bead": "S05-2"
      },
      {
       "text": "两只手像夜色里两个影子，彼此低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "柔声里仍顶着一股劲：这事不能就这样算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "旧日记忆重新有温度，眷恋里仍带着失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "难受缓下来，他想起从前不用防备，也没压住想念。",
       "keys": [
        "难受缓下来",
        "没压住想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "静得像隔着透明玻璃罩，像耳边轻哼的摇篮曲",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "少了他们，他才知有人相伴曾让自己多轻松",
       "keys": [],
       "from": [
        "S06-2"
       ],
       "bead": "S06-2"
      },
      {
       "text": "盼再有亲近又怕没有；想起曾拥有，心里暖一点",
       "keys": [],
       "from": [
        "S06-3"
       ],
       "bead": "S06-3"
      },
      {
       "text": "梦里的家园亮起，看得见却回不去，也不必急着抓回",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，他又怕以后遇事仍只能独自扛着。",
       "keys": [
        "刚有点安心",
        "独自扛着"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "当初只顾摆脱委屈，没料到这么孤单；还会走吗",
       "keys": [],
       "from": [
        "S07-2"
       ],
       "bead": "S07-2"
      },
      {
       "text": "想找回亲近，又不肯再受委屈，决心也找不回",
       "keys": [],
       "from": [
        "S07-3"
       ],
       "bead": "S07-3"
      },
      {
       "text": "寒风般的高音一闪，舞步闯入，旧声残缺，心未安",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "熟悉动作闯进来，越亲切越看清失去什么",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起曾被当作自己人，他心里暖了，却没想回头。",
       "keys": [
        "被当作自己人",
        "没想回头"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "宽广歌唱短暂回来",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "像离开前最后回头一眼",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      },
      {
       "text": "回忆陪不了往后难处，暖意退去，心又悬起",
       "keys": [],
       "from": [
        "S08-2"
       ],
       "bead": "S08-2"
      },
      {
       "text": "胸口像终于吸进一口气",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他分不清想回去是舍不得归属，还是怕孤单到愿再受委屈。",
       "keys": [
        "舍不得归属",
        "愿再受委屈"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头那扇门又阴冷地闪现，步子还没聚起来",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "像重新遇见那个不知怎么办的自己，问题仍无简单答案",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      },
      {
       "text": "这念头让他心慌，连往下想都不敢了",
       "keys": [],
       "from": [
        "S09-2"
       ],
       "bead": "S09-2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "最舍不得的是曾被当作自己人的日子，可旧委屈让他不敢回去。",
       "keys": [
        "曾被当作自己人",
        "不敢回去"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "回去未必找得回亲近，当初的委屈也抹不掉",
       "keys": [],
       "from": [
        "S10-2"
       ],
       "bead": "S10-2"
      },
      {
       "text": "反复想仍没答案：往后怎么生活？眼下也不踏实",
       "keys": [],
       "from": [
        "S10-3"
       ],
       "bead": "S10-3"
      },
      {
       "text": "熟悉声音只剩碎片，重要往事也没力气讲完",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "忽然失重，整个人悬在半空",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他不愿只凭一点指望回去忍旧委屈，先把眼下日子过稳。",
       "keys": [
        "不愿只凭一点指望",
        "把眼下日子过稳"
       ],
       "from": [
        "S11-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他仍盼回去或许能重拾亲近，却未必如愿",
       "keys": [],
       "from": [
        "S11-1"
       ],
       "bead": "S11-1"
      },
      {
       "text": "怕往后仍得独自扛事，他还是不收回打算",
       "keys": [],
       "from": [
        "S11-3"
       ],
       "bead": "S11-3"
      },
      {
       "text": "脚步从试探渐渐聚拢，害怕还在，人已往前",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "委屈不该忍，开心也是真的；他自己决定怎样站稳。",
       "keys": [
        "委屈不该忍",
        "开心也是真的"
       ],
       "from": [
        "S12-1",
        "S12-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "好时光仍让他心软，也怕往后一个人熬",
       "keys": [],
       "from": [
        "S12-2"
       ],
       "bead": "S12-2"
      },
      {
       "text": "他不再怪自己当初离开",
       "keys": [],
       "from": [
        "S12-2"
       ],
       "bead": "S12-2"
      },
      {
       "text": "不为有人陪就回头，愿带着想念过日子",
       "keys": [],
       "from": [
        "S12-3"
       ],
       "bead": "S12-3"
      },
      {
       "text": "熟悉舞步雷鸣般回来，沉重脚步终于落地",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "再有人把他当自己人，他会珍惜；没有也好好过，不为留人咽委屈。",
       "keys": [
        "当自己人",
        "不为留人咽委屈"
       ],
       "from": []
      }
     ],
     "beads": [
      {
       "text": "想起自然亲近的日子，他心里又热了，也盼再有",
       "keys": [],
       "from": [
        "S13-1"
       ],
       "bead": "S13-1"
      },
      {
       "text": "这份盼望给他劲头，好好过日子，不再跟过去较劲",
       "keys": [],
       "from": [
        "S13-2"
       ],
       "bead": "S13-2"
      },
      {
       "text": "可再遇亲近的人或许还要很久，心渐渐静下来",
       "keys": [],
       "from": [
        "S13-3"
       ],
       "bead": "S13-3"
      },
      {
       "text": "冲势收敛，细碎颤动又带来一点不安",
       "keys": [],
       "from": [
        "S13-B3"
       ],
       "bead": "S13-B3"
      }
     ]
    }
   ]
  }
 ]
}