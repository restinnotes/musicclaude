    ]
   },
   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "没在想",
    "items": [
     {
      "id": "S08-1",
      "text": "他又沉进从前那种被自然接纳的感觉里，心里有一会儿很柔和，像终于能重新靠近那份熟悉。",
      "key": "他又沉进从前那种",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2",
       "S07-4"
      ]
     },
     {
      "id": "S08-2",
      "text": "可这份亲近很快又远了，舍不得一下涌上来，身体里那点紧绷只松开了一瞬。",
      "key": "可这份亲近很快又",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-2",
      "to": "S08-1",
