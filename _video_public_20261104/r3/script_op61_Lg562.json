      {
       "text": "不敢停下来",
       "keys": [],
       "from": [
        "S04-B4-p3"
       ]
      },
      {
       "text": "越用力越不安稳",
       "keys": [],
       "from": [
        "S04-B2-p1"
       ]
      },
      {
       "text": "抵抗疲惫仓促",
       "keys": [],
       "from": [
        "S04-B2-p3"
       ]
      },
      {
       "text": "被时间催着往前跑",
       "keys": [],
       "from": [
        "S04-B3-p2"
       ]
      },
      {
       "text": "没有真正抵达",
       "keys": [],
       "from": [
        "S04-B4-p2"
       ]
      },
      {
       "text": "思绪反复盘旋",
       "keys": [],
       "from": [
        "S04-B4-p4"
       ]
      }
     ]
    }
   ]
