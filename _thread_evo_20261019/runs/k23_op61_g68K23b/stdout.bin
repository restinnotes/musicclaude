{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"刚离开熟悉的生活，他觉得终于不用再委屈自己。\",\n          \"keys\": [\"终于不用再委屈自己\"],\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"这份笃定很快散了，他心里空落落的，却说不清舍不得什么。\",\n          \"keys\": [\"笃定很快散了\", \"说不清舍不得什么\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-2\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"短句像叹息，刚冒出来就被停顿截断\",\n              \"from\": [\"S01-B3\"],\n              \"bars\": \"\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"像刚醒来，胸口发紧，眼前还模糊\",\n              \"from\": [\"S01-B4\"],\n              \"bars\": \"\",\n              \"at\": 0\n            }\n          ]\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"他还想往前走，却不知靠什么安下心。\",\n          \"keys\": [\"还想往前走\", \"靠什么安下心\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-3\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"我不能倒下，可我其实很想停下来\",\n              \"from\": [\"S01-B2\"],\n              \"bars\": \"\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"旧场景忽然清晰，过去却回不来\",\n              \"from\": [\"S01-B5\"],\n              \"bars\": \"9–17\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"开头一声沉重得像宣告，后面的声音像烟雾散开\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–6\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"舍不得从前的自在，想到以后不能再那样过便发慌。\",\n          \"keys\": [\"舍不得从前的自在\", \"便发慌\"],\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"舞步清楚了，却不像英雄凯旋\",\n              \"from\": [\"S02-B1\"],\n              \"bars\": \"\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"腿脚发虚，还在挪着舞步\",\n              \"from\": [\"S02-B2\"],\n              \"bars\": \"\",\n              \"at\": 0\n            }\n          ]\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"想念一来，他就拿受过的气提醒自己为何离开。\",\n          \"keys\": [\"受过的气\", \"为何离开\"],\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"反复说“我没事”，越说越显出在意\",\n              \"from\": [\"S02-B4\"],\n              \"bars\": \"44–65\",\n              \"at\": 0\n            }\n          ]\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"可他不甘心，难道好日子也要一并否定？\",\n          \"keys\": [\"不甘心\", \"好日子也要一并否定\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"我不甘心就这样消亡\",\n              \"from\": [\"S02-B5\"],\n              \"bars\": \"44–65\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"声音猛地往上冲又退下，呼吸跟着急起来\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"38–65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"想起曾被当作自己人，他高兴过；旧日难再有，离开真会更好吗？\",\n          \"keys\": [\"曾被当作自己人\", \"离开真会更好吗\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-1\", \"S03-2\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"像故乡夏日的麦浪与微风\",\n              \"from\": [\"S03-B2\"],\n              \"bars\": \"80–91\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"像暂时侧身离开沉重的问题，轻松是真的，却没带来答案\",\n              \"from\": [\"S03-B3\"],\n              \"bars\": \"66–91\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"那一下若被听清，像重锤砸下\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"像几个人在耳边低声絮语，彼此缠绕\",\n          \"from\": [\"S03-B4\"],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"昂扬退去，心里冒出一句：刚才真的相信了吗？\",\n          \"from\": [\"S03-B5\"],\n          \"bars\": \"66–91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"想起从前的亲近，他盼着还能那样相处。\",\n          \"keys\": [\"从前的亲近\", \"还能那样相处\"],\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"旧记忆里的亲密、感激和短暂幸福都鲜活起来\",\n              \"from\": [\"S04-B1\"],\n              \"bars\": \"92–107\",\n              \"at\": 0\n            }\n          ]\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"可旧日委屈也翻上来：离开对吗？留下又会怎样？\",\n          \"keys\": [\"旧日委屈也翻上来\", \"留下又会怎样\"],\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"不是记忆变坏，是那段日子太好了\",\n              \"from\": [\"S04-B2\"],\n              \"bars\": \"108–115\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"脑子里反复转着：如果当时……\",\n              \"from\": [\"S04-B4\"],\n              \"bars\": \"94–115\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"细碎声音像急促脚步，心跳乱了拍\",\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92–115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"他不替旧委屈开脱，也不再逼自己忘掉好时光。\",\n          \"keys\": [\"不替旧委屈开脱\", \"不再逼自己忘掉好时光\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"像夜色里两个影子，彼此低声说话\",\n              \"from\": [\"S05-B1\"],\n              \"bars\": \"\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"这件事不能就这样算了\",\n              \"from\": [\"S05-B2\"],\n              \"bars\": \"116–127\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"旧日记忆重新有了温度\",\n              \"from\": [\"S05-B3\"],\n              \"bars\": \"\",\n              \"at\": 0\n            }\n          ]\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"争辩到累了，火气渐淡，只剩不在他们身边的难受。\",\n          \"keys\": [\"火气渐淡\", \"不在他们身边的难受\"],\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"几次深呼吸，像抵抗得累了\",\n              \"from\": [\"S05-B5\"],\n              \"bars\": \"144–147\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"声音渐稀，最后只剩较慢、较疏的几下\",\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128–147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"难受缓下来，他不再拿旧委屈压住这份想念。\",\n          \"keys\": [\"难受缓下来\", \"不再拿旧委屈压住这份想念\"],\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"像被透明玻璃罩隔开的静谧\",\n              \"from\": [\"S06-B1\"],\n              \"bars\": \"\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"愿望朝远方发出，却没有回应的保证\",\n              \"from\": [\"S06-B2\"],\n              \"bars\": \"\",\n              \"at\": 0\n            }\n          ]\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"离开后常得独自熬难事，他才懂有人陪着有多轻松。\",\n          \"keys\": [\"独自熬难事\", \"有人陪着有多轻松\"],\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"曾有过的默契让他宽慰，如今盼着再有，却怕难再遇。\",\n          \"keys\": [\"曾有过的默契让他宽慰\", \"怕难再遇\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"歌唱渐渐展开，临近结束像话没说完\",\n              \"from\": [\"S06-B3\"],\n              \"bars\": \"148–180\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"好好看着珍惜的东西，不急着抓回来\",\n              \"from\": [\"S06-B4\"],\n              \"bars\": \"\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": []\n    },\n    {\n      \"sec\": \"S07\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"想到以后难事还得独自扛，他怕自己撑不住。\",\n          \"keys\": [\"以后难事还得独自扛\", \"怕自己撑不住\"],\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"寒风猛地吹开窗，后颈一凉\",\n              \"from\": [\"S07-B1\"],\n              \"bars\": \"182附近\",\n              \"at\": 0\n            }\n          ]\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"当初离开只为不再受气，如今孤单得又问自己还走不走。\",\n          \"keys\": [\"只为不再受气\", \"孤单得又问自己还走不走\"],\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-2\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"像一个熟悉动作突然闯进来，反而照见失去什么\",\n              \"from\": [\"S07-B4\"],\n              \"bars\": \"\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"心里直想冲出去，却找不到出口\",\n              \"from\": [\"S07-B3\"],\n              \"bars\": \"198–205\",\n              \"at\": 0\n            }\n          ]\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"想找回亲近，却不肯再受委屈，离开的决心也松了。\",\n          \"keys\": [\"想找回亲近\", \"离开的决心也松了\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"熟悉的舞曲气息回来，却不再完整\",\n              \"from\": [\"S07-B5\"],\n              \"bars\": \"182–197\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"舞步突然闯入，截断先前的静谧\",\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182–197\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"他先不把怀念当回头理由；可回忆不能陪他熬过未来难处，心仍悬着。\",\n          \"keys\": [\"不把怀念当回头理由\", \"心仍悬着\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-1\", \"S08-2\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"宽广的歌唱短暂回来，像临走前回头一眼\",\n              \"from\": [\"S08-B1\", \"S08-B2\"],\n              \"bars\": \"206–213\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"胸口像忽然吸进一口气\",\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"206–213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"想回去，是舍不得亲近，还是怕孤单到愿再受委屈？心慌得不敢想。\",\n          \"keys\": [\"舍不得亲近\", \"心慌得不敢想\"],\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\", \"S09-2\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"颤动的光晕里，开头那股沉重又阴冷地闪回\",\n              \"from\": [\"S09-B1\"],\n              \"bars\": \"214–215\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"这次再看那个茫然的自己，已知道他经历过什么\",\n              \"from\": [\"S09-B2\"],\n              \"bars\": \"214–215\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": []\n    },\n    {\n      \"sec\": \"S10\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"他最放不下那份亲近；旧委屈未消，回去未必如前，反复想仍难安。\",\n          \"keys\": [\"最放不下那份亲近\", \"反复想仍难安\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-1\", \"S10-2\", \"S10-3\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"熟悉的声音只剩碎片，重要的事已无力讲完\",\n              \"from\": [\"S10-B1\", \"S10-B4\"],\n              \"bars\": \"216–225\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"我究竟要怎样继续生活？\",\n              \"from\": [\"S10-B3\"],\n              \"bars\": \"216–225\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"声音忽然失重，像整个人悬在半空\",\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"221–225\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"明知回去未必恢复亲近，他仍忍不住盼着。\",\n          \"keys\": [\"未必恢复亲近\", \"忍不住盼着\"],\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"不肯只凭盼头回去；怕独自扛事，仍要先把眼下日子过稳\",\n              \"from\": [\"S11-2\", \"S11-3\"],\n              \"bars\": \"\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"步子从试探慢慢聚拢；害怕还在，脚却往前\",\n              \"from\": [\"S11-B2\", \"S11-B3\"],\n              \"bars\": \"226–241\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"低音像波涛涌起，重重声响接连砸下\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226–237\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"委屈不该忍，好日子也真有过；他不再逼自己选边。\",\n          \"keys\": [\"委屈不该忍\", \"不再逼自己选边\"],\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"可以决定怎样站立，不必假装没受过伤\",\n              \"from\": [\"S12-B2\"],\n              \"bars\": \"242–253\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"仍怕独自熬，却不怪自己离开，也不为陪伴回头；带着想念过日子\",\n              \"from\": [\"S12-2\", \"S12-3\"],\n              \"bars\": \"\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的舞步轰然回来，脚下终于踏实\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"242–253\"\n        },\n        {\n          \"text\": \"脚步向前时，像地面短暂斜了一下\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"249–253\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"rows\": [\n        {\n          \"form\": \"连贯\",\n          \"text\": \"盼着再遇见自然亲近的人，他有劲头过日子，不再整天跟旧事较劲。\",\n          \"keys\": [\"再遇见自然亲近的人\", \"不再整天跟旧事较劲\"],\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-1\", \"S13-2\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"温柔的歌忽然站到明亮处，力量也涌起来\",\n              \"from\": [\"S13-B1\"],\n              \"bars\": \"254–270\",\n              \"at\": 0\n            }\n          ]\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"劲头稍退，他又怕还要等很久。\",\n          \"keys\": [\"劲头稍退\", \"怕还要等很久\"],\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-3\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"冲势收敛，既有一点不安，也像终于能喘口气\",\n              \"from\": [\"S13-B3\"],\n              \"bars\": \"281–287\",\n              \"at\": 0\n            }\n          ]\n        },\n        {\n          \"form\": \"连贯\",\n          \"text\": \"若有人把他当自己人，他会珍惜；没有也好好过，不再忍气留人。\",\n          \"keys\": [\"把他当自己人\", \"不再忍气留人\"],\n          \"emotion\": \"安心\",\n          \"from\": [\"S13-4\"],\n          \"at\": 0\n        },\n        {\n          \"form\": \"散落\",\n          \"items\": [\n            {\n              \"text\": \"低处像吐出最后一口气，高处亮起孤悬寒星\",\n              \"from\": [\"S13-B4\"],\n              \"bars\": \"末尾几小节\",\n              \"at\": 0\n            },\n            {\n              \"text\": \"最后那一下，可以是决定，也可以是梦醒\",\n              \"from\": [\"S13-B5\"],\n              \"bars\": \"286–288\",\n              \"at\": 0\n            }\n          ]\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"明亮的声音迅疾向前冲\",\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"269–280\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"sessi