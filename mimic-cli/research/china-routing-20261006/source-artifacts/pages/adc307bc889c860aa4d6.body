                    chatContent: {"content":"\n\n<a href=\"#\" target=\"_blank\" class=\"as-chat-button active as-buttonlink icon icon-after icon-external\" data-autom=\"chat-with-a-specialist-link\" data-relatedlink=\"chat-with-a-specialist\" data-chat-ui=\"WEB_CHAT_ACTION_GROUP=DEFAULT;\">咨询 iPad Specialist 专家<span class=\"a11y\">(在新窗口中打开)</span></a>\n","images":[{"sources":[{"srcSet":"https://store.storeimages.cdn-apple.com/1/as-images.apple.com/is/step1-chat-specialist?wid=108&hei=108&fmt=png-alpha&.v=VG1QV0dEVmFFbGlWeHJSNHZES2lmTThFUTJjU01RZDB1SEoveXc2VWIxNGZ6OUZxUHZXVVFJUFFxMGpIQ085M3puWEtiOGJPMThBWG9adGJNNWpQeXRxSHU2UmUzV2FKbGp4a25SdGVxYms","type":"image/png"}],"width":"54","height":"54","attrs":"","imageName":"step1-chat-specialist","originalImageName":"step1-chat-specialist","alt":"","noImage":false,"deferSrc":false,"singleElementSources":true,"scaleFactor":"2X"},{"sources":[{"srcSet":"https://store.storeimages.cdn-apple.com/1/as-images.apple.com/is/step1-chat-specialist_AV1?wid=108&hei=108&fmt=png-alpha&.v=VG1QV0dEVmFFbGlWeHJSNHZES2lmQS9McEhvUnE2a2NHT0pXQjZyRkU4emxPZFBFc0NlM0thN1AxUmdGV3ppS1JSOW5PYzUxT0dEclIzbzVKNW1KNGkrbm1YYTd0VlNhYlZQcDNWaUFiUnM","type":"image/png"}],"width":"54","height":"54","attrs":"","imageName":"step1-chat-specialist_AV1","originalImageName":"step1-chat-specialist_AV1","alt":"","noImage":false,"deferSrc":false,"singleElementSources":true,"scaleFactor":"2X"},{"sources":[{"srcSet":"https://store.storeimages.cdn-apple.com/1/as-images.apple.com/is/step1-chat-specialist_AV2?wid=108&hei=108&fmt=png-alpha&.v=VG1QV0dEVmFFbGlWeHJSNHZES2lmRW93Um5FZVNDNFlxT3MvbDR5aU0rTGxPZFBFc0NlM0thN1AxUmdGV3ppS1JSOW5PYzUxT0dEclIzbzVKNW1KNGkrbm1YYTd0VlNhYlZQcDNWaUFiUnM","type":"image/png"}],"width":"54","height":"54","attrs":"","imageName":"step1-chat-specialist_AV2","originalImageName":"step1-chat-specialist_AV2","alt":"","noImage":false,"deferSrc":false,"singleElementSources":true,"scaleFactor":"2X"},{"sources":[{"srcSet":"https://store.storeimages.cdn-apple.com/1/as-images.apple.com/is/step1-chat-specialist_AV3?wid=108&hei=108&fmt=png-alpha&.v=VG1QV0dEVmFFbGlWeHJSNHZES2lmTmdmQTRXK0E1N3JTbXpVbXZRZmdFM2xPZFBFc0NlM0thN1AxUmdGV3ppS1JSOW5PYzUxT0dEclIzbzVKNW1KNHFIc1Z6YnIvdEY3LzUydTl3OVVKeG8","type":"image/png"}],"width":"54","height":"54","attrs":"","imageName":"step1-chat-specialist_AV3","originalImageName":"step1-chat-specialist_AV3","alt":"","noImage":false,"deferSrc":false,"singleElementSources":true,"scaleFactor":"2X"},{"sources":[{"srcSet":"https://store.storeimages.cdn-apple.com/1/as-images.apple.com/is/step1-chat-specialist_AV4?wid=108&hei=108&fmt=png-alpha&.v=VG1QV0dEVmFFbGlWeHJSNHZES2lmS1RyZWRMejQvTDY4cnlSK1VDSnZTemxPZFBFc0NlM0thN1AxUmdGV3ppS1JSOW5PYzUxT0dEclIzbzVKNW1KNG0yd3czZTNvL0hTaDRSZUJLVHlhZjQ","type":"image/png"}],"width":"54","height":"54","attrs":"","imageName":"step1-chat-specialist_AV4","originalImageName":"step1-chat-specialist_AV4","alt":"","noImage":false,"deferSrc":false,"singleElementSources":true,"scaleFactor":"2X"}],"title":"还有其他问题？"}
