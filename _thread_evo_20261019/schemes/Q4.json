{
  "name": "Q4",
  "note": "方案 Q4：Q1 的前三步 + 5.6 第二轮改的写线层（路线只锁事实和前因，具体实现由体验性质影响，查方向和先后变化）",
  "steps": [
    {
      "id": "A1",
      "prompt_file": "Q4_A1.txt",
      "replace": {
        "{NAME}": "WORK_INFO",
        "{SECTIONS}": "SEGMENTS",
        "{K}": {
          "text": "3"
        },
        "{CENTER}": "CENTER"
      },
      "model": "g6"
    },
    {
      "id": "A2",
      "prompt_file": "Q4_A2.txt",
      "replace": {
        "{ROUTES}": "step:A1"
      },
      "model": "g6",
      "append": "\n\n【候选路线】\n{ROUTES}"
    },
    {
      "id": "A3",
      "prompt_file": "Q4_A3.txt",
      "replace": {
        "{SEGMENTS}": "SEGMENTS",
        "{BEADS_TEXT}": "BEADS_TEXT"
      },
      "model": "g6",
      "after": [
        "A1"
      ],
      "append": "\n\n【段落】\n{SEGMENTS}\n\n【珠子】\n{BEADS_TEXT}"
    },
    {
      "id": "A4",
      "prompt_file": "Q4_A4.txt",
      "replace": {
        "{SECTIONS}": "SEGMENTS",
        "{ROUTES}": [
          "step:A1",
          {
            "text": "\n\n【宏观评审结果】\n"
          },
          "step:A2"
        ],
        "{TARGETS}": "step:A3",
        "{CENTER}": "CENTER"
      },
      "model": "g6"
    }
  ],
  "final": "A4"
}