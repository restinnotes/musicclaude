{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"groups\": [\n        {\n          \"label\": \"沉重开端转为空悬的召唤\",\n          \"points\": [\"S01-B1-p1\", \"S01-B1-p2\"]\n        },\n        {\n          \"label\": \"短句断裂、余音散尽与无名失落\",\n          \"points\": [\"S01-B3-p1\", \"S01-B3-p2\", \"S01-B3-p3\"]\n        },\n        {\n          \"label\": \"冷空中醒来，伸手却触不到东西\",\n          \"points\": [\"S01-B4-p1\", \"S01-B4-p2\", \"S01-B4-p3\"]\n        },\n        {\n          \"label\": \"努力挺住，却找不到行动方向\",\n          \"points\": [\"S01-B2-p1\", \"S01-B2-p2\", \"S01-B2-p3\"]\n        },\n        {\n          \"label\": \"旧日场景重新浮现，却无法回到过去\",\n          \"points\": [\"S01-B5-p1\", \"S01-B5-p2\"]\n        },\n        {\n          \"label\": \"身体重新记起舞步，但前进感尚未站稳\",\n          \"points\": [\"S01-B5-p3\", \"S01-B5-p4\"]\n        }\n      ],\n      \"tier_a\": [\"S01-B1-p1\", \"S01-B3-p3\"],\n      \"tier_b\": [\"S01-B1-p2\", \"S01-B3-p1\", \"S01-B4-p1\", \"S01-B2-p3\", \"S01-B5-p1\", \"S01-B5-p3\"],\n      \"only_one\": \"S01-B1-p1\",\n      \"line_order\": [\"S01-2\", \"S01-1\", \"S01-3\"],\n      \"line_a\": [\"S01-1\", \"S01-2\"]\n    },\n    {\n      \"sec\": \"S02\",\n      \"groups\": [\n        {\n          \"label\": \"远处传来的旧歌，熟悉却已无法拥有\",\n          \"points\": [\"S02-B1-p1\", \"S02-B1-p2\", \"S02-B1-p3\", \"S02-B1-p4\"]\n        },\n        {\n          \"label\": \"庄严舞步与脆弱旋律形成反差\",\n          \"points\": [\"S02-B2-p1\", \"S02-B2-p2\", \"S02-B2-p3\"]\n        },\n        {\n          \"label\": \"音乐反复冲起又退回，焦灼而无法落地\",\n          \"points\": [\"S02-B3-p1\", \"S02-B3-p2\", \"S02-B3-p3\"]\n        },\n        {\n          \"label\": \"挺拔姿态掩饰悲伤，反复说服自己\",\n          \"points\": [\"S02-B4-p1\", \"S02-B4-p2\", \"S02-B4-p3\", \"S02-B4-p4\"]\n        },\n        {\n          \"label\": \"不甘心就此消亡的激烈抵抗\",\n          \"points\": [\"S02-B5-p1\", \"S02-B5-p2\"]\n        }\n      ],\n      \"tier_a\": [\"S02-B1-p2\", \"S02-B2-p2\"],\n      \"