 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "离开熟悉的生活后，我心里的笃定很快散了，只剩空落落的，却说不清舍不得什么。",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "有东西在心里 却说不清愤怒遗憾还是怀念",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ],
       "emotion": "悬着"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我离开了熟悉的生活，起初觉得终于不用再委屈自己。",
       "keys": [],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "尊严还在 不能倒下 却很想停下来",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "偶尔想起从前，我仍想往前走，却不知道以后靠什么让自己安定下来。",
       "keys": [],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "记忆再清晰 过去也不会重新变成现在",
       "keys": [],
       "from": [
        "S01-B5-p2"
       ],
       "emotion": "孤单"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "我舍不得从前自在的日子，一想到以后不能再那样过，心里就慌。",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "珍惜的东西还在 却不能像从前那样拥有",
       "keys": [],
       "from": [
        "S02-B1-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "一舍不得从前，我就提醒自己受过他们的气，怕心软后忘了当初为什么离开。",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "反复说我没事 越说越显得在意",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "我还是不甘心：难道为了不再受他们的气，就得连以前的好日子也一起丢掉？",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "我心里还憋着气，可想起和他们在一起、被他们当作自己人时，还是短暂地高兴了。",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "愤怒与抗拒",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "曾经轻松亲近 不必时时防备",
       "keys": [],
       "from": [
        "S03-B2-p3"
       ],
       "emotion": "亲密"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可那点高兴还没散，我就又酸了：从前那样的日子回不去了，离开后就一定会更好吗？",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "从前亲近的日子 越怀念越觉离眼前很远",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起和他们亲近的时候，我真盼着一切还能像从前那样继续。",
       "keys": [],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "感激亲密柔情 短暂幸福",
       "keys": [],
       "from": [
        "S04-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可越盼，我越怀疑当初是不是走错了，却想不出如果没走，如今会怎样。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "记忆太好 过去无法原样回来",
       "keys": [],
       "from": [
        "S04-B2-p2"
       ],
       "emotion": "孤单"
      },
      {
       "text": "不停往前赶 只是为了避免停下来",
       "keys": [],
       "from": [
        "S04-B4-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我仍不服气，觉得当初那些气不该忍；可连过去开心的事都不敢多想，也太为难自己。",
       "keys": [],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "这件事不能就这样算了",
       "keys": [],
       "from": [
        "S05-B2-p1"
       ],
       "emotion": "炽热"
      },
      {
       "text": "眷恋里也带着失落",
       "keys": [],
       "from": [
        "S05-B3-p3"
       ],
       "emotion": "孤单"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "和自己争得累了，我那股不服气渐渐淡了；想到如今已不在他们身边，我只觉得难受。",
       "keys": [],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不是已经想通 而是抵抗得累了",
       "keys": [],
       "from": [
        "S05-B5-p3"
       ],
       "emotion": "不安"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "难受缓下来后，我想起和他们在一起、不必防备的日子；离开后遇事常得独自撑着，我才懂得有人在身边有多轻松，也不再用受过的气压住想念，想到那些日子真实存在过，心里便暖了些。",
       "keys": [],
       "from": [
        "S06-1",
        "S06-2",
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "压住的愿望委屈和思念 终于有机会浮现",
       "keys": [],
       "from": [
        "S06-B2-p3"
       ]
      },
      {
       "text": "不用解释难过 不必维持坚强",
       "keys": [],
       "from": [
        "S06-B2-p2"
       ],
       "emotion": "安心"
      },
      {
       "text": "远去的家园还在梦里 却无法回去",
       "keys": [],
       "from": [
        "S06-B2-p5"
       ],
       "emotion": "孤单"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我很想再过那种不用多说就知道彼此亲近的日子，又怕以后再也没有了。",
       "keys": [],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "安宁不代表现实变好 也不能永远停留",
       "keys": [],
       "from": [
        "S06-B1-p5"
       ],
       "emotion": "悬着"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，我又担心以后遇上难事还得一个人扛，自己真的撑得住吗？",
       "keys": [],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "寒风吹开紧闭的窗 从甜梦拽回严寒",
       "keys": [],
       "from": [
        "S07-B1-p2"
       ]
      },
      {
       "text": "后颈一凉 脉搏剧烈跳动",
       "keys": [],
       "from": [
        "S07-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "当初离开时，我只想着不再受他们的气，没想到会这么孤单；早知道这样，我还会走吗？",
       "keys": [],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "事情像是过去了 身体和情绪却还不信结束",
       "keys": [],
       "from": [
        "S07-B3-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "我想找回从前的亲近，却不甘心回去再受他们的气，也找不回当初离开时的决心。",
       "keys": [],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "细节越具体熟悉 越意识到已经失去",
       "keys": [],
       "from": [
        "S07-B4-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我暂时把回不回去放到一边，想起从前和他们亲近的时光，心里又暖了一会儿。",
       "keys": [],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "回头再看一眼刚才待过的地方 温柔又不舍",
       "keys": [],
       "from": [
        "S08-B2-p2",
        "S08-B2-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可暖意很快淡了，想到以后遇上难事时回忆不能陪我，我心里又悬了起来。",
       "keys": [],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的安静刚被认出 还没安顿就退去了",
       "keys": [],
       "from": [
        "S08-B2-p1"
       ]
      },
      {
       "text": "短暂喘息 不等于整个人重新安顿",
       "keys": [],
       "from": [
        "S08-B3-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "我忽然分不清，想回去是舍不得从前的生活，还是难受时只想有人陪；这个念头让我心慌，连往下想都不敢。",
       "keys": [],
       "from": [
        "S09-1",
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "又遇见那个不知怎么办的自己",
       "keys": [],
       "from": [
        "S09-B2-p1"
       ],
       "emotion": "悬着"
      },
      {
       "text": "舍不得旧生活 还是只想有人陪 仍没有答案",
       "keys": [],
       "from": [
        "S09-B2-p2"
       ],
       "emotion": "悬着"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "我渐渐明白，最舍不得的是从前被他们当作自己人的日子；可就算回去，也未必还能像从前，而当初受过的气不能当作没发生，光凭舍不得我还是无法安心回去。",
       "keys": [],
       "from": [
        "S10-1",
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的感觉回来了 却没有完整回来",
       "keys": [],
       "from": [
        "S10-B1-p5"
       ],
       "emotion": "悬着"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "我反复想得很累，还是没有答案，连眼下的日子也过得不踏实。",
       "keys": [],
       "from": [
        "S10-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "整个人悬在半空 辨不清方向",
       "keys": [],
       "from": [
        "S10-B2-p1"
       ]
      },
      {
       "text": "不再是起初的茫然 而是经历许多仍没答案的疲惫",
       "keys": [],
       "from": [
        "S10-B3-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我想把回不回去留到以后，先把眼下的日子过稳；虽然仍怕遇事只能自己扛、心里没底，这次我不想因为害怕就收回这个打算。",
       "keys": [],
       "from": [
        "S11-3",
        "S11-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "柔软祈祷 变成向前的意志",
       "keys": [],
       "from": [
        "S11-B2-p2"
       ]
      },
      {
       "text": "害怕还在 脚却已经往前走了",
       "keys": [],
       "from": [
        "S11-B3-p1"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我明知回去未必找得回那份亲近，还是忍不住想也许能；可我不愿只凭这点指望，就回去继续过忍让的日子。",
       "keys": [],
       "from": [
        "S11-1",
        "S11-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "绝境中的困兽之斗 一次次顶住再用力",
       "keys": [],
       "from": [
        "S11-B1-p3"
       ],
       "emotion": "炽热"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起那些好时候，我还是会心软，也怕往后一个人熬；但我不再怪自己当初离开，也不愿只为有人陪就回头，愿带着想念继续过日子。",
       "keys": [],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "知道自己会犹疑疲惫想念 仍决定怎样站立",
       "keys": [],
       "from": [
        "S12-B1-p1"
       ]
      },
      {
       "text": "不必假装自己从未受过伤",
       "keys": [],
       "from": [
        "S12-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "我知道当初那些气确实不该忍，和他们在一起时也确实开心过，这些我都可以记着。",
       "keys": [],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我想把往后的日子好好过起来，不再整天和过去较劲；将来若有人愿意把我当自己人，我会好好珍惜，即使没有，我也愿意自己过好，不再为了留住谁而咽下委屈。",
       "keys": [],
       "from": [
        "S13-2",
        "S13-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体被一股劲推着往前跑 兴奋得来不及喘息",
       "keys": [],
       "from": [
        "S13-B2-p2"
       ],
       "emotion": "炽热"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前自然亲近的日子，我心里又热起来，也盼着以后还能有那样的相处。",
       "keys": [],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "柔软没有被力量压下去 也被带进高潮",
       "keys": [],
       "from": [
        "S13-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这股劲头缓下来，我想到以后还会孤单，也不知道何时才会再有人亲近，心里渐渐静了下来。",
       "keys": [],
       "from": [
        "S13-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚有的踏实 又被问真的牢固吗？",
       "keys": [],
       "from": [
        "S13-B3-p2"
       ],
       "emotion": "不安"
      },
      {
       "text": "平静了 疑问却不一定消失",
       "keys": [],
       "from": [
        "S13-B3-p4"
       ]
      }
     ]
    }
   ]
  }
 ]
}