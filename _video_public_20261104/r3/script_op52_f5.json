       "from": [
        "S11-B1-p1",
        "S11-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "原来心里还难过时，他也确实能有安稳的时候；两件事都是真的，不必互相作假。",
       "keys": [],
       "from": [
        "S11-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他试着把这些片段放在心里，不急着排出完整次序；有时觉得它们柔和了些，阴郁又会压回来。",
       "keys": [],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他不再把想念硬压下去，允许那份舍不得在心里多待一会儿，也愿意把它看成自己曾认真珍惜过的痕迹。",
       "keys": [],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "不再压住想念",
