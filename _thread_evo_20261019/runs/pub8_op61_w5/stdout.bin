otion\": \"悬着\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"刚有点安心，一个突如其来的念头却打断了我：以后再遇上难事，要还是只能一个人顶着，我真的撑得住吗？\",\n              \"from\": [\"S07-1\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"刺骨寒意\",\n              \"keys\": [],\n              \"from\": [\"S07-B1-p1\"]\n            },\n            {\n              \"text\": \"寒风猛地灌进来\",\n              \"keys\": [],\n              \"from\": [\"S07-B1-p2\"]\n            },\n            {\n              \"text\": \"一下从暖梦里惊醒\",\n              \"keys\": [],\n              \"from\": [\"S07-B1-p2\"]\n            },\n            {\n              \"text\": \"后颈一凉\",\n              \"keys\": [],\n              \"from\": [\"S07-B1-p3\"]\n            },\n            {\n              \"text\": \"脉搏剧烈跳动\",\n              \"keys\": [],\n              \"from\": [\"S07-B1-p3\"]\n            },\n            {\n              \"text\": \"整个人一下惊醒\",\n              \"keys\": [],\n              \"from\": [\"S07-B1-p4\"]\n            },\n            {\n              \"text\": \"安静忽然被打断\",\n              \"keys\": [],\n              \"from\": [\"S07-B2-p2\"]\n            },\n            {\n              \"text\": \"眼前像换了场景\",\n              \"keys\": [],\n              \"from\": [\"S07-B2-p2\"]\n            },\n            {\n              \"text\": \"心里还是没安定\",\n              \"keys\": [],\n              \"from\": [\"S07-B2-p4\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"当初走时，我只想着别再受那些气，没料到会这么孤单；早知道这样，我还会走吗？\",\n              \"from\": [\"S07-2\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"思绪不停翻转\",\n              \"keys\": [],\n              \"from\": [\"S07-B3-p1\"]\n            },\n            {\n              \"text\": \"想停也停不下来\",\n              \"keys\": [],\n              \"from\": [\"S07-B3-p1\"]\n            },\n            {\n              \"text\": \"心里还没觉得事情过去了\",\n              \"keys\": [],\n              \"from\": [\"S07-B3-p2\"]\n            },\n            {\n              \"text\": \"想冲出去\",\n              \"keys\": [],\n              \"from\": [\"S07-B3-p3\"]\n            },\n            {\n              \"text\": \"想逃开却不知往哪去\",\n              \"keys\": [],\n              \"from\": [\"S07-B3-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"我想找回从前那份亲近，又不甘心回去再受那些气。\",\n              \"from\": [\"S07-3\"],\n              \"keys\": []\n            },\n            {\n              \"text\": \"那些熟悉的动作和日常一浮现，我反而更清楚自己已经失去了什么。\",\n              \"from\": [\"S07-3\"],\n              \"keys\": []\n            },\n            {\n              \"text\": \"可连当初离开时那股决心，我也找不着了。\",\n              \"from\": [\"S07-3\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"熟悉的动作\",\n              \"keys\": [],\n              \"from\": [\"S07-B4-p1\"],\n              \"emotion\": \"亲密\"\n            },\n            {\n              \"text\": \"一次舞蹈\",\n              \"keys\": [],\n              \"from\": [\"S07-B4-p1\"],\n              \"emotion\": \"亲密\"\n            },\n            {\n              \"text\": \"从前每天的日子\",\n              \"keys\": [],\n              \"from\": [\"S07-B4-p1\"],\n              \"emotion\": \"亲密\"\n            },\n            {\n              \"text\": \"越熟悉越难受\",\n              \"keys\": [],\n              \"from\": [\"S07-B4-p3\"]\n            },\n            {\n              \"text\": \"才发现那些日子回不来了\",\n              \"keys\": [],\n              \"from\": [\"S07-B4-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"亲密\",\n          \"lines\": [\n            {\n              \"text\": \"我暂时把回不回去的事放到一边，想起从前那些亲近的时光，心里又暖和了一会儿。\",\n              \"from\": [\"S08-1\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"心里又软了下来\",\n              \"keys\": [],\n              \"from\": [\"S08-B1-p1\"]\n            },\n            {\n              \"text\": \"回头再看一眼\",\n              \"keys\": [],\n              \"from\": [\"S08-B2-p2\"],\n              \"emotion\": \"孤单\"\n            },\n            {\n              \"text\": \"那一眼里的温柔\",\n              \"keys\": [],\n              \"from\": [\"S08-B2-p3\"]\n            },\n            {\n              \"text\": \"那一眼里的不舍\",\n              \"keys\": [],\n              \"from\": [\"S08-B2-p3\"]\n            },\n            {\n              \"text\": \"终于能深吸一口气\",\n              \"keys\": [],\n              \"from\": [\"S08-B3-p1\"],\n              \"emotion\": \"安心\"\n            },\n            {\n              \"text\": \"短暂的喘息\",\n              \"keys\": [],\n              \"from\": [\"S08-B3-p2\"],\n              \"emotion\": \"安心\"\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"悬着\",\n          \"lines\": [\n            {\n              \"text\": \"可那点暖意很快就淡了，想到以后真遇上难事，回忆没法陪着我，心又悬了起来。\",\n              \"from\": [\"S08-2\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"暖意很快淡了\",\n              \"keys\": [],\n              \"from\": [\"S08-B4-p1\"]\n            },\n            {\n              \"text\": \"以后遇事还得自己扛\",\n              \"keys\": [],\n              \"from\": [\"S08-B4-p2\"]\n            },\n            {\n              \"text\": \"回忆不能替我撑住\",\n              \"keys\": [],\n              \"from\": [\"S08-B4-p2\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我忽然说不清，自己想回去究竟是舍不得以前的生活，还是只想在难受的时候有人陪着。\",\n              \"from\": [\"S09-1\"],\n              \"keys\": []\n            },\n            {\n              \"text\": \"这个念头让我一阵心慌，连往下想都不敢了。\",\n              \"from\": [\"S09-2\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"旧念头冷不丁冒出\",\n              \"keys\": [],\n              \"from\": [\"S09-B1-p1\"],\n              \"emotion\": \"孤单\"\n            },\n            {\n              \"text\": \"刚安心一点又乱了\",\n              \"keys\": [],\n              \"from\": [\"S09-B1-p2\"],\n              \"emotion\": \"悬着\"\n            },\n            {\n              \"text\": \"又想起当初那道选择\",\n              \"keys\": [],\n              \"from\": [\"S09-B1-p3\"],\n              \"emotion\": \"悬着\"\n            },\n            {\n              \"text\": \"又想起当初无措的自己\",\n              \"keys\": [],\n              \"from\": [\"S09-B2-p1\"],\n              \"emotion\": \"悬着\"\n            },\n            {\n              \"text\": \"当初的问题又回来了\",\n              \"keys\": [],\n              \"from\": [\"S09-B2-p2\"],\n              \"emotion\": \"悬着\"\n            },\n            {\n              \"text\": \"一想到回去就心慌\",\n              \"keys\": [],\n              \"from\": [\"S09-B3-p1\"]\n            },\n            {\n              \"text\": \"不敢再往下想\",\n              \"keys\": [],\n              \"from\": [\"S09-B3-p2\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我慢慢觉得自己最舍不得的，还是从前有人把我当作自己人的日子；可就算真的回去，还能像从前那样吗？\",\n              \"from\": [\"S10-1\"],\n              \"keys\": []\n            },\n            {\n              \"text\": \"何况当初那些让我难受的事也不能当作没发生过，光凭舍不得，我还是没法放心回去。\",\n              \"from\": [\"S10-2\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"熟悉的声音断续响起\",\n              \"keys\": [],\n              \"from\": [\"S10-B1-p2\"]\n            },\n            {\n              \"text\": \"几段零碎声音\",\n              \"keys\": [],\n              \"from\": [\"S10-B1-p2\"]\n            },\n            {\n              \"text\": \"摇篮曲只剩几声\",\n              \"keys\": [],\n              \"from\": [\"S10-B1-p4\"],\n              \"emotion\": \"孤单\"\n            },\n            {\n              \"text\": \"声音又响起却没连起来\",\n              \"keys\": [],\n              \"from\": [\"S10-B1-p5\"]\n            },\n            {\n              \"text\": \"旧委屈还记在心里\",\n              \"keys\": [],\n              \"from\": [\"S10-B5-p1\"]\n            },\n            {\n              \"text\": \"不敢只凭想念回头\",\n              \"keys\": [],\n              \"from\": [\"S10-B5-p1\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"悬着\",\n          \"lines\": [\n            {\n              \"text\": \"我翻来覆去想得很累，还是没个答案。\",\n              \"from\": [\"S10-3\"],\n              \"keys\": []\n            },\n            {\n              \"text\": \"连眼下的日子，我也过得不踏实。\",\n              \"from\": [\"S10-3\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"整个人悬在半空\",\n              \"keys\": [],\n              \"from\": [\"S10-B2-p1\"]\n            },\n            {\n              \"text\": \"不知道往哪走\",\n              \"keys\": [],\n              \"from\": [\"S10-B2-p1\"]\n            },\n            {\n              \"text\": \"声音一段段飘过\",\n              \"keys\": [],\n              \"from\": [\"S10-B2-p2\"]\n            },\n            {\n              \"text\": \"脚下像踩不着地\",\n              \"keys\": [],\n              \"from\": [\"S10-B2-p2\"]\n            },\n            {\n              \"text\": \"我以后该怎么过？\",\n              \"keys\": [],\n              \"from\": [\"S10-B3-p1\"]\n            },\n            {\n              \"text\": \"想了这么久还是没答案\",\n              \"keys\": [],\n              \"from\": [\"S10-B3-p2\"]\n            },\n            {\n              \"text\": \"累得不想再讲一遍\",\n              \"keys\": [],\n              \"from\": [\"S10-B4-p1\"],\n              \"emotion\": \"孤单\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"安心\",\n          \"lines\": [\n            {\n              \"text\": \"我想，回不回去可以以后再定，先试着把眼下的日子过稳些，兴许比急着回去踏实。\",\n              \"from\": [\"S11-3\"],\n              \"keys\": []\n            },\n            {\n              \"text\": \"我还是怕以后遇上难处只能自己扛，心里也没多少底，可这回不想因为害怕就把刚才的打算收回去。\",\n              \"from\": [\"S11-4\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"试探前方有没有路\",\n              \"keys\": [],\n              \"from\": [\"S11-B2-p1\"],\n              \"emotion\": \"悬着\"\n            },\n            {\n              \"text\": \"步伐一点点聚拢\",\n              \"keys\": [],\n              \"from\": [\"S11-B2-p1\"]\n            },\n            {\n              \"text\": \"把愿望变成往前走的劲\",\n              \"keys\": [],\n              \"from\": [\"S11-B2-p2\"],\n              \"emotion\": \"炽热\"\n            },\n            {\n              \"text\": \"害怕还在\",\n              \"keys\": [],\n              \"from\": [\"S11-B3-p1\"],\n              \"emotion\": \"不安\"\n            },\n            {\n              \"text\": \"脚已经往前走\",\n              \"keys\": [],\n              \"from\": [\"S11-B3-p1\"]\n            },\n            {\n              \"text\": \"终于不再原地不动\",\n              \"keys\": [],\n              \"from\": [\"S11-B3-p2\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"明知道回去未必找得回那份亲近，我却还是忍不住想：万一能呢？\",\n              \"from\": [\"S11-1\"],\n              \"keys\": []\n            },\n            {\n              \"text\": \"我再心动，也不愿只凭这点指望，就回去过从前那种忍让的日子。\",\n              \"from\": [\"S11-2\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"压力一阵阵涌来\",\n              \"keys\": [],\n              \"from\": [\"S11-B1-p1\"]\n            },\n            {\n              \"text\": \"重锤砸下\",\n              \"keys\": [],\n              \"from\": [\"S11-B1-p1\"],\n              \"emotion\": \"炽热\"\n            },\n            {\n              \"text\": \"被逼到角落还在挣扎\",\n              \"keys\": [],\n              \"from\": [\"S11-B1-p3\"],\n              \"emotion\": \"炽热\"\n            },\n            {\n              \"text\": \"一次次顶住再用力\",\n              \"keys\": [],\n              \"from\": [\"S11-B1-p3\"],\n              \"emotion\": \"炽热\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"安心\",\n          \"lines\": [\n            {\n              \"text\": \"想起那些好时候，我还是会心软，也怕往后一个人熬。\",\n              \"from\": [\"S12-2\"],\n              \"keys\": []\n            },\n            {\n              \"text\": \"可我不再怪自己当初离开，也不愿只为有人陪着就回头。\",\n              \"from\": [\"S12-2\"],\n              \"keys\": []\n            },\n            {\n              \"text\": \"我愿意带着想念继续过日子。\",\n              \"from\": [\"S1