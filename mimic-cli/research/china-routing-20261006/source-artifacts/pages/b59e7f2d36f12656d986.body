        <div id="r_7063234" class="cell">
        
        <table cellpadding="0" cellspacing="0" border="0" width="100%">
            <tr>
                <td width="48" valign="top" align="center"><img src="https://cdn.v2ex.com/avatar/ede3/df7d/45418_normal.png?m=1747794583" class="avatar" border="0" align="default" alt="letitbesqzr" data-uid="45418" /></td>
