 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "忽然很想靠近，心里发热；怕成负担，只敢露一点喜欢。",
       "keys": [
        "心里发热",
        "怕成负担"
       ],
       "from": [
        "S01-1",
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "一点亲近已让他觉得甜，下次敢坦白吗",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      },
      {
       "text": "刚踏上微晃的船板",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因他露出在意而退开，他才慢慢放松。",
       "keys": [
        "露出在意而退开",
        "慢慢放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩膀挨着肩膀，呼吸和体温都贴近",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "身体交给船底托举，水却一直在流",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想靠近，喜欢一度快藏不住，最后怕太急而收住。",
       "keys": [
        "喜欢一度快藏不住",
        "怕太急而收住"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "甜蜜里先冒出一点鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待得这么好，他却想到总会过去，还没分开就舍不得。",
       "keys": [
        "想到总会过去",
        "还没分开就舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不想以后，只想舒服地待在亲近里。",
       "keys": [
        "不想以后",
        "舒服地待在亲近里"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波托着身体，心慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "急着表达的念头，露头又沉下去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水下暗流拖住水波，倒影碎得难拼",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "想说喜欢，也想问对方是否一样；没想好，念头就淡了。",
       "keys": [
        "问对方是否一样",
        "念头就淡了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他欢喜；上回想说的话仍没出口。",
       "keys": [
        "熟悉的亲近",
        "仍没出口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "花腔像水面晃眼的光斑",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "这回他几乎想全说出来，盼对方喜欢坦白的自己。",
       "keys": [
        "想全说出来",
        "喜欢坦白的自己"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "越想抱紧，船身越颠簸",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "想把眼下的好留久些，却怕说太多弄丢自在，仍留些话。",
       "keys": [
        "把眼下的好留久些",
        "仍留些话"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波不停向前，像每秒都在倒数",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "前几次都收住，这回他没藏住；被看见后空落落，怕太黏。",
       "keys": [
        "前几次都收住",
        "空落落，怕太黏"
       ],
       "from": [
        "S05-1",
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "交谈戛然而止，心里闪过：这幸福真实吗",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "像终于松开手，深吸一口气",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他在乎，待他却没变，他才又自在。",
       "keys": [
        "待他却没变",
        "才又自在"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚说算了，又忍不住放不下",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "仍想靠近，怕要太多；对方不知他的孤单，会不会也舍不得？",
       "keys": [
        "怕要太多",
        "会不会也舍不得"
       ],
       "from": [
        "S06-2",
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "白天相处很好，独处时心头泛酸",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "气味、身体感觉、幻想和遗憾混在一起",
