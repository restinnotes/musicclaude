{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"尊严还在，行动的方向和力气却不稳\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"尊严还在，行动却没方向和力气\"\n        },\n        {\n          \"quote\": \"这是一种尚未找到对象、也尚未找到语言的失落\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"伸出颤抖的手去摸，摸到的却只有虚空\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开了熟悉的生活\",\n          \"point\": \"离开了熟悉的生活\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"起初觉得不用一次次受委屈\"\n        },\n        {\n          \"text\": \"可心里很快又空了\",\n          \"point\": \"说不清舍不得什么\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"明明是自己决定走\"\n        },\n        {\n          \"text\": \"他偶尔想起从前\",\n          \"point\": \"靠什么安心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还是想往前过\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"它不是士兵的步伐，更像腿脚虚浮的人，在记忆中挪动舞步。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"第一次还有几分相信，第二次开始努力让自己相信，说到第三次，连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是轻松恢复自信，而是负隅顽抗。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是恢复自信，只是在硬撑\"\n        }\n      ],\n      \"lines\": [\n       