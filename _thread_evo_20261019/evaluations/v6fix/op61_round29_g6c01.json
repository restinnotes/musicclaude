      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "那个老问题又回来了：我仍想有归属，可我不愿为了它看轻自己；这回它带着前面那些拉扯的分量，不再像最初那样陌生。",
      "key": "那个老问题又回来",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-4",
       "S06-2"
      ]
     },
     {
      "id": "S09-2",
      "text": "他刚觉得自己还能把这件事放在心里承受，随即又被一阵尖锐的不安攫住；惊惶很快退去，却没有留下答案。",
      "key": "他刚觉得自己还能",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S05-4",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S06-2",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S07-2",
      "to": "S09-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "216–225",
    "relation": "正在面对",
    "items": [
     {
      "id": "S10-1",
      "text": "那份熟悉的归属感又零零碎碎地浮出来，刚觉得亲近一点，便又散开，没法完整地留住。",
      "key": "那份熟悉的归属感",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-2",
       "S09-1"
      ]
     },
     {
      "id": "S10-2",
      "text": "他忽然觉得心里没了着落，连自己该怎样继续都说不清。",
      "key": "他忽然觉得心里没",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-1"
      ]
     },
     {
      "id": "S10-3",
      "text": "他明明还在意那份归属，也不想看轻自己，可此刻累得连一句能让自己信服的话都想不出来。",
      "key": "他明明还在意那份",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-1",
       "S02-2",
       "S10-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S08-2",
      "to": "S10-1",
      "rel": "引用"
     },
     {
