   "items": [
    {
     "id": "I1",
     "text": "他还说不清自己究竟在盼什么，只知道心里有了一个格外想亲近的人。",
     "key": "发现自己想亲近某人",
     "kind": "",
     "key_model": "格外想亲近的人"
    },
    {
     "id": "I2",
     "text": "想到那个人时，他会不由自主地柔软下来，却又本能地把这份感觉收回去。",
     "key": "想起对方便柔软又收回",
     "kind": "",
     "follows": true,
     "key_model": "柔软后又收回"
    },
    {
     "id": "I3",
     "text": "这份喜欢还轻得仿佛随时能放下，可他偏偏舍不得，自己也不明白为何谨慎。",
     "key": "喜欢很轻却舍不得放下",
     "kind": "",
     "follows": true,
     "key_model": "舍不得放下喜欢"
    }
   ],
   "because": [],
   "relation_votes": {
    "还说不清": 6
   },
   "relation_model": "还说不清"
  },
  {
   "bars": "4–16",
   "relation": "没在想",
   "items": [
    {
     "id": "I4",
     "text": "他决定先让这份在意自然发展，至于两个人会怎样，可以以后再想。",
     "key": "决定让在意自然发展",
     "kind": "",
     "follows": false,
     "key_model": "暂让在意自然发展"
    },
    {
     "id": "I5",
     "text": "他不把喜欢变成对对方的期待，慢慢就能安心地亲近那个人。",
     "key": "不因喜欢而期待对方",
     "kind": "",
     "follows": true,
     "key_model": "安心亲近那个人"
    },
    {
     "id": "I6",
     "text": "他发现温柔可以自由给予，不必时时确认对方有没有领会，也能保有从容。",
     "key": "自由给予温柔不求领会",
     "kind": "",
     "follows": true,
     "key_model": "自由给予温柔"
    },
    {
     "id": "I7",
     "text": "这种不追问、不计较的亲近带来快乐和安稳，他渐渐不再提防喜欢，也满意于自己的宽和。",
     "key": "不计较地亲近带来安稳",
     "kind": "",
     "follows": true,
     "key_model": "放下对喜欢的提防"
    },
    {
     "id": "I7b",
     "text": "他觉得若能一直这样自然地亲近，就已经足够了。",
     "key": "觉得自然亲近便已足够",
     "kind": "",
     "follows": true,
     "key_model": "觉得自然亲近足够"
    }
   ],
   "because": [
