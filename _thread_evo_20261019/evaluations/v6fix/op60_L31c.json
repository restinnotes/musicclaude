      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S14",
    "bars": "111–116",
    "relation": "正在面对",
    "items": [
     {
      "id": "S14-1",
      "text": "他终于把最初一直不敢认全的心意认了下来：这份亲密确实重要，他愿意珍惜，不再等一个长久的保证。",
      "key": "他终于把最初一直",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2",
       "S13-1",
       "S13-2"
      ]
     },
     {
      "id": "S14-2",
      "text": "心里的争执慢慢收束下来；他仍知道这份幸福未必留得住，却不再把这个可能当成眼前幸福的否定。",
      "key": "心里的争执慢慢收",
      "follows": false,
      "explains": [],
      "cite": [
       "S13-2",
       "S13-3"
      ]
     },
     {
      "id": "S14-3",
      "text": "那份熟悉的温暖又轻轻回来，带着一点酸楚和回望，最后留下安静的余温。",
      "key": "那份熟悉的温暖又",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S13-3",
       "S13-4"
      ]
     }
    ],
