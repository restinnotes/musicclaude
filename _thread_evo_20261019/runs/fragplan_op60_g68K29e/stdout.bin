\": 2,\n          \"order\": 2,\n          \"reason\": \"补出这种需要的原因：越喜欢相处，越觉得时间过得快。\"\n        },\n        {\n          \"from\": \"S13-1\",\n          \"part\": 3,\n          \"order\": 3,\n          \"reason\": \"保留对永远能否实现的疑问，不把期待写成确定结论。\"\n        },\n        {\n          \"from\": \"S13-2\",\n          \"part\": 2,\n          \"order\": 4,\n          \"reason\": \"恐惧进一步加深：如今更怕对方不再需要自己，连相处机会也消失。\"\n        },\n        {\n          \"from\": \"S13-3\",\n          \"part\": 1,\n          \"order\": 5,\n          \"reason\": \"与开头形成变化：已经无法再装作不在乎。\"\n        },\n        {\n          \"from\": \"S13-3\",\n          \"part\": 3,\n          \"order\": 6,\n          \"reason\": \"呈现最终的内在冲突：重新藏起喜欢反而会使自己更难受。\"\n        }\n      ],\n      \"small\": [\n        {\n          \"from\": \"S13-2\",\n          \"part\": 3,\n          \"after\": 3,\n          \"reason\": \"保留少透露心意是否能少受伤的自我试探，维持疑问而非结论。\"\n        },\n        {\n          \"from\": \"S13-3\",\n          \"part\": 2,\n          \"after\": 4,\n          \"reason\": \"补充刚才想对对方好的心意确实出自真心。\"\n        },\n        {\n          \"from\": \"S13-B1\",\n          \"part\": 3,\n          \"after\": 2,\n          \"reason\": \"保留害怕一停下、刚得到的东西就会消失的具体担忧。\"\n        },\n        {\n          \"from\": \"S13-B2\",\n          \"part\": 3,\n          \"after\": 2,\n          \"reason\": \"保留幸福仍在而悲伤进入幸福内部的并存关系。\"\n        },\n        {\n          \"from\": \"S13-B2\",\n          \"part\": 4,\n          \"after\": 2,\n          \"reason\": \"保留终于得到珍贵事物反而感到疼痛、无法永远留住当下的体验。\"\n        },\n        {\n          \"from\": \"S13-B3\",\n          \"part\": 1,\n          \"after\": 2,\n          \"reason\": \"保留刚坚定表达肯定之后，心里立即冒出苦涩反问的另一层声音。\"\n        },\n        {\n          \"from\": \"S13-B3\",\n          \"part\": 2,\n          \"after\": 2,\n          \"reason\": \"保留反问并不意味着此前的幸福是假的这一重要区别。\"\n        },\n        {\n          \"from\": \"S13-B4\",\n          \"part\": 2,\n          \"after\": 4,\n          \"reason\": \"保留站得稳却胸口一沉再沉、像叹息又像纠缠的身体体验。