{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"短句像叹息，刚冒出来就被长停顿截断\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"短句刚出口就被停顿截断\"\n        },\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"身体先于意识，隐约记起了该如何迈步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"身体先于意识，隐约记起迈步\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他已经离开那段熟悉的生活\",\n          \"point\": \"不用再一次次委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初还觉得\"\n        },\n        {\n          \"text\": \"可这份笃定没撑多久\",\n          \"point\": \"说不清到底舍不得什么\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没撑多久\"\n        },\n        {\n          \"text\": \"偶尔想起从前熟悉的日子\",\n          \"point\": \"不知道以后靠什么让自己安下心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"他还是想往前过，却\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"依稀记得，却只能模糊地哼几句\"\n        },\n        {\n          \"quote\": \"节奏本身庄严、傲慢，旋律却脆弱凄婉\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"节奏庄严、傲慢，旋律却脆弱凄婉\"\n        },\n        {\n          \"quote\": \"悲伤还在，只是不愿把自己完全交给悲伤\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"悲伤还在\"\n        }\n      ],\n      \"lines\": [\n        {\