        "还是不甘心",
        "好日子"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他心里还憋着一股气，可想起从前和人在一起、有人把他当作自己人，竟又高兴了一小会儿，心里却像有许多人低声絮语，彼此缠绕，找不到出口。",
       "keys": [
        "当作自己人",
        "高兴了一小会儿"
       ],
       "from": [
        "S03-1",
        "S03-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "若重击格外突出",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "那一下像重锤",
       "keys": [],
