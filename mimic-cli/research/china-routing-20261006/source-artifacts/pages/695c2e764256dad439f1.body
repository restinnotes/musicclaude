ired\":\"Please select at least one interest\"},\"company\":{\"required\":\"Company is required\"},\"jobTitle\":{\"required\":\"Job title is required\"},\"department\":{\"required\":\"Department is required\"},\"generic\":{\"required\":\"Required\"}},\"footer\":{\"copyright\":\"© 2024 Counterpoint Research. All rights reserved.\",\"privacyPolicy\":\"Privacy Policy\",\"termsOfService\":\"Terms of Service\",\"contactUs\":\"Contact Us\",\"nav\":{\"researchPortal\":\"RESEARCH PORTAL\",\"about\":\"ABOUT\",\"privacyPolicy\":\"PRIVACY POLICY\",\"termsOfUse\":\"TERMS OF USE\",\"joinUs\":\"JOIN US\"}},\"home\":{\"newsletter\":{\"title\":\"Receive our insightful weekly newsletter\",\"subtitle\":\"and stay ahead of the competition.\",\"placeholder\":\"Enter your email address\",\"subscribe\":\"Subscribe\"},\"ourOfferings\":\"Our offerings\",\"highlights\":\"Counterpoint Highlights\",\"mySubscription\":\"My Subscription\",\"history\":{\"title\":\"History\",\"tabs\":{\"view\":\"View\",\"download\":\"Download\"},\"empty\":{\"view\":\"No view history yet.\",\"download\":\"No download history yet.\"}},\"memberInterest\":{\"titleDesktop\":\"Explore more from your interest\",\"titleMobile\":\"Explore more\\nfrom your interest\"},\"premium\":{\"title\":\"Premium Data \u0026 insights\"},\"recentAnalysis\":\"Recent Analysis\\nby Coverage Area\",\"listenWatch\":\"Listen \u0026 Watch\",\"events\":\"Events\",\"clientTestimonials\":\"Client Testimonials\",\"goToYoutube\":\"go to Youtube Channel\",\"readMore\":\"Read more\",\"fastFacts\":{\"title\":\"Fast Facts about Counterpoint\",\"countriesTracked\":\"Countries tracked\",\"brandsTracked\":\"Brands tracked\",\"modelsTracked\":\"Models tracked\",\"clientsServed\":\"Clients served\"},\"guestContact\":{\"desktopTitle\":\"Register to access our comprehensive research\\nreports and industry insights\",\"mobileTitle\":\"Contact us to explore more of our service\",\"mobileSubtitle\":\"Our professional analysts are waiting for you\"},\"testimonials\":{\"title\":\"Client Testimonials\",\"items\":{\"apple\":{\"name\":\"Apple\",\"role\":\"Global Research Manager\",\"description\":\"The way you contextualize things is unique, informative and actionable. The team will be coming back for more.\"},\"samsung\":{\"name\":\"Samsung Electronics\",\"role\":\"Strategic Marketing Manager\",\"description\":\"The data and analysis provided by Counterpoint is unparalleled in terms of granularity and preciseness. We did not hesitate to choose Counterpoint after the initial briefings. The client support is also excellent, very approachable.\"},\"amazon\":{\"name\":\"Amazon\",\"role\":\"Marketing Director\",\"description\":\"Counterpoint's insight on the market is way more detailed. It's an eye-opener for us compared to other firms.\"},\"here\":{\"name\":\"HERE\",\"role\":\"Corporate Strategy Manager\",\"description\":\"Counterpoint's strengths are their clear and far-sighted insights into the market for connected devices and ecosystems. They actively ensure they maintain a detailed understanding of HERE's capability and strategy. This combination means their insights offer real value to our business and are widely appreciated across our business.\"},\"skTelecom\":{\"name\":\"SK Telecom\",\"role\":\"Corporate Strategy Manager\",\"description\":\"We reach out to Counterpoint whenever we hit a block in the road. Every time the team delivers the most up to date and accurate answers to our questions. We always feel we have a long term advisor and partner to trust in.\"}}}},\"forms\":{\"login\":{\"title\":\"Login\",\"email\":\"Email\",\"password\":\"Password\",\"emailPlaceholder\":\"Please enter your email\",\"passwordPlaceholder\":\"Please enter your password\",\"forgotPassword\":\"Forgot Password?\",\"loginButton\":\"Login\",\"goToRegister\":\"Go to Register\",\"registerDescription\":\"Register now and get access to a complimentary report while remaining up-to-date on our research\"},\"forgotPassword\":{\"title\":\"Forgot your pas