{"completed": true, "response": "<escape>{\n  \"phases\": [\n    {\n      \"label\": \"开始靠近\",\n      \"emotion\": \"亲密\",\n      \"sections\": [\"S01\", \"S02\"]\n    },\n    {\n      \"label\": \"想说又收住\",\n      \"emotion\": \"悬着\",\n      \"sections\": [\"S03\", \"S04\"]\n    },\n    {\n      \"label\": \"露出心意后发慌\",\n      \"emotion\": \"不安\",\n      \"sections\": [\"S05\", \"S06\"]\n    },\n    {\n      \"label\": \"慢慢相信彼此\",\n      \"emotion\": \"欢喜\",\n      \"sections\": [\"S07\", \"S08\"]\n    },\n    {\n      \"label\": \"担心未来又回到眼前\",\n      \"emotion\": \"悬着\",\n      \"sections\": [\"S09\", \"S10\"]\n    },\n    {\n      \"label\": \"不再藏起喜欢\",\n      \"emotion\": \"炽热\",\n      \"sections\": [\"S11\", \"S12\", \"S13\"]\n    },\n    {\n      \"label\": \"不再追问永远\",\n      \"emotion\": \"安心\",\n      \"sections\": [\"S14\"]\n    }\n  ],\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"炽热\",\n          \"lines\": [\n            {\n              \"text\": \"我忽然发现自己那么想靠近对方，心里一下热起来，连我自己也有点意外。\",\n              \"keys\": [],\n              \"from\": [\"S01-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"夏夜威尼斯上空的一束烟花\",\n              \"keys\": [],\n              \"from\": [\"S01-B1-p2\"]\n            },\n            {\n              \"text\": \"细碎的光点缓缓飘落\",\n              \"keys\": [],\n              \"from\": [\"S01-B1-p2\"]\n            },\n            {\n              \"text\": \"悬在水面上方\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S01-B1-p3\"]\n            },\n            {\n              \"text\": \"刚刚踏上船板\",\n              \"keys\": [],\n              \"from\": [\"S01-B2-p1\"]\n            },\n            {\n              \"text\": \"木板微晃\",\n              \"keys\": [],\n              \"from\": [\"S01-B2-p1\"]\n            },\n            {\n              \"text\": \"一瞬失重\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S01-B2-p1\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我怕对方看出我有多需要这份亲近，会觉得负担太重，所以只敢露出一点喜欢；这点亲近已经让我觉得很甜，可我还拿不准下次能不能更坦白。\",\n              \"keys\": [],\n              \"from\": [\"S01-2\", \"S01-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"话还没出口的沉默\",\n              \"keys\": [],\n              \"from\": [\"S01-B3-p1\"]\n            },\n            {\n              \"text\": \"有些话一旦说出口关系就会改变\",\n              \"keys\": [],\n              \"from\": [\"S01-B3-p2\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"亲密\",\n          \"lines\": [\n            {\n              \"text\": \"对方没有因为我露出在意就退开，仍愿意跟我亲近，我才渐渐放松下来。\",\n              \"keys\": [],\n              \"from\": [\"S02-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"贴近耳语\",\n              \"keys\": [],\n              \"from\": [\"S02-B1-p1\"]\n            },\n            {\n              \"text\": \"肩膀挨着肩膀\",\n              \"keys\": [],\n              \"from\": [\"S02-B1-p1\"]\n            },\n            {\n              \"text\": \"呼吸贴在一起\",\n              \"keys\": [],\n              \"from\": [\"S02-B1-p1\"]\n            },\n            {\n              \"text\": \"体温融在一处\",\n              \"keys\": [],\n              \"from\": [\"S02-B1-p1\"]\n            },\n            {\n              \"text\": \"不必拼命找话题\",\n              \"keys\": [],\n              \"from\": [\"S02-B1-p2\"]\n            },\n            {\n              \"text\": \"沉默也不让人紧张\",\n              \"keys\": [],\n              \"from\": [\"S02-B1-p3\"]\n            },\n            {\n              \"text\": \"夏末潮湿温热的风\",\n              \"keys\": [],\n              \"from\": [\"S02-B1-p4\"]\n            },\n            {\n              \"text\": \"黏稠地裹在皮肤上\",\n              \"keys\": [],\n              \"from\": [\"S02-B1-p4\"]\n            },\n            {\n              \"text\": \"一下一下的心跳\",\n              \"keys\": [],\n              \"from\": [\"S02-B2-p1\"]\n            },\n            {\n              \"text\": \"无止境的水浪\",\n              \"keys\": [],\n              \"from\": [\"S02-B2-p1\"]\n            },\n            {\n              \"text\": \"把身体交给船底温柔的托举\",\n              \"keys\": [],\n              \"from\": [\"S02-B2-p2\"]\n            },\n            {\n              \"text\": \"放弃对重力的控制\",\n              \"keys\": [],\n              \"from\": [\"S02-B2-p2\"]\n            },\n            {\n              \"text\": \"水一直在流\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S02-B2-p3\"]\n            },\n            {\n              \"text\": \"时间也一直在走\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S02-B2-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"炽热\",\n          \"lines\": [\n            {\n              \"text\": \"我也想顺势靠得更近，有一阵子喜欢得几乎藏不住，最后还是怕太急弄坏眼下的自在而收住了。\",\n              \"keys\": [],\n              \"from\": [\"S02-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"忍不住说得热切一些\",\n              \"keys\": [],\n              \"from\": [\"S02-B3-p1\"]\n            },\n            {\n              \"text\": \"呼吸都跟着改变\",\n              \"keys\": [],\n              \"from\": [\"S02-B3-p1\"]\n            },\n            {\n              \"text\": \"轻轻呼出一口气\",\n              \"keys\": [],\n              \"from\": [\"S02-B3-p2\"]\n            },\n            {\n              \"text\": \"没有把心事彻底说死\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S02-B3-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"两个人待在一起这么好，我却想到这样的时刻总会过去，还没分开就先有一点舍不得。\",\n              \"keys\": [],\n              \"from\": [\"S02-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"温柔的刺\",\n              \"keys\": [],\n              \"from\": [\"S02-B4-p1\"]\n            },\n            {\n              \"text\": \"甜蜜的确认\",\n              \"keys\": [],\n              \"emotion\": \"亲密\",\n              \"from\": [\"S02-B4-p2\"]\n            },\n            {\n              \"text\": \"无法排遣的惆怅\",\n              \"keys\": [],\n              \"from\": [\"S02-B4-p2\"]\n            },\n            {\n              \"text\": \"心里有一点鼻酸\",\n              \"keys\": [],\n              \"from\": [\"S02-B4-p2\"]\n            },\n            {\n              \"text\": \"还没失去就已经舍不得\",\n              \"keys\": [],\n              \"from\": [\"S02-B4-p3\"]\n            },\n            {\n              \"text\": \"希望这一刻慢一点过去\",\n              \"keys\": [],\n              \"from\": [\"S02-B4-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"安心\",\n          \"lines\": [\n            {\n              \"text\": \"我难得不去琢磨两个人往后会怎样，只想舒舒服服地待在这份亲近里。\",\n              \"keys\": [],\n              \"from\": [\"S03-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"水波般的摇曳\",\n              \"keys\": [],\n              \"from\": [\"S03-B1-p1\"]\n            },\n            {\n              \"text\": \"摇晃漂浮\",\n              \"keys\": [],\n              \"from\": [\"S03-B1-p1\"]\n            },\n            {\n              \"text\": \"暂时不去哪里\",\n              \"keys\": [],\n              \"from\": [\"S03-B1-p1\"]\n            },\n            {\n              \"text\": \"停留在那句重要的话里面\",\n              \"keys\": [],\n              \"from\": [\"S03-B1-p2\"]\n            },\n            {\n              \"text\": \"有一点陶醉\",\n              \"keys\": [],\n              \"from\": [\"S03-B1-p2\"]\n            },\n            {\n              \"text\": \"有一点走神\",\n              \"keys\": [],\n              \"from\": [\"S03-B1-p2\"]\n            },\n            {\n              \"text\": \"舒服的沉默\",\n              \"keys\": [],\n              \"from\": [\"S03-B1-p3\"]\n            },\n            {\n              \"text\": \"沉默并不尴尬\",\n              \"keys\": [],\n              \"from\": [\"S03-B1-p3\"]\n            },\n            {\n              \"text\": \"身体还在这里\",\n              \"keys\": [],\n              \"from\": [\"S03-B1-p4\"]\n            },\n            {\n              \"text\": \"心慢慢漂远\",\n              \"keys\": [],\n              \"emotion\": \"孤单\",\n              \"from\": [\"S03-B1-p4\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我忽然想告诉对方我多喜欢这样待着，也想问对方是不是一样，可还没想好怎么开口，这个念头就淡了。\",\n              \"keys\": [],\n              \"from\": [\"S03-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"急于表达的念头\",\n              \"keys\": [],\n              \"from\": [\"S03-B2-p2\"]\n            },\n            {\n              \"text\": \"很快又沉了回去\",\n              \"keys\": [],\n              \"from\": [\"S03-B2-p2\"]\n            },\n            {\n              \"text\": \"只在水面露了一下头\",\n              \"keys\": [],\n              \"from\": [\"S03-B2-p3\"]\n            },\n            {\n              \"text\": \"受了牵绊的水波\",\n              \"keys\": [],\n              \"from\": [\"S03-B3-p1\"]\n            },\n            {\n              \"text\": \"水下暗流\",\n              \"keys\": [],\n              \"from\": [\"S03-B3-p2\"]\n            },\n            {\n              \"text\": \"被挂在半途\",\n              \"keys\": [],\n              \"from\": [\"S03-B3-p2\"]\n            },\n            {\n              \"text\": \"风吹碎的倒影\",\n              \"keys\": [],\n              \"from\": [\"S03-B3-p3\"]\n            },\n            {\n              \"text\": \"粼粼闪烁\",\n              \"keys\": [],\n              \"from\": [\"S03-B3-p3\"]\n            },\n            {\n              \"text\": \"难以拼凑完整\",\n              \"keys\": [],\n              \"from\": [\"S03-B3-p3\"]\n            },\n            {\n              \"text\": \"无法解开的结\",\n              \"keys\": [],\n              \"from\": [\"S03-B3-p4\"]\n            },\n            {\n              \"text\": \"顺畅里生出的阻力\",\n              \"keys\": [],\n              \"from\": [\"S03-B3-p5\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"欢喜\",\n          \"lines\": [\n            {\n              \"text\": \"熟悉的亲近又让我满心欢喜，我想起上回明明想告诉对方却没有开口。\",\n              \"keys\": [],\n              \"from\": [\"S04-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"耳边低语\",\n              \"keys\": [],\n              \"from\": [\"S04-B1-p2\"]\n            },\n            {\n              \"text\": \"呼吸挨得很近\",\n              \"keys\": [],\n              \"from\": [\"S04-B1-p2\"]\n            },\n            {\n              \"text\": \"更迫切\",\n              \"keys\": [],\n              \"from\": [\"S04-B1-p3\"]\n            },\n            {\n              \"text\": \"水面折射的光斑\",\n              \"keys\": [],\n              \"from\": [\"S04-B1-p4\"]\n            },\n            {\n              \"text\": \"晃得睁不开眼\",\n              \"keys\": [],\n              \"from\": [\"S04-B1-p4\"]\n            },\n            {\n              \"text\": \"微笑着讲往事\",\n              \"keys\": [],\n              \"from\": [\"S04-B1-p5\"]\n            },\n            {\n              \"text\": \"讲着讲着语速变了\",\n              \"keys\": [],\n              \"from\": [\"S04-B1-p5\"]\n            },\n            {\n              \"text\": \"忍不住再说一遍\",\n              \"keys\": [],\n              \"from\": [\"S04-B1-p6\"]\n            },\n            {\n              \"text\": \"折回来补上更多细节\",\n              \"keys\": [],\n              \"from\": [\"S04-B1-p6\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"炽热\",\n          \"lines\": [\n            {\n              \"text\": \"我几乎想把藏着的话全说出来，盼着对方也喜欢我不再小心收着的样子。\",\n              \"keys\": [],\n              \"from\": [\"S04-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"夕阳在水面切出的最后一道金光\",\n              \"keys\": [],\n              \"from\": [\"S04-B2-p1\"]\n            },\n            {\n              \"text\": \"亮得几乎刺眼\",\n              \"keys\": [],\n              \"from\": [\"S04-B2-p1\"]\n            },\n            {\n              \"text\": \"最深的情意到了喉咙口\",\n              \"keys\": [],\n              \"from\": [\"S04-B2-p2\"]\n            },\n            {\n              \"text\": \"喉咙口颤抖\",\n              \"keys\": [],\n              \"from\": [\"S04-B2-p2\"]\n            },\n            {\n              \"text\": \"哽咽\",\n              \"keys\": [],\n              \"from\": [\"S04-B2-p2\"]\n            },\n            {\n              \"text\": \"情绪完整地打开\",\n              \"keys\": [],\n              \"from\": [\"S04-B2-p3\"]\n            },\n            {\n              \"text\": \"打开后又没有落定\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S04-B2-p3\"]\n            },\n            {\n              \"text\": \"吐露的话还在空气里回荡\",\n              \"keys\": [],\n              \"from\": [\"S04-B2-p4\"]\n            },\n            {\n              \"text\": \"人安静下来\",\n              \"keys\": [],\n              \"from\": [\"S04-B2-p4\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我甚至盼着说出来能把眼下的好留得久一点，可又怕一下说得太多让对方为难，连两个人原有的自在也弄丢，最后还是留了些话没说。\",\n              \"keys\": [],\n              \"from\": [\"S04-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"轻轻握着另一只手\",\n              \"keys\": [],\n              \"from\": [\"S04-B3-p1\"]\n            },\n            {\n              \"text\": \"不自觉地握得更紧\",\n              \"keys\": [],\n              \"from\": [\"S04-B3-p1\"]\n            },\n            {\n              \"text\": \"动作先透露出害怕\",\n              \"keys\": [],\n              \"from\": [\"S04-B3-p2\"]\n            },\n            {\n              \"text\": \"想用力抱紧对方\",\n              \"keys\": [],\n              \"from\": [\"S04-B3-p3\"]\n            },\n            {\n              \"text\": \"牢牢抓住当下\",\n              \"keys\": [],\n              \"from\": [\"S04-B3-p3\"]\n            },\n            {\n              \"text\": \"越用力越颠簸\",\n              \"keys\": [],\n              \"from\": [\"S04-B3-p4\"]\n            },\n            {\n              \"text\": \"平衡越来越脆弱\",\n              \"keys\": [],\n              \"from\": [\"S04-B3-p4\"]\n            },\n            {\n              \"text\": \"甜蜜得鼻子发酸\",\n              \"keys\": [],\n              \"emotion\": \"亲密\",\n              \"from\": [\"S04-B4-p1\"]\n            },\n            {\n              \"text\": \"每一秒都在倒数\",\n              \"keys\": [],\n              \"from\": [\"S04-B4-p2\"]\n            },\n            {\n              \"text\": \"还没有失去就已经舍不得\",\n              \"keys\": [],\n              \"emotion\": \"孤单\",\n              \"from\": [\"S04-B4-p3\"]\n            },\n            {\n              \"text\": \"想多留在这一刻\",\n              \"keys\": [],\n              \"from\": [\"S04-B4-p4\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"我原先还能装作没那么在乎，可如今对方看出了我的心意，我心里一下空落落的，连怎么跟对方待着都拿不准，也担心对方嫌我太黏。\",\n              \"keys\": [],\n              \"from\": [\"S05-2\", \"S05-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"水波忽然被抽掉\",\n              \"keys\": [],\n              \"from\": [\"S05-B2-p1\"]\n            },\n            {\n              \"text\": \"单薄孤零零\",\n              \"keys\": [],\n              \"from\": [\"S05-B2-p2\"]\n            },\n            {\n              \"text\": \"失去脚下的支撑\",\n              \"keys\": [],\n              \"from\": [\"S05-B2-p3\"]\n            },\n            {\n              \"text\": \"时间也松开了\",\n              \"keys\": [],\n              \"from\": [\"S05-B2-p3\"]\n            },\n            {\n              \"text\": \"起雾的水域\",\n              \"keys\": [],\n              \"from\": [\"S05-B2-p4\"]\n            },\n            {\n              \"text\": \"前路未卜\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S05-B2-p4\"]\n            },\n            {\n              \"text\": \"交谈戛然而止\",\n              \"keys\": [],\n              \"from\": [\"S05-B3-p1\"]\n            },\n            {\n              \"text\": \"从我与你的亲密中抽身\",\n              \"keys\": [],\n              \"from\": [\"S05-B3-p2\"]\n            },\n            {\n              \"text\": \"跌回自己的内心\",\n              \"keys\": [],\n              \"from\": [\"S05-B3-p2\"]\n            },\n            {\n              \"text\": \"这份幸福是真的吗？\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S05-B3-p3\"]\n            },\n            {\n              \"text\": \"它能维持多久？\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S05-B3-p4\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"安心\",\n          \"lines\": [\n            {\n              \"text\": \"前几次我想说又收住，对方却一直愿意跟我亲近，这回我不知不觉就忘了藏好喜欢，等察觉时，对方已经看出我有多在乎。\",\n              \"keys\": [],\n              \"from\": [\"S05-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"用力抱紧对方\",\n              \"keys\": [],\n              \"from\": [\"S05-B1-p1\"]\n            },\n            {\n              \"text\": \"松开了手\",\n              \"keys\": [],\n              \"from\": [\"S05-B1-p2\"]\n            },\n            {\n              \"text\": \"深吸一口气\",\n              \"keys\": [],\n              \"from\": [\"S05-B1-p2\"]\n            },\n            {\n              \"text\": \"攥紧不放的冲动轻轻退下去\",\n              \"keys\": [],\n              \"from\": [\"S05-B1-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"安心\",\n          \"lines\": [\n            {\n              \"text\": \"这回对方看出我有多在乎，跟我相处却一点没变，我才又能像从前那样自在地待着。\",\n              \"keys\": [],\n              \"from\": [\"S06-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"陌生的水域\",\n              \"keys\": [],\n              \"from\": [\"S06-B1-p1\"]\n            },\n            {\n              \"text\": \"熟悉的摇摆\",\n              \"keys\": [],\n              \"from\": [\"S06-B1-p2\"]\n            },\n            {\n              \"text\": \"细密的小纹\",\n              \"keys\": [],\n              \"from\": [\"S06-B1-p2\"]\n            },\n            {\n              \"text\": \"暖金色的水面\",\n              \"keys\": [],\n              \"from\": [\"S06-B1-p3\"]\n            },\n            {\n              \"text\": \"古桥阴影\",\n              \"keys\": [],\n              \"from\": [\"S06-B1-p3\"]\n            },\n            {\n              \"text\": \"空气一下凉了\",\n              \"keys\": [],\n              \"from\": [\"S06-B1-p3\"]\n            },\n            {\n              \"text\": \"清凉空灵的月光\",\n              \"keys\": [],\n              \"from\": [\"S06-B1-p5\"]\n            },\n            {\n              \"text\": \"童年\",\n              \"keys\": [],\n              \"from\": [\"S06-B1-p5\"]\n            },\n            {\n              \"text\": \"第一次心动的下午\",\n              \"keys\": [],\n              \"from\": [\"S06-B1-p5\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"安静下来以后，我想到对方根本不知道我刚才有多怕被嫌弃，忽然觉得有点孤单。\",\n              \"keys\": [],\n              \"from\": [\"S06-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"好不容易安静下来的念头又回来了\",\n              \"keys\": [],\n              \"from\": [\"S06-B2-p3\"]\n            },\n            {\n              \"text\": \"算了\",\n              \"keys\": [],\n              \"from\": [\"S06-B2-p3\"]\n            },\n            {\n              \"text\": \"但还是放不下\",\n              \"keys\": [],\n              \"from\": [\"S06-B2-p3\"]\n            },\n            {\n              \"text\": \"时而靠近时而退开\",\n              \"keys\": [],\n              \"from\": [\"S06-B2-p4\"]\n            },\n            {\n              \"text\": \"忘了自己正被别人看着\",\n              \"keys\": [],\n              \"from\": [\"S06-B2-p5\"]\n            },\n            {\n              \"text\": \"不再努力显得完整\",\n              \"keys\": [],\n              \"from\": [\"S06-B2-p5\"]\n            },\n            {\n              \"text\": \"独自退回内心深处\",\n              \"keys\": [],\n              \"from\": [\"S06-B3-p1\"]\n            },\n            {\n              \"text\": \"白天相处得很好，晚上回家却泛起酸楚\",\n              \"keys\": [],\n              \"from\": [\"S06-B3-p2\"]\n            },\n            {\n              \"text\": \"最亲密的人也没法走进心里的每一个角落\",\n              \"keys\": [],\n              \"from\": [\"S06-B3-p3\"]\n            },\n            {\n              \"text\": \"美好的时光恍惚间已经成了回忆\",\n              \"keys\": [],\n              \"from\": [\"S06-B3-p4\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"悬着\",\n          \"lines\": [\n            {\n              \"text\": \"我又忍不住想，对方既然一直没有退开，会不会也有一点舍不得结束这份亲近？\",\n              \"keys\": [],\n              \"from\": [\"S06-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"一层一层荡开的水波\",\n              \"keys\": [],\n              \"from\": [\"S06-B4-p2\"]\n            },\n            {\n              \"text\": \"气味\",\n              \"keys\": [],\n              \"from\": [\"S06-B4-p2\"]\n            },\n            {\n              \"text\": \"身体感觉\",\n              \"keys\": [],\n              \"from\": [\"S06-B4-p2\"]\n            },\n            {\n              \"text\": \"幻想\",\n              \"keys\": [],\n              \"from\": [\"S06-B4-p2\"]\n            },\n            {\n              \"text\": \"遗憾\",\n              \"keys\": [],\n              \"from\": [\"S06-B4-p2\"]\n            },\n            {\n              \"text\": \"快感混在一起\",\n              \"keys\": [],\n              \"emotion\": \"亲密\",\n              \"from\": [\"S06-B4-p2\"]\n            },\n            {\n              \"text\": \"越舒服越失去方向\",\n              \"keys\": [],\n              \"from\": [\"S06-B4-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"亲密\",\n          \"lines\": [\n            {\n              \"text\": \"我想起这些日子对方总愿意跟我待在一起，渐渐觉得对方也许有时需要我陪着，和我在一起也能安心些。\",\n              \"keys\": [],\n              \"from\": [\"S07-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"水底暗涌\",\n              \"keys\": [],\n              \"emotion\": \"不安\",\n              \"from\": [\"S07-B1-p1\"]\n            },\n            {\n              \"text\": \"沉重的脉搏\",\n              \"keys\": [],\n              \"emotion\": \"炽热\",\n              \"from\": [\"S07-B1-p1\"]\n            },\n            {\n              \"text\": \"安静享受已经不够\",\n              \"keys\": [],\n              \"from\": [\"S07-B1-p2\"]\n            },\n            {\n              \"text\": \"更深的渴望推着往前\",\n              \"keys\": [],\n              \"from\": [\"S07-B1-p2\"]\n            },\n            {\n              \"text\": \"情欲\",\n              \"keys\": [],\n              \"emotion\": \"炽热\",\n              \"from\": [\"S07-B1-p3\"]\n            },\n            {\n              \"text\": \"执念\",\n              \"keys\": [],\n              \"emotion\": \"不安\",\n              \"from\": [\"S07-B1-p3\"]\n            },\n            {\n              \"text\": \"对生的眷恋\",\n              \"keys\": [],\n              \"from\": [\"S07-B1-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"炽热\",\n          \"lines\": [\n            {\n              \"text\": \"这个念头让我高兴得有点收不住，越想着两个人这样亲近，我越舍不得从这份欢喜里抽身。\",\n              \"keys\": [],\n              \"from\": [\"S07-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"舍不得抽身的快感\",\n              \"keys\": [],\n              \"from\": [\"S07-B2-p1\"]\n            },\n            {\n              \"text\": \"情色性的暖意\",\n              \"keys\": [],\n              \"emotion\": \"亲密\",\n              \"from\": [\"S07-B2-p3\"]\n            },\n            {\n              \"text\": \"越舒服越失去方向\",\n              \"keys\": [],\n              \"from\": [\"S07-B2-p4\"]\n            },\n            {\n              \"text\": \"明知道正在被卷进去，却暂时不想出来\",\n              \"keys\": [],\n              \"from\": [\"S07-B2-p5\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"我真盼着往后对方想找人陪时还会想到我，我也能一直陪在对方身边。\",\n              \"keys\": [],\n              \"from\": [\"S07-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"听见时间正在经过\",\n              \"keys\": [],\n              \"from\": [\"S07-B3-p1\"]\n            },\n            {\n              \"text\": \"美好没有消失\",\n              \"keys\": [],\n              \"from\": [\"S07-B3-p2\"]\n            },\n            {\n              \"text\": \"这一刻纵然完美也没办法让它停住\",\n              \"keys\": [],\n              \"from\": [\"S07-B3-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"欢喜\",\n          \"lines\": [\n            {\n              \"text\": \"上回我无意间露了心意，这回见对方依然亲近，我想主动些，大大方方地回应，也开始盼着我们往后还能这样好很久。\",\n              \"keys\": [],\n              \"from\": [\"S08-1\", \"S08-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"直接舒展\",\n              \"keys\": [],\n              \"from\": [\"S08-B1-p1\"]\n            },\n            {\n              \"text\": \"没有防卫\",\n              \"keys\": [],\n              \"from\": [\"S08-B1-p2\"]\n            },\n            {\n              \"text\": \"没有分析\",\n              \"keys\": [],\n              \"from\": [\"S08-B1-p2\"]\n            },\n            {\n              \"text\": \"情绪一再抬高\",\n              \"keys\": [],\n              \"from\": [\"S08-B1-p3\"]\n            },\n            {\n              \"text\": \"轻轻催促\",\n              \"keys\": [],\n              \"from\": [\"S08-B1-p3\"]\n            },\n            {\n              \"text\": \"阳光和风\",\n              \"keys\": [],\n              \"from\": [\"S08-B2-p1\"]\n            },\n            {\n              \"text\": \"身体恢复弹性\",\n              \"keys\": [],\n              \"from\": [\"S08-B2-p2\"]\n            },\n            {\n              \"text\": \"一点玩心\",\n              \"keys\": [],\n              \"from\": [\"S08-B2-p2\"]\n            },\n            {\n              \"text\": \"轻快的调情与回应\",\n              \"keys\": [],\n              \"from\": [\"S08-B2-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"悬着\",\n          \"lines\": [\n            {\n              \"text\": \"可我又想到，今天这样好不代表以后每天都能这样，心里顿时有点没底。\",\n              \"keys\": [],\n              \"from\": [\"S08-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"向上散开蒸发\",\n              \"keys\": [],\n              \"from\": [\"S08-B3-p1\"]\n            },\n            {\n              \"text\": \"戛然而止\",\n              \"keys\": [],\n              \"from\": [\"S08-B3-p2\"]\n            },\n            {\n              \"text\": \"快乐的余温\",\n              \"keys\": [],\n              \"from\": [\"S08-B3-p3\"]\n            },\n            {\n              \"text\": \"一阵怀念\",\n              \"keys\": [],\n              \"emotion\": \"孤单\",\n              \"from\": [\"S08-B3-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"我越来越具体地害怕对方有一天不再需要我陪伴，甚至不愿再和我待在一起；想到这里，我一下安静下来，不敢再往下想。\",\n              \"keys\": [],\n              \"from\": [\"S09-1\", \"S09-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"突然收住脚步\",\n              \"keys\": [],\n              \"from\": [\"S09-B1-p1\"]\n            },\n            {\n              \"text\": \"话说到要紧处一下顿住\",\n              \"keys\": [],\n              \"from\": [\"S09-B1-p2\"]\n            },\n            {\n              \"text\": \"悬在半空\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S09-B1-p3\"]\n            },\n            {\n              \"text\": \"对视到呼吸都停了\",\n              \"keys\": [],\n              \"from\": [\"S09-B1-p4\"]\n            },\n            {\n              \"text\": \"强烈的渴望还在，却引而不发\",\n              \"keys\": [],\n              \"from\": [\"S09-B1-p4\"]\n            },\n            {\n              \"text\": \"绷紧的劲还没有松开\",\n              \"keys\": [],\n              \"from\": [\"S09-B1-p4\"]\n            },\n            {\n              \"text\": \"低气压\",\n              \"keys\": [],\n              \"from\": [\"S09-B2-p1\"]\n            },\n            {\n              \"text\": \"明朗被一层层收走\",\n              \"keys\": [],\n              \"from\": [\"S09-B2-p1\"]\n            },\n            {\n              \"text\": \"一层层下沉变暗\",\n              \"keys\": [],\n              \"from\": [\"S09-B2-p1\"]\n            },\n            {\n              \"text\": \"阳光被薄雾柔化\",\n              \"keys\": [],\n              \"from\": [\"S09-B2-p2\"]\n            },\n            {\n              \"text\": \"光还在，只是隔着一层雾\",\n              \"keys\": [],\n              \"from\": [\"S09-B2-p2\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"欢喜\",\n          \"lines\": [\n            {\n              \"text\": \"我想起对方一直没有退开，眼下两个人还这么亲近，这是真的；也许对方也喜欢有我陪着，想到这儿我还是有点高兴。\",\n              \"keys\": [],\n              \"from\": [\"S09-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"听自己刚才说过的话\",\n              \"keys\": [],\n              \"from\": [\"S09-B3-p1\"]\n            },\n            {\n              \"text\": \"不急着接下一句\",\n              \"keys\": [],\n              \"from\": [\"S09-B3-p2\"]\n            },\n            {\n              \"text\": \"刚才那是真的吗？\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S09-B3-p3\"]\n            },\n            {\n              \"text\": \"接下来怎么办？\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S09-B3-p4\"]\n            },\n            {\n              \"text\": \"夜空\",\n              \"keys\": [],\n              \"from\": [\"S09-B4-p1\"]\n            },\n            {\n              \"text\": \"眼前的美好比自己的愿望大得多\",\n              \"keys\": [],\n              \"from\": [\"S09-B4-p1\"]\n            },\n            {\n              \"text\": \"不安暂时不再占据全部心思\",\n              \"keys\": [],\n              \"from\": [\"S09-B4-p2\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"安心\",\n          \"lines\": [\n            {\n              \"text\": \"我想着，再猜下去连今天也过不踏实，便暂时不管以后怎样，先好好享受眼前的亲近；紧绷慢慢松下去，我心里亮堂得几乎想笑，也有点想哭。\",\n              \"keys\": [],\n              \"from\": [\"S10-1\", \"S10-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"长长呼出一口气\",\n              \"keys\": [],\n              \"from\": [\"S10-B1-p1\"]\n            },\n            {\n              \"text\": \"胸腔一下打开\",\n              \"keys\": [],\n              \"from\": [\"S10-B1-p1\"]\n            },\n            {\n              \"text\": \"压着没说的话有了舒展的空间\",\n              \"keys\": [],\n              \"from\": [\"S10-B1-p2\"]\n            },\n            {\n              \"text\": \"眼泪也不必再忍\",\n              \"keys\": [],\n              \"from\": [\"S10-B1-p2\"]\n            },\n            {\n              \"text\": \"心事并没有解决\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S10-B1-p3\"]\n            },\n            {\n              \"text\": \"不必再强迫自己控制感受\",\n              \"keys\": [],\n              \"from\": [\"S10-B1-p3\"]\n            },\n            {\n              \"text\": \"明亮得让人想哭\",\n              \"keys\": [],\n              \"from\": [\"S10-B1-p4\"]\n            },\n            {\n              \"text\": \"突然吹进来的清风\",\n              \"keys\": [],\n              \"from\": [\"S10-B2-p1\"]\n            },\n            {\n              \"text\": \"时间也松了\",\n              \"keys\": [],\n              \"from\": [\"S10-B2-p2\"]\n            },\n            {\n              \"text\": \"开出一小块空地\",\n              \"keys\": [],\n              \"from\": [\"S10-B2-p2\"]\n            },\n            {\n              \"text\": \"终于呼出的气\",\n              \"keys\": [],\n              \"from\": [\"S10-B2-p3\"]\n            },\n            {\n              \"text\": \"不是能永远躲进去的避风处\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S10-B2-p3\"]\n            },\n            {\n              \"text\": \"身体失去重量\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S10-B3-p2\"]\n            },\n            {\n              \"text\": \"灵魂从躯壳里飘出来\",\n              \"keys\": [],\n              \"from\": [\"S10-B3-p2\"]\n            },\n            {\n              \"text\": \"夏夜微风\",\n              \"keys\": [],\n              \"from\": [\"S10-B3-p2\"]\n            },\n            {\n              \"text\": \"沉重负担碰不到飘起来的自己\",\n              \"keys\": [],\n              \"from\": [\"S10-B3-p3\"]\n            },\n            {\n              \"text\": \"晨曦里的银色蛛丝\",\n              \"keys\": [],\n              \"from\": [\"S10-B4-p1\"]\n            },\n            {\n              \"text\": \"从天上飘下的细雨\",\n              \"keys\": [],\n              \"from\": [\"S10-B4-p1\"]\n            },\n            {\n              \"text\": \"飞瀑从极高处倾泻而下\",\n              \"keys\": [],\n              \"from\": [\"S10-B4-p2\"]\n            },\n            {\n              \"text\": \"清亮地落进水里\",\n              \"keys\": [],\n              \"from\": [\"S10-B4-p2\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"炽热\",\n          \"lines\": [\n            {\n              \"text\": \"等那阵轻松过去，我忽然想，就算往后对方有时不需要我陪着，我也愿意一直陪在对方身边，不再把喜欢藏起来；想到这里，我高兴得连害臊都顾不上了。\",\n              \"keys\": [],\n              \"from\": [\"S11-1\", \"S11-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"异常直接\",\n              \"keys\": [],\n              \"from\": [\"S11-B1-p1\"]\n            },\n            {\n              \"text\": \"异常现实\",\n              \"keys\": [],\n              \"from\": [\"S11-B1-p1\"]\n            },\n            {\n              \"text\": \"谨慎终于不见了\",\n              \"keys\": [],\n              \"from\": [\"S11-B1-p2\"]\n            },\n            {\n              \"text\": \"惊涛骇浪\",\n              \"keys\": [],\n              \"from\": [\"S11-B1-p2\"]\n            },\n            {\n              \"text\": \"这是我的感情，我不再为它道歉\",\n              \"keys\": [],\n              \"from\": [\"S11-B1-p3\"]\n            },\n            {\n              \"text\": \"多年后重新走进旧房子\",\n              \"keys\": [],\n              \"from\": [\"S11-B2-p1\"]\n            },\n            {\n              \"text\": \"家具可能没变\",\n              \"keys\": [],\n              \"from\": [\"S11-B2-p2\"]\n            },\n            {\n              \"text\": \"知道的事情已经太多\",\n              \"keys\": [],\n              \"from\": [\"S11-B2-p2\"]\n            },\n            {\n              \"text\": \"温柔有了新的重量\",\n              \"keys\": [],\n              \"from\": [\"S11-B2-p3\"]\n            },\n            {\n              \"text\": \"知道它珍贵以后更容易发疼\",\n              \"keys\": [],\n              \"emotion\": \"孤单\",\n              \"from\": [\"S11-B2-p4\"]\n            },\n            {\n              \"text\": \"铺开的力量悬在半空\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S11-B3-p1\"]\n            },\n            {\n              \"text\": \"等待下一股更大的浪潮\",\n              \"keys\": [],\n              \"from\": [\"S11-B3-p1\"]\n            },\n            {\n              \"text\": \"差一点抵达\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S11-B3-p2\"]\n            },\n            {\n              \"text\": \"期待终于得到满足\",\n              \"keys\": [],\n              \"from\": [\"S11-B3-p2\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"可我愿意一直陪着，对方以后愿不愿意却不是我能说了算的；一想到这里，刚才的欢喜就压得我心口发疼。\",\n              \"keys\": [],\n              \"from\": [\"S11-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"血红金亮的天空\",\n              \"keys\": [],\n              \"emotion\": \"炽热\",\n              \"from\": [\"S11-B4-p2\"]\n            },\n            {\n              \"text\": \"光芒刺眼到让人想流泪\",\n              \"keys\": [],\n              \"from\": [\"S11-B4-p2\"]\n            },\n            {\n              \"text\": \"胸口被压迫得发痛\",\n              \"keys\": [],\n              \"from\": [\"S11-B4-p3\"]\n            },\n            {\n              \"text\": \"喜悦浓烈到身体几乎承受不住\",\n              \"keys\": [],\n              \"emotion\": \"炽热\",\n              \"from\": [\"S11-B4-p4\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"炽热\",\n          \"lines\": [\n            {\n              \"text\": \"我这会儿只想把能给的都给对方，连对方会不会同样在乎我也顾不上想。\",\n              \"keys\": [],\n              \"from\": [\"S12-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"明亮开阔\",\n              \"keys\": [],\n              \"from\": [\"S12-B1-p1\"]\n            },\n            {\n              \"text\": \"一浪高过一浪\",\n              \"keys\": [],\n              \"from\": [\"S12-B1-p1\"]\n            },\n            {\n              \"text\": \"私语放大成天地的共振\",\n              \"keys\": [],\n              \"from\": [\"S12-B1-p2\"]\n            },\n            {\n              \"text\": \"被卷进比自己更大的世界\",\n              \"keys\": [],\n              \"from\": [\"S12-B1-p3\"]\n            },\n            {\n              \"text\": \"连我都暂时退到后面\",\n              \"keys\": [],\n              \"from\": [\"S12-B1-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"可我明知再用心也没法保证以后还这么好，还是嫌这样的日子不够，想多陪对方一会儿。\",\n              \"keys\": [],\n              \"from\": [\"S12-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"近乎恳求的力量\",\n              \"keys\": [],\n              \"from\": [\"S12-B2-p2\"]\n            },\n            {\n              \"text\": \"一次次向上伸展\",\n              \"keys\": [],\n              \"from\": [\"S12-B2-p2\"]\n            },\n            {\n              \"text\": \"还想要更多\",\n              \"keys\": [],\n              \"from\": [\"S12-B2-p2\"]\n            },\n            {\n              \"text\": \"始终不能完全满足\",\n              \"keys\": [],\n              \"from\": [\"S12-B2-p2\"]\n            },\n            {\n              \"text\": \"牵扯\",\n              \"keys\": [],\n              \"from\": [\"S12-B2-p3\"]\n            },\n            {\n              \"text\": \"延迟\",\n              \"keys\": [],\n              \"from\": [\"S12-B2-p3\"]\n            },\n            {\n              \"text\": \"紧张\",\n              \"keys\": [],\n              \"from\": [\"S12-B2-p3\"]\n            },\n            {\n              \"text\": \"悬着的一口气\",\n              \"keys\": [],\n              \"emotion\": \"悬着\",\n              \"from\": [\"S12-B2-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"炽热\",\n          \"lines\": [\n            {\n              \"text\": \"那一阵高兴终于整个涌了出来，我不再强迫自己收着，只顾痛痛快快地喜欢对方。\",\n              \"keys\": [],\n              \"from\": [\"S12-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"高烧\",\n              \"keys\": [],\n              \"from\": [\"S12-B3-p1\"]\n            },\n            {\n              \"text\": \"久别重逢\",\n              \"keys\": [],\n              \"from\": [\"S12-B3-p2\"]\n            },\n            {\n              \"text\": \"久久不愿松手\",\n              \"keys\": [],\n              \"from\": [\"S12-B3-p2\"]\n            },\n            {\n              \"text\": \"喉咙发紧\",\n              \"keys\": [],\n              \"from\": [\"S12-B3-p3\"]\n            },\n            {\n              \"text\": \"眼眶湿润\",\n              \"keys\": [],\n              \"from\": [\"S12-B3-p3\"]\n            },\n            {\n              \"text\": \"想笑还是想哭都分不清\",\n              \"keys\": [],\n              \"from\": [\"S12-B3-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"不安\",\n          \"lines\": [\n            {\n              \"text\": \"那阵高兴过后，我又贪心起来，特别想听到一句以后也不会变的准话，可我心里明白谁也没法答应永远。\",\n              \"keys\": [],\n              \"from\": [\"S13-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"长久悬着的心愿终于说出口\",\n              \"keys\": [],\n              \"from\": [\"S13-B1-p1\"]\n            },\n            {\n              \"text\": \"怕一停下刚刚得到的东西就会消失\",\n              \"keys\": [],\n              \"from\": [\"S13-B1-p2\"]\n            },\n            {\n              \"text\": \"更大的浪推上来\",\n              \"keys\": [],\n              \"from\": [\"S13-B1-p3\"]\n            },\n            {\n              \"text\": \"刚刚最坚定地说了一声是\",\n              \"keys\": [],\n              \"from\": [\"S13-B2-p1\"]\n            },\n            {\n              \"text\": \"可是呢？\",\n              \"keys\": [],\n              \"from\": [\"S13-B2-p1\"]\n            },\n            {\n              \"text\": \"幸福不是假的\",\n              \"keys\": [],\n              \"from\": [\"S13-B2-p2\"]\n            },\n            {\n              \"text\": \"真正相信过，怀疑才会这么疼\",\n              \"keys\": [],\n              \"from\": [\"S13-B2-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"我想到对方有一天也许不再需要我，甚至不再愿意和我亲近，便想把露出的喜欢藏回一点，好让以后少疼些；可我已经没法装作不在乎，真要往回藏，反而更难受。\",\n              \"keys\": [],\n              \"from\": [\"S13-2\", \"S13-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"坚持确认刚才的灿烂\",\n              \"keys\": [],\n              \"from\": [\"S13-B3-p1\"]\n            },\n            {\n              \"text\": \"明亮里掺进尖锐暗沉\",\n              \"keys\": [],\n              \"emotion\": \"不安\",\n              \"from\": [\"S13-B3-p2\"]\n            },\n            {\n              \"text\": \"幸福没有消失，悲伤却进入幸福内部\",\n              \"keys\": [],\n              \"from\": [\"S13-B3-p3\"]\n            },\n            {\n              \"text\": \"终于握住珍贵的东西\",\n              \"keys\": [],\n              \"from\": [\"S13-B3-p4\"]\n            },\n            {\n              \"text\": \"这么好的一刻终究无法永远留住\",\n              \"keys\": [],\n              \"from\": [\"S13-B3-p4\"]\n            },\n            {\n              \"text\": \"脚步牢牢踩住地面\",\n              \"keys\": [],\n              \"from\": [\"S13-B4-p1\"]\n            },\n            {\n              \"text\": \"上方的声音一次次往下落\",\n              \"keys\": [],\n              \"from\": [\"S13-B4-p2\"]\n            },\n            {\n              \"text\": \"像叹息\",\n              \"keys\": [],\n              \"from\": [\"S13-B4-p2\"]\n            },\n            {\n              \"text\": \"胸口一沉再沉\",\n              \"keys\": [],\n              \"from\": [\"S13-B4-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"kind\": \"\",\n          \"emotion\": \"安心\",\n          \"lines\": [\n            {\n              \"text\": \"我仍会舍不得，也仍不知道以后会怎样，但眼下还能这样亲近，我不再逼自己非要得到一句永远不变的保证。\",\n              \"keys\": [],\n              \"from\": [\"S14-2\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"没有像梦一样慢慢飘走\",\n              \"keys\": [],\n              \"from\": [\"S14-B2-p1\"]\n            },\n            {\n              \"text\": \"铁锚落入水底\",\n              \"keys\": [],\n              \"from\": [\"S14-B2-p2\"]\n            },\n            {\n              \"text\": \"站起来，整理衣服，关上门\",\n              \"keys\": [],\n              \"from\": [\"S14-B2-p3\"]\n            },\n            {\n              \"text\": \"最后一股浪头猛推了一下\",\n              \"keys\": [],\n              \"from\": [\"S14-B3-p1\"]\n            },\n            {\n              \"text\": \"终于松下来，轻下来\",\n              \"keys\": [],\n              \"from\": [\"S14-B3-p2\"]\n            },\n            {\n              \"text\": \"心里仍然温热\",\n              \"keys\": [],\n              \"from\": [\"S14-B3-p3\"]\n            },\n            {\n              \"text\": \"身体慢慢恢复平静\",\n              \"keys\": [],\n              \"from\": [\"S14-B3-p3\"]\n            },\n            {\n              \"text\": \"从美梦里醒来，还记得梦里的光\",\n              \"keys\": [],\n              \"from\": [\"S14-B3-p4\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"亲密\",\n          \"lines\": [\n            {\n              \"text\": \"我想起起初连多露一点喜欢都紧张的自己，再想想一路走到现在，心里软下来，也有些发酸。\",\n              \"keys\": [],\n              \"from\": [\"S14-1\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"独自沉思\",\n              \"keys\": [],\n              \"from\": [\"S14-B1-p1\"]\n            },\n            {\n              \"text\": \"熟悉的温柔又回来\",\n              \"keys\": [],\n              \"from\": [\"S14-B1-p2\"]\n            },\n            {\n              \"text\": \"夜空里的水花\",\n              \"keys\": [],\n              \"from\": [\"S14-B1-p3\"]\n            },\n            {\n              \"text\": \"低低的一声回望\",\n              \"keys\": [],\n              \"from\": [\"S14-B1-p3\"]\n            },\n            {\n              \"text\": \"最后一闪\",\n              \"keys\": [],\n              \"from\": [\"S14-B1-p3\"]\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"kind\": \"\",\n          \"emotion\": \"安心\",\n          \"lines\": [\n            {\n              \"text\": \"既然喜欢已经让对方看见，我就不再往回藏；以后会怎样，等真的到了那时再说。\",\n              \"keys\": [],\n              \"from\": [\"S14-3\"]\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"隔着很远应了一声\",\n              \"keys\": [],\n              \"from\": [\"S14-B4-p2\"]\n            },\n            {\n              \"text\": \"接住开头悬着的话\",\n              \"keys\": [],\n              \"from\": [\"S14-B4-p3\"]\n            },\n            {\n              \"text\": \"终于把它说完\",\n              \"keys\": [],\n              \"from\": [\"S14-B4-p3\"]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "758e1f3e-565b-4d05-a628-df054d577ffb", "session_revision": 0, "session_ttl_max_hours": 6, "job_directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt3\\pro-bridge-20261105T023145865308Z", "elapsed_seconds": 337.859, "completed_utc": "2026-11-05T02:37:23.727682+00:00", "model": "gpt-6-thinking", "thinking_effort": "max", "temporary": true, "unpersonalized": true, "generation_policy_verified": true, "request_policy": {"model": "gpt-6-thinking", "thinking_effort": "max", "history_and_training_disabled": true, "temporary_chat_requests_personalization": false, "is_do_not_remember": false, "continuation": false, "unpersonalized_inherited_verified": false, "body_sha256": "4ea28d77c125c57894bdff2b405331d3b0e7eb832cd18621bd66372327b49c81", "attachment_count": 1}, "stream_completion": {"sse_done": true, "message_completed": true, "independent_terminal_verified": true}, "profile": "yi/local-codex-auth", "account_sha256": "b3efb6361563c139233ed7b7ef61a7c9afe0bd48d4eb3525dbe31956b024d6da", "transport": "probridge-pure-http", "resume_requests": 0, "topic_connections": 0, "browser_started": false, "Docker_used": false, "automatic_retry": false, "initializer_pss_limit_mib": "not_applicable_no_browser", "attachment_count": 1, "code_sha256": {"tools\\chatgpt_web\\gpt3_cli.py": "96a4cdb6cd5d982f4d1de5b6ba8fae0cf23ee44a