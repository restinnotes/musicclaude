       "from": [
        "S08-B1",
        "S08-B2"
       ],
       "bars": "62-70",
       "at": 15.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "那份轻快带着一点玩心，让他重新感到轻松",
     "keys": [
      "让他重新感到轻松"
     ],
     "emotion": "欢喜",
     "from": [
      "S08-2"
     ],
     "at": 4.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "甚至带一点玩心，像轻快的调情与回应",
