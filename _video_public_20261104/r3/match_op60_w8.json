   "lost": ""
  },
  {
   "id": "S02-0-3",
   "a": "对上",
   "b": "偏了",
   "lost": "乙只说了呼吸和体温的亲密接触，遗漏潮湿、温热的微风裹在皮肤上的黏稠触感。"
  },
  {
   "id": "S02-1-0",
   "a": "对上",
   "b": "对上",
   "lost": ""
  },
  {
   "id": "S02-1-1",
   "a": "偏了",
   "b": "偏了",
   "lost": "原稿是轻轻呼出一口气、重新回到柔和，不是如释重负地松了一口气。"
