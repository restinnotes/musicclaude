       "from": [
        "S13-B3"
       ],
       "bars": "103–110",
       "at": 25.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "可他早已装不出不在乎，真往回藏反倒更难受",
     "keys": [
      "反倒更难受"
     ],
     "emotion": "炽热",
     "from": [
      "S13-3"
     ],
     "at": 31.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "下方像牢牢踩住地面，上方一次次落下，胸口一沉再沉",
