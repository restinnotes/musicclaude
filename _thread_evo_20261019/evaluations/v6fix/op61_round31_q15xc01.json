    ]
   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "刚才短暂的安宁很快淡下去，离开后的沉重和不确定又回到心头。",
      "key": "刚才短暂的安宁很",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-3"
      ]
     },
     {
      "id": "S09-2",
      "text": "他再次碰到那个熟悉的问题：若早知道失落会持续这么久，自己是否仍会离开；这次问题带着已经独自承担过的分量，却仍没有答案。",
      "key": "他再次碰到那个熟",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S06-1",
       "S09-1"
      ]
     },
     {
      "id": "S09-3",
      "text": "一阵尖锐的不安突然冒出来，很快又退回原先的低落和悬而未决。",
      "key": "一阵尖锐的不安突",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-1",
       "S09-2"
      ]
     }
    ],
