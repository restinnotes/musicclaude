{"lines": [{"id": "S01-1", "t": 17.38, "d": 6.88, "rows": [[["他已经离开那段熟悉的生活，", null]], [["起初还觉得自己", null], ["总算不用再一再委屈自己了", "blue"], ["。", null]]], "text": "他已经离开那段熟悉的生活，起初还觉得自己总算不用再一再委屈自己了。", "hue": "blue"}, {"id": "S01-2", "t": 40.51, "d": 6.67, "rows": [[["可这份笃定没撑多久，他", null], ["心里就空落落的", "rose"], ["，", null]], [["一时说不清到底舍不得什么。", null]]], "text": "可这份笃定没撑多久，他心里就空落落的，一时说不清到底舍不得什么。", "hue": "rose"}, {"id": "S01-3", "t": 82.62, "d": 7.5, "rows": [[["偶尔想起", null], ["从前熟悉的日子", "gold"], ["，他还是想往前过，", null]], [["却不知道以后", null], ["靠什么让自己安下心", "rose"], ["。", null]]], "text": "偶尔想起从前熟悉的日子，他还是想往前过，却不知道以后靠什么让自己安下心。", "hue": "gold"}, {"id": "S02-1", "t": 128.76, "d": 7.71, "rows": [[["他", null], ["舍不得从前那些自在的时候", "gold"], ["，", null]], [["光是想到以后不能再像那样过日子，心里就有些慌。", null]]], "text": "他舍不得从前那些自在的时候，光是想到以后不能再像那样过日子，心里就有些慌。", "hue": "gold"}, {"id": "S02-2", "t": 143.86, "d": 7.71, "rows": [[["一想得多了，他就赶紧提醒自己", null], ["当初受过的难堪", "blue"], ["，", null]], [["怕一心软，连为什么要走都忘了。", null]]], "text": "一想得多了，他就赶紧提醒自己当初受过的难堪，怕一心软，连为什么要走都忘了。", "hue": "blue"}, {"id": "S02-3", "t": 159.86, "d": 7.29, "rows": [[["可他还是", null], ["不甘心", "blue"], ["，难道为了不再受那些气，", null]], [["就得把以前的", null], ["好日子", "gold"], ["也一起丢掉吗？", null]]], "text": "可他还是不甘心，难道为了不再受那些气，就得把以前的好日子也一起丢掉吗？", "hue": "gold"}], "phrases": [{"t": 0.5, "d": 3.4, "text": "沉重、郑重的和弦", "hue": "blue", "sel": [0.0, 0.7910000000000007, "all"], "y": 360.6}, {"t": 4.31, "d": 3.4, "text": "像烟雾往高处散", "hue": "blue", "sel": [3.955, 15.82, "lh"], "y": 118.0}, {"t": 23.27, "d": 5, "text": "短句像叹息，刚冒出来就被长停顿截断", "hue": "rose", "sel": [21.02, 37.1, "all"], "y": 435.4}, {"t": 40.23, "d": 3.61, "text": "余音在冰冷的空气里慢慢散尽", "hue": "rose", "sel": [40.18, 43.48, "all"], "y": 443.7}, {"t": 56.64, "d": 3.4, "text": "强迫自己挺直背脊", "hue": "blue", "sel": [52.762, 64.9, "lh"], "y": 128.1}, {"t": 73.02, "d": 3.4, "text": "摸到的却只有虚空", "hue": "rose", "sel": [68.10799999999999, 79.33599999999997, "lh"], "y": 368.9}, {"t": 80.99, "d": 3.4, "text": "像一幕旧场景忽然回来", "hue": "gold", "sel": [80.94, 87.32, "top"], "y": 518.4}, {"t": 91.26, "d": 3.61, "text": "过去也不会因此重新变成现在", "hue": "gold", "sel": [91.2, 97.59, "top"], "y": 435.4}, {"t": 109.85, "d": 3.4, "text": "波兰舞曲的步态逐渐浮现", "hue": "blue", "sel": [109.8, 115.76, "top"], "y": 493.5}, {"t": 119.83, "d": 3.4, "text": "隐约记起了该如何迈步", "hue": "blue", "sel": [119.78, 125.06, "lh"], "y": 402.2}, {"t": 128.15, "d": 3.4, "text": "一首从远处传来的旧歌", "hue": "gold", "sel": [128.1, 131.84, "top"], "y": 402.2}, {"t": 133.89, "d": 4.17, "text": "腿脚虚浮的人，在记忆中挪动舞步", "hue": "rose", "sel": [133.84, 137.36, "top"], "y": 385.5}, {"t": 139.37, "d": 3.4, "text": "细碎、不安的半音在蠕动", "hue": "rose", "sel": [139.32, 143.86, "lh"], "y": 244.4}, {"t": 155.25, "d": 3.61, "text": "音乐猛地往上推，却又退下来", "hue": "blue", "sel": [154.76, 159.86, "top"], "y": 360.6}], "mood": [{"t": 0.0, "top": [8, 11, 18], "bot": [10, 15, 24], "rh": [214, 226, 240], "lh": [120, 145, 180], "fade": 3.0}, {"t": 80.94, "top": [18, 13, 12], "bot": [34, 22, 16], "rh": [255, 226, 176], "lh": [160, 130, 110], "fade": 5}, {"t": 99.44, "top": [12, 12, 18], "bot": [18, 16, 24], "rh": [226, 218, 214], "lh": [120, 120, 150], "fade": 5}, {"t": 128.1, "top": [20, 9, 14], "bot": [38, 14, 22], "rh": [255, 214, 186], "lh": [190, 96, 100], "fade": 3}, {"t": 154.76, "top": [26, 10, 12], "bot": [52, 16, 18], "rh": [255, 214, 170], "lh": [220, 96, 80], "fade": 3}], "ghosts": [], "necklace": [{"t": 0.5, "hue": "blue"}, {"t": 4.31, "hue": "blue"}, {"t": 23.27, "hue": "rose"}, {"t": 40.23, "hue": "rose"}, {"t": 56.64, "hue": "blue"}, {"t": 73.02, "hue": "rose"}, {"t": 80.99, "hue": "gold"}, {"t": 91.26, "hue": "gold"}, {"t": 109.85, "hue": "blue"}, {"t": 119.83, "hue": "blue"}, {"t": 128.15, "hue": "gold"}, {"t": 133.89, "hue": "rose"}, {"t": 139.37, "hue": "rose"}, {"t": 155.25, "hue": "blue"}], "arcs": [{"from": 82.62, "to": 128.76, "hue": "gold"}, {"from": 17.38, "to": 143.86, "hue": "blue"}, {"from": 17.38, "to": 159.86, "hue": "gold"}], "center": "", "credit": "", "end_t": 99999, "wave": false, "gain": 2.6, "title": "肖邦《幻想波兰舞曲》", "subtitle": "一个人在这首曲子里经历的一件事", "intro_len": 5.0}