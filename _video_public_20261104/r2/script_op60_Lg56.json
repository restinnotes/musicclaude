 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他忽然发现自己很想靠近这个人",
       "detail": "这份心动来得连他自己都有些意外。",
       "keys": [],
       "from": [
        "S01-1"
       ]
