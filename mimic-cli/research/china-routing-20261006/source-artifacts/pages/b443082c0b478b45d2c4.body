        line-height: 32px;
    }


  /* ===================== 右下角悬浮按钮 ===================== */
        .floating-support {
            position: fixed;
           bottom: 20px;
            right: 18px;
    z-index: 9999;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
        }
        .floating-options {
            display: flex;
            flex-direction: column;
            gap: 8px;
            opacity: 0;
            pointer-events: none;
            transform: translateX(12px) scale(0.95);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .floating-support.active .floating-options {
            opacity: 1;
            pointer-events: all;
            transform: translateX(0) scale(1);
        }
        .floating-option {
            display: flex; align-items: center; gap: 8px;
            padding: 10px 16px;
            background: var(--white);
            border-radius: 12px;
            font-size: 14px; font-weight: 600;
            color: var(--theme-black);
            white-space: nowrap;
            box-shadow: var(--shadow-lg);
            cursor: pointer; transition: var(--transition);
            text-decoration: none;
            border: 1px solid var(--gray-200);
        }
        .floating-option:hover { background: var(--primary); color: #fff; transform: translateX(-4px); border-color: var(--primary); }
        .floating-option .material-icons-round { font-size: 18px; }
        .floating-headset {
            width: 58px; height: 58px;
            border-radius: 50%;
            background: var(--primary);
            display: grid; place-items: center;
            cursor: pointer;
            box-shadow: 0 6px 24px rgba(255,143,0,0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
        }
        .floating-headset:hover { transform: scale(1.08); box-shadow: 0 8px 32px rgba(255,143,0,0.5); }
        .floating-support.active .floating-headset { background: var(--theme-black); box-shadow: 0 6px 24px rgba(0,0,0,0.3); }
        .floating-headset .material-icons-round { font-size: 28px; color: #fff; }

        /* 右侧悬浮（回到顶部/底部） */
        .side-nav-buttons {
            position: fixed;
            right: 24px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 9998;
        }
        .side-nav-btn {
            width: 44px; height: 44px;
            border-radius: var(--radius-md);
            background: var(--white);
            border: 1px solid var(--gray-200);
            color: var(--gray-500);
            display: grid; place-items: center;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: var(--shadow-sm);
            -webkit-tap-highlight-color: transparent;
            outline: none;
            touch-action: manipulation;
        }

        /* 点击后滚动期间保持高亮 */
        .side-nav-btn.is-active {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
            box-shadow: var(--shadow-md);
        }

        /* 仅 PC 鼠标悬停高亮 */
        @media (hover: hover) and (pointer: fine) {
            .side-nav-btn:hover {
                background: var(--primary);
                border-color: var(--primary);
                color: #fff;
                box-shadow: var(--shadow-md);
            }
        }

        /* 按下瞬间反馈（PC + 移动端） */
        .side-nav-btn:active {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
            box-shadow: var(--shadow-md);
        }

        /* 移动端：仅清除触摸残留的 :hover，不影响 is-active */
        @media (hover: none) {
            .side-nav-btn:hover:not(.is-active) {
                background: var(--white);
                border-color: var(--gray-200);
                color: var(--gray-500);
                box-shadow: var(--shadow-sm);
            }
        }

        .side-nav-btn:focus {
            outline: none;
        }

        .side-nav-btn:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        .side-nav-btn .material-icons-round { font-size: 22px; }


</style>

