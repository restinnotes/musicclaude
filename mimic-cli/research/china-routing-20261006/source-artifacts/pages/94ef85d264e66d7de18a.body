          background-color: rgba(0, 0, 0, 0.4);
        }
        .text-on-picture {
          background: rgba(255, 255, 255, 0.5);
        }
        .v-align-out {
          display: table;
          height: 100%;
        }
        .v-align-in {
          display: table-cell;
          vertical-align: middle;
        }
        .h-align-out {
