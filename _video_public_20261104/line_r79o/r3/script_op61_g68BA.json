        "S04-2",
        "S04-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "温暖忽然像风暴",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "越用力越不安稳",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "记忆太好难以重来",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "一股力量向下拉",
       "keys": [],
       "from": [
