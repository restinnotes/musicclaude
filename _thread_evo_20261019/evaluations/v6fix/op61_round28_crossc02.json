      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "正在面对",
    "items": [
     {
      "id": "S08-1",
      "text": "他又短暂地觉得过去离自己近了些，心里因此柔和下来，紧绷也松了一点。",
      "key": "他又短暂地觉得过",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1",
       "S07-2"
      ]
     },
     {
      "id": "S08-2",
      "text": "但那份亲近很快淡了，他还没来得及安心，便又有些不舍。",
      "key": "但那份亲近很快淡",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1"
      ]
     }
    ],
    "because": [
     {
