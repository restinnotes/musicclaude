{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然心里发热想靠近对方，怕自己的需要成负担只敢露一点喜欢\",\n          \"accent\": \"心里发热\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\", \"S01-2\"],\n          \"at\": 0\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"一点亲近就让他觉得甜，下次还敢坦白吗？\",\n          \"after\": 0,\n          \"from\": [\"S01-3\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"话到嘴边又停住，怕说出口会改变关系\",\n          \"after\": 0,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"刚踩上船板水波荡开时，身体一瞬失重\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 14\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"和弦像烟花迸发，细碎光点仍悬在水面上\",\n          \"from\": [\"S01-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"不同演奏的开头，有的摇晃，有的悬空\",\n          \"from\": [\"S01-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他在意却没退开，他才慢慢放松\",\n          \"accent\": \"慢慢放松\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想靠近时喜欢快藏不住，怕太急弄坏自在便收住\",\n          \"accent\": \"喜欢快藏不住\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 26\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"想到好时光总会过去，还没分开就舍不得\",\n          \"after\": 0,\n          \"from\": [\"S02-3\"],\n          \"bars\": \"\",\n          \"at\": 44\n        },\n        {\n          \"text\": \"肩挨肩耳语时连沉默都舒服，夏末湿风贴着皮肤\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约6–16\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"把身体交给船底托着，水和时间都不停\",\n          \"after\": 0,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"喜欢涌上来时连呼吸都变了，很快又退回去\",\n          \"after\": 1,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"柔软落音像甜蜜里藏着小刺，鼻子微微发酸\",\n          \"after\": 0,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"约7–11\",\n          \"at\": 23\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"右手两条旋律贴近，像两道依偎的歌声\",\n          \"from\": [\"S02-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"约6–16\"\n        },\n        {\n          \"text\": \"左手连续脉动，歌声未出便托住摇荡\",\n          \"from\": [\"S02-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"4–16\"\n        },\n        {\n          \"text\": \"歌声先上涌，随后渐弱回到柔和\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"12–16\"\n        },\n        {\n          \"text\": \"柔软落音带着甜蜜，也透出隐约惆怅\",\n          \"from\": [\"S02-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"约7–11\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他暂时不想以后，只想舒服地待在这份亲近里\",\n          \"accent\": \"舒服地待在这份亲近里\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想说出喜欢也想问对方是否一样，念头却慢慢淡了\",\n          \"accent\": \"念头却慢慢淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"亲密交谈后安静下来很舒服，心却慢慢漂远\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"急着表达的念头露头一下，很快又沉回去\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"约20–21\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"谈话被暗流拖住，倒影零碎难拼却还没走向悲剧\",\n          \"after\": 1,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\",\n          \"at\": 26\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声退远，只剩水波般流动盘旋\",\n          \"from\": [\"S03-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"摇曳中忽然冒出短促急切的声响\",\n          \"from\": [\"S03-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"约20–21\"\n        },\n        {\n          \"text\": \"流动忽然受阻，声音绕远并滞留半途\",\n          \"from\": [\"S03-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"17–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"亲近让他欢喜又想起上回没说，盼对方接纳坦白的自己\",\n          \"accent\": \"盼对方接纳坦白的自己\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\", \"S04-2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想让眼下的好久些，又怕说多了让对方为难\",\n          \"accent\": \"怕说多了让对方为难\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 27\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"讲往事越讲越急，忍不住折回来补细节\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"情意到了喉咙口，颤抖哽咽却没落稳\",\n          \"after\": 0,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"约30–34\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"握着对方的手，不知不觉越握越紧\",\n          \"after\": 1,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 39\n        },\n        {\n          \"text\": \"两人仍靠得很近，心里却像看见每秒倒数\",\n          \"after\": 1,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\",\n          \"at\": 45\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉歌声重现，贴近的声线添了细密花腔\",\n          \"from\": [\"S04-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"高音长颤音明亮，随后渐弱并放慢摇晃\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"约30–34\"\n        },\n        {\n          \"text\": \"两道歌声仍贴近，左手水波却一直向前\",\n          \"from\": [\"S04-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"24–34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他没藏住喜欢，被看穿后空落得不知怎么相处\",\n          \"accent\": \"空落得不知怎么相处\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-1\", \"S05-2\"],\n          \"at\": 0\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他怕对方嫌自己太黏，亲近忽然隔了一层\",\n          \"after\": 0,\n          \"from\": [\"S05-3\"],\n          \"bars\": \"\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"小船漂进雾里脚下失去支撑，时间也松开\",\n          \"after\": 0,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"这份幸福是真的吗，还能维持多久？\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 12\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"水波与摇晃忽然消失，只剩单薄旋律游走\",\n          \"from\": [\"S05-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"35–39\"\n        },\n        {\n          \"text\": \"先前紧抓当下的劲松开，像深吸一口气\",\n          \"from\": [\"S05-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他多在乎仍一如从前，他又自在了\",\n          \"accent\": \"他又自在了\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想靠近又怕要得太多，这份害怕只能自己扛\",\n          \"accent\": \"只能自己扛\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"他忍不住猜，对方会不会也舍不得这份亲近\",\n          \"accent\": \"也舍不得这份亲近\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 29\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"暖金水面滑入古桥阴影，像初恋的凉月光\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"心里反复低声说算了，可还是放不下\",\n          \"after\": 1,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"再亲近的人也走不进心里，白天好似回忆\",\n          \"after\": 1,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"气味、身体感觉、幻想遗憾和快感混成一团\",\n          \"after\": 1,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 33\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"新旋律清澈舒展，左手水波变薄细碎\",\n          \"from\": [\"S06-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"低声旋律与另一声线交织，时近时远\",\n          \"from\": [\"S06-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"40–50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他渐渐觉得对方也许需要自己陪着，能安心些\",\n          \"accent\": \"也许需要自己陪着\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到能互相依靠，他心口一紧，盼着一直陪伴\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-2\", \"S07-3\"],\n          \"at\": 19\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"清澈歌声下涌出更深渴望，推着身体向前\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"沉醉带着情色暖意，明知被卷进去仍不想出来\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"这一刻仍美好，时间却已经悄悄经过\",\n          \"after\": 1,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏与内声部越发密集，低音催出急促脉搏\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"上回露心意后对方仍亲近，他想大方回应\",\n          \"accent\": \"大方回应\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他盼两人能一直这么好，心里却仍没底\",\n          \"accent\": \"心里却仍没底\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-2\", \"S08-3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"心里的话不再防备，一下子敞开\",\n          \"after\": 0,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"像重新碰到阳光和风，身体轻快又有点调情\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"歌声忽然停住，快乐余温里泛起怀念\",\n          \"after\": 1,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\",\n          \"at\": 30\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旋律舒展开来，歌句一再抬高\",\n          \"from\": [\"S08-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌声明亮轻盈，熟悉摇荡带着催促\",\n          \"from\": [\"S08-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌声向上散开，随后突然停住\",\n          \"from\": [\"S08-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"69–71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他怕对方有天不再需要他，连相处都觉得不自在\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他忽然安静下来，不敢再往以后想\",\n          \"accent\": \"不敢再往以后想\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"对方没退开也许喜欢他在身边，他有点高兴\",\n          \"accent\": \"喜欢他在身边\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"强烈渴望还在，像对视到呼吸都停了\",\n          \"after\": 0,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"像陷进低气压，阳光隔着薄雾变朦胧\",\n          \"after\": 0,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"他反复问自己，刚才是真的吗？接下来怎么办？\",\n          \"after\": 1,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"不安还在，眼前美好却比愿望更大\",\n          \"after\": 2,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 26\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉摇摆收住，颤音与轻和弦悬在半空\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"72–77\"\n        },\n        {\n          \"text\": \"声音一层层下沉变暗，明亮感渐渐柔化\",\n          \"from\": [\"S09-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"72–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他暂时不猜以后，先好好享受眼前的亲近\",\n          \"accent\": \"享受眼前的亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"紧绷慢慢松开，他心里亮堂得想笑也想哭\",\n          \"accent\": \"想笑也想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 14\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"胸口终于打开，眼泪也不必再忍\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"清风拨开水波，时间只让出一口气的空地\",\n          \"after\": 0,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"身体忽然失重，像灵魂飘在夏夜微风里\",\n          \"after\": 1,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\",\n          \"at\": 23\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"水波般的摇荡被拨开，旋律短暂打开空地\",\n          \"from\": [\"S10-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"高音织出细亮音符，琶音如飞瀑落水\",\n          \"from\": [\"S10-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"78–83（下泻琶音：80–83）\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他需要对方也愿意陪着，即使对方不需要也不藏喜欢\",\n          \"accent\": \"不藏喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\", \"S11-2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他无法决定对方以后还要不要他，想到亲近会变就心口发疼\",\n          \"accent\": \"心口发疼\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-3\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"期待像得到回应，力量却仍悬在半空\",\n          \"after\": 0,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"约92\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"夕阳烧得血红金亮，光刺眼得让人想哭\",\n          \"after\": 1,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"旧房子里的熟悉东西还在，心里却更沉\",\n          \"after\": 1,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 32\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"厚重和弦托起歌声，左手水波扩成大幅起伏\",\n          \"from\": [\"S11-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"铺开的力量短暂悬停，还没到全曲终点\",\n          \"from\": [\"S11-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"约92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他顾不上对方是否也在乎，只想把能给的都给对方\",\n          \"accent\": \"把能给的都给对方\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他知道再用心也不能保证以后，还是想多陪一会儿\",\n          \"accent\": \"想多陪一会儿\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"他不再收着，终于痛痛快快地喜欢对方\",\n          \"accent\": \"痛痛快快地喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-3\"],\n          \"at\": 26\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"被卷进更大的世界，连自己都暂时退到后面\",\n          \"after\": 2,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102（放大感：94–102）\",\n          \"at\": 31\n        },\n        {\n          \"text\": \"像久别重逢后紧紧抱住，喉咙发紧眼眶湿润\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"温柔主题被放大，内声部拉扯出层层声浪\",\n          \"from\": [\"S12-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"93–102（放大感：94–102）\"\n        },\n        {\n          \"text\": \"旋律反复上伸，牵扯延迟后才突然释放\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"93–102（96–100附近；释放：102–103交界）\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"他想听对方保证不变，心里仍怕好日子太短\",\n          \"accent\": \"怕好日子太短\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他从怕成负担到怕失去亲近，少露心意会少疼吗？\",\n          \"accent\": \"少露心意会少疼吗\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"他已装不出不在乎，若把喜欢藏回去反而更难受\",\n          \"accent\": \"藏回去反而更难受\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 27\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"刚到一道浪峰，身后又有更大的浪推来\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"幸福没有消失，悲伤却慢慢进到幸福里面\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"刚说了是，心里马上又冒出一句可是呢\",\n          \"after\": 2,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"脚步牢牢踩住地面，胸口却一次次往下沉\",\n          \"after\": 2,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"音乐反复渐强，后段逐渐绷紧直逼下一次冲击\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"下方声部稳稳踩住，上方声部反复下落\",\n          \"from\": [\"S13-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"103–110\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"从不敢露喜欢到仍然亲近，他又甜又酸却不后悔\",\n          \"accent\": \"又甜又酸却不后悔\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他仍舍不得也不知以后怎样，却不再求保证也不藏喜欢\",\n          \"accent\": \"不再求保证也不藏喜欢\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-2\", \"S14-3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从美梦里醒来，心里仍留着温热\",\n          \"after\": 0,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111–115（最后一浪：110–111交界）\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"低低回望之后，还有一道水花般的闪光\",\n          \"after\": 0,\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113–115\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"像经历震荡后站起身，整理衣服关上门\",\n          \"after\": 1,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"开头悬着的话，终于像有人回应并说完\",\n          \"after\": 1,\n          \"from\": [\"S14-B4\"],\n          \"bars\": \"113–116\",\n          \"at\": 29\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"最后一股浪头推进，终结句随后松下来\",\n          \"from\": [\"S14-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"111–115（最后一浪：110–111交界）\"\n        },\n        {\n          \"text\": \"低声部浮出独唱般旋律，随后细碎琶音闪现\",\n          \"from\": [\"S14-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"113–115\"\n        },\n        {\n          \"text\": \"最后几下和弦干脆沉重，低音明确落定\",\n          \"from\": [\"S14-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"116\"\n        },\n        {\n          \"text\": \"尾声呼应开头，最后和弦接住悬着的话\",\n          \"from\": [\"S14-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"113–116\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "b6eff46c-b66b-4918-839a-313b24b6c3f8", "session_revision": 0, "session_ttl_max_hours": 6, "job_directory": "D:\\music