       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他偏偏想到这么好的时刻总会过去，还没分开就先有点舍不得",
