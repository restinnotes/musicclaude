{
 "center": "维持尊严的行动与对旧日生活及归属的怀念反复拉扯",
 "segments": [
  {
   "bars": "1–23",
   "relation": "还说不清",
   "items": [
    {
     "id": "I1",
     "text": "他心里空了一处，却说不出少了什么。",
     "key": "空了一处",
     "kind": ""
    },
    {
     "id": "I2",
     "text": "过去的亲近曾让他不怕稍有疏忽便失去依靠。",
     "key": "失去依靠",
     "kind": ""
    },
    {
     "id": "I3",
     "text": "想起旧日，他仍先感到安稳。",
     "key": "感到安稳",
     "kind": ""
    },
    {
     "id": "I4",
     "text": "他甚至有一瞬间随熟悉感松弛下来。",
     "key": "松弛下来",
     "kind": ""
    },
    {
     "id": "I5",
     "text": "那份安稳里似乎藏着让他不自在的东西。",
     "key": "不自在的东西",
     "kind": ""
    },
    {
     "id": "I6",
     "text": "他不明白自己的戒备，也不敢完全沉进去。",
     "key": "不敢完全沉进去",
     "kind": ""
    },
    {
     "id": "I7",
     "text": "他舍不得把温存推远。",
     "key": "温存推远",
     "kind": ""
    },
    {
     "id": "I8",
     "text": "连怀念都不再自然，让他怅惘。",
     "key": "让他怅惘",
     "kind": ""
    }
   ],
   "because": []
  },
  {
   "bars": "24–65",
   "relation": "正在面对",
   "items": [
    {
     "id": "I9",
     "text": "曾为保住亲近而忍下的不满重新浮现。",
     "key": "忍下的不满",
     "kind": ""
    },
    {
     "id": "I10",
     "text": "那些委屈使他确信自己有理由不退让。",
     "key": "理由不退让",
     "kind": ""
    },
    {
     "id": "I11",
     "text": "他终于不愿为了留住别人先让自己难受。",
     "key": "留住别人",
     "kind": ""
    },
    {
     "id": "I12",
     "text": "这种自由带来的畅快远超预想。",
     "key": "远超预想",
     "kind": ""
    },
    {
     "id": "I13",
     "text": "他喜欢自己此刻不再处处顾忌的硬气。",
     "key": "不再处处顾忌",
     "kind": ""
    },
    {
     "id": "I14",
     "text": "他甚至为过去的难堪感到一丝骄傲。",
     "key": "一丝骄傲",
     "kind": ""
    },
    {
     "id": "I15",
     "text": "他感到积压已久的力量终于能伸展。",
     "key": "终于能伸展",
     "kind": ""
    },
    {
     "id": "I16",
     "text": "先前的迟疑暂时被冲淡。",
     "key": "暂时被冲淡",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I5",
     "to": "I9",
     "rel": "唤起"
    },
    {
     "from": "I6",
     "to": "I10",
     "rel": "改写"
    },
    {
     "from": "I7",
     "to": "I11",
     "rel": "改写"
    }
   ]
  },
  {
   "bars": "66–91",
   "relation": "正在面对",
   "items": [
    {
     "id": "I17",
     "text": "他愈发珍惜不必依赖别人认可的安稳。",
     "key": "别人认可",
     "kind": ""
    },
    {
     "id": "I18",
     "text": "痛快平息后，他感到另一种安静。",
     "key": "另一种安静",
     "kind": ""
    },
    {
     "id": "I19",
     "text": "许多事情如今可由他自己承担。",
     "key": "自己承担",
     "kind": ""
    },
    {
     "id": "I20",
     "text": "他却少了一个能够放心依赖的所在。",
     "key": "放心依赖",
     "kind": ""
    },
    {
     "id": "I21",
     "text": "保护自己的分量仍换不回被自然接纳的感觉。",
     "key": "自然接纳",
     "kind": "办法的限度"
    },
    {
     "id": "I22",
     "text": "这份欠缺暂未动摇他，却添了轻轻的孤单。",
     "key": "轻轻的孤单",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I13",
     "to": "I17",
     "rel": "仍在起作用"
    },
    {
     "from": "I12",
     "to": "I18",
     "rel": "限制"
    },
    {
     "from": "I2",
     "to": "I20",
     "rel": "唤起"
    },
    {
     "from": "I11",
     "to": "I21",
     "rel": "限制"
    }
   ]
  },
  {
   "bars": "92–115",
   "relation": "正在面对",
   "items": [
    {
     "id": "I23",
     "text": "孤单让旧日温存更难割舍。",
     "key": "更难割舍",
     "kind": ""
    },
    {
     "id": "I24",
     "text": "他恼怒自己仍如此需要从前的生活。",
     "key": "恼怒自己",
     "kind": ""
    },
    {
     "id": "I25",
     "text": "他仿佛仍被旧日委屈借着依恋牵住。",
     "key": "依恋牵住",
     "kind": ""
    },
    {
     "id": "I26",
     "text": "怀念因此变得带刺。",
     "key": "变得带刺",
     "kind": ""
    },
    {
     "id": "I27",
     "text": "原先畅快的坚定此刻也紧绷起来。",
     "key": "紧绷起来",
     "kind": ""
    },
    {
     "id": "I28",
     "text": "一想到失去的亲近，他便愤懑难平。",
     "key": "愤懑难平",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I22",
     "to": "I23",
     "rel": "提供理由"
    },
    {
     "from": "I9",
     "to": "I25",
     "rel": "仍在起作用"
    },
    {
     "from": "I13",
     "to": "I27",
     "rel": "改写"
    },
    {
     "from": "I20",
     "to": "I28",
     "rel": "唤起"
    }
   ]
  },
  {
   "bars": "116–147",
   "relation": "正在面对",
   "items": [
    {
     "id": "I29",
     "text": "持续的愤懑让他疲惫。",
     "key": "让他疲惫",
     "kind": ""
    },
    {
     "id": "I30",
     "text": "他不愿再只凭委屈回想过去。",
     "key": "只凭委屈",
     "kind": ""
    },
    {
     "id": "I31",
     "text": "他承认过去确实给过自己快乐。",
     "key": "给过自己快乐",
     "kind": ""
    },
    {
     "id": "I32",
     "text": "他开始觉得当年的珍惜不全因软弱或怕失去。",
     "key": "不全因软弱",
     "kind": "分清"
    },
    {
     "id": "I33",
     "text": "他不甘心：为何无法安稳地留在那份幸福里？",
     "key": "无法安稳地留在",
     "kind": ""
    },
    {
     "id": "I34",
     "text": "愤怒已无法替他把事情说清。",
     "key": "无法替他",
     "kind": "办法的限度"
    },
    {
     "id": "I35",
     "text": "失去那些好，忽然难以只是解脱。",
     "key": "难以只是解脱",
     "kind": ""
    },
    {
     "id": "I36",
     "text": "怀念让他的心柔软了些。",
     "key": "柔软了些",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I28",
     "to": "I29",
     "rel": "提供理由"
    },
    {
     "from": "I24",
     "to": "I32",
     "rel": "改写"
    },
    {
     "from": "I2",
     "to": "I31",
     "rel": "唤起"
    },
    {
     "from": "I28",
     "to": "I34",
     "rel": "限制"
    },
    {
     "from": "I23",
     "to": "I36",
     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "148–180",
   "relation": "没在想",
   "items": [
    {
     "id": "I37",
     "text": "他终于能少带怨气地感受过去的好。",
     "key": "少带怨气",
     "kind": ""
    },
    {
     "id": "I38",
     "text": "他记起那时不必时时证明自己值得被爱。",
     "key": "值得被爱",
     "kind": ""
    },
    {
     "id": "I39",
     "text": "他怀念喜欢别人时可以只是喜欢。",
     "key": "只是喜欢",
     "kind": ""
    },
    {
     "id": "I40",
     "text": "他怀念依赖别人时不必觉得难堪。",
     "key": "不必觉得难堪",
     "kind": ""
    },
    {
     "id": "I41",
     "text": "旧日的快乐仍真实，并非失去后才显得美好。",
     "key": "仍真实",
     "kind": ""
    },
    {
     "id": "I42",
     "text": "此刻他暂时无心追究那些委屈。",
     "key": "暂时无心",
     "kind": ""
    },
    {
     "id": "I43",
     "text": "他只想在那份温柔里多停留一会儿。",
     "key": "多停留一会儿",
     "kind": ""
    },
    {
     "id": "I44",
     "text": "重新感到无需防备，他甚至有些幸福。",
     "key": "有些幸福",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I31",
     "to": "I37",
     "rel": "提供理由"
    },
    {
     "from": "I32",
     "to": "I41",
     "rel": "说明"
    },
    {
     "from": "I36",
     "to": "I42",
     "rel": "提供理由"
    },
    {
     "from": "I2",
     "to": "I44",
     "rel": "唤起"
    }
   ]
  },
  {
   "bars": "181–205",
   "relation": "正在面对",
   "items": [
    {
     "id": "I45",
     "text": "回忆里的幸福渐渐变得充实。",
     "key": "变得充实",
     "kind": ""
    },
    {
     "id": "I46",
     "text": "他几乎能像从前那样毫无顾忌地依恋。",
     "key": "毫无顾忌",
     "kind": ""
    },
    {
     "id": "I47",
     "text": "需要别人照顾的自己也不再令他不安。",
     "key": "不再令他不安",
     "kind": ""
    },
    {
     "id": "I48",
     "text": "他仍渴望把心完全交给值得信赖的感情。",
     "key": "值得信赖",
     "kind": ""
    },
    {
     "id": "I49",
     "text": "先前的骄傲给不了他被温柔包容的满足。",
     "key": "温柔包容",
     "kind": "满足照出未满足"
    },
    {
     "id": "I50",
     "text": "那些亲近在回忆里鲜明得仿佛从未远去。",
     "key": "仿佛从未远去",
     "kind": ""
    },
    {
     "id": "I51",
     "text": "这份满足又让他更舍不得。",
     "key": "更舍不得",
     "kind": ""
    },
    {
     "id": "I52",
     "text": "他还想念那个能坦然爱人、放心示弱的自己。",
     "key": "放心示弱",
     "kind": ""
    },
    {
     "id": "I53",
     "text": "往日的自在如今竟显得难得。",
     "key": "显得难得",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I44",
     "to": "I45",
     "rel": "仍在起作用"
    },
    {
     "from": "I40",
     "to": "I47",
     "rel": "唤起"
    },
    {
     "from": "I21",
     "to": "I49",
     "rel": "说明"
    },
    {
     "from": "I38",
     "to": "I52",
     "rel": "唤起"
    }
   ]
  },
  {
   "bars": "206–213",
   "relation": "正在面对",
   "items": [
    {
     "id": "I54",
     "text": "他忽然记起那时也有不敢表露的真实感受。",
     "key": "不敢表露",
     "kind": ""
    },
    {
     "id": "I55",
     "text": "他曾怕认真提出要求会伤害感情。",
     "key": "伤害感情",
     "kind": ""
    },
    {
     "id": "I56",
     "text": "刚才的幸福仍在，却忽然添了令人心疼的一面。",
     "key": "令人心疼",
     "kind": ""
    },
    {
     "id": "I57",
     "text": "那份爱确实存在，他也曾为保住它而受苦。",
     "key": "为保住它而受苦",
     "kind": ""
    }
   ],
   "because": [
