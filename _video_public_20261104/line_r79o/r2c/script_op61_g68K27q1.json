 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "离开熟悉生活后他松口气，终于不用再委屈自己也能挺直腰杆",
       "keys": [],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "他硬撑着挺背，脚下没方向没力气只想停",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "笃定很快散了，他心里空落落的还说不清舍不得什么",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里堵着东西，分不清是气、遗憾还是想念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "冷空里醒来胸口发紧，视线模糊伸手摸空未落泪",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想往前过日子却总被旧时光牵回，不知以后靠什么安心",
       "keys": [],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音光线都回来了，过去却回不到眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "想到以后不能再过从前那样自在的日子，他心里发慌",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日珍爱像远歌，认得却哼不全也难再拥有",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "腿脚发虚，照着记忆挪舞步也站不稳",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他一舍不得就想起受过的气，提醒自己别忘了为何离开",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "理好衣服抬头说没事，反复说才显出在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他还是不甘心，难道不再受委屈就得丢掉好日子？",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "那股劲只是还不肯认输，谈不上重拾自信",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他心里还憋着气，想起曾被当作自己人又高兴了一会儿",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像故乡麦浪微风，也像从前相处时不必防备",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像聊点别的或出去走走，暂时躲开沉重问题",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "那点高兴很快变酸，他怕从前回不去也怕离开后未必更好",
       "keys": [],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他又怀疑，刚才那些鼓劲的话自己真信吗",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他真盼着还能那样相处",
       "keys": [],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "感激柔情曾让他幸福易伤，坚定或许仍是向往",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "想起旧日亲近和委屈，他问当初走对了吗或没走会怎样",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "美好回不来，刺痛让他疲惫又仓促",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "急促脚步推着他跑，心跳也乱了拍",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "他反复想如果当时怎样，像在躲开眼前的事",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他觉得受的气不该忍，也不愿连过去的开心都不敢想",
       "keys": [],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "柔声里压着怒气悲伤，他还想护住自己",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "争到没力气后不服气渐渐淡了，他只剩不在他们身边的难受",
       "keys": [],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "两只手像夜里的影子，靠近着低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "温暖或许来自某个人，也可能来自故乡旧生活",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "像几次深呼吸，紧绷松开一点只是累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "难受缓下来，他不再拿受过的气压住对旧日的想念",
       "keys": [],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "世界隔着玻璃，母亲轻哼摇篮曲让他暂松戒备",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "不用解释也不必装强，心愿委屈思念都浮上来",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "如今身边没了那些人，他才懂有人陪着有多轻松",
       "keys": [],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他盼着再有那种不用多说就亲近的日子，又怕再也等不到",
       "keys": [],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "他向远方祈求，愿望真切却不知有无回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "从试探到鼓起勇气，临了又像有句话没说完",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "那些日子确实拥有过，想起来仍能给他一点暖意",
       "keys": [],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "远处忽然亮起，梦里的家园看得见却回不去",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "他放轻声音看着珍惜的一切，不急着抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他担心以后遇上难事还得独自扛，自己撑得住吗",
       "keys": [],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "寒风猛地吹开窗，后颈发凉脉搏狂跳",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "心里还在翻腾，像有东西想冲出去却找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他只想离开后不再受气，早知这么孤单还会走吗",
       "keys": [],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "思绪被打断，舞步从别处闯来心里未好转",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他想找回亲近却不肯回去受委屈，连离开的决心也找不回",
       "keys": [],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的动作和舞步又浮现，失去的日子更清楚",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起曾被当作自己人，他心里暖了会儿却没想回头",
       "keys": [],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "临走前回头看一眼，心里又温柔又不舍",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "暖意很快散了，往后遇到难事回忆不能替他扛",
       "keys": [],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "胸口忽然吸进一口气，只是短暂喘息",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他分不清想回去是舍不得被当自己人，还是怕孤单到愿再受委屈",
       "keys": [],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "重遇当初无措的自己，知道经历却仍没答案",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "这念头让他一下慌了，甚至不敢再往下想",
       "keys": [],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他最舍不得曾被当作自己人，可回去还能亲近吗",
       "keys": [],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "当初的委屈没消失，光凭想念他仍不敢回去",
       "keys": [],
       "from": [
        "S10-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他反复想得筋疲力尽仍没答案，眼下日子也过得不踏实",
       "keys": [],
       "from": [
        "S10-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像突然悬在半空，辨不清方向也没有着落",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "这回他问怎样继续生活，带着一路积下的疲惫",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      },
      {
       "text": "他知道往事重要，却已没力气再讲一遍",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他知道回去未必还能亲近，却仍盼着又不肯再忍让",
       "keys": [],
       "from": [
        "S11-1",
        "S11-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他先不急着决定回不回去，想把眼下的日子过稳",
       "keys": [],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "试探的步子渐聚拢，祈祷般的声音变成行动",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他仍怕以后只能独自扛难处，却不想再因害怕收回打算",
       "keys": [],
       "from": [
        "S11-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像困在绝境里一次次顶住重压，压力却又涌来",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      },
      {
       "text": "害怕还在，问题未解但停滞终于松开",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不再逼自己选边：受过的气不该忍，从前也开心过",
       "keys": [],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "主题回归带着昂扬气势，也像面向众人的集体感",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他怕独自熬却不怪当初离开：不为陪伴回头，带着想念生活",
       "keys": [],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他终于能自己决定怎么站稳，不必假装没受过伤",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      },
      {
       "text": "脚下像忽然斜了一下，他却没有停步",
       "keys": [],
       "from": [
        "S12-B3"
       ],
       "bead": "S12-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想起从前自然亲近的日子，又盼未来还能拥有",
       "keys": [],
