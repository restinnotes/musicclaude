      "bead_edges": [
        {
          "a": "S09-B1",
          "b": "S09-B2",
          "type": "可同时成立",
          "note": "B1是运动忽然收住、悬而未发的身体感觉；B2是这份悬停中的明暗、空气与注意力变化。收住的音乐仍可以逐层下沉、变暗，不必拆成两个先后事件。"
        },
        {
          "a": "S09-B1",
          "b": "S09-B3",
          "type": "重叠但新增",
          "note": "两者都用了忽然不说话的画面。B1新增的核心是向前冲动被截断、呼吸停住而未释放；B3则把焦点转到沉默中的回听与反复追问。不能因此推定音乐规定了一个人从倾诉到自我怀疑的完整心理步骤。"
        },
        {
          "a": "S09-B2",
          "b": "S09-B3",
          "type": "可同时成立",
          "note": "声音逐层变暗、注意力集中，可以与回听自身余响的心理动作同时发生，但二者没有必须成立的因果关系。"
        },
        {
          "a": "S09-B3",
          "b": "S09-B4",
          "type": "另一种理解",
          "note": "B3仍在回听与追问，B4则把注意力从自己的愿望转向更广大的美好。它们在心理上并不互斥，一个人可以仍有疑问却暂时不被疑问占满；但作为听者的画面，两者重心不同，短时间呈现时更适合择一，不能编排成必然先后发生的自问与顿悟。"
        }
      ],
