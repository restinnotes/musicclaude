     "items": [
      {
       "text": "脚下像钉在地上，不肯挪动",
       "bead": "S13-B4",
       "from": [
        "S13-B4"
       ],
       "bars": "103–110",
       "at": 25.0
      },
      {
       "text": "人站得稳稳的，胸口却一沉再沉",
       "bead": "S13-B4",
       "from": [
        "S13-B4"
       ],
       "bars": "103–110",
       "at": 33.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "心愿像终于说出口，音乐却仍继续向前推",
     "bars": "103–110",
     "from": [
      "S13-B1"
     ]
    },
    {
     "text": "反复渐强，力量越绷越紧，逼近下一次冲击",
     "bars": "103–111",
     "from": [
      "S13-B1"
     ]
    },
    {
     "text": "明亮声里渐渐掺进尖锐、暗沉的成分",
     "bars": "107–110",
     "from": [
      "S13-B2"
     ]
    },
    {
     "text": "下方脚步稳住，上方声线一再下坠",
     "bars": "103–110",
     "from": [
      "S13-B4"
     ]
    }
   ]
  },
  {
   "sec": "S14",
   "rows": [
    {
     "kind": "line",
     "text": "最初他连喜欢都不敢多露，如今两人仍亲近",
     "keys": [
      "仍亲近"
     ],
     "emotion": "亲密",
     "from": [
      "S14-1"
     ]
    },
    {
     "kind": "line",
     "text": "心里又甜又酸，他却不后悔",
     "keys": [
      "不后悔"
     ],
     "emotion": "欢喜",
     "from": [
      "S14-1"
     ],
     "at": 6.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "最后一股浪头过去，心里仍温热，身体慢慢平静",
       "bead": "S14-B1",
       "from": [
        "S14-B1"
       ],
       "bars": "111–115",
       "at": 1.0
      },
      {
       "text": "像从美梦里醒来，还记得梦里的光",
       "bead": "S14-B1",
       "from": [
        "S14-B1"
       ],
       "bars": "111–115",
       "at": 5.0
      },
      {
       "text": "低低一声回望，熟悉的歌与摇荡又回来了",
       "bead": "S14-B2",
       "from": [
        "S14-B2"
       ],
       "bars": "113–115",
       "at": 10.0
      },
      {
       "text": "最后一道细碎水花，像溅向夜空的一闪",
       "bead": "S14-B2",
       "from": [
        "S14-B2"
       ],
       "bars": "115",
       "at": 14.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "他还是舍不得，也不知道以后会怎样，却不再逼自己讨保证",
     "keys": [
      "不再逼自己讨保证"
     ],
     "emotion": "悬着",
     "from": [
      "S14-2"
     ],
     "at": 12.0
    },
    {
     "kind": "line",
     "text": "既然喜欢已让对方看见，他就不往回藏了",
     "keys": [
      "不往回藏了"
     ],
     "emotion": "炽热",
     "from": [
      "S14-3"
     ],
     "at": 22.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "最后几下和弦像铁锚落水，把小船一下定住",
       "bead": "S14-B3",
       "from": [
        "S14-B3"
       ],
       "bars": "116",
       "at": 19.0
      },
      {
       "text": "也像经历震荡后站起身，整理衣服，关上门",
       "bead": "S14-B3",
       "from": [
        "S14-B3"
       ],
       "bars": "116",
       "at": 24.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "以后会怎样，等真的到了那时再说",
     "keys": [
      "再说"
     ],
     "emotion": "安心",
     "from": [
      "S14-3"
     ],
     "at": 29.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "尾声像接住开头那句悬着的话，终于说完",
       "bead": "S14-B4",
       "from": [
        "S14-B4"
       ],
       "bars": "113–116",
       "at": 30.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "最后一股浪头猛推一下，终结句随后松下来",
     "bars": "110–115",
     "from": [
      "S14-B1"
     ]
    },
    {
     "text": "左手内声部幽幽唱出一句，熟悉摇荡回返",
     "bars": "113–115",
     "from": [
      "S14-B2"
     ]
    },
    {
     "text": "右手细碎琶音像水花溅向夜空",
     "bars": "115",
     "from": [
      "S14-B2"
     ]
    },
    {
     "text": "最后几下和弦干脆沉重，又向上抬起",
     "bars": "116",
     "from": [
      "S14-B3"
     ]
    }
   ]
  }
 ]
