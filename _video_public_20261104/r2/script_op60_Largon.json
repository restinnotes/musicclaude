       "text": "甜得发酸",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      },
      {
       "text": "还没分开就舍不得",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "鼻尖发酸",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      },
      {
       "text": "想让这一刻慢点",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
