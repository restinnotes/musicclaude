: \"一度\"\n        },\n        {\n          \"text\": \"当初的委屈又翻上来\",\n          \"point\": \"走得对不对\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又翻上来；反复\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"旋律几乎单独露出来，像脚下原有的地板忽然不见了，只剩一个声音自己说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍觉得当初\",\n          \"point\": \"受的那些气不该忍\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"仍；也不敢多想从前的开心\"\n        },\n        {\n          \"text\": \"他跟自己反复较劲\",\n          \"point\": \"只剩下离开后的难受\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"反复较劲；直到没了力气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"明知有些事已经挽不回，便放轻声音，好好看着它\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"难受慢慢缓下来\",\n          \"point\": \"没再拿受过的气压住想