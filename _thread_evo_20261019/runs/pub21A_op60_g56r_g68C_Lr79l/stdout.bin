     ],\n      \"lines\": [\n        {\n          \"text\": \"见对方依然愿意亲近自己\",\n          \"point\": \"大方回应\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"依然愿意亲近自己\"\n        },\n        {\n          \"text\": \"他开始盼着两人能长久相处\",\n          \"point\": \"心里却还是没底\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却还是没底\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"整段像两个人对视到呼吸都停了：强烈的渴望还在，却引而不发\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"光还在，只是隔了一层朦胧的雾气\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"眼前的美好其实比自己的愿望大得多\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然怕对方不再需要自己\",\n          \"point\": \"不再需要自己\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"连相处也不自在\"\n        },\n        {\n          \"text\": \"他不敢再往远处想\",\n          \"point\": \"对方还没退开\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"不敢再往远处想\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"fine\": [\n        {\n          \"quote\": \"心事并没有解决，只是这一刻不必再强迫自己控制感受\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"暂时\"\n        },\n        {\n          \"quote\": \"不过它很短，更像一口终于呼出的气，不是能永远躲进去的避风处\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连自己的身体也仿佛失去了重量，像灵魂从躯壳里飘出来\",\n          \"carrier\": \"身体感觉\",\n        