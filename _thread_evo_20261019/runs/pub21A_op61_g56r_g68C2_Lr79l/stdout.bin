{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"我不能倒下，可我其实很想停下来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"可\"\n        },\n        {\n          \"quote\": \"记忆再清晰，过去也不会因此重新变成现在。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这里不是已经哭出来的悲伤，而是连自己身在何处都还没弄清的恍惚。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是悲伤，是恍惚\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开熟悉的生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"总算\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"不知如何安顿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想往前走又\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"第一次还有几分相信，第二次开始努力让自己相信\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越反复越显得在意\"\n        },\n        {\n          \"quote\": \"不是轻松恢复自信，而是负隅顽抗。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到以后再没有那样的日子\",\n          \"point\": \"再没有那样的日子\",\n          \"where\": \"中\",\n          \"waste\": \"他就\",\n          \"keep\": \"再没有\"\n        },\n        {\n          \"text\": \"他一遍遍想起受过的气\",\n          \"point\": \"忘了当初为什么离开\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕自己一心软\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"温柔得让人心颤，也刺痛得让人绝望：越怀念，越能感觉它与眼前处境的距离。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"绝望\"\n        },\n        {\n          \"quote\": \"那一刻的轻松可以是真的，并非假装；只是它没有替心里的事找到答案。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"我刚才是真的相信那些话，还是只是在努力让自己相信？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起有人把他当自己人\",\n          \"point\": \"把他当自己人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"一小会儿\"\n        },\n        {\n          \"text\": \"可那样的日子回不去\",\n          \"point\": \"离开后也未必更好过\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可那点高兴还没退\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"外在的步伐还在向前，里面却有了更多回声。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"却\"\n        },\n        {\n          \"quote\": \"不是记忆变坏了，而是它太好了——过去无法原样回来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不停地往前赶，只是为了避免停下来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他真盼着还能像从前那样相处\",\n          \"point\": \"还能像从前那样相处\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"真盼着\"\n        },\n        {\n          \"text\": \"可一想到回去\",\n          \"point\": \"当初离开对不对\",\n          \"where\": \"后\",\n          \"waste\": \"他也开始\",\n          \"keep\": \"一想到回去，受过的委屈又会涌上来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"柔和的歌唱并没有抹掉向前的劲：音乐仍像被压力推着走\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是想通了\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他不服气，受过的气不该忍\",\n          \"point\": \"开心的事也不该抹掉\",\n          \"where\": \"后\",\n          \"waste\": \"他不服气，\",\n          \"keep\": \"受过的气不该忍，开心的事也不该抹掉\"\n        },\n        {\n          \"text\": \"他在心里争来争去\",\n          \"point\": \"不在那些人身边\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没了力气才发现\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"可这份安宁并不意味着现实已经变好，也不是一个能永远停留的地方。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"这回想起从前\",\n          \"point\": \"没急着拿受过的气压住想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没急着\"\n        },\n        {\n          \"text\": \"独自熬过那些难关后\",\n          \"point\": \"有人陪着有多轻松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"独自熬过那些难关后\"\n        },\n        {\n          \"text\": \"他怕再也没有那份亲近\",\n          \"point\": \"心里暖了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"但想到自己曾拥有过\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"后颈一凉，脉搏也剧烈跳动。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"身体和情绪却还没有完全相信一切已经结束。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越熟悉越觉失去\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他刚安心\",\n          \"point\": \"早知道这样还会走吗？\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"以后还得独自扛\"\n        },\n        {\n          \"text\": \"他想找回那份亲近\",\n          \"point\": \"离开的决心也开始动摇了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又怕回去还要受气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一眼里有温柔，也有不舍。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只是瞬间的喘息，并不等于整个人重新安顿下来。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他先放下回去的事\",\n          \"point\": \"却没想回头\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"心里暖了一会儿，却没想回头\"\n        },\n        {\n          \"text\": \"可回忆不能陪他过难关\",\n          \"point\": \"回忆不能陪他过难关\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"心又悬了起来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"声音短暂落稳，又向高处漂去，刚有的一点稳定感随即散掉\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像是从另一面重新看见了同一扇门，真正向前的步伐还没聚起来。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"最初的问题又浮上来，却没有因此得到一个简单的答案。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他分不清自己是舍不得那份亲近\",\n          \"point\": \"舍不得那份亲近，还是太怕孤单\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"宁愿再受气\"\n        },\n        {\n          \"text\": \"这个念头让他心慌\",\n          \"point\": \"连往下想都不敢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这个念头让他心慌\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"fine\": [\n        {\n          \"quote\": \"熟悉的声音只是轻轻地、断断续续地浮现，像几块碎片。\",\n          \"carrier\": \"副词\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"明明知道它