 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他忽然很想靠近这个人，心里一下热起来，连自己都没想到。",
       "keys": [
        "很想靠近",
        "没想到"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夏夜的烟花猛地升起，光点落下来，却还悬在水面上。",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方看出自己有多需要这份亲近，会觉得有负担，只敢露出一点喜欢。",
       "keys": [
        "有多需要",
        "只敢露出一点"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像刚踏上船板，脚下晃了一下，还没站稳。",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "只靠近这么一点就让他觉得甜，可下次能不能更坦白，他还没底。",
       "keys": [
        "觉得甜",
        "还没底"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "话已经在心里想了很久，真到嘴边，反而先沉默了。",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他在意也没退开，还愿意和他亲近，他才一点点放松下来。",
       "keys": [
        "没退开",
        "放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声还没出来，脚下的水波已经像心跳一样摇着。",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像两个人贴着耳朵说悄悄话，连呼吸都挨在一起。",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "潮湿的暖风贴在皮肤上，有一点黏，却很舒服。",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人在一起明明这么好，他却想到这样的时刻总会过去，还没分开就有点舍不得。",
       "keys": [
        "总会过去",
        "舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "几次轻轻落下的声音像温柔的小刺，甜得让人有点鼻酸。",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "人舒服地漂着，不想靠岸，水却一直在往前流。",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他越待越想靠近，喜欢得差点藏不住，又怕太急会破坏这份自在，还是收住了。",
       "keys": [
        "差点藏不住",
        "还是收住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话说着说着突然热切起来，呼吸也跟着急了，随后又轻轻缓下来。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不去想两个人以后会怎样，只想舒舒服服地待在眼前的亲近里。",
       "keys": [
        "不去想",
        "舒舒服服"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "沉默一点也不尴尬，身体还在轻轻晃，心却慢慢飘远了。",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他忽然想告诉对方自己有多喜欢这样，也想问对方是不是一样，可话还没想好，念头就散了。",
       "keys": [
        "想问对方",
        "念头就散了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里那句急着说的话，只冒了个头就沉回去了。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水还在摇，人却像被水下的暗流轻轻拖住了。",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "这份熟悉的亲近又让他开心起来，也让他想起上回想说却没说出口的喜欢。",
       "keys": [
        "亲近",
        "没说出口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像聊起往事，越说越快，明明一句话够了，还想折回来再补两句。",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他这回几乎想把心里话全说出来，也盼对方喜欢不再那么小心的自己。",
       "keys": [
        "全说出来",
        "不再那么小心"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像原本只是轻轻牵着手，不知不觉就握得更紧。",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "高处的光亮得有些刺眼，想说的话也像卡在了喉咙口。",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他还想多说些，好把眼前的好留久一点，又怕说得太多让对方为难，最后还是留了话没说。",
       "keys": [
        "留久一点",
        "留了话没说"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "明明还这么甜，鼻子却有点发酸，水波还一直往前走。",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "摇晃慢下来，刚说过的话仿佛还留在空中，人却安静了。",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "前几次他想说又收住，对方却始终愿意亲近，这回他一放松就没藏住喜欢，等察觉时对方已经看出来了。",
       "keys": [
        "没藏住喜欢",
        "看出来了"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像一直握紧的手终于松开，呼吸也缓了下来。",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "从前还能假装不在乎，如今心事被看穿，他心里突然空了，连怎么相处都没底。",
       "keys": [
        "心事被看穿",
        "突然空了"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "脚下的水波突然没了，像小船独自漂进雾里。",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "丰满的声音忽然只剩细细一条，不知道要往哪儿去。",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方嫌自己太黏，熟悉的亲近也像忽然隔了一层。",
       "keys": [
        "嫌自己太黏",
        "隔了一层"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚才还像两个人低声说话，这会儿心里只剩一句：这份幸福能维持多久？",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方明明看出他有多在乎，相处时却一点也没变，他才又能像从前一样自在。",
       "keys": [
        "一点也没变",
        "自在"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像漂到古桥的阴影里，空气一下凉了，让人想起年少时第一次心动。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "等静下来，他才想到对方根本不知道自己刚才多怕被嫌弃，心里忽然有点孤单。",
       "keys": [
        "根本不知道",
        "有点孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "明明刚和人好好待着，独自回想时却有点鼻酸，像那份好已经成了回忆。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他又想，对方一直没退开，会不会也舍不得结束这份亲近？",
       "keys": [
        "一直没退开",
        "会不会也舍不得"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里一会儿想算了，一会儿又觉得还是放不下。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "回想时，气味、身体的感觉和遗憾混在一起，舒服得反倒找不着方向。",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想到对方这些日子一直愿意陪着他，他开始觉得，也许对方也需要他，和他待着也能安心。",
       "keys": [
        "也需要他",
        "也能安心"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "这个猜想让他越想越高兴，光是想到两个人这么亲近，他就舍不得从这阵欢喜里出来。",
       "keys": [
        "越想越高兴",
        "舍不得"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "底下像有沉沉的心跳在催，原本舒服的水波慢慢热起来。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "身体里像有股劲推着往前，只是安静待着已经不够了。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "回想那个人时，气味、触感、遗憾和快乐混在一起，越想越舍不得停。",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他真希望以后对方想找人陪时还会想到他，自己也能一直在身边。",
       "keys": [
        "还会想到他",
        "一直在身边"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "眼前明明这么好，心里却清楚没办法让这一刻停住。",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "上回无意露了喜欢，对方依旧亲近，他便想主动些，大大方方地回应。",
       "keys": [
        "依旧亲近",
        "主动些"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像终于不用防备，心里有什么就痛快地唱出来。",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他连以后都开始盼，觉得两个人也许还能这么好很久。",
