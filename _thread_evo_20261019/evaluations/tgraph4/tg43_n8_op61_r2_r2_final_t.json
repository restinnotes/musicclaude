   },
   "relation_model": "正在面对",
   "items_before_trim": [
    {
     "id": "I61",
     "text": "知道自己舍不得什么，并没立刻使他勇敢起来。",
     "key": "明白不舍仍未变勇敢",
     "kind": "",
     "key_model": "知道舍不得仍不勇敢"
    },
    {
     "id": "I62",
     "text": "他无法再只凭最初那股决心向前，也无法安心沉浸在旧愿里。",
     "key": "难凭决心也难安于旧愿",
     "kind": "",
     "follows": true,
     "key_model": "两种办法都难以安心"
    },
    {
     "id": "I63",
     "text": "他看出，靠决心向前和沉浸在旧愿里都曾帮过他，也各自留下难处。",
     "key": "看见决心旧愿各有难处",
     "kind": "办法的限度",
     "follows": true,
     "key_model": "两种办法都有难处"
    },
    {
     "id": "I64",
     "text": "他一时无力要求自己作出很大改变，只剩一个很轻的愿望。",
     "key": "只剩一个微弱愿望",
     "kind": "",
     "follows": true,
     "key_model": "只剩一个轻微愿望"
    },
    {
     "id": "I65",
     "text": "他只愿争取时记得缘由，也在爱惜安宁时继续面对威胁它的事。",
     "key": "记得缘由也面对威胁",
     "kind": "",
     "follows": true,
     "key_model": "争取时记得缘由"
    },
    {
     "id": "I66",
     "text": "他还不知道怎样做到，只反复想着这点微弱的意思。",
     "key": "反复想着微弱心愿",
     "kind": "",
     "follows": true,
     "key_model": "反复想着微弱意思"
    },
    {
     "id": "I67",
     "text": "这样想着，非得舍弃一边才能继续的逼迫，似乎稍稍轻了一些。",
     "key": "非此即彼的逼迫稍减",
     "kind": "",
     "follows": true,
     "key_model": "舍弃一边的逼迫变轻"
    }
   ]
  },
  {
   "bars": "226–241",
   "relation": "正在面对",
   "items": [
    {
     "id": "I68",
     "text": "凭着这点尚不牢靠的心意，他重新思考自己还能怎么办。",
     "key": "重新思考还能怎么办",
     "kind": "",
     "follows": false
    },
    {
     "id": "I69",
     "text": "他亲身体会到，开始行动能让他不再干等，却不能消除所有牵挂。",
     "key": "行动打破无力却难消牵挂",
     "kind": "办法的不足",
     "follows": false
    },
    {
     "id": "I70",
     "text": "他也尝过，心中美好能给人安慰，却不能单靠安慰保护所珍爱的生活。",
     "key": "美好能安慰却难护生活",
     "kind": "办法的不足",
     "follows": false
    },
    {
     "id": "I71",
     "text": "两样收获都是真的，他不愿简单否定任何一个。",
     "key": "不愿否定两样真实收获",
     "kind": "",
     "follows": true
    },
    {
     "id": "I73",
     "text": "他想保有无需时时奋力的安宁，可为它争取也可能让自己失去安宁。",
     "key": "为安宁争取反失安宁",
     "kind": "",
     "follows": true
    },
    {
     "id": "I74",
     "text": "过去他常因这种为难责怪自己，仿佛坚定的人不该如此。",
     "key": "曾因两难责怪自己",
     "kind": "",
     "follows": false
    },
    {
     "id": "I75",
     "text": "如今他渐渐承认，珍视的东西不止一种，它们有时难以兼顾。",
     "key": "珍视多样事物难以兼顾",
     "kind": "选择的冲突",
     "follows": true
    },
    {
     "id": "I76",
     "text": "这份承认没有让他轻松，他仍为将要付出的东西心疼，也盼有更容易的路。",
     "key": "心疼将失去的仍盼易路",
     "kind": "",
     "follows": true
    },
    {
     "id": "I77",
     "text": "他知道再等下去不会让那条更容易的路自然出现。",
     "key": "知道等待不会等来易路",
     "kind": "",
     "follows": true
    },
    {
     "id": "I78",
     "text": "若只因害怕损伤珍贵之物便不再争取，他所爱惜的也未必能留下。",
     "key": "不争取未必留住所爱",
     "kind": "",
     "follows": true
    },
    {
     "id": "I80",
     "text": "越接近真正行动，他越清楚自己仍会怕，却不肯让惧怕替自己决定。",
     "key": "不让惧怕替自己决定",
     "kind": "",
     "follows": true
    }
   ],
   "because": [
    {
     "from": "I67",
     "to": "I68",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I8",
     "to": "I69",
     "rel": "说明",
     "audit": "支持"
    },
    {
     "from": "I44",
     "to": "I70",
     "rel": "限制",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对",
   "items_before_trim": [
    {
     "id": "I68",
     "text": "凭着这点尚不牢靠的心意，他重新思考自己还能怎么办。",
     "key": "重新思考还能怎么办",
     "kind": "",
     "key_model": "重新思考怎么办"
    },
    {
     "id": "I69",
     "text": "他亲身体会到，尽力承担能使人从无力中站起，却不能消除所有牵挂。",
     "key": "承担能使人从无力站起",
     "kind": "办法的限度",
     "key_model": "承担带来力量仍有牵挂"
    },
    {
     "id": "I70",
     "text": "他也尝过，心中美好能给人安慰，却不能单靠安慰保护所珍爱的生活。",
     "key": "美好能安慰却难护生活",
     "kind": "办法的限度",
     "key_model": "美好安慰不能保护生活"
    },
    {
     "id": "I71",
     "text": "两样收获都是真的，他不愿简单否定任何一个。",
     "key": "不愿否定两样真实收获",
     "kind": "",
     "follows": true,
     "key_model": "两样收获都是真的"
    },
    {
     "id": "I72",
     "text": "可他渐渐觉得，要让两样东西都毫发无伤地留下，恐怕并不可能。",
     "key": "难让两样收获毫发无伤",
     "kind": "",
     "follows": true,
     "key_model": "无法让两样毫发无伤"
    },
    {
     "id": "I73",
     "text": "他想保有无需时时奋力的安宁，可为它争取也可能让自己失去安宁。",
     "key": "为安宁争取反失安宁",
     "kind": "",
     "follows": true,
     "key_model": "争取安宁也会失去安宁"
    },
    {
     "id": "I74",
     "text": "过去他常因这种为难责怪自己，仿佛坚定的人不该如此。",
     "key": "曾因两难责怪自己",
     "kind": "",
     "key_model": "曾因两难责怪自己"
    },
    {
     "id": "I75",
     "text": "如今他渐渐承认，代价也可能来自自己珍视的东西不止一种。",
     "key": "珍视多样事物也有代价",
     "kind": "选择的代价",
     "follows": true,
     "key_model": "代价来自珍视不止一种"
    },
    {
     "id": "I76",
     "text": "这份承认没有让他轻松，他仍为将要付出的东西心疼，也盼有更容易的路。",
     "key": "心疼代价仍盼容易之路",
     "kind": "",
     "follows": true,
     "key_model": "仍为代价心疼"
    },
    {
     "id": "I77",
     "text": "他知道再等下去不会让那条更容易的路自然出现。",
     "key": "知道等待不会等来易路",
     "kind": "",
     "follows": true,
     "key_model": "等待不会生出容易路"
    },
    {
     "id": "I78",
     "text": "若只因害怕损伤珍贵之物便不再争取，他所爱惜的也未必能留下。",
     "key": "不争取未必留住所爱",
     "kind": "",
     "follows": true,
     "key_model": "不争取也未必保得住"
    },
    {
     "id": "I79",
     "text": "他不再要求自己先毫不害怕，愿意带着不舍、没把握和承担中的苦楚重新向前。",
     "key": "带着不舍和苦楚向前",
     "kind": "",
     "follows": true,
     "key_model": "带着不舍重新向前"
    },
    {
     "id": "I80",
     "text": "临近真正承担时，他仍清楚自己会怕，却不愿再让惧怕替自己决定。",
     "key": "不让惧怕替自己决定",
     "kind": "",
     "follows": true,
     "key_model": "不让惧怕替他决定"
    }
   ]
  },
  {
   "bars": "242–253",
   "relation": "正在面对",
   "items": [
    {
     "id": "I81",
     "text": "不再等一个毫无损失的办法，他终于重新愿意向前行动。",
     "key": "不等无损办法重新行动",
     "kind": "",
     "follows": false
    },
    {
     "id": "I82",
     "text": "久违的昂扬回来了，他不再否认脆弱，也不必等疑虑消失才敢坚定。",
     "key": "昂扬回归不否认脆弱也不等疑虑消失",
     "kind": "",
     "follows": true
    },
    {
     "id": "I83",
     "text": "他仍愿尽力，却不再要求这份尽力证明自己有能力改变一切。",
     "key": "不拿尽力证明能改一切",
     "kind": "",
     "follows": true
    },
    {
     "id": "I84",
     "text": "他愿为珍惜的东西负责，不再藏起害怕失去什么，也不把牵挂当作拖累。",
     "key": "为珍惜负责不藏怕失去",
     "kind": "",
     "follows": true
    }
   ],
   "because": [
    {
     "from": "I80",
     "to": "I81",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I75",
     "to": "I84",
     "rel": "仍在起作用",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对",
   "items_before_trim": [
    {
     "id": "I81",
     "text": "不再等一个毫无损失的办法后，他终于重新愿意向前承担。",
     "key": "不等无损办法重新承担",
     "kind": "",
     "key_model": "不再等无损办法"
    },
    {
     "id": "I82",
     "text": "久违的昂扬回来了，他不必再靠否认脆弱来维持它。",
     "key": "昂扬回归不再否认脆弱",
     "kind": "",
     "follows": true,
     "key_model": "昂扬不靠否认脆弱"
    },
    {
     "id": "I83",
     "text": "他仍愿尽力，却不再要求这份尽力证明自己有能力改变一切。",
     "key": "不拿尽力证明能改一切",
     "kind": "",
     "follows": true,
     "key_model": "尽力不再证明全能"
    },
    {
     "id": "I84",
     "text": "他知道自己要承担什么，也知道为何难以割舍，怕失去和想珍惜的都不必藏起来。",
     "key": "不再隐藏所怕与所珍惜",
     "kind": "",
     "follows": true,
     "key_model": "不藏怕失去与珍惜"
    },
    {
     "id": "I85",
     "text": "他愿为真心爱惜的一切负责，不再把牵挂当作行动的拖累。",
     "key": "为珍爱负责并接纳牵挂",
     "kind": "",
     "follows": true,
     "key_model": "为所爱之物负责"
    },
    {
     "id": "I86",
     "text": "这次决心仍然热烈，却更踏实，他无需等犹疑消失才允许自己坚定。",
     "key": "不等疑虑消失才坚定",
     "kind": "分清",
     "follows": true,
     "key_model": "无需等犹疑消失"
    }
   ]
  },
  {
   "bars": "254–288",
   "relation": "正在面对",
   "items": [
    {
     "id": "I87",
     "text": "带着全部牵挂重新向前时，他有些意外，旧日的愿望并未因此远去，反而似乎更亲近。",
     "key": "带着牵挂旧愿反而更近",
     "kind": "",
     "follows": false
    },
    {
     "id": "I88",
     "text": "过去想到这种生活，他常想从艰难争取中撤回，仿佛这样才能完整保住它。",
     "key": "曾想退出争取保全旧愿",
     "kind": "",
     "follows": false
    },
    {
     "id": "I89",
     "text": "如今正因知道它多么可贵，他更不愿任由使它难以实现的事情继续存在。",
     "key": "珍惜旧愿不再任由阻碍",
     "kind": "",
     "follows": true
    },
    {
     "id": "I91",
     "text": "他承认，想保住那份温柔，有时就得离开眼前的安宁去行动。",
     "key": "保住温柔有时须离开安宁行动",
     "kind": "",
     "follows": true
    },
    {
     "id": "I92",
     "text": "他不把更多投入当作接近旧梦的保证，也不把美好愿望当作所有付出的理由。",
     "key": "不把投入当作旧梦保证",
     "kind": "办法的不足",
     "follows": true
    },
    {
     "id": "I93",
     "text": "他会留意争取时是否又在催逼自己，不让那份温柔被磨掉。",
     "key": "留意争取是否磨掉温柔",
     "kind": "",
     "follows": true
    },
    {
     "id": "I94",
     "text": "他发现，珍惜那种温柔生活，也能让他更愿意为它行动。",
     "key": "珍惜温柔生活也推动行动",
     "kind": "",
     "follows": true
    },
    {
     "id": "I96",
     "text": "他重新尝到最初相信生活时的快乐，可历经怀疑与疲惫后，这份快乐已不再理所当然。",
     "key": "历经疲惫重尝生活之乐",
     "kind": "",
     "follows": true
    },
    {
     "id": "I97",
     "text": "喜悦平静后，他仍不知道许多事会怎样，也无法保证自己的行动能改变什么，生活仍需防备。",
     "key": "行动能否改变仍无答案",
     "kind": "",
     "follows": true
    },
    {
     "id": "I99",
     "text": "他不再用行动时的畅快遮住对温柔生活的眷恋，也不因眼下仍不满足就抹去行动的收获。",
     "key": "不拿行动畅快遮住温柔眷恋",
     "kind": "",
     "follows": true
    },
    {
     "id": "I100",
     "text": "他明白，自己想改变的正是那些让温柔生活难以实现的事，而不是温柔本身。",
     "key": "改变眼前事不抛下温柔生活",
     "kind": "",
     "follows": true
    },
    {
     "id": "I102",
     "text": "他仍想过安宁的日子，也愿为它行动，虽不知能留住多少，仍不必抹去任何一边。",
     "key": "不抹去任何一边仍向前",
     "kind": "",
     "follows": true
    }
   ],
   "because": [
