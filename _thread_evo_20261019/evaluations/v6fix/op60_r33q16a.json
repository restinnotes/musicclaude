      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S13",
    "bars": "103–110",
    "relation": "正在面对",
    "items": [
     {
      "id": "S13-1",
      "text": "他又想把依恋收起来一些，这次不是怕自己给对方添负担，而是想少暴露一点，免得有一天失去时太难受。",
      "key": "他又想把依恋收起",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2",
       "S05-1",
       "S11-2"
      ]
     },
     {
      "id": "S13-2",
      "text": "他仍然很想把这份相互依靠留住，舍不得真的退开，心里却压着一层越来越重的疑虑。",
      "key": "他仍然很想把这份",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S11-2",
       "S13-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S01-2",
      "to": "S13-1",
