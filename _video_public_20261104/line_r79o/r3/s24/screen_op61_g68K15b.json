        "S09-B2"
       ],
       "bars": "214–215"
      },
      {
       "text": "却没有因此得到",
       "bead": "S09-B2",
       "from": [
        "S09-B2"
       ],
       "bars": "214–215"
      },
      {
       "text": "一个简单答案",
       "bead": "S09-B2",
       "from": [
        "S09-B2"
       ],
       "bars": "214–215"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "rows": [
    {
     "kind": "line",
     "text": "他慢慢觉得，最舍不得的还是从前有人把他当作自己人的日子；可就算回去，还能像从前那样吗？",
     "keys": [
      "最舍不得的还是从前有人把他当作自己人的日子",
      "还能像从前那样吗"
     ],
     "emotion": "悬着",
     "from": [
      "S10-1"
     ]
    },
    {
     "kind": "line",
     "text": "当初那些让他难受的事也不能当作没发生过，光凭舍不得，他还是没法放心回去。",
     "keys": [
      "当初那些让他难受的事",
      "没法放心回去"
     ],
     "emotion": "不安",
     "from": [
      "S10-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "听感像忽然失重",
