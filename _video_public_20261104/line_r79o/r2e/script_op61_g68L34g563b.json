       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "当初走时他只想着别再受那些气，没料到会这么孤单",
       "keys": [
        "没料到会这么孤单"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "一个熟悉的动作或舞步冷不防闯进来，反倒更看清失去了什么",
