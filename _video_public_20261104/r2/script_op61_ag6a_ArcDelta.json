        "S13-B1-p2",
        "S13-B1-p3",
        "S13-B1-p4"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "这么想着，他倒真有了劲头，想把往后的日子好好过起来，不再整天跟从前的事较劲。",
       "keys": [
        "有了劲头",
        "好好过起来",
        "不再整天"
       ],
       "from": [
        "S13-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "快速、炫目的八度进行一下释放了积累的能量，明亮、迅疾的音型向前冲出；身体仿佛也被一股气流推着往前跑，兴奋得几乎来不及喘息。",
       "keys": [
        "明亮、迅疾",
        "向前冲出",
        "来不及喘息",
        "来不及喘息"
       ],
       "from": [
        "S13-B2-p1",
        "S13-B2-p2"
       ]
      }
     ]
    },
    {
     "lines": [
      {
       "text": "可他也想到，往后仍可能孤单，不知何时才会再有人亲近；若有人愿意把他当作自己人，他会好好珍惜，若没有，也愿意自己好好过，不再为了留住谁而吞下委屈。",
       "keys": [
        "仍可能孤单",
        "再有人亲近",
        "好好珍惜",
        "自己好好过",
        "不再为了留住谁而吞下委屈",
        "不再为了留住谁而吞下委屈"
       ],
       "from": [
        "S13-3",
        "S13-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "冲势渐渐收敛，颤动的装饰音又带来一点不安，仿佛刚建立的成功还被轻轻问了一句：真的牢固了吗？这份回落也可以像事情说完，终于停下来喘口气；从容与细微的不安可以同时存在。",
       "keys": [
        "一点不安",
        "停下来喘口气",
        "从容与细微的不安",
        "从容与细微的不安"
       ],
       "from": [
        "S13-B3-p1",
        "S13-B3-p2",
        "S13-B3-p3",
        "S13-B3-p4"
       ]
      }
     ]
    },
    {
     "lines": [],
     "beads": [
      {
       "text": "喧嚣像骤然静止，低音沉沉吐出两记耳语般的和弦；低处的轻声与高处的亮光形成鲜明反差，结尾的力量不必只靠更猛烈的敲击。",
