 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他已经离开那段熟悉的生活，起初还觉得自己总算不用再一次次委屈自己了。",
       "keys": [
        "离开那段熟悉的生活",
        "不用再一次次委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像要宣告什么",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "像烟雾往高处散",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "停顿里还等着回声",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "强迫自己挺直背脊",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "刚要站定又飘起来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里就空落落的，一时说不清到底舍不得什么。",
       "keys": [
        "笃定没撑多久",
        "舍不得什么"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像一声叹息",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "冰冷空气里余音散尽",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "我到底在气谁",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "我又在想谁",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "刚从漫长昏沉中醒来",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "胸口发紧",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "视线模糊",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "偶尔想起从前熟悉的日子，他还是想往前过，却不知道以后靠什么让自己安下心。",
       "keys": [
        "想往前过",
        "不知道以后靠什么让自己安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧场景忽然清晰",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "熟悉的声音回来了",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "熟悉的光线回来了",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "熟悉感回来了",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "过去不会变成现在",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "身体先记起怎样迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "还没真正站稳",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前那些自在的时候，光是想到以后不能再像那样过日子，心里就有些慌。",
       "keys": [
        "舍不得从前那些自在的时候",
        "心里就有些慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "不像英雄凯旋",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "给众人看的舞步",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "只哼自己的旧歌",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "庄严、傲慢",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "脆弱凄婉",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "腿脚发虚还在挪舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "那份舍不得一上来，他就赶紧提醒自己受过的那些气，怕一心软，连当初为什么要走都忘了。",
       "keys": [
        "提醒自己受过的那些气",
        "当初为什么要走"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "更焦灼",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "呼吸越来越急",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "最后仍没落稳",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "反复说我没事",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "其实仍很在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "把衣服理整齐再抬起头",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他还是不甘心，难道为了不再受那些气，就得把以前的好日子也一起丢掉吗？",
       "keys": [
        "还是不甘心",
        "以前的好日子"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "我不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他心里还憋着一股气，可想起从前和人在一起时，有人把他当作自己人，竟又高兴了一小会儿。",
       "keys": [
        "憋着一股气",
        "当作自己人"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "重锤砸下",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "心里一悬",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "想走却乱了步子",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "焦躁急切",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "麦浪与微风",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "越亲切越遥远",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那点高兴还没退，他心里就酸了：从前那样的日子过不成了，可离开以后就一定会更好过吗？",
       "keys": [
        "那点高兴还没退",
        "离开以后就一定会更好过吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "侧身离开问题",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "轻松是真的，却没答案",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "真信，还是努力相信",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      },
      {
       "text": "耳边絮语，彼此缠绕",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "流沙，抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他一度真盼着还能那样相处。",
       "keys": [
        "从前亲近的日子",
        "还能那样相处"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像在独自说话",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "旧日的亲密",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "那份感激",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "短暂的幸福",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可那份亲近越鲜活，当初那些委屈也跟着翻上来：那一步走得对不对，后不后悔？没走的话，如今又会怎样？",
       "keys": [
        "当初那些委屈",
        "没走的话，如今又会怎样"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "温暖没能带来安稳",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "记忆没变坏，是它太好了",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "急促的脚步",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "乱了拍的心跳",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "如果当时……",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "是不是还可以……",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "思绪越盘旋",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他仍不服气，觉得当初那些气不该忍，可连过去开心的事都不敢多想，也太为难自己了。",
       "keys": [
        "那些气不该忍",
        "过去开心的事"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "换了一个人开口",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "柔和而克制",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "两个影子低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "被压力推着走",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "这件事不能就这样算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "委屈和火气都在",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "还想替自己争口气",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "旧日记忆有了温度",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "故乡或过去的生活",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "眷恋里带着失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争得没了力气，那股不服气也渐渐淡了，想到自己如今已不在那些人身边，只觉得难受。",
       "keys": [
        "没了力气",
        "只觉得难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "脚下地板忽然不见了",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "只剩一个声音自己说话",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "躁动和不安又加深",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      },
      {
       "text": "几次深呼吸",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      },
      {
       "text": "抵抗得累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "心里那阵难受慢慢缓下来，他又想起以前和人在一起、不必时时防备的时候，这回没急着拿受过的气压住这份想念。",
       "keys": [
        "不必时时防备",
        "压住这份想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "与此前隔开的静谧",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "透明玻璃罩",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "耳边轻哼的摇篮曲",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "暂时松开戒备",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "离开以后，遇上难熬的事，他常常只能自己挺过去，这才知道从前有人在身边能让自己轻松多少。",
       "keys": [
        "只能自己挺过去",
        "有人在身边能让自己轻松多少"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "圣咏般的庄严",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "藏着秘密念头",
       "keys": [],
       "from": [
        "S06-B2"
       ],
