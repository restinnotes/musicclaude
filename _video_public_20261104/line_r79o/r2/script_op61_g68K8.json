 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他已经离开那段熟悉的生活，起初还觉得自己总算不用再一次次委屈自己了。",
       "keys": [
        "离开那段熟悉的生活",
        "不用再一次次委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像烟雾向高处散开",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "我不能倒下，可我其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里就空落落的，一时说不清到底舍不得什么。",
       "keys": [
        "笃定没撑多久",
        "舍不得什么"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "余音在冰冷的空气里慢慢散尽",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "我到底在气谁，又在想谁",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "胸口发紧",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "偶尔想起从前熟悉的日子，他还是想往前过，却不知道以后靠什么让自己安下心。",
       "keys": [
        "想往前过",
        "不知道以后靠什么让自己安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧场景忽然清晰",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "身体先记起了怎样迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前那些自在的时候，光是想到以后不能再像那样过日子，心里就有些慌。",
       "keys": [
        "舍不得从前那些自在的时候",
        "心里就有些慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里却只哼自己的旧歌",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "像腿脚发虚的人还在挪舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "那份舍不得一上来，他就赶紧提醒自己受过的那些气，怕一心软，连当初为什么要走都忘了。",
       "keys": [
        "提醒自己受过的那些气",
        "当初为什么要走"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "呼吸越来越急",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "把衣服理整齐，再抬起头",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他还是不甘心，难道为了不再受那些气，就得把以前的好日子也一起丢掉吗？",
       "keys": [
        "还是不甘心",
        "以前的好日子"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他心里还憋着一股气，可想起从前和人在一起时，有人把他当作自己人，竟又高兴了一小会儿。",
       "keys": [
        "憋着一股气",
        "当作自己人"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "想往前走，脚下却乱了步子",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "像故乡夏日的麦浪与微风",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那点高兴还没退，他心里就酸了：从前那样的日子过不成了，可离开以后就一定会更好过吗？",
       "keys": [
        "那点高兴还没退",
        "离开以后就一定会更好过吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像暂时侧身离开沉重的问题",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "像流沙，抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他一度真盼着还能那样相处。",
       "keys": [
        "从前亲近的日子",
        "还能那样相处"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧记忆里的感激重新鲜活起来",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可那份亲近越鲜活，当初那些委屈也跟着翻上来：那一步走得对不对，后不后悔？没走的话，如今又会怎样？",
       "keys": [
        "当初那些委屈",
        "没走的话，如今又会怎样"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像在撕扯中步步后退",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "身体像被节奏逼着往前跑",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他仍不服气，觉得当初那些气不该忍，可连过去开心的事都不敢多想，也太为难自己了。",
       "keys": [
        "那些气不该忍",
        "过去开心的事"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两只手仿佛夜色里两个影子，彼此低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "像被压力推着走",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "旧日记忆像重新有了温度",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争得没了力气，那股不服气也渐渐淡了，想到自己如今已不在那些人身边，只觉得难受。",
       "keys": [
        "没了力气",
        "只觉得难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "只剩一个声音自己说话",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "像几次深呼吸",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "心里那阵难受慢慢缓下来，他又想起以前和人在一起、不必时时防备的时候，这回没急着拿受过的气压住这份想念。",
       "keys": [
        "不必时时防备",
        "压住这份想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像耳边轻哼的摇篮曲",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "像终于不用解释难过，也不用维持坚强",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "离开以后，遇上难熬的事，他常常只能自己挺过去，这才知道从前有人在身边能让自己轻松多少。",
       "keys": [
        "只能自己挺过去",
        "有人在身边能让自己轻松多少"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "已经远去的家园在梦里显现，看得见，却回不去",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他很想再过上那种不用多说也知道彼此亲近的日子，又怕以后再也没有了。",
       "keys": [
        "不用多说也知道彼此亲近",
        "又怕以后再也没有了"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像停在一句没说完的话上",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "不过，那样的日子自己毕竟真真切切过过，光是这么想着，他心里也暖和了一点。",
       "keys": [
        "真真切切过过",
        "心里也暖和了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像是放轻声音，好好看着珍惜的东西",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，他却猛然想到：以后再遇上难事，要还是只能一个人顶着，他真的撑得住吗？",
       "keys": [
        "猛然想到",
        "他真的撑得住吗"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "后颈一凉",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "当初走时他只想着别再受那些气，没料到会这么孤单；早知道这样，自己还会走吗？",
       "keys": [
        "没料到会这么孤单",
        "自己还会走吗"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的动作忽然闯进来",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      },
      {
       "text": "心里直想冲出去，却找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想找回从前那份亲近，又不甘心回去再受那些气，可连当初走时那股决心也找不着了。",
       "keys": [
        "想找回从前那份亲近",
        "那股决心也找不着了"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他先把回去的事放一边，想起曾被当作自己人，心里暖了一会儿，却没因此想回头。",
       "keys": [
        "把回去的事放一边",
        "没因此想回头"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像已经准备离开的人最后回头看一眼",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那点暖意很快就淡了，想到以后真遇上难事，回忆没法陪着他，心又悬了起来。",
       "keys": [
        "那点暖意很快就淡了",
        "回忆没法陪着他"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "胸口仿佛终于吸进一口气",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他忽然说不清，想回去是舍不得被当作自己人的日子，还是怕孤单到连那些气也肯再受。",
       "keys": [
        "舍不得被当作自己人的日子",
        "连那些气也肯再受"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那扇门又出现了，却不再像最初那样召唤",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "这念头让他一阵心慌，连往下想都不敢了。",
       "keys": [
        "一阵心慌",
        "连往下想都不敢了"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他慢慢觉得自己最舍不得的，还是从前有人把他当作自己人的日子；可就算真的回去，还能像从前那样吗？",
       "keys": [
        "最舍不得的",
        "还能像从前那样吗"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "整个人悬在半空",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "明明很重要，却连从头讲一遍的力气都没了",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "当初那些让他难受的事也不能当作没发生过，光凭舍不得，他还是没法放心回去。翻来覆去想得很累，仍没个答案，连眼下的日子都过得不踏实。",
       "keys": [
        "没法放心回去",
        "仍没个答案"
       ],
       "from": [
        "S10-2",
        "S10-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "明知道回去未必找得回那份亲近，他却还是忍不住想：万一能呢？",
       "keys": [
        "未必找得回那份亲近",
        "万一能呢"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "右手和弦像重锤砸下",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他不愿只凭这点指望回去忍让；回不回以后再说，先把眼下日子过稳些。以后若还得独自扛事，他仍怕、仍没底，却不想因为害怕就把刚才的打算收回去。",
       "keys": [
        "先把眼下日子过稳些",
