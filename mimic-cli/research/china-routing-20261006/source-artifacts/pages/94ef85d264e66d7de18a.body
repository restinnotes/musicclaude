        a.button-simple {
          border: 2px solid #eaeaea;
          -moz-transition: all 0.2s ease;
          -ms-transition: all 0.2s ease;
          -o-transition: all 0.2s ease;
          color: #ffffff;
          display: inline-block;
          margin: auto;
          padding-bottom: 8px;
          padding-left: 20px;
          padding-right: 20px;
          padding-top: 8px;
          text-decoration: none;
          transition: all 0.2s ease;
