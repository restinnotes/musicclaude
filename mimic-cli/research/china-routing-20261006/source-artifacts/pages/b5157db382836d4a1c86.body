n_products_box"><div class="collection_products_box_right"><a href="/index/product.category.html?category_id=10016" class="view-all"><span>VIEW ALL</span><svg xmlns="http://www.w3.org/2000/svg" width="8" height="13" viewBox="0 0 8 13" fill="none"><path d="M1 1L6 6.5L1 12" stroke="black" stroke-width="2"></path></svg></a></div></div></div></div></div></ul></nav></div></li><script>
                  document.querySelectorAll('.header__inline-menu').forEach(function(menuItem) {
                    // 对每个menu-item下的submenu-link添加鼠标进入事件
                    menuItem.querySelectorAll('.submenu-link').forEach(function(link, index) {
                      link.addEventListener('mouseenter', function() {
                        var collectionIndex = this.getAttribute('data-collection');

                        // 取消当前menu-item下所有submenu-link的active样式
                        menuItem.querySelectorAll('.submenu-link').forEach(function(sublink) {
                          sublink.classList.remove('active');
                        });

                        // 为当前悬停的submenu-link添加active样式
                        this.classList.add('active');

                        // 只隐藏当前menu-item下的collection-products
                        menuItem.querySelectorAll('.collection-products').forEach(function(collection) {
                          collection.classList.remove('active');
                        });

                        // 显示对应的collection-products
                        var targetCollection = menuItem.querySelector('.collection-products[data-collection="' + collectionIndex + '"]');
                        if (targetCollection) {
                          targetCollection.classList.add('active');
                        }
                      });

                      // 默认显示第一个submenu-link的active样式
                      if (index === 0) {
                        link.classList.add('active');
                      }
                    });

                    // 默认显示当前menu-item下的第一个collection-products
                    var firstCollection = menuItem.querySelector('.collection-products[data-collection="1"]');
                    if (firstCollection) {
                      firstCollection.classList.add('active');
                    }
                  });
                </script><style>
                  /* 容器设置：隐藏溢出内容，确保滚动效果只在内部发生 */
                  .productvariantsp {
                    /* 1. 强制内容在一行显示 */
                    white-space: nowrap;
                    /* 2. 隐藏超出容器的文本 */
                    overflow: hidden;
                    /* 3. 相对定位作为动画的参考点 */
                    position: relative;
                    /* 4. 定义高度和边距以确保布局一致 */
                    height: 1.2em; /* 假设一行文字的高度 */
                    margin: 5px 0;
                    /* 5. 确保内容宽度不会被压缩 */
                    max-width: 100%;
                  }

                  /* 滚动内容设置：应用滚动动画 */
                  .productvariantsp .selling-text {
                    /* 使用 inline-block 来确保文本宽度适应内容而不是父容器 */
                    display: inline-block;
                    /* 将内容移出视图，准备开始滚动 */
                    padding-left: 100%;

                    /* 应用自定义滚动动画 */
                    animation: marquee 15s linear infinite; /* 15s 是滚动时间，可调整 */
                  }

                  /* 如果你的模板无法在 <p> 标签内再嵌套 <div> 或 <span>，
                     你可以尝试直接在 <p> 标签内应用动画，但需要在内容外层包裹一个标签：*/
                  /* 下拉菜单样式 */

                  @keyframes marquee {
                    0% {
                      /* 0% 时，内容完全在右侧外部 */
                      transform: translate(0, 0);
                    }
                    100% {
                      /* 100% 时，内容向左滚动，直到内容完全移出左侧 */
                      /* calc(100% + 文本实际宽度): 确保内容完全移出视图 */
                      transform: translate(-100%, 0);
                      /* 注意：如果文本很长，你可能需要使用 JavaScript 来计算准确的滚动距离 */
                    }
                  }

                  .header__inline-menu .dropdown_menu_new {
                    list-style: none;
                    margin: 0;
                    background-color: #fff;
                    z-index: 1000;
                    width: 100%;
                    height: auto;
                  }

                  .header__inline-menu .submenu-item {
                    margin: 0;
                  }

                  .header__inline-menu .submenu-link {
                    display: block;
                    padding: 8px 0 8px 16px;
                    text-decoration: none;
                    color: #000;
                    font-family: "HarmonyOS Sans";
                    font-size: 18px;
                    font-style: normal;
                    font-weight: 400;
                    line-height: 120%;
                    margin-bottom: 12px;
                    /* 21.6px */
                    /* border-bottom: 1px solid #ccc; */
                  }
                  /* 鼠标停留时的样式 */
                  .submenu-link:hover,
                  .submenu-link.active {
                    border-radius: 4px;
                    background: #F6F6F6;
                    color: #1566E0;
                    /*color: #1566E0;*/
                    /*background-color: #f0f0f0;*/
                    /*text-decoration-color: #1566E0;*/
                    /*text-decoration-style: solid;*/
                    /*text-decoration-thickness: 2px;*/
                  }

                  /* 下划线从左到右动画效果 */
                  .submenu-link {
                    position: relative;
                    color: black;
                    text-decoration: none;
                  }

                  .submenu-link::before {
                    content: '';
                    position: absolute;
                    width: 0;
                    height: 2px;
                    bottom: -2px;
                    left: 0;
                    background-color: #1566E0;
                    visibility: hidden;
                    transition: all 0.3s ease-in-out;
                    display: none;
                  }

                  .submenu-link:hover::before,
                  .submenu-link.active::before {
                    visibility: visible;
                    width: 100%;
                  }
                  .dropdown_menu_new-box {
                    display: flex;
                    justify-content: center;
                    height: 100%;
                  }


                  .productvariantsp {
                    color: #585858;
                    text-align: center;
                    font-family: "HarmonyOS Sans";
                    font-size: 12px;
                    font-style: normal;
                    font-weight: 400;
                    line-height: 120%;
                    margin-bottom: 15px;
                    /* 14.4px */
                  }

                  .header__inline-menu .dropdown_menu_new-right {
                    list-style: none;
                    padding: 0;
                    margin: 0;
                    z-index: 1000;
                    width: 100%;
                    box-sizing: border-box;
                  }

                  .header__inline-menu .dropdown_menu_new-right::-webkit-scrollbar {
                    width: 8px;
                    /* 滚动条宽度 */
                  }

                  .header__inline-menu .dropdown_menu_new-right::-webkit-scrollbar-track {
                    background-color: #e0e0e0;
                    /* 滚动条轨道背景 */
                  }

                  .header__inline-menu .dropdown_menu_new-right::-webkit-scrollbar-thumb {
                    background-color: #888;
                    /* 滚动条滑块颜色 */
                    border-radius: 10px;
                    /* 圆角 */
                  }

                  .header__inline-menu .dropdown_menu_new-right::-webkit-scrollbar-thumb:hover {
                    background-color: #555;
                    /* 滑块悬停时的颜色 */
                  }

                  /* 为滚动条两端添加渐隐效果 */
                  .header__inline-menu .dropdown_menu_new-right::before,
                  .header__inline-menu .dropdown_menu_new-right::after {
                    content: '';
                    position: absolute;
                    width: 100%;
                    height: 20px;
                    left: 0;
                    pointer-events: none;
                  }

                  .header__inline-menu .dropdown_menu_new-right::before {
                    top: 0;
                    background: linear-gradient(to bottom, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
                  }

                  .header__inline-menu .dropdown_menu_new-right::after {
                    bottom: 0;
                    background: linear-gradient(to top, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
                  }


                  /* 子菜单项目样式 */
                  .header__inline-menu .submenu-item {
                    padding: 10px;
                    border-bottom: 1px solid #ddd;
                  }


                  .Metafield_Newproduct {
                    position: absolute;
                    top: 8px;
                    left: 8px;
                    font-size: 12px;
                    font-style: normal;
                    font-weight: 700;
                    line-height: 110%;
                    /* 13.2px */
                  }
                  /* 隐藏非激活状态的collection-products */
                  .collection-products {
                    display: none;
                  }

                  .collection-products.active {
                    display: block;
                    flex-wrap: wrap;
                  }
                  /* 默认状态下的样式 */
                  .menu-link {
                    color: black;
                    /* 默认字体颜色 */
                    text-decoration: none;
                    /* 去除默认下划线 */
                    position: relative;
                    /* 为了让伪元素定位 */
                    display: inline-block;
                  }

                  /* 鼠标移入时字体变蓝 */
                  .menu-link:hover {
                    color: #1566E0;
                  }

                  /* 下划线动画效果 */
                  .menu-link::after {
                    content: '';
                    position: absolute;
                    width: 0;
                    height: 2px;
                    left: 0;
                    bottom: -2px;
                    /* 下划线位置 */
                    background-color: #1566E0;
                    transition: width 0.3s ease;
                    /* 下划线延伸动画 */
                  }

                  /* 鼠标移入时触发下划线从左到右延伸 */
                  .menu-link:hover::after {
                    width: 100%;
                  }
                  .dropdown_menu_new-left {
                    width: 30%;
                    padding-right: 5rem;
                    box-sizing: border-box;
                  }
                  .dropdown_menu_new-right {
                    width: 70%;
                  }
                  .sub-collections-list {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 16px;
                  }
                  .sub-collections-list .sub-collection-item {
                    width: calc((100% - 32px) / 3);
                    overflow: hidden;
                    position: relative;
                  }
                  .sub-collections-list .sub-collection-item img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                    margin-bottom: 20px;
                    transform: scale(1);
                    border-radius: 4px;
                    transition: transform 0.7s ease;
                  }

                  .sub-collections-list .sub-collection-item:hover img {
                    transform: scale(1.05);
                  }
                  .sub-collection-title {
                    position: absolute;
                    left: 24px;
                    bottom: 20px;
                    margin: 0;
                    color: #FFF;
                    font-family: "HarmonyOS Sans SC";
                    font-size: 14px;
                    font-style: normal;
                    font-weight: 400;
                    line-height: 120%;
                  }
                </style><script>
                  document.querySelectorAll('.header__inline-menu').forEach(function(menuItem) {
                    // 对每个menu-item下的submenu-link添加鼠标进入事件
                    menuItem.querySelectorAll('.submenu-link').forEach(function(link, index) {
                      link.addEventListener('mouseenter', function() {
                        var collectionIndex = this.getAttribute('data-collection');

                        // 取消当前menu-item下所有submenu-link的active样式
                        menuItem.querySelectorAll('.submenu-link').forEach(function(sublink) {
                          sublink.classList.remove('active');
                        });

                        // 为当前悬停的submenu-link添加active样式
                        this.classList.add('active');

                        // 只隐藏当前menu-item下的collection-products
                        menuItem.querySelectorAll('.collection-products').forEach(function(collection) {
                          collection.classList.remove('active');
                        });

                        // 显示对应的collection-products
                        var targetCollection = menuItem.querySelector('.collection-products[data-collection="' + collectionIndex + '"]');
                        if (targetCollection) {
                          targetCollection.classList.add('active');
                        }
                      });

                      // 默认显示第一个submenu-link的active样式
                      if (index === 0) {
                        link.classList.add('active');
                      }
                    });

                    // 默认显示当前menu-item下的第一个collection-products
                    var firstCollection = menuItem.querySelector('.collection-products[data-collection="1"]');
                    if (firstCollection) {
                      firstCollection.classList.add('active');
                    }
                  });
