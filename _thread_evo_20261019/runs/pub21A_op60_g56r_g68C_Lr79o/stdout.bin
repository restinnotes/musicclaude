{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"细碎的光点再缓缓飘落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"关系会改变\"\n        },\n        {\n          \"quote\": \"整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"整个人交给水浪\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现自己\",\n          \"point\": \"很想靠近\",\n          \"where\": \"中\",\n          \"waste\": \"自己\",\n          \"keep\": \"忽然发现\"\n        },\n        {\n          \"text\": \"他怕显得太需要\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只敢\"\n        },\n        {\n          \"text\": \"这点亲近已让他\",\n          \"point\": \"下次还敢更坦白吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还敢\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"温柔托举\"\n        },\n        {\n          \"quote\": \"裹在皮肤上有些黏稠\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"还没有失去，就已经生出一丝舍不得\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"他才慢慢放松\",\n          \"where\": \"后\",\n  