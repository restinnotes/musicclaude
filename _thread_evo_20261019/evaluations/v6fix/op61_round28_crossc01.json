      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "242–253",
    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "他这一回能够较坦然地认可自己：仍留恋旧日的归属，也仍愿按自己的分寸过眼前的日子。",
      "key": "他这一回能够较坦",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-2",
       "S11-3"
      ]
     },
     {
      "id": "S12-2",
      "text": "怀念偶尔突然刺他一下，他的把握也会短促地一晃，但并未因此改变行事的方向。",
      "key": "怀念偶尔突然刺他",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-3",
       "S12-1"
      ]
     },
     {
      "id": "S12-3",
      "text": "这样的坚定比先前那种硬撑更靠得住，因为他已经不必装作一点都不舍得。",
      "key": "这样的坚定比先前",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-2",
       "S12-1",
       "S12-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S06-2",
