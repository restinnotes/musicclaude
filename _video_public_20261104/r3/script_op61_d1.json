 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "kind": "说不清的空落",
     "emotion": "孤单",
     "lines": [
      {
       "text": "这份笃定没撑多久，心里就空落落的，一时说不清到底舍不得什么。",
       "keys": [
        "空落落的",
        "说不清",
        "舍不得什么",
        "舍不得什么"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像要宣告什么，重量却没被接住，轻了、远了，悬在半空。",
       "keys": [
        "重量",
        "没被接住",
        "悬在半空",
        "悬在半空"
       ],
       "emotion": "悬着",
       "from": [
        "S01-B2-p1"
       ]
      },
      {
       "text": "像一次召唤，停顿里还在等回声。",
       "keys": [
        "一次召唤",
        "等回声",
        "等回声"
       ],
       "emotion": "悬着",
       "from": [
        "S01-B2-p2"
       ]
      },
      {
       "text": "像叹息，刚冒出来就被长停顿截断。",
       "keys": [
        "叹息",
        "截断",
        "截断"
       ],
       "from": [
        "S01-B3-p1"
       ]
      },
      {
       "text": "余音在冰冷的空气里慢慢散尽。",
       "keys": [
        "冰冷的空气",
        "慢慢散尽",
        "慢慢散尽"
       ],
       "from": [
        "S01-B3-p2"
       ]
      },
      {
       "text": "心里明明有东西，却分不清是愤怒、遗憾还是怀念。",
       "keys": [
        "明明有东西",
        "愤怒、遗憾还是怀念",
        "愤怒、遗憾还是怀念"
       ],
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "刚从昏沉中醒来，四周冷而空，胸口发紧，视线模糊。",
       "keys": [
        "冷而空",
        "胸口发紧",
        "视线模糊",
        "视线模糊"
       ],
       "emotion": "悬着",
       "from": [
        "S01-B4-p1"
       ]
      },
      {
       "text": "伸出手去摸，摸到的却只有虚空。",
       "keys": [
        "伸出手",
        "只有虚空",
        "只有虚空"
       ],
       "from": [
        "S01-B4-p2"
       ]
      },
      {
       "text": "连自己身在何处都还没弄清。",
       "keys": [
        "身在何处",
        "没弄清",
        "没弄清"
       ],
       "emotion": "悬着",
       "from": [
        "S01-B4-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "逼自己站住",
     "emotion": "不安",
     "lines": [
      {
       "text": "离开那段熟悉的生活，总算不用再一次次委屈自己。",
       "keys": [
        "离开",
        "不用再",
        "委屈自己",
        "委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "强迫自己挺直背脊，提醒自己不能倒下。",
       "keys": [
        "挺直背脊",
        "不能倒下",
        "不能倒下"
       ],
       "from": [
        "S01-B1-p1"
       ]
      },
      {
       "text": "尊严还在，行动的方向和力气却不稳；其实很想停下来。",
       "keys": [
        "尊严还在",
        "方向和力气却不稳",
        "很想停下来",
        "很想停下来"
       ],
       "from": [
        "S01-B1-p2",
        "S01-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "旧日浮现，脚步未稳",
     "emotion": "悬着",
     "lines": [
      {
       "text": "偶尔想起从前熟悉的日子，还是想往前过，却不知道以后靠什么安下心。",
       "keys": [
        "熟悉的日子",
        "想往前过",
        "靠什么安下心",
        "靠什么安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧场景忽然回来，当时熟悉的声音和感觉都回来了。",
       "keys": [
        "旧场景",
        "熟悉的声音",
        "感觉都回来了",
        "感觉都回来了"
       ],
       "from": [
        "S01-B5-p1"
       ]
      },
      {
       "text": "记忆再清晰，过去也不会重新变成现在。",
       "keys": [
        "记忆再清晰",
        "不会",
        "重新变成现在",
        "重新变成现在"
       ],
       "emotion": "孤单",
       "from": [
        "S01-B5-p2"
       ]
      },
      {
       "text": "身体先于意识，隐约记起了该如何迈步。",
       "keys": [
        "身体先于意识",
        "如何迈步",
        "如何迈步"
       ],
       "emotion": "安心",
       "from": [
        "S01-B5-p3"
       ]
      },
      {
       "text": "只是向前的牵引，还没有真正站稳。",
       "keys": [
        "向前的牵引",
        "没有真正站稳",
        "没有真正站稳"
       ],
       "from": [
        "S01-B5-p4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "kind": "舍不得旧日的自在",
     "emotion": "孤单",
     "lines": [
      {
       "text": "舍不得从前那些自在的时候，想到以后不能再像那样过日子，心里就有些慌。",
       "keys": [
        "舍不得",
        "自在的时候",
        "有些慌",
        "有些慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "步子终于清楚了，却不像英雄凯旋。",
       "keys": [
        "步子终于清楚",
        "不像英雄凯旋",
        "不像英雄凯旋"
       ],
       "from": [
        "S02-B1-p1"
       ]
      },
      {
       "text": "像一首从远处传来的旧歌，依稀记得，却只能模糊地哼出几句。",
       "keys": [
        "远处传来的旧歌",
        "依稀记得",
        "模糊地哼",
        "模糊地哼"
       ],
       "from": [
        "S02-B1-p2"
       ]
      },
      {
       "text": "外面有一点庄严，心里却像在低声哼唱自己的旧日记忆。",
       "keys": [
        "庄严",
        "低声哼唱",
        "低声哼唱"
       ],
       "from": [
        "S02-B1-p3"
       ]
      },
      {
       "text": "珍惜的东西仿佛还在，却已经不能像从前那样拥有。",
       "keys": [
        "珍惜的东西",
        "还在",
        "不能像从前那样拥有",
        "不能像从前那样拥有"
       ],
       "from": [
        "S02-B1-p4"
       ]
      },
      {
       "text": "腿脚虚浮，像在记忆里挪动舞步。",
       "keys": [
        "腿脚虚浮",
        "记忆里",
        "挪动舞步",
        "挪动舞步"
       ],
       "emotion": "悬着",
       "from": [
        "S02-B2-p1"
       ]
      },
      {
       "text": "节奏庄严、傲慢，心里的旋律却脆弱凄婉。",
       "keys": [
        "庄严、傲慢",
        "脆弱凄婉",
        "脆弱凄婉"
       ],
       "emotion": "不安",
       "from": [
        "S02-B2-p2"
       ]
      },
      {
       "text": "底下还有细碎、不安的东西在蠕动。",
       "keys": [
        "细碎",
        "不安",
        "蠕动",
        "蠕动"
       ],
       "emotion": "不安",
       "from": [
        "S02-B2-p3"
       ]
      },
      {
       "text": "刚提起一点劲，又退了下来。",
       "keys": [
        "下来"
       ],
       "emotion": "不安",
       "from": [
        "S02-B3-p1"
       ]
      },
      {
       "text": "再次聚拢力量，越发焦灼，最后还是没能舒服地落地。",
       "keys": [
        "聚拢力量",
        "焦灼",
        "没能"
       ],
       "emotion": "不安",
       "from": [
        "S02-B3-p2"
       ]
      },
      {
       "text": "连绵不断，呼吸越来越急。",
       "keys": [
        "越来越急",
        "呼吸",
        "呼吸"
       ],
       "emotion": "不安",
       "from": [
        "S02-B3-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "把自己重新绷住",
     "emotion": "不安",
     "lines": [
      {
       "text": "一舍不得，就赶紧想起受过的那些气，怕一心软，连当初为什么要走都忘了。",
       "keys": [
        "受过的那些气",
        "一心软",
        "为什么要走",
        "为什么要走"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "强烈地控制自己，整理好衣服，抬起头，不让别人看见动摇。",
       "keys": [
        "控制自己",
        "抬起头",
        "不让别人看见动摇",
        "不让别人看见动摇"
       ],
       "from": [
        "S02-B4-p1",
        "S02-B4-p2"
       ]
      },
      {
       "text": "一遍遍对自己说没事，越说越像是在努力相信。",
       "keys": [
        "努力"
       ],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "悲伤还在，只是不愿把自己完全交给悲伤。",
       "keys": [
        "悲伤还在",
        "不愿",
        "完全交给悲伤",
        "完全交给悲伤"
       ],
       "from": [
        "S02-B4-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "不甘心全都丢掉",
     "emotion": "炽热",
     "lines": [
      {
       "text": "难道为了不再受那些气，就得把以前的好日子也一起丢掉吗？",
       "keys": [
        "不再受那些气",
        "好日子",
        "一起丢掉吗",
        "一起丢掉吗"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "我不甘心就这样消亡。",
       "keys": [
        "不甘心",
        "消亡",
        "消亡"
       ],
       "from": [
        "S02-B5-p1"
       ]
      },
      {
       "text": "不是轻松恢复自信，是不肯就这样认输。",
       "keys": [
        "不是轻松",
        "不肯",
        "认输",
        "认输"
       ],
       "from": [
        "S02-B5-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "kind": "憋着气，忽然想起亲近",
     "emotion": "不安",
     "lines": [
      {
       "text": "心里还憋着一股气，可想起从前有人把自己当作自己人，竟又高兴了一小会儿。",
       "keys": [
        "憋着一股气",
        "当作自己人",
        "高兴了一小会儿",
        "高兴了一小会儿"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像重锤砸下，心里带着愤怒与抗拒。",
       "keys": [
        "重锤",
        "愤怒",
        "抗拒",
        "抗拒"
       ],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "忽强忽弱，心里总悬着。",
       "keys": [
        "忽强忽弱",
        "心里"
       ],
       "from": [
        "S03-B1-p2"
       ]
      },
      {
       "text": "想往前走，却无法平静地决定方向。",
       "keys": [
        "想往前走",
        "无法平静",
        "决定方向",
        "决定方向"
       ],
       "from": [
        "S03-B1-p3"
       ]
      },
      {
       "text": "前一刻还焦躁、急切，忽然就柔和、亲切起来。",
       "keys": [
        "焦躁、急切",
        "柔和、亲切",
        "柔和、亲切"
       ],
       "emotion": "亲密",
       "from": [
        "S03-B2-p1"
       ]
      },
      {
       "text": "像故乡夏日的麦浪与微风。",
       "keys": [
        "故乡夏日",
        "麦浪",
        "微风",
        "微风"
       ],
       "emotion": "亲密",
       "from": [
        "S03-B2-p2"
       ]
      },
      {
       "text": "想起那些轻松、亲近、不必时时防备的时刻。",
       "keys": [
        "轻松",
        "亲近",
        "不必时时防备",
        "不必时时防备"
       ],
       "emotion": "亲密",
       "from": [
        "S03-B2-p3"
       ]
      },
      {
       "text": "像多个人在耳边低声絮语，彼此缠绕，找不到出口。",
       "keys": [
        "低声絮语",
        "彼此缠绕",
        "找不到出口",
        "找不到出口"
       ],
       "from": [
        "S03-B3-p1"
       ]
      },
      {
       "text": "抓不住重心，四处漂移。",
       "keys": [
        "抓不住重心",
        "四处漂移",
        "四处漂移"
       ],
       "from": [
        "S03-B3-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "高兴过后又心酸",
     "emotion": "孤单",
     "lines": [
      {
       "text": "那点高兴还没退，心里就酸了：从前的日子过不成了，离开以后就一定会更好吗？",
       "keys": [
        "心里就酸了",
        "过不成了",
        "一定会更好吗",
        "一定会更好吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "越温柔，越能感觉它与眼前处境的距离。",
       "keys": [
        "温柔",
        "眼前处境的距离",
        "眼前处境的距离"
       ],
       "emotion": "亲密",
       "from": [
        "S03-B2-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "暂时躲开伤口",
     "emotion": "安心",
     "lines": [],
     "beads": [
      {
       "text": "暂时侧过身，不再正面迎着那个沉重的问题，聊点别的，出去走走。",
       "keys": [
        "不再正面",
        "暂时"
       ],
       "from": [
        "S03-B4-p1"
       ]
      },
      {
       "text": "那一刻的轻松可以是真的，不是装出来的。",
       "keys": [
        "轻松",
        "可以是真的",
        "可以是真的"
       ],
       "from": [
        "S03-B4-p2"
       ]
      },
      {
       "text": "只是心里的事还没有答案。",
       "keys": [
        "没有",
        "答案"
       ],
       "emotion": "悬着",
       "from": [
        "S03-B4-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "热劲慢慢退潮",
     "emotion": "悬着",
     "lines": [],
     "beads": [
      {
       "text": "刚才那股昂扬，正在慢慢退下去。",
       "keys": [
        "昂扬",
        "慢慢退"
       ],
       "from": [
        "S03-B5-p1"
       ]
      },
      {
       "text": "我刚才是真的相信那些话，还是只是在努力让自己相信？",
       "keys": [
        "真的相信",
        "努力让自己相信",
        "努力让自己相信"
       ],
       "from": [
        "S03-B5-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "kind": "盼着旧日再回来",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起那些亲近的时候，真盼着一切还能照从前那样继续。",
       "keys": [
        "亲近的时候",
        "真盼着",
        "照从前那样继续",
        "照从前那样继续"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的旋律又回来了，像在独自诉说心事。",
       "keys": [
        "熟悉",
        "又回来了",
        "独自"
       ],
       "from": [
        "S04-B1-p1"
       ]
      },
      {
       "text": "旧记忆忽然鲜活，带出感激、亲密、柔情和短暂的幸福。",
       "keys": [
        "旧记忆",
        "感激",
        "亲密",
        "短暂的幸福",
        "短暂的幸福"
       ],
       "from": [
        "S04-B1-p2"
       ]
      },
      {
       "text": "原来的姿态回来了，却更柔软，也更容易受伤。",
       "keys": [
        "回来了",
        "更柔软",
        "容易受伤",
        "容易受伤"
       ],
       "emotion": "孤单",
       "from": [
        "S04-B1-p3"
       ]
      },
      {
       "text": "这份坚定，也许只是努力想成为的样子，不再是毫无疑问的事实。",
       "keys": [
        "努力想成为",
        "不再是",
        "毫无疑问",
        "毫无疑问"
       ],
       "emotion": "悬着",
       "from": [
        "S04-B1-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "越想越乱",
     "emotion": "不安",
     "lines": [
      {
       "text": "又怀疑当初是不是走错了，却怎么也想不出，要是没走，如今会怎样。",
       "keys": [
        "是不是走错了",
        "要是没走",
        "会怎样",
        "会怎样"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚刚还有些温暖，转眼就变得激烈、紧绷，越用力越不安稳。",
       "keys": [
        "温暖",
        "激烈",
        "紧绷",
        "不安稳",
        "不安稳"
       ],
       "from": [
        "S04-B2-p1"
       ]
      },
      {
       "text": "不是记忆变坏了，而是它太好了，过去却无法原样回来。",
       "keys": [
        "记忆",
        "太好了",
        "无法原样回来",
        "无法原样回来"
       ],
       "emotion": "孤单",
       "from": [
        "S04-B2-p2"
       ]
      },
      {
       "text": "一边抵抗，一边疲惫地往后退。",
       "keys": [
        "疲惫",
        "疲惫"
       ],
       "from": [
        "S04-B2-p3"
       ]
      },
      {
       "text": "细碎的音符像急促的脚步，或乱了拍的心跳。",
       "keys": [
        "急促的脚步",
        "乱了拍的心跳",
        "乱了拍的心跳"
       ],
       "from": [
        "S04-B3-p1"
       ]
      },
      {
       "text": "像被时间催着往前跑，连身体都无法停下。",
       "keys": [
        "时间催着",
        "往前跑",
        "无法停下",
        "无法停下"
       ],
       "from": [
        "S04-B3-p2"
       ]
      },
      {
       "text": "如果当时……是不是还可以……究竟为什么会变成这样……",
       "keys": [
        "如果当时",
        "是不是还可以",
        "为什么会变成这样",
        "为什么会变成这样"
       ],
       "from": [
        "S04-B4-p1"
       ]
      },
      {
       "text": "动作越来越多，却没有真正抵达哪里。",
       "keys": [
        "越来越多",
        "没有真正抵达",
        "没有真正抵达"
       ],
       "from": [
        "S04-B4-p2"
       ]
      },
      {
       "text": "不停往前赶，只是为了避免停下来。",
       "keys": [
        "避免停下来",
        "避免停下来"
       ],
       "from": [
        "S04-B4-p3"
       ]
      },
      {
       "text": "思绪反复盘旋，想弄清楚，却始终无法停歇。",
       "keys": [
        "反复盘旋",
        "想弄清楚",
        "无法停歇",
        "无法停歇"
       ],
       "from": [
        "S04-B4-p4"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "kind": "旧日重新有温度",
     "emotion": "亲密",
     "lines": [
      {
       "text": "连过去开心的事都不敢多想，也太为难自己了。",
       "keys": [
        "过去开心的事",
        "不敢多想",
        "太为难自己",
        "太为难自己"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "忽然柔和下来，像有人终于肯轻声说说心里话。",
       "keys": [
        "柔和",
        "声说"
       ],
       "from": [
        "S05-B1-p1",
        "S05-B1-p2"
       ]
      },
      {
       "text": "旧日的记忆重新有了温度。",
       "keys": [
        "有了温度",
        "有了温度"
       ],
       "from": [
        "S05-B3-p1"
       ]
      },
      {
       "text": "想起某个人，也可能是故乡，或过去的生活。",
       "keys": [
        "某个人",
        "故乡",
        "过去的生活",
        "过去的生活"
       ],
       "from": [
        "S05-B3-p2"
       ]
      },
      {
       "text": "正因为已经过去，眷恋里也带着失落。",
       "keys": [
        "已经过去",
        "眷恋",
        "失落",
        "失落"
       ],
       "emotion": "孤单",
       "from": [
        "S05-B3-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "不服气还在",
     "emotion": "炽热",
     "lines": [
      {
       "text": "当初那些气不该忍。",
       "keys": [
        "那些气",
        "不该忍",
        "不该忍"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "再柔和也没有抹掉向前的劲，心里还是有句话：这件事不能就这样算了。",
       "keys": [
        "没有抹掉",
        "向前的劲",
        "不能就这样算了",
        "不能就这样算了"
       ],
       "from": [
        "S05-B2-p1"
       ]
      },
      {
       "text": "里面有愤怒，有悲伤，也有想维护自己的那股劲。",
       "keys": [
        "愤怒",
        "悲伤",
        "维护自己",
        "维护自己"
       ],
       "from": [
        "S05-B2-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "争累了，只剩难受",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争得没了力气，不服气渐渐淡了，想到自己已经不在那些人身边，只觉得难受。",
       "keys": [
        "没了力气",
        "不服气渐渐淡了",
        "不在那些人身边",
        "难受",
        "难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "还在往前流，后来渐渐放缓、变稀，最后慢下来。",
       "keys": [
        "渐渐放缓",
        "变稀",
        "慢下来",
        "慢下来"
       ],
       "emotion": "悬着",
       "from": [
        "S05-B4-p1"
       ]
      },
      {
       "text": "脚下原有的地板忽然不见了，只剩一个声音自己说话。",
       "keys": [
        "地板忽然不见",
        "只剩一个声音",
        "只剩一个声音"
       ],
       "from": [
        "S05-B4-p2"
       ]
      },
      {
       "text": "躁动和不安又加深了。",
       "keys": [
        "躁动",
        "不安",
        "加深",
        "加深"
       ],
       "emotion": "不安",
       "from": [
        "S05-B5-p1"
       ]
      },
      {
       "text": "像几次深呼吸，或一声深深的叹息，紧绷终于松开一点。",
       "keys": [
        "深呼吸",
        "深深的叹息",
        "松开一点",
        "松开一点"
       ],
       "emotion": "安心",
       "from": [
        "S05-B5-p2"
       ]
      },
      {
       "text": "不是已经想通了，只是抵抗得累了。",
       "keys": [
        "不是已经想通",
        "抵抗得累了",
        "抵抗得累了"
       ],
       "from": [
        "S05-B5-p3"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "kind": "终于能松开戒备",
     "emotion": "安心",
     "lines": [
      {
       "text": "心里的难受慢慢缓下来，又想起以前和人在一起、不必时时防备的时候，这回没急着拿受过的气压住这份想念。",
       "keys": [
        "难受慢慢缓下来",
        "不必时时防备",
        "想念",
        "想念"
       ],
       "from": [
        "S06-1"
       ]
      },
      {
       "text": "离开以后，遇上难熬的事常常只能自己挺过去，这才知道从前有人在身边能让自己轻松多少。",
       "keys": [
        "只能自己挺过去",
        "有人在身边",
        "轻松多少",
        "轻松多少"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "忽然滑进一片与此前世界隔开的静谧。",
       "keys": [
        "隔开",
        "静谧",
        "静谧"
       ],
       "from": [
        "S06-B1-p1"
       ]
      },
      {
       "text": "声音绵长、从容，仿佛可以一直停在那里。",
       "keys": [
        "绵长",
        "从容"
       ],
       "from": [
        "S06-B1-p2"
       ]
      },
      {
       "text": "整个世界像隔着一层透明玻璃，连呼吸都不愿惊动它。",
       "keys": [
        "透明玻璃",
        "连呼吸都不愿惊动",
        "连呼吸都不愿惊动"
       ],
       "from": [
        "S06-B1-p3"
       ]
      },
      {
       "text": "像母亲在耳畔轻轻哼唱的摇篮曲，终于可以暂时松开戒备。",
       "keys": [
        "母亲",
        "轻轻哼唱",
        "摇篮曲",
        "松开戒备",
        "松开戒备"
       ],
       "emotion": "亲密",
       "from": [
        "S06-B1-p4"
       ]
      },
      {
       "text": "只是这份安宁，不代表现实已经变好，也不能永远停留。",
       "keys": [
        "安宁",
        "现实",
        "不能永远停留",
        "不能永远停留"
       ],
       "emotion": "悬着",
       "from": [
        "S06-B1-p5"
       ]
      },
      {
       "text": "终于不用向别人解释为什么难过，也不用维持应该坚强的样子。",
       "keys": [
        "为什么难过",
        "不用",
        "坚强",
        "坚强"
       ],
       "from": [
        "S06-B2-p1",
        "S06-B2-p2"
       ]
      },
      {
       "text": "那些压住的愿望、委屈和思念，终于有机会浮现。",
       "keys": [
        "愿望",
        "委屈",
        "思念",
        "浮现",
        "浮现"
       ],
       "emotion": "亲密",
       "from": [
        "S06-B2-p3"
       ]
      },
      {
       "text": "向一个遥远、并不确定的对象祈求，愿望真切，却没有许诺回应。",
       "keys": [
        "遥远",
        "愿望真切",
        "没有"
       ],
       "emotion": "悬着",
       "from": [
        "S06-B2-p4"
       ]
      },
      {
       "text": "远方忽然亮了，已经远去的家园在梦里显现。",
       "keys": [
        "远方",
        "家园",
        "梦里显现",
        "梦里显现"
       ],
       "emotion": "亲密",
       "from": [
        "S06-B2-p5"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "还想再有那样的日子",
     "emotion": "亲密",
     "lines": [
      {
       "text": "很想再过上那种不用多说也知道彼此亲近的日子，又怕以后再也没有了。",
       "keys": [
        "不用多说",
        "彼此亲近",
        "再也没有",
        "再也没有"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "一开始还有些含蓄、试探，终于慢慢鼓起勇气说出心里的话。",
       "keys": [
        "含蓄",
        "试探",
        "鼓起勇气",
        "心里的话",
        "心里的话"
       ],
       "from": [
        "S06-B3-p1"
       ]
      },
      {
       "text": "再次展开，心里的话变得更充实，也更迫切。",
       "keys": [
        "再次展开",
        "更充实",
        "更迫切",
        "更迫切"
       ],
       "from": [
        "S06-B3-p2"
       ]
      },
      {
       "text": "最后又停在一句没说完的话上。",
       "keys": [
        "没说完的话",
        "没说完的话"
       ],
       "emotion": "悬着",
       "from": [
        "S06-B3-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "珍惜过，不必抓回来",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "那样的日子毕竟真真切切过过，光是这么想着，心里也暖和了一点。",
       "keys": [
        "真真切切过过",
        "想着",
        "暖和了一点",
        "暖和了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "明知有些事已经挽不回，就放轻声音，好好看着它。",
       "keys": [
        "挽不回",
        "放轻声音",
        "好好看着",
        "好好看着"
       ],
       "from": [
        "S06-B4-p1"
       ]
      },
      {
       "text": "看着自己珍惜的东西，不必立刻把它抓回来。",
       "keys": [
        "珍惜的东西",
        "不必",
        "抓回来",
        "抓回来"
       ],
       "from": [
        "S06-B4-p2"
       ]
      }
     ]
    }
   ]
  },
  {
