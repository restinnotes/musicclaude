  {
   "bars": "216–225",
   "relation": "正在面对",
   "items": [
    {
     "id": "I86",
     "text": "委屈再次激起他的不甘。",
     "key": "激起他的不甘",
     "kind": ""
    },
    {
     "id": "I87",
     "text": "他不肯低头的劲头再次涌上来。",
     "key": "再次涌上来",
     "kind": ""
    },
    {
     "id": "I88",
     "text": "这次他抗拒得更加迫切。",
     "key": "更加迫切",
     "kind": ""
    },
    {
     "id": "I89",
     "text": "他明白自己拒绝的并非亲近本身。",
     "key": "亲近本身",
     "kind": "分清"
    },
    {
     "id": "I90",
     "text": "他仍无法接受为了亲近而看轻自己。",
     "key": "看轻自己",
     "kind": ""
    },
    {
     "id": "I91",
     "text": "如今每次强硬都牵动他珍惜的过去。",
     "key": "珍惜的过去",
     "kind": ""
    },
    {
     "id": "I92",
     "text": "他感到坚持不低头也会令自己疼痛。",
     "key": "令自己疼痛",
     "kind": "选择的代价"
    },
    {
     "id": "I93",
     "text": "他心里有几乎冲破倔强的悲伤。",
     "key": "冲破倔强",
     "kind": ""
    }
   ],
   "because": [
