 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己很想靠近 / 心里一下热起来，连自己都意外",
       "keys": [
        "很想靠近",
        "心里一下热起来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夏夜里突然升起一束烟花，光点慢慢落下，却还悬在水面上",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方觉得自己太需要这份亲近 / 所以只敢露出一点喜欢",
