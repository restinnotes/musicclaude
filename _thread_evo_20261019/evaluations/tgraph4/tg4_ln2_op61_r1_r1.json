{
 "center": "维持尊严的行动与对旧日生活及归属的怀念反复拉扯",
 "segments": [
  {
   "bars": "1–23",
   "relation": "还说不清",
   "items": [
    {
     "id": "I1",
     "text": "他知道有些东西已经回不去了。",
     "key": "回不去了",
     "kind": ""
    },
    {
     "id": "I2",
     "text": "他还说不清究竟放不下什么。",
     "key": "说不清",
     "kind": ""
    },
    {
     "id": "I3",
     "text": "他怀念那时不用时时想着自己是谁。",
     "key": "自己是谁",
     "kind": ""
    },
    {
     "id": "I4",
     "text": "他那时不必费力争取就觉得自己被接纳。",
     "key": "不必费力",
     "kind": ""
    },
    {
     "id": "I5",
     "text": "如今他已无法依靠从前那份安心。",
     "key": "无法依靠",
     "kind": ""
    },
    {
     "id": "I6",
     "text": "他连该怎样对待怀念都不知道。",
     "key": "怎样对待",
     "kind": ""
    },
    {
     "id": "I7",
     "text": "回想旧日，他心里会暖一下。",
     "key": "暖一下",
     "kind": ""
    },
    {
     "id": "I8",
     "text": "他怕往后只能靠回忆确认自己曾过得好。",
     "key": "只能靠回忆",
     "kind": ""
    },
    {
     "id": "I9",
     "text": "他不愿这样依靠过去。",
     "key": "不愿这样",
     "kind": ""
    },
    {
     "id": "I10",
     "text": "他仍舍不得放下过去。",
     "key": "舍不得",
     "kind": ""
    },
    {
     "id": "I11",
     "text": "他还不知道能做什么。",
     "key": "不知道",
     "kind": ""
    },
    {
     "id": "I12",
     "text": "他隐约觉得不能任失去摆布。",
     "key": "隐约觉得",
     "kind": ""
    }
   ],
   "because": []
  },
  {
   "bars": "24–65",
   "relation": "正在面对",
   "items": [
    {
     "id": "I13",
     "text": "他开始关心自己仍能怎样生活。",
     "key": "怎样生活",
     "kind": ""
    },
    {
     "id": "I14",
     "text": "他不愿因过去无法恢复就低头。",
     "key": "低头",
     "kind": ""
    },
    {
     "id": "I15",
     "text": "他不想只等着外来的安慰。",
     "key": "外来的安慰",
     "kind": ""
    },
    {
     "id": "I16",
     "text": "他仍能坚持自己认为值得的事。",
     "key": "值得的事",
     "kind": ""
    },
    {
     "id": "I17",
     "text": "他不愿为被接纳而放低对自己的要求。",
     "key": "被接纳",
     "kind": ""
    },
    {
     "id": "I18",
     "text": "他原先无处着力的难受终于有了出口。",
     "key": "有了出口",
     "kind": ""
    },
    {
     "id": "I19",
     "text": "他发现自己仍能肯定自己。",
     "key": "肯定自己",
     "kind": ""
    },
    {
     "id": "I20",
     "text": "他感到失去没有夺走自己的一切。",
     "key": "没有夺走",
     "kind": ""
    },
    {
     "id": "I21",
     "text": "他确实比先前更有力量。",
     "key": "更有力量",
     "kind": ""
    },
    {
     "id": "I22",
     "text": "如今想起过去，他不再只看见自己的缺憾。",
     "key": "不再只看见",
     "kind": ""
    },
    {
     "id": "I23",
     "text": "他为仍能维护珍贵之物而感到骄傲。",
     "key": "感到骄傲",
     "kind": ""
    },
    {
     "id": "I24",
     "text": "他仿佛能凭自己的意志继续向前。",
     "key": "仿佛能",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I12",
     "to": "I13",
     "rel": "提供理由"
    },
    {
     "from": "I10",
     "to": "I17",
     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "66–91",
   "relation": "正在面对",
   "items": [
    {
     "id": "I25",
     "text": "他想留住来之不易的骄傲。",
     "key": "留住",
     "kind": ""
    },
    {
     "id": "I26",
     "text": "他开始相信只要不退让，缺憾便伤不了他。",
     "key": "开始相信",
     "kind": ""
    },
    {
     "id": "I27",
     "text": "曾需反复鼓励的坚持，如今让他兴奋。",
     "key": "让他兴奋",
     "kind": ""
    },
    {
     "id": "I28",
     "text": "他喜欢不再犹疑的自己。",
     "key": "不再犹疑",
     "kind": ""
    },
    {
     "id": "I29",
     "text": "他不愿再被怀念牵着走。",
     "key": "牵着走",
     "kind": ""
    },
    {
     "id": "I30",
     "text": "他试着让坚定占满内心。",
     "key": "占满内心",
     "kind": ""
    },
    {
     "id": "I31",
     "text": "他仍想念不用独自支撑一切的生活。",
     "key": "独自支撑",
     "kind": ""
    },
    {
     "id": "I32",
     "text": "他起初仿佛觉得承认牵挂会损害力量。",
     "key": "起初仿佛",
     "kind": ""
    },
    {
     "id": "I33",
     "text": "他发现旧日幸福也曾给他信心和勇气。",
     "key": "信心和勇气",
     "kind": ""
    },
    {
     "id": "I34",
     "text": "那份幸福曾让他坦然地做自己。",
     "key": "坦然",
     "kind": ""
    },
    {
     "id": "I35",
     "text": "他意识到如今的自己仍受过去塑造。",
     "key": "过去塑造",
     "kind": ""
    },
    {
     "id": "I36",
     "text": "他对意志能解决一切不再那么确信。",
     "key": "不再那么确信",
     "kind": "办法的限度"
    }
   ],
   "because": [
    {
     "from": "I23",
     "to": "I25",
     "rel": "唤起"
    },
    {
     "from": "I24",
     "to": "I26",
     "rel": "提供理由"
    },
    {
     "from": "I10",
     "to": "I31",
     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "92–115",
   "relation": "正在面对",
   "items": [
    {
     "id": "I37",
     "text": "他不忍再把怀念当成软弱。",
     "key": "当成软弱",
     "kind": ""
    },
    {
     "id": "I38",
     "text": "他渐渐放松了必须坚强的要求。",
     "key": "放松",
     "kind": ""
    },
    {
     "id": "I39",
     "text": "他允许亲近、自在和被理解的感觉回来。",
     "key": "被理解",
     "kind": ""
    },
    {
     "id": "I40",
     "text": "他怀念那时不必时时提防失去。",
     "key": "提防失去",
     "kind": ""
    },
    {
     "id": "I41",
     "text": "他怀念不用证明自己值得被爱、值得留下的日子。",
     "key": "值得被爱",
     "kind": ""
    },
    {
     "id": "I42",
     "text": "他为自己曾那样安心地生活而高兴。",
     "key": "安心地生活",
     "kind": ""
    },
    {
     "id": "I43",
     "text": "他不再急着拿过去衡量现在缺少什么。",
     "key": "衡量现在",
     "kind": ""
    },
    {
     "id": "I44",
     "text": "他重新感到熟悉的温暖。",
     "key": "熟悉的温暖",
     "kind": ""
    },
    {
     "id": "I45",
     "text": "他愿相信那份幸福即使不能重来仍有意义。",
     "key": "仍有意义",
     "kind": ""
    },
    {
     "id": "I46",
     "text": "有一阵子，他几乎满足于只是想念。",
     "key": "几乎满足",
     "kind": ""
    },
    {
     "id": "I47",
     "text": "他发现不用硬起心也能珍惜过去。",
     "key": "珍惜过去",
     "kind": ""
    },
    {
     "id": "I48",
     "text": "他渐渐无法回避不能重新拥有的遗憾。",
     "key": "无法回避",
     "kind": ""
    },
    {
     "id": "I49",
     "text": "他因那份幸福不再属于眼前而隐隐发痛。",
     "key": "隐隐发痛",
     "kind": "满足照出未满足"
    }
   ],
   "because": [
    {
     "from": "I33",
     "to": "I37",
     "rel": "改写"
    },
    {
     "from": "I36",
     "to": "I38",
     "rel": "提供理由"
    },
    {
     "from": "I1",
     "to": "I48",
     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "116–147",
   "relation": "正在面对",
   "items": [
    {
     "id": "I50",
     "text": "他更难接受眼前缺少的亲近。",
     "key": "难接受",
     "kind": ""
    },
    {
     "id": "I51",
     "text": "他发现想念无法让旧日生活重来。",
     "key": "旧日生活重来",
     "kind": "办法的限度"
    },
    {
     "id": "I52",
     "text": "他知道坚持能使自己不被失去压倒。",
     "key": "不被失去",
     "kind": ""
    },
    {
     "id": "I53",
     "text": "他发现坚持无法找回亲近与理解。",
     "key": "无法找回",
     "kind": "办法的限度"
    },
    {
     "id": "I54",
     "text": "他感到恼怒又委屈。",
     "key": "恼怒又委屈",
     "kind": ""
    },
    {
     "id": "I55",
     "text": "他觉得自己并未奢望不该得的东西。",
     "key": "并未奢望",
     "kind": ""
    },
    {
     "id": "I56",
     "text": "他不明白两样珍贵之物为何竟像无法同时保全。",
     "key": "无法同时保全",
     "kind": ""
    },
    {
     "id": "I57",
     "text": "他不愿为重新被接纳而委屈自己。",
     "key": "委屈自己",
     "kind": ""
    },
    {
     "id": "I58",
     "text": "他也不愿永远独自撑下去。",
     "key": "独自撑",
     "kind": ""
    },
    {
     "id": "I59",
     "text": "他又试着严厉要求自己。",
     "key": "严厉要求",
     "kind": ""
    },
    {
     "id": "I60",
     "text": "他劝自己别拿过去衡量一切，得往前走。",
     "key": "衡量一切",
     "kind": ""
    },
    {
     "id": "I61",
     "text": "这番劝告一度使他恢复坚定。",
     "key": "恢复坚定",
     "kind": ""
    },
    {
     "id": "I62",
     "text": "他却很快感到疲惫。",
     "key": "疲惫",
     "kind": ""
    },
    {
     "id": "I63",
     "text": "他想压下怀念时，仿佛在否认旧日幸福。",
     "key": "仿佛在否认",
     "kind": ""
    },
    {
     "id": "I64",
     "text": "他放任怀念时，又容易觉得现在不够好。",
     "key": "现在不够好",
     "kind": ""
    },
    {
     "id": "I65",
     "text": "他怀疑维护自尊是否非得拒绝怀念。",
     "key": "是否非得",
     "kind": ""
    },
    {
     "id": "I66",
     "text": "他答不上来，也不想急着回答。",
     "key": "答不上来",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I44",
     "to": "I50",
     "rel": "唤起"
    },
    {
     "from": "I21",
     "to": "I53",
     "rel": "限制"
    },
    {
     "from": "I17",
     "to": "I57",
     "rel": "仍在起作用"
    },
    {
     "from": "I10",
     "to": "I63",
     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "148–180",
   "relation": "正在面对",
   "items": [
    {
     "id": "I67",
     "text": "他不再逼自己立刻分出轻重。",
     "key": "不再逼",
     "kind": ""
    },
    {
     "id": "I68",
     "text": "他心里慢慢安静下来。",
     "key": "安静下来",
     "kind": ""
    },
    {
     "id": "I69",
     "text": "他仍想念过去，却不再拿过去要求现在。",
     "key": "要求现在",
     "kind": ""
    },
    {
     "id": "I70",
     "text": "他也不再急着从怀念里抽身。",
     "key": "抽身",
     "kind": ""
    },
    {
     "id": "I71",
     "text": "那段亲近让他愿意相信生活。",
     "key": "相信生活",
     "kind": ""
    },
    {
     "id": "I72",
     "text": "他也因此愿意善待别人。",
     "key": "善待别人",
     "kind": ""
    },
    {
     "id": "I73",
     "text": "那时他愿意认真坚持自己看重的事。",
     "key": "认真坚持",
     "kind": ""
    },
    {
     "id": "I74",
     "text": "他懂得从前的安心曾帮他坦然生活。",
     "key": "坦然生活",
     "kind": ""
    },
    {
     "id": "I75",
     "text": "失去之后，他仍不愿放弃那份坦然。",
     "key": "不愿放弃",
     "kind": ""
    },
    {
     "id": "I76",
     "text": "他不再觉得两种要求那么彼此敌对。",
     "key": "彼此敌对",
     "kind": ""
    },
    {
     "id": "I77",
     "text": "他感激过去，也珍惜如今仍能坚持的自己。",
     "key": "感激过去",
     "kind": ""
    },
    {
     "id": "I78",
     "text": "他不必贬低过去来证明自己可以独立。",
     "key": "证明自己",
     "kind": ""
    },
    {
     "id": "I79",
     "text": "他不必贬低现在来证明有多么怀念。",
     "key": "贬低现在",
     "kind": ""
    },
    {
     "id": "I80",
     "text": "他暂时不再觉得内心被撕成两半。",
     "key": "被撕成两半",
     "kind": ""
    },
    {
     "id": "I81",
     "text": "他重新感到柔和的喜悦。",
     "key": "柔和的喜悦",
     "kind": ""
    },
    {
     "id": "I82",
     "text": "他发现珍贵的东西已经成为自己的一部分。",
     "key": "一部分",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I66",
     "to": "I67",
     "rel": "提供理由"
    },
    {
     "from": "I33",
     "to": "I73",
     "rel": "改写"
    },
    {
     "from": "I35",
     "to": "I74",
     "rel": "说明"
    },
    {
     "from": "I10",
     "to": "I70",
     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "181–205",
   "relation": "没在想",
   "items": [
    {
     "id": "I83",
     "text": "他愿在这份喜悦里再停留一会儿。",
     "key": "停留",
     "kind": ""
    },
    {
     "id": "I84",
     "text": "他毫无防备地承认自己的全部感情。",
     "key": "全部感情",
     "kind": ""
    },
    {
     "id": "I85",
     "text": "他不急着选哪一种要求更正确。",
     "key": "不急着",
     "kind": ""
    },
    {
     "id": "I86",
     "text": "他感激曾经拥有过的一切。",
     "key": "曾经拥有",
     "kind": ""
    },
    {
     "id": "I87",
     "text": "他欣慰如今仍能珍惜旧日所得。",
     "key": "欣慰",
     "kind": ""
    },
    {
     "id": "I88",
     "text": "他想起过去时不再觉得自己可怜。",
     "key": "不再觉得",
     "kind": ""
    },
    {
     "id": "I89",
     "text": "他肯定如今，也不觉得要与过去断开。",
     "key": "过去断开",
     "kind": ""
    },
    {
     "id": "I90",
     "text": "旧日给他的宽厚与勇气似乎又回到心里。",
     "key": "似乎又回到",
     "kind": ""
    },
    {
     "id": "I91",
     "text": "他清楚自己并没有得到什么新的保证。",
     "key": "新的保证",
     "kind": ""
    },
    {
     "id": "I92",
     "text": "他觉得已有的东西如此丰厚。",
     "key": "如此丰厚",
     "kind": ""
    },
    {
     "id": "I93",
     "text": "他暂时不再追问还有什么没有了。",
     "key": "暂时不再",
     "kind": ""
    },
    {
     "id": "I94",
     "text": "他愿相信自己珍爱的两边本不该互相伤害。",
     "key": "互相伤害",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I81",
     "to": "I83",
     "rel": "唤起"
    },
    {
     "from": "I76",
     "to": "I85",
     "rel": "改写"
    },
    {
     "from": "I71",
     "to": "I90",
     "rel": "唤起"
    }
   ]
  },
  {
   "bars": "206–213",
   "relation": "正在面对",
   "items": [
    {
     "id": "I95",
     "text": "他离开宽慰后又想起先前的问题。",
     "key": "先前的问题",
     "kind": ""
    },
    {
     "id": "I96",
     "text": "他发现两边相容主要只发生在心里。",
     "key": "只发生在心里",
     "kind": "办法的限度"
    },
    {
     "id": "I97",
     "text": "他知道旧日生活依然没有回来。",
     "key": "没有回来",
     "kind": ""
    },
    {
     "id": "I98",
     "text": "他依然不能随时得到过去那种亲近。",
     "key": "不能随时",
     "kind": ""
    },
    {
     "id": "I99",
     "text": "他不愿把刚才的幸福说成虚假。",
     "key": "说成虚假",
     "kind": ""
    },
    {
     "id": "I100",
     "text": "他觉得说困难已解决似乎太容易了。",
     "key": "似乎太容易",
     "kind": ""
    },
    {
     "id": "I101",
     "text": "他开始有些迟疑。",
     "key": "有些迟疑",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I93",
     "to": "I95",
     "rel": "动摇"
    },
    {
     "from": "I94",
     "to": "I96",
     "rel": "限制"
    },
    {
     "from": "I53",
     "to": "I98",
     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "214–215",
   "relation": "正在面对",
   "items": [
    {
     "id": "I102",
     "text": "他还舍不得离开刚才的安宁。",
     "key": "舍不得离开",
     "kind": ""
    },
    {
     "id": "I103",
     "text": "他已无法再相信想通就不用面对缺憾。",
     "key": "无法再相信",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I92",
     "to": "I102",
     "rel": "仍在起作用"
    },
    {
     "from": "I96",
     "to": "I103",
     "rel": "提供理由"
    }
   ]
  },
  {
   "bars": "216–225",
   "relation": "正在面对",
   "items": [
    {
     "id": "I104",
     "text": "他知道还得决定怎样承受缺憾。",
     "key": "怎样承受",
     "kind": ""
    },
    {
     "id": "I105",
     "text": "他重新要求自己坚持。",
     "key": "重新要求",
     "kind": ""
    },
    {
     "id": "I106",
     "text": "他无法再单靠骄傲相信一切都会没事。",
     "key": "单靠骄傲",
     "kind": ""
    },
    {
     "id": "I107",
     "text": "他选择不退让时，已知有些愿望无法满足。",
     "key": "愿望无法满足",
     "kind": "选择的代价"
    },
    {
     "id": "I108",
     "text": "这次选择比单纯不认输艰难得多。",
     "key": "艰难得多",
     "kind": ""
    },
    {
     "id": "I109",
     "text": "他仍然愿意坚持。",
     "key": "愿意坚持",
     "kind": ""
    },
    {
     "id": "I110",
     "text": "他心里多了一份沉重。",
     "key": "一份沉重",
     "kind": ""
    },
    {
     "id": "I111",
     "text": "他已不忍再轻描淡写地看待自己的失去。",
     "key": "不忍",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I103",
     "to": "I104",
     "rel": "提供理由"
    },
    {
     "from": "I16",
     "to": "I105",
     "rel": "仍在起作用"
    },
    {
     "from": "I53",
     "to": "I107",
     "rel": "提供理由"
    },
    {
     "from": "I49",
     "to": "I111",
     "rel": "仍在起作用"
    }
   ]
  },
  {
   "bars": "226–241",
   "relation": "正在面对",
   "items": [
    {
     "id": "I112",
     "text": "他渐渐因这份沉重感到悲愤。",
     "key": "悲愤",
     "kind": ""
    },
    {
     "id": "I113",
     "text": "他不甘珍爱的生活已与自己相隔。",
     "key": "不甘",
     "kind": ""
    },
    {
     "id": "I114",
     "text": "他更不甘两种心愿在现实中仍难同时满足。",
     "key": "难同时满足",
     "kind": ""
    },
    {
     "id": "I115",
     "text": "他想知道能否保住所爱又不委屈自己。",
     "key": "保住所爱",
     "kind": ""
    },
    {
     "id": "I116",
     "text": "他仍找不到答案。",
     "key": "找不到答案",
     "kind": ""
    },
    {
     "id": "I117",
     "text": "他不肯舍弃任何一边，疑问便更刺痛他。",
     "key": "更刺痛",
     "kind": "知道更多反而更尖锐"
    },
    {
     "id": "I118",
     "text": "他比起初更加想念旧日幸福。",
     "key": "更加想念",
     "kind": ""
    },
    {
     "id": "I119",
     "text": "他已无法只盼着回到过去。",
     "key": "只盼着",
     "kind": ""
    },
    {
     "id": "I120",
     "text": "他怕为了重新被接纳而放弃不能退让的事。",
     "key": "不能退让",
     "kind": ""
    },
    {
     "id": "I121",
     "text": "他觉得即使再安心，这样也会辜负从前。",
     "key": "辜负从前",
     "kind": "选择的代价"
    },
    {
     "id": "I122",
     "text": "他希望过去留给自己的力量还能帮他往前活。",
     "key": "往前活",
     "kind": ""
    },
    {
     "id": "I123",
     "text": "这个念头令他难过。",
     "key": "令他难过",
     "kind": ""
    },
    {
     "id": "I124",
     "text": "他也因此更有理由不肯退让。",
     "key": "更有理由",
     "kind": ""
    },
    {
     "id": "I125",
     "text": "他不愿损害旧日生活成就的自己。",
     "key": "成就的自己",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I110",
     "to": "I112",
     "rel": "唤起"
    },
    {
     "from": "I96",
     "to": "I114",
     "rel": "说明"
    },
    {
     "from": "I82",
     "to": "I118",
     "rel": "唤起"
