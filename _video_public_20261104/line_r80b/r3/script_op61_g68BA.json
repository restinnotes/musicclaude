       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "偶尔想起从前熟悉的日子，他还是想往前过，却不知道以后靠什么让自己安下心。",
       "keys": [
        "想往前过",
        "安下心"
       ],
       "from": [
        "S01-3"
