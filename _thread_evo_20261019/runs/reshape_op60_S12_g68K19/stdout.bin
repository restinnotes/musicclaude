{"completed": true, "response": "<escape>{\n  \"rows\": [\n    {\n      \"form\": \"连贯\",\n      \"text\": \"他顾不上对方是否也在乎他，只想把能给的都给对方，希望对方安心。\",\n      \"keys\": [\"把能给的都给对方\", \"希望对方安心\"],\n      \"emotion\": \"亲密\",\n      \"from\": [\"S12-1\"]\n    },\n    {\n      \"form\": \"散落\",\n      \"items\": [\n        {\"text\": \"温柔晴朗的歌被放到开阔尺度\", \"from\": [\"S12-B1\"], \"bars\": \"62–71\"},\n        {\"text\": \"内声部彼此拉扯\", \"from\": [\"S12-B1\"], \"bars\": \"62–71\"},\n        {\"text\": \"一浪高过一浪\", \"from\": [\"S12-B1\"], \"bars\": \"62–71\"},\n        {\"text\": \"梦游般忽然聚焦此时此地\", \"from\": [\"S12-B1\"], \"bars\": \"62–71\"},\n        {\"text\": \"像被卷进更大的世界，我暂时退后\", \"from\": [\"S12-B1\"], \"bars\": \"62–71\"},\n        {\"text\": \"狂喜像高烧\", \"from\": [\"S12-B2\"], \"bars\": \"\"},\n        {\"text\": \"像久别重逢，忽然抱紧对方\", \"from\": [\"S12-B2\"], \"bars\": \"\"},\n        {\"text\": \"久久不愿松手\", \"from\": [\"S12-B2\"], \"bars\": \"\"},\n        {\"text\": \"喉咙发紧\", \"from\": [\"S12-B2\"], \"bars\": \"\"},\n        {\"text\": \"眼眶一下湿了\", \"from\": [\"S12-B2\"], \"bars\": \"\"},\n        {\"text\": \"快乐到分不清想笑还是想哭\", \"from\": [\"S12-B2\"], \"bars\": \"\"}\n      ]\n    },\n    {\n      \"form\": \"连贯\",\n      \"text\": \"可他明知再用心也没法保证以后还这么好，仍嫌日子不够，想多陪对方一会儿。\",\n      \"keys\": [\"没法保证以后还这么好\", \"想多陪对方一会儿\"],\n      \"emotion\": \"悬着\",\n      \"from\": [\"S12-2\"]\n    },\n    {\n      \"form\": \"散落\",\n      \"items\": [\n        {\"text\": \"歌声带上近乎恳求的力量\", \"from\": [\"S12-B3\"], \"bars\": \"93–102\"},\n        {\"text\": \"一次次向上伸展\", \"from\": [\"S12-B3\"], \"bars\": \"93–102\"},\n        {\"text\": \"却始终不能完全满足\", \"from\": [\"S12-B3\"], \"bars\": \"93–102\"}\n      ]\n    },\n    {\n      \"form\": \"连贯\",\n      \"text\": \"那阵高兴终于整个涌出来，他不再强迫自己收着，只顾痛痛快快地喜欢对方。\",\n      \"keys\": [\"高兴终于整个涌出来\", \"痛痛快快地喜欢对方\"],\n      \"emotion\": \"炽热\",\n      \"from\": [\"S12-3\"]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "7b43a8f7-5646-4578-8070-df21f3017685", "session_