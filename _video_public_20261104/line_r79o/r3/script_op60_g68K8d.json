 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近这个人，心里一下热起来，连自己也有点意外。",
       "keys": [
        "那么想靠近",
        "心里一下热起来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两下和弦骤响，烟花光点仍悬水面；刚上小船，木板微晃，脚下水波令人失重",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方看出自己有多需要这份亲近，会觉得负担太重；像一件想了很久的话，到了嘴边先沉默几秒，所以只敢露出一点点喜欢。",
       "keys": [
        "负担太重",
        "只敢露出一点点喜欢"
       ],
       "from": [
        "S01-2",
        "S01-B2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "只是这么一点亲近就让他觉得甜，他还拿不准，下次自己能不能更坦白些。",
       "keys": [
        "觉得甜",
        "能不能更坦白些"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因为他露出在意就退开，仍愿意跟他亲近，他才渐渐放松下来。",
       "keys": [
        "没有因为他露出在意就退开",
        "渐渐放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "左手像心跳般摇荡，身体交给船底托着，水却始终向前流",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "右手两线贴近如肩相依，呼吸与体温融在一起，像夏末湿热的风裹着皮肤",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "柔软落音像温柔的刺，甜蜜里忽然泛起鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠得更近，有一阵子喜欢得几乎藏不住，最后还是怕太急弄坏眼下的自在而收住了。",
       "keys": [
        "喜欢得几乎藏不住",
        "收住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声忽然上涌，随即像轻轻呼气般退回柔和",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待在一起这么好，他偏偏想到这样的时刻总会过去，还没分开就先有一点舍不得。",
       "keys": [
        "这样的时刻总会过去",
        "先有一点舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不去琢磨两个人往后会怎样，只想舒舒服服地待在这份亲近里；歌声渐渐退到后面，水波般的摇曳托着身体，沉默也很舒服，心却慢慢漂远。",
       "keys": [
        "舒舒服服地待在这份亲近里",
        "沉默也很舒服"
       ],
       "from": [
        "S03-1",
        "S03-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "摇荡里忽冒几句急促声音，随即沉回；暗流牵住水波，思绪如碎影难拼，音乐绕远滞留，像交谈碰到心结，却未走向悲剧",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想说有多喜欢这样，也想问对方是否一样；没想好怎么开口，念头就淡了。",
       "keys": [
        "有多喜欢这样",
        "对方是否一样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他满心欢喜，他想起上回明明想告诉对方，却没有开口。",
       "keys": [
        "满心欢喜",
        "没有开口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉歌声重来，比初次更华丽迫切，花腔如晃眼光斑",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想把藏着的话全说出来，盼着对方也喜欢自己不再小心收着的样子；手仿佛不自觉地握得更紧，越想抱牢当下，水面的颠簸反而越剧烈。",
       "keys": [
        "把藏着的话全说出来",
        "握得更紧"
       ],
       "from": [
        "S04-2",
        "S04-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "长颤音如夕阳最后一道刺眼金光，歌声攀高渐弱，始终未落定",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "喉头发紧，右手悬高；两线贴耳低语，左手水波仍向前，仿佛每秒倒数",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "尚未失去，心里已鼻酸舍不得",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他甚至盼着说出来能把眼下的好留得久一点；可又怕一下说得太多让对方为难，连两个人原有的自在也弄丢，最后还是留了些话没说。",
       "keys": [
        "把眼下的好留得久一点",
        "最后还是留了些话没说"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "前几次想说又收住，对方却一直愿意跟他亲近；这回他不知不觉忘了藏好喜欢，等察觉时，对方已经看出他有多在乎。",
       "keys": [
        "忘了藏好喜欢",
        "看出他有多在乎"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "托着小船的水波忽然抽空，只剩单薄旋律在雾中漫游；耳语戛然而止，心里闪过：幸福真实吗，能维持多久？",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "先前藏着时还能装作没那么在乎，如今对方看出来了，他心里空落落的，连怎么跟对方待着都拿不准；他忍不住怕对方会嫌自己太黏，熟悉的亲近也像隔了一层。",
       "keys": [
        "心里空落落的",
        "会嫌自己太黏"
       ],
       "from": [
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "先前攥紧的冲动随音乐松开，终于能深吸一口气",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这回对方看出他有多在乎，跟他相处却一点没变，他才又能像从前那样自在地待着。",
       "keys": [
        "跟他相处却一点没变",
        "自在地待着"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "摇摆重来，左手水波变薄碎成细纹；暖金水面滑入古桥阴影，月光般清澈",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "清澈里仍藏不安分，也像年少初恋的下午",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "安静时，他还想靠近，却怕要得太多；对方不知道他刚才多怕被嫌弃，他有点孤单。",
       "keys": [
        "还想靠近",
        "他有点孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "主旋律压低，另一声线回应、插话又纠缠；念头刚说算了，又浮上来",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "白天相处好，夜里独处却泛酸；气味、身体感、幻想、遗憾与快感交织，越沉醉越失方向",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他又忍不住想，对方既然一直没有退开，会不会也有一点舍不得结束这份亲近？",
       "keys": [
        "一直没有退开",
        "舍不得结束这份亲近"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "想起这些日子对方总愿意跟他待在一起，他渐渐觉得，也许对方有时也需要他，跟他在一起也能安心些。",
       "keys": [
        "也许对方有时也需要他",
        "安心些"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声底下渐不安分，伴奏变密，低音如脉搏催促；身体被渴望推向前，气味、身体感、幻想、遗憾与快感交织，明知被卷入却不想抽身",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他高兴得有点收不住，想到两个人也许能互相依靠，心里忽然一紧，却还想这样待着；他真盼着往后对方想找人陪时还会想到自己，自己也能一直陪在身边。",
       "keys": [
        "互相依靠",
        "一直陪在身边"
       ],
       "from": [
        "S07-2",
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "美好未暗，时间却在经过，再完美也留不住",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "上回他无意间露了心意，这回见对方依然亲近，他想主动些，大大方方地回应。",
       "keys": [
        "依然亲近",
        "大大方方地回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旋律忽然舒展如咏叹调，歌句越唱越开，摇荡轻催人向前；歌声明亮透气，身体恢复弹性，带点玩心",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "这样想着，他连往后的日子都开始盼了，觉得两个人说不定还能这么好很久。",
       "keys": [
        "往后的日子都开始盼了",
        "这么好很久"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声向上散开，忽然戛然而止；快乐余温未散，心头已泛起怀念",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可眼下两个人都愿意亲近，以后未必还会这样，他心里没底。",
       "keys": [
        "以后未必还会这样",
        "心里没底"
       ],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "那点没底越来越具体：要是哪天对方不再需要他陪，连和他待着都不自在了呢？",
       "keys": [
        "不再需要他陪",
        "都不自在了呢"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "冲出的势头忽然收住，熟悉摇摆退开；颤音与轻和弦悬空，像对视到呼吸停住，渴望仍绷着",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "明朗隔着薄雾，光仍在",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他一下安静了，刚才还敢盼那么远，现在却不敢再往下想。",
       "keys": [
        "一下安静了",
        "不敢再往下想"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里反复问：刚才是真的吗，接下来怎么办？不安未解，却暂不占满心思",
       "keys": [],
       "from": [
        "S09-B3"
       ],
       "bead": "S09-B3"
      },
      {
       "text": "抬头望夜空，眼前美好比愿望更大",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他想起对方一直没退开，两人眼下还亲近，这些都是真的；也许对方也喜欢他在身边，他有点高兴。",
       "keys": [
        "这些都是真的",
        "有点高兴"
       ],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想着，再猜下去连今天也过不踏实，便暂时不去管往后怎样，先好好享受眼前的亲近；紧绷的肩膀终于松开，胸腔打开，心里亮堂得几乎想笑，也有点想哭。",
       "keys": [
        "先好好享受眼前的亲近",
        "有点想哭"
       ],
       "from": [
        "S10-1",
        "S10-2",
        "S10-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "船的摇荡被清风拨开，时间只松出一小块空地，不是久留的避风处；身体失重，悬在夏夜微风里",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "高音细亮如银丝雨，琶音又像飞瀑清亮落水",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      },
      {
       "text": "眼泪终于不用憋着",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "轻松过后，他忽然想到自己需要对方，对方有时也需要他；即使对方不需要他，他仍愿意陪着，不再藏着喜欢，像终于能说：这是我的感情，我不再为它道歉。",
       "keys": [
        "不再藏着喜欢",
        "我不再为它道歉"
       ],
       "from": [
        "S11-1",
        "S11-B1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "这个念头一上来，他高兴得连害臊都顾不上了，觉得自己这么在乎对方也没什么不好。",
       "keys": [
        "连害臊都顾不上了",
        "没什么不好"
       ],
       "from": [
        "S11-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "铺开的力量悬在半空，像等下一阵浪；久悬的期待终于得到回应，却还未结束",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      },
      {
       "text": "像重回旧房，熟悉温柔仍在，因懂得珍贵更易心疼",
       "keys": [],
       "from": [
        "S11-B4"
       ],
       "bead": "S11-B4"
      },
      {
       "text": "梦里漂浮忽然落回现实，音乐变得直接真切",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可对方以后还愿不愿意让他陪在身边，不是他能说了算的；想到两人未必总能这样亲近，欢喜就压得他心口发疼。",
       "keys": [
        "不是他能说了算的",
        "欢喜就压得他心口发疼"
       ],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他顾不上对方是否也在乎他，只想把能给的都给对方，希望对方安心。",
       "keys": [
        "把能给的都给对方",
        "希望对方安心"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "晴朗的歌骤然开阔，内声部彼此拉扯、一浪高过一浪；人被卷入更大的世界，自我退到后面",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      },
      {
       "text": "狂喜如久别重逢，忽然紧抱不放，喉咙发紧、眼眶湿润",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他明知再用心也没法保证以后还这么好，还是嫌这样的日子不够，想多陪对方一会儿。",
       "keys": [
        "没法保证以后还这么好",
        "想多陪对方一会儿"
       ],
       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声近乎恳求地反复上伸仍不满足，乐句末端牵扯延迟，后来才释放",
       "keys": [],
       "from": [
        "S12-B3"
       ],
       "bead": "S12-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "那一阵高兴终于整个涌了出来，他不再强迫自己收着，只顾痛痛快快地喜欢对方。",
       "keys": [
        "高兴终于整个涌了出来",
        "痛痛快快地喜欢对方"
