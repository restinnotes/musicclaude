       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可又怕一下说得太多让对方为难，最后还是留了些话没说",
       "keys": [
        "留了些话没说"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "原本轻轻握着的手不自觉收紧，动作先露出了害怕",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "想用力抱牢当下，又怕颠坏了两人原有的平衡与自在",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "见对方一直愿意跟他亲近，这回他不知不觉忘了藏好喜欢",
