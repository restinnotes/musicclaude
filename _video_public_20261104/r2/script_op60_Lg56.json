       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "一说出口就变了",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
      },
      {
       "text": "越清楚越谨慎",
       "keys": [],
       "from": [
        "S01-B3-p2"
       ]
