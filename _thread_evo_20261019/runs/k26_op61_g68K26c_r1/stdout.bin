{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"离开熟悉生活，起初觉得不用再委屈自己\",\n          \"accent\": \"不用再委屈自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可笃定没撑多久，心里空落落，舍不得什么也说不清\",\n          \"accent\": \"心里空落落\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S01-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"仍想往前过，却不知以后靠什么安下心\",\n          \"accent\": \"不知以后靠什么安下心\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-3\"],\n          \"at\": 62\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"想挺直背脊撑住，心里却很想停下来\",\n          \"after\": 0,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–23\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"冷空里胸口发紧，伸手摸空，分不清愤怒、遗憾还是怀念\",\n          \"after\": 1,\n          \"from\": [\"S01-B3\", \"S01-B4\"],\n          \"bars\": \"1–23\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"旧日场景忽然清晰，身体记起步子，过去却回不来\",\n          \"after\": 1,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"9–23\",\n          \"at\": 46\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"沉重和弦后琶音散开，短句刚冒头又被停顿截断，像等回声\",\n          \"from\": [\"S01-B1\", \"S01-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"1–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"舍不得从前那些自在的时候\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"一想到以后不能那样过，心里就慌\",\n          \"accent\": \"心里就慌\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-1\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"于是赶紧想起受过的气，提醒自己为何离开\",\n          \"accent\": \"提醒自己为何离开\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\"],\n          \"at\": 26\n        },\n        {\n          \"text\": \"可还是不甘心，好日子难道也得一起丢掉？\",\n          \"accent\": \"不甘心\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-3\"],\n          \"at\": 49\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"旧歌像从远处传来，只能模糊哼几句\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"抬头装作没事，反复说服自己没事，仍不甘心消亡\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\", \"S02-B5\"],\n          \"bars\": \"44–65\",\n          \"at\": 37\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"步子庄严却虚浮，旋律脆弱，音乐上推又退，呼吸渐急\",\n          \"from\": [\"S02-B2\", \"S02-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"38–65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"心里还憋着一股气\",\n          \"accent\": \"一股气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可想起曾被当作自己人，竟高兴了一小会儿\",\n          \"accent\": \"高兴了一小会儿\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S03-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"那点高兴未退，心里就酸了：旧日子过不成，离开后就一定更好？\",\n          \"accent\": \"离开后就一定更好？\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S03-2\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像夏日麦浪和微风，也像不必防备的亲近\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"80–91\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"像暂时聊点别的，轻松是真的，却没解开伤口\",\n          \"after\": 1,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"66–91\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"心里冒出一句：刚才真相信那些话了吗？\",\n          \"after\": 2,\n          \"from\": [\"S03-B5\"],\n          \"bars\": \"66–91\",\n          \"at\": 25\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"重击砸下，声音忽强忽弱，旋律像絮语般漂移\",\n          \"from\": [\"S03-B1\", \"S03-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"66–91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"想起从前亲近的日子，真盼着还能那样相处\",\n          \"accent\": \"真盼着还能那样相处\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"那份亲近一鲜活，当初的委屈也跟着翻上来\",\n          \"accent\": \"当初的委屈\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"那一步走对了吗？没走的话，如今又怎样？\",\n          \"accent\": \"如今又怎样？\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\"],\n          \"at\": 23\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"回忆里有感激、柔情和短暂的幸福\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"外在步伐还向前，里面柔软易伤，坚定也许是他努力想成为的样子\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"脚步心跳乱了，像被时间催着跑，脑子反复问如果当时\",\n          \"after\": 2,\n          \"from\": [\"S04-B3\", \"S04-B4\"],\n          \"bars\": \"94–115\",\n          \"at\": 28\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"温暖歌声忽然紧绷，低音追赶，右手急动并一路下坠\",\n          \"from\": [\"S04-B2\", \"S04-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"108–115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"仍不服气，觉得当初的气不该忍，却连开心旧事也不敢多想\",\n          \"accent\": \"当初的气不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"跟自己争得没了力气，不服气也渐渐淡了\",\n          \"accent\": \"没了力气\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 29\n        },\n        {\n          \"text\": \"如今已不在那些人身边，只觉得难受\",\n          \"accent\": \"只觉得难受\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 45\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"夜色里两道影子低声说话，记起某人、故乡或旧生活\",\n          \"after\": 0,\n          \"from\": [\"S05-B1\", \"S05-B3\"],\n          \"bars\": \"116–147\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"心里仍有句：这件事不能就这样算了\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116–127\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"这一下松动，不是想通了，只是抵抗得累了\",\n          \"after\": 1,\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"132–147\",\n          \"at\": 37\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"快速音流渐稀，旋律单独露出，末尾和弦放慢\",\n          \"from\": [\"S05-B4\", \"S05-B5\"],\n          \"pt\": \"\",\n          \"bars\": \"128–147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"难受缓下来，又想起亲近，这回没拿受过的气压住想念\",\n          \"accent\": \"没拿受过的气压住想念\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"如今身边没了那些人，才知从前多轻松\",\n          \"accent\": \"才知从前多轻松\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"想再过不用多说就亲近的日子，又怕再也没有\",\n          \"accent\": \"又怕再也没有\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 38\n        },\n        {\n          \"text\": \"可那样的日子真切过过，想着就暖，先轻轻看着\",\n          \"accent\": \"想着就暖\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-4\", \"S06-B4\"],\n          \"at\": 58\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像摇篮曲隔着玻璃轻哼，不必逞强，安宁只是暂时\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\", \"S06-B2\"],\n          \"bars\": \"148–180\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"不必解释，向远方轻轻祈求，未必有回应，梦里家园亮起\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"约160\",\n          \"at\": 48\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声先试探，随后渐渐展开，最后停在未完的话上\",\n          \"from\": [\"S06-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"148–180\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"刚有点安心，忽然想到以后遇上难事\",\n          \"accent\": \"刚有点安心\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"要是还得一个人顶着，我真撑得住吗？\",\n          \"accent\": \"一个人顶着\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-1\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"当初只想着别再受气，没料到这么孤单，早知道还会走吗？\",\n          \"accent\": \"早知道还会走吗？\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-2\"],\n          \"at\": 28\n        },\n        {\n          \"text\": \"想找回亲近，却不肯再受气，离开时的决心也找不着了\",\n          \"accent\": \"决心也找不着了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\"],\n          \"at\": 44\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"寒风猛地吹开窗，后颈一凉，脉搏猛跳\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"熟悉的动作和舞步闯进来，亲切反衬失去\",\n          \"after\": 2,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181–205\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉舞步突然闯入，却没再站得完整\",\n          \"from\": [\"S07-B2\", \"S07-B5\"],\n          \"pt\": \"\",\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"连续颤音一层层累积，紧张迟迟不散\",\n          \"from\": [\"S07-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"198–205\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"先把回去的事放一边\",\n          \"accent\": \"放一边\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起曾被当作自己人，暖了一会儿，却没想回头\",\n          \"accent\": \"暖了一会儿\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"可暖意很快淡了，回忆陪不了往后难处，心又悬起\",\n          \"accent\": \"心又悬起\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-2\"],\n          \"at\": 11\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"温柔不舍地回头望一眼，胸口短暂吸进一口气\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\", \"S08-B3\"],\n          \"bars\": \"206–213\",\n          \"at\": 8\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"缓慢宽广的歌唱短暂回来\",\n          \"from\": [\"S08-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"206–213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他忽然说不清，自己为什么想回去\",\n          \"accent\": \"说不清\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"是舍不得被当作自己人的日子\",\n          \"accent\": \"被当作自己人的日子\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S09-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"还是怕孤单到连那些气也肯再受？\",\n          \"accent\": \"连那些气也肯再受？\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"这念头让他心慌，连往下想都不敢\",\n          \"accent\": \"连往下想都不敢\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-2\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"又遇见那个不知怎么办的自己，这回知道自己经历过什么\",\n          \"after\": 2,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–215\",\n          \"at\": 15\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"沉重开头在颤音里闪回，声音短暂落稳又漂散\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"214–215\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"最舍不得的，还是被当作自己人的日子\",\n          \"accent\": \"最舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可真回去，还能像从前那样吗？\",\n          \"accent\": \"还能像从前那样吗？\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"当初那些难受没法抹掉，光凭想念仍不敢回去\",\n          \"accent\": \"光凭想念仍不敢回去\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"翻来覆去问往后怎么过，仍没答案，眼下也不踏实\",\n          \"accent\": \"仍没答案\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-3\", \"S10-B3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"失重悬在半空，连重要往事也没力气讲完\",\n          \"after\": 3,\n          \"from\": [\"S10-B2\", \"S10-B4\"],\n          \"bars\": \"221–225\",\n          \"at\": 19\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉歌声与舞步只剩碎片，摇篮曲也凄厉地闪回\",\n          \"from\": [\"S10-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"216–225\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"明知回去未必找回亲近，还是忍不住想万一呢？\",\n          \"accent\": \"万一呢？\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可不愿只凭这点指望，再回去忍让\",\n          \"accent\": \"不愿只凭这点指望\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"回去以后再说，先把眼下日子过稳些\",\n          \"accent\": \"先把眼下日子过稳些\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-3\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"仍怕难处只能自己扛，却不因害怕收回打算\",\n          \"accent\": \"不因害怕收回打算\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-4\"],\n          \"at\": 14\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"害怕还在，脚却已经往前走\",\n          \"after\": 3,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"226–241\",\n          \"at\": 15\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"低音涌起，重击反复砸下，舞步由试探渐渐聚拢\",\n          \"from\": [\"S11-B1\", \"S11-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"226–241\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"当初那些气不该忍，和他们也真开心过\",\n          \"accent\": \"那些气不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"这回不逼自己选边，也不再怪自己离开\",\n          \"accent\": \"不再怪自己离开\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-1\", \"S12-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"仍会心软、怕孤单，却不只为有人陪就回头\",\n          \"accent\": \"不只为有人陪就回头\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"愿意带着想念继续过日子\",\n          \"accent\": \"带着想念\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-2\"],\n          \"at\": 17\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"经历动摇后，仍能自己决定怎样站立\",\n          \"after\": 1,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"242–253\",\n          \"at\": 10\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"雷鸣般舞步轰然回来，途中忽然偏斜一下又继续\",\n          \"from\": [\"S12-B1\", \"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"242–253\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"想起从前自然亲近的日子，心里又热起来\",\n          \"accent\": \"心里又热起来\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"也盼以后还能遇上，便有劲头把日子过好\",\n          \"accent\": \"有劲头把日子过好\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-1\", \"S13-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"不再整天跟从前较劲，可又怕等很久才遇上亲近的人\",\n          \"accent\": \"怕等很久\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-2\", \"S13-3\"],\n          \"at\": 23\n        },\n        {\n          \"text\": \"以后有人把他当自己人就珍惜，没有也好好过，不为留人咽委屈\",\n          \"accent\": \"不为留人咽委屈\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S13-4\"],\n          \"at\": 31\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"柔软歌声被宏大音响托起，像故土与共同希望\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254–270\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"静下来仍有点不安，也像终于喘口气，末尾高音像决定或梦醒\",\n          \"after\": 3,\n          \"from\": [\"S13-B3\", \"S13-B5\"],\n          \"bars\": \"281–288\",\n          \"at\": 40\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"柔软歌声被宏大音响托起，像管风琴般庄严\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"254–268\"\n        },\n        {\n          \"text\": \"密集音流像心脏全力跳动，明亮迅疾地向前冲出\",\n          \"from\": [\"S13-B1\", \"S13-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"269–280\"\n        },\n        {\n          \"text\": \"低音两