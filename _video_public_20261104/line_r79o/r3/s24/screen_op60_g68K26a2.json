     "bars": "69–71",
     "from": [
      "S08-B3"
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "rows": [
    {
     "kind": "line",
     "text": "他怕对方有天不再需要他",
     "keys": [],
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "kind": "line",
     "text": "想到对方或许不自在，他安静了",
     "keys": [],
     "emotion": "孤单",
     "from": [
      "S09-1",
      "S09-2"
     ],
     "at": 3.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像对视到呼吸停住，渴望仍绷着",
       "bead": "S09-B1",
       "from": [
        "S09-B1"
       ],
       "bars": "72–77",
       "at": 6.0
      },
      {
       "text": "阳光隔着薄雾，光还在却暗下来",
       "bead": "S09-B2",
       "from": [
        "S09-B2"
       ],
       "bars": "72–77",
       "at": 9.0
      },
      {
       "text": "听着自己的余响，问刚才是真的吗",
       "bead": "S09-B3",
       "from": [
        "S09-B3"
       ],
       "bars": "72–77",
       "at": 15.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "可对方一直没退开，两人仍亲近",
