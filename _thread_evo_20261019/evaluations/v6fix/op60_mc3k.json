      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S14",
    "bars": "111–116",
    "relation": "正在面对",
    "items": [
     {
      "id": "S14-1",
      "text": "欢喜平缓后，他仍依恋，难再像起初只顾眼前轻松。",
      "key": "欢喜平缓后，他仍",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2",
       "S13-2"
      ]
     },
     {
      "id": "S14-2",
      "text": "他确实尝过那份快乐，无法后悔交出自己。",
      "key": "他确实尝过那份快",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-2"
      ]
     },
     {
      "id": "S14-3",
      "text": "他更爱对方，仍不知美好能留多久。他不再追问，决意全心去爱。",
      "key": "他更爱对方，仍不",
