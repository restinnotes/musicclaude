      "to": "S10-2",
      "rel": "引用"
     },
     {
      "from": "S10-1",
      "to": "S10-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S11",
    "bars": "84–92",
    "relation": "正在面对",
    "items": [
     {
      "id": "S11-1",
      "text": "等那阵轻松过去，他才明白，自己不只是想多享受几次这样的亲近，而是真的愿意往后长久地陪着对方。",
      "key": "等那阵轻松过去，",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-3",
       "S08-1",
       "S10-2"
      ]
     },
     {
      "id": "S11-2",
      "text": "想到这里，他高兴得胸口发疼，连先前那点怕显得太在乎的羞怯也不再想管了。",
      "key": "想到这里，他高兴",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-2",
       "S11-1"
      ]
     },
     {
      "id": "S11-3",
      "text": "他愿意一直陪着，可对方往后还愿不愿意这样亲近他，不是他说了算的，想到这儿，心里就疼得厉害。",
      "key": "他愿意一直陪着，",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-1",
       "S11-1",
       "S11-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S07-3",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S08-1",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S10-2",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S05-2",
      "to": "S11-2",
      "rel": "引用"
     },
     {
      "from": "S11-1",
      "to": "S11-2",
      "rel": "引用"
     },
     {
