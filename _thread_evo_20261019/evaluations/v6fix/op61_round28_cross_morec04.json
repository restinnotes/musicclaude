      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "正在面对",
    "items": [
     {
      "id": "S08-1",
      "text": "他又有片刻能温柔地想着过去，心里也确实松了一些。",
      "key": "他又有片刻能温柔",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-2",
       "S06-1"
      ]
     },
     {
      "id": "S08-2",
      "text": "只是还没来得及安定，那点亲近又变得遥远，舍不得却没有退。",
      "key": "只是还没来得及安",
      "follows": false,
