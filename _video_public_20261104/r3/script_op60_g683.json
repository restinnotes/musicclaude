       "from": [
        "S13-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "如今怕哪天不被需要，连这份亲近也没了，他又想把喜欢藏回一点。",
