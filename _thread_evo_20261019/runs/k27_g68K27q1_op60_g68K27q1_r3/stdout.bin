{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他很想靠近对方却怕自己的需要成了负担，只敢露出一点喜欢\",\n          \"accent\": \"很想靠近\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\", \"S01-2\"],\n          \"at\": 0\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"眼下这点亲近很甜，他还不知下次能否坦白些\",\n          \"after\": 0,\n          \"from\": [\"S01-3\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"话到了嘴边又停住，他怕说出口会改变关系\",\n          \"after\": 0,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"刚踏上船板，水波散开身体一瞬失重\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 14\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"两下响亮和弦迸发，光点缓缓落下仍悬在水面\",\n          \"from\": [\"S01-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"开头像刚踏上船板，尚未进入稳定摇荡\",\n          \"from\": [\"S01-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"他露出在意后对方仍愿意亲近，他这才慢慢放松下来\",\n          \"accent\": \"仍愿意亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想再靠近些，喜欢几乎藏不住却怕太急弄坏眼下的自在\",\n          \"accent\": \"喜欢几乎藏不住\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\"],\n          \"at\": 26\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"好时光总会过去，他还没分开就有些舍不得\",\n          \"after\": 0,\n          \"from\": [\"S02-3\"],\n          \"bars\": \"\",\n          \"at\": 44\n        },\n        {\n          \"text\": \"肩挨着肩耳语，连沉默都像夏末湿风贴着皮肤\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约6–16\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"身体交给船底托着，水和时间仍往前流\",\n          \"after\": 0,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"喜欢猛地涌上来，呼吸一变又轻轻退回去\",\n          \"after\": 1,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"柔软的落音像温柔的刺，甜得心里发酸\",\n          \"after\": 0,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"约7–11\",\n          \"at\": 23\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"右手两条旋律线贴得很近，像两道相依的歌声\",\n          \"from\": [\"S02-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"约6–16\"\n        },\n        {\n          \"text\": \"左手连续脉动先托住音乐，水浪一直向前\",\n          \"from\": [\"S02-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"4–16\"\n        },\n        {\n          \"text\": \"歌声先往上涌，随后渐弱回到柔和状态\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"12–16\"\n        },\n        {\n          \"text\": \"几次柔软落音里，甜蜜和隐约惆怅并存\",\n          \"from\": [\"S02-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"约7–11\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不想以后，只想舒服地待在这份亲近里\",\n          \"accent\": \"舒服地待在这份亲近里\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想说出喜欢也想问对方是否一样，开口的念头却淡了\",\n          \"accent\": \"想说出喜欢\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"亲密交谈后安静下来，身体在场心却漂远\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"急着表达的念头露了下头，很快又沉回去\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"约20–21\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"暗流拖住谈话，倒影碎成一团难解的结\",\n          \"after\": 1,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\",\n          \"at\": 26\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声渐渐退远，只剩水波般流动盘旋\",\n          \"from\": [\"S03-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"摇曳中忽然冒出几句短促急切的声音\",\n          \"from\": [\"S03-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"约20–21\"\n        },\n        {\n          \"text\": \"平稳流动忽然受阻，声音绕远又滞留\",\n          \"from\": [\"S03-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"17–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉亲近让他欢喜，想起上回没说的话便盼对方喜欢坦白的自己\",\n          \"accent\": \"坦白的自己\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\", \"S04-2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他盼坦白留住眼下的好，却怕对方为难而把话咽回去\",\n          \"accent\": \"怕对方为难\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 27\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"讲着往事越说越急，忍不住折回来补细节\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"情意涌到喉咙口，声音颤着像要哽咽\",\n          \"after\": 0,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"约30–34\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"握着对方的手，不知不觉越握越紧\",\n          \"after\": 1,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 39\n        },\n        {\n          \"text\": \"歌声越美越鼻酸，仿佛每一秒都在倒数\",\n          \"after\": 1,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\",\n          \"at\": 45\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的歌声重现，两道声线贴近而更华丽迫切\",\n          \"from\": [\"S04-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"高处长颤音明亮，音乐攀升时却渐渐收弱\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"约30–34\"\n        },\n        {\n          \"text\": \"两道歌声仍贴近，左手水波持续向前\",\n          \"from\": [\"S04-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"24–34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"这回他终于没藏住喜欢，被对方看见后心里空落又不知所措\",\n          \"accent\": \"心里空落\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-1\", \"S05-2\"],\n          \"at\": 0\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他怕对方嫌他太黏，熟悉的亲近忽然隔了一层\",\n          \"after\": 0,\n          \"from\": [\"S05-3\"],\n          \"bars\": \"\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"小船漂进雾里，脚下失去支撑连时间也松开\",\n          \"after\": 0,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"从亲密里抽身，他问幸福是真的吗又能维持多久\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 12\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"水波忽然消失，只剩单薄旋律在空中游走\",\n          \"from\": [\"S05-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"35–39\"\n        },\n        {\n          \"text\": \"先前紧抓当下的劲头忽然松开，像放手后深吸气\",\n          \"from\": [\"S05-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他的在乎后依旧如常，他又自在起来\",\n          \"accent\": \"依旧如常\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他怕要得太多却还想靠近，对方不知情让他有些孤单\",\n          \"accent\": \"有些孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"他又猜对方一直没退开，会不会也舍不得这份亲近\",\n          \"accent\": \"舍不得这份亲近\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 29\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"暖金水面滑入古桥阴影，像清凉月光或初恋午后\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"低声说着算了，却还是放不下\",\n          \"after\": 1,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"白天的好像成了回忆，心里仍有无人能到的角落\",\n          \"after\": 1,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"气味、身体感觉、幻想遗憾交缠，舒服得迷失方向\",\n          \"after\": 1,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 33\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"左手水波变薄细碎，清澈舒展的新旋律浮现\",\n          \"from\": [\"S06-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"低声旋律与另一声线交织，时而靠近时而退开\",\n          \"from\": [\"S06-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"40–50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他觉得对方或许也需要他，和他在一起也能安心\",\n          \"accent\": \"也需要他\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到也许能互相依靠，他高兴得心口一紧还盼着陪下去\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-2\", \"S07-3\"],\n          \"at\": 19\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"清澈歌声下暗涌翻起，身体被渴望推着往前\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"带着情色暖意，他明知被卷进去却不想出来\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"眼前仍然美好，他却已感觉时间正在经过\",\n          \"after\": 1,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏音符变密，内声部攀爬，低音脉搏沉重急促\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"上回露出心意后对方仍亲近，他想主动回应这份亲近\",\n          \"accent\": \"主动回应\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他盼两人能这样好很久，却没把握以后是否依旧亲近\",\n          \"accent\": \"没把握\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-2\", \"S08-3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"歌声直接舒展开来，情绪一再抬高\",\n          \"after\": 0,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"阳光和风扑面而来，身体轻快得有了玩心\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"歌声忽然散开停住，快乐余温里泛起怀念\",\n          \"after\": 1,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\",\n          \"at\": 30\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旋律直接舒展，歌句逐渐展开并不断抬高\",\n          \"from\": [\"S08-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌声明亮轻盈，熟悉的摇荡带着轻轻催促\",\n          \"from\": [\"S08-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌声向上散开后突然停住，转入片刻静意\",\n          \"from\": [\"S08-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"69–71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他开始担心有天对方不再需要他，连相处都不自在\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他忽然安静下来，刚才还敢盼很远如今却不敢了\",\n          \"accent\": \"不敢了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"对方一直没退开，他猜对方也喜欢自己在身边而高兴\",\n          \"accent\": \"喜欢自己在身边\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"两人对视到呼吸停住，渴望还在却引而不发\",\n          \"after\": 0,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"阳光隔着薄雾，四周暗下来却没全黑\",\n          \"after\": 1,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"他反复问自己，刚才是真的吗接下来怎么办\",\n          \"after\": 1,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"抬头看见夜空，眼前的美好似乎比愿望更大\",\n          \"after\": 2,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 26\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"冲势突然收住，颤音与轻和弦悬在半空\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"72–77\"\n        },\n        {\n          \"text\": \"声音逐层下沉变暗，整体听感渐渐收紧\",\n          \"from\": [\"S09-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"72–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"再猜下去今天也过不踏实，他先享受眼前亲近\",\n          \"accent\": \"享受眼前亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"紧绷慢慢松开，他心里亮堂得想笑也想哭\",\n          \"accent\": \"想笑也想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 14\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他长长呼出一口气，胸口打开眼泪也不必忍\",\n          \"after\": 1,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"清风拨开水波，时间短暂空出一小块\",\n          \"after\": 0,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"身体像失去重量，灵魂飘在夏夜微风里\",\n          \"after\": 1,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\",\n          \"at\": 23\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"水波摇荡仿佛被清风拨开，旋律短暂打开空间\",\n          \"from\": [\"S10-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"高音细亮音符像银丝细雨，琶音又像飞瀑落水\",\n          \"from\": [\"S10-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"78–83（下泻琶音：80–83）\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他想到彼此或许需要对方，仍愿陪着也不再藏喜欢\",\n          \"accent\": \"不再藏喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\", \"S11-2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他左右不了对方以后是否还要他，想到亲近未必长久便心口疼\",\n          \"accent\": \"心口疼\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-3\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"期待像是得到满足，力量却仍悬在半空\",\n          \"after\": 0,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"约92\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"夕阳烧得血红金亮，刺眼得让人想流泪\",\n          \"after\": 1,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"旧房子仍熟悉，知道它珍贵后心里反而更沉\",\n          \"after\": 1,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 32\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"厚重和弦托起歌声，左手水波铺成跨八度巨浪\",\n          \"from\": [\"S11-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"84–92\"\n        },\n        {\n          \"text\": \"铺开的力量短暂悬停，像在等待下一股浪潮\",\n          \"from\": [\"S11-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"约92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他顾不上对方是否也在乎，只想把能给的都给对方\",\n          \"accent\": \"把能给的都给对方\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他知道再用心也难保长久，仍嫌时间不够想多陪一会\",\n          \"accent\": \"想多陪一会\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"那阵高兴终于涌出来，他不再收着只管痛快地喜欢\",\n          \"accent\": \"痛快地喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-3\"],\n          \"at\": 26\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"整个人被卷进更大的世界，连自己都退到后面\",\n          \"after\": 2,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102（放大感：94–102）\",\n          \"at\": 31\n        },\n        {\n          \"text\": \"像久别重逢般紧抱，喉咙发紧想笑又想哭\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"温柔明亮主题放大，内声部拉扯，音乐一浪高过一浪\",\n          \"from\": [\"S12-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"93–102（放大感：94–102）\"\n        },\n        {\n          \"text\": \"旋律反复向上伸展，末端仍有牵扯与延迟\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"93–102（96–100附近；释放：102–103交界）\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"他想听对方说以后不变，越相处越怕时光留不住\",\n          \"accent\": \"时光留不住\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"起初怕自己添负担，如今怕对方不再需要他而想少露心意\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"他已装不出不在乎，真心想对对方好再藏回去更难受\",\n          \"accent\": \"真心想对对方好\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 27\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"刚抵达一道浪峰，身后又有更大的浪推来\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"幸福里渐渐掺进苦涩，握在手里才怕它留不住\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"刚坚定地说了是，心里马上又冒出一句可是呢\",\n          \"after\": 2,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"脚步稳稳踩住地面，胸口却一次次往下沉\",\n          \"after\": 2,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"音乐反复渐强后逐渐绷紧，持续向前推进\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"103–110\"\n        },\n        {\n          \"text\": \"下方声部稳稳踏住，上方声部一次次下落\",\n          \"from\": [\"S13-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"103–110\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"从前不敢多露喜欢如今两人仍亲近，心里甜酸却不后悔\",\n          \"accent\": \"不后悔\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他舍不得也不知以后怎样，不再求保证也不藏喜欢等未来来了再说\",\n          \"accent\": \"不藏喜欢\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-2\", \"S14-3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从美梦里醒来，心里温热身体慢慢平静\",\n          \"after\": 0,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111–115（最后一浪：110–111交界）\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"低低回望一声，最后还有一道水花般的闪光\",\n          \"after\": 0,\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113–115\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"像经历一阵震荡后，站起来整理衣服关上门\",\n          \"after\": 1,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"开头悬着的话终于得到回应，像被完整说完\",\n          \"after\": 1,\n          \"from\": [\"S14-B4\"],\n          \"bars\": \"113–116\",\n          \"at\": 29\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"最后一股浪头猛推后，终结句真正松下来轻下来\",\n          \"from\": [\"S14-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"111–115（最后一浪：110–111交界）\"\n        },\n        {\n          \"text\": \"左手内声部幽幽独唱，右手琶音像水花溅向夜空\",\n          \"from\": [\"S14-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"113–115\"\n        },\n        {\n          \"text\": \"最后几下和弦干脆沉重，低音形成明确落定感\",\n          \"from\": [\"S14-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"116\"\n        },\n        {\n          \"text\": \"尾声重现熟悉声响，最后和弦接住开头的悬置\",\n          \"from\": [\"S14-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"113–116\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": 