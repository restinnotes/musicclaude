{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他已经离开那段熟悉的生活\",\n          \"accent\": \"离开\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"起初他觉得终于不用再受委屈\",\n          \"accent\": \"不用再受委屈\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\", \"S01-B2\"],\n          \"at\": 15\n        },\n        {\n          \"text\": \"笃定很快散了心里空落落的\",\n          \"accent\": \"空落落的\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S01-2\", \"S01-B2\"],\n          \"at\": 30\n        },\n        {\n          \"text\": \"他一时说不清舍不得什么\",\n          \"accent\": \"\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-2\", \"S01-B3\"],\n          \"at\": 45\n        },\n        {\n          \"text\": \"他想往前走却找不到安稳\",\n          \"accent\": \"找不到安稳\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-3\", \"S01-B5\"],\n          \"at\": 60\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"烟雾般散向高处，停顿里等着回声\",\n          \"after\": 0,\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1-6\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"我不能倒下，可我其实想停下来\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1-23\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"心里有事，却分不清怒气遗憾怀念\",\n          \"after\": 3,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1-23\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"冷空里醒来，胸紧眼模糊颤手摸空\",\n          \"after\": 3,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"1-23\",\n          \"at\": 50\n        },\n        {\n          \"text\": \"旧日声音和光线忽然回来了\",\n          \"after\": 4,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"9-17\",\n          \"at\": 65\n        },\n        {\n          \"text\": \"身体先记起怎么迈步\",\n          \"after\": 4,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"18-23\",\n          \"at\": 80\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"沉重和弦后，自由琶音向上散开\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1-6\"\n        },\n        {\n          \"text\": \"短句刚冒出就被长停顿截断\",\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1-23\"\n        },\n        {\n          \"text\": \"波兰舞曲步态渐渐浮现\",\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"18-23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"他舍不得从前自在的日子\",\n          \"accent\": \"自在\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-1\", \"S02-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到以后不能再那样过\",\n          \"accent\": \"不能再那样过\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-1\", \"S02-B1\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"他提醒自己受过的气\",\n          \"accent\": \"受过的气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\", \"S02-B4\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"怕心软就忘了为何离开\",\n          \"accent\": \"为何离开\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\", \"S02-B4\"],\n          \"at\": 30\n        },\n        {\n          \"text\": \"难道不受气就得丢掉好日子？\",\n          \"accent\": \"好日子\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-3\", \"S02-B5\"],\n          \"at\": 40\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"远处旧歌只哼得出几句\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24-65\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"珍惜的东西仿佛还在，却难再拥有\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24-65\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"腿脚虚浮地挪着记忆里的舞步\",\n          \"after\": 0,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24-65\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"呼吸被催得越来越急\",\n          \"after\": 1,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"56-65\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"整理衣服抬起头，不让人看出动摇\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"24-65\",\n          \"at\": 45\n        },\n        {\n          \"text\": \"第三遍露出在意，悲伤还在也不甘消亡\",\n          \"after\": 4,\n          \"from\": [\"S02-B4\", \"S02-B5\"],\n          \"bars\": \"44-65\",\n          \"at\": 55\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旋律猛地上推又退回，随后再次聚力\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"38-65\"\n        },\n        {\n          \"text\": \"细碎半音在伴奏里不安地蠕动\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24-65\"\n        },\n        {\n          \"text\": \"三连音一串接一串地流过\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"56-65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他心里还憋着一股气\",\n          \"accent\": \"憋着一股气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起被当作自己人他短暂高兴\",\n          \"accent\": \"短暂高兴\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S03-1\", \"S03-B2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"可那样的日子已经过不成了\",\n          \"accent\": \"过不成了\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S03-2\", \"S03-B2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"离开以后就一定会更好过吗？\",\n          \"accent\": \"更好过吗\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S03-2\", \"S03-B5\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"麦浪微风里，曾经亲近又不必防备\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"80-91\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"温柔让人心颤，也让人绝望\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"80-91\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"像出去走走，轻松是真的却没解开难题\",\n          \"after\": 0,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"66-91\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"耳边低声絮语，脚下像流沙\",\n          \"after\": 3,\n          \"from\": [\"S03-B4\"],\n          \"bars\": \"66-91\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"我刚才是真的相信那些话吗？\",\n          \"after\": 3,\n          \"from\": [\"S03-B5\"],\n          \"bars\": \"66-91\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"重和弦若被突出，节奏忽强忽弱\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66-79\"\n        },\n        {\n          \"text\": \"舞步转得灵活，后半段渐渐柔和\",\n          \"from\": [\"S03-B1\", \"S03-B2\"],\n          \"bars\": \"66-91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"想起从前亲近的日子\",\n          \"accent\": \"亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-1\", \"S04-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他一度真盼着还能那样相处\",\n          \"accent\": \"还能那样相处\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\", \"S04-B1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"可当初那些委屈也翻了上来\",\n          \"accent\": \"委屈\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\", \"S04-B2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他反复问那一步走对了吗？\",\n          \"accent\": \"走对了吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\", \"S04-B4\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"没走的话如今又会怎样？\",\n          \"accent\": \"又会怎样\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\", \"S04-B4\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"感激与幸福涌来，原来的坚定也软了\",\n          \"after\": 1,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92-107\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"原来的姿态回来，却更容易受伤\",\n          \"after\": 1,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92-107\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"记忆太好才刺痛，像被撕扯着后退\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108-115\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"急促脚步像乱了拍的心跳\",\n          \"after\": 3,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92-115\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"如果当时……是不是还可以……\",\n          \"after\": 4,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94-115\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"究竟为什么会变成这样，不停赶着不敢停\",\n          \"after\": 4,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94-115\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"温暖的旋律忽然变得风暴般紧绷\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108-115\"\n        },\n        {\n          \"text\": \"低音像在追赶，细碎音符急急往前跑\",\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92-115\"\n        },\n        {\n          \"text\": \"旋律忽然激烈，随后一路向下\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108-115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他仍觉得当初那些气不该忍\",\n          \"accent\": \"不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\", \"S05-B2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可他不想连开心的回忆都躲着\",\n          \"accent\": \"开心的回忆\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-1\", \"S05-B3\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"跟自己争得没了力气\",\n          \"accent\": \"没了力气\",\n          \"emotion\": \"疲惫\",\n          \"from\": [\"S05-2\", \"S05-B5\"],\n          \"at\": 16\n        },\n        {\n          \"text\": \"不服气慢慢淡了\",\n          \"accent\": \"慢慢淡了\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\", \"S05-B5\"],\n          \"at\": 24\n        },\n        {\n          \"text\": \"想到已不在那些人身边他难受\",\n          \"accent\": \"不在那些人身边\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\", \"S05-B3\"],\n          \"at\": 32\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"夜色里两个影子低声说话\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"116-147\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"愤怒难过，仍想护住自己不肯算了\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116-127\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"像某个人，也像故乡或旧日生活\",\n          \"after\": 1,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116-147\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"记忆有了温度，眷恋里仍有失落\",\n          \"after\": 4,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116-147\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"脚下地板忽然不见，只剩一个声音\",\n          \"after\": 3,\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128-129,139-144\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"不安加深，深呼吸后松开，只是累了\",\n          \"after\": 3,\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"132-147\",\n          \"at\": 44\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"快速音型逐渐放缓变稀，最后化成疏和弦\",\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128-147\"\n        },\n        {\n          \"text\": \"旋律几乎单独露出来\",\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128-129,139-144\"\n        },\n        {\n          \"text\": \"最后落成较慢较疏的和弦\",\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"144-147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"难受缓下来他没再压住想念\",\n          \"accent\": \"没再压住想念\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\", \"S06-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想起从前不必时时防备\",\n          \"accent\": \"不必时时防备\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-1\", \"S06-B2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"身边没了那些人他才懂得轻松\",\n          \"accent\": \"才懂得轻松\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"他想再过不用多说的亲近日子\",\n          \"accent\": \"亲近日子\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-3\", \"S06-B2\"],\n          \"at\": 30\n        },\n        {\n          \"text\": \"可他怕以后再也没有了\",\n          \"accent\": \"再也没有了\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-3\"],\n          \"at\": 40\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"玻璃罩里母亲哼摇篮曲，呼吸也轻\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148-180\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"安宁留不久，现实也没变好\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148-180\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"像圣咏也像秘密，终于不用解释难过\",\n          \"after\": 1,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148-180\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"不必装坚强，愿望委屈思念浮上来\",\n          \"after\": 1,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148-180\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"向遥远处祈求，却未必有回应\",\n          \"after\": 4,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148-180\",\n          \"at\": 45\n        },\n        {\n          \"text\": \"回不去的家园梦里亮起，心暖轻轻看着\",\n          \"after\": 4,\n          \"from\": [\"S06-4\", \"S06-B2\", \"S06-B4\"],\n          \"bars\": \"约160\",\n          \"at\": 55\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旋律绵长从容，几乎停在原地\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148-180\"\n        },\n        {\n          \"text\": \"歌声从含蓄试探慢慢展开\",\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"148-167\"\n        },\n        {\n          \"text\": \"后段歌唱更饱满迫切，末尾像没说完\",\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"168-180\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"刚安心就想到往后怎么办？\",\n          \"accent\": \"怎么办\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"遇上难事他能独自扛住吗？\",\n          \"accent\": \"独自扛住吗\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-1\", \"S07-B3\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"当初只想不再受那些气\",\n          \"accent\": \"不再受那些气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-2\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"早知道会这么孤单他还会走吗？\",\n          \"accent\": \"还会走吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-2\"],\n          \"at\": 21\n        },\n        {\n          \"text\": \"他想找回亲近却不愿再受气\",\n          \"accent\": \"不愿再受气\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-3\"],\n          \"at\": 28\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"寒风吹窗，甜梦骤裂，后颈凉心跳猛\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"刚才思绪被截断，心里仍没安定\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182-197\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"熟悉的动作和舞步突然闯进来\",\n          \"after\": 3,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181-205\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"这份亲切反让失去更清楚\",\n          \"after\": 3,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181-205\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"事情像过去了，心里仍翻转找不到出口\",\n          \"after\": 1,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198-205\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"当初离开时那股决心也找不着了\",\n          \"after\": 4,\n          \"from\": [\"S07-3\", \"S07-B5\"],\n          \"bars\": \"\",\n          \"at\": 39\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高音区忽然浮出细长颤音\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\"\n        },\n        {\n          \"text\": \"舞步突然闯入，熟悉舞曲气息已不完整\",\n          \"from\": [\"S07-B2\", \"S07-B5\"],\n          \"bars\": \"182-197\"\n        },\n        {\n          \"text\": \"连续颤音一层层累积\",\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198-205\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"他先把回去的事放一边\",\n          \"accent\": \"放一边\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起被当作自己人心里暖了\",\n          \"accent\": \"心里暖了\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\", \"S08-B1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他没想回头暖意很快淡了\",\n          \"accent\": \"没想回头\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-1\", \"S08-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"回忆陪不了他扛难事心又悬起\",\n          \"accent\": \"心又悬起\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-2\", \"S08-B3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像临走前回头一眼，胸口短暂喘口气\",\n          \"after\": 2,\n          \"from\": [\"S08-B2\", \"S08-B3\"],\n          \"bars\": \"206-213\",\n          \"at\": 12\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"缓慢宽广的歌唱短暂回来\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"206-213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他分不清想回去的原因\",\n          \"accent\": \"分不清\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-1\", \"S09-B2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"是舍不得被当作自己人\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S09-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"还是怕孤单到愿意再受气\",\n          \"accent\": \"愿意再受气\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"这念头让他一阵心慌\",\n          \"accent\": \"心慌\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"他连往下想都不敢了\",\n          \"accent\": \"不敢了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像重新遇见那个不知怎么办的自己\",\n          \"after\": 0,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214-215\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"这回知道那个自己经历过什么，仍没答案\",\n          \"after\": 4,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214-215\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"双手铺开巨大的颤音光晕\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214-215\"\n        },\n        {\n          \"text\": \"开头沉重引子闪现，声音短暂落稳又漂高\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"214-215\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他最舍不得有人把他当自己人\",\n          \"accent\": \"当自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可回去还能像从前那样吗？\",\n          \"accent\": \"还能像从前那样吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"当初那些难受不能当没发生\",\n          \"accent\": \"不能当没发生\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"光凭舍不得他仍不敢回去\",\n          \"accent\": \"仍不敢回去\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"他想得很累眼下日子也不踏实\",\n          \"accent\": \"很累\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S10-3\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"忽然像失重，整个人悬在半空\",\n          \"after\": 4,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"221-225\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"那么我究竟要怎样继续生活？\",\n          \"after\": 4,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"216-225\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"明知那件事重要，却没力气重讲\",\n          \"after\": 4,\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"216-225\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的歌和舞曲只剩断续碎片\",\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216-225\"\n        },\n        {\n          \"text\": \"摇篮曲破碎重现，听来更凄厉哀婉\",\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216-225\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"回去未必能找回那份亲近\",\n          \"accent\": \"未必\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他却忍不住想万一能呢？\",\n          \"accent\": \"万一能呢\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他不愿只凭指望回去再忍让\",\n          \"accent\": \"不愿\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他想先把眼下日子过稳些\",\n          \"accent\": \"过稳些\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-3\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"他怕独自扛难事却不收回打算\",\n          \"accent\": \"不收回打算\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-4\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"困兽般顶住，祈祷开始变成意志\",\n          \"after\": 4,\n          \"from\": [\"S11-B1\", \"S11-B2\"],\n          \"bars\": \"226-241\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"害怕还在，脚往前走，停滞松开一点\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"226-241\",\n          \"at\": 15\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"低音波涛涌起，和弦像重锤反复砸下\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226-241\"\n        },\n        {\n          \"text\": \"每次爆发后，声音没有真正落稳\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226-237\"\n        },\n        {\n          \"text\": \"步伐从试探开始，最后几小节渐渐聚拢\",\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"226-241\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他不再逼自己选边站\",\n          \"accent\": \"不再逼自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-1\", \"S12-2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"那些气不该忍开心也是真的\",\n          \"accent\": \"开心也是真的\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他不再怪自己当初离开\",\n          \"accent\": \"不再怪自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他不愿只为有人陪着就回头\",\n          \"accent\": \"不愿\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"他愿带着想念继续过日子\",\n          \"accent\": \"继续过日子\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-2\", \"S12-B2\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"会心软也怕独自熬\",\n          \"after\": 4,\n          \"from\": [\"S12-2\"],\n          \"bars\": \"\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"还会犹疑疲惫，不必假装没受过伤\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"242-253\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"向前时脚下像短暂斜了一下\",\n          \"after\": 4,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"249-253\",\n          \"at\": 15\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉的舞曲主题以雷鸣般声势回来\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"242-253\"\n        },\n        {\n          \"text\": \"向前的脚步中途忽然换了一下色彩\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"249-253\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"旧日亲近让他心热也盼重现\",\n          \"accent\": \"盼重现\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他有劲头过好日子不再较劲\",\n          \"accent\": \"过好日子\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他怕再遇亲近的人要等很久\",\n          \"accent\": \"等很久\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S13-3\"],\n          \"at\": 16\n        },\n        {\n          \"text\": \"若有人再把他当自己人他会珍惜\",\n          \"accent\": \"他会珍惜\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-4\"],\n          \"at\": 24\n        },\n        {\n          \"text\": \"若没有也好好过不为留人忍气\",\n          \"accent\": \"不为留人忍气\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S13-4\", \"S13-B5\"],\n          \"at\": 32\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"管风琴般庄严，柔软歌声也站到明亮处\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254-270\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"故土、共同记忆和希望也浮上来\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254-270\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"密集音符像激流喷涌，心跳几乎到极限\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254-270\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"气流推着身体往前跑，兴奋得来不及喘\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"269-280\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"成功真的稳了吗？又像终于能喘口气\",\n          \"after\": 2,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"281-287\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"最后像一个决定，也像忽然从梦中醒来\",\n          \"after\": 4,\n          \"from\": [\"S13-B5\"],\n          \"bars\": \"286-288\",\n          \"at\": 42\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"柔软歌唱转入宏大音响，随后迅疾冲出\",\n          \"f