{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"accent\": \"很想靠近\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"]\n        },\n        {\n          \"text\": \"他怕对方觉得负担太重\",\n          \"accent\": \"负担太重\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"]\n        },\n        {\n          \"text\": \"他只敢露出一点喜欢\",\n          \"accent\": \"一点喜欢\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-2\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"这点亲近很甜他还拿不准下次能否坦白\",\n          \"after\": 2,\n          \"from\": [\"S01-3\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"明知说出口会改变关系便先沉默\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"像刚踏上微晃船板一瞬失重\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"两下和弦像夏夜烟花突然迸开\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"光点缓缓飘落仍悬着摇荡未成形\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没有因他在意退开\",\n          \"accent\": \"没有退开\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"]\n        },\n        {\n          \"text\": \"他这才慢慢放松下来\",\n          \"accent\": \"放松下来\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"]\n        },\n        {\n          \"text\": \"他想更靠近几乎藏不住喜欢\",\n          \"accent\": \"藏不住喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\"]\n        },\n        {\n          \"text\": \"又怕太急弄坏眼下的自在\",\n          \"accent\": \"眼下的自在\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"]\n        },\n        {\n          \"text\": \"他还没分开就先舍不得\",\n          \"accent\": \"先舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"两道旋律贴得像耳边低语\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约6–16\"\n        },\n        {\n          \"text\": \"夏末湿热的风裹着皮肤\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约6–16\"\n        },\n        {\n          \"text\": \"脚下像有心跳和水浪托着\",\n          \"after\": 1,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–5\"\n        },\n        {\n          \"text\": \"船上舒服地漂着水和时间仍往前\",\n          \"after\": 4,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\"\n        },\n        {\n          \"text\": \"柔软落音像甜蜜确认又有点鼻酸\",\n          \"after\": 4,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"约7–11\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"两条旋律贴近交织\",\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约6–16\"\n        },\n        {\n          \"text\": \"歌声未浮出左手已一下一下摇动\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–5\"\n        },\n        {\n          \"text\": \"歌声忽然上涌又轻轻呼出一口气\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不去想以后\",\n          \"accent\": \"不去想以后\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"]\n        },\n        {\n          \"text\": \"只想舒服地待在亲近里\",\n          \"accent\": \"舒服地待着\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"]\n        },\n        {\n          \"text\": \"他想说自己有多喜欢\",\n          \"accent\": \"有多喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S03-2\"]\n        },\n        {\n          \"text\": \"也想问对方是否也喜欢这样\",\n          \"accent\": \"是否也喜欢\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"]\n        },\n        {\n          \"text\": \"没想好怎么开口念头就淡了\",\n          \"accent\": \"念头就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"说完重要的话还沉浸着沉默也舒服\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"身体还在这里心却慢慢漂远\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"急切念头只在水面露一下头\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"约20–21\"\n        },\n        {\n          \"text\": \"水波像被暗流拖住声音悬在半途\",\n          \"after\": 1,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"约20–22\"\n        },\n        {\n          \"text\": \"风吹碎的倒影难拼也像谈话遇心结\",\n          \"after\": 3,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇荡中忽然冒出几句短促声音\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"约20–21\"\n        },\n        {\n          \"text\": \"流动像被暗流拖住有些声音悬着\",\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"约20–22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又让他欢喜\",\n          \"accent\": \"又让他欢喜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"]\n        },\n        {\n          \"text\": \"他想起上回有话没说\",\n          \"accent\": \"有话没说\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-1\"]\n        },\n        {\n          \"text\": \"这回他几乎想把话全说出\",\n          \"accent\": \"全说出\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"]\n        },\n        {\n          \"text\": \"他盼对方喜欢坦白的自己\",\n          \"accent\": \"坦白的自己\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-2\"]\n        },\n        {\n          \"text\": \"他怕说太多最后还是收住\",\n          \"accent\": \"最后还是收住\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"说出来也许能把好时光留久些\",\n          \"after\": 3,\n          \"from\": [\"S04-3\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"怕让对方为难连原有自在也会丢\",\n          \"after\": 4,\n          \"from\": [\"S04-3\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"原本轻握的手不知不觉握得更紧\",\n          \"after\": 4,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"越想抱紧对方船身越颠簸\",\n          \"after\": 4,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"还没失去就已舍不得鼻酸\",\n          \"after\": 0,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"话越说越快深情却哽在喉咙\",\n          \"after\": 2,\n          \"from\": [\"S04-B1\", \"S04-B2\"],\n          \"bars\": \"24–34\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉歌声重返转音更华丽更急切\",\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"高处长颤音亮得刺眼随后渐弱\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"约30–34\"\n        },\n        {\n          \"text\": \"摇荡到末尾渐渐慢下来\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"24–34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他不知不觉露出喜欢\",\n          \"accent\": \"露出喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"]\n        },\n        {\n          \"text\": \"对方看出他有多在乎\",\n          \"accent\": \"多在乎\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-1\"]\n        },\n        {\n          \"text\": \"他怕太黏连相处都拿不准\",\n          \"accent\": \"拿不准\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-2\", \"S05-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"心里空落落熟悉的亲近像隔了一层\",\n          \"after\": 2,\n          \"from\": [\"S05-2\", \"S05-3\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"小船失了托举攥紧的手也松开\",\n          \"after\": 2,\n          \"from\": [\"S05-B1\", \"S05-B3\"],\n          \"bars\": \"35–39\"\n        },\n        {\n          \"text\": \"幸福是真的吗还能维持多久？\",\n          \"after\": 2,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"丰满伴奏忽然撤去只剩单线旋律\",\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他在乎却没变\",\n          \"accent\": \"却没变\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"]\n        },\n        {\n          \"text\": \"他才又能像从前那样自在\",\n          \"accent\": \"自在\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"]\n        },\n        {\n          \"text\": \"安静时他仍想靠近又怕要太多\",\n          \"accent\": \"怕要太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"]\n        },\n        {\n          \"text\": \"他猜对方也舍不得结束亲近\",\n          \"accent\": \"也舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"对方不知道他刚才多怕被嫌弃\",\n          \"after\": 2,\n          \"from\": [\"S06-2\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"像月光照着年少初恋的下午\",\n          \"after\": 1,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"心里刚说算了又放不下\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"夜里泛酸好时光像回忆谁也进不了心底\",\n          \"after\": 2,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"回忆里气味和身体感觉都回来\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"幻想遗憾快感混在一起越舒服越迷失\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇荡变轻左手波浪碎成细纹\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"新旋律清澈舒展像一支牧歌\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"另一条旋律不时插话又缠上来\",\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他觉得对方也许需要他陪\",\n          \"accent\": \"需要他陪\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-1\"]\n        },\n        {\n          \"text\": \"和他在一起也能安心\",\n          \"accent\": \"也能安心\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"]\n        },\n        {\n          \"text\": \"想到互相依靠他高兴又心紧\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-2\"]\n        },\n        {\n          \"text\": \"他盼对方想找人陪时会想到他\",\n          \"accent\": \"会想到他\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\"]\n        },\n        {\n          \"text\": \"他也想一直陪在对方身边\",\n          \"accent\": \"一直陪在身边\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"身体被情欲执念和生命眷恋推着走\",\n          \"after\": 2,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"这股暖意带一点情色的快感\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"明知被卷进去却暂时不想出来\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"越舒服越让人失去方向\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"美好还在时间却一直经过\",\n          \"after\": 4,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏音符变密内层声音不断攀升\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"低音反复重击像沉重脉搏催促\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"上回露出心意对方仍亲近\",\n          \"accent\": \"仍亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"]\n        },\n        {\n          \"text\": \"他想大方回应这份亲近\",\n          \"accent\": \"大方回应\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S08-1\"]\n        },\n        {\n          \"text\": \"他开始盼两人能好很久\",\n          \"accent\": \"好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"]\n        },\n        {\n          \"text\": \"可他没把握以后还会这样\",\n          \"accent\": \"没把握\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"身体像重新有了弹性\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"轻快得像调情也像回应\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"快乐余温还在心里已泛起怀念\",\n          \"after\": 3,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旋律忽然舒展直接像歌剧咏叹调\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌声向上散开后忽然戛然而止\",\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他怕对方不再需要他陪\",\n          \"accent\": \"不再需要他陪\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"]\n        },\n        {\n          \"text\": \"也怕对方和他待着不自在\",\n          \"accent\": \"不自在\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"]\n        },\n        {\n          \"text\": \"他一下安静下来不敢想以后\",\n          \"accent\": \"不敢想以后\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"]\n        },\n        {\n          \"text\": \"对方一直没退开他有点高兴\",\n          \"accent\": \"有点高兴\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"也许对方喜欢他在身边\",\n          \"after\": 3,\n          \"from\": [\"S09-3\"],\n          \"bars\": \"\"\n        },\n        {\n          \"text\": \"对视停住呼吸渴望仍悬着\",\n          \"after\": 2,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\"\n        },\n        {\n          \"text\": \"听着余响心里问刚才是真的吗接下来呢\",\n          \"after\": 2,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\"\n        },\n        {\n          \"text\": \"阳光隔着薄雾夜空比愿望更大\",\n          \"after\": 2,\n          \"from\": [\"S09-B2\", \"S09-B4\"],\n          \"bars\": \"72–77\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉摇荡退开音乐忽然收住\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–75\"\n        },\n        {\n          \"text\": \"轻柔和弦与颤音悬在半空\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"76–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他暂时不猜以后怎样\",\n          \"accent\": \"暂时不猜\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"]\n        },\n        {\n          \"text\": \"他先享受眼前的亲近\",\n          \"accent\": \"眼前的亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"]\n        },\n        {\n          \"text\": \"紧绷松开他亮堂得想笑又想哭\",\n          \"accent\": \"想笑又想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"]\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"心事没解决只是暂时不管\",\n          \"after\": 0,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"像在时间里开出一小块空地\",\n          \"after\": 1,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"像灵魂飘出身体悬在夏夜微风\",\n          \"after\": 2,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高处细亮音符像银丝和细雨\",\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"一串琶音从高处倾泻落水\",\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"80–83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他知道自己需要对方\",\n          \"accent\": \"需要对方\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"]\n        },\n        {\n          \"text\": \"对方有时也需要他\",\n          \"accent\": \"也需要他\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"]\n        },\n        {\n          \"text\": \"即使对方不需要他他仍愿意陪\",\n          \"accent\": \"仍愿意陪\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"]\n        },\n        {\n          \"text\": \"他不再藏着喜欢\",\n          \"accent\": \"不再藏着\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\", \"S11-2\"]\n        },\n        {\n          \"text\": \"他不能决定对方还愿不愿他陪\