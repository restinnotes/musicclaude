{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"夏夜威尼斯上空升起的一束烟花\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"夏夜威尼斯\"\n        },\n        {\n          \"quote\": \"有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"关系会改变\"\n        },\n        {\n          \"quote\": \"这里是刚刚踏上船板的感觉，还不是整个人已经安稳地交给规律起伏的水浪。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现自己很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"心里一下热起来\"\n        },\n        {\n          \"text\": \"他怕显得太需要对方\",\n          \"point\": \"只敢流露出一点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"怕显得太需要对方\"\n        },\n        {\n          \"text\": \"这点亲近已让他觉得甜\",\n          \"point\": \"下次还敢更坦白吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这点亲近已让他觉得甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"放弃对重力的控制，把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"放弃重力控制\"\n        },\n        {\n          \"quote\": \"一根温柔的刺\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"眼前的好还在，心里却已经有一点鼻酸\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开，仍愿意亲近\",\n      