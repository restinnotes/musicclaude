        "S01-B1"
       ],
       "bars": "1–3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "rows": [
    {
     "form": "连贯",
     "text": "对方没有因为他露出在意就退开，仍愿意亲近，两个人肩膀挨着肩膀，呼吸贴在一起，他才渐渐放松下来。",
