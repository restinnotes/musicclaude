     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他因对方依旧愿意亲近而终于慢慢放松下来。",
