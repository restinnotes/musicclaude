       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从暖金水面滑进古桥阴影，清凉如年少初恋的下午",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "关于以后可能失去的念头还是会回来",
