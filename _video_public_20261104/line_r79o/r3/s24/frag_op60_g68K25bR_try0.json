{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他忽然发现自己很想靠近",
     "accent": "很想靠近",
     "emotion": "炽热",
     "from": [
      "S01-1"
     ]
    },
    {
     "text": "他怕对方知道自己有多需要",
     "accent": "有多需要",
     "emotion": "不安",
     "from": [
      "S01-2"
     ]
    },
    {
     "text": "所以他只敢露出一点喜欢",
     "accent": "一点喜欢",
     "emotion": "悬着",
     "from": [
      "S01-2"
     ]
    },
    {
     "text": "一点亲近让他甜想坦白又没底",
     "accent": "想坦白又没底",
     "emotion": "欢喜",
     "from": [
      "S01-3"
     ]
    }
   ],
   "small": [
    {
     "text": "像话到嘴边，先沉默几秒",
     "after": 1,
     "from": [
      "S01-B2"
     ],
     "bars": "1–3"
    },
    {
     "text": "刚踏上微晃的船板，身体一瞬失重",
     "after": 0,
     "from": [
      "S01-B3"
     ],
     "bars": "1–3"
    }
   ],
   "notes": [
    {
     "text": "两下响亮的和弦像烟花突然迸开",
     "from": [
      "S01-B1"
     ],
     "bars": "1–3"
    },
    {
     "text": "细碎亮点缓缓落下，余音仍悬着",
     "from": [
      "S01-B1"
     ],
     "bars": "1–3"
    },
    {
     "text": "船歌的摇荡感还没有真正成形",
     "from": [
      "S01-B1",
      "S01-B3"
     ],
     "bars": "1–3"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "对方没有因为他的在意退开",
     "accent": "没有退开",
     "emotion": "亲密",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "他才渐渐放松下来",
     "accent": "放松下来",
     "emotion": "安心",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "他想靠得更近却还是收住",
     "accent": "还是收住",
     "emotion": "炽热",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "他想到这样的好总会过去",
     "accent": "总会过去",
     "emotion": "悬着",
     "from": [
      "S02-3",
      "S02-B2"
     ]
    },
    {
     "text": "还没分开他就有点舍不得",
     "accent": "有点舍不得",
     "emotion": "孤单",
     "from": [
      "S02-3",
      "S02-B4"
     ]
    }
   ],
   "small": [
    {
     "text": "像两人肩挨着肩，连呼吸都贴近",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "像熟人静静坐着，不必找话题",
     "after": 1,
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "像夏末潮湿的风，温热地裹着皮肤",
     "after": 1,
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "身体交给船底，不必踩实，水仍往前流",
     "after": 4,
     "from": [
      "S02-B2"
     ],
     "bars": "4–16"
    },
    {
     "text": "热切地涌上来，又轻轻退回去",
     "after": 2,
     "from": [
      "S02-B3"
     ],
     "bars": "12–16"
    },
    {
     "text": "甜蜜里带着一点鼻酸",
     "after": 4,
     "from": [
      "S02-B4"
     ],
     "bars": "约7–11"
    }
   ],
   "notes": [
    {
     "text": "歌声还没浮出来，摇荡已先开始",
     "from": [
      "S02-B2"
     ],
     "bars": "4–5"
    },
    {
     "text": "两道歌声贴得很近，像耳边低语",
     "from": [
      "S02-B1"
     ],
     "bars": "约6–16"
    },
    {
     "text": "几次柔软的落音轻轻点在句尾",
     "from": [
      "S02-B4"
     ],
     "bars": "约7–11"
    },
    {
     "text": "歌声先向上涌起，随后轻轻收回",
     "from": [
      "S02-B3"
     ],
     "bars": "12–16"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他难得只想待在亲近里",
     "accent": "只想待在亲近里",
     "emotion": "安心",
     "from": [
      "S03-1"
     ]
    },
    {
     "text": "他想说多喜欢也问对方是否一样",
     "accent": "是否一样",
     "emotion": "炽热",
     "from": [
      "S03-2"
     ]
    },
    {
     "text": "他没想好怎么说便没了说的念头",
     "accent": "没了说的念头",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ]
    }
   ],
   "small": [
    {
     "text": "身体还在这里，心却慢慢漂远",
     "after": 0,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23"
    },
    {
     "text": "亲密交谈后的沉默很舒服",
     "after": 0,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23"
    },
    {
     "text": "身体像被水波托着，暂时哪里也不去",
     "after": 0,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23"
    },
    {
     "text": "急着表达的念头刚冒头就沉下去",
     "after": 1,
     "from": [
      "S03-B2"
     ],
     "bars": "约20–21"
    },
    {
     "text": "像风吹碎的倒影，也像碰到解不开的结",
     "after": 2,
     "from": [
      "S03-B3"
     ],
     "bars": "17–23"
    },
    {
     "text": "亲密的谈话像碰到一个解不开的结",
     "after": 2,
     "from": [
      "S03-B3"
     ],
     "bars": "17–23"
    }
   ],
   "notes": [
    {
     "text": "短促急切的几声突然冒出来",
     "from": [
      "S03-B2"
     ],
     "bars": "约20–21"
    },
    {
     "text": "流动的声音像被暗流拖住",
     "from": [
      "S03-B3"
     ],
     "bars": "20–22"
    },
    {
     "text": "有些声音绕远了，像挂在半途",
     "from": [
      "S03-B3"
     ],
     "bars": "20–22"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "熟悉的亲近让他想起上回没说",
     "accent": "上回没说",
     "emotion": "欢喜",
     "from": [
      "S04-1"
     ]
    },
    {
     "text": "这回他几乎想把喜欢全说出",
     "accent": "全说出",
     "emotion": "炽热",
     "from": [
      "S04-2"
     ]
    },
    {
     "text": "他甚至盼说出口能把好时光留久",
     "accent": "把好时光留久",
     "emotion": "欢喜",
     "from": [
      "S04-3"
     ]
    },
    {
     "text": "可他怕说太多会让对方为难",
     "accent": "让对方为难",
     "emotion": "不安",
     "from": [
      "S04-3"
     ]
    },
    {
     "text": "最后还是留了些话没说",
     "accent": "留了些话没说",
     "emotion": "悬着",
     "from": [
      "S04-3"
     ]
    }
   ],
   "small": [
    {
     "text": "他盼对方喜欢自己，喜欢他不再收着",
     "after": 1,
     "from": [
      "S04-2"
     ],
     "bars": ""
    },
    {
     "text": "像讲往事，越讲越急，还忍不住补细节",
     "after": 1,
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "像话到喉咙口，忽然颤得说不出",
     "after": 2,
     "from": [
      "S04-B2"
     ],
     "bars": "约30–34"
    },
    {
     "text": "像握着对方的手，不知不觉越握越紧",
     "after": 3,
     "from": [
      "S04-B3"
     ],
     "bars": "24–34"
    },
    {
     "text": "像想抱紧对方，船却晃得更厉害",
     "after": 3,
     "from": [
      "S04-B3"
     ],
     "bars": "24–34"
    }
   ],
   "notes": [
    {
     "text": "熟悉的歌声回来，这次更华丽急切",
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "高处一段细密颤动亮得刺眼",
     "from": [
      "S04-B2"
     ],
     "bars": "约30–34"
    },
    {
     "text": "声音向高处走时又渐渐收弱",
     "from": [
      "S04-B2"
     ],
     "bars": "约30–34"
    },
    {
     "text": "摇荡到结尾慢慢放缓",
     "from": [
      "S04-B2"
     ],
     "bars": "34"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "他几次收住这回心意被看出",
     "accent": "被看出",
     "emotion": "炽热",
     "from": [
      "S05-1"
     ]
    },
    {
     "text": "他心里空落落不知怎么相处",
     "accent": "不知怎么相处",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    },
    {
     "text": "他怕对方嫌他太黏",
     "accent": "太黏",
     "emotion": "不安",
     "from": [
      "S05-3"
     ]
    }
   ],
   "small": [
    {
     "text": "对方仍愿亲近，他却觉得隔了一层",
     "after": 2,
     "from": [
      "S05-1",
      "S05-3"
     ],
     "bars": ""
    },
    {
     "text": "像小船漂进雾里，脚下没支撑，时间松了",
     "after": 1,
     "from": [
      "S05-B1"
     ],
     "bars": "35–39"
    },
    {
     "text": "重要的话悬在嘴边，幸福能维持多久",
     "after": 1,
     "from": [
      "S05-B2"
     ],
     "bars": "35–39"
    }
   ],
   "notes": [
    {
     "text": "厚实的摇荡忽然抽走，只剩单薄旋律",
     "from": [
      "S05-B1"
     ],
     "bars": "35–39"
    },
    {
     "text": "像终于松开手，深吸一口气",
     "from": [
      "S05-B3"
     ],
     "bars": "35–39"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "对方看出他在乎却没有退开",
     "accent": "没有退开",
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "他才慢慢恢复从前的自在",
     "accent": "从前的自在",
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "他还想靠近却怕自己要得太多",
     "accent": "怕自己要得太多",
     "emotion": "不安",
     "from": [
      "S06-2"
     ]
    },
    {
     "text": "对方不知道他刚才多怕被嫌",
     "accent": "不知道",
     "emotion": "孤单",
     "from": [
      "S06-2"
     ]
    },
    {
     "text": "他猜对方也许舍不得结束亲近",
     "accent": "也许",
     "emotion": "悬着",
     "from": [
      "S06-3"
     ]
    }
   ],
   "small": [
    {
     "text": "这让他有点孤单",
     "after": 3,
     "from": [
      "S06-2"
     ],
     "bars": ""
    },
    {
     "text": "暖金水面滑入阴影，像童年初恋的月光",
     "after": 1,
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "心里一会儿说算了，一会儿又放不下",
     "after": 2,
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    },
    {
     "text": "说着说着忘了有人看，不再装得完整",
     "after": 2,
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    },
    {
     "text": "回家后心里泛酸，对方也陪不到那里",
     "after": 3,
     "from": [
      "S06-B3"
     ],
     "bars": "40–50"
    },
    {
     "text": "好时光还在眼前，恍惚已像回忆",
     "after": 3,
     "from": [
      "S06-B3"
     ],
     "bars": "40–50"
    }
   ],
   "notes": [
    {
     "text": "熟悉的摇荡变轻，碎成细细的水纹",
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "清澈舒展的新歌浮出来",
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "两道歌声一来一回，时而靠近时而退开",
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    },
    {
     "text": "独自回想那段关系，气味和身体感觉一阵阵涌来",
     "from": [
      "S06-B4"
     ],
     "bars": "40–50"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "他想起对方总愿意陪着他",
     "accent": "总愿意陪着他",
     "emotion": "亲密",
     "from": [
      "S07-1"
     ]
    },
    {
     "text": "他开始觉得对方有时也需要他",
     "accent": "也需要他",
     "emotion": "安心",
     "from": [
      "S07-1"
     ]
    },
    {
     "text": "也许能互相依靠他心紧还想待着",
     "accent": "心紧还想待着",
     "emotion": "欢喜",
     "from": [
      "S07-2"
     ]
    },
    {
     "text": "听着像身体被更深渴望推着走",
     "accent": "推着走",
     "emotion": "炽热",
     "from": [
      "S07-B1"
     ]
    },
    {
     "text": "他盼对方想找人陪时会想到自己",
     "accent": "想到自己",
     "emotion": "亲密",
     "from": [
      "S07-3"
     ]
    }
   ],
   "small": [
    {
     "text": "有他陪着，对方也许更安心",
     "after": 1,
     "from": [
      "S07-1"
     ],
     "bars": ""
    },
    {
     "text": "他也想一直陪在对方身边",
     "after": 4,
     "from": [
      "S07-3"
     ],
     "bars": ""
    },
    {
     "text": "光是安静享受已经不够了",
     "after": 3,
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    },
    {
     "text": "那股暖意越舒服，越让人失去方向",
     "after": 3,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61"
    },
    {
     "text": "明知自己被卷进去，还是不想出来",
     "after": 3,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61"
    },
    {
     "text": "美好还在眼前，音乐没有暗下来",
     "after": 4,
     "from": [
      "S07-B3"
     ],
     "bars": "53–61"
    }
   ],
   "notes": [
    {
     "text": "底下的音符越来越密，暗涌不断往上攀",
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    },
    {
     "text": "低沉的节奏像沉重脉搏一样催促",
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "对方依然亲近他想主动回应",
     "accent": "主动回应",
     "emotion": "欢喜",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "他开始盼两人能这样好很久",
     "accent": "好很久",
     "emotion": "欢喜",
     "from": [
      "S08-2"
     ]
    },
    {
     "text": "可他知道以后未必还会这样",
     "accent": "未必",
     "emotion": "不安",
     "from": [
      "S08-3"
     ]
    }
   ],
   "small": [
    {
     "text": "熟悉的摇荡像在轻轻催人向前",
     "after": 0,
     "from": [
      "S08-B1"
     ],
     "bars": "62–70"
    },
    {
     "text": "阳光和风重新落到身上",
     "after": 0,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70"
    },
    {
     "text": "身体像恢复弹性，带一点玩心",
     "after": 0,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70"
    },
    {
     "text": "像轻快的调情与回应",
     "after": 0,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70"
    },
    {
     "text": "快乐余温还在，心头已泛起怀念",
     "after": 2,
     "from": [
      "S08-B3"
     ],
     "bars": "69–71"
    }
   ],
   "notes": [
    {
     "text": "歌句忽然打开，一次次向上舒展",
     "from": [
      "S08-B1"
     ],
     "bars": "62–70"
    },
    {
     "text": "歌声向上散开，随后突然停住",
     "from": [
      "S08-B3"
     ],
     "bars": "69–71"
    }
   ]
  },
  {
   "sec": "S09",
   "big": [
    {
     "text": "他怕对方不再需要他陪",
     "accent": "不再需要他",
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "他一下不敢再往下想",
     "accent": "不敢再往下想",
     "emotion": "悬着",
     "from": [
      "S09-2"
     ]
    },
    {
     "text": "对方没退开两人仍亲近",
     "accent": "仍亲近",
     "emotion": "安心",
     "from": [
      "S09-3"
     ]
    },
    {
     "text": "也许对方喜欢他在身边",
     "accent": "喜欢他在身边",
     "emotion": "欢喜",
     "from": [
      "S09-3"
     ]
    }
   ],
   "small": [
    {
     "text": "也怕对方和他待着不自在",
     "after": 0,
     "from": [
      "S09-1"
     ],
     "bars": ""
    },
    {
     "text": "像对视到呼吸都停了，渴望仍悬着",
     "after": 1,
     "from": [
      "S09-B1"
     ],
     "bars": "72–77"
    },
    {
     "text": "像阳光被薄雾柔化，四周仍有光",
     "after": 1,
     "from": [
      "S09-B2"
     ],
     "bars": "72–77"
    },
    {
     "text": "刚才的亲近是真的吗，接下来怎么办",
     "after": 1,
     "from": [
      "S09-B3"
     ],
     "bars": "72–77"
    },
    {
     "text": "抬头看夜空，美好大过愿望，不安暂退",
     "after": 3,
     "from": [
      "S09-B4"
     ],
     "bars": "72–77"
    }
   ],
   "notes": [
    {
     "text": "前面的推进忽然收住，摇荡退到一旁",
     "from": [
      "S09-B1"
     ],
     "bars": "72–75"
    },
    {
     "text": "轻柔的颤动和和弦悬在半空",
     "from": [
      "S09-B1"
     ],
     "bars": "76–77"
    }
   ]
  },
  {
   "sec": "S10",
   "big": [
    {
     "text": "他暂时不再猜往后怎样",
     "accent": "不再猜往后怎样",
     "emotion": "安心",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "先好好享受眼前的亲近",
     "accent": "眼前的亲近",
     "emotion": "亲密",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "这一刻不必再逼自己控制感受",
     "accent": "不必再逼自己",
     "emotion": "安心",
     "from": [
      "S10-B1"
     ]
    }
   ],
   "small": [
    {
     "text": "像绷着肩的人终于长长呼气",
     "after": 2,
     "from": [
      "S10-B1"
     ],
     "bars": "78–83"
    },
    {
     "text": "胸腔打开，眼泪也不必再忍",
     "after": 2,
     "from": [
      "S10-B1"
     ],
     "bars": "78–83"
    },
    {
     "text": "时间像被清风拨开，只短暂有空地",
     "after": 1,
     "from": [
      "S10-B2"
     ],
     "bars": "78–83"
    },
    {
     "text": "听着像身体失重，灵魂飘在风里",
     "after": 2,
     "from": [
      "S10-B3"
     ],
     "bars": "78–83"
    }
   ],
   "notes": [
    {
     "text": "高处细亮的小音符像银丝和细雨",
     "from": [
      "S10-B4"
     ],
     "bars": "78–83"
    },
    {
     "text": "一串音符像飞瀑从高处倾泻",
     "from": [
      "S10-B4"
     ],
     "bars": "80–83"
    }
   ]
  },
  {
   "sec": "S11",
   "big": [
    {
     "text": "他想到彼此有时都需要对方",
     "accent": "彼此都需要",
     "emotion": "亲密",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "即使对方不需要他仍愿意陪着",
     "accent": "仍愿意陪着",
     "emotion": "安心",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "他不再把喜欢藏起来",
     "accent": "不再藏起来",
     "emotion": "炽热",
     "from": [
      "S11-1",
      "S11-2"
     ]
    },
    {
     "text": "他不能决定对方以后还要不要他",
     "accent": "不能决定",
     "emotion": "不安",
     "from": [
      "S11-3"
     ]
    },
    {
     "text": "想到未必总亲近他心口发疼",
     "accent": "心口发疼",
     "emotion": "孤单",
     "from": [
      "S11-3",
      "S11-B3"
     ]
    }
   ],
   "small": [
    {
     "text": "高兴得连害臊都顾不上",
     "after": 2,
     "from": [
      "S11-2"
     ],
     "bars": ""
    },
    {
     "text": "像终于说出：这是我的感情，不再道歉",
     "after": 2,
     "from": [
      "S11-B1"
     ],
     "bars": "84–92"
    },
    {
     "text": "像夕阳烧得血红金亮，刺眼得想哭",
     "after": 4,
     "from": [
      "S11-B3"
     ],
     "bars": "84–92"
    },
    {
     "text": "旧房仍熟悉，却知道亲近未必长久",
     "after": 4,
     "from": [
      "S11-B4"
     ],
     "bars": "84–92"
    },
    {
     "text": "悬着的期待像终于得到某种满足",
     "after": 3,
     "from": [
      "S11-B2"
     ],
     "bars": "约92"
    }
   ],
   "notes": [
    {
     "text": "熟悉的旋律再现，这次唱得直接有力",
     "from": [
      "S11-B1"
     ],
     "bars": "84–92"
    },
    {
     "text": "温柔的摇荡翻成层层惊涛",
     "from": [
      "S11-B1"
     ],
     "bars": "84–92"
    },
    {
     "text": "铺开的力量在末尾短暂悬起",
     "from": [
      "S11-B2"
     ],
     "bars": "约92"
    }
   ]
  },
  {
   "sec": "S12",
   "big": [
    {
     "text": "他顾不上对方是否也在乎",
     "accent": "顾不上",
     "emotion": "炽热",
     "from": [
      "S12-1"
     ]
    },
    {
     "text": "他只想把能给的都给对方",
     "accent": "都给对方",
     "emotion": "亲密",
     "from": [
      "S12-1"
     ]
    },
    {
     "text": "他知道再用心也难保以后仍亲近",
     "accent": "难保以后仍亲近",
     "emotion": "悬着",
     "from": [
      "S12-2"
     ]
    },
    {
     "text": "他还是想多陪对方一会儿",
     "accent": "多陪对方",
     "emotion": "炽热",
     "from": [
      "S12-2"
     ]
    },
    {
     "text": "他终于不再强迫自己收着",
     "accent": "不再强迫自己",
     "emotion": "欢喜",
     "from": [
      "S12-3"
     ]
    }
   ],
   "small": [
    {
     "text": "像被卷进更大的世界，自己暂时退后",
     "after": 1,
     "from": [
      "S12-B1"
     ],
     "bars": "93–102"
    },
    {
     "text": "这份狂喜像一场高烧",
     "after": 4,
     "from": [
      "S12-B2"
     ],
     "bars": "93–102"
    },
    {
     "text": "像久别重逢，忽然抱紧对方不肯松手",
     "after": 4,
     "from": [
      "S12-B2"
     ],
     "bars": "93–102"
    },
    {
     "text": "喉咙发紧眼眶湿润，分不清笑还是哭",
     "after": 4,
     "from": [
      "S12-B2"
     ],
     "bars": "93–102"
    },
    {
     "text": "像还想要更多，却始终得不到满足",
     "after": 3,
     "from": [
      "S12-B3"
     ],
     "bars": "93–102"
    },
    {
     "text": "那口气一直悬着，直到句尾才松开",
     "after": 3,
     "from": [
      "S12-B3"
     ],
     "bars": "93–102"
    }
   ],
   "notes": [
    {
     "text": "晴朗的歌被推得开阔而强烈",
     "from": [
      "S12-B1"
     ],
     "bars": "93–102"
    },
    {
     "text": "里面的声音彼此拉扯，一浪高过一浪",
     "from": [
      "S12-B1"
     ],
     "bars": "93–102"
    },
    {
     "text": "句尾一次次向上伸展，却始终被牵住",
     "from": [
      "S12-B3"
     ],
     "bars": "96–100"
    }
   ]
  },
  {
   "sec": "S13",
   "big": [
    {
     "text": "他更想听对方说以后不变",
     "accent": "以后不变",
     "emotion": "悬着",
     "from": [
      "S13-1"
     ]
    },
    {
     "text": "可就算听到他仍怕时间太快",
     "accent": "时间太快",
     "emotion": "不安",
     "from": [
      "S13-1"
     ]
    },
    {
     "text": "他如今更怕对方不再需要他",
     "accent": "不再需要他",
     "emotion": "不安",
     "from": [
      "S13-2"
     ]
    },
    {
     "text": "他想少露些心意免得太疼",
     "accent": "少露些心意",
     "emotion": "悬着",
     "from": [
      "S13-2"
     ]
    },
    {
     "text": "可他已不想把喜欢藏回去",
     "accent": "不想藏回去",
     "emotion": "炽热",
     "from": [
      "S13-3"
     ]
    }
   ],
   "small": [
    {
     "text": "刚到浪峰，身后又有更大的浪推来",
     "after": 1,
     "from": [
      "S13-B1"
     ],
     "bars": "103–110"
    },
    {
     "text": "刚觉得这么好是真的，心里就疼起来",
     "after": 1,
     "from": [
      "S13-B2"
     ],
     "bars": "103–110"
    },
    {
     "text": "像把珍贵的东西握住，才知道留不住",
     "after": 1,
     "from": [
      "S13-B2"
     ],
     "bars": "103–110"
    },
    {
     "text": "刚说了是，心里马上问可是呢",
     "after": 2,
     "from": [
      "S13-B3"
     ],
     "bars": "103–110"
    },
    {
     "text": "脚步像钉在地上，胸口却一沉再沉",
     "after": 3,
     "from": [
      "S13-B4"
     ],
     "bars": "103–110"
    }
   ],
   "notes": [
    {
     "text": "熟悉的句子反复出现，力度不断推高",
     "from": [
      "S13-B1"
     ],
     "bars": "103–110"
    },
    {
     "text": "明亮里渐渐混入尖锐暗沉的色彩",
     "from": [
      "S13-B2"
     ],
     "bars": "107–110"
    },
    {
     "text": "下面稳住不动，上面的声音一次次落下",
     "from": [
      "S13-B4"
     ],
     "bars": "103–110"
    }
   ]
  },
  {
   "sec": "S14",
   "big": [
    {
     "text": "最初他连喜欢都不敢多露",
     "accent": "不敢多露",
     "emotion": "悬着",
     "from": [
      "S14-1"
     ]
    },
    {
     "text": "如今仍亲近他心里又甜又酸",
     "accent": "又甜又酸",
     "emotion": "欢喜",
     "from": [
      "S14-1"
     ]
    },
    {
     "text": "他不后悔让对方看见喜欢",
     "accent": "不后悔",
     "emotion": "安心",
     "from": [
      "S14-1",
      "S14-3"
     ]
    },
    {
     "text": "他不再逼自己讨永远不变的保证",
     "accent": "逼自己讨",
     "emotion": "安心",
     "from": [
      "S14-2"
     ]
    },
    {
     "text": "他决定不把喜欢藏回去",
     "accent": "不把喜欢藏回去",
     "emotion": "炽热",
     "from": [
      "S14-3"
     ]
    }
   ],
   "small": [
    {
     "text": "他仍舍不得，也不知道以后怎样",
     "after": 3,
     "from": [
      "S14-2"
     ],
     "bars": ""
    },
    {
     "text": "心里仍温热，身体慢慢恢复平静",
     "after": 2,
     "from": [
      "S14-B1"
     ],
     "bars": "111–115"
    },
    {
     "text": "像从美梦醒来，还记得梦里的光",
     "after": 2,
     "from": [
      "S14-B1"
     ],
     "bars": "111–115"
    },
    {
     "text": "像经历震荡后站起身，整理衣服关上门",
     "after": 4,
     "from": [
      "S14-B3"
     ],
     "bars": "116"
    }
   ],
   "notes": [
    {
     "text": "熟悉的歌唱和摇荡幽幽回来",
     "from": [
      "S14-B2"
     ],
     "bars": "113–115"
    },
    {
     "text": "低沉的一句像独自沉思",
     "from": [
      "S14-B2"
     ],
     "bars": "113"
    },
    {
     "text": "细碎音符像水花溅向夜空",
     "from": [
      "S14-B2"
     ],
     "bars": "115"
    },
    {
     "text": "最后几下声音干脆沉重，船一下定住",
     "from": [
      "S14-B3"
     ],
     "bars": "116"
    },
    {
     "text": "结尾像接住开头悬着的话",
     "from": [
      "S14-B4"
     ],
     "bars": "113–116"
    }
   ]
  }
 ]
}