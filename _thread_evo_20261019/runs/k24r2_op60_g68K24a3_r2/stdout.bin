{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"accent\": \"很想靠近\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"怕对方觉得负担太重\",\n          \"accent\": \"负担太重\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他只敢露出一点喜欢\",\n          \"accent\": \"一点喜欢\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"一点亲近就让他觉得甜\",\n          \"accent\": \"觉得甜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S01-3\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"他还拿不准能否坦白\",\n          \"accent\": \"拿不准\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-3\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"怕开口改变关系，话到嘴边沉默\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"刚踏上船板，身体一瞬失重\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 7\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"两下和弦像威尼斯夏夜烟花，光点飘落仍悬着\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"船歌的稳定摇荡还没真正成形\",\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没有因他的在意退开\",\n          \"accent\": \"没有退开\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他这才渐渐放松下来\",\n          \"accent\": \"放松下来\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"他想顺势靠得更近\",\n          \"accent\": \"靠得更近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"怕太急弄坏自在 他收住了\",\n          \"accent\": \"他收住了\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"想到好时光会过去 他先舍不得\",\n          \"accent\": \"先舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 30\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"肩挨着肩，呼吸体温都贴得很近\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"沉默也不紧张，像夏末潮风裹着皮肤\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6–16\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"脚下不用踩实，任船底温柔托着\",\n          \"after\": 1,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"漂得舒服，水和时间却一直在走\",\n          \"after\": 4,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"感情忽然热切了一下，又轻轻收回\",\n          \"after\": 2,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"柔软落音像温柔的刺，甜得让人鼻酸\",\n          \"after\": 4,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7–11\",\n          \"at\": 32\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇荡先起，两条旋律随后贴近\",\n          \"from\": [\"S02-B1\", \"S02-B2\"],\n          \"bars\": \"4–16\"\n        },\n        {\n          \"text\": \"几次柔软落音轻轻落下\",\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7–11\"\n        },\n        {\n          \"text\": \"歌声短暂上涌，随后收回柔和\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不去琢磨以后\",\n          \"accent\": \"不去琢磨以后\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"只想舒服地待在这份亲近里\",\n          \"accent\": \"舒服地待着\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\", \"S03-B1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他想说自己有多喜欢\",\n          \"accent\": \"有多喜欢\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S03-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"也想问对方是不是一样\",\n          \"accent\": \"是不是一样\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"没想好怎么开口 念头就淡了\",\n          \"accent\": \"念头就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 19\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"水波托着身体，晃着却不去哪里\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"话后陶醉走神，沉默舒服，心慢慢漂远\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"想说的话冒出一下，很快又沉回去\",\n          \"after\": 3,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20–21\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"思绪像碎掉的倒影，闪着却拼不拢\",\n          \"after\": 3,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"谈话像碰到解不开的结，却没走向悲剧\",\n          \"after\": 3,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\",\n          \"at\": 19\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声退到后面，水波般流动仍托着\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"短促急切的声音忽然冒出\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20–21\"\n        },\n        {\n          \"text\": \"流动绕远滞留，声音像挂在半途\",\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20–22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又让他欢喜\",\n          \"accent\": \"又让他欢喜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想起上回想说却没开口\",\n          \"accent\": \"却没开口\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"这回几乎想把藏着的话说完\",\n          \"accent\": \"说完\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"怕对方为难 也怕自在被毁\",\n          \"accent\": \"怕自在被毁\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"他最后还是留了些话\",\n          \"accent\": \"留了些话\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-3\"],\n          \"at\": 32\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"本来一句就够，他又折回来补细节\",\n          \"after\": 2,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"他盼对方喜欢他，坦白的样子\",\n          \"after\": 2,\n          \"from\": [\"S04-B1\", \"S04-B2\"],\n          \"bars\": \"24–34\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"盼说出口能把眼下的好留久些\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"24–34\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"想说最深的情意，喉咙却发颤\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"手越握越紧，船舱平衡越脆弱\",\n          \"after\": 3,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"美好还在，水波却一直向前，心里鼻酸\",\n          \"after\": 4,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\",\n          \"at\": 30\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"两道声线贴近，花腔像光斑晃开\",\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\"\n        },\n        {\n          \"text\": \"高处长颤音像金光，随后渐渐收弱\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"这回他不知不觉忘了藏喜欢\",\n          \"accent\": \"忘了藏喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"对方已经看出他有多在乎\",\n          \"accent\": \"看出他有多在乎\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他空落落 怕对方嫌他太黏\",\n          \"accent\": \"怕对方嫌他太黏\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\", \"S05-3\"],\n          \"at\": 8\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"前几次想说又收住，对方仍愿亲近\",\n          \"after\": 0,\n          \"from\": [\"S05-1\"],\n          \"bars\": \"\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"只剩孤零旋律，像小船漂进雾里\",\n          \"after\": 2,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"耳语停了，心里问幸福真吗、能维持多久\",\n          \"after\": 2,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"攥紧的冲动退了，像松手深吸气\",\n          \"after\": 2,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"35–39\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"不知怎么相处，熟悉亲近也像隔层\",\n          \"after\": 2,\n          \"from\": [\"S05-2\", \"S05-3\"],\n          \"bars\": \"\",\n          \"at\": 12\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"丰满伴奏抽空，单薄旋律独自游走\",\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他在乎 相处仍如从前\",\n          \"accent\": \"仍如从前\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他才又能自在地待着\",\n          \"accent\": \"自在地待着\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"安静时他仍想靠近 却怕要太多\",\n          \"accent\": \"怕要太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他有点孤单\",\n          \"accent\": \"孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"他猜对方也舍不得结束？\",\n          \"accent\": \"也舍不得结束\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 25\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"古桥阴影里凉如月光，像童年初次心动\",\n          \"after\": 1,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"算了又放不下，说着说着不再装完整\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"夜里独处泛酸，最亲近的人也走不进心里\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"眼前的好时光，恍惚已经成了回忆\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"气味身体幻想遗憾快感交织，舒服又迷路\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"对方不知道，他刚才有多怕被嫌弃\",\n          \"after\": 3,\n          \"from\": [\"S06-2\"],\n          \"bars\": \"\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"清澈舒展的新旋律，像朴素牧歌\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\"\n        },\n        {\n          \"text\": \"低声旋律与另一声线时近时远\",\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他觉得对方或许也需要他陪\",\n          \"accent\": \"也需要他陪\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到两人也许能互相依靠\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"他高兴得收不住 心里忽然一紧\",\n          \"accent\": \"心里忽然一紧\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-2\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"更深的渴望推着他往前\",\n          \"accent\": \"更深的渴望\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-B1\"],\n          \"at\": 19\n        },\n        {\n          \"text\": \"他想一直陪在对方身边\",\n          \"accent\": \"一直陪在身边\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-3\"],\n          \"at\": 25\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"热度像情欲、执念和对生命的眷恋\",\n          \"after\": 3,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"独处回想，气味身体幻想遗憾快感交织\",\n          \"after\": 3,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"有点情色暖意，舒服得失去方向\",\n          \"after\": 3,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"明知被卷进去，暂时不想出来\",\n          \"after\": 3,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"美没有消失，时间却一直在经过\",\n          \"after\": 4,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"他陪着，对方或许安心，以后也想到他\",\n          \"after\": 4,\n          \"from\": [\"S07-1\", \"S07-3\"],\n          \"bars\": \"\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏变密，低音像沉重脉搏催促\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"对方仍愿亲近 他想主动回应\",\n          \"accent\": \"主动回应\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他开始盼两人还能好很久\",\n          \"accent\": \"好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"以后未必还会这样 他心里没底\",\n          \"accent\": \"心里没底\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-3\"],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"上回无意露了心意，对方这回仍亲近\",\n          \"after\": 0,\n          \"from\": [\"S08-1\"],\n          \"bars\": \"\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"不用分析和防备，像重新接触阳光和风\",\n          \"after\": 0,\n          \"from\": [\"S08-B1\", \"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"身体恢复弹性，带点玩心和调情回应\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"快乐余温还在，心头已泛起怀念\",\n          \"after\": 2,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌句忽然舒展，情绪一再抬高\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"歌声向上散开，随后突然停住\",\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他怕对方有天不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"连和他待着都不自在？\",\n          \"accent\": \"不自在\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他一下安静 不敢再往远处想\",\n          \"accent\": \"不敢再往远处想\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他想起对方一直没有退开\",\n          \"accent\": \"一直没有退开\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S09-3\"],\n          \"at\": 16\n        },\n        {\n          \"text\": \"也许对方喜欢他在身边？\",\n          \"accent\": \"喜欢他在身边\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"对视到呼吸停住，渴望仍绷着没说\",\n          \"after\": 2,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"像陷进低气压，阳光隔着一层薄雾\",\n          \"after\": 2,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"听着余响，刚才是真的吗？接下来呢？\",\n          \"after\": 2,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"夜空下美好比愿望更大，不安暂时退开\",\n          \"after\": 4,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 22\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇摆突然收住，颤音和轻和弦悬着\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–77\"\n        },\n        {\n          \"text\": \"声音一层层下沉，明亮渐被雾化\",\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"再猜下去今天也过不踏实\",\n          \"accent\": \"过不踏实\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他决定先享受眼前的亲近\",\n          \"accent\": \"享受眼前\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"先前的紧绷慢慢松开\",\n          \"accent\": \"慢慢松开\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"心里亮堂得想笑也想哭\",\n          \"accent\": \"想笑也想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"长长呼气，胸腔打开，眼泪不必再忍\",\n          \"after\": 2,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"水波像被清风拨开，时间短暂松了\",\n          \"after\": 1,\n          \"from\": [\"S10-B2\"],\n          \"bars\": 