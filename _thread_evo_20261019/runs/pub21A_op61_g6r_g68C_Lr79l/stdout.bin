      ],\n      \"lines\": [\n        {\n          \"text\": \"这回想起从前\",\n          \"point\": \"没急着拿受过的气压住想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没急着拿受过的气压住想念\"\n        },\n        {\n          \"text\": \"独自熬过难处后\",\n          \"point\": \"有人陪着有多轻松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"独自熬过难处后，他才懂\"\n        },\n        {\n          \"text\": \"他怕再也没有\",\n          \"point\": \"因曾拥有而暖了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却因曾拥有而暖了一点\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"把人从甜梦里生生拽回严寒\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"生生拽回严寒\"\n        },\n        {\n          \"quote\": \"身体和情绪却还没有完全相信一切已经结束\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"身体和心都还不信一切已经结束\"\n        },\n        {\n          \"quote\": \"恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他刚安心一点\",\n          \"point\": \"还得独自扛\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"刚安心一点，就想到\"\n        },\n        {\n          \"text\": \"他想找回那份\",\n          \"point\": \"离开的决心也松了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又怕回去还要受气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一眼里有温柔，也有不舍\",\n          \"carrier\": \"连接转折\",\n      