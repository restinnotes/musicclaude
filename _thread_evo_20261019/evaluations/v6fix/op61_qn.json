      "rel": "引用"
     },
     {
      "from": "S08-2",
      "to": "S09-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "216–225",
    "relation": "正在面对",
    "items": [
     {
      "id": "S10-1",
      "text": "他试着想象重新回到过去的生活，可再也没法只想着其中的好，而绕过原先的委屈。",
      "key": "他试着想象重新回",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S04-2",
       "S07-2"
      ]
     },
     {
      "id": "S10-2",
      "text": "现在的日子少了过去那种顺手就能依靠的关系，靠怀念也填不上这份空缺。",
      "key": "现在的日子少了过",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1",
       "S08-1"
      ]
     },
     {
      "id": "S10-3",
      "text": "他既不愿再忍让，也不知道往哪里才能重新得到那种亲近；想得久了，只剩疲惫。",
      "key": "他既不愿再忍让，",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-2",
       "S07-2",
       "S09-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S01-1",
      "to": "S10-1",
      "rel": "引用"
     },
     {
      "from": "S04-2",
      "to": "S10-1",
      "rel": "引用"
     },
     {
      "from": "S07-2",
      "to": "S10-1",
      "rel": "引用"
     },
     {
      "from": "S06-1",
      "to": "S10-2",
      "rel": "引用"
     },
     {
      "from": "S08-1",
      "to": "S10-2",
      "rel": "引用"
     },
     {
      "from": "S01-2",
      "to": "S10-3",
      "rel": "引用"
     },
     {
      "from": "S07-2",
      "to": "S10-3",
      "rel": "引用"
     },
     {
      "from": "S09-2",
