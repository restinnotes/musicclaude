: \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他不再猜以后\",\n          \"point\": \"享受眼前的亲近\",\n          \"where\": \"后\",\n          \"waste\": \"好好\",\n          \"keep\": \"不再猜以后\"\n        },\n        {\n          \"text\": \"紧绷松开\",\n          \"point\": \"想笑，也有点想哭\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"也有点想哭\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"fine\": [\n        {\n          \"quote\": \"这是我的感情，我不再为它道歉\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"胸口非但没有舒展开来，反而被压迫得发痛\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"没有舒展开，反而压得发痛\"\n        },\n        {\n          \"quote\": \"原来的温柔再次出现，却有了新的重量\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他承认自己需要对方\",\n          \"point\": \"不再藏喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"也愿意陪着\"\n        },\n        {\n          \"text\": \"他不再为在乎害臊\",\n          \"point\": \"怕对方未必一直需要自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却怕\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"fine\": [\n        {\n          \"quote\": \"倒不是“我的感情终于变得比一切都伟大”，反而像整个人被卷进一个比自己更大的世界\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是自己变伟大，是被更大世界卷入\"\n        },\n        {\n          \"quote\": \"旋律一次次向上伸展，仿佛还想要更多，却始终不能完全满足\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"快乐到连自己想笑还是