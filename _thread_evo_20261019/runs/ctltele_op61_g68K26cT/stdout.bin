{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"离开熟悉生活；初感无需再委屈自己\",\n          \"accent\": \"无需再委屈自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S01-1\"\n          ],\n          \"at\": 0\n        },\n        {\n          \"text\": \"笃定未久，心中空落；不知所舍为何\",\n          \"accent\": \"心中空落\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S01-2\"\n          ],\n          \"at\": 16\n        },\n        {\n          \"text\": \"偶忆从前，仍欲向前；安心所凭未明\",\n          \"accent\": \"安心所凭未明\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S01-3\"\n          ],\n          \"at\": 40\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"强令脊背挺直：不可倒下，实则欲停\",\n          \"after\": 0,\n          \"from\": [\n            \"S01-B2\"\n          ],\n          \"bars\": \"1–23\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"初醒般，四周冷空；胸口紧，伸手触空\",\n          \"after\": 1,\n          \"from\": [\n            \"S01-B3\",\n            \"S01-B4\"\n          ],\n          \"bars\": \"1–23\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"旧景骤清，往昔不返；身体先记迈步\",\n          \"after\": 2,\n          \"from\": [\n            \"S01-B5\"\n          ],\n          \"bars\": \"9–23\",\n          \"at\": 58\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"沉重和弦落下，自由琶音像烟雾散开\",\n          \"from\": [\n            \"S01-B1\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"1–6\"\n        },\n        {\n          \"text\": \"那一下也像召唤，停顿里仿佛等着回声\",\n          \"from\": [\n            \"S01-B1\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"1–6\"\n        },\n        {\n          \"text\": \"短句像叹息，被长停顿截断，余音散在冷空气里\",\n          \"from\": [\n            \"S01-B3\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"1–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"旧日自在，难以割舍\",\n          \"accent\": \"难以割舍\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S02-1\"\n          ],\n          \"at\": 0\n        },\n        {\n          \"text\": \"念及此后不复如常，心慌顿生\",\n          \"accent\": \"心慌顿生\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S02-1\"\n          ],\n          \"at\": 7\n        },\n        {\n          \"text\": \"不舍初起，便以受气旧事自警\",\n          \"accent\": \"受气旧事\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S02-2\"\n          ],\n          \"at\": 15\n        },\n        {\n          \"text\": \"仍有不甘：好日子亦须一并舍弃？\",\n          \"accent\": \"仍有不甘\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S02-3\"\n          ],\n          \"at\": 30\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"庄严舞步之中，远处似有私下哼唱旧歌\",\n          \"after\": 0,\n          \"from\": [\n            \"S02-B1\"\n          ],\n          \"bars\": \"24–65\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"抬头称‘无事’至第三遍；愈显在意，亦不甘就此消亡\",\n          \"after\": 3,\n          \"from\": [\n            \"S02-B4\",\n            \"S02-B5\"\n          ],\n          \"bars\": \"24–65\",\n          \"at\": 36\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"庄严步子虚浮，旋律脆弱，底下细碎不安\",\n          \"from\": [\n            \"S02-B2\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"音乐猛地上推又退下，连绵音流催急呼吸\",\n          \"from\": [\n            \"S02-B3\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"38–65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"心中郁气未消\",\n          \"accent\": \"郁气未消\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S03-1\"\n          ],\n          \"at\": 0\n        },\n        {\n          \"text\": \"忆及曾被视作自己人，欣喜片刻复生\",\n          \"accent\": \"曾被视作自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S03-1\"\n          ],\n          \"at\": 7\n        },\n        {\n          \"text\": \"喜意未退，酸意已起：离去之后，可会更好？\",\n          \"accent\": \"离去之后，可会更好\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S03-2\"\n          ],\n          \"at\": 17\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"故乡夏日：麦浪、微风；温柔至心颤\",\n          \"after\": 1,\n          \"from\": [\n            \"S03-B2\"\n          ],\n          \"bars\": \"66–91\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"如外出暂行，避开伤口；轻松确是真切\",\n          \"after\": 2,\n          \"from\": [\n            \"S03-B3\"\n          ],\n          \"bars\": \"66–91\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"昂扬渐歇，心问：方才当真信了？\",\n          \"after\": 2,\n          \"from\": [\n            \"S03-B5\"\n          ],\n          \"bars\": \"66–91\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"重击落下，忽强忽弱的起伏让心一悬\",\n          \"from\": [\n            \"S03-B1\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"前半急切，后半忽然柔和轻盈\",\n          \"from\": [\n            \"S03-B2\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"旋律像多人低声絮语，调子像流沙抓不住\",\n          \"from\": [\n            \"S03-B4\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"66–91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"旧日亲近浮现，仍盼相处如初\",\n          \"accent\": \"仍盼相处如初\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S04-1\"\n          ],\n          \"at\": 0\n        },\n        {\n          \"text\": \"亲近愈鲜明，昔日委屈愈上涌\",\n          \"accent\": \"委屈愈上涌\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S04-2\"\n          ],\n          \"at\": 7\n        },\n        {\n          \"text\": \"反复自问：此行正确否？若未离开，又将如何？\",\n          \"accent\": \"若未离开，又将如何\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S04-2\"\n          ],\n          \"at\": 15\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"记忆构成：感激、亲近、短暂幸福\",\n          \"after\": 0,\n          \"from\": [\n            \"S04-B1\"\n          ],\n          \"bars\": \"92–107\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"美好过甚，反成刺痛；往事不可复返\",\n          \"after\": 1,\n          \"from\": [\n            \"S04-B2\"\n          ],\n          \"bars\": \"92–115\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"时间催迫，身体不停；思绪循环打转\",\n          \"after\": 2,\n          \"from\": [\n            \"S04-B3\",\n            \"S04-B4\"\n          ],\n          \"bars\": \"92–115\",\n          \"at\": 22\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉舞步回来，旋律却更柔软抒情\",\n          \"from\": [\n            \"S04-B1\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"92–107\"\n        },\n        {\n          \"text\": \"温暖忽然转成风暴，声音一路下滑\",\n          \"from\": [\n            \"S04-B2\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"108–115\"\n        },\n        {\n          \"text\": \"低音追赶，右手像乱了阵脚\",\n          \"from\": [\n            \"S04-B3\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"92–115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"仍怀不服：当初诸般受气，不应忍受\",\n          \"accent\": \"不应忍受\",\n          \"emotion\": \"炽热\",\n          \"from\": [\n            \"S05-1\"\n          ],\n          \"at\": 0\n        },\n        {\n          \"text\": \"连旧日欢事亦不敢多念，自我为难太甚\",\n          \"accent\": \"不敢多念\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S05-1\"\n          ],\n          \"at\": 10\n        },\n        {\n          \"text\": \"自我争辩至力竭，不服渐淡；念及已离开他们，便觉难受\",\n          \"accent\": \"便觉难受\",\n          \"emotion\": \"孤单\",\n          \"from\": [\n            \"S05-2\"\n          ],\n          \"at\": 24\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"双手如夜影低语；心念未改：不可就此作罢\",\n          \"after\": 0,\n          \"from\": [\n            \"S05-B1\",\n            \"S05-B2\"\n          ],\n          \"bars\": \"116–127\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"旧人、故乡、旧生活再显温度；眷恋与失落并存\",\n          \"after\": 1,\n          \"from\": [\n            \"S05-B3\"\n          ],\n          \"bars\": \"116–147\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"数次深呼吸，稍有松动；抵抗已倦，内心未必平复\",\n          \"after\": 2,\n          \"from\": [\n            \"S05-B5\"\n          ],\n          \"bars\": \"132–147\",\n          \"at\": 38\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"柔和歌唱里仍有向前的压力\",\n          \"from\": [\n            \"S05-B2\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"116–127\"\n        },\n        {\n          \"text\": \"快速音流渐慢变稀，旋律几乎单独露出\",\n          \"from\": [\n            \"S05-B4\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"128–147\"\n        },\n        {\n          \"text\": \"末尾几次和弦像深深呼吸\",\n          \"from\": [\n            \"S05-B5\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"144–147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"难受渐缓；不再以旧怨压抑想念，亦无须解释、强撑\",\n          \"accent\": \"不再以旧怨压抑想念\",\n          \"emotion\": \"安心\",\n          \"from\": [\n            \"S06-1\",\n            \"S06-B2\"\n          ],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他们缺席之际，方知昔日有人相伴何其轻松\",\n          \"accent\": \"何其轻松\",\n          \"emotion\": \"孤单\",\n          \"from\": [\n            \"S06-2\"\n          ],\n          \"at\": 9\n        },\n        {\n          \"text\": \"仍盼重获亲近，又惧此后再无可能\",\n          \"accent\": \"再无可能\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S06-3\"\n          ],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"往昔日子确曾存在；忆之即暖\",\n          \"after\": 2,\n          \"from\": [\n            \"S06-4\"\n          ],\n          \"bars\": \"\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"透明罩般隔绝，亦如母亲轻哼摇篮曲；安宁难久\",\n          \"after\": 0,\n          \"from\": [\n            \"S06-B1\"\n          ],\n          \"bars\": \"148–180\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"似向远方祈愿；梦中家园亮起，只静观，不急于追回\",\n          \"after\": 1,\n          \"from\": [\n            \"S06-B2\",\n            \"S06-B4\"\n          ],\n          \"bars\": \"148–180\",\n          \"at\": 42\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声庄严绵长，随后逐渐展开\",\n          \"from\": [\n            \"S06-B2\",\n            \"S06-B3\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"旋律越唱越开，临近结尾像停在没说完的话上\",\n          \"from\": [\n            \"S06-B3\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"148–180\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"方得片刻安心，复惧往后难事唯有独自承担\",\n          \"accent\": \"独自承担\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S07-1\"\n          ],\n          \"at\": 0\n        },\n        {\n          \"text\": \"初衷只是避开受气，未料孤单至此\",\n          \"accent\": \"孤单至此\",\n          \"emotion\": \"孤单\",\n          \"from\": [\n            \"S07-2\"\n          ],\n          \"at\": 10\n        },\n        {\n          \"text\": \"欲寻回亲近，不愿再受气；决意渐淡\",\n          \"accent\": \"决意渐淡\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S07-3\"\n          ],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"后颈骤凉，脉搏急促；甜梦惊醒之感\",\n          \"after\": 0,\n          \"from\": [\n            \"S07-B1\"\n          ],\n          \"bars\": \"182\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"舞步骤然换场；熟悉动作反照失去\",\n          \"after\": 1,\n          \"from\": [\n            \"S07-B2\",\n            \"S07-B4\"\n          ],\n          \"bars\": \"181–205\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"思绪翻涌不止，欲冲出，却无出口\",\n          \"after\": 2,\n          \"from\": [\n            \"S07-B3\"\n          ],\n          \"bars\": \"198–205\",\n          \"at\": 28\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高音区忽然浮出轻细颤动，后来连续翻涌\",\n          \"from\": [\n            \"S07-B1\",\n            \"S07-B3\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"182、198–205\"\n        },\n        {\n          \"text\": \"舞蹈节奏闯入，和前段静谧形成反差\",\n          \"from\": [\n            \"S07-B2\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"旧舞曲气息再现，却不再完整鲜明\",\n          \"from\": [\n            \"S07-B5\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"182–197\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"暂不思归；忆起曾被视作自己人\",\n          \"accent\": \"曾被视作自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\n            \"S08-1\"\n          ],\n          \"at\": 0\n        },\n        {\n          \"text\": \"暖意消退，回忆无力陪其承担难处\",\n          \"accent\": \"无力陪其承担难处\",\n          \"emotion\": \"孤单\",\n          \"from\": [\n            \"S08-2\"\n          ],\n          \"at\": 8\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"柔软处短暂敞开；临行回望般，胸口终得喘息\",\n          \"after\": 0,\n          \"from\": [\n            \"S08-B1\",\n            \"S08-B2\",\n            \"S08-B3\"\n          ],\n          \"bars\": \"206–213\",\n          \"at\": 4\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"缓慢宽广的歌唱短暂回来\",\n          \"from\": [\n            \"S08-B1\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"206–213\"\n        },\n        {\n          \"text\": \"安静刚被认出，就又退去了\",\n          \"from\": [\n            \"S08-B2\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"206–213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"难以分辨：欲归，究竟因不舍亲近\",\n          \"accent\": \"不舍亲近\",\n          \"emotion\": \"悬着\",\n          \"from\": [\n            \"S09-1\"\n          ],\n          \"at\": 0\n        },\n        {\n          \"text\": \"抑或惧怕孤单，宁愿再受旧气；心慌，不敢细想\",\n          \"accent\": \"心慌，不敢细想\",\n          \"emotion\": \"不安\",\n          \"from\": [\n            \"S09-1\",\n            \"S09-2\"\n          ],\n          \"at\": 7\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"仿佛自另一侧望见同一扇门；步履未启\",\n          \"after\": 0,\n          \"from\": [\n            \"S09-B1\"\n          ],\n          \"bars\": \"214–215\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"再逢茫然的自己；已知其所历\",\n          \"after\": 1,\n          \"from\": [\n            \"S09-B2\"\n          ],\n          \"bars\": \"214–215\",\n          \"at\": 15\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"巨大的颤动光晕里，开头沉重和弦阴冷闪回\",\n          \"from\": [\n            \"S09-B1\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"214–215\"\n        },\n        {\n          \"text\": \"声音短暂落稳，随即又向高处漂去\",\n          \"from\": [\n            \"S09-B1\"\n          ],\n          \"pt\": \"\",\n          \"bars\": \"2