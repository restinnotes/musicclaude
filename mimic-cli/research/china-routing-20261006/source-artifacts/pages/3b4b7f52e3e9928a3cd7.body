    left: 50%;
    }
    }
    .floating-image {
    /* Attach the animation to the element
    animation: float 3s ease-in-out infinite;
    }*/
    @keyframes float {
    0%, 100% {
    transform: translateY(0); /* Starting and ending position */
    }
    50% {
    transform: translateY(-20px); /* Move 20px up at the halfway point */
    }
    }
</style>
</div></div>
					</div>

         </div>
      </main>
