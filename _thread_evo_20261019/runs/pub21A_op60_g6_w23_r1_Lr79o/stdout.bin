    \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"在他心里\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"左手的波浪变薄、碎成细密的小纹\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"再亲密也陪不到心底\"\n        },\n        {\n          \"quote\": \"气味、身体感觉、幻想、遗憾、快感混在一起\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"这回对方看出他有多在乎\",\n          \"point\": \"跟他相处却一点没变\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"他才又能像从前那样自在地待着\"\n        },\n        {\n          \"text\": \"安静下来以后，他想到对方根本不知道\",\n          \"point\": \"对方根本不知道他刚才有多怕被嫌弃\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"忽然觉得有点孤单\"\n        },\n        {\n          \"text\": \"他又忍不住想\",\n          \"point\": \"舍不得结束这份亲近\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"既然一直没有退开\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"原先压着的感受反而变成了动力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"压着的感受变成动力\"\n        },\n        {\n          \"quote\": \"你明知道自己正在被卷进去，却暂时不想出来\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"明知正被卷进去\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起这些日子对方总愿意跟他待在一起\",\n          \"point\": \"对方有时也需要他陪着\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"也许对方有时也需要他陪着，跟他在一起也能安心些\"\n        },\n        {\n          \"text\": \"这个念头让他高兴得有点收不住\",\n          \"point\": \"越舍不得从这份欢喜里抽身\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"越想着两个人这样亲近\"\n        },\n        {\n          \"text\": \"他真盼着\",\n          \"point\": \"自己也能一直陪在身边\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方想找人陪时还会想到自己\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"歌句越唱越开，情绪一再抬高，连熟悉的摇荡也仿佛在轻轻催促\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"歌句越唱越开\"\n        },\n        {\n          \"quote\": \"歌声没有踏踏实实地落定，反而向上散掉、蒸发了\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"向上散掉、蒸发了\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"上回他无意间露了心意\",\n          \"point\": \"大大方方地回应\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"上回他无意间露了心意，这回见对方依然亲近\"\n        },\n        {\n          \"text\": \"这样想着，他连往后的日子都开始盼了\",\n          \"point\": \"还能这么好很久\",\n          \"where\": \"后\",\n          \"waste\": \"这样想着\",\n          \"keep\": \"说不定还能这么好很久\"\n        },\n        {\n          \"text\": \"可他又想到\",\n          \"point\": \"今天这样好不代表以后每天都能这样\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"可他又想到\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"四周并未彻底暗下去，更像阳光被薄雾柔化——光还在，只是隔了一层朦胧的雾气\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"光还在，只隔了一层雾\"\n        },\n        {\n          \"quote\": \"心里的不安还没有得到回答，却暂时不再占据全部心思\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不安还没得到回答\"\n    