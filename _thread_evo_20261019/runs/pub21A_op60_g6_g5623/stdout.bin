{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"落下来以后，却还没有真正落稳，仿佛仍悬在水面上方\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这里是刚刚踏上船板的感觉，还不是整个人已经安稳地交给规律起伏的水浪。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变，所以格外谨慎。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越清楚后果，越谨慎\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现，自己竟那么想靠近这个人\",\n          \"point\": \"那么想靠近这个人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"自己竟\"\n        },\n        {\n          \"text\": \"他怕对方看出自己有多需要这份亲近\",\n          \"point\": \"觉得负担太重\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"有多需要这份亲近\"\n        },\n        {\n          \"text\": \"所以他只敢露出一点喜欢\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只敢\"\n        },\n        {\n          \"text\": \"这么一点亲近就已经让他觉得甜\",\n          \"point\": \"拿不准下次能否更坦白\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这么一点亲近就已经让他觉得甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"那层暖意裹在皮肤上有些黏稠。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"可以放弃对重力的控制，把身体交给船底温柔的托举。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"温柔地托举\"\n        },\n        {\n          \"quote\": \"