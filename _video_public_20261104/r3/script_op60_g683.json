        "不被需要",
        "藏回一点"
       ],
       "from": [
        "S13-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这样以后或许能少疼些，可他已经没法装作不在乎。",
