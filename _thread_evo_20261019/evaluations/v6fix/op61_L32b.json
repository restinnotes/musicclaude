      "to": "S06-1",
      "rel": "引用"
     },
     {
      "from": "S05-3",
      "to": "S06-1",
      "rel": "引用"
     },
     {
      "from": "S06-1",
      "to": "S06-2",
      "rel": "引用"
     },
     {
      "from": "S03-1",
      "to": "S06-2",
      "rel": "引用"
     },
     {
      "from": "S04-2",
      "to": "S06-3",
      "rel": "引用"
     },
     {
      "from": "S06-2",
      "to": "S06-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S07",
    "bars": "181–205",
    "relation": "正在面对",
    "items": [
     {
      "id": "S07-1",
      "text": "刚才的安静忽然被一阵惊惧打断，身体先绷紧了，心里的念头也跟着翻来覆去，却没有一个清楚的出口。",
      "key": "刚才的安静忽然被",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1",
       "S06-2"
      ]
     },
     {
      "id": "S07-2",
      "text": "他还是继续把眼前的分寸守着，熟悉的自持只回来一点；过去的亲近感也忽然掠过，让他既觉得熟悉，又更清楚它离眼前有段距离。",
      "key": "他还是继续把眼前",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S02-1",
       "S06-3"
      ]
     }
    ],
    "because": [
