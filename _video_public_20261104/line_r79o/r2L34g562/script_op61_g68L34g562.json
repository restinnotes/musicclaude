       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "但他没有因此撤回对自己的要求",
       "keys": [
        "没有因此撤回对自己的要求"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚才的思绪一下被打断，换了副热闹步子心里却安定不下来",
