 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近这个人，连自己也有点意外。",
       "keys": [
        "想靠近这个人",
        "有点意外"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "烟花般迸发，光点落下仍悬在水面上",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "刚踏上船板，脚下微晃，身体一瞬失重",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "怕让对方觉得负担太重，他只敢露出一点点喜欢。",
       "keys": [
        "负担太重",
        "一点点喜欢"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有退开，仍愿意亲近，他才渐渐放松下来。",
       "keys": [
        "没有退开",
        "渐渐放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体不必踩实，交给船底温柔托举",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "肩膀挨着肩膀，连呼吸都贴在一起",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想靠近些，喜欢得几乎藏不住，最后怕弄坏眼下的自在而收住。",
       "keys": [
        "喜欢得几乎藏不住",
        "眼下的自在"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声忽然往上涌，感情也热切了一瞬",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "像轻轻呼出一口气，重新回到柔和",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "两个人待在一起这么好，他还没分开就先有些舍不得。",
       "keys": [
        "待在一起这么好",
        "先有些舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "眼前明明很好，心里却已经有点鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
