       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "心里的热意一度变得更开放，随后又柔和地收回来",
       "keys": [
        "柔和地收回来"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
