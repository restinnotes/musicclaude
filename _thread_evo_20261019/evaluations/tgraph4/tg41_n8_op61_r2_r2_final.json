   },
   "relation_model": "正在面对"
  },
  {
   "bars": "242–253",
   "relation": "正在面对",
   "items": [
    {
     "id": "I57",
     "text": "不再等毫无损失的办法后，他重又感到昂扬，这一次无需否认自己的脆弱。",
     "key": "带着脆弱重新昂扬",
     "kind": "",
     "key_model": "无需否认"
    },
    {
     "id": "I58",
     "text": "他仍愿尽力，却不再急着借坚定证明自己有能力改变事情，也不要求自己无所不能。",
     "key": "尽力却不求无所不能",
     "kind": "",
     "key_model": "无所不能"
    },
    {
     "id": "I59",
     "text": "他肯让怕失去的和想爱惜的留在心里，不再为了显得勇敢而将它们藏起来。",
     "key": "不再藏起依恋与珍惜",
     "kind": "",
     "key_model": "藏起来"
    },
    {
     "id": "I60",
     "text": "他开始愿意为真心爱惜的一切负责，牵挂也不再使他觉得行动受了拖累。",
     "key": "愿为珍爱之物负责",
     "kind": "",
     "key_model": "真心爱惜"
    },
    {
     "id": "I61",
     "text": "这份决心仍热烈，却比最初踏实，他不再等疑虑消失才准许自己坚定。",
     "key": "不等疑虑消失再坚定",
     "kind": "",
     "key_model": "疑虑消失"
    }
   ],
   "because": [
    {
     "from": "I56",
     "to": "I57",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I23",
     "to": "I57",
     "rel": "改写",
     "audit": "支持"
    },
    {
     "from": "I45",
     "to": "I59",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I52",
     "to": "I60",
     "rel": "提供理由",
     "audit": "支持"
    },
    {
     "from": "I56",
     "to": "I61",
     "rel": "提供理由",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "254–288",
   "relation": "正在面对",
   "items": [
    {
     "id": "I62",
     "text": "重新决定向前时，他意外发现，那份曾使他想退回去的旧愿，似乎比从前更亲近。",
     "key": "旧愿反而更加亲近",
     "kind": "",
     "key_model": "更亲近"
    },
    {
     "id": "I63",
     "text": "如今他因珍惜那份生活，反而更不肯放任使它难以实现的事情继续存在。",
     "key": "珍惜生活不再放任威胁",
     "kind": "",
     "key_model": "不肯放任"
    },
    {
     "id": "I64",
     "text": "他第一次真切觉得，自己珍惜温柔的心也能成为行动的理由，令他不肯袖手旁观。",
     "key": "温柔也成为行动理由",
     "kind": "",
     "key_model": "行动的理由"
    },
    {
     "id": "I65",
     "text": "他想要的仍是无需拼命便能好好生活的日子，却愿意承认爱惜它有时就得离开安宁。",
     "key": "爱惜旧愿也须离开安宁",
     "kind": "",
     "key_model": "离开安宁"
    },
    {
     "id": "I66",
     "text": "他不敢认定多付出就能更接近旧愿，也不因愿望美好便觉得一切付出都值得。",
     "key": "不认定付出必然值得",
     "kind": "办法的限度",
     "key_model": "一切付出都值得"
    },
    {
     "id": "I67",
     "text": "他仍会留意自己是否在争取中失去想保护的东西，这些担心如今也提醒他如何坚持。",
     "key": "担心提醒他如何坚持",
     "kind": "",
     "key_model": "提醒他如何坚持"
    },
    {
     "id": "I68",
     "text": "两股心意这时竟能一同支持他，他因而欢喜，不再为依恋羞愧，也不厌倦该尽的责任。",
     "key": "两份心意一同支持行动",
     "kind": "",
     "key_model": "一同支持"
    },
    {
     "id": "I69",
     "text": "他重新尝到全心投入的畅快，但经过怀疑和疲惫，已不再把这份快乐视为理所当然。",
     "key": "不再视畅快为理所当然",
     "kind": "",
     "key_model": "全心投入的畅快"
    },
    {
     "id": "I70",
     "text": "喜悦渐渐平静后，他仍不知道努力究竟能改变多少，那种无需防备的生活也未到来。",
     "key": "努力能改变多少仍未知",
     "kind": "",
     "key_model": "能改变多少"
    },
    {
     "id": "I71",
     "text": "他清楚以后还可能疲惫、因代价而动摇，两份愿望也可能再次相互牵制。",
     "key": "知道两份愿望仍会牵制",
     "kind": "",
     "key_model": "再次相互牵制"
    },
    {
     "id": "I72",
     "text": "他不再拿一种满足盖住另一种需要，也不因心里还有缺口就否认自己确实得到的东西。",
     "key": "不以满足掩盖另一需要",
     "kind": "",
     "key_model": "确实得到的东西"
    },
    {
     "id": "I73",
     "text": "他仍向往那种生活，也仍愿行动，虽不知能留下多少珍贵的东西，却肯带着不舍向前。",
     "key": "带着不舍继续向前",
     "kind": "",
     "key_model": "带着不舍向前"
    },
    {
     "id": "I74",
     "text": "这一次，他不再需要为自己的愿意寻找更多证明。",
     "key": "不再为愿意寻找证明",
     "kind": "",
     "key_model": "更多证明"
    }
   ],
