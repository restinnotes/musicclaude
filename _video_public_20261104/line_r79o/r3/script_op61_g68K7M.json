   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "明知道回去未必找得回那份亲近，他还是忍不住想：万一能呢？可他不愿只凭这点指望，再去过从前那种忍让的日子。",
       "keys": [
        "万一能呢",
