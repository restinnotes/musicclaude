 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开了熟悉的生活，起初还觉得总算不用再一次次委屈自己了。",
       "keys": [
        "离开了",
        "不用再一次次委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像提醒自己别倒下，可其实很想停下来。",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "沉重的一下过去，声音却像烟往高处散，越飘越远。",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里就空了，连自己到底舍不得什么都说不清。",
       "keys": [
        "心里就空了",
        "舍不得什么"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "叹息才出口就静了，余音慢慢散尽。",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "四周冷，胸口紧，伸手摸去却是空的。",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "想起从前那些熟悉的日子，他还是想往前过，却不知道以后靠什么安下心。",
       "keys": [
        "想往前过",
        "安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧时的声音和光亮又回来了，可过去回不来。",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "脚像记起了该怎么迈步，可还没真正站稳。",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他舍不得从前那些自在的日子，一想到以后不能再那样过，心里就发慌。",
       "keys": [
        "舍不得",
        "不能再那样过"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像远处传来旧歌，只记得几句，唱不全。",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "脚步听着很端正，腿脚却像没多少力气。",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "一觉得舍不得，他就赶紧想起当初受过的气，怕心一软，连自己为什么走都忘了。",
       "keys": [
        "想起当初受过的气",
        "为什么走"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像整理好衣服、抬起头，不想让人看见自己在动摇。",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "反复说“我没事”，头一遍还信，越说越像硬撑。",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "可他还是不甘心：难道为了不再受那些气，就一定得把从前的好日子也丢掉吗？",
       "keys": [
        "不甘心",
        "好日子也丢掉"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音刚往上冲，又退下来，好像总差一口气。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "呼吸越来越急，到最后还是落不稳。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他心里那股气还憋着，一时也平静不下来。",
       "keys": [
        "那股气还憋着",
        "平静不下来"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "如果开头那下弹得很重，像突然挨了一锤。",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "前半段急得像坐不住，心里一直绷着。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "可一想起从前有人把他当自己人，他竟又高兴了一小会儿。",
       "keys": [
        "当自己人",
        "高兴了一小会儿"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "忽然像夏天的麦浪被风吹动，轻轻柔柔的。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那点高兴还没退，他就心酸了：从前的日子回不去，离开以后就一定会更好吗？",
       "keys": [
        "心酸了",
        "一定会更好吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "越想那时不必防备，越觉得离现在好远。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "刚才是真的相信了，还是在逼自己相信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      },
      {
       "text": "像几个人小声说着话，绕来绕去找不到出口。",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想起那些亲近的时候，真有一阵盼着一切还能像从前那样继续。",
       "keys": [
        "盼着",
        "像从前那样继续"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的调子回来，像在轻声说心里话，旧时的感觉也鲜活起来。",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "外面像还在照常迈步，心里却变得更容易难受了。",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可越是这么盼着，他越怀疑当初是不是走错了，却怎么也想不出如果没走会怎样。",
       "keys": [
        "怀疑当初是不是走错了",
        "想不出"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子里不停冒出“如果当时……”，想停都停不下来。",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "心跳像乱了拍，脚步越赶越急，好像不敢停。",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "回忆明明那么好，想起来却刺痛，越用力越不稳。",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他仍不服气，觉得当初那些委屈就不该忍。",
       "keys": [
        "不服气",
        "不该忍"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像压低声音说：这件事不能就这么算了。",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "可连从前开心的事都不敢多想，他又觉得这样太为难自己了。",
       "keys": [
        "开心的事",
        "太为难自己了"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夜里两个影子，靠得很近，在低声说着话。",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他跟自己争到没了力气，那股不服气才慢慢淡下去，一想到已经不在那些人身边，就只剩难受。",
       "keys": [
        "没了力气",
        "只剩难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音渐渐稀了，像脚下忽然没了地板，只剩一个声音。",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "像长长呼出一口气，不是想通了，只是争累了。",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "难受慢慢缓下来，他又想起从前有人在身边、不必防备的日子，这回没再急着拿受过的气压住想念。",
       "keys": [
        "难受慢慢缓下来",
        "没再急着"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像突然和外面的世界隔了一层玻璃，连呼吸都不敢太重。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "像有人在耳边轻轻哼着摇篮曲，终于能松开一点戒备。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "离开后遇上难事，他常常只能自己扛，这才知道从前有人在身边能让自己轻松多少。",
       "keys": [
        "只能自己扛",
        "有人在身边"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像终于不用解释为什么难过，也不用装作自己一直很坚强。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "远处像忽然亮了起来，那个回不去的地方在梦里又看见了。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他真想再过那种不用多说就彼此亲近的日子，可又怕以后再也没有了。",
       "keys": [
        "真想再过",
        "怕以后再也没有了"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "那份歌唱越往后越急，像还有话没说完。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "不过，那样的日子他毕竟真过过，光这么想着，心里也暖和了一点。",
       "keys": [
        "真过过",
        "暖和了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像好好看着一件珍惜的东西，不急着马上把它抓回来。",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，他就猛然想到：以后遇上难事要是还只能一个人顶着，自己真的撑得住吗？",
       "keys": [
        "猛然想到",
        "撑得住吗"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像寒风猛地吹开窗，后颈一凉，心跳也快起来。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "舞步突然闯进来，刚才那阵安静像被一下截断了。",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他这才发现，当初只想着别再受那些气，却没料到会这么孤单，忍不住问自己早知道还会走吗？",
       "keys": [
        "没料到会这么孤单",
        "还会走吗"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像一个熟悉的动作突然冒出来，明明亲切，反而更难过。",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想找回以前的亲近，又不愿回去受那些气，偏偏连当初离开的决心也找不着了。",
       "keys": [
        "想找回以前的亲近",
        "决心也找不着了"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里的紧张一层层叠上来，想停都停不了。",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      },
      {
       "text": "就像总有什么想冲出去，却怎么也找不到出口。",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他先把回不回去的事放到一边，想起从前那些亲近的时候，心里又暖和了一会儿。",
       "keys": [
        "放到一边",
        "暖和了一会儿"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "先前那种轻柔的歌声又回来，像心里柔软的地方重新打开。",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "胸口像终于能吸进一口气。",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可暖意退得太快，他想到以后遇上难事，回忆也不能陪着自己，心又悬了起来。",
       "keys": [
        "回忆也不能陪着自己",
        "心又悬了起来"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像临走时忍不住回头看一眼，还没看够就得离开。",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他忽然说不清自己想回去，到底是舍不得以前的生活，还是只想难受的时候有人陪着。",
       "keys": [
        "说不清",
        "难受的时候有人陪着"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "沉重的声音又回来了，刚站稳一点，又向高处飘走。",
       "keys": [],
       "from": [
        "S09-B1"
       ],
