   "items_before_trim": [
    {
     "id": "I87",
     "text": "带着全部牵挂重新向前时，他有些意外，旧日的愿望并未因此远去，反而似乎更亲近。",
     "key": "带着牵挂旧愿反而更近",
     "kind": "",
     "key_model": "旧愿反而更亲近"
    },
    {
     "id": "I88",
     "text": "过去想到这种生活，他常想从艰难争取中撤回，仿佛这样才能完整保住它。",
     "key": "曾想退出争取保全旧愿",
     "kind": "",
     "key_model": "曾想撤回以保旧愿"
    },
    {
     "id": "I89",
     "text": "如今正因知道它多么可贵，他更不愿任由使它难以实现的事情继续存在。",
     "key": "珍惜旧愿不再任由阻碍",
     "kind": "",
     "follows": true,
     "key_model": "不愿放任旧愿受阻"
    },
    {
     "id": "I90",
     "text": "他感到，对那种生活的向往让他不肯袖手旁观，若在争取中丢掉它，尽力也会失去意义。",
     "key": "向往使他不肯袖手旁观",
     "kind": "",
     "follows": true,
     "key_model": "向往成为行动理由"
    },
    {
     "id": "I91",
     "text": "他仍想过无需拼命也能好好生活的日子，却承认珍惜它有时要求自己离开安宁去行动。",
     "key": "珍惜安宁仍须起身行动",
     "kind": "",
     "follows": true,
     "key_model": "珍惜安宁有时须行动"
    },
    {
     "id": "I92",
     "text": "他不把更多投入当作接近旧梦的保证，也不把美好愿望当作所有付出的理由。",
     "key": "不把投入当作旧梦保证",
     "kind": "办法的限度",
     "follows": true,
     "key_model": "投入不保证靠近旧梦"
    },
    {
     "id": "I93",
     "text": "他仍须留心自己会不会在争取中失去所爱，而这些顾虑也提醒他该以怎样的心坚持。",
     "key": "顾虑提醒他如何坚持",
     "kind": "",
     "follows": true,
     "key_model": "顾虑提醒怎样坚持"
    },
    {
     "id": "I94",
     "text": "重新理解希望后，他感到更宽广的喜悦，两股曾拉扯他的心意开始共同支持他。",
     "key": "两种心意开始共同支撑",
     "kind": "",
     "follows": true,
     "key_model": "两股心意共同支持"
    },
    {
     "id": "I95",
     "text": "他不必为依恋感到羞耻，也不必因责任而厌倦珍惜。",
     "key": "不羞于依恋不厌倦珍惜",
     "kind": "",
     "follows": true,
     "key_model": "不再羞于依恋"
    },
    {
     "id": "I96",
     "text": "他重新尝到最初相信生活时的快乐，可历经怀疑与疲惫后，这份快乐已不再理所当然。",
     "key": "历经疲惫重尝生活之乐",
     "kind": "",
     "follows": true,
     "key_model": "快乐不再理所当然"
    },
    {
     "id": "I97",
     "text": "喜悦平静后，他仍知道许多事没有答案，无法保证承担能改变什么，也没回到无须防备的生活。",
     "key": "仍无答案难保行动有用",
     "kind": "",
     "follows": true,
     "key_model": "承担未必改变现实"
    },
    {
     "id": "I98",
     "text": "往后他仍可能疲惫，也可能因代价动摇，即使带着两种渴望同行，它们仍可能相互牵制。",
     "key": "两种渴望仍会相互牵制",
     "kind": "",
     "follows": true,
     "key_model": "两种渴望仍会牵制"
    },
    {
     "id": "I99",
     "text": "他不再用一种满足遮盖另一种需要，也不因某种需要未满足就否定已有的收获。",
     "key": "不以满足遮盖其他需要",
     "kind": "",
     "follows": true,
     "key_model": "不以满足遮盖需要"
    },
    {
     "id": "I100",
     "text": "他由这些经历看清，哪些东西值得付出，哪些不能在付出中轻易牺牲。",
     "key": "看清付出与不可牺牲",
     "kind": "",
     "follows": true,
     "key_model": "经历提醒他不可牺牲"
    },
    {
     "id": "I101",
     "text": "他仍向往安宁，也仍愿意行动，却不知道最终能留下多少珍贵的东西。",
     "key": "仍愿行动不知能留多少",
     "kind": "",
     "key_model": "仍向往安宁也愿行动"
    },
    {
     "id": "I102",
     "text": "他不愿靠遗忘任何一边求得安稳，可以带着不舍继续向前，不再为自己的愿意寻找更多证明。",
     "key": "不忘两边带着不舍前行",
     "kind": "",
     "follows": true,
     "key_model": "不忘任何一边向前"
    }
   ]
  }
