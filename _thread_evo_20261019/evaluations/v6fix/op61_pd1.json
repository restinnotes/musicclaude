      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S11",
    "bars": "226–241",
    "relation": "正在面对",
    "items": [
     {
      "id": "S11-1",
      "text": "可这样想过以后，他还是怕这一切终究只是自己的一厢情愿。",
      "key": "可这样想过以后，",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-3"
      ]
     },
     {
      "id": "S11-2",
      "text": "这个不确定仍让他不安，甚至有时又觉得难堪。",
      "key": "这个不确定仍让他",
      "follows": true,
      "explains": [],
      "cite": []
     },
     {
      "id": "S11-3",
      "text": "不过这次他没有因为难堪就认定自己不该想靠近。",
      "key": "不过这次他没有因",
      "follows": true,
      "explains": [],
      "cite": [
       "S03-2",
       "S10-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S10-3",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S03-2",
      "to": "S11-3",
      "rel": "引用"
     },
     {
      "from": "S10-2",
      "to": "S11-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "242–253",
    "relation": "没在想",
    "items": [
     {
      "id": "S12-1",
      "text": "他安静地想念过去那种不必小心证明自己的生活。",
      "key": "他安静地想念过去",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S12-2",
      "text": "现在的距离一旦浮上心头，那份温暖又叫他觉得寂寞。",
      "key": "现在的距离一旦浮",
      "follows": true,
      "explains": [],
      "cite": []
     }
    ],
    "because": []
   },
   {
    "sec": "S13",
    "bars": "254–288",
    "relation": "正在面对",
    "items": [
     {
      "id": "S13-1",
      "text": "他依然愿意盼着与他们平等亲近，而不打算为此讨好谁。",
      "key": "他依然愿意盼着与",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-3",
       "S11-3"
      ]
     },
     {
      "id": "S13-2",
      "text": "如今的他们是否还愿意接纳他，他仍不知道。",
      "key": "如今的他们是否还",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-2"
      ]
     },
     {
      "id": "S13-3",
      "text": "他也还没有决定，自己会不会真的尝试靠近。",
      "key": "他也还没有决定，",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S13-4",
      "text": "他就带着这份没有着落的期待，守着眼下的距离。",
      "key": "他就带着这份没有",
      "follows": true,
      "explains": [],
      "cite": []
     }
    ],
