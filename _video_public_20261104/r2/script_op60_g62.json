       ],
       "bead": "S13-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想把露出的喜欢藏回去，好让以后少疼些；可早已装不回不在乎。",
