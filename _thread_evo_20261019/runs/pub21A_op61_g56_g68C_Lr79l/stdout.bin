{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"像烟雾往高处散\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"伸出颤抖的手去摸，摸到的却只有虚空\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"身体先于意识，隐约记起了该如何迈步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"意识还没跟上\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开熟悉的生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"总算\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"想往前走又不知如何安顿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可心里很快空了\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"节奏本身庄严、傲慢，旋律却脆弱凄婉\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"旋律却脆弱\"\n        },\n        {\n          \"quote\": \"第一次还有几分相信，第二次开始努力让自己相信\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到以后再没有\",\n          \"point\": \"以后再没有那样的日子\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"以后再没有\"\n        },\n        {\n          \"text\": \"他提醒自己受过的气\",\n          \"point\": \"怕一心软就忘了当初为什么离开\