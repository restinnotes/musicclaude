<script src="https://img.dsers.com/cdn/js/jquery-3.5.1.min.js" crossorigin></script>
<script src="/blog/assets/built/tag-sort-order.js?v=dc29813cc6"></script>
<script>
    $(async function() {
            const api = new GhostContentAPI({
        url: window.location.href.match('help.dsers.com') ? 'https://help.dsers.com' : 'https://help-dev.dsers.com',
        key: window.location.href.match('help.dsers.com') ? 'aba8f27e3ca137ee6541fd9a7c' : '193ea68ee8e27bfc6cdf440768',
        version: 'v3.0'
    })
          const postTagSlugs = window.POST_TAG_SLUGS || [];
          const topTags = (typeof getTopTagsForPostTags === 'function')
              ? getTopTagsForPostTags(postTagSlugs)
              : TOP_TAGS;
        // 取出原始标签
        let tagText = $("#page_tag").text().trim();
        if (!tagText) return;
        let arr = tagText.split(',');
        $("#page_tag").empty();

            // 1. 先请求所有标签
    let allTags = [];
    try {
        const res = await api.tags.browse({ limit: 'all' });
        allTags = res;
    } catch (err) {
        console.error('请求标签失败', err);
        return;
    }

    // 2. 构建树形菜单
    function buildTree(parentSlug) {
        const descendants = allTags.filter(item =>
            item.slug.startsWith(parentSlug + '-') && item.slug !== parentSlug
        );
        const children = descendants.filter(potentialChild => {
            return !descendants.some(other =>
                potentialChild.slug.startsWith(other.slug + '-') &&
                potentialChild.slug !== other.slug
            );
        });
        return children.map(item => ({
            name: item.name.includes('/') ? item.name.split('/').pop() : item.name,
            slug: item.slug,
            des: item.description,
            feature_image: item.feature_image,
            children: buildTree(item.slug)
        }));
    }

    // 生成完整树结构
    const tagTree = topTags.map(slug => {
        const topTag = allTags.find(t => t.slug === slug);
        if (!topTag) return null;
        return {
            name: topTag.name,
            slug: topTag.slug,
            des: topTag.description,
            feature_image: topTag.feature_image,
            children: buildTree(slug)
        };
    }).filter(Boolean);

    console.log('✅ 树形菜单生成完成', tagTree, arr);

    let mainTag = null;   // 一级：从 tagTree 根匹配到
    let secondTag = null;// 二级：从 一级的 children 匹配到

    // 1. 遍历 arr，先找 一级分类（tagTree 根节点的 name）
    for (const tagName of arr) {
        const found = tagTree.find(item => 
            item.name.trim() === tagName.trim()
        );
        if (found) {
            mainTag = found;
            break;
        }
    }

    // 2. 找到一级后，在它的 children 里找 二级分类
    if (mainTag) {
        for (const tagName of arr) {
            const found = mainTag.children.find(child => 
                child.name.trim() === tagName.trim()
            );
            if (found) {
                secondTag = found;
                break;
            }
        }
    }

    console.log(mainTag, 'mainTag')
    console.log(secondTag, 'secondTag')

// 情况1：一级 + 二级都存在
if (mainTag && secondTag) {
  var isAiSection = (typeof AI_TOP_TAGS !== 'undefined' && AI_TOP_TAGS.indexOf(mainTag.slug) !== -1);
  var sectionLabel = isAiSection ? 'AI Agent Mode' : 'SaaS Mode';
  var sectionHtml = `<span class="article-breadcrumb-section">${sectionLabel}</span>`;
  var mainDisplayName = (mainTag.slug === 'troubleshooting' || /^(faqs?|troubleshooting)$/i.test(mainTag.name)) ? 'Trouble Shooting' : mainTag.name;
  var parentPath = (typeof getMainTagPagePath === 'function') ? getMainTagPagePath(mainTag.slug) : (isAiSection ? '/aimode/' : '/maintag/');
  var mainTagLink = `<a class="article-breadcrumb-link" href="${parentPath}?main=${mainTag.slug}">${mainDisplayName}</a>`;
  var separator = '<span class="article-breadcrumb-sep">›</span>';
  var secondTagLink = `<a class="article-breadcrumb-link tag_names2" href="/articles/?main=${secondTag.slug}">${secondTag.name}</a>`;

  $("#page_tag").append(sectionHtml).append(separator).append(mainTagLink).append(separator).append(secondTagLink);
} 
// 情况2：只有一级，没有二级
else if (mainTag) {
  var isAiSectionOnly = (typeof AI_TOP_TAGS !== 'undefined' && AI_TOP_TAGS.indexOf(mainTag.slug) !== -1);
  var sectionLabelOnly = isAiSectionOnly ? 'AI Agent Mode' : 'SaaS Mode';
  var sectionHtmlOnly = `<span class="article-breadcrumb-section">${sectionLabelOnly}</span>`;
  var mainDisplayNameOnly = (mainTag.slug === 'troubleshooting' || /^(faqs?|troubleshooting)$/i.test(mainTag.name)) ? 'Trouble Shooting' : mainTag.name;
  var parentPathOnly = (typeof getMainTagPagePath === 'function') ? getMainTagPagePath(mainTag.slug) : (isAiSectionOnly ? '/aimode/' : '/maintag/');
  var mainTagLinkOnly = `<a class="article-breadcrumb-link" href="${parentPathOnly}?main=${mainTag.slug}">${mainDisplayNameOnly}</a>`;
  var separatorOnly = '<span class="article-breadcrumb-sep">›</span>';
  $("#page_tag").append(sectionHtmlOnly).append(separatorOnly).append(mainTagLinkOnly);
}


        // 点击二级标签存储 localStorage
        $(document).on('click', '.tag_names2', function() {
            let tag = arr[0];
            let maintag = tag.split('/')[0];
            let secondTag = tag.split('/')[1];
            localStorage.setItem('new-main-tag', maintag);
            localStorage.setItem('new-second-tag', secondTag);
        });
    });
</script>

