       "from": [
        "S10-2",
        "S10-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "问题又递回来：我究竟要怎样继续生活",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      },
      {
       "text": "往事明明重要，他却已经累得没力气把它重新讲一遍",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    }
   ]
  },
  {
