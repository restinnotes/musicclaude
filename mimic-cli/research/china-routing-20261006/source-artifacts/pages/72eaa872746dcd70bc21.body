wser-key="qq"  data-browser="QQ" data-extlink="qqbrowser://extensions/" data-toggle="tab" aria-selected="false" aria-controls="tab-qq_browser"><img class="browser-icon lazyload" src="https://cn01.aiprice.com/static/index/img/browser-icon/qq_browser.png"><p>QQ</p></a></li><li class="extension-manual__browser-item nav-item"><a class="extension-manual__browser-item-link nav-link" data-browser-key="sogo"  data-browser="Sogou" data-extlink="se://extensions" data-toggle="tab" aria-selected="false" aria-controls="tab-sougou"><img class="browser-icon lazyload" src="https://cn01.aiprice.com/static/index/img/browser-icon/sougou.png"><p>Sogou</p></a></li><li class="extension-manual__browser-item nav-item"><a class="extension-manual__browser-item-link nav-link" data-browser-key="opera" data-browser="Opera" data-extlink="opera://extensions/" data-toggle="tab" aria-selected="false" aria-controls="tab-opera"><img class="browser-icon lazyload" src="https://cn01.aiprice.com/static/index/img/browser-icon/opera.png"><p>Opera</p></a></li><li class="extension-manual__browser-item nav-item"><a class="extension-manual__browser-item-link nav-link" data-browser-key="maxthon" data-browser="Maxthon"data-extlink="mx://extensions/" data-toggle="tab" aria-selected="false" aria-controls="tab-maxthon"><img class="browser-icon lazyload" src="https://cn01.aiprice.com/static/index/img/browser-icon/maxthon.png"><p>Maxthon</p></a></li><li class="extension-manual__browser-item nav-item"><a class="extension-manual__browser-item-link nav-link" data-browser-key="2345" data-browser="2345" data-extlink="chrome://extensions" data-toggle="tab" aria-selected="false" aria-controls="tab-2345"><img class="browser-icon lazyload" src="https://cn01.aiprice.com/static/index/img/browser-icon/2345.png"><p>2345</p></a></li></ul><div class="tab-content" id="TabContent"><div class="tab-pane fade show active" id="tab-chrome"><div class="modal-install__manual-guide"><div class="modal-install__manual-guide-content"><div class="modal-install__manual-guide-title guide-desc">Chrome Browser Extension Installation Guide：</div><div class="modal-install__manual-guide-item"><em class="num flex-shrink-0">1</em><div class="guide-info"><div class="desc">Download Plugin File（Compatible with: <span class="browser_name">Chrome</span>）
                                                    <a class="btn btn-sm-green" href="https://api.chnprice.com/extension_page/1688/aiprice_sourcing_tool.zip?r=1858">Download Offline Package</a></div></div></div><div class="modal-install__manual-guide-item"><em class="num flex-shrink-0">2</em><div class="guide-info"><div class="desc"><span class="insert-ext-url">Enter <b class="select-url">chrome://extensions</b> in the address bar</span><a class="btn-text-link copy-select-url">Copy Link</a> &nbsp;,Open the extension management page, then enable Developer Mode in the top right corner</div></div></div><div class="modal-install__manual-guide-item"><em class="num flex-shrink-0">3</em><div class="guide-info"><div class="desc">Drag the downloaded .zip file directly into the page without unzipping it</div><div class="desc-more">More detailed<a class="text-blue text-decoration-underline" href="https://www.aiprice.com/resources/install.html" target="_blank">Install Guide</a></div></div></div></div><div class="modal-install__manual-guide-video"><div class="modal-install__manual-guide-title">Video Tutorial：</div><div class="modal-install__manual-guide-video-inner"><video class="w-100" controls="controls" loop="loop" muted="muted" autoplay="autoplay"><source src="" type="video/mp4"/>Your browser does not support the video tag</video></div></div></div></div></div></div></div></div></div></div></div><!--弹框：手动安装插件  --END--><script>    $(function(){
        //展示二维码
        $('.weixin').hover(
            function () {$(this).find('.tooltips-weixin-qrcode').addClass('d-flex')},
            function () {$(this).find('.tooltips-weixin-qrcode').removeClass('d-flex')}
        )

        //复制扩展管理链接
        $('.copy-select-url').click(function() {
            const $this = $(this);
            const originalHtml = $this.html();
            var textToCopy = $('.select-url').text();
            navigator.clipboard.writeText(textToCopy)
                .then(function() {
                    // 添加类并替换内容
                    $this.addClass('copied').html('<i class="ap-icon icon-right-fill"></i>Copy succeeded!');

                    // 3 秒后恢复原状
                    setTimeout(function () {
                        $this.removeClass('copied').html(originalHtml);
                    }, 3000);
                })
        });

        //切换浏览器
        $('#myTab .nav-link').click(function(){
            browser = $(this).attr('data-browser')
            $('.browser_name').text(browser)

            str = '<b class="select-url"> '+$(this).attr('data-extlink')+' </b>';
            var originalStr = "Enter {:msg} in the address bar";
            $('.insert-ext-url').html(originalStr.replace(/\{\:msg\}/g, str));

            originalStr = "{:msg} Browser Extension Installation Guide";
            $('.guide-desc').text(originalStr.replace(/\{\:msg\}/g, browser))

            var videoElement = $('.modal-install__manual-guide-video').find('video')[0];
            $(videoElement).empty();
            originalStr = 'https://chnprice-hk.oss-cn-hongkong.aliyuncs.com/video/offline_install/1688-chrome.mp4';
            videoUrl = originalStr.replace(/chrome/g, $(this).attr('data-browser-key'))
            $('<source>')
                .attr('src', videoUrl)
                .attr('type', 'video/mp4')
                .appendTo(videoElement);
            videoElement.load();

        })

        //方法一里的商店按钮：Edge / 360 三兄弟 / 紫鸟 / 傲游 走的是第三方扩展商店，
        //商店侧看不到安装数，点击量只能在本站统计，所以每次点击补发一条自定义事件
        $('#install-method-market .extension-manual__browser-item-link').on('click', function () {
            if (typeof window.gtag !== 'function') return;
            window.gtag('event', 'extension_store_click', {
                browser: $(this).attr('data-browser-key') || '',
                store: $(this).attr('data-store') || '',
                placement: 'homepage_manual_modal',
                link_url: $(this).attr('href') || ''
            });
        });

        /**
         * 打开「手动安装插件」弹窗——banner 离线按钮、浏览器列表、图搜平台三处共用
         * @param {string} method     'market' = 方法一：应用市场下载；其余 = 方法二：手动下载安装
         * @param {string} browserKey 方法二里默认选中的浏览器教程；没有对应教程就回落到 chrome
         */
        window.apOpenInstallManual = function (method, browserKey) {
            var key = browserKey || 'chrome';
            // 用 filter 而不是属性选择器拼串，免得 key 里有奇怪字符把选择器写坏
            var $tab = $('#myTab .nav-link').filter(function () {
                return $(this).attr('data-browser-key') === key;
            });
            if (!$tab.length) {
                $tab = $('#myTab .nav-link').filter(function () {
                    return $(this).attr('data-browser-key') === 'chrome';
                });
            }
            // 触发已有的切换处理，顺带把教程文案和视频换成这个浏览器的
            $tab.trigger('click');

            $(method === 'market' ? '#install-method-market-tab' : '#install-method-manual-tab').tab('show');
            $('#modal-install-manual').modal('show');
        };
    })
</script><script type="text/javascript" src="https://cn01.aiprice.com/static/index/js/foreign-access.js?v=1858"></script><script type="text/javascript" src="https://cn01.aiprice.com/static/js/browser-detection/dist/browser.min.js?v=10"></script><script type="text/javascript" src="https://cn01.aiprice.com/static/js/browser-detection/dist/browserlist.js"></script><script>    $(function () {
        //外网可达性提前算好并记下来：banner 按钮、支持的浏览器列表、图搜功能支持的平台三处共用同一个结论
        window.apNet.check();

        //banner图自动匹配浏览器
        var serviceBrowser = 'chrome';
        var country_code = 'US';
        //只有naver,紫鸟是服务端判断，其他都有js判断
        if (!['naver', 'ziniao', 'adspower'].includes(serviceBrowser)) {
            const p1 = browser.getInfo();
