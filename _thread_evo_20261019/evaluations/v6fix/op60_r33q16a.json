     }
    ]
   },
   {
    "sec": "S08",
    "bars": "62–71",
    "relation": "还说不清",
    "items": [
     {
      "id": "S08-1",
      "text": "自己也能让对方安心，这件事让他很满足；他不再只担心自己是不是需要得太多。",
      "key": "自己也能让对方安",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S07-2"
      ]
     },
     {
      "id": "S08-2",
      "text": "他心里轻快起来，第一次觉得两个人这样互相需要，也许真的能维持很久。",
      "key": "他心里轻快起来，",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1"
      ]
     },
     {
      "id": "S08-3",
      "text": "正高兴着，他忽然有一点舍不得，像是怕这份好感觉很快过去，却还说不清自己为什么会这样。",
      "key": "正高兴着，他忽然",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-3",
       "S08-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S07-1",
      "to": "S08-1",
