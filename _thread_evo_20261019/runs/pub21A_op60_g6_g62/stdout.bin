{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"细碎的光点再缓缓飘落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"船歌那种稳定的摇荡感还没有真正成形\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"怕一说出口，关系就变了\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现自己很想靠近\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"自己\",\n          \"keep\": \"却怕给对方负担\"\n        },\n        {\n          \"text\": \"这么一点亲近就让他觉得甜\",\n          \"point\": \"下次能不能更坦白\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这么一点亲近就让他觉得甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"沉默也不让人紧张\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"沉默也自在\"\n        },\n        {\n          \"quote\": \"没有把心事彻底说死\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"没把心事说死\"\n        },\n        {\n          \"quote\": \"因为太喜欢眼前的东西，所以还没有失去，就已经生出一丝舍不得\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没失去，就已舍不得\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"才慢慢放松下来\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没有退开，仍愿意亲近\"\n        },\n        {\n          \"text\": \"他也想靠得更