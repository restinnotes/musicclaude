      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S08",
    "bars": "62–71",
    "relation": "正在面对",
    "items": [
     {
      "id": "S08-1",
      "text": "他不再总想着自己是不是给得太多，单是想到两个人都愿意靠近，就觉得轻松又快乐。",
      "key": "他不再总想着自己",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1",
       "S07-1"
      ]
     },
     {
      "id": "S08-2",
      "text": "他忍不住盼起了以后的日子，心里偷偷把这份彼此需要当成两个人还能长久亲近的把握。",
      "key": "他忍不住盼起了以",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S07-3"
      ]
     },
     {
      "id": "S08-3",
      "text": "可真想到以后，他的高兴忽然有些接不上了，因为此刻再好，也还说不准将来会怎样。",
      "key": "可真想到以后，他",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S05-1",
      "to": "S08-1",
      "rel": "引用"
     },
     {
      "from": "S07-1",
      "to": "S08-1",
      "rel": "引用"
     },
     {
      "from": "S07-1",
