       "from": [
        "S11-1",
        "S11-2",
        "S11-3",
        "S11-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "步子从试探慢慢聚拢，害怕还在，脚已往前走",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "开心过，委屈不该忍，不为陪伴回头，带着想念往前",
