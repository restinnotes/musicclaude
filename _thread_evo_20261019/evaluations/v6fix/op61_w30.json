   "check": null,
   "notes": [],
   "revised": false
  },
  "S04": {
   "edit": {
    "items": [
     {
      "id": "S04-1",
      "text": "他知道，先前那份投入没能让自己安定下来，也没能让那份亲近照旧回来。",
      "key": "没能安定下来",
      "follows": false,
      "causes": [
       "c1"
      ]
     },
     {
      "id": "S04-2",
      "text": "他怕一停下来就得承认那份亲近已经回不到从前，便把继续行动当成暂时不去面对的办法。",
      "key": "继续行动",
      "follows": true,
      "causes": [
       "c2"
      ]
     },
     {
      "id": "S04-3",
      "text": "他想弄清当初没想透就行动时，自己是否还有别的选择。",
      "key": "别的选择",
      "follows": false,
      "causes": [
       "c3"
      ]
     }
    ],
    "because": [
     {
      "from": "S02-1",
      "to": "S04-1",
      "rel": "说明"
