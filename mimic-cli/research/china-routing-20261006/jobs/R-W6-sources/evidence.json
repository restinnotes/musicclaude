      "status": "VERIFIED_WITH_CAVEAT",
      "supported": true,
      "correction": null,
      "caveat": "Classification, valuation, admissibility and preparation of entry-related documents for others fall within the customs-business boundary; mere electronic transmission of received data is excluded.",
