          \"keep\": \"真盼着\"\n        },\n        {\n          \"text\": \"可一想到回去\",\n          \"point\": \"怀疑当初离开对不对\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一想到回去，受过的委屈又会涌上来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"只剩一个声音自己说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不是想通，是抵抗累了\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他不服气\",\n          \"point\": \"受过的气不该忍，开心的事也不该抹掉\",\n          \"where\": \"中\",\n          \"waste\": \"他不服气，\",\n          \"keep\": \"也不该抹掉\"\n        },\n        {\n          \"text\": \"他在心里争来争去\",\n          \"point\": \"自己已不在那些人身边\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没了力气才发现\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"连呼吸都不愿惊动它\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"也不必维持“我应该坚强”的姿态\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不必维持“我应该坚强”\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"愿望真切，却没有许诺回应\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"这回想起从前\",\n          \"point\": \"没急着拿受过的气压住想念\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没急着\"\n        },\n        {\n          \"text\": \"独自熬过那些难关后\",\n          \"point\": \"有人陪着有多轻松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"才懂\"\n        },\n        {\n          \"text\": \"他怕再也没有那份亲近\",\n          \"point\": \"心里暖了一点\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"但想到自己曾拥有过\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"像寒风猛地吹开紧闭的窗，把人从甜梦里生生拽回严寒\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"紧闭的窗，生生拽回严寒\"\n        },\n        {\n          \"quote\": \"身体和情绪却还没有完全相信一切已经结束\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"身体还不信一切已结束\"\n        },\n        {\n          \"quote\": \"恰恰因为那些细节具体而熟悉，反而更容易意识到自己已经失去了什么\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越熟悉，越觉失去\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他刚安心\",\n          \"point\": \"早知道这样还会走吗？\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"刚安心，却\"\n        },\n        {\n          \"text\": \"他想找回那份亲近\",\n          \"point\": \"离开的决心也开始动摇了\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又怕回去还要受气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一眼里有温柔，也有不舍\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"