连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"高处悬着\"\n        },\n        {\n          \"quote\": \"越用力，水面的颠簸就越剧烈，船舱内的平衡就越脆弱\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"熟悉的亲近又让他满心欢喜\",\n          \"point\": \"想起上回明明想告诉对方却没有开口\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"熟悉的亲近又让他满心欢喜\"\n        },\n        {\n          \"text\": \"他几乎想把藏着的话全说出来\",\n          \"point\": \"盼着对方也喜欢他不再小心收着的样子\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"不再小心收着的样子\"\n        },\n        {\n          \"text\": \"他甚至盼着说出来能把眼下的好留得久一点\",\n          \"point\": \"最后还是留了些话没说\",\n          \"where\": \"后\",\n          \"waste\": \"甚至\",\n          \"keep\": \"连两个人原有的自在也弄丢\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"丰满的声音只剩下一条单薄、孤零零的旋律，在空中漫无目的地游走\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"只剩单薄一线\"\n        },\n        {\n          \"quote\": \"一个人从“我与你”的亲密中抽身，转而跌回自己的内心\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"这份幸福是真实的吗？它能维持多久？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"前几次想说又收住\",\n          \"point\": \"对方已经看出他有多在乎\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"不知不觉就忘了藏好喜欢\"\n        },\n        {\n          \"text\": \"先前藏着时还能装作没那么在乎\",\n          \"point\": \"连怎么跟对方待着都拿不准\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"先前藏着时还能装作没那么在乎\"\n        },\n        {\n          \"text\": \"他忍不住担心对方会嫌自己太黏\",\n          \"point\": \"连原本熟悉的亲近，在他心里也像忽然隔了一层\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"在他心里\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"旁边另一条声线不时回应、插话，又不断与它纠缠\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"再亲密也没人能陪到心底\"\n        },\n        {\n          \"quote\": \"白天明明和某个人相处得很好，晚上回到家后，心头却泛起一阵酸楚\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"白天再好，夜里仍会酸楚\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"这回对方看出他有多在乎\",\n          \"point\": \"他才又能像从前那样自在地待着\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"跟他相处却一点没变\"\n        },\n        {\n          \"text\": \"安静下来以后\",\n          \"point\": \"忽然觉得有点孤单\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方根本不知道他刚才有多怕被嫌弃\"\n        },\n        {\n          \"text\": \"他又忍不住想\",\n          \"point\": \"会不会也有一点舍不得结束这份亲近\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"既然一直没有退开\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"原先压着的感受反而变成了动力，光是安静地享受已经不够\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"安静享受已不够\"\n        },\n        {\n          \"quote\": \"它有一点情色性的暖意；越舒服，越让人失去方向\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"什