      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S04",
    "bars": "92–115",
    "relation": "正在面对",
    "items": [
     {
      "id": "S04-1",
      "text": "那些平常的好又来到心里，他甚至庆幸自己曾经真正拥有过它们。",
      "key": "那些平常的好又来",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2"
      ]
     },
     {
      "id": "S04-2",
      "text": "紧接着他就有些恼自己：明明是自己要走的，怎么还舍不得成这样？",
      "key": "紧接着他就有些恼",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S04-1"
      ]
     },
     {
      "id": "S04-3",
      "text": "他赶紧把当初一再受过的委屈想回来，想让自己心安，结果仍旧放不下。",
      "key": "他赶紧把当初一再",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S04-2"
      ]
     },
     {
      "id": "S04-4",
      "text": "他来回想着这是不是说明自己选错了，想得心烦，却还是不肯说当初应该留下。",
      "key": "他来回想着这是不",
      "follows": false,
      "explains": [],
      "cite": [
       "S04-2",
       "S04-3"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-2",
      "to": "S04-1",
      "rel": "引用"
     },
     {
      "from": "S01-1",
