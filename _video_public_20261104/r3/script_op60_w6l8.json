       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的气味",
       "keys": [],
       "from": [
        "S06-B4-p2"
       ]
      },
      {
       "text": "贴近时的感觉",
       "keys": [],
       "from": [
        "S06-B4-p2"
       ]
      },
      {
       "text": "幻想和遗憾混在一起",
       "keys": [],
       "from": [
        "S06-B4-p2"
       ]
      },
      {
       "text": "越舒服越迷失方向",
       "keys": [],
       "from": [
        "S06-B4-p3"
       ],
       "emotion": "悬着"
      }
     ]
