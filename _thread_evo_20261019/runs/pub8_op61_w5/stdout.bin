     \"keys\": [],\n              \"from\": [\"S04-B4-p1\"]\n            },\n            {\n              \"text\": \"怎么会变成这样？\",\n              \"keys\": [],\n              \"from\": [\"S04-B4-p1\"]\n            },\n            {\n              \"text\": \"不敢停下来\",\n              \"keys\": [],\n              \"from\": [\"S04-B4-p3\"]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"groups\": [\n        {\n          \"rank\": \"主\",\n          \"emotion\": \"亲密\",\n          \"lines\": [\n            {\n              \"text\": \"我仍不服气，觉得当初那些气不该忍，可连过去开心的事都不敢多想，也太为难自己了。\",\n              \"from\": [\"S05-1\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              \"text\": \"夜里并肩的两个人\",\n              \"keys\": [],\n              \"from\": [\"S05-B1-p2\"]\n            },\n            {\n              \"text\": \"彼此低声说话\",\n              \"keys\": [],\n              \"from\": [\"S05-B1-p2\"]\n            },\n            {\n              \"text\": \"不能就这么算了\",\n              \"keys\": [],\n              \"from\": [\"S05-B2-p1\"],\n              \"emotion\": \"炽热\"\n            },\n            {\n              \"text\": \"想起从前心里又暖了\",\n              \"keys\": [],\n              \"from\": [\"S05-B3-p1\"]\n            },\n            {\n              \"text\": \"想念里也有难过\",\n              \"keys\": [],\n              \"from\": [\"S05-B3-p3\"],\n              \"emotion\": \"孤单\"\n            }\n          ]\n        },\n        {\n          \"rank\": \"次\",\n          \"emotion\": \"孤单\",\n          \"lines\": [\n            {\n              \"text\": \"我跟自己争得没了力气，那股不服气也渐渐淡了。\",\n              \"from\": [\"S05-2\"],\n              \"keys\": []\n            },\n            {\n              \"text\": \"想到自己如今已不在那些人身边，我只觉得难受。\",\n              \"from\": [\"S05-2\"],\n              \"keys\": []\n            }\n          ],\n          \"beads\": [\n            {\n              