        "S11-3",
        "S11-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "左手低音波涛般涌起，右手和弦像重锤砸下",
       "keys": [],
       "from": [
        "S11-B1"
       ],
       "bead": "S11-B1"
      },
      {
       "text": "步子还在试探前方有没有路；随后一点点聚拢，前进感越来越不可回避。害怕还在，脚却已经往前走了",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      }
