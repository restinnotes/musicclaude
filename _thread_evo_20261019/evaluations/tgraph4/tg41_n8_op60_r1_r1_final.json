   "relation": "正在面对",
   "items": [
    {
     "id": "I39",
     "text": "欢喜稍稍落定后，刚才那次尽情喜欢让他再难含糊自己真正想要什么。",
     "key": "尽情喜欢后看清所求",
     "kind": "知道更多反而更尖锐",
     "key_model": "再难含糊"
    },
    {
     "id": "I40",
     "text": "他想让自己的深情有所相遇，想知道对方是否也愿靠近、彼此珍惜。",
     "key": "盼深情相遇彼此珍惜",
     "kind": "",
     "key_model": "深情有所相遇"
    },
    {
     "id": "I41",
     "text": "他看清愿望的分量后，也更明白自己的真心不能成为对方必须回应的理由。",
     "key": "真心不能要求对方回应",
     "kind": "分清",
     "key_model": "不能成为"
    },
    {
     "id": "I42",
     "text": "退回谨慎仿佛辜负刚承认的心意，继续盼望又怕把爱变成对对方的要求。",
     "key": "盼望与怕强求的拉扯",
     "kind": "选择的代价",
     "key_model": "退回谨慎"
    },
    {
     "id": "I43",
     "text": "他想不出能兼顾这两边的办法，感到委屈，甚至厌倦了反复为难自己。",
     "key": "为两难委屈又厌倦",
