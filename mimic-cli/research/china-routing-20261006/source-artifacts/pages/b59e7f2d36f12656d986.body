        <div id="r_7064022" class="cell">
        
        <table cellpadding="0" cellspacing="0" border="0" width="100%">
            <tr>
                <td width="48" valign="top" align="center"><img src="https://cdn.v2ex.com/avatar/710c/ecdc/59282_normal.png?m=1781508588" class="avatar" border="0" align="default" alt="Tedko" data-uid="59282" /></td>
