     ]
    }
   ],
   "items_before_fix": [
    {
     "id": "I22",
     "text": "欢喜稍平后，他仍想知道自己是否也被对方放在心上。",
     "key": "仍想被放在心上",
     "kind": ""
    },
    {
     "id": "I23",
     "text": "这个念头让他难堪，因为他刚刚还为自己的无所求而高兴。",
     "key": "无所求后的难堪",
     "kind": "",
     "follows": true
    },
    {
     "id": "I24",
     "text": "他没法说自己毫无所求，也知道此前的快乐并非为了换取回应。",
     "key": "承认期待并非交换",
     "kind": "",
     "follows": true
    },
    {
     "id": "I25",
     "text": "他只能暂时停在这份不自在里，不替自己辩解，也不急着用新的热烈盖过去。",
     "key": "暂不替自己辩解",
     "kind": "",
     "follows": true
    }
   ],
