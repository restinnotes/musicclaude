            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        loadGsapScripts();
                        observer.unobserve(entry.target);
                    }
                });
            });
            const brandPc = document.querySelector(".Brand_pc");
            observer.observe(brandPc);
            function loadGsapScripts() {
                const gsapScript = document.createElement("script");
                gsapScript.src = "https://minisforum-web.oss-cn-shenzhen.aliyuncs.com/index/static/gsap.min.js";
                gsapScript.onload = () => {
                    const scrollTriggerScript = document.createElement("script");
                    scrollTriggerScript.src = "https://minisforum-web.oss-cn-shenzhen.aliyuncs.com/index/static/ScrollTrigger.min.js";
                    scrollTriggerScript.onload = () => initAnimation();
                    document.body.appendChild(scrollTriggerScript);
                };
                document.body.appendChild(gsapScript);
            }
            function initAnimation() {
                gsap.registerPlugin(ScrollTrigger);
                gsap.to(".Brand_pc", {
                    width: "40%", ease: "none",
                    scrollTrigger: {
                        trigger: ".Brand_pc", start: "top 200px", end: "+=1000", scrub: true,
                        onUpdate: (self) => {
                            const progress = self.progress;
                            const newWidth = Math.max(100 - progress * 100, 2);
                            document.querySelector(".Brand_pc").style.width = `${newWidth}%`;
                            const brandPc = document.querySelector(".Brand_pc");
                            const brandGird = document.querySelector(".Brand_gird");
                            if (newWidth < 40) {
                                brandPc.classList.add("Brand_hidden");
                                brandGird.classList.remove("Brand_hidden");
                            } else {
                                brandPc.classList.remove("Brand_hidden");
                                brandGird.classList.add("Brand_hidden");
                            }
                        },
                    },
                });
            }
        </script></div><div id="shopify-section-template--23713310933298__nov_policy_DgdhrR" class="shopify-section section-policy" style="display: none;"><div class="distance wow fadeInUp animated"><div class="container"><div class="container-inner position-relative"><div class="row spacing-30"><div class="nov-policy-item col-xl-3 col-lg-3 col-md-6 col-sm-6 col-6 bg-icon "><div class="policy__item--content style1 block-1 text-md-center d-flex align-items-center d-md-block"><div class="policy-icon d-inline-flex align-items-center justify-content-center mb-20 mb-sm-0 position-relative"><img class="lazyload" data-src="/index/static/1_200x.svg" alt="icon_policy"></div><div class="heading--policy"><div class="title-policy f_pr font-500">快速免费送货</div><div class="desc-policy">2-5 个工作日联邦快递运送</div></div></div></div><div class="nov-policy-item col-xl-3 col-lg-3 col-md-6 col-sm-6 col-6 bg-icon "><div class="policy__item--content style1 block-2 text-md-center d-flex align-items-center d-md-block"><div class="policy-icon d-inline-flex align-items-center justify-content-center mb-20 mb-sm-0 position-relative"><img class="lazyload" data-src="/index/static/3yrswarranty_200x.png" alt="icon_policy"></div><div class="heading--policy"><div class="title-policy f_pr font-500">3 年保修</div><div class="desc-policy">MINISFORUM 年度会员</div></div></div></div><div class="nov-policy-item col-xl-3 col-lg-3 col-md-6 col-sm-6 col-6 bg-icon "><div class="policy__item--content style1 block-3 text-md-center d-flex align-items-center d-md-block"><div class="policy-icon d-inline-flex align-items-center justify-content-center mb-20 mb-sm-0 position-relative"><img class="lazyload" data-src="/index/static/Group_36011_200x.svg" alt="icon_policy"></div><div class="heading--policy"><div class="title-policy f_pr font-500">30 天保证</div><div class="desc-policy">无需理由，全额退款</div></div></div></div><div class="nov-policy-item col-xl-3 col-lg-3 col-md-6 col-sm-6 col-6 bg-icon "><div class="policy__item--content style1 blo