<style>
    /* .a2a_default_style {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .a2a_svg,
    .a2a_count {
        border-radius: 50% !important;
    } */

    #st-1 .st-btn {
        display: inline-block !important;
        border-radius: 50%;
    }

    .modal-body form .form-group label {
        color: #000;
    }

    #ShareOverMailModal .modal-header,
    #ShareOverMailModal .close {
        background-color: #007BFF;
        color: #fff;
    }

    #ShareOverMailModal .close {
        opacity: 1;
    }

    /* Container for the loader */
    .loader-container {
        position: absolute;
        /* Position it absolutely inside the modal-body */
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* Take 100% height of its parent modal-body */
        background: rgba(0, 0, 0, 0.1);
        /* Semi-transparent background */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 99;
    }

    /* Dot container and dot styles */
    .dot-container {
        display: flex;
        gap: 10px;
    }

    .dot {
        width: 15px;
        height: 15px;
        border-radius: 50%;
        background-color: #007BFF;
        /* Changed color */
        animation: dot-animation 1.5s infinite ease-in-out;
    }

    .dot:nth-child(1) {
        animation-delay: 0s;
    }

    .dot:nth-child(2) {
        animation-delay: 0.3s;
    }

    .dot:nth-child(3) {
        animation-delay: 0.6s;
    }

    .dot:nth-child(4) {
        animation-delay: 0.9s;
    }

    @keyframes dot-animation {

        0%,
        100% {
            opacity: 0;
            transform: translateY(0);
        }

        50% {
            opacity: 1;
            transform: translateY(-10px);
        }
    }

    #send-mail-success {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
        color: #28a745;
        font-size: 18px;
        font-weight: bold;
    }

    .popup-form-alert {
        background: #fdecea;
        color: #b71c1c;
        border: 1px solid #f5c6cb;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 13px;
        margin-bottom: 12px;
    }

    .popup-success {
        text-align: center;
    }

    .popup-success-icon {
        margin-bottom: 12px;
    }

    .popup-success-title {
        font-size: 22px;
        font-weight: 700;
        margin: 0 0 8px;
        color: #1a1668;
    }

    .popup-success-text {
        font-size: 14px;
        color: #444;
        margin: 0;
        line-height: 1.5;
    }

    .popup-submit[disabled] {
        opacity: .6;
        cursor: not-allowed;
    }

    /* Thank-you state only: widen the dialog (BS .modal-lg is added via JS).
       Scoped override needed because the popup pins .modal-dialog to 400px.
       Gated to >=576px so phones keep the responsive full-width dialog. */
    @media (min-width:576px) {
        .banner-pop-up-modal-rd .modal-dialog.modal-lg {
            max-width: 600px;
        }
    }

    /* Company-email capture inside the success state — styled like the popup form */
    .popup-update-email {
        margin-top: 18px;
        text-align: left;
    }

    .popup-update-note {
        font-size: 19px;
        color: #201d69;
        margin: 0 0 20px;
        line-height: 1.45;
        text-align: center;
    }

    .popup-update-label {
        flex: 0 0 auto;
        white-space: nowrap;
        font-size: 13px;
        font-weight: 500;
        color: #2c2c2c;
        margin: 0;
    }

    .popup-update-row {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .popup-update-row input[type=email] {
        flex: 1 1 auto;
        min-width: 0;
        padding: 9px 11px;
        border: 1px solid #d8d8de;
        border-radius: 6px;
        font-size: 13.5px;
        color: #2c2c2c;
        background: #fff;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .popup-update-row input[type=email]::placeholder {
        color: #5b6473;
        opacity: 1;
    }

    .popup-update-row input[type=email]:focus {
        border-color: #0029ff;
        box-shadow: 0 0 0 3px rgba(0, 41, 255, .15);
    }

    .popup-update-row input.field-invalid {
        border-color: #e6263b;
        box-shadow: 0 0 0 1px #e6263b;
    }

    .popup-update-btn {
        flex: 0 0 auto;
        white-space: nowrap;
        padding: 9px 18px;
        border: none;
        border-radius: 6px;
        background: #0029ff;
        color: #fff;
        font-size: 13.5px;
        font-weight: 700;
        letter-spacing: .4px;
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

    .popup-update-btn:hover {
        background: #0022d6;
        box-shadow: 0 8px 18px -8px rgba(0, 41, 255, .55);
        transform: translateY(-1px);
    }

    .popup-update-btn:active {
        transform: translateY(0);
    }

    .popup-update-btn:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(0, 41, 255, .3);
    }

    .popup-update-btn[disabled] {
        opacity: .6;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .popup-update-alert {
