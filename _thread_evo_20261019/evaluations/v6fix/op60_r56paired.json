      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S10-2",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S05-2",
      "to": "S11-2",
      "rel": "引用"
     },
     {
      "from": "S11-1",
      "to": "S11-2",
      "rel": "引用"
     },
     {
      "from": "S09-1",
      "to": "S11-3",
      "rel": "引用"
     },
     {
      "from": "S11-1",
      "to": "S11-3",
      "rel": "引用"
     },
     {
      "from": "S11-2",
      "to": "S11-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "93–102",
    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "想到自己也许能让对方安心些，他心里满得发疼，只想好好陪着对方，自己能得到多少反倒顾不上了。",
      "key": "想到自己也许能让",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S11-1"
      ]
     },
     {
      "id": "S12-2",
      "text": "他还是嫌这样的日子不够多，明知再怎么喜欢也不能保证以后一直这样好，仍盼着能多陪对方一些。",
      "key": "他还是嫌这样的日",
      "follows": false,
      "explains": [],
      "cite": [
