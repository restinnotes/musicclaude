    },
    {
     "rank": "次",
     "kind": "另一侧面",
     "emotion": "不安",
     "lines": [
      {
       "text": "我催自己向前，却舍不得旧日的好。",
       "keys": [],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "试探着找方向",
