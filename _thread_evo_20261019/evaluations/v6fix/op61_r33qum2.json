      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "刚才那份暖还没散尽，他又生出一点熟悉的踏实，像是自己仍能待在从前的日子里。",
      "key": "刚才那份暖还没散",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1",
       "S08-2"
      ]
     },
     {
      "id": "S09-2",
      "text": "转念想到自己确实离开了，他猛地难过起来，那点踏实又没了着落。",
      "key": "转念想到自己确实",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S09-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S08-1",
