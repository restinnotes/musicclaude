                <div class="survery" id="survery"></div>

<script type="text/babel">
const Survery = () => {
    const checkboxList = [
        'It is missing information.',
        'The information is inaccurate/out of date.',
        'It doesn\'t match my expectations.',
        'Images weren\'t helpful.',
        'Any additional feedback.'
    ];

    const [select, setSelect] = React.useState([]);
    const [feedbackText, setFeedbackText] = React.useState('');
    
    // 按钮高亮 & 弹窗
    const [activeYes, setActiveYes] = React.useState(false);
    const [activeNo, setActiveNo] = React.useState(false);
    const [showFeedbackModal, setShowFeedbackModal] = React.useState(false);
    const [showThanksModal, setShowThanksModal] = React.useState(false);

    // 保存提交瞬间的反馈快照
    const submitSnapshotRef = React.useRef({
      selectedLabels: [],
      extraText: ''
    });

    let title = '';
    let url = location.href;

    // 获取 Cookie _ga
    const getCookie = () => {
        let all = document.cookie;
        let cookieArr = all.split(';');
        let id = '';
        cookieArr.forEach(item => {
            if (item.split('=')[0].trim() === '_ga') {
                id = item.split('=')[1];
            }
        });
        return id || 'unknown-user';
    };

    let clientId = getCookie();

    // 打点：获取文章信息（与 post.hbs 保持一致）
    const getArticleId = () => {
        const el = document.getElementById('post_id');
        return el ? el.innerText : '';
    };

    const getArticleTitle = () => {
        const el = document.getElementById('articleTitle');
        return el ? el.innerText : title;
    };

    const getFeedbackType = (selectedValues, extraText) => {
        const feedbackType = selectedValues.map(val => checkboxList[parseInt(val, 10) - 1].replace(/\.$/, ''));
        if (extraText.trim()) {
            feedbackType.push('Editable text');
        }
        if (selectedValues.length === 0 && !extraText.trim()) {
            feedbackType.push('Not selected');
        }
        return feedbackType;
    };

    const trackFeedback = (feedback) => {
        if (typeof eventCollect !== 'function') return;
        eventCollect({
            module: 'help_center',
            name: 'click',
            action: 'help_center_user_feedback',
            params: {
                id: getArticleId(),
                title: getArticleTitle(),
                feedback: feedback
            }
        });
    };

    const trackFeedbackSubmit = (selectedValues, extraText) => {
        if (typeof eventCollect !== 'function') return;
        eventCollect({
            module: 'help_center',
            name: 'click',
            action: 'help_center_user_feedback_submit',
            params: {
                id: getArticleId(),
                title: getArticleTitle(),
                feedback_type: getFeedbackType(selectedValues, extraText),
                editable_text: extraText
            }
        });
    };

    // 格式化标题
    const toUpCase = (str) => {
        let newStr = str.split(" ");
        for (var i = 0; i < newStr.length; i++) {
            newStr[i] = newStr[i].slice(0, 1).toUpperCase() + newStr[i].slice(1).toLowerCase();
        }
        return newStr.join(" ");
    };

    if (/\/(.*)\//g.test(location.pathname)) {
        title = toUpCase(RegExp.$1.replace(/\-/g, " "));
    }

    // 多选切换
    const handleCheckBox = (e) => {
        const value = e.target.value;
        if (e.target.checked) {
            setSelect([...select, value]);
        } else {
            setSelect(select.filter(item => item !== value));
        }
    };

    // 统一上报接口
    const submitSurvey = (isUseful) => {
        fetch('https://super-api.dsers.com/ecommerce/question', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                client_id: clientId,
                useful: isUseful,
                types: select.join(','),
                extra: feedbackText,
                article_title: title,
                article_link: url
            })
        })
        .then(res => res.text())
        .then(res => {
            try {
                const data = JSON.parse(res);
                if (data.code === 2010) console.log('上报成功');
            } catch (err) {
                console.error('解析失败', err);
            }
        })
        .catch(err => console.error('接口异常', err));
    };

    // 点击 Yes / No
    const handleFeedback = (type) => {
        if (type === 'yes') {
            trackFeedback('yes');
            setActiveYes(true);
            setActiveNo(false);
            setSelect([]);
            setFeedbackText('');
            submitSurvey(1);
            setShowThanksModal(true);
            setTimeout(() => setActiveYes(false), 400);
        } else {
            trackFeedback('no');
            setActiveNo(true);
            setActiveYes(false);
            setSelect([]);
            setFeedbackText('');
            setShowFeedbackModal(true);
        }
    };

    // 关闭反馈弹窗（点Cancel，立刻清空）
    const closeFeedbackModal = () => {
        setShowFeedbackModal(false);
        setSelect([]);
        setFeedbackText('');
    };

    // 【修改】提交反馈：不立即清空表单，直接打开感谢弹窗
    const submitFeedback = () => {
        // 快照保存当前提交的数据，供Contact Support使用
        submitSnapshotRef.current = {
            selectedLabels: select.map(val => checkboxList[parseInt(val,10)-1]),
            extraText: feedbackText.trim()
        };

        trackFeedbackSubmit(select, feedbackText);
        submitSurvey(0);
        // ❗删掉原来 closeFeedbackModal()，这里不清空
        setShowFeedbackModal(false); // 关闭第一个反馈弹窗，保留state数据
        setShowThanksModal(true);

        setTimeout(() => {
            setActiveNo(false);
        }, 300);
    };

    // 【修改】关闭感谢弹窗：在这里统一清空表单内容
    const closeThanksModal = () => {
        setShowThanksModal(false);
        setActiveYes(false);
        setActiveNo(false);
        // ✅ 第二个弹窗关闭的时候才清空选择和输入框
        setSelect([]);
        setFeedbackText('');
    };

    return (
        <div>
            {/* 评价按钮 */}
            <div className="article-feedback">
                <p className="feedback-question">Was this article helpful?</p>
                <div className="feedback-buttons">
                    <button 
                        className={`feedback-btn yes ${activeYes ? 'active' : ''}`}
                        onClick={() => handleFeedback('yes')}
                    >
                        <span className="material-icons-round">thumb_up</span>
                        Yes, it helped
                    </button>
                    <button 
                        className={`feedback-btn no ${activeNo ? 'active' : ''}`}
                        onClick={() => handleFeedback('no')}
                    >
                        <span className="material-icons-round">thumb_down</span>
                        Not really
                    </button>
                </div>
            </div>

            {/* 反馈弹窗 */}
            <div className={`modal-overlay ${showFeedbackModal ? 'show' : ''}`}
                onClick={(e) => e.target.classList.contains('modal-overlay') && closeFeedbackModal()}
            >
                <div className="modal-content">
                    <div className="modal-header">
                        <h3 className="modal-title">Share your feedback</h3>
                        <button className="modal-close" onClick={closeFeedbackModal}>
                            <span className="material-icons-round">close</span>
                        </button>
                    </div>

                    <div className="modal-body">
                        <label className="modal-label">What could we improve?</label>
                        
                        <div className="checkbox-group">
                            {checkboxList.map((item, index) => (
                                <div className="checkbox-item" key={index}>
                                    <input
                                        type="checkbox"
                                        className="feedback-checkbox"
                                        value={index + 1}
                                        checked={select.includes(String(index + 1))}
                                        onChange={handleCheckBox}
                                    />
                                    <span>{item}</span>
                                </div>
                            ))}
                        </div>

                        <textarea
                            className="modal-textarea"
                            value={feedbackText}
                            onChange={(e) => setFeedbackText(e.target.value)}
                            placeholder="Please describe your issue or suggestion..."
                        />
                    </div>

                    <div className="modal-footer">
                        <button className="modal-btn modal-btn-cancel" onClick={closeFeedbackModal}>Cancel</button>
                        <button className="modal-btn modal-btn-submit" onClick={submitFeedback}>Submit Feedback</button>
                    </div>
                </div>
            </div>

            {/* 感谢弹窗 */}
            <div className={`modal-overlay thanks-modal ${showThanksModal ? 'show' : ''}`}
                onClick={(e) => e.target.classList.contains('modal-overlay') && closeThanksModal()}
            >
                <div className="modal-content">
                    <div className="thanks-icon">
                        <span className="material-icons-round">check_circle</span>
                    </div>
                    <h3 className="thanks-title">Thank you for your feedback!</h3>
                    <p className="thanks-text">Your input helps us improve our documentation.</p>
                    <div className="modal-footer thanks-actions">
                        <button className="modal-btn modal-btn-cancel" onClick={closeThanksModal}>Close</button>
                        <button
                            className="modal-btn modal-btn-submit"
                            onClick={() => {
                                const { selectedLabels, extraText } = submitSnapshotRef.current;
                                const msgParts = [];
                                if(extraText){
                                    msgParts.push(extraText);
                                }
                                const msg = encodeURIComponent(msgParts.join("\n\n"));
                                const linkUrl = `https://www.messenger.com/t/DSersOfficial?text=${msg}`;
                                window.open(linkUrl, '_blank');
                                closeThanksModal();
                            }}
                        >
                            Contact Support
                        </button>
                    </div>
                </div>
            </div>
        </div>
    );
};

ReactDOM.render(<Survery />, document.getElementById("survery"))
</script>            </article>

            <div class="right-sidebar">

                <div class="tocbot_content" style="display: none;">
                        <div class="tocbot_title">ON THIS PAGE</div>
                <div class="tocbot_box"></div>
                </div>

                <div id="ab-test-container"></div>



            </div>

        </div>
    </div>


    <!-- 左侧悬浮目录呼出按钮（纯图标） -->
    <button class="drawer-toggle-btn" id="drawerToggleBtn" onclick="openDrawer()" aria-label="Open categories menu">
        <span class="material-icons-round">menu</span>
    </button>

    <!-- 右侧悬浮目录/广告呼出按钮 -->
    <button class="right-drawer-toggle-btn" id="rightDrawerToggleBtn" type="button" aria-label="Open table of contents">
        <span class="material-icons-round">toc</span>
    </button>
    <div class="right-drawer-overlay" id="rightDrawerOverlay"></div>
    <div class="right-drawer-panel" id="rightDrawerPanel">
        <div class="right-drawer-header">
            <span class="right-drawer-title">On This Page</span>
            <button class="right-drawer-close" id="rightDrawerCloseBtn" type="button" aria-label="Close">
                <span class="material-icons-round" style="font-size:18px;">close</span>
            </button>
        </div>
        <div class="right-drawer-body" id="rightDrawerBody"></div>
    </div>

<!-- 抽屉遮罩 -->
<div class="drawer-overlay" id="drawerOverlay"></div>

<!-- 抽屉面板 -->
<div class="drawer-panel" id="drawerPanel">
    <div class="drawer-header">
        <span class="drawer-title">All Categories</span>

        <button class="drawer-close" id="drawerCloseBtn">
            <span class="material-icons-round" style="font-size:18px;">
                close
            </span>
        </button>
    </div>

    <div class="drawer-toc">
        <ul class="toc-list">

