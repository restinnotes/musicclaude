 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开了那段熟悉的生活，起初觉得总算不用再委屈自己了",
       "keys": [
        "不用再委屈自己"
       ],
       "from": [
        "S01-1",
        "S01-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他强撑着挺直背脊，心里却很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "尊严还在，往哪走和哪里来力气都不稳",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里就空落落的，说不清舍不得什么",
       "keys": [
        "空落落的"
       ],
       "from": [
        "S01-2",
        "S01-B3",
        "S01-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉里醒来，胸口发紧，四周冷而空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "视线还模糊，伸出颤抖的手只摸到虚空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "那份失落还分不清是愤怒、遗憾还是怀念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他还想往前过，却不知道以后靠什么才能安下心",
       "keys": [
        "安下心"
       ],
       "from": [
        "S01-3",
        "S01-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧场景忽然回来，身体像记起怎样迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前自在的日子，一想到以后不能再那样过就发慌",
       "keys": [
        "不能再那样过"
       ],
       "from": [
        "S02-1",
        "S02-B1",
        "S02-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "舞步庄严甚至傲慢，旧歌却脆弱得像从远处传来",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "记忆里珍惜的东西还在，却不能像从前那样拥有",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "像腿脚虚浮的人，在记忆里挪动舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "一心软，他就提醒自己受过的气，怕忘了当初为什么离开",
       "keys": [
        "受过的气"
       ],
       "from": [
        "S02-2",
        "S02-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "他整理好衣服抬起头，不想让人看见动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "反复说我没事，说到后来自己也快不信了",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他还是不甘心，难道连以前的好日子也得一起丢掉吗",
       "keys": [
        "不甘心"
       ],
       "from": [
        "S02-3",
        "S02-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里还顶着一句：我不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他心里还憋着一股气，想起曾被当作自己人又短暂高兴起来",
       "keys": [
        "短暂高兴起来"
       ],
       "from": [
        "S03-1",
        "S03-B1",
        "S03-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像故乡夏日麦浪和微风，温柔得让人心颤",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "也像从前轻松亲近、不必时时防备的日子",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像暂时侧身离开伤口，出去走走，心事却还在",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那点高兴还没退，他就酸了：从前回不去，离开后也未必更好",
       "keys": [
        "离开后也未必更好"
       ],
       "from": [
        "S03-2",
        "S03-B2",
        "S03-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "越怀念越刺痛，眼前的处境离它很远",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "低声絮语缠在耳边，重心抓不住，也定不下方向",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "他心里问：刚才真信了，还是只在努力相信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他真盼着还能那样相处",
       "keys": [
        "还能那样相处"
       ],
       "from": [
        "S04-1",
        "S04-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧时光里有感激、亲密和短暂的幸福",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "那份坚定也许只是他努力想成为的样子",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可那份亲近越鲜活，当初受的委屈也跟着翻上来",
       "keys": [
        "委屈也跟着翻上来"
       ],
       "from": [
        "S04-2",
        "S04-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "细碎的动静像急促脚步，心跳也乱了拍，越跑越不安",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "越美好的记忆越刺痛，因为它回不来了",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他反复问自己，那一步走得对不对，没走的话如今又会怎样",
       "keys": [
        "那一步走得对不对"
       ],
       "from": [
        "S04-2",
        "S04-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子里停不下如果当时、是不是还可以",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "越往前赶，越像在躲开停下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他仍不服气，觉得当初那些气不该忍",
       "keys": [
        "那些气不该忍"
       ],
       "from": [
        "S05-1",
        "S05-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "两只手像夜色里两个影子，彼此低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "旧日记忆重新有了温度，可能是某个人也可能是故乡",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可连过去开心的事都不敢多想，也太为难自己了",
       "keys": [
        "也太为难自己了"
       ],
       "from": [
        "S05-1",
        "S05-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里有愤怒、悲伤，也有不肯就这么算了的劲",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "跟自己争得没了力气，那股不服气也渐渐淡了",
       "keys": [
        "没了力气"
       ],
       "from": [
        "S05-2",
        "S05-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "声音稀疏下来，像脚下的地板忽然不见",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "想到自己已不在那些人身边，他只觉得难受",
       "keys": [
        "只觉得难受"
       ],
       "from": [
        "S05-2",
        "S05-B1",
        "S05-B3",
        "S05-B4",
        "S05-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "几次深呼吸后松了一点，却还没想通",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      },
      {
       "text": "不是想通了，只是抵抗得累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "那阵难受慢慢缓下来，他终于敢好好想起从前的亲近",
       "keys": [
        "敢好好想起"
       ],
       "from": [
        "S06-1",
        "S06-B1",
        "S06-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "不用解释难过，也不用装坚强，愿望委屈思念都浮上来",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "像母亲在耳边轻轻哼着摇篮曲",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "如今身边少了那些人，他才知道有人陪着有多轻松",
       "keys": [
        "有人陪着有多轻松"
       ],
       "from": [
        "S06-2",
        "S06-B2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他很想再过那种不用多说就彼此亲近的日子，又怕以后再也没有",
       "keys": [
        "又怕以后再也没有"
       ],
       "from": [
        "S06-3",
        "S06-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "也像向遥远又不确定的对象祈求，愿望未必有回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "远方忽然亮起，梦里看见已经远去的家园",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "那样的日子他毕竟真真切切过过，光是想起心里也暖了一点",
       "keys": [
        "真真切切过过"
       ],
       "from": [
        "S06-4",
        "S06-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "他想轻轻看着它，不急着把它抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      },
      {
       "text": "现实并没因此变好，这份安宁也不能久留",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，他却猛然想到以后遇上难事还得自己扛",
       "keys": [
        "还得自己扛"
       ],
       "from": [
        "S07-1",
        "S07-B1",
        "S07-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "寒风像猛地吹开窗，后颈发凉，脉搏也乱跳",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "当初只想着别再受那些气，没想到离开后会这么孤单",
       "keys": [
        "会这么孤单"
       ],
       "from": [
        "S07-2",
        "S07-B2",
        "S07-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "熟悉的动作或舞蹈突然闯进脑海",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      },
      {
       "text": "越是具体熟悉，越能感觉自己失去了什么",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      },
      {
       "text": "新舞步闯进来，心里却没有因此安定",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想找回从前的亲近，又不甘心回去再受那些气",
       "keys": [
        "不甘心回去再受那些气"
       ],
       "from": [
        "S07-3",
        "S07-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那股宣告般的劲头再次出现，却已不完整",
       "keys": [],
       "from": [
        "S07-B5"
       ],
       "bead": "S07-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可连当初离开时那股决心，他也快找不着了",
       "keys": [
        "找不着了"
       ],
       "from": [
        "S07-3",
        "S07-B5"
       ]
      }
     ],
     "beads": [
      {
       "text": "想冲出去，心里翻转不停却找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "那份熟悉的亲近感又回来，他心里暖了一会儿",
       "keys": [
        "心里暖了一会儿"
       ],
       "from": [
        "S08-1",
        "S08-B1",
        "S08-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "这点暖意没有让他想回头",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "像临走前回头看一眼，温柔又不舍",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可暖意很快淡了，想到难事还得独自面对，心又悬起来",
       "keys": [
        "心又悬起来"
       ],
       "from": [
        "S08-2",
        "S08-B2",
        "S08-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "回忆没法陪他扛过以后遇到的难处",
       "keys": [],
