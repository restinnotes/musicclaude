 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近这个人",
       "keys": [
        "那么想靠近这个人"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夏夜烟花迸上高处，光点飘落后仍悬在水面",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "像刚踏上小船，木板微晃，身体有一瞬失重",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "有的演奏已在轻摇，有的声音还悬在空中",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他怕对方看出自己多需要这份亲近，会觉得负担太重，所以只敢露出一点喜欢",
       "keys": [
        "只敢露出一点喜欢"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话到嘴边先沉默几秒，怕说出口会改变关系",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "心里明明知道要说什么，还是格外谨慎",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "光这么一点亲近就很甜，他还拿不准下次能不能更坦白些",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因他露出在意就退开，仍愿意跟他亲近，他才渐渐放松",
       "keys": [
        "渐渐放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像贴近耳语，呼吸和体温都融在一起，夏末暖风黏在皮肤上",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "也像熟人安静坐着，不必找话说，偶尔对望也不紧张",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "脚下不必踩实，把身体交给船底温柔托着",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠得更近，有一阵子喜欢得几乎藏不住",
       "keys": [
        "喜欢得几乎藏不住"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声忽然热切起来，连呼吸也跟着变了",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "最后还是怕太急弄坏眼下的自在，收住了",
       "keys": [
        "怕太急弄坏眼下的自在"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待得这么好，他却想到时刻总会过去，没分开就先舍不得",
       "keys": [
        "没分开就先舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "人在船上不急靠岸，水和时间不停，他想让这一刻慢些",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "柔软落音像温柔的刺，甜蜜里有惆怅，眼前还好着就先鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他难得不去琢磨两个人往后会怎样，只想舒舒服服地待在这份亲近里",
       "keys": [
        "待在这份亲近里"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体被水波般的摇曳托着，晃着漂着，暂时不去哪里",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "像说完重要的话还沉浸其中，有点陶醉，也有点走神",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "又像亲密交谈后安静下来也不尴尬，人还在，心却慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想说有多喜欢这样，也想问对方是否一样",
       "keys": [
        "想说有多喜欢这样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急着倾诉的念头只在水面露了下头，很快又沉回去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "思绪像被风吹碎的倒影，闪闪发亮却拼不完整",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "亲密谈话碰到解不开的结，原本顺畅里生出阻力",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "没想好怎么开口，念头就淡了",
       "keys": [
        "念头就淡了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他满心欢喜，他想起上回想说却没开口",
       "keys": [
        "满心欢喜"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "细密花腔像水面光斑晃眼，聊起往事语速也渐渐快了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想把藏着的话全说出来，也盼对方喜欢他不再收着",
       "keys": [
        "把藏着的话全说出来"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "高处长颤音亮如夕阳最后一道金光，几乎刺眼",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "最深的情意涌到喉咙口，却颤抖哽咽",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他甚至盼着说出来能把眼下的好留得久一点",
       "keys": [
        "留得久一点"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "话还在空气里回荡，人却慢慢安静下来",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可他怕一下说得太多让对方为难，连两个人原有的自在也弄丢",
       "keys": [
        "怕一下说得太多让对方为难"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "原本轻握的手不自觉收紧，也想把对方抱牢",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "明明美好仍在发生，左手水波向前流，歌声美得让人想多留",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "最后还是留了些话没说",
       "keys": [
        "留了些话没说"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "抱紧时船身更颠，原有平衡也更脆弱",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "几次收住心意，对方仍愿亲近，这回他忘了藏喜欢，对方看出他多在乎",
       "keys": [
        "忘了藏喜欢"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他心里空落落的",
       "keys": [
        "空落落的"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "先前还能装作没那么在乎，如今连怎么待着都拿不准",
       "keys": [],
       "from": [
        "S05-2"
       ],
       "bead": "S05-2"
      },
      {
       "text": "像突然失去脚下支撑，连时间也松开了，小船漂进雾里",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "从两个人的亲近里抽身，忽然跌回自己心里",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "像一句重要的话悬在嘴边，他忍不住问幸福能维持多久",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕对方嫌自己太黏",
       "keys": [
        "怕对方嫌自己太黏"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "原本熟悉的亲近，在心里像忽然隔了一层",
       "keys": [],
       "from": [
        "S05-3"
       ],
       "bead": "S05-3"
      },
      {
       "text": "刚才想攥紧不放的冲动，终于轻轻退了下去",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他有多在乎，相处却一点没变，他才又自在起来",
       "keys": [
        "才又自在起来"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "暖金水面滑进古桥阴影，清凉如月光，像童年或初次心动的下午",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "安静时，他还想靠近，怕自己要得太多",
       "keys": [
        "怕自己要得太多"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "念头刚安静又冒出算了，还是放不下，也不再硬撑",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "也有人听成贴身沉醉，感觉像水波一层层荡开",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      },
      {
       "text": "气味、身体感觉、幻想、遗憾、快感混在一起，舒服得迷了方向",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "对方不知道他刚才多怕被嫌弃，他有点孤单",
       "keys": [
        "他有点孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他独自退回内心，白天相处得好，夜里却泛起酸楚",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "独处放大幽微感受，最亲近的人也进不了心里，美好恍惚成回忆",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他又忍不住想，对方会不会也舍不得结束这份亲近？",
       "keys": [
        "舍不得结束这份亲近"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他渐渐觉得，对方有时也需要他陪着",
       "keys": [
        "有时也需要他陪着"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "跟他在一起，对方也许能安心些",
       "keys": [
        "也许能安心些"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到两个人也许能互相依靠，他高兴得收不住",
       "keys": [
        "高兴得收不住"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "原先压着的感受变成动力，身体被更深的渴望推着往前",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "情欲、执念和对生的眷恋，一起从心底翻涌",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "那股热度带着情色的暖意，让人舍不得抽身",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "明知正被卷进去，却暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "心里忽然一紧，却还是想这样待着",
       "keys": [
        "心里忽然一紧"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他盼着对方以后想找人陪时还会想到自己，自己也能一直陪着",
       "keys": [
        "一直陪着"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "这一刻再完美，也听见时间正流过，没法让它停住",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
