  },
  {
   "bars": "111–116",
   "relation": "正在面对",
   "items": [
    {
     "id": "I65",
     "text": "牵挂仍未平息，他渐渐不再要求自己找出一种不会受伤的爱法。",
     "key": "不会受伤的爱法",
     "kind": ""
    },
    {
     "id": "I66",
     "text": "他仍想被对方选择，因为对方确实重要，即使未必如愿，也不愿假装不曾期盼。",
     "key": "不曾期盼",
     "kind": ""
    },
    {
     "id": "I67",
     "text": "他不愿放弃克制，因为对方有自己的心意，他不想为了安心而逼对方迁就。",
     "key": "逼对方迁就",
     "kind": "分清"
    },
    {
     "id": "I68",
     "text": "他依旧会遗憾，但不再觉得必须先消除这份遗憾，才能继续喜欢。",
     "key": "依旧会遗憾",
     "kind": ""
    },
    {
     "id": "I69",
     "text": "即使疑问没得到回答，他仍珍惜先前那些真实的快乐，也因此知道对方多重要。",
     "key": "真实的快乐",
     "kind": ""
    },
    {
     "id": "I70",
     "text": "他仍盼回应，也仍会克制，却不拿回应的有无检验真心，或拿克制多少证明清醒。",
     "key": "检验真心",
     "kind": "分清"
    },
    {
     "id": "I71",
     "text": "他知道今后还会想靠得更近，仍可能因得不到而疼，却不把疼痛变成否认或催促。",
     "key": "因得不到而疼",
     "kind": ""
    },
    {
     "id": "I72",
     "text": "他愿继续把这个人放在心里，认真地喜欢，尽情欢喜，也接纳无法替对方决定的部分。",
     "key": "认真地喜欢",
     "kind": ""
    },
    {
     "id": "I73",
     "text": "即使没有得到想要的一切，他仍可以盼着被爱而不强求，也能尊重对方而不收回心意。",
     "key": "不收回心意",
     "kind": "分清"
    }
   ],
