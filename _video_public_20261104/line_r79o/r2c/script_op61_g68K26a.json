       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "少了他们在身边，他才懂从前有多轻松",
       "keys": [
        "多轻松"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他想再有那样的亲近，也怕以后再没有",
       "keys": [
        "怕以后再没有"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "隔着玻璃罩听母亲哼摇篮曲，想起曾拥有也暖了",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "远方旧家园像梦里亮起，他只想静静看着不去抓",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    }
   ]
