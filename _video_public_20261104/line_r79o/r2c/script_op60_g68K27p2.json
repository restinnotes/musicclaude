       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他这才渐渐放松下来",
       "keys": [
        "放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "不用再踩实地面，只管把身体交给船底轻轻托着",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "人在船上舒服地漂着，水一直在流，时间也一直在走",
