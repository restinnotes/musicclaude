{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\"text\": \"他忽然发现自己这么想靠近对方\", \"accent\": \"这么想靠近\", \"emotion\": \"炽热\", \"from\": [\"S01-1\"], \"at\": 0},\n        {\"text\": \"怕对方嫌他太需要这份亲近，只敢露出一点喜欢\", \"accent\": \"一点喜欢\", \"emotion\": \"不安\", \"from\": [\"S01-2\"], \"at\": 6},\n        {\"text\": \"这一点亲近已经很甜，他还不知下次敢不敢坦白\", \"accent\": \"很甜\", \"emotion\": \"欢喜\", \"from\": [\"S01-3\"], \"at\": 12}\n      ],\n      \"small\": [\n        {\"text\": \"像要对亲近的人说一件想了很久的事，话到嘴边先沉默\", \"after\": 1, \"from\": [\"S01-B2\"], \"bars\": \"1–3\", \"at\": 3},\n        {\"text\": \"他明知话一出口关系可能改变，所以格外谨慎\", \"after\": 1, \"from\": [\"S01-B2\"], \"bars\": \"1–3\", \"at\": 5},\n        {\"text\": \"像刚踏上小船，木板微晃，脚下水波荡开\", \"after\": 0, \"from\": [\"S01-B3\"], \"bars\": \"1–3\", \"at\": 9}\n      ],\n      \"notes\": [\n        {\"text\": \"开头两下和弦突然迸出，像威尼斯夏夜烟花\", \"from\": [\"S01-B1\"], \"pt\": \"\", \"bars\": \"1–3\"},\n        {\"text\": \"细碎光点缓缓飘落，却仍悬在水面上方\", \"from\": [\"S01-B1\"], \"pt\": \"\", \"bars\": \"1–3\"},\n        {\"text\": \"这里像刚踏上船板，还没进入稳定摇荡\", \"from\": [\"S01-B3\"], \"pt\": \"\", \"bars\": \"1–3\"},\n        {\"text\": \"有些演奏开头已在摇晃，这里仍像刚刚上船\", \"from\": [\"S01-B3\"], \"pt\": \"\", \"bars\": \"1–3\"}\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\"text\": \"对方没有退开，仍愿意亲近，他才慢慢放松\", \"accent\": \"慢慢放松\", \"emotion\": \"安心\", \"from\": [\"S02-1\"], \"at\": 0},\n        {\"text\": \"他也想顺势靠近，一度喜欢得几乎藏不住\", \"accent\": \"几乎藏不住\", \"emotion\": \"炽热\", \"from\": [\"S02-2\"], \"at\": 10},\n        {\"text\": \"可他怕太急会弄坏眼下的自在，最后还是收住\", \"accent\": \"最后还是收住\", \"emotion\": \"不安\", \"from\": [\"S02-2\"], \"at\": 20},\n        {\"text\": \"两个人待在一起这么好，他却想到这一刻总会过去\", \"accent\": \"总会过去\", \"emotion\": \"悬着\", \"from\": [\"S02-3\"], \"at\": 30},\n        {\"text\": \"还没分开，他心里已经有一点舍不得\", \"accent\": \"有一点舍不得\", \"emotion\": \"孤单\", \"from\": [\"S02-3\"], \"at\": 40}\n      ],\n      \"small\": [\n        {\"text\": \"像相识已久的人并肩坐着，不必找话题，沉默也不紧张\", \"after\": 0, \"from\": [\"S02-B1\"], \"bars\": \"4–16\", \"at\": 2},\n        {\"text\": \"夏末潮湿温热的风裹在皮肤上，有些黏稠\", \"after\": 0, \"from\": [\"S02-B1\"], \"bars\": \"4–16\", \"at\": 5},\n        {\"text\": \"脚下仿佛不用踩实，可以交给船底温柔托住\", \"after\": 0, \"from\": [\"S02-B2\"], \"bars\": \"4–5\", \"at\": 12},\n        {\"text\": \"人舒服地漂着，不急靠岸，水和时间却不停流\", \"after\": 3, \"from\": [\"S02-B2\"], \"bars\": \"4–16\", \"at\": 23},\n        {\"text\": \"眼前的好还在，心里却已经有点鼻酸\", \"after\": 4, \"from\": [\"S02-B4\"], \"bars\": \"7–11\", \"at\": 35}\n      ],\n      \"notes\": [\n        {\"text\": \"右手两条旋律贴得很近，像耳语和肩膀相依\", \"from\": [\"S02-B1\"], \"pt\": \"\", \"bars\": \"4–16\"},\n        {\"text\": \"第4–5小节左手像心跳，一下一下地摇着\", \"from\": [\"S02-B2\"], \"pt\": \"\", \"bars\": \"4–5\"},\n        {\"text\": \"第12–14小节歌声上涌，14–16小节轻轻收回\", \"from\": [\"S02-B3\"], \"pt\": \"\", \"bars\": \"12–16\"},\n        {\"text\": \"声音短暂落稳，又微微漂起，没有冲向高潮\", \"from\": [\"S02-B3\"], \"pt\": \"\", \"bars\": \"12–16\"},\n        {\"text\": \"几次柔软的落音像温柔的刺，甜里带惆怅\", \"from\": [\"S02-B4\"], \"pt\": \"\", \"bars\": \"7–11\"}\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\"text\": \"他难得不去想两个人以后怎样，只想安心待在亲近里\", \"accent\": \"安心待在亲近里\", \"emotion\": \"安心\", \"from\": [\"S03-1\"], \"at\": 0},\n        {\"text\": \"他想说自己有多喜欢，也想问对方是不是一样\", \"accent\": \"是不是一样\", \"emotion\": \"亲密\", \"from\": [\"S03-2\"], \"at\": 10},\n        {\"text\": \"可还没想好怎么开口，这个念头就淡了\", \"accent\": \"念头就淡了\", \"emotion\": \"悬着\", \"from\": [\"S03-2\"], \"at\": 20}\n      ],\n      \"small\": [\n        {\"text\": \"像说过重要的话后，还沉在那句话里，有点陶醉走神\", \"after\": 0, \"from\": [\"S03-B1\"], \"bars\": \"17–23\", \"at\": 2},\n        {\"text\": \"亲密交谈后忽然安静，沉默反而很舒服\", \"after\": 0, \"from\": [\"S03-B1\"], \"bars\": \"17–23\", \"at\": 4},\n        {\"text\": \"一个急着表达的念头闪了一下，很快又沉回去\", \"after\": 1, \"from\": [\"S03-B2\"], \"bars\": \"20–21\", \"at\": 12},\n        {\"text\": \"平稳的谈话像被水下暗流拖住，绕远又滞留\", \"after\": 2, \"from\": [\"S03-B3\"], \"bars\": \"20–22\", \"at\": 21},\n        {\"text\": \"思绪像被风吹碎的倒影，闪着却拼不完整\", \"after\": 2, \"from\": [\"S03-B3\"], \"bars\": \"20–22\", \"at\": 23},\n        {\"text\": \"亲密的谈话碰到解不开的结，却没有走向悲剧\", \"after\": 2, \"from\": [\"S03-B3\"], \"bars\": \"20–22\", \"at\": 25}\n      ],\n      \"notes\": [\n        {\"text\": \"歌声渐退，只剩流动盘旋的摇曳\", \"from\": [\"S03-B1\"], \"pt\": \"\", \"bars\": \"17–23\"},\n        {\"text\": \"约第20–21小节，短促急切的声音忽然冒出\", \"from\": [\"S03-B2\"], \"pt\": \"\", \"bars\": \"20–21\"},\n        {\"text\": \"约第20–22小节，平稳流动中出现牵绊和滞留\", \"from\": [\"S03-B3\"], \"pt\": \"\", \"bars\": \"20–22\"}\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\"text\": \"熟悉的亲近又让他欢喜，也想起上回没说出口的话\", \"accent\": \"没说出口的话\", \"emotion\": \"欢喜\", \"from\": [\"S04-1\"], \"at\": 0},\n        {\"text\": \"这回他几乎想把藏着的心意全说出来\", \"accent\": \"全说出来\", \"emotion\": \"炽热\", \"from\": [\"S04-2\"], \"at\": 8},\n        {\"text\": \"他盼着对方也喜欢自己不再小心的样子\", \"accent\": \"不再小心\", \"emotion\": \"亲密\", \"from\": [\"S04-2\"], \"at\": 16},\n        {\"text\": \"他甚至盼着说出口，能让眼下的好留久一点\", \"accent\": \"留久一点\", \"emotion\": \"欢喜\", \"from\": [\"S04-3\"], \"at\": 26},\n        {\"text\": \"可他怕说得太多让对方为难，连原有的自在也弄丢\", \"accent\": \"原有的自在\", \"emotion\": \"不安\", \"from\": [\"S04-3\"], \"at\": 36}\n      ],\n      \"small\": [\n        {\"text\": \"像讲起往事，语速渐快，忍不住反复补上细节\", \"after\": 0, \"from\": [\"S04-B1\"], \"bars\": \"24–34\", \"at\": 4},\n        {\"text\": \"最深的情意到了喉咙口，像要哽咽\", \"after\": 1, \"from\": [\"S04-B2\"], \"bars\": \"30–34\", \"at\": 10},\n        {\"text\": \"像夕阳在水面切出最后一道刺眼金光\", \"after\": 1, \"from\": [\"S04-B2\"], \"bars\": \"30–34\", \"at\": 14},\n        {\"text\": \"话还在空气里回荡，人已慢慢安静下来\", \"after\": 3, \"from\": [\"S04-B2\"], \"bars\": \"30–34\", \"at\": 20},\n        {\"text\": \"握着对方的手，不知不觉就越握越紧\", \"after\": 2, \"from\": [\"S04-B3\"], \"bars\": \"24–34\", \"at\": 24},\n        {\"text\": \"越想抱紧对方，水面越颠簸，船里的平衡越脆弱\", \"after\": 4, \"from\": [\"S04-B3\"], \"bars\": \"24–34\", \"at\": 28},\n        {\"text\": \"明明美好还在发生，心里却已经鼻酸\", \"after\": 3, \"from\": [\"S04-B4\"], \"bars\": \"24–34\", \"at\": 36},\n        {\"text\": \"歌声越美，越想把这一刻多留一会儿\", \"after\": 3, \"from\": [\"S04-B4\"], \"bars\": \"24–34\", \"at\": 42}\n      ],\n      \"notes\": [\n        {\"text\": \"第24小节熟悉歌声重来，两道声线仍贴近耳语\", \"from\": [\"S04-B1\"], \"pt\": \"\", \"bars\": \"24–34\"},\n        {\"text\": \"花腔变得更华丽急切，像水面晃动的光斑\", \"from\": [\"S04-B1\"], \"pt\": \"\", \"bars\": \"24–34\"},\n        {\"text\": \"第32小节附近高处长颤音，把情绪推到最亮处\", \"from\": [\"S04-B2\"], \"pt\": \"\", \"bars\": \"30–34\"},\n        {\"text\": \"右手高处悬停，左手仍推着往前，随后渐弱放慢\", \"from\": [\"S04-B2\"], \"pt\": \"\", \"bars\": \"30–34\"},\n        {\"text\": \"左手水波一直向前，仿佛每一秒都在倒数\", \"from\": [\"S04-B4\"], \"pt\": \"\", \"bars\": \"24–34\"}\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\"text\": \"这回他没藏住喜欢，对方看出他有多在乎\", \"accent\": \"看出他有多在乎\", \"emotion\": \"炽热\", \"from\": [\"S05-1\"], \"at\": 0},\n        {\"text\": \"他心里空落落的，连怎么相处都拿不准\", \"accent\": \"空落落的\", \"emotion\": \"孤单\", \"from\": [\"S05-2\"], \"at\": 6},\n        {\"text\": \"怕对方嫌他太黏，熟悉的亲近也像隔了一层\", \"accent\": \"隔了一层\", \"emotion\": \"不安\", \"from\": [\"S05-3\"], \"at\": 12}\n      ],\n      \"small\": [\n        {\"text\": \"前几次想说又收住，对方却一直愿意亲近\", \"after\": 0, \"from\": [\"S05-1\"], \"bars\": \"\", \"at\": 2},\n        {\"text\": \"像小船漂进起雾的水域，前路一下没了方向\", \"after\": 1, \"from\": [\"S05-B1\"], \"bars\": \"35–39\", \"at\": 4},\n        {\"text\": \"刚才还像两个人耳语，交谈却忽然停了\", \"after\": 1, \"from\": [\"S05-B2\"], \"bars\": \"35–39\", \"at\": 8},\n        {\"text\": \"他甚至会问：这份幸福是真的吗？能维持多久？\", \"after\": 1, \"from\": [\"S05-B2\"], \"bars\": \"35–39\", \"at\": 10},\n        {\"text\": \"像终于松开攥紧的手，深深吸了一口气\", \"after\": 2, \"from\": [\"S05-B3\"], \"bars\": \"35–39\", \"at\": 14}\n      ],\n      \"notes\": [\n        {\"text\": \"托着的水波忽然抽掉，只剩一条单薄旋律\", \"from\": [\"S05-B1\"], \"pt\": \"\", \"bars\": \"35–39\"},\n        {\"text\": \"丰满的交谈感戛然而止，声音退回独处\", \"from\": [\"S05-B2\"], \"pt\": \"\", \"bars\": \"35–39\"}\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\"text\": \"对方看出他有多在乎，相处却一点没变\", \"accent\": \"一点没变\", \"emotion\": \"安心\", \"from\": [\"S06-1\"], \"at\": 0},\n        {\"text\": \"他终于又能像从前那样自在地待着\", \"accent\": \"自在地待着\", \"emotion\": \"安心\", \"from\": [\"S06-1\"], \"at\": 6},\n        {\"text\": \"可安静下来，他还是想靠近，又怕自己要得太多\", \"accent\": \"怕自己要得太多\", \"emotion\": \"不安\", \"from\": [\"S06-2\"], \"at\": 12},\n        {\"text\": \"对方不知道他刚才多怕被嫌弃，他有点孤单\", \"accent\": \"有点孤单\", \"emotion\": \"孤单\", \"from\": [\"S06-2\"], \"at\": 19},\n        {\"text\": \"他忍不住想，对方会不会也舍不得结束这份亲近\", \"accent\": \"也舍不得\", \"emotion\": \"悬着\", \"from\": [\"S06-3\"], \"at\": 27}\n      ],\n      \"small\": [\n        {\"text\": \"光线像从暖金水面滑进古桥阴影，空气凉了\", \"after\": 0, \"from\": [\"S06-B1\"], \"bars\": \"40–50\", \"at\": 4},\n        {\"text\": \"像清凉月光，也让人想起童年或第一次心动\", \"after\": 1, \"from\": [\"S06-B1\"], \"bars\": \"40–50\", \"at\": 8},\n        {\"text\": \"一个念头刚安静下来，又回来插一句：算了，还是放不下\", \"after\": 2, \"from\": [\"S06-B2\"], \"bars\": \"40–50\", \"at\": 11},\n        {\"text\": \"像说着说着忘了有人看着，不再努力显得完整\", \"after\": 2, \"from\": [\"S06-B2\"], \"bars\": \"40–50\", \"at\": 15},\n        {\"text\": \"白天相处得很好，夜里独自回家却泛起酸楚\", \"after\": 3, \"from\": [\"S06-B3\"], \"bars\": \"40–50\", \"at\": 20},\n        {\"text\": \"最亲近的人也走不进心底每个角落，眼前的好像已成回忆\", \"after\": 3, \"from\": [\"S06-B3\"], \"bars\": \"40–50\", \"at\": 23},\n        {\"text\": \"气味、身体感觉、幻想、遗憾和快感混在一起\", \"after\": 4, \"from\": [\"S06-B4\"], \"bars\": \"40–50\", \"at\": 30},\n        {\"text\": \"越舒服，反而越让人失去方向\", \"after\": 4, \"from\": [\"S06-B4\"], \"bars\": \"40–50\", \"at\": 34}\n      ],\n      \"notes\": [\n        {\"text\": \"第40小节熟悉摇摆回来，左手波浪变薄变碎\", \"from\": [\"S06-B1\"], \"pt\": \"\", \"bars\": \"40–50\"},\n        {\"text\": \"A大调新旋律清澈舒展，近乎朴素牧歌\", \"from\": [\"S06-B1\"], \"pt\": \"\", \"bars\": \"40–50\"},\n        {\"text\": \"主旋律压低声音，另一条声线不断回应插话\", \"from\": [\"S06-B2\"], \"pt\": \"\", \"bars\": \"40–50\"},\n        {\"text\": \"两条声线时而靠近，时而退开，彼此纠缠\", \"from\": [\"S06-B2\"], \"pt\": \"\", \"bars\": \"40–50\"}\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\"text\": \"他觉得对方有时也需要自己，跟他在一起也能安心些\", \"accent\": \"也需要自己\", \"emotion\": \"安心\", \"from\": [\"S07-1\"], \"at\": 0},\n        {\"text\": \"想到两个人也许能互相依靠，他高兴得有点收不住\", \"accent\": \"互相依靠\", \"emotion\": \"欢喜\", \"from\": [\"S07-2\"], \"at\": 8},\n        {\"text\": \"这份高兴里忽然有点发紧，他却还想这样待着\", \"accent\": \"还想这样待着\", \"emotion\": \"炽热\", \"from\": [\"S07-2\"], \"at\": 16},\n        {\"text\": \"他盼着以后对方想找人陪时，还会想到自己\", \"accent\": \"还会想到自己\", \"emotion\": \"亲密\", \"from\": [\"S07-3\"], \"at\": 24},\n        {\"text\": \"他也想一直陪在对方身边\", \"accent\": \"一直陪在身边\", \"emotion\": \"亲密\", \"from\": [\"S07-3\"], \"at\": 32}\n      ],\n      \"small\": [\n        {\"text\": \"这些日子，对方总愿意跟他待在一起\", \"after\": 0, \"from\": [\"S07-1\"], \"bars\": \"\", \"at\": 4},\n        {\"text\": \"安静享受已经不够，身体像被更深的渴望推着走\", \"after\": 1, \"from\": [\"S07-B1\"], \"bars\": \"51–61\", \"at\": 12},\n        {\"text\": \"热度像情欲、执念和对生命的眷恋一齐涌上来\", \"after\": 2, \"from\": [\"S07-B1\"], \"bars\": \"51–61\", \"at\": 18},\n        {\"text\": \"回想一段关系时，气味、身体感觉、幻想和遗憾混在一起\", \"after\": 2, \"from\": [\"S07-B2\"], \"bars\": \"51–61\", \"at\": 20},\n        {\"text\": \"那份快感带着一点情色的暖意\", \"after\": 2, \"from\": [\"S07-B2\"], \"bars\": \"51–61\", \"at\": 26},\n        {\"text\": \"明知自己正被卷进去，却暂时不想出来\", \"after\": 2, \"from\": [\"S07-B2\"], \"bars\": \"51–61\", \"at\": 34},\n        {\"text\": \"美还在，时间却已经从身边经过\", \"after\": 3, \"from\": [\"S07-B3\"], \"bars\": \"53–61\", \"at\": 37}\n      ],\n      \"notes\": [\n        {\"text\": \"51–61小节主题再现，伴奏音符变得更密\", \"from\": [\"S07-B1\"], \"pt\": \"\", \"bars\": \"51–61\"},\n        {\"text\": \"内声部像暗涌攀爬，低音八度与切分像沉重脉搏\", \"from\": [\"S07-B1\"], \"pt\": \"\", \"bars\": \"51–61\"},\n        {\"text\": \"清澈还在，底下的推动却越来越急\", \"from\": [\"S07-B1\"], \"pt\": \"\", \"bars\": \"51–61\"}\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\"text\": \"上回无意间露了心意，这回见对方依然亲近\", \"accent\": \"依然亲近\", \"emotion\": \"欢喜\", \"from\": [\"S08-1\"], \"at\": 0},\n        {\"text\": \"他想主动些，大大方方地回应这份亲近\", \"accent\": \"大大方方地回应\", \"emotion\": \"炽热\", \"from\": [\"S08-1\"], \"at\": 8},\n        {\"text\": \"他开始盼着以后，觉得两个人也许还能这样好很久\", \"accent\": \"好很久\", \"emotion\": \"欢喜\", \"from\": [\"S08-2\"], \"at\": 16},\n        {\"text\": \"可想到以后未必一直如此，他心里又没底\", \"accent\": \"心里又没底\", \"emotion\": \"不安\", \"from\": [\"S08-3\"], \"at\": 24}\n      ],\n      \"small\": [\n        {\"text\": \"这会儿他不再分析和防卫，只想敞开地回应\", \"after\": 1, \"from\": [\"S08-B1\"], \"bars\": \"62–70\", \"at\": 4},\n        {\"text\": \"连身体都像重新有了弹性，带一点玩心\", \"after\": 1, \"from\": [\"S08-B2\"], \"bars\": \"62–70\", \"at\": 10},\n        {\"text\": \"轻快得像调情，也像自然地回应\", \"after\": 1, \"from\": [\"S08-B2\"], \"bars\": \"62–70\", \"at\": 18},\n        {\"text\": \"快乐的余温还在，心里却泛起一阵怀念\", \"after\": 3, \"from\": [\"S08-B3\"], \"bars\": \"69–71\", \"at\": 28}\n      ],\n      \"notes\": [\n        {\"text\": \"旋律忽然直接舒展，近乎意大利歌剧咏叹调\", \"from\": [\"S08-B1\"], \"pt\": \"\", \"bars\": \"62–70\"},\n        {\"text\": \"歌句越唱越开，熟悉的摇荡也轻轻催促\", \"from\": [\"S08-B1\", \"S08-B2\"], \"pt\": \"\", \"bars\": \"62–70\"},\n        {\"text\": \"第69–70小节歌声向上散开，约第71小节戛然而止\", \"from\": [\"S08-B3\"], \"pt\": \"\", \"bars\": \"69–71\"}\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\"text\": \"他开始具体地怕，有天对方不再需要他陪\", \"accent\": \"不再需要他陪\", \"emotion\": \"不安\", \"from\": [\"S09-1\"], \"at\": 0},\n        {\"text\": \"甚至连和他待着，对方也会觉得不自在\", \"accent\": \"不自在\", \"emotion\": \"不安\", \"from\": [\"S09-1\"], \"at\": 8},\n        {\"text\": \"他一下安静下来，不敢再往远处想\", \"accent\": \"不敢再往远处想\", \"emotion\": \"悬着\", \"from\": [\"S09-2\"], \"at\": 16},\n        {\"text\": \"可对方一直没退开，两人眼下仍亲近\", \"accent\": \"仍亲近\", \"emotion\": \"安心\", \"from\": [\"S09-3\"], \"at\": 24},\n        {\"text\": \"想到对方也许喜欢他在身边，他又有点高兴\", \"accent\": \"喜欢他在身边\", \"emotion\": \"欢喜\", \"from\": [\"S09-3\"], \"at\": 28}\n      ],\n      \"small\": [\n        {\"text\": \"像话说到要紧处突然顿住，呼吸也停了\", \"after\": 2, \"from\": [\"S09-B1\"], \"bars\": \"72–77\", \"at\": 3},\n        {\"text\": \"强烈的渴望还在，只是暂时没有说出来\", \"after\": 2, \"from\": [\"S09-B1\"], \"bars\": \"72–77\", \"at\": 5},\n        {\"text\": \"像阳光被薄雾柔化，光还在却隔着一层\", \"after\": 2, \"from\": [\"S09-B2\"], \"bars\": \"72–77\", \"at\": 11},\n        {\"text\": \"像在听自己刚才说过的话，迟迟不接下一句\", \"after\": 2, \"from\": [\"S09-B3\"], \"bars\": \"72–77\", \"at\": 18},\n        {\"text\": \"心里还在问：刚才是真的吗？接下来怎么办？\", \"after\": 2, \"from\": [\"S09-B3\"], \"bars\": \"72–77\", \"at\": 20},\n        {\"text\": \"激动说了许多后，他忽然抬头看见夜空\", \"after\": 2, \"from\": [\"S09-B4\"], \"bars\": \"72–77\", \"at\": 26},\n        {\"text\": \"不安还没答案，却暂时不再占满心思\", \"after\": 3, \"from\": [\"S09-B4\"], \"bars\": \"72–77\", \"at\": 28}\n      ],\n      \"notes\": [\n        {\"text\": \"72–75小节前冲的势头突然收住\", \"from\": [\"S09-B1\"], \"pt\": \"\", \"bars\": \"72–75\"},\n        {\"text\": \"76–77小节颤音和轻柔和弦悬在半空\", \"from\": [\"S09-B1\"], \"pt\": \"\", \"bars\": \"76–77\"},\n        {\"text\": \"声音一层层下沉变暗，像阳光隔着薄雾\", \"from\": [\"S09-B2\"], \"pt\": \"\", \"bars\": \"72–77\"}\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\"text\": \"他不想再猜下去，决定先好好享受眼前的亲近\", \"accent\": \"享受眼前的亲近\", \"emotion\": \"安心\", \"from\": [\"S10-1\"], \"at\": 0},\n        {\"text\": \"刚才绷紧的心慢慢松开，亮堂得让他想笑\", \"accent\": \"慢慢松开\", \"emotion\": \"欢喜\", \"from\": [\"S10-2\"], \"at\": 8},\n        {\"text\": \"那股轻松又涌出眼泪，他也有点想哭\", \"accent\": \"有点想哭\", \"emotion\": \"欢喜\", \"from\": [\"S10-2\"], \"at\": 16}\n      ],\n      \"small\": [\n        {\"text\": \"心事没有解决，这一刻只是不用再控制感受\", \"after\": 1, \"from\": [\"S10-B1\"], \"bars\": \"78–83\", \"at\": 3},\n        {\"text\": \"时间像忽然松开，旋律里短暂有一块空地\", \"after\": 0, \"from\": [\"S10-B2\"], \"bars\": \"78–83\", \"at\": 5},\n        {\"text\": \"那只是一口气，不是能一直躲进去的地方\", \"after\": 0, \"from\": [\"S10-B2\"], \"bars\": \"78–83\", \"at\": 8},\n        {\"text\": \"身体像失去重量，灵魂飘在夏夜微风里\", \"after\": 1, \"from\": [\"S10-B3\"], \"bars\": \"78–83\", \"at\": 11},\n        {\"text\": \"高音细亮得像银色蛛丝，又像飘下的细雨\", \"after\": 1, \"from\": [\"S10-B4\"], \"bars\": \"78–83\", \"at\": 17},\n        {\"text\": \"一串琶音像飞瀑从高处倾泻，清亮地落进水里\", \"after\": 2, \"from\": [\"S10-B4\"], \"bars\": \"80–83\", \"at\": 20}\n      ],\n      \"notes\": [\n        {\"text\": \"原先持续前行的摇荡，像被一阵清风拨开\", \"from\": [\"S10-B2\"], \"pt\": \"\", \"bars\": \"78–83\"},\n        {\"text\": \"右手高音区织出极细极亮的小音符\", \"from\": [\"S10-B4\"], \"pt\": \"\", \"bars\": \"78–83\"},\n        {\"text\": \"80–83小节一串琶音像飞瀑倾泻入水\", \"from\": [\"S10-B4\"], \"pt\": \"\", \"bars\": \"80–83\"}\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\"text\": \"他忽然想到，自己确实需要对方\", \"accent\": \"需要对方\", \"emotion\": \"亲密\", \"from\": [\"S11-1\"], \"at\": 0},\n        {\"text\": \"对方有时也需要他陪，他愿意一直在身边\", \"accent\": \"也需要他陪\", \"emotion\": \"安心\", \"from\": [\"S11-1\"], \"at\": 7},\n        {\"text\": \"就算对方不需要，他也愿意陪着\", \"accent\": \"也愿意陪着\", \"emotion\": \"亲密\", \"from\": [\"S11-1\"], \"at\": 14},\n        {\"text\": \"他高兴得顾不上害臊，觉得在乎没什么不好\", \"accent\": \"没什么不好\", \"emotion\": \"欢喜\", \"from\": [\"S11-2\"], \"at\": 21},\n        {\"text\": \"可想到以后未必还能亲近，欢喜又压得心口发疼\", \"accent\": \"心口发疼\", \"emotion\": \"不安\", \"from\": [\"S11-3\"], \"at\": 28}\n      ],\n      \"small\": [\n        {\"text\": \"像终于说出口：这是我的感情，我不再为它道歉\", \"after\": 1, \"from\": [\"S11-B1\"], \"bars\": \"84–92\", \"at\": 3},\n        {\"text\": \"开头那份唱出便收弱的谨慎，这回不见了\", \"after\": 1, \"from\": [\"S11-B1\"], \"bars\": \"84–92\", \"at\": 6},\n        {\"text\": \"这次像接住了第32小节没能落定的期待\", \"after\": 3, \"from\": [\"S11-B2\"], \"bars\": \"约92\", \"at\": 15},\n        {\"text\": \"这还不是全曲的结束\", \"after\": 3, \"from\": [\"S11-B2\"], \"bars\": \"约92\", \"at\": 17},\n        {\"text\": \"像夕阳沉下前烧得血红金亮，亮得让人想哭\", \"after\": 4, \"from\": [\"S11-B3\"], \"bars\": \"84–92\", \"at\": 23},\n        {\"text\": \"像多年后重回旧房子，家具没变，自己知道得更多\", \"after\": 4, \"from\": [\"S11-B4\"], \"bars\": \"84–92\", \"at\": 31}\n      ],\n      \"notes\": [\n        {\"text\": \"第84小节同一首歌重新出现，变得直接而现实\", \"from\": [\"S11-B1\"], \"pt\": \"\", \"bars\": \"84–92\"},\n        {\"text\": \"厚重和弦托起歌声，左手水波翻成跨八度的浪\", \"from\": [\"S11-B1\"], \"pt\": \"\", \"bars\": \"84–92\"},\n        {\"text\": \"第92小节力量短暂悬起，像等待下一股浪潮\", \"from\": [\"S11-B2\"], \"pt\": \"\", \"bars\": \"约92\"},\n        {\"text\": \"这次悬置的期待得到满足，但乐曲还未结束\", \"from\": [\"S11-B2\"], \"pt\": \"\", \"bars\": \"约92\"}\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\"text\": \"他顾不上对方是不是也在乎，只想把能给的都给对方\", \"accent\": \"把能给的都给对方\", \"emotion\": \"亲密\", \"from\": [\"S12-1\"], \"at\": 0},\n        {\"text\": \"他希望对方安心，还想多陪对方一会儿\", \"accent\": \"多陪对方一会儿\", \"emotion\": \"安心\", \"from\": [\"S12-1\", \"S12-2\"], \"at\": 9},\n        {\"text\": \"明知用心也保证不了以后，他还是嫌眼下相处不够\", \"accent\": \"相处不够\", \"emotion\": \"不安\", \"from\": [\"S12-2\"], \"at\": 18},\n        {\"text\": \"那阵高兴终于整个涌出来，他不再逼自己收着\", \"accent\": \"不再逼自己收着\", \"emotion\": \"炽热\", \"from\": [\"S12-3\"], \"at\": 27}\n      ],\n      \"small\": [\n        {\"text\": \"私语仿佛扩成天地间的共振\", \"after\": 0, \"from\": [\"S12-B1\"], \"bars\": \"93–102\", \"at\": 4},\n        {\"text\": \"整个人像被卷进更大的世界，连自己都暂时退到后面\", \"after\": 0, \"from\": [\"S12-B1\"], \"bars\": \"93–102\", \"at\": 6},\n        {\"text\": \"这份狂喜像高烧一样涌上来\", \"after\": 3, \"from\": [\"S12-B2\"], \"bars\": \"93–102\", \"at\": 13},\n        {\"text\": \"久别重逢时紧紧抱住对方，久久不愿松手\", \"after\": 3, \"from\": [\"S12-B2\"], \"bars\": \"93–102\", \"at\": 17},\n        {\"text\": \"快乐到分不清自己想笑还是想哭\", \"after\": 3, \"from\": [\"S12-B2\"], \"bars\": \"93–102\", \"at\": 23},\n        {\"text\": \"旋律一次次往上伸，像还想再要多一点\", \"after\": 2, \"from\": [\"S12-B3\"], \"bars\": \"93–102\", \"at\": 30}\n      ],\n      \"notes\": [\n        {\"text\": \"93–102小节，原先温柔晴朗的歌被放大\", \"from\": [\"S12-B1\"], \"pt\": \"\", \"bars\": \"93–102\"},\n        {\"text\": \"内声部彼此拉扯，声音一浪高过一浪\", \"from\": [\"S12-B1\"], \"pt\": \"\", \"bars\": \"93–102\"},\n        {\"text\": \"96–100小节乐句末端仍牵扯、延迟、紧张\", \"from\": [\"S12-B3\"], \"pt\": \"\", \"bars\": \"96–100\"},\n        {\"text\": \"102–103小节交界，那口气才得到重大释放\", \"from\": [\"S12-B3\"], \"pt\": \"\", \"bars\": \"102–103\"}\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\"text\": \"他更想听对方说，以后也会一直这样\", \"accent\": \"一直这样\", \"emotion\": \"悬着\", \"from\": [\"S13-1\"], \"at\": 0},\n        {\"text\": \"越喜欢和对方待着，他越觉得时间过得快\", \"accent\": \"时间过得快\", \"emotion\": \"欢喜\", \"from\": [\"S13-1\"], \"at\": 8},\n        {\"text\": \"起初怕自己太需要，如今怕对方不再需要他\", \"accent\": \"对方不再需要他\", \"emotion\": \"不安\", \"from\": [\"S13-2\"], \"at\": 16},\n        {\"text\": \"他甚至想少露些心意，也许就能少疼一点\", \"accent\": \"少疼一点\", \"emotion\": \"不安\", \"from\": [\"S13-2\"], \"at\": 24},\n        {\"text\": \"他早已装不回不在乎，真要藏起心意反而更难受\", \"accent\": \"反而更难受\", \"emotion\": \"炽热\", \"from\": [\"S13-3\"], \"at\": 32}\n      ],\n      \"small\": [\n        {\"text\": \"幸福没有消失，悲伤却慢慢进到幸福里面\", \"after\": 1, \"from\": [\"S13-B2\"], \"bars\": \"103–110\", \"at\": 5},\n        {\"text\": \"像终于握住珍贵的东西，才发现这一刻留不住\", \"after\": 1, \"from\": [\"S13-B2\"], \"bars\": \"103–110\", \"at\": 12},\n        {\"text\": \"刚坚定地说了声“是”，心里马上冒出“可是呢？”\", \"after\": 2, \"from\": [\"S13-B3\"], \"bars\": \"103–110\", \"at\": 20},\n        {\"text\": \"他刚才想对对方好，也是自己真心想做的\", \"after\": 4, \"from\": [\"S13-3\"], \"bars\": \"\", \"at\": 28},\n        {\"text\": \"脚步像钉在地上，上面的声音却一再往下沉\", \"after\": 4, \"from\": [\"S13-B4\"], \"bars\": \"103–110\", \"at\": 35}\n      ],\n      \"notes\": [\n        {\"text\": \"103小节愿望像终于说出口，音乐却继续反复渐强\", \"from\": [\"S13-B1\"], \"pt\": \"\", \"bars\": \"103–110\"},\n        {\"text\": \"106小节后越绷越紧，像怕停下就会失去刚得到的东西\", \"from\": [\"S13-B1\"], \"pt\": \"\", \"bars\": \"106–110\"},\n        {\"text\": \"107小节后明亮声里渐渐掺进尖锐、暗沉的成分\", \"from\": [\"S13-B2\"], \"pt\": \"\", \"bars\": \"107–110\"},\n        {\"text\": \"下方脚步像钉住地面，上方声部一再往下落\", \"from\": [\"S13-B4\"], \"pt\": \"\", \"bars\": \"103–110\"}\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\"text\": \"最初他连喜欢都不敢多露，如今已让对方看见\", \"accent\": \"已让对方看见\", \"emotion\": \"安心\", \"from\": [\"S14-1\"], \"at\": 0},\n        {\"text\": \"两人还亲近，他心里又甜又酸，却不后悔\", \"accent\": \"又甜又酸\", \"emotion\": \"欢喜\", \"from\": [\"S14-1\"], \"at\": 7},\n        {\"text\": \"他仍舍不得，也不知道以后会怎样\", \"accent\": \"仍舍不得\", \"emotion\": \"悬着\", \"from\": [\"S14-2\"], \"at\": 14},\n        {\"text\": \"他不再逼自己讨一句永远不变的保证\", \"accent\": \"不再逼自己\", \"emotion\": \"安心\", \"from\": [\"S14-2\"], \"at\": 21},\n        {\"text\": \"既然喜欢已让对方看见，他就不往回藏\", \"accent\": \"不往回藏\", \"emotion\": \"炽热\", \"from\": [\"S14-3\"], \"at\": 28},\n        {\"text\": \"往后怎样，等真的到了那时再说\", \"accent\": \"再说\", \"emotion\": \"安心\", \"from\": [\"S14-3\"], \"at\": 31}\n      ],\n      \"small\": [\n        {\"text\": \"像从一场美梦醒来，心里还记得梦里的光\", \"after\": 1, \"from\": [\"S14-B1\"], \"bars\": \"111–115\", \"at\": 4},\n        {\"text\": \"像经历一阵震荡后，站起来整理衣服，关上门\", \"after\": 4, \"from\": [\"S14-B3\"], \"bars\": \"116\", \"at\": 17}\n      ],\n      \"notes\": [\n        {\"text\": \"110–111小节交界最后一股浪头猛推，终结句才松下来\", \"from\": [\"S14-B1\"], \"pt\": \"\", \"bars\": \"110–115\"},\n        {\"text\": \"第113小节内声部像男中音，熟悉歌唱和摇荡又回来\", \"from\": [\"S14-B2\"], \"pt\": \"\", \"bars\": \"113–115\"},\n        {\"text\": \"第115小节右手细碎琶音像水花溅向夜空\", \"from\": [\"S14-B2\"], \"pt\": \"\", \"bars\": \"115\"},\n        {\"text\": \"第116小节最后几下和弦干脆沉重，低音像铁锚落水\", \"from\": [\"S14-B3\"], \"pt\": \"\", \"bars\": \"116\"},\n        {\"text\": \"尾声像隔空回应开头，最后和弦接住那句悬着的话\", \"from\": [\"S14-B4\"], \"pt\": \"\", \"bars\": \"113–116\"}\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "9e26358f-84bd-4ac5-819e-45780b1d7802", "session_revi