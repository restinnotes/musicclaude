      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S06",
    "bars": "148–180",
    "relation": "没在想",
    "items": [
     {
      "id": "S06-1",
      "text": "安静下来时，他不必再逼自己证明什么，压着的愿望和想念便慢慢浮上来。",
      "key": "安静下来时，他不",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1"
      ]
     },
     {
      "id": "S06-2",
      "text": "原本含蓄的感受慢慢展开，却没有变成一个明确结果；他只是让它们在心里自然起伏。",
      "key": "原本含蓄的感受慢",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1"
      ]
     },
     {
      "id": "S06-3",
      "text": "他知道旧日生活已经不能照样回来，暂时不再逼自己把它重新抓住，只珍惜还留在心里的温度。",
      "key": "他知道旧日生活已",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1",
       "S06-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S05-1",
      "to": "S06-1",
      "rel": "引用"
     },
     {
      "from": "S06-1",
