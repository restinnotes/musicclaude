   // import CountUp  from 'countup.js';
// import 'waypoints/lib/noframework.waypoints';

document.querySelectorAll('.js-count-up').forEach(element => {
  const { start, end, decimals, duration } = element.dataset;
  const countUp = new CountUp(element, start, end, decimals, duration, element.dataset);

  new Waypoint({
    element,
    handler: direction => {
      if (direction === 'down') {
        countUp.start();
      }
    },
    offset: '600px'
  });
});

</script><script type="text/javascript" src="/ResourcePackages/AutoCare/assets/scripts/modal.js"></script><script type="text/javascript" src="/ResourcePackages/AutoCare/assets/scripts/sponsor-rotate.js"></script><script type="text/javascript" src="/Scripts/clipboard.min.js"></script> </body></html>
