      "N16"
     ]
    }
   ],
   "relation_votes": {
    "正在面对": 5,
    "还说不清": 1
   },
   "relation_model": "正在面对",
   "items_before_reorg": [
    {
     "id": "N11",
     "text": "尝过亲近的幸福后，他开始盼这份喜欢能延续，不只属于眼前。",
     "from": [
      "I11"
     ],
     "key": "",
     "kind": "",
     "follows": false
    },
    {
     "id": "N12",
     "text": "一想到长久，他就想到：自己能珍惜对方，却决定不了对方是否也把自己放在心上。",
     "from": [
      "I12"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N13",
     "text": "从前觉得无需确认的事，如今竟开始牵动他的心。",
     "from": [
      "I13"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N14",
     "text": "他没打算索取什么，只是偶尔想知道，自己对对方是否也很特别。",
     "from": [
      "I14"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N15",
     "text": "期待只多了一点，原先的安稳就松动了。",
     "from": [
      "I15"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N16",
     "text": "他有些意外：明明已经觉得满足了，怎么还是会盼着更多？",
     "from": [
      "I16"
     ],
     "key": "",
     "kind": "满足照出未满足",
     "follows": true
    }
   ]
  },
  {
   "bars": "24–34",
   "relation": "正在面对",
   "items": [
    {
     "id": "R15",
     "text": "他不愿让新添的紧张毁掉好不容易得来的快乐；对方没答应过什么，他也不想把喜欢变成催促。",
     "from": [
      "N16",
      "N17"
     ],
     "key": "不让期待变成催促",
     "kind": "",
     "follows": false
    },
    {
     "id": "R16",
     "text": "于是他提醒自己：关心、给予、真心替对方高兴，本来就是快乐，不必每次换来表示或保证。",
     "from": [
      "N17",
      "N18",
      "N19"
     ],
     "key": "给予本身就是快乐",
     "kind": "",
     "follows": true
    },
    {
     "id": "R17",
     "text": "这样想真的让他轻松下来；想确认的紧张渐渐退去，他反而更愿意付出，也不再计算给了多少。",
     "from": [
      "N20",
      "N21"
     ],
     "key": "放下计较",
     "kind": "",
     "follows": true
    },
    {
     "id": "R18",
     "text": "多给一点，也不再让他怕自己显得更在乎；尽情对一个人好，心里反而更丰盈。",
     "from": [
      "N21",
      "N22"
     ],
     "key": "慷慨带来丰盈",
     "kind": "",
     "follows": true
    },
    {
     "id": "R19",
     "text": "那阵子他甚至相信，只要不提出要求，就能尽情去爱，也不会失去什么。",
     "from": [
      "N22",
      "N23"
     ],
     "key": "以为无所求就不会受伤",
     "kind": "",
     "follows": true
    }
   ],
   "because": [
    {
     "from": "R14",
     "to": "R15",
     "rel": "提供理由",
     "audit": "支持",
     "old": [
      "N15",
      "N17"
     ]
    }
   ],
   "items_before_fix": [
    {
     "id": "I17",
     "text": "他不愿让新添的紧张破坏先前得来的快乐，也不想把喜欢变成无形的催促。",
     "key": "不愿快乐被紧张破坏",
     "kind": ""
    },
    {
     "id": "I18",
     "text": "他提醒自己，关心、给予并由衷为对方高兴，本身就是真实的快乐。",
     "key": "给予本身就是快乐",
     "kind": "",
     "follows": true
    },
    {
     "id": "I19",
     "text": "这样想让他轻松下来，也更愿意付出，不再小心衡量心意的多少。",
     "key": "轻松后更愿付出",
     "kind": "",
     "follows": true
    },
    {
     "id": "I20",
     "text": "他不再担心多给一点会显得自己更加在乎，反而为这种热切感到幸福。",
     "key": "不再担心给得更多",
     "kind": "",
     "follows": true
    },
    {
     "id": "I21",
     "text": "那一阵，他甚至相信，只要不提出要求，就能尽情地爱而不失去什么。",
     "key": "无要求便能尽情爱",
     "kind": "",
     "follows": true
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对",
   "items_before_reorg": [
    {
     "id": "N17",
     "text": "他怕新添的紧张毁掉好不容易得来的快乐；何况对方从没答应过什么。",
     "from": [
      "I17"
     ],
     "key": "",
     "kind": "",
     "follows": false
    },
    {
     "id": "N18",
     "text": "于是他提醒自己：关心对方、愿意给予、真心替对方高兴，本来就是快乐。",
     "from": [
      "I18"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N19",
     "text": "珍惜一个人，不必每次都换来对方的表示或一句保证；他试着把心放宽。",
     "from": [
      "I18b"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N20",
     "text": "这样想真的让他松下来，先前那股想确认对方心意的紧张渐渐退去。",
     "from": [
      "I19"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N21",
     "text": "轻松些后，他更愿意付出，也不再一笔笔计算自己给了多少。",
     "from": [
      "I19b"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N22",
     "text": "多给一点不再让他怕自己显得更在乎；尽情地对一个人好，反而让心里丰盈。",
     "from": [
      "I20"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N23",
     "text": "那阵子他相信，亲近可以不伤人：只要不提要求，就能尽情去爱，也不会失去什么。",
     "from": [
      "I21",
      "I21b"
     ],
     "key": "",
     "kind": "",
     "follows": true
    }
   ]
  },
  {
   "bars": "35–39",
   "relation": "还说不清",
   "items": [
    {
     "id": "R20",
     "text": "可欢喜稍稍平息，他还是想知道：对方有没有也把他放在心上。",
     "from": [
      "N23",
      "N24"
     ],
     "key": "期待重新浮现",
     "kind": "",
     "follows": false
    },
    {
     "id": "R21",
     "text": "刚为无所求而高兴，转眼又盼着被看见；他因此难堪，也怀疑体贴里是否藏着未承认的期待。",
     "from": [
      "N24",
      "N25",
      "N26"
     ],
     "key": "难堪与自我怀疑",
     "kind": "",
     "follows": true
    },
    {
     "id": "R22",
     "text": "说自己毫无所求并不诚实，可先前的快乐也确实不是为了换取回应。",
     "from": [
      "N27"
     ],
     "key": "承认快乐与期待并存",
     "kind": "",
     "follows": true
    },
    {
     "id": "R23",
     "text": "他暂且留在这份不自在里，不替自己辩解，也不急着用新的热烈盖过去。",
     "from": [
      "N28"
     ],
     "key": "暂时不替自己辩解",
     "kind": "",
     "follows": true
    }
   ],
   "because": [
