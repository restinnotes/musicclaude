{"completed": true, "response": "```json\n{\n  \"segments\": [\n    {\n      \"segment\": \"S01\",\n      \"links\": [\n        {\n          \"thread_quote\": \"开头的和弦突然亮起来\",\n          \"bead\": \"S01/B1\",\n          \"bead_quote\": \"开头那两下响亮的和弦，有一点突然\",\n          \"type\": \"承接\",\n          \"note\": \"确立开场的突然性，为后面的光点与悬而未落提供起点。\"\n        },\n        {\n          \"thread_quote\": \"那不是毫无来由的激动。\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"一件已经想了很久的事\",\n          \"type\": \"承接\",\n          \"note\": \"用早已积累的心事解释开场的激动并非无因。\"\n        },\n        {\n          \"thread_quote\": \"心里早就有了答案，正因为知道自己想说什么\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"你并不是不知道自己想说什么\",\n          \"type\": \"承接\",\n          \"note\": \"把犹豫的原因放在说话者已经明确的内心意图上。\"\n        },\n        {\n          \"thread_quote\": \"两下响亮的声音迸开，光点似的余音慢慢落下\",\n          \"bead\": \"S01/B1\",\n          \"bead_quote\": \"细碎的光点再缓缓飘落\",\n          \"type\": \"承接\",\n          \"note\": \"把和弦的爆发与余音的下落写成同一个连续动作。\"\n        },\n        {\n          \"thread_quote\": \"眼前的一切还会不会像现在这样？\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"有些话一旦说出来，关系就会改变\",\n          \"type\": \"承接\",\n          \"note\": \"将害怕关系改变具体化为对眼前亲近能否维持的疑问。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S02\",\n      \"links\": [\n        {\n          \"thread_quote\": \"水波重新托住身体。\",\n          \"bead\": \"S01/B3\",\n          \"bead_quote\": \"刚刚踏上船板的感觉\",\n          \"type\": \"回指\",\n          \"note\": \"将开头刚踏上船板的短暂失重重新带入身体被水托住的状态。\"\n        },\n        {\n          \"thread_quote\": \"水波重新托住身体。\",\n          \"bead\": \"S02/B2\",\n          \"bead_quote\": \"把身体交给船底温柔的托举\",\n          \"type\": \"承接\",\n          \"note\": \"让水波从摇晃的背景变成身体放松的直接依托。\"\n        },\n        {\n          \"thread_quote\": \"仿佛两个人已经亲近到不必时时确认彼此\",\n          \"bead\": \"S02/B1\",\n          \"bead_quote\": \"沉默也不让人