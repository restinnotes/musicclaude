        "心里亮堂得想笑"
       ],
       "from": [
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "胸腔一下打开，眼泪终于不用憋着",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他不再藏喜欢；彼此或许需要，即使单向也愿陪。",
