: \"可、心又悬了起来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"像是从另一面重新看见了同一扇门\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"同一扇门\"\n        },\n        {\n          \"quote\": \"最初的问题又浮上来，却没有因此得到一个简单的答案\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他分不清是舍不得亲近\",\n          \"point\": \"舍不得亲近，还是怕孤单到愿再受气\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"分不清是、还是\"\n        },\n        {\n          \"text\": \"这个念头让他心慌\",\n          \"point\": \"连往下想都不敢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"连\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"fine\": [\n        {\n          \"quote\": \"明明知道它很重要，却已经没有力气把它重新讲述一遍\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"声音回来了，却没有完整铺开\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不再只是尚未开始时的茫然，而是历经许多之后，仍未能获得彻底答案的疲惫\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他最舍不得的\",\n          \"point\": \"曾被当作自己人的日子\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"最、曾\"\n        },\n        {\n          \"text\": \"可受过的委屈不能抹掉\",\n          \"point\": \"受过的委屈不能抹掉，回去也未必还能如旧\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"也未必\"\n        },\n        {\n          \"text\": \"他翻来覆去想得很累\",\n          \"point\": \"眼