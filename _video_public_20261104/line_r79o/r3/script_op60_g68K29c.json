 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近这个人，心里一下热起来",
       "keys": [
        "心里一下热起来"
       ],
       "from": [
        "S01-1"
       ]
