     ]
    },
    {
     "from": "R56",
     "to": "R59",
     "rel": "提供理由",
     "audit": "支持",
     "old": [
      "N67",
      "N70"
     ]
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对",
   "items_before_reorg": [
    {
     "id": "N68",
     "text": "幸福还鲜明着，他就察觉：心里仍有一块地方没有着落。",
     "from": [
      "I65"
     ],
     "key": "",
     "kind": "",
     "follows": false
    },
    {
     "id": "N69",
     "text": "他能尽情拥有自己的深情，却不能靠这份深情换来对方同样的选择。",
     "from": [
      "I66"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N70",
     "text": "刚才的欢喜越真实，眼下的酸楚就越难忽略。",
     "from": [
      "I67"
     ],
     "key": "",
     "kind": "满足照出未满足",
     "follows": true
    },
    {
     "id": "N71",
     "text": "他已知道自己爱得多深，再也不能轻易说对方怎样选择都无所谓。",
     "from": [
      "I68"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N72",
     "text": "他不想把安稳全交给对方，更不愿让对方负责消除自己所有的不安。",
     "from": [
      "I69"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N73",
     "text": "也不肯因为害怕落空，就故意削弱那些曾给他巨大幸福的感情。",
     "from": [
      "I70"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N74",
     "text": "克制曾让他安心，却没让渴望消失；尽情投入也曾让他幸福，却不能保证他不失望。",
     "from": [
      "I71",
      "I72"
     ],
     "key": "",
     "kind": "办法的限度",
     "follows": true
    },
    {
     "id": "N75",
     "text": "他依然迫切想靠近，也坚持不勉强对方；两股心思都不肯退。",
     "from": [
      "I73"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N76",
     "text": "如今他更看清两者的冲突，反而觉得更难，因为两边都已舍不得否认。",
     "from": [
      "I74"
     ],
     "key": "",
     "kind": "知道更多反而更尖锐",
     "follows": true
    },
    {
     "id": "N77",
     "text": "他不愿为求轻松就草草丢掉一边，宁可不舒服，也不拿自欺换平静。",
     "from": [
      "I75"
     ],
     "key": "",
     "kind": "",
     "follows": true
    }
   ]
  },
  {
   "bars": "111–116",
   "relation": "正在面对",
   "items": [
    {
     "id": "R65",
     "text": "带着仍未平息的牵挂，他不再逼自己找一种绝不会受伤的爱法。",
     "from": [
      "N77",
      "N78"
     ],
     "key": "放下寻找无风险的爱法",
     "kind": "",
     "follows": false
    },
    {
     "id": "R66",
     "text": "他仍盼被对方选择，因为这个人重要，他真心想和对方彼此亲近，即使未必如愿。",
     "from": [
      "N79"
     ],
     "key": "想被重要的人选择",
     "kind": "",
     "follows": true
    },
    {
     "id": "R67",
     "text": "他知道对方有自己的心意，不必和他一样；若为求安心就要对方接住全部期待，亲近反会失去自在。",
     "from": [
      "N80",
      "N81"
     ],
     "key": "给对方保留自由",
     "kind": "",
     "follows": true
    },
    {
     "id": "R68",
     "text": "他终于明白，遗憾不必先消失才能好好喜欢；收住和尽情投入，也都不能替他免去风险。",
     "from": [
      "N81",
      "N82",
      "N85"
     ],
     "key": "不必先消除遗憾",
     "kind": "",
     "follows": true
    },
    {
     "id": "R69",
     "text": "小心靠近、不求确认地付出、独自珍藏，以及尽情欢喜，都曾给他真切的快乐。",
     "from": [
      "N83"
     ],
     "key": "过去的快乐都是真的",
     "kind": "",
     "follows": true
    },
    {
     "id": "R70",
     "text": "它们没解开最后的问题，却没白费：让他一次次愿意向前，也看清这个人有多重要。",
     "from": [
      "N83",
      "N84"
     ],
     "key": "快乐让他继续向前",
     "kind": "",
     "follows": true
    },
    {
     "id": "R71",
     "text": "没人能保证以后不失望；他仍盼回应、还会想要更多，也会因不能更近而疼。",
     "from": [
      "N85",
      "N86",
      "N87"
     ],
     "key": "承认未来仍有风险",
     "kind": "",
     "follows": true
    },
    {
     "id": "R72",
     "text": "他不拿对方的选择判定真心，也不拿克制证明清醒；更不让这些疼痛成为否认感情或催促对方的理由。",
     "from": [
      "N86",
      "N88"
     ],
     "key": "不以回应衡量真心",
     "kind": "",
     "follows": true
    },
    {
     "id": "R73",
     "text": "他愿继续认真喜欢、充分欢喜；想被爱，却不把渴望变成对方的义务，也不为保护彼此先放弃爱。",
     "from": [
