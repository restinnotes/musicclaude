{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"船歌那种稳定的摇荡感还没有真正成形\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"摇荡尚未成形\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越清楚越谨慎\"\n        },\n        {\n          \"quote\": \"还拿不准，下次自己能不能更坦白些\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"下次能否更坦白\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"忽然\"\n        },\n        {\n          \"text\": \"怕让对方为难\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"中\",\n          \"waste\": \"还不敢坦白\",\n          \"keep\": \"怕让对方为难\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"像一根温柔的刺\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"温柔的小刺\"\n        },\n        {\n          \"quote\": \"水却一直在流，时间也一直在走\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"水还在流\"\n        },\n        {\n          \"quote\": \"裹在皮肤上有些黏稠\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"慢慢放松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"才慢慢放松\"\n        },\n        {\n          \"text\": \"他也想靠近些\",\n          \"point\": \"喜欢得几乎藏不住\",\n    