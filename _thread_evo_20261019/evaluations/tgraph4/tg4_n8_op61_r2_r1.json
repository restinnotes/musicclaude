     "to": "I110",
     "rel": "唤起"
    },
    {
     "from": "I84",
     "to": "I111",
     "rel": "提供理由"
    },
    {
     "from": "I94",
     "to": "I109",
     "rel": "说明"
    },
    {
     "from": "I105",
     "to": "I114",
     "rel": "改写"
    }
   ]
  },
  {
   "bars": "226–241",
   "relation": "正在面对",
   "items": [
    {
     "id": "I115",
     "text": "他凭这点尚不牢靠的心意重新想办法。",
     "key": "重新想办法",
     "kind": ""
    },
    {
     "id": "I116",
     "text": "他不愿简单否定任何一种已有的收获。",
     "key": "简单否定",
     "kind": ""
    },
    {
     "id": "I117",
     "text": "他觉得恐怕无法让两份珍惜都毫发无伤。",
     "key": "毫发无伤",
     "kind": ""
    },
    {
     "id": "I118",
     "text": "他发觉为所爱争取可能再次失去安宁。",
     "key": "再次失去安宁",
     "kind": "选择的代价"
    },
    {
     "id": "I119",
     "text": "他渐渐不再把难受归咎于自己不够坚强。",
     "key": "不够坚强",
     "kind": ""
    },
    {
     "id": "I120",
     "text": "他承认这一点后仍不轻松。",
     "key": "仍不轻松",
     "kind": ""
    },
    {
     "id": "I121",
     "text": "他想到仍得付出，还是心疼。",
     "key": "还是心疼",
     "kind": ""
    },
    {
     "id": "I122",
     "text": "他仍希望有条不那么艰难的路。",
     "key": "不那么艰难",
     "kind": ""
    },
    {
     "id": "I123",
     "text": "他明白继续等待不会让那条路自己出现。",
     "key": "继续等待",
     "kind": ""
    },
    {
     "id": "I124",
     "text": "他也知道不去争取，心爱的东西未必留得住。",
     "key": "未必留得住",
     "kind": ""
    },
    {
     "id": "I125",
     "text": "他不再要求自己先变得毫不害怕。",
     "key": "毫不害怕",
     "kind": ""
    },
    {
     "id": "I126",
     "text": "他允许自己舍不得、没把握也能承担。",
     "key": "没把握",
     "kind": ""
    },
    {
     "id": "I127",
     "text": "他也允许自己在承担中受苦。",
     "key": "承担中受苦",
     "kind": ""
    },
    {
     "id": "I128",
     "text": "他一点点重新聚起力量。",
     "key": "重新聚起",
     "kind": ""
    },
    {
     "id": "I129",
     "text": "他愿意带着不舍向前。",
     "key": "带着不舍",
     "kind": ""
    },
    {
     "id": "I130",
     "text": "他临近真正承担时，反而更清楚自己仍然会怕。",
     "key": "仍然会怕",
     "kind": ""
    },
    {
     "id": "I131",
     "text": "他不想再让惧怕替他决定。",
     "key": "惧怕替他决定",
     "kind": ""
    }
   ],
   "because": [
