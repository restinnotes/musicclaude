   ]
  },
  {
   "sec": "S14",
   "rows": [
    {
     "kind": "line",
     "text": "最初他连喜欢都不敢多露，如今两人还亲近",
     "keys": [
      "如今两人还亲近"
     ],
     "emotion": "亲密",
     "from": [
      "S14-1"
     ]
    },
    {
     "kind": "line",
     "text": "心里又甜又酸，他还是舍不得，却并不后悔",
     "keys": [
      "又甜又酸"
     ],
     "emotion": "欢喜",
     "from": [
      "S14-1"
     ],
     "at": 8.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像从美梦醒来，身体平静，心里还留着光",
       "bead": "S14-B1",
       "from": [
        "S14-B1"
       ],
       "bars": "111–115",
       "at": 4.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "他仍不知道以后怎样，却不再逼自己要永远不变的保证",
