 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他觉得眼下有件事重得不能轻慢，盼着心里能有个着落，却始终安定不下来",
       "keys": [
        "始终安定不下来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "强撑着提醒自己不能倒下，可心里其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "一阵失落刚浮上来，他还没弄清它究竟指向什么，心思便又散开",
       "keys": [
        "心思便又散开"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "连合适的说法也找不到",
       "keys": [],
       "from": [
        "S01-2"
       ],
       "bead": "S01-2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他一时连自己该把心放在哪里都拿不准，身体也微微绷紧，觉得自己比平日更容易受伤",
       "keys": [
        "比平日更容易受伤"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉中醒来，四周又冷又空，胸口发紧、伸手只摸到空处",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "旧日那种熟悉的感觉忽然清楚了一瞬",
       "keys": [
        "忽然清楚了一瞬"
       ],
       "from": [
        "S01-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他随即想到它已不能原样回来，而自己连维持端正都显得有些吃力",
       "keys": [
        "已不能原样回来"
       ],
       "from": [
        "S01-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子还没想清楚，身体先隐约记起了怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他渐渐想起，自己真正放不下的",
       "keys": [
        "真正放不下的"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "是从前待在那种生活里时，不必时时确认自己有没有位置的轻松",
       "keys": [
        "不必时时确认自己有没有位置的轻松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他仍尽量把日子过得有条理，心里却时常发虚，连不让难过露出来都要费上好些力气",
       "keys": [
        "连不让难过露出来都要费上好些力气"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像腿脚发虚的人，还在记忆里勉强挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像整理好衣服抬起头，不让人看出自己动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚觉得自己把心收住了，怀念又翻上来，焦急反而积了起来",
       "keys": [
        "焦急反而积了起来"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "呼吸像被催着一样，变得越来越急促",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "一遍遍对自己说没事，说到后来反倒露出了自己有多在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他不甘心把失去那个位置当成自己就不再重要的证明，也不愿把自己看轻",
       "keys": [
        "不愿把自己看轻"
       ],
       "from": [
        "S02-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "哪怕心里还在难受，也不甘心就这样垮下去",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他还是不服眼下的处境，心里一阵恼、一阵急，却找不到这股劲该往哪里去",
       "keys": [
        "找不到这股劲该往哪里去"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "从前那种不用防备、自然亲近的感觉忽然回来了，今昔的距离也清楚起来",
       "keys": [
        "今昔的距离也清楚起来"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "短短一会儿，他几乎又能轻松地待在那份熟悉里",
       "keys": [],
       "from": [
        "S03-2"
       ],
       "bead": "S03-2"
      },
      {
       "text": "像回到故乡夏日的麦浪与微风里，温和又轻快",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "许多念头挤在一起，他顾不上分清，反而被那点温暖占满",
       "keys": [
        "被那点温暖占满"
       ],
       "from": [
        "S03-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像出去走走换个心情，轻松是真的，心结却还没解开",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "耳边像有人低声絮语，脚下像踩着流沙抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他又觉得自己先前那股笃定没有想象中牢靠",
       "keys": [
        "没有想象中牢靠"
       ],
       "from": [
        "S03-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "我刚才是真信那些话，还是在勉强自己去信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "那份曾被自然接纳的暖意仍是真的，也舍不得把它说成不值一提",
       "keys": [
        "舍不得把它说成不值一提"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "表面还撑着从前坚定的样子，心却比以前更容易受伤了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "温暖很快又变成刺痛，最后只剩疲惫和想退开的念头",
       "keys": [
        "温暖很快又变成刺痛"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他想把自己稳住，里面却越来越紧",
       "keys": [],
       "from": [
        "S04-2"
       ],
       "bead": "S04-2"
      },
      {
       "text": "过去太好又回不去才最刺痛，像在拉扯中疲惫地步步后退",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他觉得自己连片刻都难以安歇，连自己的节奏也顾不上",
       "keys": [
        "连片刻都难以安歇"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "仿佛总得赶着把心里的事理出头绪",
       "keys": [],
       "from": [
        "S04-3"
       ],
       "bead": "S04-3"
      },
      {
       "text": "像急促的脚步和乱了拍的心跳，被催着往前跑停不下来",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他反复想当初究竟从哪里开始变了，始终没有答案",
       "keys": [
        "始终没有答案"
       ],
       "from": [
        "S04-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子里还在问怎么会变成这样，不停往前赶只是不敢停下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "可他不愿因此认定，今天的自己就不值得被接纳",
       "keys": [
        "不愿因此认定"
       ],
       "from": [
        "S04-4"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他仍珍惜从前那份亲近，却只肯把它安静地留在心里，不想把最柔软的地方轻易摊开",
       "keys": [
        "安静地留在心里"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "让他惦记的像是某个人，又像是故乡或从前的日子",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "想到眼下的处境，他又有些不甘：失去从前的位置，凭什么就要连自己也看轻？",
       "keys": [
        "凭什么就要连自己也看轻"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里还憋着那股护住自己的劲：这件事不能就这么算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他不再拿过去是否接纳自己来衡量今天，可这样守着自己时，心里的难受反倒显得无处安放",
       "keys": [
        "心里的难受反倒显得无处安放"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像脚下的地板忽然空了，只剩一个声音在自言自语",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "不安又渐渐涨起来，他不肯退让的那股劲却已疲惫",
       "keys": [
        "那股劲却已疲惫"
       ],
       "from": [
        "S05-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像长叹一口气松了下来，其实还没想通，只是争累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "等紧绷稍稍松开，旧日的温暖又浮到了心上",
       "keys": [
        "旧日的温暖又浮到了心上"
       ],
       "from": [
        "S05-4"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他心里忽然安静下来，不必时时防着自己露出难过，也不必硬撑着显得坚强",
       "keys": [
        "不必硬撑着显得坚强"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "世界像被透明玻璃罩隔开，像听着母亲哼摇篮曲，连呼吸都放轻",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "平日压着的委屈和想念慢慢浮出来",
       "keys": [
        "委屈和想念慢慢浮出来"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他仍盼着有一天能自然地属于某处，却不知道这份愿望会不会有着落",
       "keys": [
        "自然地属于某处"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像对着远方真切地祈求，却不知道会不会有回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "后来这份心思渐渐清楚、充实，连想被接纳的愿望也变得迫切，却仍没有得到答案",
       "keys": [
        "想被接纳的愿望也变得迫切"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "起初他只敢承认自己还在想念",
       "keys": [],
       "from": [
        "S06-3"
       ],
       "bead": "S06-3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他也有一刻觉得，那些曾经珍贵、如今不能照旧拥有的东西，不必硬求它们重新回来",
       "keys": [
        "不必硬求它们重新回来"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "远去的家园像在梦里被照亮，虽然回不去，却远远看见了它",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "明知有些珍惜的事挽不回，便静静看着，不再急着抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有的安静忽然被一阵惊惧打断，他先感到紧张，连自己为什么一下子不安都来不及弄明白",
       "keys": [
        "被一阵惊惧打断"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像寒风猛地吹开窗把人从好梦里拽醒，后颈一凉、脉搏乱跳",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "心思一下子变得活跃，原先那点安宁不在了，可他并没有因此轻快起来",
       "keys": [
        "并没有因此轻快起来"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚才的思绪一下被打断，换了副热闹步子心里却安定不下来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
