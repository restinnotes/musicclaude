[\n        {\n          \"quote\": \"光线仿佛从暖金色的水面滑入古桥阴影，空气一下凉了\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是哭泣或崩溃，只是不再努力显得完整\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不再努力显得完整\"\n        },\n        {\n          \"quote\": \"即使是最亲密的人，也没法陪你走进心里的每一个角落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方看出他有多在乎\",\n          \"point\": \"仍像从前一样亲近\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"看出他有多在乎，却仍像从前一样\"\n        },\n        {\n          \"text\": \"两人安静相处时，他想靠近\",\n          \"point\": \"这让他有点孤单\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"对方不知道他怕被嫌弃\"\n        },\n        {\n          \"text\": \"他又想，对方会不会也舍不得\",\n          \"point\": \"也舍不得失去这样的相处\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又；也\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"原先压着的感受反而变成了动力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"压着的感受变成动力\"\n        },\n        {\n          \"quote\": \"你明知道自己正在被卷进去，却暂时不想出来\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"越舒服，反而越让人失去方向\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方总愿意陪他\",\n          \"point\": \"或许也被需要\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"k