       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他再心动，也不愿只凭这点指望，回去过从前那种忍让的日子。",
       "keys": [
        "再心动",
        "从前那种忍让的日子"
       ],
       "from": [
        "S11-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "回不回去再说，先把眼下过稳些，也许更踏实。",
       "keys": [
        "先把眼下过稳些",
        "也许更踏实"
       ],
       "from": [
        "S11-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他怕以后独自扛难事，心里没底；这回不想因害怕收回打算。",
       "keys": [
        "心里没底",
        "这回不想因害怕收回打算"
       ],
       "from": [
        "S11-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "听来，害怕还在",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      },
      {
       "text": "脚却已经往前走了",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想，当初那些气不该忍，和那些人在一起也确实开心过；这回不逼自己选边。",
       "keys": [
        "当初那些气不该忍",
        "不逼自己选边"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "这份挺立也可以听成经历动摇后的主动选择：犹疑、疲惫、想念都在，仍决定怎样站立；不必假装从未受过伤。",
       "keys": [
        "经历动摇后的主动选择",
        "不必假装从未受过伤"
       ],
