   },
   "relation_model": "没在想",
   "items_before_trim": [
    {
     "id": "I16",
     "text": "因为已经认真投入过，他反而能从原先反复自问里稍稍松开。",
     "key": "投入后稍松反复自问",
     "kind": "",
     "key_model": "从反复自问中松开"
    },
    {
     "id": "I17",
     "text": "他发现自己不只有沉重和责任，也会因不再畏缩而高兴。",
     "key": "发现不畏缩也会高兴",
     "kind": "",
     "follows": true,
