  {
   "bars": "111–116",
   "relation": "正在面对",
   "items": [
    {
     "id": "I150",
     "text": "他不再要求找到一种不会受伤的爱法。",
     "key": "不会受伤的爱法",
     "kind": ""
    },
    {
     "id": "I151",
     "text": "他仍然想被对方选择。",
     "key": "被对方选择",
     "kind": ""
    },
    {
     "id": "I152",
     "text": "他知道这愿望并非虚荣，源自想要彼此亲近。",
     "key": "并非虚荣",
     "kind": ""
    },
    {
     "id": "I153",
     "text": "即使未必如愿，他也不再假装没有愿望。",
     "key": "假装没有愿望",
     "kind": ""
    },
    {
     "id": "I154",
     "text": "他知道对方有自由作出与他不同的选择。",
     "key": "不同的选择",
     "kind": ""
    },
    {
     "id": "I155",
     "text": "他知道强求对方背负全部期待，会让亲近不再自在。",
     "key": "亲近不再自在",
     "kind": "选择的代价"
    },
    {
     "id": "I156",
     "text": "他仍会遗憾，却不再要求先消除遗憾。",
     "key": "先消除遗憾",
     "kind": ""
    },
    {
     "id": "I157",
     "text": "他认为疑问未解也不会使曾有的快乐白费。",
     "key": "快乐白费",
     "kind": "分清"
    },
    {
     "id": "I158",
     "text": "他甚至更加珍惜此前的快乐。",
     "key": "更加珍惜",
     "kind": ""
    },
    {
     "id": "I159",
     "text": "他从一再愿意靠近中看出对方有多重要。",
     "key": "一再愿意靠近",
     "kind": ""
    },
    {
     "id": "I160",
     "text": "他不再用有无回应判定自己的真心。",
     "key": "判定自己的真心",
     "kind": "分清"
    },
    {
     "id": "I161",
     "text": "他不再用保留多少证明自己清醒。",
     "key": "证明自己清醒",
     "kind": "分清"
    },
    {
     "id": "I162",
     "text": "他知道以后还会想要更多。",
     "key": "想要更多",
     "kind": ""
    },
    {
     "id": "I163",
     "text": "他知道无法更近一步时仍会疼痛。",
     "key": "仍会疼痛",
     "kind": ""
    },
    {
     "id": "I164",
     "text": "他不再因可能受伤而否认感情。",
     "key": "否认感情",
     "kind": ""
    },
    {
     "id": "I165",
     "text": "他也不借这份疼痛催促对方。",
     "key": "催促对方",
     "kind": ""
    },
    {
     "id": "I166",
     "text": "他愿继续认真地喜欢，充分地欢喜。",
     "key": "充分地欢喜",
     "kind": ""
    },
    {
     "id": "I167",
     "text": "他也愿承受自己无法决定的部分。",
     "key": "无法决定的部分",
     "kind": ""
    },
    {
     "id": "I168",
     "text": "他容许自己渴望被爱，却不将愿望变成对方的义务。",
     "key": "对方的义务",
     "kind": ""
    },
    {
     "id": "I169",
     "text": "他珍惜对方的自由，也不为此收回心意。",
     "key": "收回心意",
     "kind": ""
    },
    {
     "id": "I170",
     "text": "他虽未得到想要的一切，也不再为了守住彼此而先放弃最想给予的爱。",
     "key": "最想给予的爱",
     "kind": ""
    }
   ],
