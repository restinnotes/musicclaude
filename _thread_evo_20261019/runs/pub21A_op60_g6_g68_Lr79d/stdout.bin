{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"连自己也有点意外\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"细碎的光点再缓缓飘落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"还没有真正落稳，仿佛仍悬在水面上方\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"心里一下热了起来\"\n        },\n        {\n          \"text\": \"怕让对方为难\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"怕让对方为难\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"像一根温柔的刺\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"温柔的\"\n        },\n        {\n          \"quote\": \"因为太喜欢眼前的东西，所以还没有失去，就已经生出一丝舍不得\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"太喜欢眼前\"\n        },\n        {\n          \"quote\": \"没有把心事彻底说死\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"慢慢放松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没有退开\"\n        },\n        {\n          \"text\": \"他也想靠近些\",\n          \"point\": \"喜欢得几乎藏不住\",\n          \"where\": \"后\",\n     