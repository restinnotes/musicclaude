{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然想靠近对方\",\n          \"accent\": \"想靠近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他怕给对方负担，只敢露一点喜欢\",\n          \"accent\": \"给对方负担\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"这点亲近很甜，他还不知下次敢不敢坦白\",\n          \"accent\": \"还不知下次\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-3\"],\n          \"at\": 8\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"烟花光点悬在水面，脚下一瞬失重\",\n          \"after\": 0,\n          \"from\": [\"S01-B1\", \"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 2\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"开头两下和弦突然响起，船歌摇荡还没成形\",\n          \"from\": [\"S01-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没因他的在意退开，他才渐渐放松\",\n          \"accent\": \"渐渐放松\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想再靠近，却怕太急弄坏眼下的自在\",\n          \"accent\": \"怕太急\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"两人待得越好，他越先想到时光会过去\",\n          \"accent\": \"时光会过去\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"两条声线贴近耳语，肩挨肩的呼吸像湿热的风\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约6–16\",\n          \"at\": 2\n        },\n        {\n          \"text\": \"脚下不必踩实，船底温柔托着身体\",\n          \"after\": 2,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"歌声忽然热切上涌，随后轻轻呼出一口气\",\n          \"after\": 1,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12–16\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"柔软落音像温柔的刺，甜得有点鼻酸\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"约7–11\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"左手一下一下摇着，歌声还没浮出来\",\n          \"from\": [\"S02-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"4–5\"\n        },\n        {\n          \"text\": \"歌声忽然上涌，随后轻轻收回\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"12–16\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他暂时不想两个人的以后，只想舒服地待在亲近里\",\n          \"accent\": \"舒服地待在亲近里\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想说喜欢、问对方是否一样，念头却淡了\",\n          \"accent\": \"念头却淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 7\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"歌声退远后身体仍在，心却舒服地漂远\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 2\n        },\n        {\n          \"text\": \"急着表达的念头露一下头，很快沉回去\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"约20–21\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"水下暗流拖住对话，风把倒影吹碎\",\n          \"after\": 0,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17–23\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声退后有短促声音冒出，几处音符迟迟不落\",\n          \"from\": [\"S03-B1\", \"S03-B2\", \"S03-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"17–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又回来，他想起上次没能开口\",\n          \"accent\": \"熟悉的亲近\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想把藏着的话说完，盼对方喜欢也盼这份好久些\",\n          \"accent\": \"把藏着的话说完\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"可他怕说太多让对方为难，最后还是留了些话\",\n          \"accent\": \"怕说太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"两道声线贴耳低语，这一遍更华丽\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"高处金光刺眼，像话到喉咙口发颤\",\n          \"after\": 1,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"约30–34\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"手越握越紧，船里反倒更难平衡\",\n          \"after\": 2,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"美好还在，心里已舍不得这一刻过去\",\n          \"after\": 2,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\",\n          \"at\": 29\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉歌声重来后花腔渐密，高处颤音收弱而摇晃放慢\",\n          \"from\": [\"S04-B1\", \"S04-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"24–34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他没藏住喜欢，对方看出他在乎\",\n          \"accent\": \"看出他在乎\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他怕太黏，对方会退开\",\n          \"accent\": \"怕太黏\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-3\"],\n          \"at\": 4\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"心里空落落，熟悉亲近像隔了一层\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"音乐像松开手，轻轻呼气\",\n          \"after\": 1,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"35–39\",\n          \"at\": 10\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"丰满伴奏忽然抽走，贴近的声线也断开\",\n          \"from\": [\"S05-B1\", \"S05-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他多在乎，跟他相处却没变\",\n          \"accent\": \"相处却没变\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他重新自在，仍怕自己要得太多\",\n          \"accent\": \"怕自己要得太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他有点孤单，想知道对方是否也舍不得\",\n          \"accent\": \"有点孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\", \"S06-3\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"暖金水面滑进古桥阴影，空气转凉\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 2\n        },\n        {\n          \"text\": \"心里说算了，转眼又放不下\",\n          \"after\": 1,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"回家独处，白天的好忽然成了回忆\",\n          \"after\": 2,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"气味、身体感觉、幻想、遗憾和快感混在一起\",\n          \"after\": 1,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 26\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"左手波浪变薄，新旋律清澈而旁边声线插话\",\n          \"from\": [\"S06-B1\", \"S06-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"40–50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他觉得，对方或许也需要他陪着才安心\",\n          \"accent\": \"需要他陪着才安心\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到彼此能依靠，他高兴又心头一紧\",\n          \"accent\": \"高兴\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"他盼着对方以后还会想起自己\",\n          \"accent\": \"以后还会想起自己\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\"],\n          \"at\": 22\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"安静已不够，情欲与眷恋推着身体往前\",\n          \"after\": 1,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"气味、身体感觉、幻想和遗憾混成快感\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"明知被卷进去，暂时不想出来\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"美还在，完美的一刻也留不住\",\n          \"after\": 2,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏音符变密，内声部上涌而低音催促\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"这回他想主动些，大方回应对方\",\n          \"accent\": \"大方回应\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他开始盼着两人能这样好很久\",\n          \"accent\": \"好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"可他心里没底，往后未必还能这样亲近\",\n          \"accent\": \"心里没底\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"歌声像咏叹调般舒展，毫无防备\",\n          \"after\": 0,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"阳光和风回来，身体有弹性也像在调情\",\n          \"after\": 0,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"快乐余温还在，心头已泛起怀念\",\n          \"after\": 2,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\",\n          \"at\": 23\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旋律舒展上扬，随后向上散开并戛然而止\",\n          \"from\": [\"S08-B1\", \"S08-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"62–71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他怕对方有天不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他一下安静下来，怕对方连陪着都不自在\",\n          \"accent\": \"一下安静下来\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\", \"S09-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"对方没退开，也许喜欢他陪着\",\n          \"accent\": \"也许喜欢他陪着\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-3\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"阳光隔着薄雾，四周并未全暗\",\n          \"after\": 0,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"听着自己的余响，问刚才是真的吗、接下来呢\",\n          \"after\": 1,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"美好比愿望大，夜空让不安暂时退开\",\n          \"after\": 2,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 22\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"前面的势头忽然收住，颤音和和弦悬停\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"72–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他先不猜以后，好好享受眼前亲近\",\n          \"accent\": \"享受眼前亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他紧绷的心松开了，亮得想笑也想哭\",\n          \"accent\": \"亮得想笑也想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 7\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"肩膀终于松开，眼泪也不必再忍\",\n          \"after\": 0,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"清风拨开水波，时间松出一小块空地\",\n          \"after\": 0,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"身体轻得像灵魂飘在夏夜微风里\",\n          \"after\": 1,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\",\n          \"at\": 16\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高音区细亮音符织开，琶音随后倾泻而下\",\n          \"from\": [\"S10-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"78–83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他承认需要对方，不藏喜欢也不为它道歉\",\n          \"accent\": \"不为它道歉\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\", \"S11-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"即使对方未必需要，他仍愿意陪着\",\n          \"accent\": \"仍愿意陪着\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\", \"S11-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"他知道未来由不得自己定，想到亲近会结束就疼\",\n          \"accent\": \"由不得自己定\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-3\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"先前没抵达的期待，这里像终于回应\",\n          \"after\": 1,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"约92\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"夕阳烧成血红金亮，刺眼得让胸口疼\",\n          \"after\": 1,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"多年后走进旧房子，熟悉温柔有新重量\",\n          \"after\": 2,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 25\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"厚和弦托起歌声，左手巨浪铺开后短暂悬住\",\n          \"from\": [\"S11-B1\", \"S11-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"84–92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他只想把能给的都给对方，让对方安心\",\n          \"accent\": \"让对方安心\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他知道留不住以后，还是想多陪一会儿\",\n          \"accent\": \"多陪一会儿\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"高兴终于涌出来，他不再收着喜欢\",\n          \"accent\": \"不再收着喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-3\"],\n          \"at\": 17\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像被卷进更大的世界，连自己都退到后面\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"94–102\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"快乐像高烧，重逢时抱紧对方舍不得松手\",\n          \"after\": 2,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"歌声一再上扬，像还想要更多却无法满足\",\n          \"after\": 2,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"96–100\",\n          \"at\": 26\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌声开阔而内声部拉扯，乐句末端迟迟不落后释放\",\n          \"from\": [\"S12-B1\", \"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"94–103\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"他想听对方说以后不变，时间却飞快过去\",\n          \"accent\": \"以后不变\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他怕对方哪天不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他想少露些心意，可往回藏更难受\",\n          \"accent\": \"往回藏更难受\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\", \"S13-3\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"刚到浪峰，身后又有更大的浪推来\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"明亮里掺进暗沉，幸福里也有悲伤\",\n          \"after\": 0,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"刚说了是又冒出可是，正因相信才疼\",\n          \"after\": 1,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"脚步踩得很稳，胸口却一再往下沉\",\n          \"after\": 1,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\",\n          \"at\": 26\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"乐句反复渐强，下方脚步稳住而上方声音下落\",\n          \"from\": [\"S13-B1\", \"S13-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"103–110\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"从前他不敢露喜欢，如今亲近也不后悔\",\n          \"accent\": \"不后悔\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他仍舍不得，往后等到了再说\",\n          \"accent\": \"往后等到了再说\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-2\", \"S14-3\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他不再逼自己讨永远的保证，也不藏喜欢\",\n          \"accent\": \"不再逼自己\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S14-2\", \"S14-3\"],\n          \"at\": 15\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像美梦醒来，心仍温热而身体平静\",\n          \"after\": 0,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111–115\",\n          \"at\": 2\n        },\n        {\n          \"text\": \"像男中音独自沉思\",\n          \"after\": 1,\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113–115\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"最后和弦像铁锚落水，像关门离开\",\n          \"after\": 2,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"尾声回应开头，接完悬着的话\",\n          \"after\": 2,\n          \"from\": [\"S14-B4\"],\n          \"bars\": \"113–116\",\n          \"at\": 23\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"左手内声部低低唱出一句，右手细碎琶音闪过\",\n          \"from\": [\"S14-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"113–115\"\n        },\n        {\n          \"text\": \"最后几下和弦干脆沉重，低音落定\",\n          \"from\": [\"S14-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"116\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "77f52710-de4d-44c0-8687-a43