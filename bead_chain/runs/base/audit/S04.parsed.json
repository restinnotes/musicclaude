{
 "segment": "S04",
 "experiences": [
  {
   "id": "E1",
   "measures": "mm.24–34",
   "dimensions": [
    "感官质地",
    "时间与变化"
   ],
   "what": "第1主题重现，熟悉的歌不再照原样重复：双音声响更丰满、明亮，花腔与装饰更繁密，声音层次显得被放大。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gpt56w-web-r1",
     "quote": "它更华丽、更充实，也更迫切。",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt6w-web-2",
     "quote": "熟悉的旋律回来，比初次出现时更丰满、更有装饰。",
     "quote_verified": true
    },
    {
     "src": "SRC-gflash-web-3",
     "quote": "这个主题带着更密集的装饰音和双颤音再次出现",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E2",
   "measures": "mm.24–34",
   "dimensions": [
    "情绪色调",
    "时间与变化",
    "感官质地"
   ],
   "what": "重唱的情绪由有分寸的温柔逐渐转亮、转热、转急；增加的光彩不是纯炫技或无忧的喜悦，已经隐约带着难以自抑的颤动。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gflash-int-2",
     "quote": "情感从最初克制的倾诉，逐渐变成难以自抑的轻微颤动。",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt6w-web-3",
     "quote": "它更灵动、更灿烂，也更急切。",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt56w-int-2",
     "quote": "原来那种从容越来越维持不住。",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E3",
   "measures": "mm.24–30",
   "dimensions": [
    "动因与心理",
    "人物与关系",
    "时间与变化"
   ],
   "what": "一种“说过仍嫌不够”的复述：因事情珍贵、情意太深，想把同样的话重新解释、换说法、补添细节；繁复音符变成言语的增量。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gpt56w-int-3",
     "quote": "人在真正动情以后，会开始反复解释。",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt56w-int-3",
     "quote": "第二遍又觉得还不够准确，于是换一种方式再说。",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt56w-int-2",
     "quote": "开始补充越来越多细节。",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E4",
   "measures": "mm.24–34",
   "dimensions": [
    "动因与心理",
    "情绪色调",
    "时间与变化"
   ],
   "what": "另一条完整听法是独自重新回味已经经历的幸福：重现像把刚才的好时光在记忆中重放、描画得更美，并想让那刻稍微延长。不是确定的现场双人对话。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gpt6w-web-2",
     "quote": "人在回想一段刚刚经历的快乐时，会不自觉地把它想得更加美好。",
     "quote_verified": true
    },
    {
     "src": "SRC-luna-web-1",
     "quote": "一个人回想刚才的幸福，想把那一刻再留住一点。",
     "quote_verified": true
    },
    {
     "src": "SRC-luna-web-3",
     "quote": "像同一段记忆被反复回想",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E5",
   "measures": "mm.24–34",
   "dimensions": [
    "动因与心理",
    "人物与关系",
    "时间与变化",
    "情绪色调"
   ],
   "what": "复述往事还可让旁听者发现：起初能微笑、说得体面，后来语速和细节失控；它并没有成为过去，叙述者仍深陷其中。这比单纯甜蜜回味多一层自我揭露。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gpt56w-int-2",
     "quote": "刚开始还能微笑着讲，讲着讲着语速变了",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt56w-int-2",
     "quote": "原来这件事根本没有过去。",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt56w-int-r1",
     "quote": "这很像人反复想起同一件事。",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E6",
   "measures": "mm.27–34",
   "dimensions": [
    "动因与心理",
    "人物与关系",
    "情绪色调"
   ],
   "what": "从满足于亲近，转成需要确证、要求对方回应，甚至希望这一刻能够持续；越珍惜越想获得保证，幸福开始给人施压。与“自己说不尽”不是同一个动因。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gpt56w-int-3",
     "quote": "我需要它回应我。",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt6w-web-1",
     "quote": "能不能让这件美好的事一直发生下去？",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt6w-int-2",
     "quote": "这是真的吧？这种幸福能不能再深一点？",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E7",
   "measures": "mm.24–34",
   "dimensions": [
    "情绪色调",
    "动因与心理",
    "时间与变化"
   ],
   "what": "表面仍唱得优雅漂亮、保持礼貌的克制，内在的在乎与冲动却越积越多；“看似从容”和“从容不住”同时存在，并非已经崩溃。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gpt56w-int-2",
     "quote": "外表仍然漂亮，内部却已经不完全平静。",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt56w-int-r1",
     "quote": "一方面想继续维持优雅、克制和完整；",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt56w-int-r1",
     "quote": "另一方面，感情本身却越来越想突破这种体面。",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E8",
   "measures": "mm.24–34",
   "dimensions": [
    "情绪色调",
    "动因与心理",
    "时间与变化"
   ],
   "what": "当下仍是甜美的、珍贵的，但也因意识到幸福会流逝而鼻酸、患得患失；痛不是已失去或被拒绝，而是美好尚在便预感它不能永久留住。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gpt56w-int-r1",
     "quote": "幸福过度浓缩以后产生的焦虑",
     "quote_verified": true
    },
    {
     "src": "SRC-gflash-int-2",
     "quote": "这么美的一刻，能持续多久呢？",
     "quote_verified": true
    },
    {
     "src": "SRC-gflash-web-1",
     "quote": "每一秒都在倒数。",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E9",
   "measures": "mm.24–34",
   "dimensions": [
    "人物与关系",
    "身体与动作",
    "情绪色调",
    "聆听与演奏差异"
   ],
   "what": "双音的相随可以听成两个贴得很近的人相互应答、呼吸同频；主题再现时仿佛恋人的交谈渐入佳境，亲昵和微醺升温。这是可选的双人听法，不是谱面指定剧情。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gflash-web-3",
     "quote": "就像两个人的谈话渐入佳境，微醺的情意开始泛滥。",
     "quote_verified": true
    },
    {
     "src": "SRC-gflash-web-2",
     "quote": "并行的双音像两个人同步的呼吸与肢体触碰。",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E10",
   "measures": "mm.24–34",
   "dimensions": [
    "感官质地",
    "身体与动作",
    "场景与画面",
    "情绪色调"
   ],
   "what": "更贴近皮肤的、成熟的黄昏微醺：湿热微风与呼吸混成略黏稠的温存。它从前面的主题区延续至重唱，不能说从第24小节突然才出现。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gflash-int-3",
     "quote": "黄昏时的倦意和微醺感",
     "quote_verified": true
    },
    {
     "src": "SRC-gflash-int-3",
     "quote": "潮湿、温热的微风，裹在皮肤上甚至有些黏稠。",
     "quote_verified": true
    },
    {
     "src": "SRC-gflash-web-1",
     "quote": "成熟到近乎颓废",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E11",
   "measures": "mm.24–31",
   "dimensions": [
    "场景与画面",
    "感官质地",
    "时间与变化"
   ],
   "what": "装饰音不一定是多说话，也能是水面骤然碎开的星光、金色反光和飞溅水珠；光斑晃得耀眼，繁密颗粒直接构成视觉快感。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gflash-int-2",
     "quote": "仿佛水面折射的光斑突然晃得人睁不开眼",
     "quote_verified": true
    },
    {
     "src": "SRC-gflash-web-2",
     "quote": "如星光反射般细密的花腔",
     "quote_verified": true
    },
    {
     "src": "SRC-gflash-web-1",
     "quote": "装饰音如水珠飞溅",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E12",
   "measures": "mm.24–31",
   "dimensions": [
    "身体与动作",
    "感官质地",
    "场景与画面"
   ],
   "what": "与纯粹闪光不同，装饰可像船桨提起时水珠被拉成细长湿丝，沾着残阳慢慢滑落；重点是拉丝、湿度和下落的物理触感。",
   "validity": "plausible",
   "sources": [
    {
     "src": "SRC-gflash-int-3",
     "quote": "船桨提起时，水珠拉成细丝、在残阳下反光滑落的质感。",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E13",
   "measures": "mm.27–34",
   "dimensions": [
    "身体与动作",
    "人物与关系",
    "动因与心理",
    "时间与变化"
   ],
   "what": "身体上的索取由凝视、轻握变为伸手去抓、握得更紧，甚至想用力抱住眼前的人或这一刻；加大的感情有了手掌施力的形状。",
   "validity": "solid",
   "sources": [
    {
     "src": "SRC-gpt56w-int-3",
     "quote": "原本只是凝视，现在忍不住伸手去抓住对方。",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt6w-int-2",
     "quote": "后来不自觉地握得更紧。",
     "quote_verified": true
    },
    {
     "src": "SRC-gflash-int-3",
     "quote": "想要用力抱紧对方、牢牢抓住当下的冲动",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E14",
   "measures": "mm.32–34",
   "dimensions": [
    "身体与动作",
    "场景与画面",
    "动因与心理"
   ],
   "what": "一种有反作用的拥抱听法：越想用力抓紧，舟身越被晃得厉害，平衡越脆弱；珍惜本身反而制造失稳。此具体物理因果只有一稿明说。",
   "validity": "plausible",
   "sources": [
    {
     "src": "SRC-gflash-int-3",
     "quote": "你越用力，水面的颠簸就越剧烈",
     "quote_verified": true
    },
    {
     "src": "SRC-gflash-int-3",
     "quote": "船舱内的平衡就越脆弱。",
     "quote_verified": true
    }
   ],
   "in_segment": true
  },
  {
   "id": "E15",
   "measures": "mm.24–34",
   "dimensions": [
    "身体与动作",
    "感官质地",
    "情绪色调"
   ],
   "what": "持续的摇摆还有身体被托住的安慰：内心越躁动，底下规律的运动仍像柔软的承托，使人不至于一下坠落。这与高声部想停而低声部催走的对抗不同。",
   "validity": "plausible",
   "sources": [
    {
     "src": "SRC-gpt6w-int-1",
     "quote": "它像有人轻轻托着你",
     "quote_verified": true
    },
    {
     "src": "SRC-gpt6w-int-1",
     "quote": "即使情绪变得很强烈，你也不会立即坠落。",
     "quote_verified": true
