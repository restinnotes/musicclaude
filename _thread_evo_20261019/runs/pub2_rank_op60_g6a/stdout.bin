{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"groups\": [\n        {\n          \"label\": \"话到嘴边的紧张与谨慎\",\n          \"points\": [\"S01-B3-p2\", \"S01-B3-p1\"]\n        },\n        {\n          \"label\": \"刚刚踏入亲近，心还悬着，尚未安稳\",\n          \"points\": [\"S01-B2-p3\", \"S01-B2-p1\", \"S01-B1-p2\", \"S01-B1-p3\", \"S01-B1-p1\", \"S01-B1-p4\", \"S01-B2-p2\"]\n        }\n      ],\n      \"tier_a\": [\"S01-B3-p2\", \"S01-B2-p3\"],\n      \"tier_b\": [\"S01-B3-p1\", \"S01-B2-p1\", \"S01-B1-p2\", \"S01-B1-p3\", \"S01-B1-p1\"],\n      \"only_one\": \"S01-B3-p2\",\n      \"line_order\": [\"S01-1\", \"S01-2\", \"S01-3\"],\n      \"line_a\": [\"S01-1\"]\n    },\n    {\n      \"sec\": \"S02\",\n      \"groups\": [\n        {\n          \"label\": \"亲密贴近带来的温暖与安心\",\n          \"points\": [\"S02-B1-p1\", \"S02-B1-p2\", \"S02-B1-p3\", \"S02-B1-p4\"]\n        },\n        {\n          \"label\": \"甜蜜里已经有了舍不得的酸楚\",\n          \"points\": [\"S02-B4-p2\", \"S02-B4-p3\", \"S02-B4-p1\"]\n        },\n        {\n          \"label\": \"放下身体的控制，舒服地漂浮，却感觉时间仍在流逝\",\n          \"points\": [\"S02-B2-p2\", \"S02-B2-p3\", \"S02-B2-p1\"]\n        },\n        {\n          \"label\": \"感情一度涌上来，又重新收住\",\n          \"points\": [\"S02-B3-p1\", \"S02-B3-p2\", \"S02-B3-p3\"]\n        }\n      ],\n      \"tier_a\": [\"S02-B4-p2\", \"S02-B1-p1\"],\n      \"tier_b\": [\"S02-B1-p2\", \"S02-B1-p3\", \"S02-B4-p3\", \"S02-B2-p3\", \"S02-B3-p1\", \"S02-B3-p2\"],\n      \"only_one\": \"S02-B4-p2\",\n      \"line_order\": [\"S02-1\", \"S02-2\", \"S02-3\"],\n      \"line_a\": [\"S02-1\"]\n    },\n    {\n      \"sec\": \"S03\",\n      \"groups\": [\n        {\n          \"label\": \"沉浸在亲密后的安静里，舒服地漂浮、不急着去哪里\",\n          \"points\": [\"S03-B1-p3\", \"S03-B1-p1\", \"S03-B1-p4\", \"S03-B1-p2\"]\n        },\n        {\n          \"label\": \"想表达什么，却只是一闪而过的念头\",\n          \"points\": [\"S03-B2-p2\", \"S03-B2-p3\", \"S03-B2-p1\"]\n        },\n        {\n          \"label\": \"安静中出现牵绊，亲密里有些无法解开的结\",\n          \"points\": [\"S03-B3-p4\", \"S03-B3-p2\", \"S03-B3-p1\", \"S03-B3-p5\", \"S03-B3-p3\"]\n        }\n      ],\n      \"tier_a\": [\"S03-B1-p3\", \"S03-B3-p4\"],\n      \"tier_b\": [\"S03-B1-p1\", \"S03-B1-p4\", \"S03-B2-p2\", \"S03-B3-p2\", \"S03-B3-p5\", \"S03-B3-p1\"],\n      \"only_one\": \"S03-B1-p3\",\n      \"line_order\": [\"S03-1\", \"S03-2\"],\n      \"line_a\": [\"S03-1\"]\n    },\n    {\n      \"sec\": \"S04\",\n      \"groups\": [\n        {\n          \"label\": \"熟悉的亲密重新变得热烈，喜欢越来越藏不住\",\n          \"points\": [\"S04-B1-p3\", \"S04-B1-p6\", \"S04-B1-p5\", \"S04-B1-p4\", \"S04-B1-p2\", \"S04-B1-p1\"]\n        },\n        {\n          \"label\": \"想把最深的情意说出口，激动得颤抖，却没有真正落定\",\n          \"points\": [\"S04-B2-p2\", \"S04-B2-p1\", \"S04-B2-p3\", \"S04-B2-p4\"]\n        },\n        {\n          \"label\": \"想抓紧对方，身体先于意识暴露了害怕失去\",\n          \"points\": [\"S04-B3-p2\", \"S04-B3-p1\", \"S04-B3-p3\", \"S04-B3-p4\"]\n        },\n        {\n          \"label\": \"眼前越甜蜜，越舍不得时间过去\",\n          \"points\": [\"S04-B4-p3\", \"S04-B4-p2\", \"S04-B4-p4\", \"S04-B4-p1\"]\n        }\n      ],\n      \"tier_a\": [\"S04-B2-p2\", \"S04-B4-p3\"],\n      \"tier_b\": [\"S04-B1-p3\", \"S04-B1-p6\", \"S04-B2-p3\", \"S04-B3-p2\", \"S04-B3-p4\", \"S04-B4-p2\", \"S04-B4-p4\"],\n      \"only_one\": \"S04-B4-p3\",\n      \"line_order\": [\"S04-2\", \"S04-3\", \"S04-1\"],\n      \"line_a\": [\"S04-2\", \"S04-3\"]\n    },\n    {\n      \"sec\": \"S05\",\n      \"groups\": [\n        {\n          \"label\": \"终于松开了紧抓不放的手\",\n          \"points\": [\"S05-B1-p2\", \"S05-B1-p3\", \"S05-B1-p1\"]\n        },\n        {\n          \"label\": \"失去支撑，突然孤零零地漂在没有方向的地方\",\n          \"points\": [\"S05-B2-p2\", \"S05-B2-p3\", \"S05-B2-p4\", \"S05-B2-p1\"]\n        },\n        {\n          \"label\": \"两个人的亲密突然中断，跌回自己的内心，开始怀疑\",\n          \"points\": [\"S05-B3-p2\", \"S05-B3-p1\", \"S05-B3-p3\", \"S05-B3-p4\"]\n        }\n      ],\n      \"tier_a\": [\"S05-B3-p2\"],\n      \"tier_b\": [\"S05-B1-p3\", \"S05-B2-p2\", \"S05-B2-p3\", \"S05-B2-p4\", \"S05-B3-p1\", \"S05-B3-p3\"],\n      \"only_one\": \"S05-B3-p2\",\n      \"line_order\": [\"S05-1\", \"S05-2\", \"S05-3\"],\n      \"line_a\": [\"S05-1\"]\n    },\n    {\n      \"sec\": \"S06\",\n      \"groups\": [\n        {\n          \"label\": \"熟悉的摇摆变得清凉、轻薄，像进入陌生而安静的地方\",\n          \"points\": [\"S06-B1-p3\", \"S06-B1-p5\", \"S06-B1-p4\", \"S06-B1-p2\", \"S06-B1-p1\"]\n        },\n        {\n          \"label\": \"表面安静，心里的念头却反复回来、低声纠缠\",\n          \"points\": [\"S06-B2-p3\", \"S06-B2-p2\", \"S06-B2-p4\", \"S06-B2-p5\", \"S06-B2-p1\"]\n        },\n        {\n          \"label\": \"独处时涌出的孤单与酸楚，亲密也无法填满内心\",\n          \"points\": [\"S06-B3-p3\", \"S06-B3-p2\", \"S06-B3-p4\", \"S06-B3-p1\"]\n        },\n        {\n          \"label\": \"沉醉地回味一段关系，舒服却越来越失去方向\",\n          \"points\": [\"S06-B4-p2\", \"S06-B4-p3\", \"S06-B4-p1\"]\n        }\n      ],\n      \"tier_a\": [\"S06-B3-p3\"],\n      \"tier_b\": [\"S06-B3-p2\", \"S06-B3-p4\", \"S06-B2-p3\", \"S06-B1-p3\", \"S06-B4-p3\"],\n      \"only_one\": \"S06-B3-p3\",\n      \"line_order\": [\"S06-1\", \"S06-2\", \"S06-3\"],\n      \"line_a\": [\"S06-1\"]\n    },\n    {\n      \"sec\": \"S07\",\n      \"groups\": [\n        {\n          \"label\": \"被更深的渴望推动，热度从心底翻涌上来\",\n          \"points\": [\"S07-B1-p2\", \"S07-B1-p3\", \"S07-B1-p1\"]\n        },\n        {\n          \"label\": \"沉醉于亲密的快感，明知被卷进去却不想出来\",\n          \"points\": [\"S07-B2-p5\", \"S07-B2-p4\", \"S07-B2-p2\", \"S07-B2-p1\", \"S07-B2-p3\"]\n        },\n        {\n          \"label\": \"美好仍在，却已经感觉到时间无法停住\",\n          \"points\": [\"S07-B3-p3\", \"S07-B3-p1\", \"S07-B3-p2\"]\n        }\n      ],\n      \"tier_a\": [\"S07-B3-p3\", \"S07-B1-p2\"],\n      \"tier_b\": [\"S07-B2-p5\", \"S07-B2-p4\", \"S07-B3-p1\"],\n      \"only_one\": \"S07-B3-p3\",\n      \"line_order\": [\"S07-1\", \"S07-2\", \"S07-3\"],\n      \"line_a\": [\"S07-1\"]\n    },\n    {\n      \"sec\": \"S08\",\n      \"groups\": [\n        {\n          \"label\": \"放下防卫，明亮舒展地表达喜欢\",\n          \"points\": [\"S08-B1-p2\", \"S08-B1-p3\", \"S08-B1-p1\"]\n        },\n        {\n          \"label\": \"轻盈、活泼，带着调情与回应的欢喜\",\n          \"points\": [\"S08-B2-p1\", \"S08-B2-p2\", \"S08-B2-p3\"]\n        },\n        {\n          \"label\": \"快乐还留着余温，声音却突然消失，变成怀念\",\n          \"points\": [\"S08-B3-p3\", \"S08-B3-p2\", \"S08-B3-p1\"]\n        }\n      ],\n      \"tier_a\": [\"S08-B3-p3\"],\n      \"tier_b\": [\"S08-B1-p2\", \"S08-B1-p3\", \"S08-B2-p3\", \"S08-B3-p2\"],\n      \"only_one\": \"S08-B3-p3\",\n      \"line_order\": [\"S08-1\", \"S08-2\", \"S08-3\"],\n      \"line_a\": [\"S08-1\"]\n    },\n    {\n      \"sec\": \"S09\",\n      \"groups\": [\n        {\n          \"label\": \"渴望还在，却突然停住，紧绷地悬在半空\",\n          \"points\": [\"S09-B1-p4\", \"S09-B1-p1\", \"S09-B1-p2\", \"S09-B1-p3\"]\n        },\n        {\n          \"label\": \"明朗退去，心里笼罩着低气压与朦胧的不安\",\n          \"points\": [\"S09-B2-p1\", \"S09-B2-p2\"]\n        },\n        {\n          \"label\": \"反复听自己的心声，怀疑刚才的幸福，也不知道下一步怎么办\",\n          \"points\": [\"S09-B3-p3\", \"S09-B3-p4\", \"S09-B3-p2\", \"S09-B3-p1\"]\n        },\n        {\n          \"label\": \"暂时从自己的不安中抬起头，看见比愿望更大的美好\",\n          \"points\": [\"S09-B4-p2\", \"S09-B4-p1\"]\n        }\n      ],\n      \"tier_a\": [\"S09-B1-p4\", \"S09-B3-p3\"],\n      \"tier_b\": [\"S09-B2-p1\", \"S09-B3-p2\", \"S09-B4-p2\", \"S09-B1-p2\"],\n      \"only_one\": \"S09-B1-p4\",\n      \"line_order\": [\"S09-1\", \"S09-3\", \"S09-2\"],\n      \"line_a\": [\"S09-1\", \"S09-3\"]\n    },\n    {\n      \"sec\": \"S10\",\n      \"groups\": [\n        {\n          \"label\": \"终于松开紧绷，长长呼出一口气，明亮得让人想哭\",\n          \"points\": [\"S10-B1-p3\", \"S10-B1-p1\", \"S10-B1-p2\", \"S10-B1-p4\"]\n        },\n        {\n          \"label\": \"时间暂时停下来，获得一小块短暂的喘息空间\",\n          \"points\": [\"S10-B2-p2\", \"S10-B2-p3\", \"S10-B2-p1\"]\n        },\n        {\n          \"label\": \"身体失去重量，像从现实