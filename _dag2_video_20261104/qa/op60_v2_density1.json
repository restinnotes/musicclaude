    {
      "sec": "S05",
      "body_font": 28,
      "bead_nodes": [
        "S05-B1",
        "S05-B2",
        "S05-B3"
      ],
      "bead_edges": [
        {
          "a": "S05-B2",
          "b": "S05-B3",
          "type": "重叠但新增",
          "note": "两者都由原先丰富摇荡的声音突然收束而来。B1给出失去支撑的身体感，B2则给出亲密交谈突然中断、一些心事无法完全向对方表达的关系感。两种感受可以同时存在。"
        },
        {
          "a": "S05-B2",
          "b": "S05-B1",
          "type": "可同时成立",
          "note": "B1像原来的支撑被抽走，B3像自己松开了紧攥的手。虽然动作主体不同，却并不互斥：一个人可以同时感到声音失去依托，以及身体主动卸下力道。B3不是B1必须具备的心理原因。"
        },
        {
          "a": "S05-B3",
          "b": "S05-B1",
          "type": "可同时成立",
          "note": "谈话忽然停住、问题悬而未决，与松手换气可以同时被听到。但不能因此拼成同一人物‘因为怀疑幸福，所以决定松手’的连续剧情。"
        }
      ],
