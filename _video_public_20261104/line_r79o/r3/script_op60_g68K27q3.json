 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近对方，心里一下热了",
       "keys": [
        "心里一下热了"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚踏上小船，木板在脚下微晃",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "水波从脚下荡开，身体一瞬失重",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕自己的需要吓着对方，他只敢露出一点喜欢",
       "keys": [
        "一点喜欢"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "想了很久的话到了嘴边，他先沉默几秒",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "他知道说出口可能改变两人的关系",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "只靠近一点，他心里已经很甜",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      },
      {
       "text": "他还拿不准下次能否更坦白",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看见他的在意仍愿亲近，他才慢慢放松",
       "keys": [
        "慢慢放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像肩挨肩耳语，连呼吸都贴在一起",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "夏末潮湿温热的风裹着皮肤",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "相识已久，安静坐着也不紧张",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "对方偶尔望来一眼，也不必找话题",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想靠得更近，却怕太急弄坏眼下的自在",
       "keys": [
        "怕太急弄坏眼下的自在"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那阵喜欢几乎已经藏不住",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待得这么好，他还没分开就先舍不得",
       "keys": [
        "先舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "他想到这样的时刻总会过去",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "船底温柔托着人，脚下不必踩实",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "舒服地漂着，暂时不急着靠岸",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "水一直流，时间也一直走",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "甜蜜确认里藏着一点惆怅",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "眼前还好好的，心里已经有点鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他难得不去想以后，只想舒服地待在亲近里",
       "keys": [
        "舒服地待在亲近里"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波一阵阵托着身体，像在原地漂着",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "说过重要的话后，人还停在那句话里",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "有点陶醉，也有点走神",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "亲密交谈后的沉默，反而很舒服",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "身体还在这里，心却慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想说自己有多喜欢，也想问对方是否一样",
       "keys": [
        "有多喜欢"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "急着表达的念头只露了一下头",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "它很快又沉回心里",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "没想好怎么开口，念头就淡了",
       "keys": [
        "念头就淡了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "平稳的交谈像被水下暗流拖住",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "思绪像被风吹碎的倒影，闪烁难拼",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "谈话碰到解不开的结，亲近里有了阻力",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他欢喜，他想起上回没能开口",
