 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近对方，心里一下热起来，连自己都意外。",
       "keys": [
        "那么想靠近",
        "心里一下热起来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "怕对方觉得这份需要太重，他只敢露出一点喜欢；这点亲近虽甜，下次能否坦白些，他还没把握。",
       "keys": [
        "这份需要太重",
        "只敢露出一点喜欢"
       ],
       "from": [
        "S01-2",
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头两下和弦像夏夜烟花迸向高处，光点落下仍悬在水面上，船歌还没稳稳摇起来",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "像一句想了很久的话，到了嘴边先沉默几秒；一出口，关系可能就会改变",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "刚踏上船板，木板微晃，水波荡开，身体一瞬失重，还没安稳交给水浪",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他露出一点在意，对方仍愿意亲近，他这才慢慢放松。",
       "keys": [
        "仍愿意亲近",
        "慢慢放松"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "两条旋律贴耳低语，肩膀挨着肩膀，呼吸和体温都融在一起，像夏末潮热的风贴着皮肤",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "第4–5小节歌声还没浮出来，左手已像心跳和水浪，船底温柔地托着身体；水和时间却一直在流",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "几次柔软的落音像温柔的刺：眼前的好还在，心里却先有一点鼻酸，想让这一刻慢些",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠近些，喜欢得几乎藏不住，最后还是怕太急弄坏眼下的自在而收住了。",
       "keys": [
        "喜欢得几乎藏不住",
        "收住了"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "第12–14小节歌声忽然往上涌，像忍不住热切地说了几句；14–16小节又轻轻呼出一口气，回到柔和，心事没有说死",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待在一起这么好，他却想到这样的时刻终会过去，还没分开就先有一点舍不得。",
       "keys": [
        "这样的时刻终会过去",
        "先有一点舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不去想两个人以后会怎样，只想安心待在眼前这份亲近里。",
       "keys": [
        "不去想两个人以后会怎样",
        "安心待在眼前这份亲近里"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "水波托着身体轻轻漂着，暂时不知道要去哪里",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "像重要的话说完还留在余味里；亲密交谈后的沉默很舒服，身体在这里，心却慢慢漂远",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想告诉对方自己有多喜欢，也想问对方是否一样；没想好怎么开口，念头就淡了。",
       "keys": [
        "有多喜欢",
        "对方是否一样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "摇曳中忽然冒出几句短促急切的声音，像想说的话露头一下，很快又沉了回去",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "水波仍在晃，流动却像被水下暗流拖住；思绪像风吹碎的倒影，闪着却拼不完整，仿佛谈话碰到了解不开的结，顺畅里多了阻力",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "熟悉的亲近又让他欢喜，也让他想起上回明明想说，却没有开口。",
       "keys": [
        "熟悉的亲近",
        "没有开口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "这回他几乎想把藏着的喜欢全说出来，盼着对方接受不再小心收着的自己，也盼眼下的好能留久一点。",
       "keys": [
        "把藏着的喜欢全说出来",
        "眼下的好能留久一点"
       ],
       "from": [
        "S04-2",
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "原本轻轻握着的手不自觉收紧；越想抱牢当下，水面越颠簸，船舱里的平衡越脆弱",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "两道声线仍贴得很近，左手水波却一直向前，仿佛每一秒都在倒数；还没失去什么，就已经舍不得",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他怕说太多让对方为难，也怕两人原有的自在消失，最后还是留了些话没说。",
       "keys": [
        "让对方为难",
        "留了些话没说"
       ],
       "from": [
        "S04-4"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "几次想说又收住，对方仍一直亲近；这回他没藏好喜欢，对方终于看出他有多在乎。",
       "keys": [
        "没藏好喜欢",
        "看出他有多在乎"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "被看出来后，他再也装不成不在乎，一时不知怎么相处；怕对方嫌他太黏，熟悉的亲近也像隔了一层。",
       "keys": [
        "不知怎么相处",
        "嫌他太黏"
       ],
       "from": [
        "S05-2",
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "托着人的水波忽然被抽掉，只剩单薄旋律在雾里游走，脚下失去支撑，前路未卜",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "贴近耳语忽然断了，他从我与你跌回自己心里：这份幸福是真的吗？能维持多久",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "像终于松开攥紧的手，深深吸了一口气",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他有多在乎，却仍和从前一样亲近，他才重新自在下来。",
       "keys": [
        "仍和从前一样亲近",
        "重新自在下来"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "安静下来他仍想靠近，却怕自己要得太多；对方不知道他刚才怕被嫌弃，他有点孤单。",
       "keys": [
        "怕自己要得太多",
        "有点孤单"
       ],
       "from": [
        "S06-2",
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "低声旋律旁另一条声线不时回应、插话，又纠缠回来；心里刚说算了，又忍不住放不下，声音忽近忽远",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "白天和某个人相处得很好，独自回家时心头却泛酸；再亲密的人也走不进心里的每个角落，美好时光恍惚已像回忆",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      },
      {
       "text": "另一种听法，不是欲望退潮，而是更贴身的沉醉：气味、身体感觉、幻想、遗憾和快感像水波一层层荡开，舒服得让人失去方向",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想到对方一直没有退开，会不会也舍不得结束这份亲近？",
       "keys": [
        "一直没有退开",
        "舍不得结束这份亲近"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这些日子对方总愿意陪着他，他开始觉得，对方或许也需要这份陪伴。",
       "keys": [
        "总愿意陪着他",
        "或许也需要这份陪伴"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声再回来，清澈底下的暗涌却越来越不安分；伴奏变密，低音像沉重脉搏催着身体往前，情欲、执念和对生命的眷恋一齐翻上来",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "独自回想一段关系，气味、身体感觉、幻想、遗憾和快感混在一起；有一点情色的暖意，明知正被卷进去，却暂时不想出来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "想到两人也许能互相依靠，他高兴得有点收不住，心里却忽然一紧。",
       "keys": [
        "互相依靠",
        "忽然一紧"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他盼着以后对方想找人陪时还会想到自己，自己也能一直陪在身边。",
       "keys": [
        "还会想到自己",
        "一直陪在身边"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "美还在，音乐也没有彻底变暗，可他已经听见时间正在经过；这一刻再完美，也没有办法让它停住",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "对方见他无意露出心意后仍旧亲近，他想主动些，大大方方地回应。",
       "keys": [
        "仍旧亲近",
        "大大方方地回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旋律忽然直接舒展，像歌剧里的咏叹调；没有防卫和分析，歌句越唱越开，熟悉的摇荡轻轻催着往前",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "声音明亮、轻盈、透气，像重新碰到阳光和风；身体恢复弹性，带一点玩心和调情般的回应",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他连往后的日子都开始期待，觉得两个人或许还能这样好很久。",
       "keys": [
        "往后的日子",
        "好很久"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "第69–70小节歌声向上散开，没有踏实落定；约第71小节忽然停住，快乐的余温还在，心里却泛起怀念",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可眼下愿意亲近，不代表以后一定如此，他心里仍没底。",
       "keys": [
        "以后一定如此",
        "心里仍没底"
       ],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "那点没底越来越具体：哪天对方不再需要他陪，甚至觉得和他待着不自在呢？",
       "keys": [
        "不再需要他陪",
        "待着不自在呢"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "前面几乎冲出去的势头突然收住；第76–77小节颤音和轻柔和弦悬在半空，像对视到呼吸都停住，渴望还绷着，没有真正松开",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "明朗像隔了薄雾，声音一层层下沉、变暗，光还在，只是被柔化了",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      },
      {
       "text": "像在听自己刚才说过的话，反复问：刚才那是真的吗？接下来怎么办",
       "keys": [],
       "from": [
        "S09-B3"
       ],
       "bead": "S09-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这个念头让他一下安静下来，刚生出的期待也停住，不敢再往远处想。",
       "keys": [
        "一下安静下来",
        "不敢再往远处想"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像激动地说了很多话后忽然抬头看见夜空，眼前的美好比自己的愿望更大；不安还没得到回答，却暂时不再占满心思",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      }
     ]
    },
    {
     "rank": "次",
