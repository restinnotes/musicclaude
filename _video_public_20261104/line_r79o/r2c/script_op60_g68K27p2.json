     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他露出了在意，对方也还是愿意跟他亲近",
       "keys": [
        "还是愿意跟他亲近"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像两个人肩挨着肩耳语，连呼吸和体温都贴在一起",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "也像熟人安静坐着，偶尔望一眼，沉默也不觉得紧张",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "像夏末水面潮湿温热的风，裹在皮肤上有点发黏",
