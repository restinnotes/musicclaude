 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "我不愿再像从前那样委屈自己，可还是盼着旧日生活有一天能照原样回来",
       "keys": [
        "盼着旧日生活有一天能照原样回来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "像这样眼下的坚持才算有个着落",
       "keys": [
        "眼下的坚持才算有个着落"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "心里那点不平静刚冒出来就断了，我说不清它是什么，也不知道该从哪里说起",
       "keys": [
        "说不清它是什么"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "我常常弄不清自己现在该把心放在哪里，先感到的是绷紧和空落，连难过都还没成形",
       "keys": [
        "先感到的是绷紧和空落"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉中醒来，四周又冷又空，胸口发紧、伸手只摸到空处",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "熟悉的感觉偶尔会突然回来一点，我也跟着想往前，可这股劲很快散了",
       "keys": [
        "可这股劲很快散了"
       ],
       "from": [
        "S01-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "强撑着提醒自己不能倒下，可心里其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "脑子还没想清楚，身体先隐约记起了怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "曾经珍惜的东西仍然牵着我，记忆里的亲近还在，只是我已经不能像以前那样拥有它",
       "keys": [
        "不能像以前那样拥有它"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我尽量让自己显得镇定，可心里总像没站稳，自我安慰也只能撑一会儿",
       "keys": [
        "心里总像没站稳"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像腿脚发虚的人，还在记忆里勉强挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像整理好衣服抬起头，不让人看出自己动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "一遍遍对自己说没事，说到后来反倒露出了自己有多在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我几次想重新积起力气，刚有一点起色又退下去，焦急反而越来越重",
       "keys": [
        "焦急反而越来越重"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "呼吸像被催着一样，变得越来越急促",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "即使这样，我还是不愿接受自己变得无足轻重，心里那股不甘一直顶着我",
       "keys": [
        "心里那股不甘一直顶着我"
       ],
       "from": [
        "S02-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "哪怕心里还在难受，也不甘心就这样垮下去",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我终于分清，自己舍不得的是曾经那份归属，不是还在等旧日生活照原样回来",
       "keys": [
        "舍不得的是曾经那份归属"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "抗拒和烦躁还是会突然涌上来，过一会儿又转成对那份熟悉亲近的想念",
       "keys": [
        "对那份熟悉亲近的想念"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像回到故乡夏日的麦浪与微风里，温和又轻快",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "好几个念头在心里挤来挤去，我一时理不清",
       "keys": [
        "我一时理不清"
       ],
       "from": [
        "S03-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像出去走走换个心情，轻松是真的，心结却还没解开",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "耳边像有人低声絮语，脚下像踩着流沙抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "原先那股昂扬也跟着退了，我又开始怀疑自己能撑多久",
       "keys": [
        "怀疑自己能撑多久"
       ],
       "from": [
        "S03-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "我刚才是真信那些话，还是在勉强自己去信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "那份熟悉的亲近感又变得很清楚，我会感激它曾经给过我的温暖",
       "keys": [
        "感激它曾经给过我的温暖"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "也更容易感觉到自己现在有多脆弱",
       "keys": [
        "自己现在有多脆弱"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "表面还撑着从前坚定的样子，心却比以前更容易受伤了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "越是想起那份温暖，眼下和从前的距离就越明显，心里的紧绷也跟着加重",
       "keys": [
        "眼下和从前的距离就越明显"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "过去太好又回不去才最刺痛，像在拉扯中疲惫地步步后退",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我越想把自己稳住，身体和心里越像被一股急迫感推着",
       "keys": [
        "被一股急迫感推着"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像急促的脚步和乱了拍的心跳，被催着往前跑停不下来",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "我反复想着如果当时还有别的可能会怎样，却始终没有答案",
       "keys": [
        "却始终没有答案"
       ],
       "from": [
        "S04-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子里还在问怎么会变成这样，不停往前赶只是不敢停下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "那份旧日的温暖又靠近了一阵，我仍然会想念它",
       "keys": [
        "我仍然会想念它"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "让他惦记的像是某个人，又像是故乡或从前的日子",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "这次它只是让我更清楚地感到失去的分量，没有让我觉得恢复原样就在眼前",
       "keys": [
        "更清楚地感到失去的分量"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "我很想把心里的东西表达出来，里面既有柔软的靠近，也有不肯再委屈自己的怒意",
       "keys": [
        "不肯再委屈自己的怒意"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里还憋着那股护住自己的劲：这件事不能就这么算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可越想撑住自己，越觉得原先那点支撑在变薄，心里也显得孤单",
       "keys": [
        "原先那点支撑在变薄"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像脚下的地板忽然空了，只剩一个声音在自言自语",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "不安攒得太满时，我会短暂松下来，那更像是累了",
       "keys": [
        "那更像是累了"
       ],
       "from": [
        "S05-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像长叹一口气松了下来，其实还没想通，只是争累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "我终于看清，等旧日生活恢复原样并不能给我保证",
       "keys": [
        "并不能给我保证"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "却让眼下的日子一直悬在那个没有把握的可能上",
       "keys": [
        "一直悬在那个没有把握的可能上"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "难得安静下来时，我暂时不用再向外撑着，压着的委屈、想念和需要一点点浮出来",
