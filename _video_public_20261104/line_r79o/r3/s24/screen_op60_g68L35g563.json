        "S06-B3"
       ],
       "bars": "40-50",
       "at": 24.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "眼前的好也隐约带上了将来会怀念的味道",
     "keys": [
      "将来会怀念的味道"
