 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他很想靠近对方却怕自己的需要成了负担，只敢露出一点喜欢",
