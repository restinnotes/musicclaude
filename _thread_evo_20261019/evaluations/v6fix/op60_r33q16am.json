      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "93–102",
    "relation": "没在想",
    "items": [
     {
      "id": "S12-1",
      "text": "他满心只想好好爱这个人，把自己能给的喜欢和温柔都真心实意地给出去。",
      "key": "他满心只想好好爱",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-1"
      ]
     },
     {
      "id": "S12-2",
      "text": "光是想到两个人如今都愿意这样亲近，他就快乐得几乎想哭，心里有说不尽的珍惜。",
      "key": "光是想到两个人如",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S12-1"
      ]
     },
     {
      "id": "S12-3",
      "text": "他还想把这份喜欢给得更多、更好，直到自己也被眼下的幸福深深满足，终于不再急着表现什么。",
      "key": "他还想把这份喜欢",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1",
       "S12-2"
      ]
     }
    ],
    "because": [
