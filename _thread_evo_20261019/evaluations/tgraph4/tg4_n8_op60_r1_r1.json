  {
   "bars": "103–110",
   "relation": "正在面对",
   "items": [
    {
     "id": "I135",
     "text": "幸福仍鲜明，他却感到一处没有着落。",
     "key": "没有着落",
     "kind": ""
    },
    {
     "id": "I136",
     "text": "他仍不知道对方会不会同样选择他。",
     "key": "会不会同样选择他",
     "kind": "满足照出未满足"
    },
    {
     "id": "I137",
     "text": "他无法凭自己的深情替对方作选择。",
     "key": "替对方作选择",
     "kind": ""
    },
    {
     "id": "I138",
     "text": "想到这里，他仍感到酸楚。",
     "key": "感到酸楚",
     "kind": ""
    },
    {
     "id": "I139",
     "text": "刚才的欢喜使酸楚格外难以忽略。",
     "key": "格外难以忽略",
     "kind": ""
    },
    {
     "id": "I140",
     "text": "他已难以说服自己对回应毫不在乎。",
     "key": "对回应毫不在乎",
     "kind": ""
    },
    {
     "id": "I141",
     "text": "他不愿把自己的安稳全交给对方。",
     "key": "全交给对方",
     "kind": ""
    },
    {
     "id": "I142",
     "text": "他不愿让对方负责消除自己全部不安。",
     "key": "消除自己全部不安",
     "kind": ""
    },
    {
     "id": "I143",
     "text": "他也不愿因害怕落空就削弱这份感情。",
     "key": "害怕落空",
     "kind": ""
    },
    {
     "id": "I144",
     "text": "他发现克制仍无法消除渴望。",
     "key": "无法消除渴望",
     "kind": "办法的限度"
    },
    {
     "id": "I145",
     "text": "他发现尽情投入仍不能排除失望。",
     "key": "不能排除失望",
     "kind": "办法的限度"
    },
    {
     "id": "I146",
     "text": "他感到两种心思的冲突比先前更强烈。",
     "key": "比先前更强烈",
     "kind": "知道更多反而更尖锐"
    },
    {
     "id": "I147",
     "text": "他已舍不得否认其中任何一边。",
     "key": "否认其中任何一边",
     "kind": ""
    },
    {
     "id": "I148",
     "text": "他宁愿承受不轻松，也不仓促舍弃任何一边。",
     "key": "承受不轻松",
     "kind": ""
    },
    {
     "id": "I149",
     "text": "他不想欺骗自己来换取平静。",
     "key": "欺骗自己",
     "kind": ""
    }
   ],
