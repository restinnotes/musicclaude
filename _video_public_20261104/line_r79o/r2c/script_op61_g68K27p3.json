 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开了那段熟悉的生活，起初觉得终于不用再委屈自己了",
       "keys": [
        "不用再委屈自己"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那份郑重像一次召唤，停顿里还在等回声",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "他像逼自己挺直背脊，心里却很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "尊严还撑着，心里却没有方向和力气",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "那份笃定很快散了，心里空落落的又说不清舍不得什么",
       "keys": [
        "空落落"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里有东西，却分不清是愤怒、遗憾还是怀念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "四周冷而空，胸口发紧，视线模糊得伸手只摸到虚空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      },
      {
       "text": "手还在发抖，这还不是哭出来的悲伤",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他还想往前过，却不知道以后靠什么才能安心",
       "keys": [
        "才能安心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日的声音、光线和熟悉感忽然一起回来",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "身体仿佛先记起怎么迈步，心还没跟上",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前自在的日子，想到以后不能那样过就发慌",
       "keys": [
        "自在的日子"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那支旧歌像从远处传来，熟悉却只哼得出几句",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "舞曲像面向众人的庄严，歌声却像私下哼唱",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "珍惜的东西仿佛还在，却已不能像从前那样拥有",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "步子庄严却虚浮，旋律脆弱，伴奏里藏着不安",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他一舍不得就想起受过的气，提醒自己别心软",
       "keys": [
        "别心软"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他整理好衣服抬起头，一遍遍告诉自己“我没事”",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "说到后来，他自己也听出这句话有多勉强",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "悲伤还在，他只是努力不让自己垮下去",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可他还是不甘心，难道离开就得把那些好日子也丢掉吗",
       "keys": [
        "不甘心"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "那股激昂也像在说：我不甘心就这样消亡",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他心里还憋着气，想起曾被当作自己人又高兴了一会儿",
       "keys": [
        "高兴了一会儿"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那一下像重锤砸下来，带着怒气和抗拒",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "轻柔像故乡夏日的麦浪，也像亲近的旧时光",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像暂时侧身走开，聊点别的，轻松是真的",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那点高兴很快变酸，从前的日子已经回不去了",
       "keys": [
        "很快变酸"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "那份温柔让人心颤，也刺痛人：它离眼前太远",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "可这点轻松没有替心里的事找到答案",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "许多声音像在耳边低声絮语，怎么也找不到出口",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "调性像流沙，心里抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他忍不住问，离开以后就一定会更好过吗",
       "keys": [
        "一定会更好过吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚才那股昂扬慢慢退去，他又怀疑自己是否真信过",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他真盼着还能那样相处",
       "keys": [
        "还能那样相处"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那些回忆里有感激、亲密、柔情和短暂的幸福",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "熟悉的步伐还在，他心里却更柔软也更容易受伤",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "那份坚定也可能只是他努力想成为的样子",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那些旧委屈也跟着涌上来，他开始怀疑当初走得对不对",
       "keys": [
        "旧委屈"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "回忆太好，才更刺痛：它已经不能原样回来",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "用力抵抗时，脚步反而更不稳，也显得疲惫仓促",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "像乱了拍的心跳，身体被催着不停往前跑",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他又想当时没走的话，如今会是什么样",
       "keys": [
        "没走的话"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子里反复问：如果当时……是不是还可以……",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      },
      {
       "text": "动作越来越多，心里却始终没想出答案",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他还是不服气，觉得当初那些气根本不该忍",
       "keys": [
        "不服气"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "那股劲里有愤怒、难过，也有想护住自己的心思",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "那股歌唱仍被压力推着走，像在宣告不能算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可连从前开心的事都不敢想，他觉得自己也太为难了",
       "keys": [
        "太为难了"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日记忆又有了温度，可能是某个人、故乡或旧生活",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      },
      {
       "text": "眷恋里也带着失落，因为那段日子已经过去",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争得筋疲力尽，不服气散尽后只剩离开他们的难受",
       "keys": [
        "不服气散尽"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "两只手像夜色里的两个影子，彼此低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "几次深呼吸似的松动，更像累了，不代表想通了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "心里的难受慢慢缓下来，他又想起从前有人陪着的轻松",
       "keys": [
        "难受慢慢缓下来"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "周围像罩着透明玻璃，连呼吸都不愿惊动它",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "这份安宁像母亲的摇篮曲，却不代表现实变好也不能久留",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "如今身边没了那些人，他才知道有人陪着有多轻松",
       "keys": [
        "有人陪着有多轻松"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "他终于不用解释难过，也不用硬撑着说自己没事",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "压着的愿望、委屈和思念终于能浮上来",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他很想再过上不用多说就彼此亲近的日子",
       "keys": [
        "彼此亲近"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "他像在向远方祈求，却不知道会不会得到回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "远去的家园仿佛在梦里被照亮",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "歌声从含蓄试探慢慢展开，后来更迫切，最后像话没说完",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可他也怕这样的日子以后再也遇不到",
       "keys": [
        "再也遇不到"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "想到自己曾真真切切拥有过，他心里又暖了一点",
       "keys": [
        "暖了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "他只是轻轻看着珍惜过的一切，不急着抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有些安心，他又担心以后遇上难事还得一个人扛",
       "keys": [
        "一个人扛"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "寒风像猛地吹开窗户，后颈一凉，脉搏骤然加快",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "当初只想着离开那些委屈，没想到会这么孤单",
       "keys": [
        "这么孤单"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "舞步突然闯进来，像换了场景，打断刚才的思绪",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      },
      {
       "text": "场景换了，心情却没有因此安定下来",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他忍不住想，早知道这样自己还会走吗",
       "keys": [
        "还会走吗"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "颤动一层层累积，脑子翻来覆去，想停也停不下",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      },
      {
       "text": "身体还不相信一切已经结束，想冲出去却找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想找回从前的亲近，却不愿回去再受那些气",
       "keys": [
        "不愿回去再受那些气"
