       "keys": [],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "话停在一半",
       "keys": [],
       "from": [
        "S06-B3-p3"
       ]
      },
      {
       "text": "鼓起勇气说心里话",
