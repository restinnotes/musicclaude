{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"“我不能倒下，可我其实很想停下来。”\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不能倒下，可我想停下\"\n        },\n        {\n          \"quote\": \"却没把这份重量接住\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"没接住这份重量\"\n        },\n        {\n          \"quote\": \"过去也不会因此重新变成现在\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"记得再清，也回不到现在\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开熟悉的生活\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"总算\"\n        },\n        {\n          \"text\": \"可心里很快空了\",\n          \"point\": \"想往前走又不知如何安顿\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"仿佛还在，却已经无法像从前那样拥有它们\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还在，却不能再像从前那样拥有\"\n        },\n        {\n          \"quote\": \"腿脚虚浮的人，在记忆中挪动舞步\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连反复说这句话本身都暴露出：其实还是很在意\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越反复说，越显得在意\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想到以后再没有那样的日子\",\n          \"point\": \"以后再没有那样的日子\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"想到\"\n        },\n        {\n          \"text\": \"他一遍遍想起受过的气\",\