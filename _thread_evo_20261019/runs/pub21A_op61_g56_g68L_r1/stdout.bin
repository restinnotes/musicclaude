{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"我不能倒下，可我其实很想停下来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"声音轻了、远了，悬在半空。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"伸出颤抖的手去摸，摸到的却只有虚空。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他离开了熟悉的生活\",\n          \"point\": \"不用再受委屈\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"离开了熟悉的生活\"\n        },\n        {\n          \"text\": \"没多久，他心里空落落的\",\n          \"point\": \"不知舍不得什么\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没多久\"\n        },\n        {\n          \"text\": \"想继续往前走\",\n          \"point\": \"不知道以后怎么安心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想继续往前走\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"腿脚虚浮的人，在记忆中挪动舞步。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他舍不得过去的自在\",\n          \"point\": \"回不去就心慌\",\n   