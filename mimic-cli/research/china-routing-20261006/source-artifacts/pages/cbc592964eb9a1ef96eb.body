<div id="emerSampleModal" class="emer-sample-modal" aria-hidden="true">
    <div data-emer-modal-close class="emer-sample-modal__backdrop"></div>
    <div class="emer-sample-modal__viewport">
                <div class="emer-sample-modal__card">
            <div class="emer-sample-modal__bar"></div>
            <div class="emer-sample-modal__header">
                <button type="button" data-emer-modal-close class="emer-sample-modal__close" aria-label="Close sample modal">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M1.5 1.5l10 10M11.5 1.5l-10 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <div class="emer-sample-modal__header-inner">
                    <div class="emer-sample-modal__eyebrow">
                        <span class="emer-sample-modal__eyebrow-dot"></span>
                        <span id="emerSampleEyebrow" class="emer-sample-modal__eyebrow-text">Free Sample Request</span>
                    </div>
                    <h3 class="emer-sample-modal__title">
                        <span id="emerSampleTitlePrefix">Get Your</span>
                        <span id="emerSampleTitleEmphasis" class="emer-sample-modal__title-em">Free Sample</span>
                    </h3>
                    <p id="emerSampleSubtitle" class="emer-sample-modal__subtitle">Receive a complimentary chapter of this report delivered to your inbox.</p>
                    <div class="emer-sample-modal__report-strip">
                        <div class="emer-sample-modal__report-icon" aria-hidden="true">
                            <svg viewBox="0 0 14 14" fill="none"><path d="M2.5 1.5h9v11h-9V1.5z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M4.5 5h5M4.5 7h5M4.5 9h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                        </div>
                        <div>
                            <div id="emerSampleReportTitle" class="emer-sample-modal__report-name">US Mini PC Market</div>
                            <div id="emerSampleReportMeta" class="emer-sample-modal__report-meta">Semiconductors &amp; Electronics | Computing and Embedded Systems</div>
                        </div>
                    </div>
                </div>
            </div>

            <form action="https://www.emergenresearch.com/submit-form" method="POST" class="emer-sample-modal__form">
