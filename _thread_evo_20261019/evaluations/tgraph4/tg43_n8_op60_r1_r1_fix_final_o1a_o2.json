   ],
   "items_before_fix": [
    {
     "id": "I76",
     "text": "带着这份仍未平息的牵挂，他渐渐不再要求自己找到一种不会受伤的爱法。",
     "key": "不再寻找无伤爱法",
     "kind": ""
    },
    {
     "id": "I77",
     "text": "他仍想被选择，因为对方重要，也盼两人彼此亲近，即使未必如愿也不假装没有这愿望。",
     "key": "仍想被选也不否认",
     "kind": ""
    },
    {
     "id": "I78",
     "text": "他喜欢得很深，也仍舍不得放弃克制，因为对方有自己的心意，不必与他相同。",
     "key": "克制出于珍惜自由",
     "kind": "分清"
    },
    {
     "id": "I79",
     "text": "若为安心要求对方承担全部期待，他盼望的亲近也会失去自在。",
     "key": "要求期待会损害自在",
     "kind": "选择的代价",
     "follows": true
    },
    {
     "id": "I80",
     "text": "他仍会遗憾，却不再觉得必须消灭遗憾才能好好爱一个人。",
     "key": "遗憾无需先被消灭",
     "kind": "",
     "follows": true
    },
    {
     "id": "I81",
     "text": "小心亲近、不求确认地付出、独自珍藏和尽情欢欣，都曾给他真实的幸福。",
     "key": "几种快乐都真实",
     "kind": "",
     "follows": true
    },
    {
     "id": "I82",
     "text": "这些快乐虽没解决最后的问题，却没有白费，还让他一再向前、看清对方重要。",
     "key": "快乐没有白费",
     "kind": "",
     "follows": true
    },
    {
     "id": "I83",
     "text": "他曾努力收住，也曾尽情投入，因此知道两种办法都不能免去爱人的风险。",
     "key": "两种办法都无法免险",
     "kind": "办法的限度",
     "follows": true
    },
    {
     "id": "I84",
     "text": "他仍盼回应，也偶尔收住心意，却不再用回应有无判断真心，也不拿克制多少证明清醒。",
     "key": "不以回应或克制自证",
     "kind": "",
     "follows": true
    },
    {
     "id": "I85",
     "text": "他知道以后仍可能失望，也会因不能更近一步而感到疼痛。",
     "key": "知道以后仍会疼痛",
     "kind": ""
    },
    {
     "id": "I86",
     "text": "这些疼痛不必让他否认感情，也不必成为催促对方的理由。",
     "key": "疼痛不该否认或催促",
     "kind": "",
     "follows": true
    },
    {
     "id": "I87",
     "text": "他愿继续把对方放在心里，认真喜欢、充分欢喜，也承受无法决定的部分。",
     "key": "继续认真喜欢和欢喜",
     "kind": "",
     "follows": true
    },
    {
     "id": "I88",
     "text": "他可以渴望被爱而不把渴望变成对方的义务，也能珍惜对方自由而不收回自己的心。",
     "key": "渴望与自由能够并存",
     "kind": "",
     "follows": true
    },
    {
     "id": "I89",
     "text": "他没有得到想要的一切，却不再为了保护彼此而先放弃最想给予的爱。",
     "key": "未得一切仍继续爱",
     "kind": "",
     "follows": true
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对",
   "items_before_reorg": [
    {
     "id": "N63",
     "text": "带着这份还没平息的牵挂，他不再逼自己找出一种绝不会受伤的爱法。",
     "from": [
      "I65",
      "I67",
      "I69",
      "I71",
      "I72",
      "I75",
      "I76"
     ],
     "key": "不再寻找无伤爱法",
     "kind": "",
     "follows": true
    },
    {
     "id": "N64",
     "text": "他仍想被选择，即使未必如愿也不假装没有；同时知道对方有自己的心意，不必与他相同。",
     "from": [
      "I77",
      "I78"
     ],
     "key": "想被选择也尊重自由",
     "kind": "",
     "follows": true
    },
    {
     "id": "N65",
     "text": "若为求安心就要对方接住全部期待，这份亲近反而会失去自在。",
     "from": [
      "I78",
      "I79"
     ],
     "key": "期待不能压给对方",
     "kind": "",
     "follows": true
    },
    {
     "id": "N66",
     "text": "遗憾还会有，他却不再要求自己先消灭遗憾，才配好好去爱。",
     "from": [
      "I79",
      "I80"
     ],
     "key": "允许遗憾存在",
     "kind": "",
     "follows": true
    },
    {
     "id": "N67",
     "text": "小心亲近、不求确认地付出、独自珍藏，还有尽情欢喜，都曾给过他真实的幸福。",
     "from": [
      "I81"
     ],
     "key": "几种真实的快乐",
     "kind": "",
     "follows": true
    },
    {
     "id": "N68",
     "text": "这些快乐没解决最后的问题，却没有白费；它们让他一次次愿意继续向前。",
     "from": [
      "I81",
      "I82"
     ],
     "key": "快乐没有白费",
     "kind": "",
     "follows": true
    },
    {
     "id": "N69",
     "text": "曾努力收住，也曾尽情投入，他才知道两种办法都不能替爱免去风险。",
     "from": [
      "I81",
      "I83"
     ],
     "key": "爱无法免去风险",
     "kind": "",
     "follows": true
    },
    {
     "id": "N70",
     "text": "他仍盼回应，偶尔也收住心意，却不拿回应有无判断真心，也不靠克制多少证明清醒。",
     "from": [
      "I83",
      "I84"
     ],
     "key": "不以回应判真心",
     "kind": "",
     "follows": true
    },
    {
     "id": "N71",
     "text": "以后仍可能失望、想要更多，或因不能更近而疼；这些都不必成为否认感情或催促对方的理由。",
     "from": [
      "I85",
      "I86"
     ],
     "key": "疼痛不是否定理由",
     "kind": "",
     "follows": true
    },
    {
     "id": "N72",
     "text": "他愿继续把这个人放在心里，认真喜欢、充分欢喜，也接受自己决定不了的部分。",
     "from": [
      "I87"
     ],
     "key": "继续认真喜欢",
     "kind": "",
     "follows": true
    },
    {
     "id": "N73",
     "text": "他可以渴望被爱而不把渴望变成义务，也能珍惜对方的自由而不收回自己的心。",
     "from": [
      "I88"
     ],
     "key": "渴望不等于义务",
     "kind": "",
     "follows": true
    },
    {
     "id": "N74",
     "text": "他没得到想要的一切，却不再为了保护彼此，先放弃最想给出的爱。",
     "from": [
      "I76",
      "I89"
     ],
     "key": "不先放弃爱",
     "kind": "",
     "follows": true
    }
   ]
  }
 ],
 "source": "n8_op60_r1",
 "check": {
  "center_verbatim": true,
