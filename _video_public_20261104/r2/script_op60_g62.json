 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他忽然发现自己很想靠近，却怕给对方负担，只敢露出一点喜欢。",
       "keys": [
        "很想靠近",
        "一点喜欢"
       ],
       "from": [
        "S01-1",
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头的光亮像烟花升起，落下后却还悬在水面上方。",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "有些话明明想得很清楚，到了嘴边却还是沉默。",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "这么一点亲近就让他觉得甜，他还不知道下次能不能更坦白。",
       "keys": [
        "一点亲近",
        "更坦白"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有退开，仍愿意亲近，他才慢慢放松下来。",
       "keys": [
        "没有退开",
        "放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "脚下像不必再踩实，整个人渐渐交给水波托着。",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "两个人贴得很近，连呼吸和体温都像融在一起。",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他也想靠得更近，喜欢几乎藏不住，最后还是怕太急而收住。",
       "keys": [
        "靠得更近",
        "收住"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "柔软的落音像一根温柔的刺，甜得心里有点鼻酸。",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "歌声忽然热切地往上涌，连呼吸都跟着变了。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "那股热切没有冲到底，像轻轻呼出一口气。",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "两个人待得越好，他越想到这样的时刻总会过去。",
       "keys": [
        "待得越好",
        "总会过去"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他难得不去想两个人的以后，只想舒服地待在这份亲近里。",
       "keys": [
        "不去想",
        "待在这份亲近里"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "身体还在原处，心却像随着水波慢慢漂远。",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他一度想问对方是不是也喜欢这样相处，可念头很快淡了。",
       "keys": [
        "是不是也喜欢",
        "念头很快淡了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "一个急着说出口的念头冒出来，很快又沉了回去。",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "原本顺畅的心绪像被水下暗流拖住，绕远又滞留。",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "熟悉的亲近再次让他欢喜，也勾起上回没说出口的话。",
       "keys": [
        "再次让他欢喜",
        "没说出口"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "这次耳语更热烈，像讲起往事后越说越快，忍不住反复补充。",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他几乎想全说出来，盼对方喜欢自己坦白的样子，又怕弄丢自在。",
       "keys": [
        "全说出来",
        "弄丢自在"
       ],
       "from": [
        "S04-2",
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "最深的情意到了喉咙口，忽然颤得几乎哽咽。",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "原本只是轻轻握着，后来手却不自觉地握紧。",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "明明亲近还在，心里却像已经听见倒数声。",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不知不觉露出全部在乎，对方看出来后，他反而不知怎么相处。",
       "keys": [
        "全部在乎",
        "不知怎么相处"
       ],
       "from": [
        "S05-1",
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "原本托着他的水波忽然撤走，他一下失去支撑。",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他怕对方嫌自己太黏，连熟悉的亲近都像隔了一层。",
       "keys": [
        "嫌自己太黏",
        "隔了一层"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "亲密忽然停了下来，心里只剩一句：这份幸福是真的吗？",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方看出他的在乎后却一切如常，他终于又能自在地靠近。",
       "keys": [
        "一切如常",
        "自在地靠近"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "光线仿佛从暖金色水面滑进古桥阴影，空气一下凉了。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "清澈的歌声像月光，让人想起年少时第一次心动。",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "安静下来，他才想起对方不知道自己刚才有多害怕，也猜对方会不会舍不得。",
       "keys": [
        "有多害怕",
        "会不会舍不得"
       ],
       "from": [
        "S06-2",
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里刚说算了，另一个念头又低声插进来：还是放不下。",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "白天相处得很好，独自回家后心里却泛起酸楚。",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他渐渐觉得，对方有时也需要自己陪着，在身边会更安心。",
       "keys": [
        "也需要自己陪着",
        "更安心"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "安静的满足忽然变热，像有股更深的渴望推着身体往前。",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "气味、触感、幻想和遗憾混在一起，舒服得让人不想抽身。",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "想到以后对方还会找自己，他高兴得几乎舍不得从这份欢喜里出来。",
       "keys": [
        "还会找自己",
        "舍不得从这份欢喜里出来"
       ],
       "from": [
        "S07-2",
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "一切仍然美好，却已经听得见时间正从身边经过。",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这回见对方依然亲近，他想不再躲闪，大大方方地回应。",
       "keys": [
        "不再躲闪",
        "大大方方地回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里重新见到阳光，身体也恢复弹性，带着一点玩心。",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他开始盼着两个人能一直这么好，可一想到以后，心里又没底。",
       "keys": [
        "一直这么好",
        "心里又没底"
       ],
       "from": [
        "S08-2",
        "S08-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "快乐还留着余温，歌声却忽然散去，心头泛起怀念。",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他忽然怕有一天，对方不再需要自己，也不愿再和他待在一起。",
       "keys": [
        "不再需要自己",
        "不愿再和他待在一起"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "话说到要紧处忽然顿住，渴望还在，却没有说出口。",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "两个人像对视到连呼吸都停住，绷紧的劲还没松开。",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "明亮没有消失，只像隔着薄雾，慢慢暗下来。",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不敢再往远处想，只能想起对方还愿意亲近，也许也喜欢有他陪着。",
       "keys": [
        "不敢再往远处想",
        "还愿意亲近"
       ],
       "from": [
        "S09-2",
        "S09-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "他像在听自己刚说过的话，心里还回荡着疑问。",
       "keys": [],
       "from": [
        "S09-B3"
       ],
       "bead": "S09-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不再追问往后怎样，决定先好好享受眼前的亲近。",
       "keys": [
        "不再追问",
        "眼前的亲近"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "肩膀终于松下来，胸口一下打开，眼泪也不必再忍。",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "时间像被拨开一小块空地，终于不用一直跟着水波走。",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "身体轻得像失去重量，仿佛飘在夏夜的微风里。",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      },
      {
       "text": "一串音符像高处落下的飞瀑，清亮地落进水里。",
       "keys": [],
       "from": [
        "S10-B4"
       ],
       "bead": "S10-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他决定，就算以后对方有时不需要自己，也还是愿意陪在身边。",
       "keys": [
        "有时不需要自己",
        "愿意陪在身边"
       ],
       "from": [
        "S11-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像多年后重新走进旧房子，熟悉的一切都带上新重量。",
       "keys": [],
       "from": [
        "S11-B2"
       ],
       "bead": "S11-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "这个念头让他高兴得顾不上害臊；可对方愿不愿意，终究不是他能决定的。",
       "keys": [
        "顾不上害臊",
        "不是他能决定的"
       ],
       "from": [
        "S11-2",
        "S11-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "刚刚铺开的力量忽然悬住，像还在等下一阵更大的浪。",
       "keys": [],
       "from": [
        "S11-B3"
       ],
       "bead": "S11-B3"
      },
      {
       "text": "灿烂得像夕阳最后一刻，亮到刺眼，胸口反而发疼。",
       "keys": [],
       "from": [
        "S11-B4"
       ],
       "bead": "S11-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他只想把能给的都给对方，暂时顾不上对方是否同样在乎。",
       "keys": [
        "把能给的都给对方",
        "同样在乎"
       ],
       "from": [
        "S12-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "私密的心事忽然变得辽阔，连自己都暂时退到了后面。",
       "keys": [],
       "from": [
        "S12-B1"
       ],
       "bead": "S12-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "明知再用心也保证不了以后，他还是想多陪一会儿，也不再收着喜欢。",
       "keys": [
        "保证不了以后",
        "不再收着喜欢"
       ],
       "from": [
        "S12-2",
        "S12-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "越想再多一点，越像有口气悬着，迟迟得不到满足。",
       "keys": [],
       "from": [
        "S12-B2"
       ],
       "bead": "S12-B2"
      },
