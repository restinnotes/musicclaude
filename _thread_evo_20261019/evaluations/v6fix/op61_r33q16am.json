   {
    "sec": "S08",
    "bars": "206–213",
    "relation": "没在想",
    "items": [
     {
      "id": "S08-1",
      "text": "他又想起从前被当作自己人的那份亲近，短短一会儿觉得心里暖和。",
      "key": "他又想起从前被当",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-2",
       "S07-4"
      ]
     },
     {
      "id": "S08-2",
      "text": "那点暖意没能留太久，他只是有些不舍，顾不上再想别的。",
      "key": "那点暖意没能留太",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-2",
      "to": "S08-1",
