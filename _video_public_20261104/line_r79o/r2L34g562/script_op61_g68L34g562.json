    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这一小段，他暂时把这件事放在一边",
       "keys": [
        "暂时把这件事放在一边"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像准备离开的人在最后一刻回头，再看一眼待过的地方",
