    {
     "rank": "次",
     "kind": "段内变化",
     "emotion": "不安",
     "lines": [
      {
       "text": "难过又贴回心口，我迫切想找回过去。",
       "keys": [],
       "from": [
        "S04-2"
       ]
      }
