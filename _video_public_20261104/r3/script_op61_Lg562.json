 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他离开熟悉的生活只为不再一次次委屈自己。",
       "detail": "",
       "keys": [],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "挺直背脊 不能倒下",
       "keys": [],
       "from": [
        "S01-B1-p1"
       ]
      },
      {
       "text": "很想停下来",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ]
      },
      {
       "text": "找不到方向",
       "keys": [],
       "from": [
        "S01-B1-p3"
       ]
      },
      {
       "text": "内心游移",
       "keys": [],
       "from": [
        "S01-B1-p2"
       ]
      }
     ]
    },
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "离开后他很快陷入说不清自己舍不得什么的失落。",
       "detail": "",
       "keys": [],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "生气还是想念？",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "伸手只摸到虚空",
       "keys": [],
       "from": [
        "S01-B4-p2"
       ]
      },
      {
       "text": "停顿里等回声",
       "keys": [],
       "from": [
        "S01-B2-p2"
       ]
      },
      {
       "text": "胸口发紧",
       "keys": [],
       "from": [
        "S01-B4-p1"
       ]
      },
      {
       "text": "遗憾",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "尚未找到对象和语言的失落",
       "keys": [],
       "from": [
        "S01-B3-p3"
       ]
      },
      {
       "text": "恍惚",
       "keys": [],
       "from": [
        "S01-B4-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他仍想把日子往前过却找不到往后能让自己安心的依靠。",
       "detail": "",
       "keys": [],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "记得清楚却回不去",
       "keys": [],
       "from": [
        "S01-B5-p2"
       ]
      },
      {
       "text": "身体先记起迈步",
       "keys": [],
       "from": [
        "S01-B5-p3"
       ]
      },
      {
       "text": "旧场景忽然回来",
       "keys": [],
       "from": [
        "S01-B5-p1"
       ]
      },
      {
       "text": "当时的声音和光线",
       "keys": [],
       "from": [
        "S01-B5-p1"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "往后不能再像从前那样自在地生活让他心里发慌。",
       "detail": "",
       "keys": [],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "记得却不能再拥有",
       "keys": [],
       "from": [
        "S02-B1-p4"
       ]
      },
      {
       "text": "腿脚虚浮",
       "keys": [],
       "from": [
        "S02-B2-p1"
       ]
      },
      {
       "text": "远处旧歌 只哼几句",
       "keys": [],
       "from": [
        "S02-B1-p2"
       ]
      },
      {
       "text": "呼吸越来越急",
       "keys": [],
       "from": [
        "S02-B3-p3"
       ]
      },
      {
       "text": "最后还是没落稳",
       "keys": [],
       "from": [
        "S02-B3-p2"
       ]
      },
      {
       "text": "面向众人的庄严",
       "keys": [],
       "from": [
        "S02-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "越舍不得从前他越要记住当初受过的气免得心软后忘了为何离开。",
       "detail": "",
       "keys": [],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "越说没事越在意",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "整理衣服 抬起头",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      },
      {
       "text": "不让人看出动摇",
       "keys": [],
       "from": [
        "S02-B4-p2"
       ]
      },
      {
       "text": "第一次还信自己没事",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "第二次努力相信",
       "keys": [],
       "from": [
        "S02-B4-p3"
       ]
      },
      {
       "text": "不肯把自己交给悲伤",
       "keys": [],
       "from": [
        "S02-B4-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他不愿再受那些气也不甘心连从前的好日子都一并放弃。",
       "detail": "他还没找到两全的办法，只是不肯认定离开就只能失去那些好日子。",
       "keys": [],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "还不肯认输",
       "keys": [],
       "from": [
        "S02-B5-p1"
       ]
      },
      {
       "text": "这股劲还在",
       "keys": [],
       "from": [
        "S02-B5-p2"
       ]
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "那股气还没消他却因想起曾被当作自己人而短暂高兴。",
       "detail": "",
       "keys": [],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "故乡夏日的麦浪",
       "keys": [],
       "from": [
        "S03-B2-p2"
       ]
      },
      {
       "text": "温柔得让人心颤",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ]
      },
      {
       "text": "心里一悬",
       "keys": [],
       "from": [
        "S03-B1-p2"
       ]
      },
      {
       "text": "低声絮语 找不到出口",
       "keys": [],
       "from": [
        "S03-B3-p1"
       ]
      },
      {
       "text": "越怀念越觉得远",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ]
      },
      {
       "text": "想往前却拿不定方向",
       "keys": [],
       "from": [
        "S03-B1-p3"
       ]
      },
      {
       "text": "出去走走透口气",
       "keys": [],
       "from": [
        "S03-B4-p1"
       ]
      },
      {
       "text": "刚才真的相信了吗？",
       "keys": [],
       "from": [
        "S03-B5-p2"
       ]
      },
      {
       "text": "轻松过后还是心酸",
       "keys": [],
       "from": [
        "S03-B4-p2",
        "S03-B4-p3"
       ]
      },
      {
       "text": "愤怒与抗拒",
       "keys": [],
       "from": [
        "S03-B1-p1"
       ]
      },
      {
       "text": "焦躁急切",
       "keys": [],
       "from": [
        "S03-B2-p1"
       ]
      },
      {
       "text": "轻松亲近",
       "keys": [],
       "from": [
        "S03-B2-p3"
       ]
      },
      {
       "text": "刺痛得让人绝望",
       "keys": [],
       "from": [
        "S03-B2-p4"
       ]
      },
      {
       "text": "那一刻的轻松是真的",
