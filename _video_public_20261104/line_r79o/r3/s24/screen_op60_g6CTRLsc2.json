       "from": [
        "S06-B4"
       ],
       "bars": "40-50",
       "at": 21.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "对方不知道他刚才多怕被嫌弃，他有点孤单",
     "keys": [
      "他有点孤单"
     ],
     "emotion": "孤单",
     "from": [
      "S06-2"
     ],
     "at": 8.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像夜里灯一关，胸口忽然泛起一点酸",
       "bead": "S06-B3",
       "from": [
        "S06-B3"
       ],
       "bars": "40-50",
       "at": 24.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "他又忍不住想，对方既然一直没有退开，会不会也有一点舍不得结束这份亲近？",
     "keys": [
      "舍不得结束这份亲近"
     ],
     "emotion": "悬着",
     "from": [
      "S06-3"
     ],
     "at": 12.0
    }
   ],
   "notes": [
    {
     "text": "左手波浪变薄碎成细纹，新旋律清澈舒展如牧歌",
     "bars": "40-50",
     "from": [
      "S06-B1"
     ]
    },
    {
     "text": "旋律压低声音，另一条声线时而靠近时而退开",
     "bars": "40-50",
     "from": [
      "S06-B2"
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "rows": [
    {
     "kind": "line",
     "text": "想起这些日子对方总愿意跟他待在一起，他渐渐觉得，也许对方有时也需要他陪着",
     "keys": [
      "有时也需要他陪着"
     ],
     "emotion": "安心",
     "from": [
      "S07-1"
     ]
    },
    {
     "kind": "line",
     "text": "跟他在一起也能安心些",
     "keys": [
      "也能安心些"
     ],
     "emotion": "安心",
     "from": [
      "S07-1"
     ],
     "at": 4.0
    },
    {
     "kind": "line",
     "text": "他高兴得有点收不住，想到两个人也许能互相依靠",
     "keys": [
      "高兴得有点收不住"
     ],
     "emotion": "欢喜",
     "from": [
      "S07-2"
     ],
     "at": 8.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像胸口轻轻一缩，随即又被暖意包住",
       "bead": "S07-2",
       "from": [
        "S07-2"
       ],
       "bars": "",
       "at": 15.0
      },
      {
       "text": "胸口热得发胀，指尖也有些发麻",
       "bead": "S07-B1",
       "from": [
        "S07-B1"
       ],
       "bars": "51-61",
       "at": 18.0
      },
      {
       "text": "像温热的潮水漫过来，皮肤也跟着发烫",
       "bead": "S07-B2",
       "from": [
        "S07-B2"
       ],
       "bars": "51-61",
       "at": 21.0
      }
     ]
    },
    {
     "kind": "line",
     "text": "他真盼着，往后对方想找人陪时还会想到自己，自己也能一直陪在身边",
     "keys": [
      "一直陪在身边"
     ],
     "emotion": "亲密",
     "from": [
      "S07-3"
     ],
     "at": 12.0
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像夕阳落进水里，金光一寸寸往远处退",
       "bead": "S07-B3",
       "from": [
        "S07-B3"
       ],
       "bars": "53-61",
       "at": 24.0
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "伴奏音符变密，内声部像水底暗涌不断攀爬",
     "bars": "51-61",
     "from": [
      "S07-B1"
     ]
    },
    {
     "text": "低音八度与切分像沉重的脉搏在催促",
     "bars": "51-61",
     "from": [
      "S07-B1"
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "rows": [
    {
     "kind": "line",
     "text": "上回他无意间露了心意，这回见对方依然亲近",
