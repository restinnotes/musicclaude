  "S03": {
   "edit": {
    "items": [
     {
      "id": "S03-1",
      "text": "他开始盼这份亲近能长久。",
      "key": "盼它长久",
      "follows": false,
      "causes": [
       "c2"
      ]
     },
     {
      "id": "S03-2",
      "text": "想到长久，他发现自己能决定怎样珍惜对方，却不能决定对方是否也珍惜自己。",
      "key": "不能决定",
      "follows": true,
      "causes": [
       "c2"
      ]
     },
     {
      "id": "S03-3",
      "text": "他偶尔想知道自己在对方心里是不是特别，却还不打算向对方索取答复。",
