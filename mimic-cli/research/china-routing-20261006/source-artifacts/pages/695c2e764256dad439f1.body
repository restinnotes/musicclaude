"static/chunks/7445-e544027c29844654.js\",\"7970\",\"static/chunks/7970-49ae6bd8cb2d5763.js\",\"9795\",\"static/chunks/9795-7b3c0f4c75e0a697.js\",\"6655\",\"static/chunks/6655-b2dc331da51f2f8e.js\",\"3408\",\"static/chunks/3408-981e0cc051ab5772.js\",\"7993\",\"static/chunks/7993-b"])</script><script>self.__next_f.push([1,"d4e353981e82f05.js\",\"7478\",\"static/chunks/7478-0e0772f676e69352.js\",\"9959\",\"static/chunks/9959-a6343109d333ac11.js\",\"3256\",\"static/chunks/3256-64168f161be6b987.js\",\"9637\",\"static/chunks/9637-93e2d6a934b53fdb.js\",\"7054\",\"static/chunks/7054-ed5c41171340993e.js\",\"6967\",\"static/chunks/app/%5Blocale%5D/insights/%5Bid%5D/page-1aae8a46d9ff8093.js\"],\"PostSideBanner\"]\n2d:I[56250,[\"4316\",\"static/chunks/ad2866b8-e61efaab7b01bf9f.js\",\"9110\",\"static/chunks/9110-fa2e96f6140e469f.js\",\"7445\",\"static/chunks/7445-e544027c29844654.js\",\"7970\",\"static/chunks/7970-49ae6bd8cb2d5763.js\",\"9795\",\"static/chunks/9795-7b3c0f4c75e0a697.js\",\"6655\",\"static/chunks/6655-b2dc331da51f2f8e.js\",\"3408\",\"static/chunks/3408-981e0cc051ab5772.js\",\"7993\",\"static/chunks/7993-bd4e353981e82f05.js\",\"7478\",\"static/chunks/7478-0e0772f676e69352.js\",\"9959\",\"static/chunks/9959-a6343109d333ac11.js\",\"3256\",\"static/chunks/3256-64168f161be6b987.js\",\"9637\",\"static/chunks/9637-93e2d6a934b53fdb.js\",\"7054\",\"static/chunks/7054-ed5c41171340993e.js\",\"6967\",\"static/chunks/app/%5Blocale%5D/insights/%5Bid%5D/page-1aae8a46d9ff8093.js\"],\"BackToListButton\"]\n29:T29d86,"])</script><script>self.__next_f.push([1,"\u003ch2 class=\"text-2xl font-bold dark:text-white\"\u003e\u003cspan style=\"white-space: pre-wrap;\"\u003eQ2 2026 Highlights\u003c/span\u003e\u003c/h2\u003e\u003ch3 class=\"text-xl font-bold dark:text-white\"\u003e\u003cfigure class=\"editor-image\" style=\"width: 100%;\"\u003e\u003cimg src=\"https://static.counterpointresearch.com/statics/images/admin/65b68d50-a5cc-11f1-80d6-3f15a78e7327.png\" alt=\"US Smartphone Shipments 