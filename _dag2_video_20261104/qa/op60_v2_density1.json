        "S04-B4"
      ],
      "bead_edges": [
        {
          "a": "S04-B1",
          "b": "S04-B2",
          "type": "段内先后",
          "note": "第24小节主题加饰重现，逐渐走向第30–32小节附近的局部高点；第32–34小节出现颤音、退弱和放慢。两种体验在高点附近相互渗透，并非B1完全结束后B2才开始。"
        },
        {
          "a": "S04-B1",
          "b": "S04-B3",
          "type": "重叠但新增",
          "note": "B1已经传达了越来越迫切、反复想补充的感觉；B3新增手掌由轻握到握紧的具体动作，以及想抓牢却愈发失衡的身体触感。它们不要求属于同一个人物。"
        },
        {
          "a": "S04-B2",
          "b": "S04-B3",
          "type": "可同时成立",
          "note": "高处颤音的悬停与左手推行，可以同时被听成想表达却哽住，以及想抓牢却失衡；两者不构成必然因果。"
        },
        {
          "a": "S04-B2",
          "b": "S04-B4",
          "type": "可同时成立",
          "note": "B2的左手水波带来具体的持续推动感；B4则把同一持续摇荡感受成时间正在流走。B2的一瞬敞亮与B4的预先舍不得可以同时存在。"
        },
        {
          "a": "S04-B3",
          "b": "S04-B4",
          "type": "可同时成立",
          "note": "B3是越来越想抓紧的主动身体动作，B4是美好尚在时便已鼻酸的时间感。一个偏向用力，一个偏向感到流逝，不能说成先握紧才导致鼻酸。"
        }
      ],
