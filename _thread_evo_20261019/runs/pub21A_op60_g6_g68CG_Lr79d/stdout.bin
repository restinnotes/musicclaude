{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"船歌那种稳定的摇荡感还没有真正成形\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"摇荡感还没成形\"\n        },\n        {\n          \"quote\": \"还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没安稳地交给水浪\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近\",\n          \"point\": \"很想靠近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"忽然\"\n        },\n        {\n          \"text\": \"怕让对方为难\",\n          \"point\": \"只敢露出一点喜欢\",\n          \"where\": \"中\",\n          \"waste\": \"还不敢坦白\",\n          \"keep\": \"怕让对方为难\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"因为太喜欢眼前的东西，所以还没有失去，就已经生出一丝舍不得\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没失去，就先舍不得\"\n        },\n        {\n          \"quote\": \"水却一直在流，时间也一直在走\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像一根温柔的刺\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"对方没有退开\",\n          \"point\": \"慢慢放松\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"仍愿意亲近，他才慢慢放松\"\n        },\n        {\n          \"text\": \"他也想靠近些\",\n          \"point\": \"喜欢得几乎藏不住\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"几乎\"\n        },\n        {\n          \"text\": \"可他怕太急\",\n          \"point\": \"还没分开就先舍不