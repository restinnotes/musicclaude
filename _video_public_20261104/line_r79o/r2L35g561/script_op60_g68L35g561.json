        ""
       ],
       "bead": ""
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这份亲近本身就让我觉得温柔而舒服，不必一直表达什么，我也能安静地享受它",
