       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "一些亲切的日常感觉一浮现，反而让我更清楚地感到和过去的距离",
