       "text": "熟悉并不能证明原来的生活还能原样恢复",
       "keys": [],
       "from": [
        "S03-3"
       ],
       "bead": "S03-3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "所以我不再把想念当作折返的依据，继续离开",
       "keys": [
        "不再把想念当作折返的依据"
       ],
       "from": [
        "S03-3"
       ]
      }
