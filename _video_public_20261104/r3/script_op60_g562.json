       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他几乎想把话全说出来，盼着对方也喜欢他的坦白。",
