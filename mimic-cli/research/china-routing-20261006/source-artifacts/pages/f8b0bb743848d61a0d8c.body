        $("#rank").load('//www.ithome.com/block/rank.html');
        
        $("#cat-hot").load('//www.ithome.com/block/cat/100.html');
        if ($("#cat-hot").find("*").length > 0) {
            $("#cat-hot").show();
        }

        
        $(function () {
            if (imageSupportChecker) {
                imageSupportChecker.ready(function () {
                    lazyLoad()
                })
            } else {
                lazyLoad()
            }
            function lazyLoad() {
                $("img.lazy").lazyload();
            }
        });
        
        if ($(".post_content pre").length > 0 && loadFile) {
            loadFile("//img.ithome.com/file/js/prettify/prettify.js", function () {
                $("pre").addClass("prettyprint"); prettyPrint();
            })
        }
    </script>

    <div style="display:none">
        <script>
            var _hmt = _hmt || [];
            (function () {
                var hm = document.createElement("script");
                hm.src = "https://hm.baidu.com/hm.js?cfebe79b2c367c4b89b285f412bf9867";
                var s = document.getElementsByTagName("script")[0];
                s.parentNode.insertBefore(hm, s);
            })();
        </script>
    </div>
</body>
</html>
