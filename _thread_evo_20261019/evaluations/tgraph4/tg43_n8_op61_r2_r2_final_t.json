   "relation_votes": {
    "没在想": 6
   },
   "relation_model": "没在想",
   "items_before_trim": [
    {
     "id": "I54",
     "text": "就在这番为难里，那份温柔又短暂地贴近了他。",
     "key": "温柔在为难中短暂贴近",
     "kind": "",
     "key_model": "温柔短暂贴近"
    },
    {
     "id": "I55",
     "text": "他明知自己不能一直停留，仍不忍立刻推开这份温柔。",
     "key": "不忍立刻推开温柔",
     "kind": "",
     "follows": true,
     "key_model": "不忍立刻推开温柔"
    },
    {
     "id": "I56",
     "text": "既然它确实给过他深深的满足，他便不想每次想起都立刻拿它审问自己。",
     "key": "不愿一想温柔就自审",
     "kind": "",
     "follows": true,
     "key_model": "不再用满足审问自己"
    },
    {
     "id": "I57",
     "text": "他愿意再爱惜片刻，暂时不想那些尚无答案的事。",
     "key": "暂不追问只愿爱惜片刻",
     "kind": "",
     "follows": true,
     "key_model": "再爱惜安静片刻"
    },
    {
     "id": "I58",
     "text": "这点安静仍使他欢喜，只是欢喜里已经带着不舍。",
     "key": "欢喜中已经带着不舍",
     "kind": "",
     "follows": true,
     "key_model": "欢喜里已有不舍"
    }
   ]
  },
  {
   "bars": "214–215",
   "relation": "正在面对",
   "items": [
    {
     "id": "I59",
     "text": "安静退去后，熟悉的迟疑又回来，仿佛走了很远仍回到原处。",
     "key": "安静退去迟疑重返",
     "kind": "",
     "follows": false
    },
    {
     "id": "I60",
     "text": "他如今知道自己始终放不下什么，那份迟疑里有怯懦，也有他不愿失去的生活希望。",
     "key": "迟疑藏着怯懦与希望",
     "kind": "分清",
     "follows": true
    }
   ],
   "because": [
