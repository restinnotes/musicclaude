       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "卡片上写着“有空回来”，他盯了半晌，最后夹进书里继续拆箱",
       "keys": [
        "有空回来"
       ],
       "from": [
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "激烈的思绪间胸口像终于吸进一口气，也只是瞬间的喘息",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "收拾箱子时旧友打来电话，说大家想找个晚上聚一聚",
