{"completed": true, "response": "<escape>{\n  \"blocks\": [\n    {\"id\":\"S01-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S01-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S01-0-2\",\"a\":\"偏了\",\"b\":\"偏了\",\"lost\":\"原稿强调踩上小船时身体瞬间失重、脚下晃动，不是心动或心绪失衡。\"},\n    {\"id\":\"S01-1-0\",\"a\":\"对上\",\"b\":\"偏了\",\"lost\":\"乙把原稿未具体说明的、想了很久的重要事情限定成了告白或表达喜欢。\"},\n    {\"id\":\"S01-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-0-3\",\"a\":\"偏了\",\"b\":\"对上\",\"lost\":\"甲只抓到温暖舒服的亲近感，漏掉了潮湿温热、微风黏稠地贴在皮肤上的具体触感。\"},\n    {\"id\":\"S02-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-1-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-2-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S02-2-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-0-1\",\"a\":\"对上\",\"b\":\"偏了\",\"lost\":\"乙把说过重要的话之后的余韵、陶醉和走神，转成了享受眼前亲近的感觉。\"},\n    {\"id\":\"S03-0-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-0-3\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-1-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S03-1-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S04-0-0\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S04-0-1\",\"a\":\"没对上\",\"b\":\"对上\",\"lost\":\"甲不知道；原稿表达的是水面折射出的细碎光斑突然明亮晃眼的视觉感受。\"},\n    {\"id\":\"S04-0-2\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"},\n    {\"id\":\"S04-1-0\",\"a\":\"没对上\",\"b\":\"对上\",\"lost\":\"甲不知道；原稿表达的是夕阳金光强烈刺眼，并将情绪推向炽热的顶点。\"},\n    {\"id\":\"S04-1-1\",\"a\":\"对上\",\"b\":\"对上\",\"lost\":\"\"}