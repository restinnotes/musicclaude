        "空落落",
        "分不清"
       ],
       "from": [
        "S01-2",
        "S01-B2",
        "S01-B3"
       ]
      }
     ],
     "beads": [
      {
       "text": "开头一记沉响",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      },
      {
       "text": "郑重得像宣告",
