     "rel": "提供理由"
    }
   ]
  },
  {
   "bars": "254–288",
   "relation": "正在面对",
   "items": [
    {
     "id": "I136",
     "text": "他渐渐感到一种不同于先前骄傲的力量。",
     "key": "不同于先前",
     "kind": ""
    },
    {
     "id": "I137",
     "text": "他仍羡慕不用费力维护尊严的日子。",
     "key": "仍羡慕",
     "kind": ""
    },
    {
     "id": "I138",
     "text": "他不再把遗憾当成自己不够坚强的证据。",
     "key": "不够坚强",
     "kind": ""
    },
    {
     "id": "I139",
     "text": "他不再那么急着证明自己。",
     "key": "急着证明",
     "kind": ""
    },
    {
     "id": "I140",
     "text": "他仍能在愿望落空时认真选择往后怎样活。",
     "key": "认真选择",
     "kind": ""
    },
    {
     "id": "I141",
     "text": "他想起旧日的爱与勇气，仍因强烈眷恋而酸楚。",
     "key": "强烈眷恋",
     "kind": ""
    },
    {
     "id": "I142",
     "text": "他为没有放弃所珍惜的东西感到实在的自豪。",
     "key": "实在的自豪",
     "kind": ""
    },
    {
     "id": "I143",
     "text": "他不愿亏待自己的感情。",
     "key": "亏待自己的感情",
     "kind": ""
    },
    {
     "id": "I144",
     "text": "他不轻易让出自己的尊严。",
     "key": "让出自己的尊严",
     "kind": ""
    },
    {
     "id": "I145",
     "text": "他的自豪如今也容得下难过。",
     "key": "容得下难过",
     "kind": ""
    },
    {
     "id": "I146",
     "text": "他不必装作不需要亲近才能独自承受。",
     "key": "不需要亲近",
     "kind": ""
    },
    {
     "id": "I147",
     "text": "他不必回到过去才能珍惜旧日所得。",
     "key": "回到过去",
     "kind": ""
    },
    {
     "id": "I148",
     "text": "他如今的坚持带着对旧日安心的感激。",
     "key": "旧日安心",
     "kind": ""
    },
    {
     "id": "I149",
     "text": "他不再让怀念和坚持在心里互相否定。",
     "key": "互相否定",
     "kind": ""
    },
    {
     "id": "I150",
     "text": "他愿意承受有些珍贵的东西回不来了。",
     "key": "愿意承受",
     "kind": ""
    },
    {
     "id": "I151",
     "text": "他仍想把旧日留给他的美好继续下去。",
     "key": "继续下去",
     "kind": ""
    },
    {
     "id": "I152",
     "text": "他不再靠骄傲否认失去。",
     "key": "否认失去",
     "kind": ""
    },
    {
     "id": "I153",
     "text": "他此刻仍愿意坚持。",
     "key": "仍愿意坚持",
     "kind": ""
    },
    {
     "id": "I154",
     "text": "他因此觉得自己没有辜负过去。",
     "key": "没有辜负过去",
     "kind": ""
    },
    {
     "id": "I155",
     "text": "他也觉得没有辜负现在的自己。",
     "key": "现在的自己",
     "kind": ""
    }
