      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S03",
    "bars": "66–91",
    "relation": "正在面对",
    "items": [
     {
      "id": "S03-1",
      "text": "可他开始反复想念从前被人自然需要、接纳的日子，想到那份亲近，心里仍会觉得温暖。",
      "key": "可他开始反复想念",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S02-1"
      ]
     },
     {
      "id": "S03-2",
      "text": "那些过去不必费力就能拥有的亲近，如今只能靠回想，他也渐渐无法只顾着庆幸自己离开了。",
      "key": "那些过去不必费力",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S02-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S01-1",
      "to": "S03-1",
      "rel": "引用"
     },
     {
