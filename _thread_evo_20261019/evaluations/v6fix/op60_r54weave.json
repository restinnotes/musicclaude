      "rel": "引用"
     },
     {
      "from": "S08-2",
      "to": "S09-2",
      "rel": "引用"
     },
     {
      "from": "S09-1",
      "to": "S09-2",
      "rel": "引用"
     },
     {
      "from": "S06-1",
      "to": "S09-3",
      "rel": "引用"
     },
     {
      "from": "S09-1",
      "to": "S09-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S10",
    "bars": "78–83",
    "relation": "正在面对",
    "items": [
     {
      "id": "S10-1",
      "text": "他终于肯暂时不去猜那一天会不会到来，先好好享受眼前两个人还能这样亲近的欢喜。",
      "key": "他终于肯暂时不去",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-1",
       "S09-3"
      ]
     },
     {
      "id": "S10-2",
      "text": "先前那阵紧绷慢慢松下去，他心里亮堂得几乎想笑，也有点想哭。",
      "key": "先前那阵紧绷慢慢",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-2",
       "S10-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S09-1",
      "to": "S10-1",
      "rel": "引用"
     },
     {
