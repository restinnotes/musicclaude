      "rel": "提供理由",
      "how": null
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "242–253",
    "relation": "正在面对",
    "items": [
     {
      "id": "I126",
      "text": "他不再需要靠贬低怀念维持坚持。",
      "key": "贬低怀念",
      "follows": null
     },
     {
      "id": "I127",
      "text": "他愿承认自己仍渴望旧日的亲近。",
      "key": "仍渴望",
      "follows": null
     },
     {
      "id": "I128",
      "text": "想起从前，他仍会难过。",
      "key": "仍会难过",
      "follows": null
     },
     {
      "id": "I129",
      "text": "他肯定有些坚持得不到安慰也值得保留。",
      "key": "值得保留",
      "follows": null
     },
     {
      "id": "I130",
      "text": "这种想法没有让他立刻轻松。",
      "key": "立刻轻松",
      "follows": null
     },
     {
      "id": "I131",
      "text": "他不再压抑后，更真切地感到失去沉重。",
      "key": "更真切",
      "follows": null
     },
     {
      "id": "I132",
      "text": "他有时舍不得，甚至怀疑能否一直走下去。",
      "key": "怀疑",
      "follows": null
     },
     {
      "id": "I133",
      "text": "他开始愿意感激过去而不怨恨它。",
      "key": "不怨恨它",
      "follows": null
     },
     {
      "id": "I134",
      "text": "他不愿让无法恢复的过去拖住今后的选择。",
      "key": "今后的选择",
      "follows": null
     },
     {
      "id": "I135",
      "text": "他不愿用得不到亲近来否定自己。",
      "key": "否定自己",
      "follows": null
     }
    ],
    "because": [
     {
      "from": "I125",
      "to": "I126",
      "rel": "改写",
      "how": null
     },
     {
      "from": "I98",
      "to": "I127",
      "rel": "仍在起作用",
      "how": null
     },
     {
      "from": "I124",
      "to": "I129",
      "rel": "提供理由",
      "how": null
     },
     {
      "from": "I107",
      "to": "I131",
      "rel": "提供理由",
      "how": null
     }
    ]
   },
   {
    "sec": "S13",
    "bars": "254–288",
    "relation": "正在面对",
    "items": [
     {
      "id": "I136",
      "text": "他渐渐感到一种不同于先前骄傲的力量。",
      "key": "不同于先前",
      "follows": null
     },
     {
      "id": "I137",
      "text": "他仍羡慕不用费力维护尊严的日子。",
      "key": "仍羡慕",
      "follows": null
     },
     {
      "id": "I138",
      "text": "他不再把遗憾当成自己不够坚强的证据。",
      "key": "不够坚强",
      "follows": null
     },
     {
      "id": "I139",
      "text": "他不再那么急着证明自己。",
      "key": "急着证明",
      "follows": null
     },
     {
      "id": "I140",
      "text": "他仍能在愿望落空时认真选择往后怎样活。",
      "key": "认真选择",
      "follows": null
     },
     {
      "id": "I141",
      "text": "他想起旧日的爱与勇气，仍因强烈眷恋而酸楚。",
      "key": "强烈眷恋",
      "follows": null
     },
     {
      "id": "I142",
      "text": "他为没有放弃所珍惜的东西感到实在的自豪。",
      "key": "实在的自豪",
      "follows": null
     },
     {
      "id": "I143",
      "text": "他不愿亏待自己的感情。",
      "key": "亏待自己的感情",
      "follows": null
     },
     {
      "id": "I144",
      "text": "他不轻易让出自己的尊严。",
      "key": "让出自己的尊严",
      "follows": null
     },
     {
      "id": "I145",
      "text": "他的自豪如今也容得下难过。",
      "key": "容得下难过",
      "follows": null
     },
     {
      "id": "I146",
      "text": "他不必装作不需要亲近才能独自承受。",
      "key": "不需要亲近",
      "follows": null
     },
     {
      "id": "I147",
      "text": "他不必回到过去才能珍惜旧日所得。",
      "key": "回到过去",
      "follows": null
     },
     {
      "id": "I148",
      "text": "他如今的坚持带着对旧日安心的感激。",
      "key": "旧日安心",
      "follows": null
     },
     {
      "id": "I149",
      "text": "他不再让怀念和坚持在心里互相否定。",
      "key": "互相否定",
      "follows": null
     },
     {
      "id": "I150",
      "text": "他愿意承受有些珍贵的东西回不来了。",
      "key": "愿意承受",
      "follows": null
     },
     {
      "id": "I151",
      "text": "他仍想把旧日留给他的美好继续下去。",
      "key": "继续下去",
      "follows": null
     },
     {
      "id": "I152",
      "text": "他不再靠骄傲否认失去。",
      "key": "否认失去",
      "follows": null
     },
     {
      "id": "I153",
      "text": "他此刻仍愿意坚持。",
      "key": "仍愿意坚持",
      "follows": null
     },
     {
      "id": "I154",
      "text": "他因此觉得自己没有辜负过去。",
      "key": "没有辜负过去",
      "follows": null
     },
     {
      "id": "I155",
      "text": "他也觉得没有辜负现在的自己。",
      "key": "现在的自己",
      "follows": null
     }
    ],
