        "S07-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他欢喜得快兜不住了，想到两人说不定真能互相作个依靠",
