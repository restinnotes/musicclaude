       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "待在同一个屋檐下就已经很舒服",
       "keys": [
        "很舒服"
