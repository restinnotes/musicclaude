",\n          \"after\": 2,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"242–253\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"他决定怎样站立不必装作没受伤\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"242–253\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"前进时脚下像忽然斜了一下\",\n          \"after\": 4,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"249–253\",\n          \"at\": 20\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉主题以雷鸣般声势铺开\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"242–253\"\n        },\n        {\n          \"text\": \"向前的声音忽然换了一下色彩\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"249–253\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"想起从前亲近他心里又热了\",\n          \"accent\": \"心里又热了\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-1\", \"S13-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他盼着以后还能那样相处\",\n          \"accent\": \"盼着\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S13-1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他想过好日子不再和过去较劲\",\n          \"accent\": \"不再和过去较劲\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-2\", \"S13-B2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"怕还要等很久他渐渐静下来\",\n          \"accent\": \"等很久\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-3\", \"S13-B3\"],\n          \"at\": 34\n        },\n        {\n          \"text\": \"有人来他会珍惜没人也好好过\",\n          \"accent\": \"好好过\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S13-4\", \"S13-B5\"],\n          \"at\": 49\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"也会想到故土共同记忆和希望\",\n          \"after\": 1,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254–270\",\n          \"at\": 