 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他得尽量把自己稳住，保住尊严",
       "keys": [
        "尽量把自己稳住"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "强撑着提醒自己不能倒下，可心里其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "这件事对他很重要，像有些话需要说清、需要一个确认，可那份笃定很快散了",
       "keys": [
        "那份笃定很快散了"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "迟钝和闷沉稍稍退开后，他才感觉到那点说不清的不安",
       "keys": [
        "那点说不清的不安"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉中醒来，四周又冷又空，胸口发紧、伸手只摸到空处",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "旧日生活里熟悉的感觉忽然鲜明起来，亲近得让他舍不得",
       "keys": [
        "亲近得让他舍不得"
       ],
       "from": [
        "S01-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那种日子不能照原样回来，熟悉感也没能给他一个明确方向",
       "keys": [
        "没能给他一个明确方向"
       ],
       "from": [
        "S01-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子还没想清楚，身体先隐约记起了怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他尽量让自己显得郑重、硬气，心里却仍亲近那段旧日生活",
       "keys": [
        "心里却仍亲近那段旧日生活"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像腿脚发虚的人，还在记忆里勉强挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "想撑住的劲一会儿聚起来，一会儿又退下去，焦灼越积越多",
       "keys": [
        "焦灼越积越多"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "呼吸像被催着一样，变得越来越急促",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他一遍遍劝自己先稳住，不要被难过压过去",
       "keys": [
        "不要被难过压过去"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像整理好衣服抬起头，不让人看出自己动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可越这样劝，越知道自己还是很在意",
       "keys": [
        "越知道自己还是很在意"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他心里还留着一点不愿屈服的劲，只是这并没有让他重新轻松或自信",
       "keys": [
        "一点不愿屈服的劲"
       ],
       "from": [
        "S02-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "哪怕心里还在难受，也不甘心就这样垮下去",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "心里有股不服气，想往前顶一下",
       "keys": [
        "心里有股不服气"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可几个念头又同时冒出来，越急越不知道该往哪儿使劲",
       "keys": [
        "越急越不知道该往哪儿使劲"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "耳边像有人低声絮语，脚下像踩着流沙抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他会想起过去那种轻松、亲近、不必时刻提防的感觉",
       "keys": [
        "轻松、亲近、不必时刻提防"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像回到故乡夏日的麦浪与微风里，温和又轻快",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像出去走走换个心情，轻松是真的，心结却还没解开",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "这份温柔一闪过，眼前的处境反而更让人难受",
       "keys": [
        "眼前的处境反而更让人难受"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "先前那股昂扬和确信慢慢退了，他开始怀疑自己原来相信的东西究竟有多牢",
       "keys": [
        "开始怀疑自己原来相信的东西究竟有多牢"
       ],
       "from": [
        "S03-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "我刚才是真信那些话，还是在勉强自己去信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "旧日生活里熟悉的感觉忽然鲜活起来，带来温暖、感激和短暂的幸福",
       "keys": [
        "温暖、感激和短暂的幸福"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "表面还撑着从前坚定的样子，心却比以前更容易受伤了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "这份温暖很快又转成疼和紧绷，他越想抵住那股难受，越清楚那种生活不能照原样回来",
       "keys": [
        "越清楚那种生活不能照原样回来"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "过去太好又回不去才最刺痛，像在拉扯中疲惫地步步后退",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他明明已经累了，却很难让自己真正停下来放松",
       "keys": [
        "很难让自己真正停下来放松"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像急促的脚步和乱了拍的心跳，被催着往前跑停不下来",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他反复在心里设想各种可能，想找出一个说得通的解释，可想来想去还是绕在原处",
       "keys": [
        "想来想去还是绕在原处"
       ],
       "from": [
        "S04-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子里还在问怎么会变成这样，不停往前赶只是不敢停下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他对那份亲近有很柔和、克制的感情，很多在意仍留在心里，没有完全表达出来",
       "keys": [
        "很多在意仍留在心里"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "维持尊严仍是他必须做的事，他不愿就这样被压下去",
       "keys": [
        "不愿就这样被压下去"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里还憋着那股护住自己的劲：这件事不能就这么算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可旧日生活和曾经的归属也一直牵着他，眷恋里有温暖也有失落",
       "keys": [
        "眷恋里有温暖也有失落"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "让他惦记的像是某个人，又像是故乡或从前的日子",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "原本支撑他的那股劲慢慢弱下来，心里像少了依托，脆弱和孤立感都更明显",
       "keys": [
        "脆弱和孤立感都更明显"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像脚下的地板忽然空了，只剩一个声音在自言自语",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "不安又加深，紧绷了一阵后忽然松了一点",
       "keys": [
        "紧绷了一阵后忽然松了一点"
       ],
       "from": [
        "S05-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像长叹一口气松了下来，其实还没想通，只是争累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "紧绷之后，他有了一段安静柔和的时刻，像暂时不用处处防备",
       "keys": [
        "暂时不用处处防备"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "世界像被透明玻璃罩隔开，像听着母亲哼摇篮曲，连呼吸都放轻",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他不必再把自己装得那么坚强，压着的委屈、愿望和想念都能先承认下来",
