       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可越用力，心里越发紧，也越能感觉到它并不由我掌控",
       "keys": [
        "并不由我掌控"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "原本轻轻握着的手不自觉收紧，动作先露出了害怕",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "想用力抱牢当下，又怕颠坏了两人原有的平衡与自在",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    }
   ]
