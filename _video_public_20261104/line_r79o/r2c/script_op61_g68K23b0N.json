     "beads": []
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "先把回去放一边，回忆暖过，却陪不了往后",
       "keys": [
        "把回去放一边",
        "陪不了往后"
       ],
       "from": [
        "S08-1",
        "S08-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "缓慢宽广的歌唱短暂回来，像离开前最后回头一眼",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "像终于吸进一口气，却只是一瞬",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "舍不得亲近，还是怕孤单到肯再受气？心慌不敢再想",
