   "groups": [
    {
     "rank": "主",
     "kind": "刚安心，又被惊醒",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，却猛然想到：以后再遇上难事，要还是只能一个人顶着，真的撑得住吗？",
