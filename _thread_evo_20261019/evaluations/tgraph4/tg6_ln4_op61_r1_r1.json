  {
   "bars": "181–205",
   "relation": "正在面对",
   "items": [
    {
     "id": "I67",
     "text": "他如今仍渴望亲近别人。",
     "key": "仍渴望亲近",
     "kind": ""
    },
    {
     "id": "I68",
     "text": "他却无法像从前那样毫无顾虑。",
     "key": "毫无顾虑",
     "kind": ""
    },
    {
     "id": "I69",
     "text": "他心里还留着旧日美好的感受。",
     "key": "美好的感受",
     "kind": ""
    },
    {
     "id": "I70",
     "text": "他如今找不到地方放心交出这些心意。",
     "key": "找不到地方",
     "kind": "满足照出未满足"
    },
    {
     "id": "I71",
     "text": "他还想念那个不用处处保护自己的自己。",
     "key": "不用处处保护",
     "kind": ""
    },
    {
     "id": "I72",
     "text": "他因记得旧日有多好，更难承受如今的孤单。",
     "key": "更难承受",
     "kind": "知道更多反而更尖锐"
    },
    {
     "id": "I73",
     "text": "他仍能从回忆里得到温暖。",
     "key": "回忆里得到温暖",
     "kind": ""
    },
    {
     "id": "I74",
     "text": "他发现回忆无法让自己过回旧日。",
     "key": "过回旧日",
     "kind": "办法的限度"
    },
    {
     "id": "I75",
     "text": "他舍不得结束回忆里的满足。",
     "key": "回忆里的满足",
     "kind": ""
    },
    {
     "id": "I76",
     "text": "他已无法忘记自己失去了那种生活。",
     "key": "无法忘记",
     "kind": ""
    }
   ],
