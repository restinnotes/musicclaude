   "relation": "没在想",
   "items": [
    {
     "id": "I34",
     "text": "心意已经这样深，他忽然不想再时时提醒自己收住喜欢。",
     "key": "不想再时时收住喜欢",
     "kind": "",
     "key_model": "收住喜欢"
    },
    {
     "id": "I35",
     "text": "他意识到先前的快乐并不依赖承诺，即使自己仍有期待，那些幸福也是真的。",
     "key": "承诺之外的快乐也真实",
     "kind": "分清",
     "key_model": "幸福也是真的"
    },
    {
     "id": "I36",
     "text": "他不想因为怕受伤就连高兴都小心翼翼，决定尽情喜欢一次，暂不追问结果。",
     "key": "尽情喜欢暂不问结果",
     "kind": "",
     "key_model": "尽情喜欢一次"
    },
    {
     "id": "I37",
     "text": "积攒的眷恋让他坦然投入，不再计算给出多少，也不提醒自己每次热切都得收回。",
     "key": "坦然投入不计算付出",
     "kind": "",
     "key_model": "坦然投入"
    },
    {
     "id": "I38",
     "text": "有一阵欢喜确实盖过顾虑，他知道没有保证，却几乎感不到那份沉重。",
     "key": "欢喜一度盖过顾虑",
     "kind": "",
