       "text": "整个人悬在半空",
       "bead": "S10-B2",
       "from": [
        "S10-B2"
       ],
       "bars": "221–225"
      },
      {
       "text": "辨不清方向",
       "bead": "S10-B2",
       "from": [
        "S10-B2"
       ],
       "bars": "221–225"
      },
