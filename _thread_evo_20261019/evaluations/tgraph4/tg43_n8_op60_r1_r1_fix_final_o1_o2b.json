   "relation_model": "正在面对",
   "items_before_reorg": [
    {
     "id": "N5",
     "text": "既然还说不清自己怕什么，他先不替喜欢安排去向；两人以后怎样，可以以后再说。",
     "from": [
      "I5"
     ],
     "key": "",
     "kind": "",
     "follows": false
    },
    {
     "id": "N6",
     "text": "这样想着，他才慢慢敢安心地靠近那个人。",
     "from": [
      "I6"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N7",
     "text": "心里的温柔可以直接给出去，不必时时打听对方有没有接住。",
     "from": [
      "I7"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N8",
     "text": "原来认真在乎一个人未必让人不安；对方再重要，他也能从容，甚至比以前自在。",
     "from": [
      "I8"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N9",
     "text": "这份快乐让他渐渐不再提防自己的喜欢，也有点欣赏自己的宽和。",
     "from": [
      "I9"
     ],
     "key": "",
     "kind": "",
     "follows": true
    },
    {
     "id": "N10",
     "text": "那时他真觉得，只要亲近自然，不追问、不计较，就已经够了。",
     "from": [
      "I10"
     ],
     "key": "",
     "kind": "",
     "follows": true
    }
   ]
