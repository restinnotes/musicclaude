     }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S06\",\n      \"links\": [\n        {\n          \"thread_quote\": \"音乐重新落入水中，却像换了一片水域。\",\n          \"bead\": \"S06/B1\",\n          \"bead_quote\": \"像重新落在一片陌生的水域\",\n          \"type\": \"承接\",\n          \"note\": \"把从孤悬状态返回水中写成进入另一片水域。\"\n        },\n        {\n          \"thread_quote\": \"先前那种暖金色的光不见了\",\n          \"bead\": \"S06/B1\",\n          \"bead_quote\": \"从暖金色的水面滑入古桥阴影\",\n          \"type\": \"承接\",\n          \"note\": \"保留色彩与温度从暖转凉的听觉变化。\"\n        },\n        {\n          \"thread_quote\": \"不必把每一份满足都追问到底\",\n          \"bead\": \"S06/B2\",\n          \"bead_quote\": \"“算了”“但还是放不下”\",\n          \"type\": \"承接\",\n          \"note\": \"将清澈新歌中的暂时放下写成一种自我安慰。\"\n        },\n        {\n          \"thread_quote\": \"然而，另一道声音始终没有完全安静。\",\n          \"bead\": \"S06/B2\",\n          \"bead_quote\": \"旁边另一条声线不时回应、插话\",\n          \"type\": \"承接\",\n          \"note\": \"把无法彻底安静的心事落实为歌声旁边持续插入的另一道声音。\"\n        },\n        {\n          \"thread_quote\": \"算了，别再逼问了。可是，真的能算了吗？\",\n          \"bead\": \"S06/B2\",\n          \"bead_quote\": \"“算了”“但还是放不下”\",\n          \"type\": \"承接\",\n          \"note\": \"将另一道声音组织成自我安慰与反问之间的往复。\"\n        },\n        {\n          \"thread_quote\": \"正因为那些亲近确实发生过，才无法轻易把心里的愿望一并收走。\",\n          \"bead\": \"S05/B2\",\n          \"bead_quote\": \"刚才仿佛还有两个人在贴近耳语\",\n          \"type\": \"回指\",\n          \"note\": \"回到水波撤去之前的亲近，以解释愿望为何无法随之消失。\"\n        },\n        {\n          \"thread_quote\": \"为什么还是如此放不下\",\n          \"bead\": \"S07/B2\",\n          \"bead_quote\": \"你明知道自己正在被卷进去，却暂时不想出来\",\n          \"type\": \"铺垫\",\n          \"note\": \"先提出无法放下的疑问，下一段再将其发展为明知沉醉却不愿抽身。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [\n        \"S06/B3\",\n        \"S06/B4\"\n      ],\n      \"retell\": false\n    },\n    {\n      \"segment\": \"S07\",\n      \"links\": [