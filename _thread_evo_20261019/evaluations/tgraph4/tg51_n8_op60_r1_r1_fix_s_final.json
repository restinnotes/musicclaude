     "id": "I33",
     "text": "他终于不想逼自己立刻选定做法，决定先缓一缓。",
     "key": "不再逼自己立刻选择",
     "kind": "",
     "key_model": "暂不逼自己选择"
    },
    {
     "id": "I34",
     "text": "他暂时让两种心思都在，继续喜欢，也接受自己无法决定对方心意。",
     "key": "容许两种心思并存",
     "kind": "",
     "follows": true,
     "key_model": "让两种心思同在"
    },
    {
     "id": "I35",
     "text": "他可以带着愿望安静喜欢，也知道自己没有把握，心里因此松开一点。",
     "key": "明知无把握仍安静喜欢",
     "kind": "",
     "follows": true,
     "key_model": "带着愿望继续喜欢"
    }
   ],
   "because": [
    {
     "from": "I32",
     "to": "I33",
     "rel": "提供理由",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "84–92",
   "relation": "正在面对",
   "items": [
    {
     "id": "I36",
     "text": "不再强迫自己消除渴望后，他重新尝到最初亲近一个人的快乐。",
     "key": "重新尝到亲近的快乐",
     "kind": "",
     "key_model": "重新尝到亲近快乐"
    },
    {
     "id": "I37",
     "text": "他尝过期待的紧张、想被珍惜的难堪，也知道深情不能替对方决定是否靠近，却仍愿全心喜欢。",
     "key": "不能代对方选择仍深爱",
     "kind": "",
     "follows": true,
     "key_model": "经历犹疑仍全心投入"
    },
    {
     "id": "I38",
     "text": "他不再靠无所求证明体贴，也愿面对自己想被珍惜的心情，即使可能受伤仍愿充分欢喜。",
     "key": "承认渴望仍愿尽情欢喜",
     "kind": "分清",
     "follows": true,
     "key_model": "体贴也容得下渴望"
    }
   ],
   "because": [
    {
     "from": "I35",
     "to": "I36",
     "rel": "唤起",
     "audit": "支持"
    },
    {
     "from": "I10",
     "to": "I37",
     "rel": "说明",
     "audit": "支持"
    },
    {
     "from": "I16",
     "to": "I37",
     "rel": "说明",
     "audit": "支持"
    },
    {
     "from": "I31",
     "to": "I37",
     "rel": "说明",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "93–102",
   "relation": "没在想",
   "items": [
    {
     "id": "I39",
     "text": "不再遮掩渴望后，他更清楚自己多想和这个人亲近。",
     "key": "坦然渴望更想亲近对方",
     "kind": "",
     "key_model": "更清楚想亲近对方"
    },
    {
     "id": "I40",
     "text": "他想被同样深切地珍惜，也想知道两人能共同拥有多丰盛的幸福。",
     "key": "想被深切珍惜共享幸福",
     "kind": "",
     "follows": true,
     "key_model": "盼共同拥有深切幸福"
    },
    {
     "id": "I41",
     "text": "那阵满足强烈得让他几乎顾不上别的，只觉得能这样爱着已充实得不可思议，暂时也想不到以后。",
     "key": "沉浸爱中暂不去想以后",
     "kind": "",
     "follows": true,
     "key_model": "此刻爱着已足够充实"
    }
   ],
   "because": [
    {
     "from": "I38",
     "to": "I39",
     "rel": "唤起",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "没在想": 4,
    "正在面对": 2
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "103–110",
   "relation": "正在面对",
   "items": [
    {
     "id": "I42",
     "text": "幸福仍然鲜明时，他忽然感到心里有一处始终没有着落。",
     "key": "幸福鲜明仍觉心无着落",
     "kind": "满足照出未满足",
     "key_model": "幸福里仍有未满足"
    },
    {
     "id": "I43",
     "text": "他可以充分拥有自己的深情，却不能凭这份深情决定对方也同样选择自己。",
     "key": "深情不能决定对方选择",
     "kind": "",
     "follows": true,
     "key_model": "深情不能替人选择"
    },
    {
     "id": "I44",
     "text": "那份酸楚没有推翻刚才的欢喜，反而因欢喜如此真实而格外难以忽略。",
     "key": "欢喜越真酸楚越难忽略",
     "kind": "知道更多反而更尖锐",
     "follows": true,
     "key_model": "欢喜使酸楚更清楚"
    },
    {
     "id": "I45",
     "text": "他希望对方接受心意时仍能自在，也想保留这份给过自己巨大幸福的感情，不把全部不安交给对方处理。",
     "key": "愿对方自在也留住喜欢",
     "kind": "",
     "follows": true,
     "key_model": "不让对方负责不安"
    },
    {
     "id": "I46",
     "text": "他发现克制能让自己安心，却不能让渴望消失，尽情投入带来幸福，也仍可能失望。",
     "key": "克制难消渴望也会失望",
     "kind": "办法的限度",
     "follows": true,
     "key_model": "克制投入各有难处"
    },
    {
     "id": "I47",
     "text": "他仍急切想靠近，也坚持让对方自愿靠近，宁愿把这两种心思都留着。",
     "key": "想靠近却坚持对方自愿",
     "kind": "",
     "follows": true,
     "key_model": "想靠近也尊重自愿"
    }
   ],
   "because": [
    {
     "from": "I41",
     "to": "I42",
     "rel": "限制",
     "audit": "支持"
    },
    {
     "from": "I31",
     "to": "I43",
     "rel": "仍在起作用",
     "audit": "支持"
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对"
  },
  {
   "bars": "111–116",
   "relation": "正在面对",
   "items": [
    {
     "id": "I48",
     "text": "他渐渐接受，认真喜欢一个人也可能让自己受伤。",
     "key": "接受喜欢也可能受伤",
     "kind": "",
     "key_model": "接受爱有受伤风险"
    },
    {
     "id": "I49",
     "text": "他仍想被对方选择，因为对方确实重要，即使愿望未必实现，也愿意面对这份盼望。",
     "key": "仍盼被选也愿面对期待",
     "kind": "",
     "key_model": "仍盼对方选择"
    },
    {
     "id": "I50",
     "text": "他仍舍不得放下克制，因为对方有自己的心意，若要对方消除他全部不安，亲近也会变得不自在。",
     "key": "不让对方承担全部不安",
     "kind": "",
     "key_model": "尊重对方自己的心意"
    },
    {
     "id": "I51",
     "text": "他仍会遗憾，却知道带着遗憾也能好好喜欢一个人。",
     "key": "带着遗憾也能好好喜欢",
     "kind": "选择的代价",
     "follows": true,
     "key_model": "带着遗憾继续喜欢"
    },
    {
     "id": "I52",
     "text": "他知道先前的快乐都真实发生过，也让他看清对方多么重要，最后的难题仍没抹掉这些快乐。",
     "key": "难题抹不掉真实快乐",
     "kind": "",
     "key_model": "旧日快乐都是真切"
    },
    {
     "id": "I53",
     "text": "他仍盼对方珍惜自己，也知道自己的真心由自己判断，克制多少只是当下的选择。",
     "key": "自认真心仍盼被珍惜",
     "kind": "",
     "key_model": "真心由自己判断"
    },
    {
     "id": "I54",
     "text": "他知道以后仍可能想要更多、因不能更近而疼痛，却不拿这些感受否认真心或催促对方。",
     "key": "痛也不否认更不催促",
     "kind": "",
     "follows": true,
     "key_model": "预见疼痛也不催促"
    },
    {
     "id": "I55",
     "text": "他愿继续把对方放在心里，认真喜欢、充分欢喜，也接受自己无法决定的那部分。",
     "key": "继续喜欢接受无法掌控",
     "kind": "",
     "follows": true,
     "key_model": "继续喜欢并接受未知"
    },
    {
     "id": "I56",
     "text": "他既渴望被爱，也让对方自由选择，仍认真喜欢，不因未得一切就先放弃这份爱。",
     "key": "渴望被爱仍尊重选择",
     "kind": "",
     "follows": true,
     "key_model": "渴望与自由都保留"
    }
   ],
