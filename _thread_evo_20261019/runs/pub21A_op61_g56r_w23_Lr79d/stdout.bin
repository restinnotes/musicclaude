{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"像烟雾往高处散，声音轻了、远了，悬在半空。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"我不能倒下，可我其实很想停下来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他已经离开那段熟悉的生活\",\n          \"point\": \"不用再一次次委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初还觉得\"\n        },\n        {\n          \"text\": \"可这份笃定没撑多久\",\n          \"point\": \"说不清到底舍不得什么\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这份笃定没撑多久\"\n        },\n        {\n          \"text\": \"偶尔想起从前熟悉的日子\",\n          \"point\": \"不知道以后靠什么让自己安下心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"还是想往前过，却\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"模糊地哼\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"悲伤还在，只是不愿把自己完全交给悲伤。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"悲伤还在\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他舍不得从前