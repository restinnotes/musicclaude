{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/music-bead/structure-output-contract",
  "title": "Generic independent structural segmentation result",
  "description": "Workflow interface contract, not a claim of independent score validation; natural phrase boundaries can be ambiguous.",
  "type": "object",
  "required": [
    "work",
    "scope",
    "macro_segments",
    "unresolved_boundaries"
  ],
  "properties": {
    "work": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_access": {
      "type": "object",
      "properties": {
        "read_score": {
          "type": "boolean"
        },
        "listened_to_recording": {
          "type": "boolean"
        },
        "looked_up_external_analysis": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "url_or_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_type": {
            "type": "string"
          },
          "specific_support": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "source_links": {
      "type": "array"
    },
    "macro_segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "start_measure",
          "end_measure",
          "neutral_label",
          "boundary_reason",
          "evidence_ids",
          "confidence"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "start_measure": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "end_measure": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "start_time": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "end_time": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "neutral_label": {
            "type": "string"
          },
          "boundary_reason": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "internal_notes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "edition": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "secondary_boundaries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved_boundaries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "FREEZE_READY": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
