      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S07",
    "bars": "51–61",
    "relation": "正在面对",
    "items": [
     {
      "id": "S07-1",
      "text": "这份自在让他更想亲近，交出难说的爱。",
      "key": "这份自在让他更想",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-2"
      ]
     },
     {
      "id": "S07-2",
      "text": "他想多给温柔，也把对方的心意接住。",
      "key": "他想多给温柔，也",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S07-3",
      "text": "怕这份好留不住，他不肯少爱，哪怕更痛。",
      "key": "怕这份好留不住，",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-1"
      ]
     },
     {
      "id": "S07-4",
      "text": "独自回味亲近，舒服和遐想让他忘了别的。",
      "key": "独自回味亲近，舒",
      "follows": false,
      "explains": [],
      "cite": []
     }
    ],
    "because": [
     {
