{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"先向高处迸发，细碎的光点再缓缓飘落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"还不是整个人已经安稳地交给规律起伏的水浪\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没交给规律水浪\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越清楚，越小心\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然很想靠近对方\",\n          \"point\": \"很想靠近对方\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"忽然；连自己都吓了一跳\"\n        },\n        {\n          \"text\": \"他只敢流露出一点喜欢\",\n          \"point\": \"只敢流露出一点喜欢\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"怕给对方太大负担\"\n        },\n        {\n          \"text\": \"只是这一点亲近就很甜\",\n          \"point\": \"还不敢更坦白\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"这一点亲近就很甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"裹在皮肤上有些黏稠\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"可以放弃对重力的控制，把身体交给船底温柔的托举\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"放弃重力控制\"\n        },\n        {\n          \"quote\": \"因为太喜欢眼前的东西，所以还没有失去，就已经生出一丝舍不得\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"越喜欢，越先舍不得\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"t