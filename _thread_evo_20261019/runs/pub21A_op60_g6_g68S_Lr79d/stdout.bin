"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"却\"\n        },\n        {\n          \"text\": \"安静下来\",\n          \"point\": \"不知道他有多害怕\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"安静下来；才发现\"\n        },\n        {\n          \"text\": \"他又猜\",\n          \"point\": \"也舍不得这份亲近\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又猜；会不会\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"fine\": [\n        {\n          \"quote\": \"原先压着的感受反而变成了动力\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"越舒服，越让人失去方向\",\n          \"carrier\": \"副词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"跟他在一起也能安心些\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"也能安心些\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他渐渐觉得\",\n          \"point\": \"对方或许也需要他陪着\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"渐渐；或许\"\n        },\n        {\n          \"text\": \"他越想越高兴\",\n          \"point\": \"越舍不得抽身\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"越想越高兴\"\n        },\n        {\n          \"text\": \"他盼着以后\",\n          \"point\": \"还会想到自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"以后；想找人时\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"没有哲学，没有防卫，没有分析\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"连身体也像恢复了弹性\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n        