    {
      "sec": "S03",
      "body_font": 28,
      "bead_nodes": [
        "S03-B1",
        "S03-B2",
        "S03-B3"
      ],
      "bead_edges": [
        {
          "a": "S03-B1",
          "b": "S03-B2",
          "type": "段内先后",
          "note": "B1是持续的摇曳、漂浮状态；约20–21小节，B2的短促声音在这片流动中突然出现，又迅速消失。背景摇曳并未因此停止。"
        },
        {
          "a": "S03-B1",
          "b": "S03-B3",
          "type": "可同时成立",
          "note": "身体仍被水波托着，局部流动却可以出现阻力。舒服的走神与短暂的犹疑并不矛盾。B3的破碎倒影则是比舒适漂浮更纷乱的一种心理画面，不应把两个原稿的人物故事强行接在一起。"
        },
        {
          "a": "S03-B2",
          "b": "S03-B3",
          "type": "重叠但新增",
          "note": "二者都涉及20–22附近的不平稳，但B2是几句短促声音突然冒头、又沉没；B3是较持续的绕远、滞留、被暗流拖住。碎裂倒影还提供一种难以拼凑的感官画面。它们不是同一个动作换三种说法，也没有证据表明存在固定的因果先后。"
        }
      ],
