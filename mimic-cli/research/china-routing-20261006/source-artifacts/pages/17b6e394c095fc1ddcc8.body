/smartphones-devices" target="_self" data-discover="true">Smartphones &amp; Devices</a></li><li class="ArticleBase-Topic"><a data-component="keyword" class="Keyword Keyword_variant_category Keyword_title_customerExperience" href="/digital-transformation/customer-experience" target="_self" data-discover="true">Customer Experience</a></li><li class="ArticleBase-Topic"><a data-component="keyword" class="Keyword Keyword_variant_category Keyword_title_news" href="/latest-news" target="_self" data-discover="true">News</a></li></ul><div><h1 class="ArticleBase-HeaderTitle ArticleBase-HeaderTitleLayout"><span class="ArticleBase-DefaultTitle" data-testid="article-default-title">AT&amp;T, T-Mobile and Verizon's smartphone promotions push Q2 sales performance – report</span></h1><p class="ArticleBase-HeaderSummary" data-testid="article-summary">Carrier promotions have played an important role in increasing smartphone sell-through rates for the Big Three mobile operators in Q2 of 2025, according to Counterpoint Research.</p></div></div></div><div class="TwoColumnLayout-VideoSection"></div><div class="TwoColumnLayout-Content"><div class="TwoColumnLayout-Body"><div class="ArticleBase-Body ArticleBase-BodyLayout" data-testid="article-base-body"><div class="ArticleBase-Contributors ArticleBase-ContributorsLayout" data-testid="article-base-contributors"><div class="Contributors Contributors_variant_normal Contributors_hasAvatar" data-component="contributors"><div class="Contributors-AvatarWrapper"><a class="Contributors-AvatarLink" aria-label="Kelsey Ziser" href="/author/kelsey-ziser" target="_self" data-discover="true"><img aria-hidden="true" data-testid="contributor-avatar" data-component="image" class="Contributors-Avatar" data-src="https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blta3d74b6fc2bf93c6/679bd9e67303e7fcc4463433/Kelsey_2025_2.jpg?width=100&amp;auto=webp&amp;quality=80&amp;disable=upscale" src="https://eu-images.contentstack.com/v3/assets/blt23eb5bbc4124baa6/blta3d74b6fc2bf93c6/679bd9e67303e7fcc4463433/Kelsey_2025_2.jpg?width=100&amp;auto=webp&amp;quality=80&amp;disable=upscale" loading="lazy" alt="Picture of Kelsey Ziser" title="Picture of Kelsey Ziser"/></a></div><div class="Contributors-InfoWrapper"><a class="Contributors-ContributorName" data-testid="contributor-name" href="/author/kelsey-ziser" target="_self" data-discover="true">Kelsey Ziser<!-- -->,</a><span class="Contributors-ContributorTitle" data-testid="contributor-title">Senior Editor<!-- -->,</span><span class="Contributors-ContributorTitle" data-testid="contributor-title">Light Reading</span><p class="Contributors-Date" data-testid="contributors-date">August 19, 2025</p></div></div><div data-component="article-read-time" class="ArticleReadTime ArticleReadTime_size_normal"><span data-component="icon" style="mask-image:url(&quot;data:image/svg+xml,%3csvg%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20width=&#x27;14&#x27;%20height=&#x27;14&#x27;%20viewBox=&#x27;0%200%2014%2014&#x27;%3e%3cpath%20id=&#x27;Icon_awesome-clock&#x27;%20data-name=&#x27;Icon%20awesome-clock&#x27;%20d=&#x27;M7.563.563a7,7,0,1,0,7,7A7,7,0,0,0,7.563.563Zm1.612,9.882L6.685,8.635a.341.341,0,0,1-.138-.274V3.611a.34.34,0,0,1,.339-.339H8.24a.34.34,0,0,1,.339.339V7.5l1.792,1.3a.339.339,0,0,1,.073.474l-.8,1.1A.341.341,0,0,1,9.174,10.444Z&#x27;%20transform=&#x27;translate(-0.563%20-0.563)&#x27;/%3e%3c/svg%3e&quot;);-webkit-mask-image:url(&quot;data:image/svg+xml,%3csvg%20xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%20width=&#x27;14&#x27;%20height=&#x27;14&#x27;%20viewBox=&#x27;0%200%2014%2014&#x27;%3e%3cpath%20id=&#x27;Icon_awesome-clock&#x27;%20data-name=&#x27;Icon%20awesome-clock&#x27;%20d=&#x27;M7.563.563a7,7,0,1,0,7,7A7,7,0,0,0,7.563.563Zm1.612,9.882L6.685,8.635a.341.341,0,0,1-.138-.274V3.611a.34.34,0,0,1,.339-.339H8.24a.34.34,0,0,1,.339.339V7.5l1.792,1.3a.339.339,0,0,1,.073.474l-.8,1.1A.341.341,0,0,1,9.174,10.444Z&#x27;%20transform=&#x27;translate(-0.563%20-0.563)&#x27;/%3e%3c/svg