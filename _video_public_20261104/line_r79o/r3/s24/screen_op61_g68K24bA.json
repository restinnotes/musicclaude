{
 "uniform": true,
 "sections": [
  {
   "sec": "S01",
   "rows": [
    {
     "kind": "line",
     "text": "他离开熟悉生活不再委屈自己",
     "keys": [
      "不再委屈自己"
     ],
     "emotion": "不安",
     "from": [
      "S01-1"
     ]
    },
    {
     "kind": "line",
     "text": "他挺直背脊却不知往哪走",
     "keys": [
      "挺直背脊"
     ],
     "emotion": "炽热",
     "from": [
      "S01-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "我不能倒下，可其实很想停下来",
       "bead": "S01-B2",
       "from": [
        "S01-B2"
       ],
       "bars": "1–23"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可心里很快空了下来",
     "keys": [
      "空了下来"
     ],
     "emotion": "孤单",
     "from": [
      "S01-2",
      "S01-B3",
      "S01-B4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像从漫长昏沉里醒来，四周冷而空",
       "bead": "S01-B4",
       "from": [
        "S01-B4"
       ],
       "bars": "1–23"
      },
      {
       "text": "胸口发紧，视线模糊，伸手只摸到虚空",
       "bead": "S01-B4",
       "from": [
        "S01-B4"
       ],
       "bars": "1–23"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他一时说不清舍不得什么",
     "keys": [
      "说不清"
     ],
     "emotion": "悬着",
     "from": [
      "S01-2",
      "S01-B3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "怒气、遗憾还是怀念，自己也分不清",
       "bead": "S01-B3",
       "from": [
        "S01-B3"
       ],
       "bars": "1–23"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想往前过却不知怎样安心",
     "keys": [
      "不知怎样安心"
     ],
     "emotion": "悬着",
     "from": [
      "S01-3",
      "S01-B5"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "旧日声音光线回来，却不能变回现在",
       "bead": "S01-B5",
       "from": [
        "S01-B5"
       ],
       "bars": "9–17"
      },
      {
       "text": "身体先记起了该怎样迈步",
       "bead": "S01-B5",
       "from": [
        "S01-B5"
       ],
       "bars": "18–23"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "沉重声音刚落，轻飘音符便像烟雾升高",
     "bars": "1–6",
     "from": [
      "S01-B1"
     ]
    },
    {
     "text": "像一次召唤，停顿里仿佛还等着回声",
     "bars": "1–6",
     "from": [
      "S01-B1"
     ]
    },
    {
     "text": "短句像叹息，刚冒出就被长停顿截断",
     "bars": "1–23",
     "from": [
      "S01-B3"
     ]
    },
    {
     "text": "余音在冰冷空气里慢慢散尽",
     "bars": "1–23",
     "from": [
      "S01-B3"
     ]
    },
    {
     "text": "旋律轮廓稍稍清楚起来",
     "bars": "9–17",
     "from": [
      "S01-B5"
     ]
    },
    {
     "text": "熟悉的舞步渐渐浮现",
     "bars": "18–23",
     "from": [
      "S01-B5"
     ]
    },
    {
     "text": "声音轻了又远了，像悬在半空",
     "bars": "1–6",
     "from": [
      "S01-B1"
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "rows": [
    {
     "kind": "line",
     "text": "他舍不得从前自在的日子",
     "keys": [
      "舍不得"
     ],
     "emotion": "亲密",
     "from": [
      "S02-1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "远处旧歌只能模糊哼出几句",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24–65"
      },
      {
       "text": "庄严舞步里藏着私人低声哼唱",
       "bead": "S02-B1",
       "from": [
        "S02-B1"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想到以后不能那样过就慌",
     "keys": [
      "就慌"
     ],
     "emotion": "不安",
     "from": [
      "S02-1",
      "S02-B1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像腿脚虚浮，在记忆里挪动舞步",
       "bead": "S02-B2",
       "from": [
        "S02-B2"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他赶紧想起受过的那些气",
     "keys": [
      "受过的那些气"
     ],
     "emotion": "炽热",
     "from": [
      "S02-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像整理好衣服，抬头不让人看出动摇",
       "bead": "S02-B4",
       "from": [
        "S02-B4"
       ],
       "bars": "24–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "怕一心软就忘了为何离开",
     "keys": [
      "忘了为何离开"
     ],
     "emotion": "不安",
     "from": [
      "S02-2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "先有几分相信，后来越说越露出在意",
       "bead": "S02-B4",
       "from": [
        "S02-B4"
       ],
       "bars": "44–65"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可他不甘心连好日子也丢掉",
     "keys": [
      "不甘心"
     ],
     "emotion": "炽热",
     "from": [
      "S02-3",
      "S02-B5"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "激昂像在喊我不甘心就这样消亡",
       "bead": "S02-B5",
       "from": [
        "S02-B5"
       ],
       "bars": "44–65"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "节奏庄严得近乎傲慢，旋律却脆弱凄婉",
     "bars": "24–65",
     "from": [
      "S02-B2"
     ]
    },
    {
     "text": "细碎不安的声音在伴奏里蠕动",
     "bars": "24–65",
     "from": [
      "S02-B2"
     ]
    },
    {
     "text": "音乐猛地往上推，又退了下来",
     "bars": "38–43",
     "from": [
      "S02-B3"
     ]
    },
    {
     "text": "再次聚力，越到后面越焦灼，仍未落稳",
     "bars": "44–65",
     "from": [
      "S02-B3"
     ]
    },
    {
     "text": "一串连绵的小音符把呼吸催得越来越急",
     "bars": "56–65",
     "from": [
      "S02-B3"
     ]
    },
    {
     "text": "舞步清楚了，却不像英雄凯旋",
     "bars": "24–65",
     "from": [
      "S02-B1"
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "rows": [
    {
     "kind": "line",
     "text": "他心里还憋着一股气",
     "keys": [
      "憋着一股气"
     ],
     "emotion": "炽热",
     "from": [
      "S03-1",
      "S03-B1"
     ]
    },
    {
     "kind": "line",
     "text": "被当作自己人他开心了一会儿",
     "keys": [
      "开心了一会儿"
     ],
     "emotion": "亲密",
     "from": [
      "S03-1",
      "S03-B2"
     ]
    },
    {
     "kind": "line",
     "text": "那时自在亲近不必时时防备",
     "keys": [
      "不必时时防备"
     ],
     "emotion": "安心",
     "from": [
      "S03-1",
      "S03-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "后半像故乡夏日麦浪和微风",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "80–91"
      },
      {
       "text": "温柔得心颤，也刺痛得绝望",
       "bead": "S03-B2",
       "from": [
        "S03-B2"
       ],
       "bars": "80–91"
      }
     ]
    },
    {
     "kind": "line",
     "text": "那点轻松没能替心事解围",
     "keys": [
      "没能替心事解围"
     ],
     "emotion": "悬着",
     "from": [
      "S03-2",
      "S03-B3"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "聊点别的或出去走走，轻松片刻是真的",
       "bead": "S03-B3",
       "from": [
        "S03-B3"
       ],
       "bars": "66–91"
      },
      {
       "text": "像几个人在耳边低声絮语",
       "bead": "S03-B4",
       "from": [
        "S03-B4"
       ],
       "bars": "66–91"
      },
      {
       "text": "脚下像流沙，抓不住重心，四处漂移",
       "bead": "S03-B4",
       "from": [
        "S03-B4"
       ],
       "bars": "66–91"
      }
     ]
    },
    {
     "kind": "line",
     "text": "从前过不成离开会更好吗？",
     "keys": [
      "会更好吗？"
     ],
     "emotion": "不安",
     "from": [
      "S03-2",
      "S03-B5"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "我是真的相信，还是只在努力相信？",
       "bead": "S03-B5",
       "from": [
        "S03-B5"
       ],
       "bars": "66–91"
      }
     ]
    }
   ],
   "notes": [
    {
     "text": "开头那一下若格外沉重，会像重锤砸下",
     "bars": "66",
     "from": [
      "S03-B1"
     ]
    },
    {
     "text": "节奏忽然错开，让人心里悬着",
     "bars": "66–91",
     "from": [
      "S03-B1"
     ]
    },
    {
     "text": "前半段焦躁急切，像急着找方向",
     "bars": "66–79",
     "from": [
      "S03-B2"
     ]
    },
    {
     "text": "后半段忽然柔和，带着田园般轻盈",
     "bars": "80–91",
     "from": [
      "S03-B2"
     ]
    },
    {
     "text": "端正步子转成灵活流动、难以安定的舞步",
     "bars": "66–91",
     "from": [
      "S03-B1"
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "rows": [
    {
     "kind": "line",
     "text": "他真盼着还能那样亲近",
     "keys": [
      "真盼着"
     ],
     "emotion": "亲密",
     "from": [
      "S04-1",
      "S04-B1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "记忆里还留着感激和柔情",
       "bead": "S04-B1",
       "from": [
        "S04-B1"
       ],
       "bars": "92–107"
      }
     ]
    },
    {
     "kind": "line",
     "text": "旧日亲近让他幸福也更易受伤",
     "keys": [
      "更易受伤"
     ],
     "emotion": "悬着",
     "from": [
      "S04-B1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "那份坚定也像他努力想成为的样子",
       "bead": "S04-B1",
       "from": [
        "S04-B1"
       ],
       "bars": "92–107"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可当初的委屈也翻了上来",
     "keys": [
      "委屈"
     ],
     "emotion": "不安",
     "from": [
      "S04-2",
      "S04-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "记忆太好，才刺痛得回不去了",
       "bead": "S04-B2",
       "from": [
        "S04-B2"
       ],
       "bars": "92–115"
      },
      {
       "text": "细碎音符像急促脚步或乱拍心跳",
       "bead": "S04-B3",
       "from": [
        "S04-B3"
       ],
       "bars": "92–115"
      },
      {
       "text": "像被时间催着跑，身体无法停下",
       "bead": "S04-B3",
       "from": [
        "S04-B3"
       ],
       "bars": "92–115"
      }
     ]
    },
    {
     "kind": "line",
     "text": "那一步走对了吗还后悔吗？",
     "keys": [
      "走对了吗"
     ],
     "emotion": "悬着",
     "from": [
      "S04-2",
      "S04-B4"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "不停往前赶，只为不让自己停下",
       "bead": "S04-B4",
       "from": [
        "S04-B4"
       ],
       "bars": "94–115"
      }
     ]
    },
    {
     "kind": "line",
     "text": "如果没走如今又会怎样？",
     "keys": [
      "又会怎样？"
     ],
     "emotion": "不安",
     "from": [
      "S04-2",
      "S04-B4"
     ]
    }
   ],
   "notes": [
    {
     "text": "温暖之后忽然显出风暴般的激烈紧绷",
     "bars": "108–115",
     "from": [
      "S04-B2"
     ]
    },
    {
     "text": "一股向下的声音像撕扯着步步后退",
     "bars": "108–115",
     "from": [
      "S04-B2"
     ]
    },
    {
     "text": "低沉声音追赶，高处旋律慌乱挣扎",
     "bars": "92–115",
     "from": [
      "S04-B3"
     ]
    },
    {
     "text": "流动的声音和细碎点缀让主题更像私语",
     "bars": "92–107",
     "from": [
      "S04-B1"
     ]
    },
    {
     "text": "向后退的声音显得疲惫又仓促",
     "bars": "108–115",
     "from": [
      "S04-B2"
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "rows": [
    {
     "kind": "line",
     "text": "他仍觉得当初那些气不该忍",
     "keys": [
      "不该忍"
     ],
     "emotion": "炽热",
     "from": [
      "S05-1",
      "S05-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像夜色里两个影子低声说话",
       "bead": "S05-B1",
       "from": [
        "S05-B1"
       ],
       "bars": "116–147"
      },
      {
       "text": "柔和歌声仍像在说不能就这样算了",
       "bead": "S05-B2",
       "from": [
        "S05-B2"
       ],
       "bars": "116–127"
      }
     ]
    },
    {
     "kind": "line",
     "text": "可连开心的回忆都不敢多想",
     "keys": [
      "不敢多想"
     ],
     "emotion": "不安",
     "from": [
      "S05-1"
     ]
    },
    {
     "kind": "line",
     "text": "跟自己争得没了力气",
     "keys": [
      "没了力气"
     ],
     "emotion": "孤单",
     "from": [
      "S05-2",
      "S05-B5"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像几次深呼吸，抵抗累了却未想通",
       "bead": "S05-B5",
       "from": [
        "S05-B5"
       ],
       "bars": "约132–147（重点144–147）"
      }
     ]
    },
    {
     "kind": "line",
     "text": "那股不服气也渐渐淡了",
     "keys": [
      "渐渐淡了"
     ],
     "emotion": "悬着",
     "from": [
      "S05-2",
      "S05-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "旧日记忆重新有了温度",
       "bead": "S05-B3",
       "from": [
        "S05-B3"
       ],
       "bars": "116–147"
      },
      {
       "text": "可能是某个人，也可能是故乡或旧生活",
       "bead": "S05-B3",
       "from": [
        "S05-B3"
       ],
       "bars": "116–147"
      },
      {
       "text": "流动渐稀，像脚下地板忽然不见",
       "bead": "S05-B4",
       "from": [
        "S05-B4"
       ],
       "bars": "128–147"
      }
     ]
    },
    {
     "kind": "line",
     "text": "想到已不在他们身边就难受",
     "keys": [
      "不在他们身边"
     ],
     "emotion": "孤单",
     "from": [
      "S05-2",
      "S05-B3"
     ]
    }
   ],
   "notes": [
    {
     "text": "快速声音渐渐放缓变稀，最后只剩疏落声响",
     "bars": "128–147",
     "from": [
      "S05-B4"
     ]
    },
    {
     "text": "旋律几乎单独露出来，像只剩一个声音",
     "bars": "128–129；139–144",
     "from": [
      "S05-B4"
     ]
    },
    {
     "text": "声音稀疏下来，像一声深深的叹息",
     "bars": "144–147",
     "from": [
      "S05-B5"
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "rows": [
    {
     "kind": "line",
     "text": "难受暂缓现实还隔着玻璃罩",
     "keys": [
      "暂缓"
     ],
     "emotion": "安心",
     "from": [
      "S06-1",
      "S06-B1"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "像母亲耳边摇篮曲，温柔得让人松开戒备",
       "bead": "S06-B1",
       "from": [
        "S06-B1"
       ],
       "bars": "148–180"
      }
     ]
    },
    {
     "kind": "line",
     "text": "他终于不用解释也不必装坚强",
     "keys": [
      "不必装坚强"
     ],
     "emotion": "安心",
     "from": [
      "S06-1",
      "S06-B2"
     ]
    },
    {
     "kind": "feel",
     "items": [
      {
       "text": "压住的愿望、委屈和思念浮上来",
       "bead": "S06-B2",
       "from": [
        "S06-B2"
       ],
       "bars": "148–180"
      },
      {
       "text": "像向遥远未知处祈求，却未必有回应",
       "bead": "S06-B2",
