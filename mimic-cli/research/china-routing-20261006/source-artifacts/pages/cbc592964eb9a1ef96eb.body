  }
  table tbody tr:nth-child(1) td:nth-child(1) {
    color: #fff !important;
    font-weight: 600;
    text-transform: capitalize;
    font-family: math;
    border-right: 1px solid #a6d2df;
  }
  table tbody tr:nth-child(1) td {
    color: #fff !important;
    font-family: math;
    padding: 10px;
  }
  table tbody tr td:nth-child(1) {
    font-weight: 600;
    text-transform: capitalize;
    font-family: math;
  }
  table tbody tr td {
    padding: 10px;
  }
  .report-prose table,
  .mck-article table {
    width: 100%;
    border-collapse: collapse;
    border-spacing: 0;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(18, 55, 87, 0.12);
    color: #003366;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 15.5px;
    line-height: 1.55;
  }
  .report-prose table thead tr,
  .mck-article table thead tr,
  .report-prose table tbody tr:first-child,
  .mck-article table tbody tr:first-child {
    background: #123757 !important;
    color: #ffffff !important;
  }
  .report-prose table th,
  .mck-article table th,
  .report-prose table tbody tr:first-child td,
  .mck-article table tbody tr:first-child td {
    padding: 16px 18px;
    background: transparent !important;
    border: 0 !important;
    color: #ffffff !important;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.55;
    text-transform: none;
  }
  .report-prose table tbody tr,
  .mck-article table tbody tr {
    background: #ffffff !important;
  }
  .report-prose table tbody tr:nth-child(even),
  .mck-article table tbody tr:nth-child(even) {
    background: #f4f7fd !important;
  }
  .report-prose table td,
  .mck-article table td {
    padding: 16px 18px;
    background: transparent !important;
    border: 0 !important;
    border-top: 1px solid #dfe7ef !important;
    color: #003366 !important;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 15.5px;
    font-weight: 400;
    line-height: 1.55;
    text-transform: none;
  }
  .report-prose table td:first-child,
  .mck-article table td:first-child,
  .report-prose table.rd-table--two-col td:first-child,
  .mck-article table.rd-table--two-col td:first-child {
    color: #004392 !important;
    font-weight: 800;
  }
  .report-prose table.rd-table--cols-4 td:nth-child(2),
  .mck-article table.rd-table--cols-4 td:nth-child(2) {
    color: #062f55 !important;
    font-size: 17px;
    font-weight: 800;
  }
  .report-prose table.rd-table--cols-4 td:nth-child(3),
  .mck-article table.rd-table--cols-4 td:nth-child(3) {
    color: #003b78 !important;
    font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .report-prose table tbody tr:first-child td:first-child,
  .mck-article table tbody tr:first-child td:first-child,
  .report-prose table.rd-table--two-col tbody tr:first-child td:first-child,
  .mck-article table.rd-table--two-col tbody tr:first-child td:first-child {
    color: #ffffff !important;
    font-weight: 800;
  }
  .head {
    font-weight: 600;
    display: contents;
  }
  p {
    margin-bottom: 10px;
  }
  h4 {
    font-size: 16px;
    font-weight: 700;
    margin-top: 10px;
    margin-bottom: 10px;
  }
  .prose.max-w-none p {
    display: block;
  }
  b.list-bullet {
    margin-bottom: 17px;
    font-weight: 600;
    margin-left: 25px;
    list-style: disc !important;
    margin-top: 10px;
    line-height: 27px;
  }
  .seg-region {
    font-weight: 700;
    font-size: 1.05rem;
    display: inline-block;
    margin-top: .5rem;
  }
  .seg-h4 {
    margin-top: 1rem;
  }
  .display-block {
    display: block;
  }
  .er-hero-heading {
    max-width: 1200px;
  }
  .er-hero-heading .er-hero-title-main {
    display: block;
  }
  .er-hero-heading .er-hero-title-sub {
    display: block;
    margin-top: 1rem;
    max-width: 78rem;
    font-size: 0.35em;
    line-height: 1.75;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }
  .key-insights li {
    color: #131010;
    line-height: 23px;
  }
  #rd-summary {
    margin-top: 0 !important;
  }
  .cv-auto {
    content-visibility: auto;
    contain-intrinsic-size: 900px;
  }
  @keyframes logosScrollR {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes logosScrollL {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  @media (max-width: 767px) {
    :root {
      --er-header-offset: 64px;
      --er-actionbar-height: 56px;
    }
    .rd-actionbar {
      min-height: var(--er-actionbar-height);
      height: auto;
    }
    .rd-actionbar__inner {
      min-height: var(--er-actionbar-height);
      padding: 6px 10px;
      gap: 8px;
    }
    .rd-actionbar__brand {
      width: 52px;
      padding: 4px 0;
    }
    .rd-actionbar__brand img {
      max-width: 48px;
      max-height: 34px;
      object-fit: contain;
      object-position: left center;
    }
    .rd-actionbar__title {
      display: none;
    }
    .rd-actionbar__actions {
      flex: 1 1 auto;
      min-width: 0;
      gap: 8px;
    }
    .rd-actionbar__btn {
      flex: 1 1 0;
      min-width: 0;
      min-height: 42px;
      padding: 0 9px;
      gap: 6px;
      font-size: 12.5px;
      white-space: nowrap;
    }
    .rd-actionbar__btn svg {
      width: 15px;
      height: 15px;
    }
    .rd-sidebar-sample {
      border-width: 1px;
      border-radius: 14px;
    }
    .rd-sidebar-sample__media {
      min-height: 76px;
      padding: 16px 18px 13px;
    }
    .rd-sidebar-sample__body {
      padding: 16px 18px 16px;
    }
    #emer-market-size .section-title {
      font-size: 24px;
    }
    .rd-market-metrics {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .rd-market-metric {
      min-height: 112px;
      padding: 22px 18px;
    }
    .rd-inline-cta,
    .figure-cta-strip,
    .figure-cta-strip--dark,
    .company-overview-cta {
      margin: 18px 0 20px !important;
      padding: 16px 16px 15px;
    }
    .company-overview-cta__inner {
      display: block;
    }
    .rd-inline-cta__label,
    .company-overview-cta__eyebrow {
      margin-bottom: 8px;
    }
    .rd-inline-cta__title {
      margin-bottom: 8px;
      font-size: 16px;
    }
    .rd-inline-cta__actions,
    .figure-cta-actions,
    .figure-cta-strip--dark .figure-cta-actions,
    .company-overview-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      width: auto;
      margin-top: 0;
    }
    .rd-inline-cta__btn,
    .rd-inline-cta__link,
    .figure-cta-btn,
    .figure-cta-strip--dark .figure-cta-btn,
    .company-overview-cta__btn {
      width: auto;
      min-height: 38px;
      padding: 10px 14px;
      background: #ff6b1a;
      border-color: #ff6b1a;
      color: #ffffff !important;
      -webkit-text-fill-color: #ffffff;
      white-space: normal;
    }
    .rd-inline-cta__link {
      margin-left: 0;
    }
    .report-prose .rd-inline-cta {
      padding: 18px 16px;
      background: #123f63;
    }
    .report-prose .rd-inline-cta__actions {
      display: flex;
      gap: 10px;
      margin-top: 0;
    }
    .report-prose .rd-inline-cta__btn,
    .report-prose .rd-inline-cta__link {
      min-height: 38px;
      padding: 10px 14px;
      background: #ff6b1a;
      color: #ffffff !important;
      -webkit-text-fill-color: #ffffff;
      white-space: normal;
    }
    .report-prose .rd-inline-cta__link {
      margin-left: 0;
    }
    .report-shell {
      padding-bottom: 96px;
    }
    .er-authorbar {
      display: none !important;
    }
    .er-inline-cta-copy {
      font-size: 1rem;
      line-height: 1.65;
    }
    .logos-hdr {
      padding: 14px 20px 4px;
    }
    .logos-hdr-label,
    .logos-hdr-count {
      display: none;
    }
    .logo-item {
      height: 52px;
      padding: 0 22px;
    }
    .logos-proof {
      padding: 4px 16px 14px;
    }
    .lp-item {
      padding: 0 8px;
      font-size: 8px;
    }
    .er-hero-heading .er-hero-title-sub {
      font-size: 0.5em;
      line-height: 1.65;
    }
  }

  .er-exit-overlay {
    position: fixed;
    inset: 0;
    z-index: 9995;
    display: none;
    width: 100vw;
    max-width: 100vw;
    overflow-x: hidden;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    padding: 22px;
    background: rgba(7, 24, 37, 0.72);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .er-exit-overlay.is-open {
    display: flex;
    animation: erExitFadeIn 0.22s ease both;
  }

  .er-exit-dialog {
    position: relative;
    width: min(100%, 440px);
    background: #ffffff;
    border-top: 3px solid #00b8d4;
    box-shadow: 0 24px 64px rgba(13, 43, 69, 0.22);
    animation: erExitPopIn 0.28s cubic-bezier(.34, 1.38, .64, 1) both;
  }

  .er-exit-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    width: 30px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #8ba5ba;
    background: #f5f8fa;
    border: 1px solid rgba(13, 43, 69, 0.12);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .er-exit-close:hover {
    color: #00b8d4;
    border-color: rgba(0, 184, 212, 0.28);
    background: rgba(0, 184, 212, 0.08);
  }

  .er-exit-head {
    padding: 24px 28px 20px;
    background: #0d2b45;
  }

  .er-exit-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
  }

  .er-exit-eyebrow::before {
    content: "";
    width: 20px;
    height: 1px;
    background: #00b8d4;
    opacity: 0.7;
  }

  .er-exit-title {
    margin: 0 34px 6px 0;
    font-family: "Sora", sans-serif;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.24;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .er-exit-title em {
    color: #00b8d4;
    font-style: italic;
    font-weight: 400;
  }

  .er-exit-subtitle {
    margin: 0;
    color: rgba(255, 255, 255, 0.54);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
  }

  .er-exit-body {
    padding: 20px 28px 20px;
  }

  .er-exit-report {
    margin-bottom: 14px;
    padding: 12px 14px;
    background: #f5f8fa;
    border-left: 2px solid #00b8d4;
    color: #506a80;
    font-size: 12px;
    line-height: 1.5;
  }

  .er-exit-report strong {
    display: block;
    margin-top: 2px;
    color: #0d2b45;
    font-size: 13px;
    line-height: 1.45;
  }

  .er-exit-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 12px;
    min-width: 0;
  }

  .er-exit-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1a2b3c;
  }

  .er-exit-required {
    color: #00b8d4;
  }

  .er-exit-input {
    width: 100%;
    max-width: 100%;
    height: 40px;
    padding: 0 12px;
    color: #1a2b3c;
    background: #f5f8fa;
    border: 1px solid #c9d6e2;
    border-radius: 3px;
    outline: none;
    box-sizing: border-box;
    font: 400 13px/1.2 "Inter", sans-serif;
    transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }

  .er-exit-input:focus {
    border-color: #00b8d4;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(0, 184, 212, 0.07);
  }
  .er-exit-phone-row {
    display: grid;
    grid-template-columns: minmax(0, 112px) minmax(0, 1fr);
    gap: 8px;
    width: 100%;
    min-width: 0;
  }
  .er-exit-select {
    width: 100%;
    max-width: 100%;
    height: 40px;
    padding: 0 30px 0 12px;
    color: #1a2b3c;
    background: #f5f8fa;
    border: 1px solid #c9d6e2;
    border-radius: 3px;
    outline: none;
    box-sizing: border-box;
    font: 400 13px/1.2 "Inter", sans-serif;
    transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }
  .er-exit-select:focus {
    border-color: #00b8d4;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(0, 184, 212, 0.07);
  }
  @media (max-width: 420px) {
    .er-exit-phone-row {
      grid-template-columns: 1fr;
    }
    .er-exit-select {
      width: 100%;
    }
  }

  .er-exit-submit {
    position: relative;
    overflow: hidden;
    width: 100%;
    margin-top: 6px;
    padding: 12px 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #071825;
    background: #00b8d4;
    border: 0;
    cursor: pointer;
    font: 700 13.5px/1 "Inter", sans-serif;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: background 0.18s ease, transform 0.15s ease;
  }

  .er-exit-submit::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 -100%;
    width: 50%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.24), transparent);
    transition: left 0.5s ease;
  }

  .er-exit-submit:hover {
    background: #00cfe8;
    transform: translateY(-1px);
  }

  .er-exit-submit:hover::after {
    left: 140%;
  }

  .er-exit-note {
    margin: 12px 0 0;
    color: #8ba5ba;
    text-align: center;
    font-size: 11px;
    font-weight: 300;
    line-height: 1.65;
  }

  .emer-sample-modal__form .er-captcha-block,
  .er-exit-body .er-captcha-block {
    margin: 4px 0 16px !important;
    display: flex;
    justify-content: center;
  }

  @keyframes erExitFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes erExitPopIn {
    from { opacity: 0; transform: translateY(18px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 575px) {
    .er-exit-overlay {
      padding: 16px;
    }

    .er-exit-head,
    .er-exit-body {
      padding-left: 22px;
      padding-right: 22px;
    }

    .er-exit-title {
      font-size: 18px;
    }
  }

  @media (max-width: 767px) {
    html,
    body {
      max-width: 100%;
      position: relative;
      overflow-x: hidden;
    }

    .report-breadcrumb,
    .report-hero-inner,
    .report-nav-inner,
    .report-shell,
    .report-mobile-dock,
    .content-block {
      box-sizing: border-box;
    }

    #report-details,
    #report-content,
    .report-shell,
    .report-main-stack,
    .report-sidebar-stack,
    .content-block {
      max-width: 100%;
      overflow-x: hidden !important;
    }

    #report-details {
      width: 100%;
    }

    .report-nav,
    .report-mobile-dock {
      max-width: 100vw;
      overflow-x: hidden;
    }

    .report-breadcrumb,
    .report-hero-inner {
      padding-left: 16px;
      padding-right: 16px;
    }
    .report-hero-inner {
      grid-template-columns: 5px minmax(0, 1fr);
      padding-top: 20px;
      padding-bottom: 26px;
    }
    .report-hero-inner::before {
      width: 5px;
    }
    .report-hero-body {
      padding-left: 18px;
    }

    .report-nav-inner {
      max-width: 100%;
      padding-left: 36px;
      padding-right: 36px;
    }

    .report-nav-link {
      padding: 13px 14px 12px;
      font-size: 10.5px;
      letter-spacing: 0.04em;
    }

    .report-shell {
      width: 100%;
      max-width: 100%;
      padding-left: 12px;
      padding-right: 12px;
    }

    .report-main-stack,
    .report-sidebar-stack {
      width: 100%;
      max-width: 100%;
    }

    #report-content {
      padding: 24px 16px 28px;
    }

    .content-block {
      width: 100%;
      max-width: 100%;
      padding: 22px 0;
      margin-bottom: 0;
      overflow-wrap: break-word;
    }
    .content-block--key-takeaways {
      padding: 22px 0 16px;
      margin-bottom: 4px;
    }
    .content-block--key-takeaways .section-title {
      font-size: 24px;
    }
    .key-takeaways-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .key-takeaways-card {
      min-height: 0;
      padding: 18px 16px;
    }
    .key-takeaways-list li {
      font-size: 14px;
    }

    .report-prose,
    .report-prose p,
    .report-prose li {
      font-size: 14px;
      line-height: 1.72;
    }

    .updates-block .section-title {
      font-size: 24px;
    }

    .updates-timeline__item {
      grid-template-columns: 22px minmax(0, 1fr);
      column-gap: 10px;
    }

    .updates-timeline__content {
      font-size: 15px;
      line-height: 1.65;
    }

    .updates-timeline__dot {
      width: 12px;
      height: 12px;
      border-width: 3px;
    }

    .report-prose ul,
    .report-prose ol {
      padding-left: 18px;
    }

    .toc-block {
      padding-left: 14px;
      padding-right: 14px;
    }

    .rd-table-scroll {
      overflow-x: hidden;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }

    .report-prose table,
    .mck-article table {
      display: block;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      overflow: visible;
      box-sizing: border-box;
    }

    .report-prose table.rd-table--two-col,
    .mck-article table.rd-table--two-col {
      min-width: 0;
    }

    .report-prose table.rd-table--wide,
    .mck-article table.rd-table--wide {
      min-width: 0;
    }

    .report-prose table.rd-table--mobile-cards tbody,
    .report-prose table.rd-table--mobile-cards tr,
    .report-prose table.rd-table--mobile-cards th,
    .report-prose table.rd-table--mobile-cards td,
    .mck-article table.rd-table--mobile-cards tbody,
    .mck-article table.rd-table--mobile-cards tr,
    .mck-article table.rd-table--mobile-cards th,
    .mck-article table.rd-table--mobile-cards td {
      display: block;
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
    }

    .report-prose table.rd-table--mobile-cards thead,
    .mck-article table.rd-table--mobile-cards thead,
    .report-prose table.rd-table--mobile-cards.rd-table--has-header-row tbody tr:first-child,
    .mck-article table.rd-table--mobile-cards.rd-table--has-header-row tbody tr:first-child {
      display: none !important;
    }

    .report-prose table.rd-table--mobile-cards tr,
    .mck-article table.rd-table--mobile-cards tr {
      margin: 0 0 12px;
      overflow: hidden;
      max-width: 100%;
      border: 1px solid rgba(13, 43, 69, 0.12);
      box-sizing: border-box;
      border-radius: 8px;
      background: #ffffff !important;
      box-shadow: 0 8px 20px rgba(13, 43, 69, 0.06);
    }

    .report-prose table.rd-table--mobile-cards th,
    .report-prose table.rd-table--mobile-cards td,
    .mck-article table.rd-table--mobile-cards th,
    .mck-article table.rd-table--mobile-cards td {
      border: 0;
      border-bottom: 1px solid rgba(13, 43, 69, 0.08);
      color: #0b1f44 !important;
      background: #ffffff;
      text-align: left;
      max-width: 100%;
      box-sizing: border-box;
      word-break: break-word;
      overflow-wrap: anywhere;
      hyphens: auto;
      white-space: normal;
      text-wrap: wrap;
      font-family: "Sora", "Segoe UI", sans-serif;
    }

    .report-prose table.rd-table--mobile-cards th:last-child,
    .report-prose table.rd-table--mobile-cards td:last-child,
    .mck-article table.rd-table--mobile-cards th:last-child,
    .mck-article table.rd-table--mobile-cards td:last-child {
      border-bottom: 0;
    }

    .report-prose table th,
    .report-prose table td,
    .mck-article table th,
    .mck-article table td {
      padding: 11px 12px;
      font-size: 13px;
      line-height: 1.55;
      max-width: 100%;
      box-sizing: border-box;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .report-prose table th:first-child,
    .report-prose table td:first-child,
    .mck-article table th:first-child,
    .mck-article table td:first-child {
      min-width: 0;
      text-align: left;
    }

    .report-prose table.rd-table--two-col td:first-child,
    .mck-article table.rd-table--two-col td:first-child {
      background: linear-gradient(60deg, #3297b1 0%, #1d2746 100%);
      color: #ffffff !important;
      font-weight: 700;
    }

    .report-prose table.rd-table--two-col td:not(:first-child),
    .mck-article table.rd-table--two-col td:not(:first-child) {
      background: #e8faff;
      font-weight: 600;
    }

    .report-prose table.rd-table--mobile-cards:not(.rd-table--two-col) td::before,
    .mck-article table.rd-table--mobile-cards:not(.rd-table--two-col) td::before {
      content: attr(data-rd-label);
      display: block;
      margin-bottom: 5px;
      color: #007a90;
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      overflow-wrap: anywhere;
      word-break: break-word;
    }
  }

  @media (max-width: 575px) {
    .emer-sample-modal__viewport {
      align-items: center;
      padding: 12px;
    }

    .emer-sample-modal__card {
      max-width: 100%;
      max-height: calc(100dvh - 24px);
      min-height: 0;
      height: auto;
      border-radius: 8px;
      box-shadow: 0 18px 50px rgba(7, 24, 37, 0.32);
    }

    .emer-sample-modal__header {
      padding: 14px 14px 12px;
    }

    .emer-sample-modal__form {
      padding: 12px 14px 14px;
    }

    .emer-sample-modal__report-strip {
      margin-top: 8px;
      padding: 8px 10px;
    }

    .emer-sample-modal__field-row {
      gap: 10px;
      margin-bottom: 10px;
    }

    .emer-sample-modal__field--full {
      margin-bottom: 10px;
    }

    .emer-sample-modal__phone-row {
      display: grid;
      grid-template-columns: minmax(0, 42%) minmax(0, 58%);
      gap: 8px;
    }

    .emer-sample-modal__phone-code {
      width: 100%;
      min-width: 0;
    }

    .emer-sample-modal__textarea {
      min-height: 72px;
    }

    .emer-sample-modal__submit {
      margin-top: 10px;
      padding-top: 11px;
      padding-bottom: 11px;
    }

    .er-exit-overlay {
      padding: 12px;
    }

    .er-exit-dialog {
      width: 100%;
      max-height: calc(100dvh - 24px);
      overflow-y: auto;
    }

    .er-exit-head {
      padding: 18px 16px 14px;
    }

    .er-exit-body {
      padding: 16px;
    }

    .er-exit-subtitle {
      font-size: 12px;
      line-height: 1.45;
    }

    .er-exit-report {
      margin-bottom: 12px;
      padding: 10px 12px;
    }

    .er-exit-field {
      margin-bottom: 10px;
    }

    .er-exit-input,
    .er-exit-select {
      padding-top: 9px;
      padding-bottom: 9px;
      font-size: 13px;
    }

    .er-exit-phone-row {
      display: grid;
      grid-template-columns: minmax(0, 42%) minmax(0, 58%);
      gap: 8px;
    }

    .er-exit-select {
      width: 100%;
      min-width: 0;
    }
  }
</style>

     
     




