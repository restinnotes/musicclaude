       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他反复琢磨复核会怎么定，心里一直绷着，却想不出什么办法能让结果快一点",
