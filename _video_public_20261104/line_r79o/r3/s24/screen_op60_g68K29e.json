     "bars": "80-83",
     "from": [
      "S10-B4"
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "rows": [
    {
     "kind": "line",
     "text": "他忽然想到自己需要对方，对方有时也需要他",
