  \"Insta360 ONE X2\",\n    \"Insta360 ONE X\",\n    \"Insta360 ONE RS\",\n    \"Insta360 ONE R\",\n    \"Insta360 Sphere\",\n    \"Insta360 EVO\",\n    \"Insta360 Nano S\",\n    \"Insta360 Nano\",\n    \"Insta360 ONE\",\n    \"Insta360 Nano S2\"\n  ],\n[\n\"Insta360 Luna Ultra\",\n\"Insta360 Luna Pro\"\n],\n  [\n    \"Insta360 Ace Pro 2\",\n    \"Insta360 GO Ultra\",\n    \"Insta360 Ace Pro\",\n    \"Insta360 Ace\",\n    \"Insta360 GO 3S\",\n    \"Insta360 GO 3\",\n    \"Insta360 GO 2\",\n    \"Insta360 GO\",\n    \"SMO 4K\"\n  ],\n  [\n    \"Insta360 Flow 2 Pro\",\n    \"Insta360 Flow 2\",\n    \"Insta360 Flow Pro\",\n    \"Insta360 Flow\"\n  ],\n[\n\"Insta360 Mic Pro\"\n],\n  [\n    \"Insta360 Wave\",\n    \"Insta360 Link 2\",\n    \"Insta360 Link 2C\",\n    \"Insta360 Link\",\n    \"Insta360 Connect\"\n  ],\n  [\n    \"Insta360 Titan\",\n    \"Insta360 Pro 2\",\n    \"Insta360 Pro\"\n  ],\n  [\n    \"Other\"\n  ]\n]","support.product_support.support_form.device_group.tab_wireless_microphone":"无线麦克风","product_ace_pro2.nav_features.powerful_hardware":"强悍硬件","product_ace_pro2.nav_features.superior_image_quality":"卓越画质","product_ace_pro2.nav_features.ready_for_action":"硬核性能","product_ace_pro2.nav_features.smart_shooting":"智能易用","product_ace_pro2.nav_features.easy_editing":"AI 剪辑","product_ace_pro2.nav_features.creative_effects":"创意大片","product_ace_pro2.bento.sensor_and_lens":"新一代 1/1.3 英寸 8K 传感器 \u0026 徕卡 SUMMARIT 镜头","product_ace_pro2.bento.low_light":"卓越夜景，再上新台阶","product_ace_pro2.bento.image_quality":"AI 双芯，超凡画质","product_ace_pro2.bento.color":"4K60fps 运动 HDR 视频 \u0026 徕卡滤镜","product_ace_pro2.bento.stab":"FlowState 防抖科技 \u0026 360° 水平矫正","product_ace_pro2.bento.touchscreen":"2.5 英寸翻转触摸屏","product_ace_pro2.bento.rugged":"坚固耐用，12 米防水","product_ace_pro2.bento.audio":"全新防风结构，收音更清晰","product_ace_pro2.lens.sup":"徕卡 SUMMARIT 镜头","product_ace_pro2.lens.title":"    强强联手，\n    运动影像新标杆。","product_ace_pro2.lens.desc":"全新一代徕卡 SUMMARIT 镜头，采用 F2.6 大光圈并提升至 157°  超广视场角，进一步优化最短对焦距离，影像能力全方位提升，树立旗舰运动影像新标杆。","product_ace_pro2.sensor.sup":"1/1.3 英寸 8K 传感器","product_ace_pro2.sensor.title":"    性能再升级，\n    大作有底气。","product_ace_pro2.sensor.desc":"全新一代 1/1.3 英寸 8K 传感器，支持高达 13.5 档动态范围，等效像素尺寸达 2.4μm，性能更强悍，让 Ace Pro 2 突破性支持拍摄 4K60fps 运动 HDR 和 8K30fps 超高清视频，无论昼夜，画质都更上一层楼。","product_ace_pro2.chip.sup":"AI 双芯","product_ace_pro2.chip.title":"    双芯出动，\n    画质更出众。","product_ace_pro2.chip.desc":"行业首款配备 AI 双芯片的运动相机。Ace Pro 2 新增专业影像芯片，专注于图像降噪等画质上的优化，让每一帧画面都更细腻纯净。搭配强大的 5nm AI 芯片，综合处理图像、性能和系统运行。双芯合力，算力相比 Ace Pro 提升 100%，带来令人惊叹的画质表现。\n","product_ace_pro2.8k.sup":"8K30fps","product_ace_pro2.8k.title":"8K 视界，\n纤毫毕现。","product_ace_pro2.8k.desc":"Ace Pro 2 支持拍摄 8K 超高分辨率视频，即使画面放大裁切，依旧能展现惊人的细节。帧率提升至 30fps，运动时也能拍出电影级的流畅画面。","product_ace_pro2.purevideo.sup":"4K60fps 夜景录像","product_ace_pro2.purevideo.title":"卓越夜景，\n再上新台阶。","product_ace_pro2.purevideo.desc":"得益于 AI 双芯片和传感器的硬件加持，Ace Pro 2 的夜景录像提升至 4K60fps，夜拍实力再突破，在极暗光环境下，画面依旧清晰明亮。更有 AI 智能降噪，让画面更纯净，即便是夜间运动拍摄，也无惧颠簸抖动，稳稳记录夜间精彩。","product_ace_pro2.50mp.sup":"5000 万像素照片","product_ace_pro2.50mp.title":"珍贵瞬间，\n细节尽显。","product_ace_pro2.50mp.desc":"拍照更清晰，记录每一缕光影变幻。以 5000 万像素，定格当下这一刻的美好。","product_ace_pro2.color.title":"所见即所拍，\u003cspan\u003e色彩\u003c/span\u003e更出彩。","product_ace_pro2.color.hdr_title":"4K60fps 运动 HDR","product_ace_pro2.color.hdr_desc":"运动 HDR 4K 档位最高帧率提升至 60fps，高速运动下也能拍出流畅丝滑大片。在强光或逆光环境下，可保留更多高光和阴影细节，呈现更真实的视觉效果。","product_ace_pro2.color.color_title":"徕卡滤镜","product_ace_pro2.color.color_desc":"新增徕卡滤镜，融入徕卡标志性的色彩美学，一键应用，让你的视频和照片更出彩。","product_ace_pro2.color.underwater_title":"水下色彩还原","product_ace_pro2.color.underwater_desc":"无需滤镜，强大的 AI 色彩矫正算法能精准还原水下的每一处色彩细节，真实呈现五彩斑斓的水下世界。","product_ace_pro2.clarity_zoom.sup":"4K 无损变焦","product_ace_pro2.clarity_zoom.title":"无论远近，\n画面都清晰。","product_ace_pro2.clarity_zoom.desc":"与常规数码变焦不同，Ace Pro 2 的无损变焦即使放大 2 倍，依旧保持 4K 超清分辨率，远处景色也能清晰捕捉。轻松拥有更多可用焦段，随心构图，镜头语言更丰富。","product_ace_pro2.clarity_zoom.digital_zoom":"数码变焦","product_ace_pro2.clarity_zoom.clarity_zoom":"无损变焦","product_ace_pro2.slowmo.sup":"4K120fps","product_ace_pro2.slowmo.title":"高光时刻，\n值得慢慢品味。","product_ace_pro2.slowmo.desc":"4K 超清画质联手 120fps 超高帧率，画面超清晰超丝滑，你的运动高光时刻，值得慢下来细细回味。","product_ace_pro2.wide_angle.title":"全新视界，\n即刻开启。","product_ace_pro2.wide_angle.wide_angle_title":"157° 超广视野","product_ace_pro2.wide_angle.wide_angle_desc":"广袤世界，尽收眼底。视野提升带来更震撼人心的视觉冲击力，尤其适合骑行等场景的第一视角拍摄，沉浸式还原你眼中的世界。","product_ace_pro2.wide_angle.megaview_title":"自然广角","product_ace_pro2.wide_angle.megaview_desc":"全新的自然广角 FOV，可减少画面边缘的畸变，视频观感更真实自然，轻松出大片。","product_ace_pro2.audio.sup1":"全新防风结构","product_ace_pro2.audio.title1":"让声音，更纯净。","product_ace_pro2.audio.desc1":"Ace Pro 2 机身自带麦克风防风罩配件，创新硬件设计，大大减少风噪影响，获得更真实纯净的收音效果。","product_ace_pro2.audio.sup2":"音频算法升级","product_ace_pro2.audio.title2":"    无惧嘈杂，\n    “声”临其境。","product_ace_pro2.audio.desc2":"搭载全新升级的音频降噪算法，支持智能降风噪、智能人声增强、立体声三种音频模式，为你带来更加清晰生动、立体沉浸的视听享受。","product_ace_pro2.rugged_and_waterproof.sup":"防水耐用","product_ace_pro2.rugged_and_waterproof.title":"运动，准备就绪。","product_ace_pro2.rugged_and_waterproof.waterproof_title":"12 米防水。","product_ace_pro2.rugged_and_waterproof.waterproof_desc":"Ace Pro 2 裸机防水由 10 米升级至 12 米。配合潜水壳，即可实现 60 米防水，尽情探索神秘的海底世界。","product_ace_pro2.rugged_and_waterproof.rugged_title":"坚固耐用。","product_ace_pro2.rugged_and_waterproof.rugged_desc":"坚固耐用的翻转屏与可拆卸保护镜设计，耐用抗造，助你安心记录每一次冒险时刻。","product_ace_pro2.stab.title":"全面增稳，无惧颠簸翻转。","product_ace_pro2.stab.flowstate_title":"FlowState 防抖科技","product_ace_pro2.stab.flowstate_desc":"不管是日常跑步，还是山地骑行，摇晃、颠簸统统不在话下，随手拍出流畅大片。","product_ace_pro2.stab.horizon_lock_title":"360° 水平矫正","product_ace_pro2.stab.horizon_lock_desc":"无论相机如何翻转，Ace Pro 2 都能应对自如，让画面中的地平线始终保持水平。","product_ace_pro2.battery.sup":"快速充电 \u0026 长效电池","product_ace_pro2.battery.title":"持久续航，\n整日畅拍。","product_ace_pro2.battery.180_mins":"180 \u003cspan\u003e分钟\u003c/span\u003e","product_ace_pro2.battery.battery_life":"续航时长*","product_ace_pro2.battery.18_mins":"18 \u003cspan\u003e分钟\u003c/span\u003e","product_ace_pro2.battery.to_80":"充至 80%** ","product_ace_pro2.battery.desc":"得益于更大的 1800mAh 电池，Ace Pro 2 续航时长高达 180 分钟。更支持快速充电，仅需 18 分钟即可将电量充至 80%，47 分钟即可充满。不仅如此，Ace Pro 2 还可作为移动电源，为手机反向充电，从容应对户外电量危机。\n","product_ace_pro2.battery.note":"*在 25°C 的实验室环境下，使用长续航模式，录制 1080p24fps 普通录像视频（关闭运动 HDR）测得。实际续航时间可能因不同条件而异。","product_ace_pro2.weather.sup":"耐寒耐热","product_ace_pro2.weather.title":"严寒酷暑，\n应对自如。","product_ace_pro2.weather.desc":"既能适应 -20°C 的严寒，又能应对高达 45°C 的酷暑，无惧极端环境，陪你一起尽情冒险。","product_ace_pro2.touchscreen.sup":"2.5 英寸翻转触摸屏","product_ace_pro2.touchscreen.title":"任何角度，都好拍。","product_ace_pro2.touchscreen.desc":"更大、更清晰、更耐用的翻转触摸屏，不仅方便预览和操控，还能精准构图，让每一个角度都尽在掌握。无论是拍 vlog、自拍还是运动场景的多角度预览，都能轻松应对。","product_ace_pro2.touchscreen.increase_in_ppi":"像素密度","product_ace_pro2.touchscreen.increase_in_brightness":"翻转屏耐用性","product_ace_pro2.magnetic.sup":"磁吸快拆","product_ace_pro2.magnetic.title":"自由切换，\n稳固牢靠。","product_ace_pro2.magnetic.desc":"告别复杂的传统螺杆拆装。Ace Pro 2 采用磁吸快拆设计，连接牢固，可实现多机位、多配件的灵活转换。快拆底座无边框设计，在运动中按键操作和充电变得更加轻松。","product_ace_pro2.stats.title":"每一次进步，\n都有迹可循。","product_ace_pro2.stats.activity_title":"GPS 运动助手","product_ace_pro2.stats.activity_desc":"无需额外配件，通过 Insta360 App 即可记录速度、里程、海拔等运动数据并添加到视频中，操作更简单更方便。","product_ace_pro2.stats.third_party_title":"第三方运动数据","product_ace_pro2.stats.third_party_desc":"支持将佳明、高驰、Apple Watch 记录的速度、心率等运动数据，叠加在 Ace Pro 2 拍摄的画面上，运动轨迹一目了然，画面更生动直观。","product_ace_pro2.ride_smarter.title":"好拍，更好用。","product_ace_pro2.ride_smarter.bluetooth_title":"蓝牙耳机兼容","product_ace_pro2.ride_smarter.bluetooth_desc":"兼容 Sena、Cardo 等摩托车蓝牙耳机，与相机搭配即可实现双轨收音，并可在 App 中进行混音。还可直接通过语音控制相机拍摄，解放双手更轻松。","product_ace_pro2.ride_smarter.double_title":"行车记录模式","product_ace_pro2.ride_smarter.double_desc":"让你的相机变身行车记录仪！只需设置好固定的循环存储空间，Ace Pro 2 总能为你保存最新的画面，与你一路安全相伴。","product_ace_pro2.ride_smarter.pre_recording_title":"预录制","product_ace_pro2.ride_smarter.pre_recording_desc":"在你按下快门前就已经拍摄了至多 120 秒的视频，不再错过任何难以预测的时刻。无论是鱼儿上钩的瞬间还是滑板的高光动作，未知精彩悉数捕捉。","product_ace_pro2.control.title":"解放双手，自由掌控。","product_ace_pro2.control.gesture_title":"手势控制","product_ace_pro2.control.gesture_desc":"社恐人士福音，抬抬手，就能掌控相机。尤其适合在团体合照或嘈杂环境下使用，戴上头盔和手套也能轻松识别。","product_ace_pro2.control.voice_title":"语音控制 2.0","product_ace_pro2.control.voice_desc":"全新的语音控制算法，让你在离相机更远处，或不便触屏操控时，也能通过语音指令轻松控制相机，解放双手，拍摄更高效。","product_ace_pro2.pause_recording.sup":"暂停录像","product_ace_pro2.pause_recording.title":"暂停或继续，\n你说了算。","product_ace_pro2.pause_recording.desc":"只需按下暂停，切换到下一个场景，再继续录像，即可避免拍摄繁多的琐碎片段，将你想拍的记录在同一个文件中，省去后期剪辑或挑选画面的不便。","product_ace_pro2.timecode.sup":"时间码","product_ace_pro2.timecode.title":"精准同步，\n后期更高效。","product_ace_pro2.timecode.desc":"内置时间码功能，可实现多机位快速对齐，前期拍摄更精准，后期剪辑更高效，兼容 Final Cut Pro 和 Adobe Premiere Pro 等剪辑软件。","product_ace_pro2.freeframe.sup":"自由比例录像","product_ace_pro2.freeframe.title":"一次拍摄，\n满足多平台所需。","product_ace_pro2.freeframe.desc":"不确定哪种构图更合适？自由比例录像就是你的不二之选！它允许你在后期自由裁切、灵活调节视场角和畸变，一条视频导出多种比例，多平台发布需求一次满足。","product_ace_pro2.creativity.title":"轻松出大片，创意不设限。","product_ace_pro2.creativity.timelapse_title":"延时摄影","product_ace_pro2.creativity.timelapse_desc":"捕捉时光流转，记录云卷云舒，将美景揉于一瞬。","product_ace_pro2.creativity.timeshift_title":"移动延时","product_ace_pro2.creativity.timeshift_desc":"轻松解锁时空加速的炫酷效果。步履之间，城市穿梭等创意大片尽在掌握。","product_ace_pro2.creativity.starlapse_title":"星空延时","product_ace_pro2.creativity.starlapse_desc":"让暗光摄影变得轻松，完美捕捉满天星辰绚烂。 ","product_ace_pro2.creativity.eraser_title":"自拍杆消除 ","product_ace_pro2.creativity.eraser_desc":"后期通过 Insta360 App 可消除画面中的自拍杆，仿佛有专业摄影师随行跟拍。无需上传云端，本地即可处理和出片。","product_ace_pro2.creativity.ai_warp_title":"AI 魔术师","product_ace_pro2.creativity.ai_warp_desc":"AI 可以为高光时刻增添炫酷的动感特效，能应用于整个画面或画面中的特定部分。犹如变魔术一般，带来令人惊叹的视觉震撼力。","product_ace_pro2.acc.title":"精选配件，全面装配。","product_ace_pro2.compare.title":"机型对比","product_ace_pro2.compare.chip":"芯片","product_ace_pro2.compare.chip_value2":"专业影像芯片 + 5nm AI 芯片","product_ace_pro2.compare.chip_value1":"5nm AI 芯片","product_ace_pro2.compare.sensor":"传感器","product_ace_pro2.compare.sensor_value2":"新一代 1/1.3 英寸 8K 传感器","product_ace_pro2.compare.sensor_value1":"1/1.3 英寸传感器","product_ace_pro2.compare.fov":"镜头视场角","product_ace_pro2.compare.fov_value2":"157°","product_ace_pro2.compare.fov_value1":"151°","product_ace_pro2.compare.audio_hardware":"专业音频硬件","product_ace_pro2.compare.audio_hardware_value2":"麦克风防风罩\n（包装内含）","product_ace_pro2.compare.max_video_resolution":"最高视频分辨率","product_ace_pro2.compare.max_video_resolution_value2":"8K30fps","product_ace_pro2.compare.max_video_resolution_value1":"8K24fps","product_ace_pro2.compare.hdr":"运动 HDR 视频\n最高分辨率/帧率","product_ace_pro2.compare.hdr_value2":"4K60fps","product_ace_pro2.compare.hdr_value1":"4K30fps","product_ace_pro2.compare.purevideo":"夜景录像\n最高分辨率/帧率","product_ace_pro2.compare.purevideo_value2":"4K60fps","product_ace_pro2.compare.purevideo_value1":"4K30fps","product_ace_pro2.compare.touchscreen":"翻转触摸屏\n尺寸，分辨率，亮度","product_ace_pro2.compare.touchscreen_value2":"2.5 英寸，PPI 329，900nit","product_ace_pro2.compare.touchscreen_value1":"2.4 英寸，PPI 192，850nit","product_ace_pro2.compare.lens_guard":"可拆卸镜头保护镜","product_ace_pro2.compare.waterproof":"防水性能","product_ace_pro2.compare.waterproof_value2":"12 米","product_ace_pro2.compare.waterproof_value1":"10 米","product_ace_pro2.compare.stab":"FlowState 防抖 +\n360° 水平矫正","product_ace_pro2.meta.title":"影石Insta360 Ace Pro 2 – AI 双芯，旗舰影像运动相机","product_ace_pro2.meta.description":"与徕卡联合研发。搭载 AI 双芯片和新一代 1/1.3 英寸 8K 传感器，无论昼夜，画质再上新高峰。集 2.5 英寸翻转触摸屏、坚固的机身、升级的音频以及 AI 自动剪辑等强大功能于一身。","product_ace_pro2.chip.tag1":"专业影像芯片","product_ace_pro2.chip.tag2":"5nm AI 芯片","product_ace_pro2.editing.title":"AI 出力，剪辑毫不费力。","product_ace_pro2.editing.ai_title":"AI 高光助手","product_ace_pro2.editing.ai_desc":"机内配置 AI 高光助手，启用后，Ace Pro 2 能自动识别单个视频中的高光瞬间，你也可以手动选择片段，并在相机内合成高光合集。还可将不需要的原始片段删除，大大节省 SD 卡存储空间以及后期素材的挑选时间。","product_ace_pro2.editing.editing_title":"自动成片","product_ace_pro2.editing.editing_desc":"拍摄容易剪辑难？来试试 Insta360 App 自动剪辑功能，AI 会为你智能挑选视频中的精彩片段，并在成片时自动配乐。一步到位，剪辑事半功倍。","product_ace_pro2.creativity.ai_warp_tip":"*为限免功能，使用达一定次数后将收费。 ","product_ace_pro2.sub_header.highlights":"亮点","product_ace_pro2.sub_header.ac