      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "93–102",
    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "不再因自己要得太多而难堪，他尽情给出爱。",
      "key": "不再因自己要得太",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-3"
      ]
     },
     {
      "id": "S12-2",
      "text": "越满足越怕改变，他更珍惜眼前。",
      "key": "越满足越怕改变，",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-2"
      ]
     },
     {
      "id": "S12-3",
      "text": "欢喜混着怕留不住，他快乐得发疼也不愿收住。",
      "key": "欢喜混着怕留不住",
      "follows": false,
      "explains": [],
      "cite": []
     },
     {
      "id": "S12-4",
      "text": "他因能全心给予，忽觉美好远大于自己的得失。",
      "key": "他因能全心给予，",
      "follows": false,
      "explains": [],
      "cite": []
     }
    ],
    "because": [
     {
