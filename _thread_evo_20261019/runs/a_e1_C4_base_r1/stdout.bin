{"completed": true, "response": "```json\n{\n  \"segments\": [\n    {\n      \"segment\": \"S01\",\n      \"links\": [\n        {\n          \"thread_quote\": \"光芒迸发之后，余音并没有立刻落稳。\",\n          \"bead\": \"S01/B1\",\n          \"bead_quote\": \"落下来以后，却还没有真正落稳\",\n          \"type\": \"承接\",\n          \"note\": \"Thread把开场骤亮后的余音悬置接成尚未安顿的状态。\"\n        },\n        {\n          \"thread_quote\": \"明明早已知道自己想说什么，临到开口\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"你并不是不知道自己想说什么\",\n          \"type\": \"承接\",\n          \"note\": \"Thread将开场的悬置转化为心意明确却迟疑开口的心理。\"\n        },\n        {\n          \"thread_quote\": \"说出来的不只是一个念头，还有自己愿意交给对方的分量。\",\n          \"bead\": \"S01/B2\",\n          \"bead_quote\": \"有些话一旦说出来，关系就会改变\",\n          \"type\": \"承接\",\n          \"note\": \"Thread说明迟疑来自表达可能改变关系以及必须承担的情感分量。\"\n        },\n        {\n          \"thread_quote\": \"烟花已经升起来了，真正困难的却是让它落下。\",\n          \"bead\": \"S14/B4\",\n          \"bead_quote\": \"接住开头悬着的话\",\n          \"type\": \"铺垫\",\n          \"note\": \"开头把声音尚未落稳的问题留到终曲结尾，由最后的和弦回应。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S02\",\n      \"links\": [\n        {\n          \"thread_quote\": \"左手开始摇荡，音乐终于有了可以停靠的地方。\",\n          \"bead\": \"S01/B3\",\n          \"bead_quote\": \"还不是整个人已经安稳地交给规律起伏\",\n          \"type\": \"回指\",\n          \"note\": \"水波终于建立起来，使开头刚踏上船板、尚未安稳的感觉获得后续。\"\n        },\n        {\n          \"thread_quote\": \"身体被一层层柔和的波浪托住\",\n          \"bead\": \"S02/B2\",\n          \"bead_quote\": \"把身体交给船底温柔的托举\",\n          \"type\": \"承接\",\n          \"note\": \"Thread把摇荡写成身体放弃支撑、接受水波托举的体验。\"\n        },\n        {\n          \"thread_quote\": \"右手的歌声也贴近过来，像两个熟悉的人不必费力解释\",\n          \"bead\": \"S02/B1\",\n          \"bead_quote\": \"不必拼命找话题；对方偶尔望来一眼\",\n          \"type\": \"承接\",\n          \"note\": \"亲密的歌声解释了为什么沉默也能带来舒适与安心。\"\n        },\n        {\n          \"thread_quote\": \"歌声每次向上伸展，又在渐弱中轻轻收回来。\",\n          \"bead\": \"S02/B3\",\n          \"bead_quote\": \"话已经到了嘴边，又轻轻咽回去\",\n          \"type\": \"承接\",\n          \"note\": \"声音的上扬与收弱被解释为靠近之后仍不敢说尽心意。\"\n        },\n        {\n          \"thread_quote\": \"第12–16小节，情绪短暂地向上涌起，随即又柔下来\",\n          \"bead\": \"S02/B5\",\n          \"bead_quote\": \"先前小心收着的歌声忽然往上涌了一次\",\n          \"type\": \"承接\",\n          \"note\": \"Thread保留了本段先热切上涌、再柔和回落的具体变化。\"\n        },\n        {\n          \"thread_quote\": \"那口气里有满足，因为此刻确实得到了靠近的快乐\",\n          \"bead\": \"S02/B5\",\n          \"bead_quote\": \"像轻轻呼出一口气\",\n          \"type\": \"承接\",\n          \"note\": \"短暂的回落被写成亲近带来的满足与松弛。\"\n        },\n        {\n          \"thread_quote\": \"也有一点不易察觉的失落\",\n          \"bead\": \"S02/B4\",\n          \"bead_quote\": \"还没有失去什么，就已经生出一丝舍不得\",\n          \"type\": \"承接\",\n          \"note\": \"Thread把尚未发生失去时就已出现的惆怅接入亲密体验。\"\n        },\n        {\n          \"thread_quote\": \"水波托住了身体，却始终向前流动。\",\n          \"bead\": \"S02/B2\",\n          \"bead_quote\": \"水却一直在流，时间也一直在走\",\n          \"type\": \"承接\",\n          \"note\": \"水波提供安慰的同时也提示时间并未停下。\"\n        },\n        {\n          \"thread_quote\": \"越舍不得眼前的美好，越会意识到，它不是可以永远停留的地方。\",\n          \"bead\": \"S04/B4\",\n          \"bead_quote\": \"左手的水波却一直向前流\",\n          \"type\": \"铺垫\",\n          \"note\": \"本段先建立美好正在流逝的意识，后段才将它展开为甜蜜中的酸楚。\"\n        },\n        {\n          \"thread_quote\": \"越舍不得眼前的美好，越会意识到，它不是可以永远停留的地方。\",\n          \"bead\": \"S07/B3\",\n          \"bead_quote\": \"你也没有办法让它停住\",\n          \"type\": \"铺垫\",\n          \"note\": \"时间不能停驻的意识在这里出现，后段才明确成为对完美时刻无法留住的感受。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S03\",\n      \"links\": [\n        {\n          \"thread_quote\": \"歌声退远之后，水波还在。\",\n          \"bead\": \"S03/B1\",\n          \"bead_quote\": \"剩下一阵阵流动、盘旋，水波般的摇曳托着身体\",\n          \"type\": \"承接\",\n          \"note\": \"歌声退出后，持续的摇荡接住了漂浮、暂时不去哪里的状态。\"\n        },\n        {\n          \"thread_quote\": \"这份安静并不虚假。它确实让人轻松\",\n          \"bead\": \"S03/B1\",\n          \"bead_quote\": \"沉默并不尴尬，反而很舒服\",\n          \"type\": \"承接\",\n          \"note\": \"Thread保留了沉默本身真实而舒服的体验。\"\n        },\n        {\n          \"thread_quote\": \"几句短促、急切的声音突然冒出来，很快又沉下去。\",\n          \"bead\": \"S03/B2\",\n          \"bead_quote\": \"忽然冒出几句短促、稍显急切的声音\",\n          \"type\": \"承接\",\n          \"note\": \"两者都强调短促念头突然出现又很快消退。\"\n        },\n        {\n          \"thread_quote\": \"它们没有发展成一段完整的歌，却打断了原先平顺的流动。\",\n          \"bead\": \"S03/B3\",\n          \"bead_quote\": \"那份顺畅之中出现了阻力\",\n          \"type\": \"承接\",\n          \"note\": \"短促声音带来的中断接住了水波流动受阻的听感。\"\n        },\n        {\n          \"thread_quote\": \"这点不安竟然无法顺着水波自然消散。\",\n          \"bead\": \"S03/B3\",\n          \"bead_quote\": \"平稳的对话有一种被水下暗流拖住的感觉\",\n          \"type\": \"承接\",\n          \"note\": \"Thread把音乐中的阻力解释为无法随平顺流动自行消失的不安。\"\n        },\n        {\n          \"thread_quote\": \"那些话即使没有被说出，也没有因此失去分量\",\n          \"bead\": \"S03/B2\",\n          \"bead_quote\": \"某个念头突然想说话，却很快又沉回去\",\n          \"type\": \"承接\",\n          \"note\": \"念头虽然沉回去，其情感分量并没有随之消失。\"\n        },\n        {\n          \"thread_quote\": \"人可以暂时不说，却不能靠不说，让自己不再有所期待。\",\n          \"bead\": \"S04/B1\",\n          \"bead_quote\": \"本来一句话已经够了，却忍不住再说一遍\",\n          \"type\": \"铺垫\",\n          \"note\": \"本段明确沉默不能消除期待，为下一段再次表达提供了动因。\"\n        }\n      ],\n      \"thread_only\": [\n        \"于是，沉默的意义变了。\"\n      ],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S04\",\n      \"links\": [\n        {\n          \"thread_quote\": \"熟悉的歌声重新出现。\",\n          \"bead\": \"S04/B1\",\n          \"bead_quote\": \"熟悉的歌声又回来了\",\n          \"type\": \"承接\",\n          \"note\": \"Thread接住主题重新出现这一段落入口。\"\n        },\n        {\n          \"thread_quote\": \"旋律并没有换成另一份心事，却比第一次更加繁密\",\n          \"bead\": \"S04/B1\",\n          \"bead_quote\": \"这一遍比第一次更华丽、更迫切\",\n          \"type\": \"承接\",\n          \"note\": \"熟悉主题的回归与表达密度、迫切程度的增加相互对应。\"\n        },\n        {\n          \"thread_quote\": \"像一句原本已经说过的话，到了心里仍觉得不够\",\n          \"bead\": \"S04/B1\",\n          \"bead_quote\": \"本来一句话已经够了，却忍不住再说一遍\",\n          \"type\": \"承接\",\n          \"note\": \"Thread把花腔扩展解释为说过之后仍想补充和重说。\"\n        },\n        {\n          \"thread_quote\": \"因为先前的亲近没有消除顾虑\",\n          \"bead\": \"S02/B1\",\n          \"bead_quote\": \"像两个紧挨在一起的人耳语\",\n          \"type\": \"回指\",\n          \"note\": \"Thread重新调用先前亲密的体验，并指出亲密未能完全解除顾虑。\"\n        },\n        {\n          \"thread_quote\": \"沉默也没有使心事退去\",\n          \"bead\": \"S03/B2\",\n          \"bead_quote\": \"某个念头突然想说话，却很快又沉回去\",\n          \"type\": \"回指\",\n          \"note\": \"上一段暂时沉下去的念头在此成为再次表达的原因。\"\n        },\n        {\n          \"thread_quote\": \"第32小节附近的高音闪烁得近乎刺眼\",\n          \"bead\": \"S04/B2\",\n          \"bead_quote\": \"亮得几乎刺眼\",\n          \"type\": \"承接\",\n          \"note\": \"Thread保留高音达到局部高点时近乎刺眼的明亮感。\"\n        },\n        {\n          \"thread_quote\": \"歌声像是终于触及最深处，却又在渐弱中一点点收回来。\",\n          \"bead\": \"S04/B2\",\n          \"bead_quote\": \"一边往上争取，一边又在退弱\",\n          \"type\": \"承接\",\n          \"note\": \"情绪似乎打开，却在渐弱中重新收回，呼应珠子的未能落定。\"\n        },\n        {\n          \"thread_quote\": \"这里的脆弱不是因为感情不够强，而是因为感情太强\",\n          \"bead\": \"S04/B2\",\n          \"bead_quote\": \"想把最深的情意说出口，却在喉咙口颤抖、哽咽\",\n          \"type\": \"承接\",\n          \"note\": \"Thread将高音处的颤动解释为强烈情感难以稳定承载的表现。\"\n        },\n        {\n          \"thread_quote\": \"到第34小节，摇荡渐渐慢下来，余音仍然停留在空气里。\",\n          \"bead\": \"S04/B2\",\n          \"bead_quote\": \"到第34小节，摇晃渐渐放慢\",\n          \"type\": \"承接\",\n          \"note\": \"本段收尾的减速与余音停留接住了珠子所写的表达之后的安静。\"\n        }\n      ],\n      \"thread_only\": [],\n      \"beads_unlinked\": [],\n      \"retell\": true\n    },\n    {\n      \"segment\": \"S05\",\n      \"links\": [\n        {\n          \"thread_quote\": \"伴奏忽然撤去