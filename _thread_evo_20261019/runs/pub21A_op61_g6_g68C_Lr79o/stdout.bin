{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"它像烟雾往高处散，声音轻了、远了，悬在半空。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"身体先于意识，隐约记起了该如何迈步。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开以后，他起初\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初总算\"\n        },\n        {\n          \"text\": \"可他很快觉得\",\n          \"point\": \"不知怎么才能安心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"想往前走，却\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"更像腿脚虚浮的人，在记忆中挪动舞步。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"舍不得从前的自在\",\n          \"point\": \"忘了为何离开\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一心软\"\n        },\n        {\n          \"text\": \"他还是不甘心\",\n          \"point\": \"从前的好日子也得丢掉\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"不甘心\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"温柔得让人心颤，也刺痛得让人绝望：越怀念，越能感觉它与眼前处境的距离。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"甚至绝望\"\n        },\n        {\n          \"quote\": \"那一刻的轻松可以是真的，并非假装；只是它没有替心里的事找到答案。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"我刚才是真的相信那些话，还是只是在努力让自己相信？\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"努力\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他还憋着气\",\n          \"point\": \"想起从前那份亲近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"还憋着气，却也\"\n        },\n        {\n          \"text\": \"没过多久，他心里又发酸\",\n          \"point\": \"日子真会更好吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没过多久\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"原来的姿态回来，却显得更柔软、更容易受伤：外在的步伐还在向前，里面却有了更多回声。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"步子还向前\"\n        },\n        {\n          \"quote\": \"不是记忆变坏了，而是它太好了——过去无法原样回来。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不停地往前赶，只是为了避免停下来。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起从前亲近的日子\",\n          \"point\": \"盼着还能那样相处\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一度\"\n        },\n        {\n          \"text\": \"当初的委屈又翻上来\",\n          \"point\": \"走得对不对\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"当初的委屈又翻上来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"里面可以同时有愤怒、悲伤，也有想维护自己的那股劲。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"也有悲伤\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍觉得当初受的那些气\",\n          \"point\": \"受的那些气不该忍\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"也不敢多想从前的开心\"\n        },\n        {\n          \"text\": \"他跟自己反复较劲\",\n          \"point\": \"只剩下离开后的难受\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"直到没了力气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"整个世界像被一层透明玻璃罩隔开，连呼吸都不愿惊动它。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"愿望真切，音乐却没有许诺回应。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"明知有些事已经挽不回，便放轻声音，好好看着它。\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"难受慢慢缓下来\",\n         