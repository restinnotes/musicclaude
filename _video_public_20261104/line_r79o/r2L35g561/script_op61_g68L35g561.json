 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他和旧日生活已经隔开一段距离，心里仍把从前那种自然属于其中的感觉看得很重",
       "keys": [
        "自然属于其中的感觉"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "盼着只要守住自己的立场，它也许还能回来",
       "keys": [
        "它也许还能回来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他一时恍惚，心里发虚，连眼下该怎样安顿自己都没把握",
       "keys": [
        "连眼下该怎样安顿自己都没把握"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉中醒来，四周又冷又空，胸口发紧、伸手只摸到空处",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "从前那种不用费力就能亲近的感觉忽然变得鲜明，却不能因此立刻重新拥有",
       "keys": [
        "不能因此立刻重新拥有"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "脑子还没想清楚，身体先隐约记起了怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他仍想守住不委屈自己的分寸，可这份自持并不轻松，心里也有想停下来、不再硬撑的疲惫",
       "keys": [
        "想停下来、不再硬撑的疲惫"
       ],
       "from": [
        "S01-4"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他仍然很珍惜从前那种自然属于其中的感觉",
       "keys": [
        "很珍惜从前那种自然属于其中的感觉"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "越清楚它曾经有多重要，越感到如今已经不能像从前那样亲近",
       "keys": [
        "不能像从前那样亲近"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他努力把情绪收住，心里却一直脆弱不安，反复安慰自己也没能让失落消失",
       "keys": [
        "没能让失落消失"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像腿脚发虚的人，还在记忆里勉强挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像整理好衣服抬起头，不让人看出自己动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "一遍遍对自己说没事，说到后来反倒露出了自己有多在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他一阵阵想把自己往前推，一阵阵又想退下来，焦灼越积越重",
       "keys": [
        "焦灼越积越重"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "呼吸像被催着一样，变得越来越急促",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "即使如此，他仍不愿被动地接受眼下的处境",
       "keys": [
        "不愿被动地接受眼下的处境"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "哪怕心里还在难受，也不甘心就这样垮下去",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他开始看清，自己再怎么守住立场，也不能保证旧日那种归属一定会回来",
       "keys": [
        "不能保证旧日那种归属一定会回来"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想到从前那种轻松、亲近、不必时时防备的感觉，他会短暂柔和下来",
       "keys": [
        "短暂柔和下来"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像回到故乡夏日的麦浪与微风里，温和又轻快",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "也更明显地感到如今隔着一段距离",
       "keys": [
        "如今隔着一段距离"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他心里有一阵恼意和抗拒，想做点什么，却又拿不准该往哪里去",
       "keys": [
        "拿不准该往哪里去"
       ],
       "from": [
        "S03-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像出去走走换个心情，轻松是真的，心结却还没解开",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "耳边像有人低声絮语，脚下像踩着流沙抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "我刚才是真信那些话，还是在勉强自己去信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "从前那种亲近的温暖再次让他心里柔软起来，带来感激和短暂的幸福",
       "keys": [
        "感激和短暂的幸福"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "表面还撑着从前坚定的样子，心却比以前更容易受伤了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可那点温暖很快又让眼前的距离变得刺眼",
       "keys": [
        "眼前的距离变得刺眼"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "过去太好又回不去才最刺痛，像在拉扯中疲惫地步步后退",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他越想绷住自己，整个人越紧得难以放松，抵抗到后来只剩疲惫",
       "keys": [
        "抵抗到后来只剩疲惫"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像急促的脚步和乱了拍的心跳，被催着往前跑停不下来",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他的思绪总绕回相近的假设，反复推想也没有结论",
       "keys": [
        "反复推想也没有结论"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "想得越多，越难真正停下来",
       "keys": [
        "越难真正停下来"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子里还在问怎么会变成这样，不停往前赶只是不敢停下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他还是会不自觉地留意，旧日那种归属有没有一点回来的迹象",
       "keys": [
        "有没有一点回来的迹象"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "只是心里已经不再认定它一定会发生",
       "keys": [
        "不再认定它一定会发生"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他心里仍有柔软而克制的亲近需要，盼着自己的感受能被理解",
       "keys": [
        "盼着自己的感受能被理解"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "让他惦记的像是某个人，又像是故乡或从前的日子",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "失落和不甘仍然交织，他还是努力把眼前的日子往前过，不愿就这样被动接受眼下的处境",
       "keys": [
        "努力把眼前的日子往前过"
       ],
       "from": [
        "S05-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "心里还憋着那股护住自己的劲：这件事不能就这么算了",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "原先支撑他的自持慢慢松动，不安先是不断加深，后来只是因为疲惫才暂时缓下来",
       "keys": [
        "因为疲惫才暂时缓下来"
       ],
       "from": [
        "S05-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "像脚下的地板忽然空了，只剩一个声音在自言自语",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "像长叹一口气松了下来，其实还没想通，只是争累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他决定不再把眼前的日子过成等待旧日归属恢复的空档",
       "keys": [
        "不再把眼前的日子过成等待旧日归属恢复的空档"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "仍按自己的分寸生活，把心思放回眼下能够继续承担的事情上",
       "keys": [
        "把心思放回眼下能够继续承担的事情上"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "这段安静里，他暂时不必绷紧自己，心里终于有了片刻柔和的休息",
       "keys": [
        "片刻柔和的休息"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "世界像被透明玻璃罩隔开，像听着母亲哼摇篮曲，连呼吸都放轻",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "终于不用向人解释为什么难过，也不用再硬撑着装坚强",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他允许想念和委屈慢慢浮上来，也仍盼着有一天能被理解",
       "keys": [
        "盼着有一天能被理解"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像对着远方真切地祈求，却不知道会不会有回应",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "从前那种归属感仍然珍贵，只是他不再要求它原样回来，愿意先把这份眷恋留在心里",
       "keys": [
        "先把这份眷恋留在心里"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "远去的家园像在梦里被照亮，虽然回不去，却远远看见了它",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "明知有些珍惜的事挽不回，便静静看着，不再急着抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他照着已经作出的选择继续过眼前的日子，原本安静的心绪却忽然受到惊扰",
