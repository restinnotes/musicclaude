<script>
(function () {
    const uid = "emer_198456";

    const sidebar = document.getElementById('report-sidebar-' + uid);
    const sticky  = document.getElementById('sticky-cta-' + uid);

    // this is your bottom CTA section
    const lastCta = document.getElementById('last-cta');

    if (!sidebar || !sticky) return;

    let ticking = false;
    let sidebarBottomThreshold = 0;

    function measureSidebarThreshold() {
        sidebarBottomThreshold = sidebar.offsetTop + sidebar.offsetHeight - 120;
    }

    function updateSticky() {

        // ✅ show only after sidebar ends
        const passedSidebar = window.scrollY > sidebarBottomThreshold;

        // ✅ hide when last-cta is near/visible (so it won’t overlap)
        let reachedLastCta = false;
        if (lastCta) {
            const lastTop = lastCta.getBoundingClientRect().top; // relative to viewport
            // when last-cta enters viewport (adjust 160 if needed)
            reachedLastCta = lastTop < (window.innerHeight - 160);
        }

        const shouldShow = passedSidebar && !reachedLastCta;
        sticky.classList.toggle('hidden', !shouldShow);
    }

    function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
            updateSticky();
            ticking = false;
        });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function () {
        measureSidebarThreshold();
        onScroll();
    });

    // if sidebar height changes due to toggles
    document.addEventListener('click', (e) => {
        if (e.target.closest('[data-emer-toggle]')) {
            setTimeout(() => {
                measureSidebarThreshold();
                updateSticky();
            }, 60);
        }
    });

    if ('ResizeObserver' in window) {
        const sidebarObserver = new ResizeObserver(() => {
            measureSidebarThreshold();
            updateSticky();
        });
        sidebarObserver.observe(sidebar);
    }

    measureSidebarThreshold();
    updateSticky();
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const sidebarCard = document.querySelector('.rd-sidebar-sample');
    if (!sidebarCard) return;

    const tabCopy = {
        sample: {
            title: 'Get Free Sample PDF',
            intro: 'Leave your work email and we will send the sample chapter for this report.',
            submit: 'Email sample PDF',
            formType: 'request-free-sample',
            formCode: 'rs-sidebar',
            message: 'Sticky sidebar sample PDF request'
        },
        customize: {
            title: 'Customize this report',
            intro: 'Tell us which segments, regions, or data cuts you need customized.',
            submit: 'Send customization request',
            formType: 'request-customization',
            formCode: 'cr-sidebar',
            message: 'Sticky sidebar customization request'
        },
        discount: {
            title: 'Ask for a discount',
            intro: 'Share your licensing needs and we will review pricing options.',
            submit: 'Send discount request',
            formType: 'ask-for-discount',
            formCode: 'ad-sidebar',
            message: 'Sticky sidebar discount request'
        }
    };

    const title = sidebarCard.querySelector('[data-sidebar-title]');
    const intro = sidebarCard.querySelector('[data-sidebar-intro]');
    const submit = sidebarCard.querySelector('[data-sidebar-submit]');
    const formType = sidebarCard.querySelector('[data-sidebar-form-type]');
    const formCode = sidebarCard.querySelector('[data-sidebar-form-code]');
    const message = sidebarCard.querySelector('[data-sidebar-message]');
    const tabs = Array.from(sidebarCard.querySelectorAll('[data-sidebar-tab]'));

    function setSidebarMode(mode) {
        const copy = tabCopy[mode] || tabCopy.sample;

        if (title) title.textContent = copy.title;
        if (intro) intro.textContent = copy.intro;
        if (submit) submit.textContent = copy.submit;
        if (formType) formType.value = copy.formType;
        if (formCode) formCode.value = copy.formCode;
        if (message) message.value = copy.message;

        tabs.forEach(function (tab) {
            const isActive = tab.getAttribute('data-sidebar-tab') === mode;
            tab.classList.toggle('is-active', isActive);
            tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
    }

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            setSidebarMode(tab.getAttribute('data-sidebar-tab'));
        });
    });

    setSidebarMode('sample');
});

document.addEventListener('DOMContentLoaded', function () {

    const modal = document.getElementById('emerSampleModal');
    const title = document.getElementById('emerSampleReportTitle');
    const reportId = document.getElementById('emerSampleReportId');
    const reportName = document.getElementById('emerSampleReportName');
    const reportNameLegacy = document.getElementById('emerSampleReportNameLegacy');
    const formType = document.getElementById('emerSampleFormType');
    const formCode = document.getElementById('emerSampleFormCode');
    const countryCode = document.getElementById('emerSampleCountryCode');
    const countryName = document.getElementById('emerSampleCountry');
    const countryIso = document.getElementById('emerSampleCountryIso');
    const eyebrow = document.getElementById('emerSampleEyebrow');
    const titlePrefix = document.getElementById('emerSampleTitlePrefix');
    const titleEmphasis = document.getElementById('emerSampleTitleEmphasis');
    const subtitle = document.getElementById('emerSampleSubtitle');
    const submitText = document.getElementById('emerSampleSubmitText');
    const tableCtaHtml = "\u003Cdiv class=\u0022rd-inline-cta\u0022\u003E\n  \u003Cdiv class=\u0022rd-inline-cta__copy\u0022\u003E\n    \u003Cspan class=\u0022rd-inline-cta__label\u0022\u003EInsight Support\u003C\/span\u003E\n    \u003Ch3 class=\u0022rd-inline-cta__title\u0022\u003ENeed the story behind the data table?\u003C\/h3\u003E\n    \u003Cp class=\u0022rd-inline-cta__text\u0022\u003EOur analysts can walk you through the assumptions, segment logic, and commercial implications behind the numbers shown here.\u003C\/p\u003E\n  \u003C\/div\u003E\n  \u003Cdiv class=\u0022rd-inline-cta__actions\u0022\u003E\n    \u003Ca href=\u0022https:\/\/www.emergenresearch.com\/schedule-a-call\u0022 class=\u0022rd-inline-cta__btn\u0022\u003ESchedule A Call\u003C\/a\u003E\n    \u003Ca href=\u0022https:\/\/www.emergenresearch.com\/request-free-sample\/198456\u0022 class=\u0022rd-inline-cta__link\u0022\u003EGet Sample\u003C\/a\u003E\n  \u003C\/div\u003E\n\u003C\/div\u003E";
    const figureLightbox = document.getElementById('figureLightbox');
    const figureLightboxImage = document.getElementById('figureLightboxImage');
    const reportMeta = document.getElementById('emerSampleReportMeta');
    const samplePath = "https:\/\/www.emergenresearch.com\/request-free-sample\/198456";
    const customizationPath = "https:\/\/www.emergenresearch.com\/request-for-customization\/198456";
    const customReportPath = "https:\/\/www.emergenresearch.com\/request-custom-report\/198456";
    const executiveSummaryPath = "https:\/\/www.emergenresearch.com\/request-executive-summary\/198456";
    const regionalSummaryPath = "https:\/\/www.emergenresearch.com\/request-regional-summary\/198456";
    const companyOverviewPath = "https:\/\/www.emergenresearch.com\/request-company-overview\/198456";
    const discountPath = "https:\/\/www.emergenresearch.com\/ask-for-discount\/198456";
    const reportMetaText = "Semiconductors \u0026 Electronics | Computing and Embedded Systems";
    const refreshCsrfUrl = "https:\/\/www.emergenresearch.com\/refresh-csrf";
    const popupCopy = {
        sample: {"type":"request-free-sample","eyebrow":"Free Sample Request","titlePrefix":"Get Your","titleEmphasis":"Free Sample","subtitle":"Receive a complimentary chapter of this report delivered to your inbox.","submit":"Send My Free Sample","messagePlaceholder":"Share what you want from this sample or any specific sections you want our team to focus on."},
        customization: {"type":"request-customization","eyebrow":"Customization Request","titlePrefix":"Request","titleEmphasis":"Custom Scope","subtitle":"Tell our analysts what you need and we will tailor the research scope around your priorities.","submit":"Send My Request","messagePlaceholder":"Describe your custom requirement, priority markets, segments, competitors, or deliverables you want included."},
        discount: {"type":"ask-for-discount","eyebrow":"Discount Request","titlePrefix":"Ask For","titleEmphasis":"Discount","subtitle":"Share your licensing needs and budget context, and our team will review available pricing flexibility for this report.","submit":"Send My Discount Request","messagePlaceholder":"Tell us about your license needs, budget expectations, timeline, or any pricing questions you want reviewed."}    };

    async function fetchFreshCsrfToken() {
        const controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
        const timeoutId = controller
            ? window.setTimeout(function () { controller.abort(); }, 3000)
            : null;

        try {
            const response = await fetch(refreshCsrfUrl, {
                method: 'GET',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                signal: controller ? controller.signal : undefined
            });
            if (!response.ok) return null;

            const data = await response.json();
            return data && data.token ? data.token : null;
        } catch (_) {
            return null;
        } finally {
            if (timeoutId) {
                window.clearTimeout(timeoutId);
            }
        }
    }

    function resetPopupForm(form, options = {}) {
        if (!form) return;

        const preserveNames = new Set(options.preserveNames || []);
        const fields = form.querySelectorAll('input, textarea, select');

        fields.forEach(function (field) {
            const name = field.getAttribute('name') || '';
            if (preserveNames.has(name) || field.hasAttribute('data-preserve')) {
                return;
            }

            if (field.tagName === 'SELECT') {
                const defaultValue = field.getAttribute('data-default-value');
                if (defaultValue !== null) {
                    field.value = defaultValue;
                } else {
                    field.selectedIndex = 0;
                }
                return;
            }

            const type = (field.getAttribute('type') || '').toLowerCase();
            if (['hidden', 'submit', 'button', 'reset'].includes(type)) {
                return;
            }

            if (type === 'checkbox' || type === 'radio') {
                field.checked = false;
                return;
            }

            field.value = '';
        });
    }

    async function preparePopupForm(form, options = {}) {
        if (!form) return;

        resetPopupForm(form, options);

        const token = await fetchFreshCsrfToken();
        if (!token) return;

        form.querySelectorAll('input[name=\"_token\"]').forEach(function (tokenInput) {
            tokenInput.value = token;
        });
    }

    window.prepareReportPopupForm = preparePopupForm;

    function syncPopupCountry() {
        if (!countryCode || !countryName) return;
        const selected = countryCode.options[countryCode.selectedIndex];
        countryName.value = selected ? (selected.getAttribute('data-country-name') || 'N/A') : 'N/A';
        if (countryIso) {
            countryIso.value = selected ? (selected.getAttribute('data-country-iso') || '') : '';
        }
    }

    function getPopupMode(btn) {
        const href = (btn.getAttribute('href') || '').toLowerCase();
        const explicitMode = (btn.getAttribute('data-popup-mode') || '').toLowerCase();
        if (explicitMode === 'discount' || href.indexOf('/ask-for-discount/') !== -1) {
            return 'discount';
        }
        if (explicitMode === 'customization' || href.indexOf('/request/cr') !== -1 || href.indexOf('/request-for-customization/') !== -1 || href.indexOf('/request-custom-report/') !== -1) {
            return 'customization';
        }
        return 'sample';
    }

    function setFieldRequired(id, required) {
        const field = document.getElementById(id);
        if (!field) return;
        field.required = required;
    }

    function setCompactEmailPopup(enabled) {
        if (!modal) return;
        modal.classList.toggle('is-email-only', enabled);
        setFieldRequired('emerSampleName', !enabled);
        setFieldRequired('emerSampleMobile', !enabled);
    }

    function configurePopup(btn) {
        const mode = getPopupMode(btn);
        const copy = popupCopy[mode];
        const t = btn.getAttribute('data-name') || btn.getAttribute('data-title') || "US Mini PC Market";
        const rid = btn.getAttribute('data-id') || "198456";
        const messageField = document.getElementById('emerSampleMessage');
        const compactEmailOnly = btn.getAttribute('data-popup-compact') === 'email-only' || btn.classList.contains('js-open-sample-toc');
        const compactReportTitle = /\breport$/i.test(t) ? t : (t + ' Report');

        setCompactEmailPopup(compactEmailOnly);
        if (title && t) title.textContent = t;
        if (reportId && rid) reportId.value = rid;
        if (reportName && t) reportName.value = t;
        if (reportNameLegacy && t) reportNameLegacy.value = t;
        if (formType) {
            const hrefLower = (btn.getAttribute('href') || '').toLowerCase();
            if (hrefLower.indexOf('/request/cr') !== -1) {
                formType.value = 'request-for-customization';
            } else if (hrefLower.indexOf('/request/ds') !== -1) {
                formType.value = 'download-summary';
            } else if (hrefLower.indexOf('/request-custom-report/') !== -1) {
                formType.value = 'request-custom-report';
            } else if (hrefLower.indexOf('/request-executive-summary/') !== -1) {
                formType.value = 'request-executive-summary';
            } else {
                formType.value = copy.type;
            }
        }
        if (formCode) {
            const hrefCodeMatch = (btn.getAttribute('href') || '').toLowerCase().match(/\/request\/((?:rs|cr|ds)[0-9]*)/);
            formCode.value = hrefCodeMatch ? hrefCodeMatch[1] : '';
        }
        if (eyebrow) eyebrow.textContent = copy.eyebrow;
        if (compactEmailOnly) {
            if (titlePrefix) titlePrefix.textContent = 'Get this Data in a Free Sample of the ';
            if (titleEmphasis) titleEmphasis.textContent = compactReportTitle;
            if (subtitle) subtitle.textContent = '';
            if (submitText) submitText.textContent = 'Submit';
        } else {
            if (titlePrefix) titlePrefix.textContent = copy.titlePrefix + ' ';
            if (titleEmphasis) titleEmphasis.textContent = copy.titleEmphasis;
            if (subtitle) subtitle.textContent = copy.subtitle;
            if (submitText) submitText.textContent = copy.submit;
        }
        if (reportMeta) reportMeta.textContent = reportMetaText;
        if (messageField) {
            messageField.placeholder = copy.messagePlaceholder;
        }
        syncPopupCountry();
    }

    document.querySelectorAll('.figure-image-frame').forEach(function (frame) {
        const img = frame.querySelector('img');
        if (!img || frame.querySelector('.figure-image-lightbox-trigger')) return;

        const trigger = document.createElement('button');
        trigger.type = 'button';
        trigger.className = 'figure-image-lightbox-trigger';
        trigger.setAttribute('aria-label', 'View full image');
        trigger.innerHTML = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
        frame.appendChild(trigger);

        trigger.addEventListener('click', function () {
            if (!figureLightbox || !figureLightboxImage) return;
            figureLightboxImage.src = img.currentSrc || img.src;
            figureLightboxImage.alt = img.alt || 'Expanded report image';
            figureLightbox.classList.add('is-open');
            figureLightbox.setAttribute('aria-hidden', 'false');
            document.body.classList.add('overflow-hidden');
        });
    });

    function prepareResponsiveReportTable(table) {
        if (table.dataset.mobilePrepared === 'true') return;
        table.dataset.mobilePrepared = 'true';

        const firstRow = table.querySelector('tr');
        const rows = Array.from(table.querySelectorAll('tr'));
        const columnCount = firstRow ? firstRow.querySelectorAll('th, td').length : 0;

        table.classList.add('rd-table--mobile-cards');

        if (columnCount > 0 && columnCount <= 8) {
            table.classList.add('rd-table--cols-' + columnCount);
        }

        if (columnCount <= 2) {
            table.classList.add('rd-table--two-col');
            return;
        }

        table.classList.add('rd-table--wide', 'rd-table--has-header-row');

        const headings = Array.from(firstRow.querySelectorAll('th, td')).map(function (cell, index) {
            const label = (cell.textContent || '').replace(/\s+/g, ' ').trim();
            return label || 'Column ' + (index + 1);
        });

        rows.slice(1).forEach(function (row) {
            Array.from(row.querySelectorAll('th, td')).forEach(function (cell, index) {
                cell.setAttribute('data-rd-label', headings[index] || 'Column ' + (index + 1));
            });
        });
    }

    document.querySelectorAll('.mck-article table, .report-prose table').forEach(function (table) {
        const isWrapped = !!table.closest('.rd-table-scroll');
        prepareResponsiveReportTable(table);

        if (isWrapped) {
            return;
        }

        const wrapper = document.createElement('div');
        wrapper.className = 'rd-table-scroll';
        table.parentNode.insertBefore(wrapper, table);
        wrapper.appendChild(table);
    });

    function isImpactNote(node) {
        if (!node || !node.matches || !node.matches('p')) return false;
        const text = (node.textContent || '').replace(/\s+/g, ' ').trim();
        return /^impact values\b/i.test(text);
    }

    document.querySelectorAll('.mck-article table').forEach(function (table) {
        if (table.dataset.ctaInjected === 'true') return;
        table.dataset.ctaInjected = 'true';
        const tableAnchor = table.closest('.rd-table-scroll') || table;
        const existingImpactNote = tableAnchor.nextElementSibling;

        if (isImpactNote(existingImpactNote)) {
            existingImpactNote.classList.add('rd-impact-note');
        }

        if (tableCtaHtml) {
            tableAnchor.insertAdjacentHTML('afterend', tableCtaHtml);
            const insertedCta = tableAnchor.nextElementSibling;
            const impactNote = insertedCta ? insertedCta.nextElementSibling : null;

            if (insertedCta && isImpactNote(impactNote)) {
                impactNote.classList.add('rd-impact-note');
                insertedCta.parentNode.insertBefore(impactNote, insertedCta);
            }
        }
    });

    if (!modal) return;

    function markFutureOutlookTocItems() {
        document.querySelectorAll('.report-toc-source li').forEach(function (item) {
            const text = (item.textContent || '').replace(/\s+/g, ' ').trim();
            if (!/^(?:\d+\.\s*)?market opportunities and future outlook$/i.test(text)) return;

            const hasDirectPopupLink = Array.from(item.children).some(function (child) {
                return child.tagName === 'A' && child.classList.contains('js-open-sample-toc');
            });
            if (hasDirectPopupLink) return;

            const link = document.createElement('a');
            link.href = "https:\/\/www.emergenresearch.com\/request-free-sample\/198456";
            link.className = 'js-open-sample-toc';
            link.setAttribute('data-popup-mode', 'sample');
            link.setAttribute('data-popup-compact', 'email-only');
            link.setAttribute('data-id', "198456");
            link.setAttribute('data-title', "US Mini PC Market");

            while (item.firstChild) {
                const node = item.firstChild;
                if (node.nodeType === Node.ELEMENT_NODE && ['UL', 'OL'].includes(node.tagName)) {
                    break;
                }
                link.appendChild(node);
            }

            if ((link.textContent || '').trim() === '') {
                link.textContent = text;
            }

            item.insertBefore(link, item.firstChild);
        });
    }

    function setupImportedTocToggles() {
        document.querySelectorAll('.report-toc-source .report-toc-list > li').forEach(function (item) {
            const childList = Array.from(item.children).find(function (child) {
                return ['UL', 'OL'].includes(child.tagName);
            });
            if (!childList) return;

            const directHeading = Array.from(item.children).find(function (child) {
                return child.matches('strong, .head');
            });
            if (!directHeading) return;

            const headingText = (directHeading.textContent || '').replace(/\s+/g, ' ').trim();
            const numberMatch = headingText.match(/^(\d+)\./);
            if (!numberMatch || parseInt(numberMatch[1], 10) < 4) return;

            item.classList.add('toc-is-collapsible', 'toc-collapsed');
            directHeading.setAttribute('role', 'button');
            directHeading.setAttribute('tabindex', '0');
            directHeading.setAttribute('aria-expanded', 'false');

            const toggle = function () {
                const isCollapsed = item.classList.toggle('toc-collapsed');
                directHeading.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
            };

            directHeading.addEventListener('click', toggle);
            directHeading.addEventListener('keydown', function (event) {
                if (event.key !== 'Enter' && event.key !== ' ') return;
                event.preventDefault();
                toggle();
            });
        });
    }

    markFutureOutlookTocItems();
    setupImportedTocToggles();

    document.querySelectorAll('a[href]').forEach(function (link) {
        const href = link.getAttribute('href') || '';
        if (href === samplePath) {
            link.classList.add('js-open-sample');
            link.setAttribute('data-popup-mode', 'sample');
            link.setAttribute('data-id', "198456");
            link.setAttribute('data-title', "US Mini PC Market");
        } else if (href === customizationPath) {
            link.classList.add('js-open-sample');
            link.setAttribute('data-popup-mode', 'customization');
            link.setAttribute('data-id', "198456");
            link.setAttribute('data-title', "US Mini PC Market");
        } else if (href === customReportPath) {
            link.classList.add('js-open-sample');
            link.setAttribute('data-popup-mode', 'customization');
            link.setAttribute('data-id', "198456");
            link.setAttribute('data-title', "US Mini PC Market");
        } else if (href === executiveSummaryPath || href === regionalSummaryPath || href === companyOverviewPath) {
            link.classList.add('js-open-sample');
            link.setAttribute('data-popup-mode', 'sample');
            link.setAttribute('data-id', "198456");
            link.setAttribute('data-title', "US Mini PC Market");
        } else if (href === discountPath) {
            link.classList.add('js-open-sample');
            link.setAttribute('data-popup-mode', 'discount');
            link.setAttribute('data-id', "198456");
            link.setAttribute('data-title', "US Mini PC Market");
        }
    });

    if (countryCode) {
        countryCode.setAttribute('data-default-value', countryCode.value);
        syncPopupCountry();
        countryCode.addEventListener('change', syncPopupCountry);
    }

    const useSamplePopup = true;

    document.addEventListener('click', async function (e) {
        const btn = e.target.closest('.js-open-sample, .js-open-sample-toc, a[href]');
        if (!btn) return;

        const href = btn.getAttribute('href') || '';
        const isTocPopupTrigger = btn.classList.contains('js-open-sample-toc');
        if (!useSamplePopup && !isTocPopupTrigger) return;

        const isPopupTrigger = isTocPopupTrigger || btn.classList.contains('js-open-sample') || href === samplePath || href === customizationPath || href === customReportPath || href === executiveSummaryPath || href === regionalSummaryPath || href === companyOverviewPath || href === discountPath;
        if (!isPopupTrigger) return;

        e.preventDefault();
        await preparePopupForm(modal.querySelector('form'), {
            preserveNames: [
                'report_id',
                'report_name',
                'reportName',
                'form_type',
                'form_code',
                'country',
                'visitor_country_iso'
            ]
        });
        configurePopup(btn);
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('overflow-hidden');
    });

    // CLOSE (overlay or X)
    document.addEventListener('click', function (e) {
        if (!e.target.closest('[data-emer-modal-close]')) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('overflow-hidden');
    });

    // ESC close
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('overflow-hidden');
        }

        if (e.key === 'Escape' && figureLightbox && figureLightbox.classList.contains('is-open')) {
            figureLightbox.classList.remove('is-open');
            figureLightbox.setAttribute('aria-hidden', 'true');
            if (figureLightboxImage) {
                figureLightboxImage.src = '';
            }
            document.body.classList.remove('overflow-hidden');
        }
    });

    document.addEventListener('click', function (e) {
        if (!figureLightbox || !e.target.closest('[data-figure-lightbox-close]')) return;
        figureLightbox.classList.remove('is-open');
        figureLightbox.setAttribute('aria-hidden', 'true');
        if (figureLightboxImage) {
            figureLightboxImage.src = '';
        }
        document.body.classList.remove('overflow-hidden');
    });

});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const exitPopup = document.getElementById('erExitIntentPopup');
    const timedPopup = document.getElementById('erTimedReportPopup');
    const odyssOfferPopup = document.getElementById('erOdyssOfferPopup');
    const reportId = (exitPopup || timedPopup || odyssOfferPopup)?.getAttribute('data-report-id') || 'report';

    if (!exitPopup && !timedPopup && !odyssOfferPopup) return;

    function storageGet(key) {
        try {
            return window.sessionStorage.getItem(key);
        } catch (e) {
            return null;
        }
    }

    function storageSet(key, value) {
        try {
            window.sessionStorage.setItem(key, value);
        } catch (e) {
            // Private browsing or blocked storage should not break the form.
        }
    }

    function sampleModalIsOpen() {
        const sampleModal = document.getElementById('emerSampleModal');
        return sampleModal && sampleModal.classList.contains('is-open');
    }

    function anotherPopupIsOpen(activePopup) {
        return [exitPopup, timedPopup, odyssOfferPopup].some(function (popupEl) {
            return popupEl && popupEl !== activePopup && popupEl.classList.contains('is-open');
        });
    }

    function setupPopup(popup, storageKey, registerTriggers) {
        if (!popup) return;

        const dialog = popup.querySelector('.er-exit-dialog');
        const form = popup.querySelector('form');
        const firstInput = popup.querySelector('input[name="name"]');
        const countryCodeSelect = popup.querySelector('select[name="country_code"]');
        let opened = false;

        if (countryCodeSelect && !countryCodeSelect.hasAttribute('data-default-value')) {
            countryCodeSelect.setAttribute('data-default-value', countryCodeSelect.value);
        }

        async function openPopup() {
            if (opened || storageGet(storageKey) === '1' || sampleModalIsOpen() || anotherPopupIsOpen(popup)) return;
            opened = true;
            storageSet(storageKey, '1');
            popup.classList.add('is-open');
            popup.setAttribute('aria-hidden', 'false');
            document.body.classList.add('overflow-hidden');
            const prepareForm = window.prepareReportPopupForm;
            if (typeof prepareForm === 'function') {
                prepareForm(form, {
                    preserveNames: [
                        'report_id',
                        'report_name',
                        'reportName',
                        'form_type',
                        'country',
                        'visitor_country_iso',
                        'message'
                    ]
                }).catch(function () {});
            }
            window.setTimeout(function () {
                if (firstInput) firstInput.focus();
            }, 80);
        }

        function closePopup() {
            popup.classList.remove('is-open');
            popup.setAttribute('aria-hidden', 'true');

            if (![exitPopup, timedPopup, odyssOfferPopup].some(function (popupEl) {
                return popupEl && popupEl.classList.contains('is-open');
            })) {
                document.body.classList.remove('overflow-hidden');
            }
        }

        popup.addEventListener('click', function (event) {
            if (event.target.closest('[data-er-exit-close]')) {
                closePopup();
                return;
            }

            if (dialog && !dialog.contains(event.target)) {
                closePopup();
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && popup.classList.contains('is-open')) {
                closePopup();
            }
        });

        if (form) {
            form.addEventListener('submit', function () {
                storageSet(storageKey, '1');
            });
        }

        registerTriggers(openPopup);
    }

    function setupOdyssOfferPopup() {
        const popup = odyssOfferPopup;
        if (!popup) return;

        const dialog = popup.querySelector('.er-odyss-offer__panel');
        const form = popup.querySelector('form');
        const firstInput = popup.querySelector('input[name="name"]');
        const odyssBand = document.querySelector('.report-odyss-band');
        const storageKey = 'er_report_odyss_offer_seen_' + reportId;
        let opened = false;
        let triggerArmed = true;

        function closeOffer() {
            popup.classList.remove('is-open');
            popup.setAttribute('aria-hidden', 'true');

            if (![exitPopup, timedPopup, odyssOfferPopup].some(function (popupEl) {
                return popupEl && popupEl.classList.contains('is-open');
            })) {
                document.body.classList.remove('overflow-hidden');
            }
        }

        function openOffer() {
            if (opened || storageGet(storageKey) === '1' || sampleModalIsOpen() || anotherPopupIsOpen(popup)) return false;
            opened = true;
            storageSet(storageKey, '1');
            popup.classList.add('is-open');
            popup.setAttribute('aria-hidden', 'false');
            document.body.classList.add('overflow-hidden');
            window.setTimeout(function () {
                if (firstInput) firstInput.focus();
            }, 80);
            return true;
        }

        function maybeOpenAfterOdyss() {
            if (!triggerArmed || !odyssBand || opened || storageGet(storageKey) === '1') return;
            const rect = odyssBand.getBoundingClientRect();
            if (rect.bottom <= window.innerHeight + 80) {
                window.setTimeout(function () {
                    if (openOffer()) {
                        triggerArmed = false;
                    }
                }, 450);
            }
        }

        popup.addEventListener('click', function (event) {
            if (event.target.closest('[data-er-odyss-offer-close]')) {
                closeOffer();
                return;
            }

            if (dialog && !dialog.contains(event.target)) {
                closeOffer();
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && popup.classList.contains('is-open')) {
                closeOffer();
            }
        });

        if (form) {
            form.addEventListener('submit', function () {
                storageSet(storageKey, '1');
            });
        }

        window.addEventListener('scroll', maybeOpenAfterOdyss, { passive: true });
        window.addEventListener('resize', maybeOpenAfterOdyss);
        window.setTimeout(maybeOpenAfterOdyss, 700);
    }

    setupOdyssOfferPopup();

    setupPopup(exitPopup, 'er_exit_popup_seen_' + reportId, function (openPopup) {
        document.addEventListener('mouseleave', function (event) {
            if (event.clientY <= 8) {
                openPopup();
            }
        });

        let mobileTimerStarted = false;
        let mobileScrollable = 1;

        function updateMobileScrollable() {
            const doc = document.documentElement;
            mobileScrollable = Math.max(1, doc.scrollHeight - window.innerHeight);
        }

        updateMobileScrollable();
        window.addEventListener('resize', updateMobileScrollable);

        window.addEventListener('scroll', function () {
            if (mobileTimerStarted || window.innerWidth > 768) return;
            const progress = window.scrollY / mobileScrollable;

            if (progress >= 0.35) {
                mobileTimerStarted = true;
                window.setTimeout(openPopup, 45000);
            }
        }, { passive: true });
    });

    setupPopup(timedPopup, 'er_timed_popup_seen_' + reportId, function (openPopup) {
        window.setTimeout(openPopup, 10000);
    });
});
</script>


