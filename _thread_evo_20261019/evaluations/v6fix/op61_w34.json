    ],
    "because": [
     {
      "from": "S02-2",
      "to": "S03-1",
      "rel": "提供理由"
     },
     {
      "from": "S02-1",
      "to": "S03-3",
      "rel": "唤起"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  },
  "S04": {
   "edit": {
    "items": [
     {
      "id": "S04-1",
      "text": "他确实尝过那份亲近带来的快乐，所以虽知道当时的坚定也靠努力撑着，眼下虽不安仍愿意坚持。",
      "key": "亲近带来的快乐",
      "follows": false,
      "src": [
       "S04-1"
      ]
     },
     {
      "id": "S04-3",
      "text": "他怕停下就得承认那份亲近回不到从前，便硬撑着不肯停下，反复追问过去还能怎样，却仍无法安心。",
      "key": "回不到从前",
      "follows": true,
      "src": [
       "S04-3"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-3",
      "to": "S04-1",
      "rel": "动摇"
     },
     {
      "from": "S01-3",
      "to": "S04-3",
      "rel": "改写"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  },
  "S05": {
   "edit": {
    "items": [
     {
      "id": "S05-1",
      "text": "行动明明还不够，他却舍不得松手，怕承认失望就是变心。",
      "key": "舍不得松手",
      "follows": false,
      "src": [
       "S05-1"
      ]
     },
     {
      "id": "S05-2",
      "text": "他怕一软就停步，便不肯放下那份曾让他骄傲的要求，渐渐连脆弱都容不下，一累就怪自己不够坚定。",
      "key": "骄傲的要求",
      "follows": true,
      "src": [
       "S05-2",
       "S05-3"
      ]
     },
     {
      "id": "S05-3",
      "text": "他发现自己还在逼着一个累了的人硬撑，终于不想再证明自己多坚强。",
      "key": "逼着一个累了的人",
      "follows": true,
      "src": [
       "S05-4"
      ]
     },
     {
      "id": "S05-4",
      "text": "他终于松了劲，却没因此安心下来，这才肯承认自己舍不得那种不必防备的亲近。",
      "key": "不必防备的亲近",
      "follows": true,
      "src": [
       "S05-5"
      ]
     }
    ],
    "because": [
     {
      "from": "S04-3",
      "to": "S05-1",
      "rel": "仍在起作用"
     },
     {
      "from": "S02-1",
      "to": "S05-2",
      "rel": "改写"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  },
  "S06": {
   "edit": {
    "items": [
     {
      "id": "S06-1",
      "text": "催逼停下来后，他发现自己舍不得的不是一时舒服，而是曾真心相信过的生活：他盼着珍惜的东西不用靠争抢才能留住；他想付出时只是因为喜欢，不必反复证明自己值得被爱、被接纳，也不必先想着靠近会受伤。",
      "key": "曾真心相信",
      "follows": false,
      "src": [
       "S06-1"
      ]
     },
     {
      "id": "S06-4",
      "text": "他不愿把这份向往说成软弱。",
      "key": "软弱",
      "follows": true,
      "src": [
       "S06-4"
      ]
     },
     {
      "id": "S06-5",
      "text": "他暂时不再担心心里一软就会停步，才肯承认自己也有委屈和思念。",
      "key": "委屈和思念",
      "follows": true,
      "src": [
       "S06-5"
      ]
     },
     {
      "id": "S06-8",
      "text": "他允许自己去爱、去相信，先珍惜心里向往的生活，不急着求它实现或证明有用，也不拿责任和它比轻重。",
      "key": "先珍惜",
      "follows": true,
      "src": [
       "S06-8"
      ]
     }
    ],
    "because": [
     {
      "from": "S05-4",
      "to": "S06-1",
      "rel": "改写"
     },
     {
      "from": "S05-3",
      "to": "S06-5",
      "rel": "提供理由"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  },
  "S07": {
   "edit": {
    "items": [
     {
      "id": "S07-1",
      "text": "熟悉的亲近让他觉得向往的生活近在眼前，可现实并没因此改变，他懊恼自己又沉进去了。",
      "key": "熟悉的亲近",
      "follows": false,
      "src": [
       "S07-1"
      ]
     },
     {
      "id": "S07-2",
      "text": "他越真切地感到安宁，越不能只满足于在心里拥有那种生活，因为这份满足反而提醒他愿望还没实现。",
      "key": "心里安宁",
      "follows": true,
      "src": []
     },
     {
      "id": "S07-3",
      "text": "他当初不肯再等，是怕珍惜的东西继续受损，光在心里想着那种生活也护不住它们。",
      "key": "不肯再等",
      "follows": true,
      "src": [
       "S07-2"
      ]
     },
     {
      "id": "S07-4",
      "text": "他想重新投入，却怕刚找回的温柔被耗尽，也怕顾不上想留住的生活，仍没想定怎样争取才不伤那份温柔。",
      "key": "刚找回的温柔",
      "follows": true,
      "src": [
       "S07-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S06-8",
      "to": "S07-2",
      "rel": "改写"
     },
     {
      "from": "S01-2",
      "to": "S07-4",
      "rel": "仍在起作用"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  },
  "S08": {
   "edit": {
    "items": [
     {
      "id": "S08-1",
      "text": "安宁曾给过他很深的满足，他不必每次想起都立刻审问自己，仍愿爱惜片刻，欢喜里已有不舍。",
      "key": "爱惜片刻",
      "follows": false,
      "src": [
       "S08-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S07-2",
      "to": "S08-1",
      "rel": "提供理由"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  },
  "S09": {
   "edit": {
    "items": [
     {
      "id": "S09-1",
      "text": "他这回知道自己为什么迟疑：他有些怯懦，也不愿丢掉过上那种生活的盼头。",
      "key": "为什么迟疑",
      "follows": true,
      "src": [
       "S09-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S06-1",
      "to": "S09-1",
      "rel": "仍在起作用"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  },
  "S10": {
   "edit": {
    "items": [
     {
      "id": "S10-1",
      "text": "他提不起劲争取，也说不清为何舍不得丢开那一步和那份安宁。",
      "key": "丢开那一步",
      "follows": false,
      "src": [
       "S10-1"
      ]
     },
     {
      "id": "S10-2",
      "text": "他知道尽力去做确实帮过他，如今也让他难以继续，若还争取就得记得当初为什么不肯再等。",
      "key": "尽力去做",
      "follows": true,
      "src": []
     },
     {
      "id": "S10-3",
      "text": "他知道自己向往的生活确实曾让他安宁，可威胁它的事还在，珍惜它也不能把那些事放下。",
      "key": "向往的生活",
      "follows": false,
      "src": []
     },
     {
      "id": "S10-4",
      "text": "他反复想着自己究竟想护住什么，想歇一歇也不等于要把它丢下。",
      "key": "歇一歇",
      "follows": true,
      "src": [
       "S10-2"
      ]
     },
     {
      "id": "S10-5",
      "text": "他还不知道往后该怎么过，却不再急着判哪一边错，逼自己立刻选边的劲也松了一点。",
      "key": "选边的劲",
      "follows": true,
      "src": [
       "S10-3"
      ]
     }
    ],
    "because": [
     {
      "from": "S07-3",
      "to": "S10-2",
      "rel": "提供理由"
     },
     {
      "from": "S08-1",
      "to": "S10-3",
      "rel": "提供理由"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  },
  "S11": {
   "edit": {
    "items": [
     {
      "id": "S11-1",
      "text": "他知道行动给他的力气和那种生活的安宁都是真的，却很难两样都不受损地留住，便重新想还能承担什么。",
      "key": "还能承担",
      "follows": false,
      "src": [
       "S11-1",
       "S11-2"
      ]
     },
     {
      "id": "S11-5",
      "text": "他怕争取会伤到珍惜的东西，心里仍疼，也知道只因害怕而不争取，未必留得住它们，还可能让它们继续受损。",
      "key": "心里还是疼",
      "follows": true,
      "src": [
       "S11-2",
       "S11-5"
      ]
     },
     {
      "id": "S11-6",
      "text": "他知道再等也不会等来容易的路，便带着不舍和痛苦继续争取，不再要求自己先不害怕。",
      "key": "带着怕",
      "follows": true,
      "src": [
       "S11-6"
      ]
     }
    ],
    "because": [
     {
      "from": "S10-2",
      "to": "S11-1",
      "rel": "提供理由"
     },
     {
      "from": "S07-3",
      "to": "S11-5",
      "rel": "仍在起作用"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  },
  "S12": {
   "edit": {
    "items": [
     {
      "id": "S12-1",
      "text": "他知道该做什么，能做多少先做到多少，不必否认脆弱，也不用等犹疑消失才坚定，久违的昂扬又回来了。",
      "key": "能做多少",
      "follows": false,
      "src": [
       "S12-1"
      ]
     },
     {
      "id": "S12-3",
      "text": "他舍不得那种不必证明也能被爱、被接纳的生活，也怕失去它，愿为所爱负责，不再把牵挂当成行动的拖累。",
      "key": "真心爱惜",
      "follows": true,
      "src": [
       "S12-3"
      ]
     }
    ],
    "because": [
     {
      "from": "S11-6",
      "to": "S12-1",
      "rel": "改写"
     },
     {
      "from": "S06-1",
      "to": "S12-3",
      "rel": "提供理由"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  },
  "S13": {
   "edit": {
    "items": [
     {
      "id": "S13-1",
      "text": "他从前想退回安宁里护住那种生活，如今发现眼前的事也在替它争取。",
      "key": "替它争取",
      "follows": false,
      "src": [
       "S13-1"
      ]
     },
     {
      "id": "S13-2",
      "text": "旧愿近了些，让他重尝当初的快乐，愿望未成也不抹掉这份快乐，却不能代替他真正过上那种生活。",
      "key": "旧愿近了些",
      "follows": true,
      "src": [
       "S13-1",
       "S13-2"
      ]
     },
     {
      "id": "S13-3",
      "text": "他发现旧愿和眼前的行动虽能一起推着他，却仍可能彼此冲突。",
      "key": "彼此冲突",
      "follows": true,
      "src": [
       "S13-1"
      ]
     },
     {
      "id": "S13-4",
      "text": "他愿为那种生活吃苦，却知道再多付出也未必更靠近它，不能只因心愿就认定每一分付出都值得。",
      "key": "每一分付出",
      "follows": true,
      "src": [
       "S13-3"
      ]
     },
     {
      "id": "S13-5",
      "text": "他得留心别在争取时耗尽所爱，真要付代价时，仍可能累得想退回安宁。",
      "key": "耗尽所爱",
      "follows": true,
      "src": [
       "S13-3"
      ]
     },
     {
      "id": "S13-6",
      "text": "他不再反复找理由证明自己该往前，仍清楚知道那种生活是自己想要的。",
      "key": "自己想要的",
      "follows": true,
      "src": [
       "S13-4"
      ]
     }
    ],
    "because": [
     {
      "from": "S12-3",
      "to": "S13-1",
      "rel": "提供理由"
     },
     {
      "from": "S07-4",
      "to": "S13-5",
      "rel": "仍在起作用"
     }
    ]
   },
   "check": null,
   "notes": [],
   "revised": false
  }
 },
 "base": "w31 找回丢失 + 改复述 + 守 v6 形式"
}