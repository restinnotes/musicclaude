       "from": [
        "S01-B3-p3"
       ],
       "keys": []
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "离开熟悉的生活后，我终于不用再委屈自己。",
       "from": [
        "S01-1"
       ],
       "keys": []
      }
     ],
     "beads": [
      {
       "text": "无措",
       "from": [
        "S01-B1-p3"
       ],
       "keys": []
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "我想往前走，却不知道怎么安心。",
       "from": [
        "S01-3"
       ],
       "keys": []
      }
     ],
     "beads": [
