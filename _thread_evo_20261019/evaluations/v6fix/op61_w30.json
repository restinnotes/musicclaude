  "S08": {
   "edit": {
    "items": [
     {
      "id": "S08-1",
      "text": "他不愿只因眼下还做不到，就把那种亲近的向往说成软弱，仍愿意相信并珍惜它。",
      "key": "仍愿意珍惜",
      "follows": false,
      "causes": [
       "c1"
