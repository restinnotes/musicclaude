  .emer-sample-modal.is-email-only .emer-sample-modal__card {
    max-width: 435px;
    border-radius: 8px;
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.28);
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__bar,
  .emer-sample-modal.is-email-only .emer-sample-modal__eyebrow,
  .emer-sample-modal.is-email-only .emer-sample-modal__subtitle,
  .emer-sample-modal.is-email-only .emer-sample-modal__report-strip,
  .emer-sample-modal.is-email-only [data-emer-modal-phone-field],
  .emer-sample-modal.is-email-only [data-emer-modal-message-field] {
    display: none;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__header {
    padding: 34px 24px 0;
    background: #ffffff;
    text-align: center;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__header::after {
    display: none;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__header-inner {
    padding-right: 0;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__close {
    top: 13px;
    right: 13px;
    width: 25px;
    height: 25px;
    border: 0;
    background: transparent;
    color: #777777;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__close:hover {
    background: transparent;
    color: #333333;
    transform: none;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__title {
    max-width: 360px;
    margin: 0 auto;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #252957;
    line-height: 1.45;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__title-em {
    color: inherit;
    font-style: normal;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__form {
    padding: 8px 24px 24px;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__field-row {
    display: block;
    margin-bottom: 0;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__field-row .emer-sample-modal__field:first-child {
    display: none;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__label {
    color: #3b556d;
    font-size: 10.5px;
    font-weight: 700;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__input {
    height: 46px;
    padding: 0 14px;
    background: #f8fbfd;
    border: 1px solid #c9d6e2;
    border-radius: 8px;
    color: #1d2939;
    font-size: 14px;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__input-icon,
  .emer-sample-modal.is-email-only .emer-sample-modal__submit svg {
    display: none;
  }
  .emer-sample-modal.is-email-only .emer-sample-modal__submit {
    margin-top: 16px;
    padding: 12px 18px;
    border-radius: 3px;
    background: linear-gradient(180deg, #42bfd8 0%, #28b5ca 100%);
    box-shadow: 0 3px 8px rgba(0, 122, 144, 0.22);
    font-size: 14px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .emer-sample-modal__trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(13, 43, 69, 0.1);
  }
  .emer-sample-modal__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: #8BA5BA;
  }
  .emer-sample-modal__trust-item svg {
    color: #0D7A4E;
    flex-shrink: 0;
  }
  @media (max-width: 540px) {
    .emer-sample-modal__viewport {
      align-items: stretch;
      padding: 0;
    }
    .emer-sample-modal__card {
      max-width: 100%;
      max-height: 100vh;
      min-height: 100vh;
      height: 100vh;
      border-radius: 0;
      box-shadow: none;
    }
    .emer-sample-modal__header {
      padding: 16px 16px 14px;
    }
    .emer-sample-modal__form {
      padding: 14px 16px 16px;
    }
    .emer-sample-modal__backdrop {
      background: rgba(7, 24, 37, 0.92);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    .emer-sample-modal__header-inner {
      padding-right: 28px;
    }
    .emer-sample-modal__eyebrow {
      margin-bottom: 8px;
      padding: 3px 9px;
    }
    .emer-sample-modal__eyebrow-text {
      font-size: 7.5px;
      letter-spacing: 0.15em;
    }
    .emer-sample-modal__title {
      font-size: 18px;
      margin-bottom: 4px;
    }
    .emer-sample-modal__subtitle {
      font-size: 11.5px;
      line-height: 1.45;
      max-width: 92%;
    }
    .emer-sample-modal__report-strip {
      gap: 8px;
      margin-top: 10px;
      padding: 9px 10px;
    }
    .emer-sample-modal__report-icon {
      width: 26px;
      height: 26px;
    }
    .emer-sample-modal__report-name {
      font-size: 11px;
    }
    .emer-sample-modal__report-meta {
      font-size: 7px;
      letter-spacing: 0.08em;
    }
    .emer-sample-modal__close {
      top: 14px;
      right: 14px;
      width: 28px;
      height: 28px;
    }
    .emer-sample-modal__field-row {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }
    .emer-sample-modal__field--full {
      margin-bottom: 12px;
    }
    .emer-sample-modal__label {
      font-size: 10.5px;
    }
    .emer-sample-modal__input,
    .emer-sample-modal__select {
      height: 44px;
      padding: 0 11px 0 36px;
      font-size: 12.5px;
    }
    .emer-sample-modal__input-icon {
      left: 10px;
    }
    .emer-sample-modal__phone-row {
      display: grid;
      grid-template-columns: minmax(0, 46%) minmax(0, 54%);
      gap: 8px;
    }
    .emer-sample-modal__phone-code {
      width: 100%;
      min-width: 0;
      padding-right: 26px;
      font-size: 12px;
      background-position: right 8px center;
    }
    .emer-sample-modal__textarea {
      min-height: 88px;
      font-size: 12.5px;
      padding: 10px 12px;
    }
    .emer-sample-modal__submit {
      margin-top: 12px;
      padding: 12px 16px;
      font-size: 13px;
    }
    .emer-sample-modal__trust-row {
      gap: 8px 12px;
      margin-top: 10px;
      padding-top: 10px;
    }
    .emer-sample-modal__trust-item {
      font-size: 10px;
    }
  }
  .report-odyss-band {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(135deg, #0a2238 0%, #0d2b45 50%, #0f3554 100%);
    background-size: 64px 64px, 64px 64px, cover;
  }
  .report-odyss-band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(9,31,49,0.16) 0%, rgba(9,31,49,0.02) 34%, rgba(9,31,49,0.14) 100%);
    pointer-events: none;
  }
  .report-odyss-band__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .report-odyss-band__layout {
    display: grid;
    grid-template-columns: minmax(470px, 0.88fr) minmax(520px, 1.12fr);
    gap: 44px;
    min-height: 0;
    align-items: stretch;
  }
  .report-odyss-band__content {
    padding: 38px 0 40px;
    border-right: 1px solid rgba(255,255,255,0.06);
  }
  .report-odyss-band__visual {
    padding: 22px 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
  }
  .report-odyss-band__eyebrow-row {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    margin-bottom: 14px;
  }
  .report-odyss-band__eyebrow,
  .report-odyss-band__eyebrow-alt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 28px;
    padding: 0 14px;
    border: 1px solid rgba(15,184,216,0.4);
    color: #05b8d8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .report-odyss-band__eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 2px solid #05b8d8;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .report-odyss-band__eyebrow-dot::after {
    content: '';
    width: 2px;
    height: 2px;
    border-radius: 999px;
    background: #05b8d8;
  }
  .report-odyss-band__title {
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: clamp(30px, 2.75vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 800;
    margin: 0;
    max-width: 500px;
    text-align: left;
    text-wrap: balance;
  }
  .report-odyss-band__accent {
    color: #05b8d8;
    -webkit-text-fill-color: #05b8d8;
  }
  .report-odyss-band__copy {
    max-width: 500px;
    margin: 22px 0 0;
    color: rgba(214,226,237,0.9);
    -webkit-text-fill-color: rgba(214,226,237,0.9);
    font-size: 15px;
    line-height: 1.8;
    text-align: left;
  }
        .report-odyss-band__tabs {
            margin-top: 22px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            max-width: 360px;
        }
        .report-odyss-band__tabs--visual {
            margin-top: 22px;
            width: 100%;
            max-width: 520px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }
        .report-odyss-band__tab {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 38px;
    padding: 0 14px;
    border: 1px solid rgba(92,127,150,0.26);
    background: rgba(255,255,255,0.04);
    color: rgba(214,226,237,0.9);
    -webkit-text-fill-color: rgba(214,226,237,0.9);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
  }
  .report-odyss-band__tab::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #05b8d8;
    flex: 0 0 auto;
  }
  .report-odyss-band__actions {
    display: flex;
    justify-content: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 34px;
  }
  .report-odyss-band__pricing {
    display: inline-flex;
    margin-top: 14px;
    color: rgba(214,226,237,0.72);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(214,226,237,0.18);
    padding-bottom: 4px;
  }
  .report-odyss-band__pricing:hover {
    color: #ffffff;
    border-color: rgba(214,226,237,0.38);
  }
  .report-odyss-band__image {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 344 / 208;
  }
  .report-odyss-band__image img {
    width: 100%;
    max-width: 520px;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .report-odyss-band__tabs--visual .report-odyss-band__tab {
    width: 100%;
  }
  .report-odyss-band__tabs--visual .report-odyss-band__tab:last-child {
    grid-column: 1 / span 2;
    width: calc(50% - 5px);
  }
  .report-odyss-band__btn {
    min-width: 232px;
    min-height: 40px;
    padding: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: "Sora", sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .report-odyss-band__btn--primary {
    background: #0f8ea4;
    border: 1px solid #0f8ea4;
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
  }
  .report-odyss-band__btn--primary:hover {
    background: #107f92;
    border-color: #107f92;
  }
  .report-odyss-band__btn--secondary {
    background: transparent;
    border: 1px solid rgba(214,226,237,0.28);
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
  }
  .report-odyss-band__btn--secondary:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(214,226,237,0.42);
  }
  .er-odyss-offer {
    position: fixed;
    inset: 0;
    z-index: 99990;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(7, 24, 37, 0.84);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .er-odyss-offer.is-open {
    display: flex;
    animation: erOdyssOfferFade 0.22s ease both;
  }
  .er-odyss-offer__panel {
    position: relative;
    width: min(100%, 500px);
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
    background: #ffffff;
    box-shadow: 0 32px 80px rgba(7, 24, 37, 0.45);
    animation: erOdyssOfferRise 0.3s cubic-bezier(0.22, 0.9, 0.28, 1) both;
  }
  .er-odyss-offer__crown {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 56px 14px 22px;
    background:
      linear-gradient(90deg, rgba(7,24,37,0.055) 1px, transparent 1px),
      linear-gradient(90deg, #ff9f0a 0%, #ffc24a 52%, #ff9f0a 100%);
    background-size: 56px 100%, auto;
    border-bottom: 1px solid rgba(7, 24, 37, 0.2);
  }
  .er-odyss-offer__plate {
    flex: 0 0 auto;
    padding: 7px 12px;
    background: #071825;
    color: #ffc24a;
    font-family: "Sora", sans-serif;
    font-size: 19px;
    font-weight: 800;
    line-height: 1;
  }
  .er-odyss-offer__plate sup {
    font-size: 11px;
    vertical-align: 0.6em;
  }
  .er-odyss-offer__label {
    color: rgba(7, 24, 37, 0.74);
    font-family: "JetBrains Mono", monospace;
    font-size: 9.5px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .er-odyss-offer__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: rgba(7, 24, 37, 0.62);
    cursor: pointer;
  }
  .er-odyss-offer__close:hover {
    color: #071825;
    background: rgba(7, 24, 37, 0.14);
  }
  .er-odyss-offer__body {
    padding: 24px 30px 28px;
  }
  .er-odyss-offer__title {
    margin: 0 0 9px;
    color: #0d2b45;
    font-family: "Sora", sans-serif;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.25;
  }
  .er-odyss-offer__intro {
    margin: 0 0 20px;
    color: #5e7286;
    font-size: 13.5px;
    line-height: 1.6;
  }
  .er-odyss-offer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-bottom: 16px;
  }
  .er-odyss-offer__field {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .er-odyss-offer__field label {
    margin-bottom: 7px;
    color: #3b556d;
    font-family: "JetBrains Mono", monospace;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .er-odyss-offer__field label span {
    color: rgba(94, 114, 134, 0.68);
  }
  .er-odyss-offer__input {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    color: #1a2b3c;
    background: #f8fbfd;
    border: 1px solid #c9d6e2;
    border-radius: 8px;
    outline: none;
    font: 500 14px/1.4 "Inter", sans-serif;
    transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
    box-sizing: border-box;
  }
  .er-odyss-offer__input::placeholder {
    color: #7f93a7;
    font-weight: 400;
  }
  .er-odyss-offer__input:focus {
    border-color: #007a90;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(0, 122, 144, 0.16);
  }
  .er-odyss-offer__consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 18px;
    color: #5e7286;
    font-size: 12px;
    line-height: 1.55;
  }
  .er-odyss-offer__consent input {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: 1px;
    accent-color: #007a90;
  }
  .er-odyss-offer__consent a {
    color: #007a90;
    text-decoration: underline;
  }
  .er-odyss-offer__captcha {
    margin: 4px 0 16px;
    display: flex;
    justify-content: center;
  }
  .er-odyss-offer__captcha .er-captcha-block {
    margin: 0 !important;
  }
  .er-odyss-offer__submit {
    width: 100%;
    padding: 14px 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 1px solid #071825;
    background: #071825;
    color: #ffffff;
    cursor: pointer;
    font: 700 12.5px/1 "Inter", sans-serif;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .er-odyss-offer__submit:hover {
    background: #007a90;
    border-color: #007a90;
  }
  .er-odyss-offer__fine {
    margin: 12px 0 0;
    color: rgba(94, 114, 134, 0.86);
    text-align: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 9.5px;
    line-height: 1.7;
    letter-spacing: 0;
  }
  @keyframes erOdyssOfferFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes erOdyssOfferRise {
    from { opacity: 0; transform: translateY(16px) scale(0.972); }
    to { opacity: 1; transform: none; }
  }
  @media (max-width: 767px) {
    .report-breadcrumb,
    .report-hero-inner,
    .report-nav-inner,
    .report-shell,
    .report-mobile-dock {
      box-sizing: border-box;
    }
    .report-mobile-dock {
      display: grid;
    }
    .report-breadcrumb,
    .report-hero-inner,
    .report-nav-inner {
      padding-left: 16px;
      padding-right: 48px;
    }
    .report-nav-inner {
      mask-image: linear-gradient(to right, transparent 0, #000 12px, #000 calc(100% - 12px), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 12px, #000 calc(100% - 12px), transparent 100%);
    }
    .report-nav-scroll {
      width: 30px;
      height: 30px;
    }
    .report-nav-scroll--left {
      left: 6px;
    }
    .report-nav-scroll--right {
      right: 6px;
    }
    .report-hero {
      padding-top: 26px;
      padding-bottom: 32px;
    }
    .report-hero-title {
      font-size: clamp(24px, 8vw, 34px);
      line-height: 1.12;
    }
    .report-hero-subtitle {
      font-size: 13px;
    }
    .report-cta-band__inner {
      padding: 44px 18px 48px;
    }
    .report-cta-band__copy {
      font-size: 15px;
    }
    .report-cta-band__btn {
      width: 100%;
      min-width: 0;
    }
    .rd-similar-reports__inner {
      padding: 26px 18px 30px;
    }
    .rd-similar-reports__heading {
      margin-bottom: 20px;
      font-size: 18px;
    }
    .rd-similar-reports__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .report-odyss-band__inner {
      padding: 0 18px;
    }
    .report-odyss-band__layout {
      grid-template-columns: 1fr;
      gap: 18px;
      min-height: auto;
    }
    .report-odyss-band__content {
      padding: 28px 0 26px;
      border-right: 0;
    }
    .report-odyss-band__visual {
      padding: 0 0 28px;
      align-items: stretch;
    }
    .report-odyss-band__eyebrow-row {
      margin-bottom: 12px;
    }
    .report-odyss-band__eyebrow-alt {
      display: none;
    }
    .report-odyss-band__copy {
      font-size: 15px;
    }
    .report-odyss-band__tabs {
      max-width: none;
    }
    .report-odyss-band__tabs--visual {
      max-width: none;
      margin-top: 14px;
      grid-template-columns: 1fr;
    }
    .report-odyss-band__tabs--visual {
      max-width: 90%;
    }
    .report-odyss-band__tabs--visual .report-odyss-band__tab:last-child {
      grid-column: auto;
      width: 100%;
    }
    .report-odyss-band__btn {
      width: 100%;
      min-width: 0;
    }
    .er-odyss-offer {
      padding: 0;
      align-items: flex-end;
    }
    .er-odyss-offer__panel {
      width: 100%;
      max-height: 96dvh;
    }
    .er-odyss-offer__crown {
      padding: 13px 52px 13px 18px;
    }
    .er-odyss-offer__body {
      padding: 20px 18px 24px;
    }
    .er-odyss-offer__title {
      font-size: 19px;
    }
    .er-odyss-offer__input {
      height: 44px;
      padding: 0 12px;
      font-size: 13px;
    }
    .report-shell {
      display: block;
      padding: 20px 16px 32px;
      gap: 24px;
    }
    .report-main-stack,
    .report-sidebar-stack {
      width: auto;
      max-width: none;
      flex: initial;
    }
    .snapshot-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .exec-kpi-row {
      grid-template-columns: 1fr;
    }
    .figure-label-row,
    .figure-heading,
    .figure-image-wrap,
    .figure-cta-strip {
      padding-left: 16px;
      padding-right: 16px;
    }
    .figure-image-frame {
      padding: 0;
      max-width: 100%;
    }
    .figure-image-lightbox-trigger {
      top: 10px;
      right: 10px;
      width: 34px;
      height: 34px;
    }
    .figure-lightbox {
      padding: 12px;
    }
    .figure-lightbox__frame {
      padding: 12px;
      border-radius: 14px;
    }
    .figure-cta-strip {
      grid-template-columns: 1fr;
      gap: 14px;
      padding-top: 16px;
      padding-bottom: 16px;
    }
    .figure-cta-actions {
      width: 100%;
      justify-content: stretch;
      flex-direction: column;
    }
    .figure-cta-btn {
      width: 100%;
      padding: 0;
    }
    .company-overview-cta__inner {
      grid-template-columns: 1fr;
      padding: 18px 16px;
      gap: 14px;
    }
    .company-overview-cta__actions {
      width: 100%;
      justify-content: stretch;
    }
    .company-overview-cta__btn {
      width: 100%;
    }
    .company-overview-cta__text {
      max-width: 100%;
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .company-overview-cta__btn {
      min-height: 46px;
      height: auto;
      padding: 13px 14px;
      line-height: 1.45;
      white-space: normal;
      letter-spacing: 0.06em;
    }
    .company-chip-grid {
      grid-template-columns: 1fr;
    }
    .addresses-grid {
      grid-template-columns: 1fr;
    }
    .toc-grid {
      grid-template-columns: 1fr;
    }
    .author-card__inner {
      gap: 14px;
      align-items: flex-start;
    }
    .author-card__avatar {
      width: 54px;
      height: 54px;
      font-size: 17px;
    }
    .author-card__header {
      flex-direction: column;
      gap: 8px;
    }
    .rd-inline-cta {
      padding: 18px 16px;
    }
    .rd-inline-cta__title {
      font-size: 20px;
    }
    .rd-inline-cta__actions {
      width: 100%;
      flex-direction: column;
    }
    .rd-inline-cta__btn,
    .rd-inline-cta__link {
      width: 100%;
      padding: 0;
    }
    .sidebar-analyst-card {
      padding-left: 18px;
      padding-right: 18px;
    }
    .sidebar-related-card {
      padding-left: 18px;
      padding-right: 18px;
    }
    .faq-answer {
      max-width: 100%;
    }
  }
  .er-title {
    font-family: "Sora", sans-serif;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  :root {
    --er-header-offset: 66px;
    --er-authorbar-height: 64px;
    --er-actionbar-height: 62px;
  }
  .er-progress {
    height: 2px;
    background: #3b82f6;
    width: 0%;
    transition: width 0.1s linear;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }
  .er-sticky-parent {
    overflow: visible !important;
    position: relative;
  }
  .er-authorbar {
    position: sticky !important;
    top: var(--er-header-offset) !important;
    left: auto !important;
    right: auto !important;
    width: 100%;
    z-index: 60;
    padding-left: 0;
    padding-right: 0;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(6px);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    transition: top 0.2s ease, box-shadow 0.2s ease;
  }
  @media (min-width: 768px) {
    .er-authorbar {
      position: sticky !important;
      top: var(--er-header-offset) !important;
    }
  }
  .er-sidebar-sticky {
    position: sticky;
    top: calc(var(--er-header-offset) + var(--er-actionbar-height) + 16px);
    align-self: flex-start;
    max-height: none;
    overflow: visible;
  }
  @media (max-width: 767px) {
    .er-sidebar-sticky {
      position: static;
      top: auto;
    }
  }

  /* FMI-inspired report detail refresh */
  #report-details,
  .report_section {
    background: #f6f8ff !important;
  }
  .mck-article,
  .mck-article h2,
  .mck-article h3,
  .mck-article p,
  .mck-article li,
  .report-prose,
  .report-prose p,
  .report-prose li {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
  }
  .breadcrumb-bar,
  .report-hero {
    background: #123757 !important;
  }
  .report-hero {
    background: #123f63 !important;
  }
  .report-hero::before {
    display: none;
  }
  .report-hero {
    padding: 0;
    box-shadow: none !important;
    filter: none !important;
    outline: 0 !important;
  }
  .report-hero::after {
    display: none !important;
  }
  .swiper-button-prev,
  .swiper-button-next,
  .slick-prev,
  .slick-next,
  .owl-prev,
  .owl-next,
  .carousel-control-prev,
  .carousel-control-next,
  .arrow.left,
  .arrow.right {
    display: none !important;
  }
  .report-hero-inner,
  .report-nav-inner,
  .report-shell {
    max-width: 1304px;
  }
  .report-hero-inner {
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr);
    padding-top: 38px;
    padding-bottom: 34px;
  }
  .report-hero-inner::before {
    content: "";
    display: block;
    width: 7px;
    min-height: 100%;
    background: linear-gradient(180deg, #66d8ea 0%, #ff6b1a 100%);
  }
  .report-hero-body {
    min-width: 0;
    padding-left: 28px;
  }
  .report-category-tag {
    max-width: 100%;
    margin-bottom: 12px;
    padding: 7px 12px;
    border: 1px solid rgba(102,216,234,0.34);
    background: transparent;
    color: #66d8ea;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.45;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .report-hero-title {
    max-width: 980px;
    margin-bottom: 10px;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
  }
  .report-hero-subtitle {
    max-width: 980px;
    margin-bottom: 16px;
    color: rgba(255,255,255,0.76);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.72;
  }
  .rd-actionbar {
    position: sticky;
    top: var(--er-header-offset);
    z-index: 80;
    width: 100%;
    max-width: 100vw;
    min-height: 74px;
    height: auto;
    margin-top: 0;
    background: #ffffff;
    border-bottom: 3px solid #0868ad;
    box-shadow: none;
    backdrop-filter: blur(8px);
    box-sizing: border-box;
    overflow: hidden;
  }
  .rd-actionbar__inner {
    width: 100%;
    max-width: 100%;
    min-height: 74px;
    margin: 0 auto;
    padding: 12px clamp(12px, 1.8vw, 24px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(12px, 1.8vw, 24px);
    box-sizing: border-box;
    min-width: 0;
  }
  .rd-actionbar__brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    text-decoration: none;
  }
  .rd-actionbar__brand img {
    display: block;
    width: 32px;
    height: 32px;
    max-width: 32px;
    max-height: 32px;
    object-fit: contain;
  }
  .rd-actionbar__title {
    min-width: 0;
    flex: 1 1 auto;
    color: #003c75;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rd-actionbar__actions {
    flex: 0 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: flex-end;
  }
  .rd-actionbar__btn {
    min-height: 46px;
    padding: 0 clamp(14px, 1.7vw, 24px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 999px;
    color: #0f1111;
    font-size: 16px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .rd-actionbar__btn span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rd-actionbar__btn svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }
  .rd-actionbar__btn--sample {
    border: 1px solid #ffd44d;
    background: #ffd44d;
  }
  .rd-actionbar__btn--sample:hover {
    background: #f4c63e;
    border-color: #f4c63e;
    color: #0f1111;
  }
  .rd-actionbar__btn--pdf {
    border: 1px solid #ff6633;
    background: #ffffff;
    color: #ff6633;
  }
  .rd-actionbar__btn--pdf:hover {
    background: #fff7f2;
    border-color: #f0572b;
    color: #f0572b;
  }
  @media (max-width: 1180px) {
    .rd-actionbar__title {
      font-size: 14px;
    }
    .rd-actionbar__actions {
      gap: 8px;
    }
    .rd-actionbar__btn {
      min-height: 42px;
      padding: 0 14px;
      gap: 7px;
      font-size: 14px;
    }
    .rd-actionbar__btn svg {
      width: 16px;
      height: 16px;
    }
  }
  @media (max-width: 980px) {
    .rd-actionbar__title {
      display: none;
    }
    .rd-actionbar__actions {
      flex: 1 1 auto;
    }
    .rd-actionbar__btn {
      flex: 1 1 0;
    }
  }
  .report-hero-meta {
    gap: 18px;
    margin-bottom: 18px;
  }
  .hero-meta-item,
  .hero-meta-label,
  .hero-meta-value {
    font-size: 12px;
  }
  .report-nav {
    position: static;
    background: #ffffff;
    border-bottom: 1px solid rgba(18,55,87,0.12);
    box-shadow: none;
  }
  .report-nav::before,
  .report-nav::after,
  .report-nav-scroll {
    display: none !important;
  }
  .report-nav-link {
    padding: 13px 20px 12px;
    border-bottom-width: 3px;
    color: #24384a;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }
  .report-nav-link:hover {
    color: #0868ad;
    border-color: #0868ad;
  }
  .report-shell {
    gap: 28px;
    padding: 26px 36px 42px;
  }
  .report-main-stack {
    flex: 1 1 auto;
    width: auto;
    max-width: none;
  }
  #report-content {
    background: #ffffff;
    border: 1px solid rgba(18,55,87,0.1);
    border-radius: 0;
    box-shadow: none;
    padding: 44px 34px 38px;
  }
  .report-sidebar-stack {
    flex: 0 0 299px;
    width: 299px;
    max-width: 299px;
  }
  .content-block {
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    padding: 16px 0;
    margin-bottom: 0;
    border-bottom: 0;
  }
  #report-content > .content-block:first-child {
    padding-top: 0;
  }
  .content-block:last-child {
    border-bottom: 0;
  }
  .section-title {
    position: relative;
    display: inline-block;
    margin: 0 0 18px;
    padding-bottom: 13px;
    color: #004392;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 23px;
    font-weight: 500;
    line-height: 1.28;
  }
  .section-title::before {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 60px;
    height: 3px;
    border-radius: 0;
    background: #0667ac;
  }
  .report-prose {
    color: #000000;
    font-size: 16px;
    line-height: 1.62;
  }
  .report-prose p,
  .report-prose li {
    color: #000000;
    font-size: 16px;
    line-height: 1.62;
  }
  .report-prose p {
    margin: 0 0 20px;
    text-align: justify;
  }
  .report-prose > *:last-child {
    margin-bottom: 0;
  }
  .report-prose ul,
  .report-prose ol {
    margin: 0 0 22px 20px;
    padding-left: 0;
  }
  .report-prose li + li {
    margin-top: 4px;
  }
  .report-prose li::marker {
    color: #0667ac;
  }
  .updates-block {
    padding-top: 10px;
  }
  .updates-block .section-title {
    display: block;
    margin: 0 0 24px;
    padding: 0 0 18px;
    border-bottom: 1px solid #d8e1ea;
    color: #071d2f;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
  }
  .updates-block .section-title::before {
    display: none;
  }
  .updates-timeline {
    display: grid;
  }
  .updates-timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    column-gap: 14px;
  }
  .updates-timeline__rail {
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 7px;
  }
  .updates-timeline__item:not(:first-child) .updates-timeline__rail::before,
  .updates-timeline__item:not(:last-child) .updates-timeline__rail::after {
    content: "";
    position: absolute;
    left: 50%;
    width: 1px;
    background: #d8e1ea;
    transform: translateX(-50%);
  }
  .updates-timeline__item:not(:first-child) .updates-timeline__rail::before {
    top: -26px;
    height: 33px;
  }
  .updates-timeline__item:not(:last-child) .updates-timeline__rail::after {
    top: 23px;
    bottom: -26px;
  }
  .updates-timeline__dot {
    position: relative;
    z-index: 1;
    width: 17px;
    height: 17px;
    border: 3px solid #4ab6d2;
    border-radius: 50%;
    background: #ffffff;
    box-sizing: border-box;
  }
  .updates-timeline__content {
    position: relative;
    padding: 0 0 26px;
    color: #183b56;
    font-size: 17px;
    line-height: 1.7;
    text-align: left;
  }
  .updates-timeline__content p {
    margin: 0;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
    text-align: left;
  }
  .updates-timeline__content > *:last-child {
    margin-bottom: 0;
  }
  .updates-timeline__item:last-child .updates-timeline__content {
    padding-bottom: 0;
  }
  .report-prose h3 {
    margin: 22px 0 10px;
    color: #005fab;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
  }
  .rd-impact-analysis-heading,
  .report-prose .rd-impact-analysis-heading {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: auto;
    min-height: 0;
    margin: 14px 0 10px;
    padding: 5px 12px;
    border: 1px solid #a8d7e7;
    border-radius: 999px;
    background: #effaff;
    color: #2a86a1;
    font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.1;
    text-transform: uppercase;
    box-sizing: border-box;
  }
  .rd-impact-analysis-heading::before,
  .report-prose .rd-impact-analysis-heading::before {
    content: "";
    flex: 0 0 auto;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #48b6d0;
  }
  .report-prose .rd-impact-note {
    margin: 16px 0 24px;
    padding: 16px 18px;
    border: 1px solid #d7e5ef;
    border-radius: 10px;
    background: #f4f9fd;
    color: #2d485d;
    font-size: 14px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.6;
    box-sizing: border-box;
  }
  .report-prose h4 {
    margin: 20px 0 10px;
    color: #005fab;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
  }
  .section-title + .report-prose > h3:first-child,
  .section-title + .report-prose > h4:first-child {
    margin-top: 4px;
  }
  #emer-market-size {
    margin: 0;
    padding: 16px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  #emer-market-size .section-title {
    display: block;
    margin: 0 0 24px;
    padding: 0 0 20px;
    border-bottom: 1px solid #d8e1ea;
    color: #06263b;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
  }
  #emer-market-size .section-title::before {
    display: none;
  }
  .rd-market-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0 0 28px;
    padding: 0;
    background: transparent;
    border-radius: 0;
  }
  .rd-market-metric {
    position: relative;
    min-height: 150px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 28px 22px;
    overflow: hidden;
    background: linear-gradient(180deg, #ffffff 0%, #f0fbff 100%);
    border: 1px solid #d7e3ef;
    border-radius: 12px;
  }
  .rd-market-metric::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: #4ab6d2;
  }
  .rd-market-metric:nth-child(2)::before {
    background: #10b981;
  }
  .rd-market-metric:nth-child(3)::before {
    background: #ff6418;
  }
  .rd-market-metric__icon {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: #ffffff;
  }
  .rd-market-metric__icon svg {
    width: 17px;
    height: 17px;
    stroke: currentColor;
  }
  .rd-market-metric__icon--size {
    background: #3b82f6;
  }
  .rd-market-metric__icon--forecast {
    background: #10b981;
  }
  .rd-market-metric__icon--cagr {
    background: #f97316;
  }
  .rd-market-metric__label {
    color: #758aa0;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .rd-market-metric__value {
    margin-top: 7px;
    color: #06263b;
    font-size: 22px;
    font-weight: 800;
    line-height: 1.1;
  }
  .rd-market-metric__value--growth {
    color: #00bf63;
  }
  .content-block--key-takeaways {
    margin: 0;
    padding: 16px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  #emer-custom-26 + #emer-segmentation {
    padding-top: 36px;
  }
  #emer-faq {
    padding-top: 0;
  }
  #emer-addresses + .author-card,
  .author-card {
    margin-top: 16px;
  }
  .content-block--key-takeaways .section-title {
    display: block;
    margin: 0 0 24px;
    padding: 0 0 20px;
    border-bottom: 1px solid #d8e1ea;
    color: #06263b;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
  }
  .content-block--key-takeaways .section-title::before {
    display: none;
  }
  .key-takeaways-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .key-takeaways-card {
    min-height: 260px;
    padding: 20px 18px 18px;
    border: 1px solid #d7e3ef;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 8px 20px rgba(13, 43, 69, 0.04);
  }
  .key-takeaways-card__title {
    margin: 0 0 14px;
    color: #06263b;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.35;
  }
  .key-takeaways-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .key-takeaways-list li {
