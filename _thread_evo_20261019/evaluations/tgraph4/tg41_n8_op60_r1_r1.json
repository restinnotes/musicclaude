     "rel": "提供理由"
    },
    {
     "from": "I38",
     "to": "I56",
     "rel": "改写"
    }
   ]
  },
  {
   "bars": "103–110",
   "relation": "正在面对",
   "items": [
    {
     "id": "I58",
     "text": "幸福仍鲜明时，他发现自己再怎样深情，也无法凭此得到对方同样深切的选择。",
     "key": "同样深切的选择",
     "kind": "满足照出未满足"
    },
    {
     "id": "I59",
     "text": "想到这里他仍会酸楚，刚才的欢喜如此真实，他再难说服自己不在乎回应。",
     "key": "再难说服",
     "kind": "知道更多反而更尖锐"
    },
    {
     "id": "I60",
     "text": "他担心把安稳全交给对方，会让对方连他的全部不安也必须负责消除。",
     "key": "全部不安",
     "kind": "选择的代价"
    },
    {
     "id": "I61",
     "text": "他也不愿因怕得不到，就有意削弱那些带给自己巨大幸福的感情。",
     "key": "有意削弱",
     "kind": ""
    },
    {
     "id": "I62",
     "text": "他终于看出，克制虽曾带来安心，却没消除渴望，尽情投入也无法排除失望。",
     "key": "无法排除失望",
     "kind": "办法的限度"
    },
    {
     "id": "I63",
     "text": "想靠近的迫切和不肯勉强对方的坚持都没有退去，他因此更强烈地感到冲突。",
     "key": "更强烈",
     "kind": "知道更多反而更尖锐"
    },
    {
     "id": "I64",
     "text": "他宁可承受这份不轻松，也不愿再为求轻松而匆忙舍弃其中一边。",
     "key": "宁可承受",
     "kind": "选择的代价"
    }
   ],
