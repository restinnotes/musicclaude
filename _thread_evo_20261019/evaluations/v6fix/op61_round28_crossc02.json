      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S11",
    "bars": "226–241",
    "relation": "正在面对",
    "items": [
     {
      "id": "S11-1",
      "text": "他仍觉得疲惫，却一点点又生出照自己认可的方式往下过的心劲。",
      "key": "他仍觉得疲惫，却",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-4",
       "S10-3"
      ]
     },
     {
      "id": "S11-2",
      "text": "失落仍一阵阵逼过来，每次都让他想停在等待里，可他又不愿就这么搁下对自己的要求。",
      "key": "失落仍一阵阵逼过",
      "follows": false,
      "explains": [],
      "cite": [
       "S02-4",
       "S11-1"
      ]
     },
     {
      "id": "S11-3",
      "text": "他不想非等到心里安稳了，才肯照自己看得起的方式做。",
      "key": "他不想非等到心里",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-4",
       "S11-2"
      ]
     },
     {
      "id": "S11-4",
      "text": "就算旧日的归属始终没有回来，他也希望回头看今天时，不会因为自己的做法而瞧不起自己。",
      "key": "就算旧日的归属始",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S11-3"
      ]
     }
    ],
    "because": [
     {
