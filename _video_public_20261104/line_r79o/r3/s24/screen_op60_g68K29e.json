       "from": [
        "S08-B2"
       ],
       "bars": "62-70",
       "at": 18.0
      },
      {
       "text": "带着一点玩心，像轻快的调情与回应",
       "bead": "S08-B2",
       "from": [
        "S08-B2"
       ],
       "bars": "62-70",
       "at": 18.0
      }
