 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他已经认定不该靠否定自己换回旧日归属，起初很郑重地想守住这个选择",
       "keys": [
        "不该靠否定自己换回旧日归属"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可这份支撑很快松动，心里甚至闪过不想再这样撑下去的念头",
       "keys": [
        "不想再这样撑下去"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "强撑着提醒自己不能倒下，可心里其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "心里隐约不平静，带着无所依凭的脆弱感，却还说不清这份失落究竟从哪里来",
       "keys": [
        "说不清这份失落究竟从哪里来"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉中醒来，四周又冷又空，胸口发紧、伸手只摸到空处",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "旧日那种熟悉的归属感忽然清晰了一瞬，他同时觉得它与眼下隔着距离",
       "keys": [
        "与眼下隔着距离"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "想重新适应生活的念头刚刚冒出来，却还没有方向",
       "keys": [
        "却还没有方向"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子还没想清楚，身体先隐约记起了怎么迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他仍然记得旧日生活给过自己的那份归属有多珍贵",
       "keys": [
        "那份归属有多珍贵"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "只是如今已经不能像从前那样亲近地拥有",
       "keys": [
        "不能像从前那样亲近地拥有"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他努力让自己保持庄重和稳定，心里却一直发虚，原本想维持的从容总被不安侵蚀",
       "keys": [
        "原本想维持的从容总被不安侵蚀"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像腿脚发虚的人，还在记忆里勉强挪着舞步",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像整理好衣服抬起头，不让人看出自己动摇",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他重新聚起力气，心里的焦灼反而更重，始终没有安定的落点",
       "keys": [
        "始终没有安定的落点"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "呼吸像被催着一样，变得越来越急促",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他反复劝自己已经能够承受，后来连自己也不太相信这句话",
       "keys": [
        "连自己也不太相信这句话"
       ],
       "from": [
        "S02-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "一遍遍对自己说没事，说到后来反倒露出了自己有多在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "哪怕心里还在难受，也不甘心就这样垮下去",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他对眼下这种两边都不踏实的状态生出一股不甘和烦躁",
       "keys": [
        "生出一股不甘和烦躁"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "旧日那种不必时时防备的熟悉感又柔和地靠近",
       "keys": [
        "不必时时防备的熟悉感"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像回到故乡夏日的麦浪与微风里，温和又轻快",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像出去走走换个心情，轻松是真的，心结却还没解开",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他明明不愿否定自己，却第一次把仍然想念旧日归属当成了自己应该回去的证据",
       "keys": [
        "当成了自己应该回去的证据"
       ],
       "from": [
        "S03-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "耳边像有人低声絮语，脚下像踩着流沙抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他开始怀疑自己是不是把这份怀念看成了太可靠的指引",
       "keys": [
        "是不是把这份怀念看成了太可靠的指引"
       ],
       "from": [
        "S03-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "我刚才是真信那些话，还是在勉强自己去信？",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "旧日归属重新变得温暖而亲近，那份感激和依恋并没有因为他已经作出选择就变得不真实",
       "keys": [
        "温暖而亲近"
       ],
       "from": [
        "S04-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "表面还撑着从前坚定的样子，心却比以前更容易受伤了",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可一想到自己竟拿这份怀念替回去找理由，他心里骤然绷紧",
       "keys": [
        "他心里骤然绷紧"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "过去太好又回不去才最刺痛，像在拉扯中疲惫地步步后退",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "像急促的脚步和乱了拍的心跳，被催着往前跑停不下来",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "问题在心里转来转去，却始终找不到能让自己安心的解释",
       "keys": [
        "找不到能让自己安心的解释"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "脑子里还在问怎么会变成这样，不停往前赶只是不敢停下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "想念只能说明那份归属对自己很重要，不能单凭这份感受就证明现在应该回去",
       "keys": [
        "不能单凭这份感受就证明现在应该回去"
       ],
       "from": [
        "S04-4"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他对旧日的眷恋变得很私密、很柔软，只肯在心里承认自己舍不得",
