        "走得对不对",
        "没走的话"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "温暖没能持续",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "忽然风暴般激烈",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "整段绷得很紧",
