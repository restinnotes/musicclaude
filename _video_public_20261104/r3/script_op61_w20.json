       "from": [
        "S13-B4-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "我不再总和从前较劲，终于有了把往后的日子过好的劲头。",
       "keys": [],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "想起故土",
       "keys": [],
       "from": [
        "S13-B1-p4"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "我知道往后仍可能孤单，若有人把我当自己人就珍惜，没有也好好过，不再委屈自己。",
       "keys": [],
       "from": [
        "S13-3"
       ]
      }
     ],
