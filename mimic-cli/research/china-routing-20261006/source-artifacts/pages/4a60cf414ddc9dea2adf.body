                box-shadow: 0px 0px 4px 1px rgba(0, 208, 228, 0.3), 0 0 0 2px #00d0e4 !important;
                border: 1px solid #00d0e4 !important;
           }
          .modal_for_zoom_img .buy_now.buy_now_2 {
            padding: 14px 20px;
          }
        
        .modal_for_zoom .modal-dialog {
            width: 100%;
            max-width: 800px;
        }
        .zom_modal_head {
            color: #340f49;
