{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"先向高处迸发，细碎的光点再缓缓飘落\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"先升后缓落\"\n        },\n        {\n          \"quote\": \"还没有真正落稳，仿佛仍悬在水面上方\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还没落稳\"\n        },\n        {\n          \"quote\": \"正因为太清楚，又明白有些话一旦说出口，关系就会改变，所以格外谨慎\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"关系会变\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他忽然发现自己那么想靠近\",\n          \"point\": \"那么想靠近这个人\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"连自己也有点意外\"\n        },\n        {\n          \"text\": \"他怕对方一看出自己有多需要\",\n          \"point\": \"只敢露出一点点喜欢\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"就会觉得负担太重\"\n        },\n        {\n          \"text\": \"只是这么一点亲近就让他觉得甜\",\n          \"point\": \"下次自己能不能更坦白些\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"只是这么一点亲近就让他觉得甜\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"对方偶尔望来一眼，沉默也不让人紧张\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"水面潮湿、温热的微风，裹在皮肤上有些黏稠\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"潮湿黏稠\"\n        },\n        {\n          \"quote\": \"没有继续冲向高潮，而像轻轻呼出一口气，重新回到柔和\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\