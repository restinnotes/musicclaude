{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然很想靠近自己也意外\",\n          \"accent\": \"很想靠近\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"怕对方觉得有负担\",\n          \"accent\": \"\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"只露一点喜欢却已觉得甜\",\n          \"accent\": \"觉得甜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S01-2\", \"S01-3\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"下次能否坦白他没把握\",\n          \"accent\": \"没把握\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-3\"],\n          \"at\": 10\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"话到嘴边先沉默，怕关系从此改变\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1-3\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"踏上船板身体一轻，水波还未稳\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1-3\",\n          \"at\": 11\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"开头两下和弦像烟花升起又悬住\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1-3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没退开仍愿意亲近\",\n          \"accent\": \"仍愿意亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他才渐渐放松下来\",\n          \"accent\": \"放松下来\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"喜欢快藏不住他想再靠近\",\n          \"accent\": \"藏不住\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"怕太急弄坏自在他收住了\",\n          \"accent\": \"他收住了\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"还没分开他已开始舍不得\",\n          \"accent\": \"开始舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 25\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"肩膀挨着肩膀，连呼吸都贴近\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6-16\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"熟识的人安静坐着，沉默也不紧张\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6-16\",\n          \"at\": 29\n        },\n        {\n          \"text\": \"夏末潮湿温热的风裹在皮肤上\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6-16\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"脚下不必踩实，船底温柔地托着身体\",\n          \"after\": 1,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4-16\",\n          \"at\": 34\n        },\n        {\n          \"text\": \"漂着不急靠岸，水和时间却一直走\",\n          \"after\": 4,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4-16\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"柔软落音像温柔的刺，甜里带点鼻酸\",\n          \"after\": 4,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7-11\",\n          \"at\": 39\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"两条旋律紧挨着，像贴耳低语\",\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6-16\"\n        },\n        {\n          \"text\": \"一下一下的低音像心跳和水浪\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4-5\"\n        },\n        {\n          \"text\": \"歌声忽然上涌，随后像轻轻呼气\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12-16\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不去想以后怎样\",\n          \"accent\": \"不去想以后\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"只想舒服地待在亲近里\",\n          \"accent\": \"舒服地待着\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"他想说多喜欢也问对方是否一样\",\n          \"accent\": \"多喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S03-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"没想好怎么开口念头就淡了\",\n          \"accent\": \"念头就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"摇晃漂浮着，暂时不去哪里\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17-23\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"沉默很舒服，身体还在心却漂远\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17-23\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"思绪像碎倒影拼不齐，也像谈话触到心结\",\n          \"after\": 3,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17-23\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"短促急切的声音忽然冒出来\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20-21\"\n        },\n        {\n          \"text\": \"摇荡仍在，流动却像被暗流拖住\",\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20-22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又让他欢喜\",\n          \"accent\": \"又让他欢喜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想起上回有话没说\",\n          \"accent\": \"有话没说\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"他几乎想把心里话全说出\",\n          \"accent\": \"全说出\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"盼对方喜欢他坦白的样子\",\n          \"accent\": \"坦白的样子\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-2\"],\n          \"at\": 16\n        },\n        {\n          \"text\": \"怕说太多让对方为难他收住\",\n          \"accent\": \"他收住\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 39\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"贴耳低语，呼吸挨近又忍不住补细节\",\n          \"after\": 2,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24-34\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"盼说出口，能把眼下的好留久些\",\n          \"after\": 2,\n          \"from\": [\"S04-3\"],\n          \"bars\": \"\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"夕阳金光刺眼，话到喉咙口发颤\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30-34\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"手越握越紧，像抱住当下船舱更颠\",\n          \"after\": 4,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24-34\",\n          \"at\": 33\n        },\n        {\n          \"text\": \"还没失去就已鼻酸，想多留一会儿\",\n          \"after\": 3,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24-34\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"也怕弄丢两人原有的自在\",\n          \"after\": 4,\n          \"from\": [\"S04-3\"],\n          \"bars\": \"\",\n          \"at\": 38\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉歌声回来，细碎声音像水面光斑\",\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24-34\"\n        },\n        {\n          \"text\": \"高处的长颤声亮得刺眼，随后收弱\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30-34\"\n        },\n        {\n          \"text\": \"摇荡到句尾渐渐放慢\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"32-34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他没藏住喜欢\",\n          \"accent\": \"没藏住喜欢\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他空落落不知怎么相处\",\n          \"accent\": \"空落落\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"怕被嫌太黏熟悉亲近隔了一层\",\n          \"accent\": \"隔了一层\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-3\"],\n          \"at\": 8\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"小船漂进雾里，脚下忽然没支撑\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35-39\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"这份幸福是真的吗？能维持多久？\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35-39\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"想攥紧的手松开，深吸一口气\",\n          \"after\": 2,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"35-39\",\n          \"at\": 13\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇荡忽然抽掉，只剩单薄旋律\",\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35-39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他在乎却没变\",\n          \"accent\": \"却没变\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他才又能自在地待着\",\n          \"accent\": \"自在地待着\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"安静时他仍想靠近却怕要太多\",\n          \"accent\": \"怕要太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他怕被嫌弃对方却不知情\",\n          \"accent\": \"怕被嫌弃\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他猜对方会不会也舍不得\",\n          \"accent\": \"也舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"清凉如月光，让人想起童年或初次心动\",\n          \"after\": 1,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40-50\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"心里说算了，却还是放不下\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40-50\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"夜里独处发酸，亲近的人难陪到每个角落\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40-50\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"好时光还在眼前，恍惚已像回忆\",\n          \"after\": 3,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40-50\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"回想时，气味和身体感觉带着遗憾涌来\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40-50\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"舒服得让人失去方向\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40-50\",\n          \"at\": 29\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉摇摆变轻，水面只剩细细波纹\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40-50\"\n        },\n        {\n          \"text\": \"新歌清澈舒展，像一支朴素牧歌\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40-50\"\n        },\n        {\n          \"text\": \"低声旋律旁另一道声音时近时远\",\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40-50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他觉得对方或许有时也需要他陪\",\n          \"accent\": \"有时也需要他\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"和他在一起也许能安心\",\n          \"accent\": \"能安心\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"想到也许能互相依靠他很高兴\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-2\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"心里一紧却还想这样待着\",\n          \"accent\": \"还想这样待着\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-2\"],\n          \"at\": 15\n        },\n        {\n          \"text\": \"盼对方以后还会想到他\",\n          \"accent\": \"还会想到他\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-3\"],\n          \"at\": 21\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"他也想一直陪在对方身边\",\n          \"after\": 4,\n          \"from\": [\"S07-3\"],\n          \"bars\": \"\",\n          \"at\": 23\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏渐密，低音像脉搏催着往前\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51-61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"上回他无意露出心意\",\n          \"accent\": \"露出心意\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"这回对方依然愿意亲近\",\n          \"accent\": \"依然愿意亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"他想主动些大方回应\",\n          \"accent\": \"大方回应\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S08-1\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"他开始盼两人能好很久\",\n          \"accent\": \"好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"],\n          \"at\": 16\n        },\n        {\n          \"text\": \"可他没把握以后还能这样\",\n          \"accent\": \"没把握\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-3\"],\n          \"at\": 22\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"身体重新有了弹性，带点调情的玩心\",\n          \"after\": 2,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62-70\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"快乐余温还在，心里已泛起怀念\",\n          \"after\": 4,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69-71\",\n          \"at\": 28\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌句越唱越开，熟悉摇荡轻轻催促\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62-70\"\n        },\n        {\n          \"text\": \"歌声向上散开，随后忽然停住\",\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69-71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他怕对方不再需要他陪\",\n          \"accent\": \"不再需要他陪\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"怕对方和他待着也不自在\",\n          \"accent\": \"不自在\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他一下安静下来不敢再想\",\n          \"accent\": \"不敢再想\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"眼下两人仍然亲近是真的\",\n          \"accent\": \"仍然亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S09-3\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他猜对方也许喜欢他在身边\",\n          \"accent\": \"也许喜欢\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"光还在，只是隔着一层薄雾\",\n          \"after\": 2,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72-77\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"余响里问：刚才是真的吗？接下来呢？\",\n          \"after\": 2,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72-77\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"抬头看夜空，眼前的好让不安暂时退开\",\n          \"after\": 3,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72-77\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"想到这点，他有一点高兴\",\n          \"after\": 4,\n          \"from\": [\"S09-3\"],\n          \"bars\": \"\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇荡忽然收住，颤声和轻和弦悬空\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72-77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他不再猜以后会怎样\",\n          \"accent\": \"不再猜\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"先好好享受眼前的亲近\",\n          \"accent\": \"眼前的亲近\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-1\"],\n          \"at\": 5\n        },\n        {\n          \"text\": \"紧绷慢慢松开他想笑也想哭\",\n          \"accent\": \"想笑也想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 10\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"长长呼气胸口打开，心事仍没解决\",\n          \"after\": 2,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78-83\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"时间松开片刻，像一小块避风空地\",\n          \"after\": 1,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78-83\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"身体像失去重量，飘在夏夜微风里\",\n          \"after\": 2,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78-83\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"细亮的高音像银丝细雨\",\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"78-83\"\n        },\n        {\n          \"text\": \"一串音符像飞瀑清亮落进水里\",\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"80-83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他需要对方而对方有时也需要他\",\n          \"accent\": \"有时也需要他\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"就算对方不需要他他也愿陪\",\n          \"accent\": \"他也愿陪\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他不再藏着喜欢\",\n          \"accent\": \"不再藏着\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\", \"S11-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"对方以后让不让他陪由不得他\",\n          \"accent\": \"由不得他\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-3\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"想到亲近未必长久他心口发疼\",\n          \"accent\": \"心口发疼\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"这是我的感情，我不再为它道歉\",\n          \"after\": 2,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84-92\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"他高兴得顾不上害臊，觉得在乎没错\",\n          \"after\": 2,\n          \"from\": [\"S11-2\"],\n          \"bars\": \"\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"他盼着对方有时也需要他，像有回应\",\n          \"after\": 0,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"夕阳烧得血红金亮，胸口压得发痛\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84-92\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"家具可能没变，知道它珍贵后温柔更沉\",\n          \"after\": 4,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84-92\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"厚重的声音托起歌声，低音翻成惊涛\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84-92\"\n        },\n        {\n          \"text\": \"铺开的力量在高处短暂悬起\",\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他顾不上对方是否也在乎\",\n          \"accent\": \"顾不上\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"只想把能给的都给对方\",\n          \"accent\": \"都给对方\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他明知再用心也保不住以后\",\n          \"accent\": \"保不住以后\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"还是嫌时间不够想多陪一会儿\",\n          \"accent\": \"多陪一会儿\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他终于不再收着尽情喜欢\",\n          \"accent\": \"尽情喜欢\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S12-3\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像被卷进更大的世界，自己退到后面\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93-102\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"狂喜像高烧，像久别重逢抱紧不放\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93-102\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"喉咙发紧眼眶湿，分不清想笑还是哭\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93-102\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"那股渴望悬在半空，迟迟才松开\",\n          \"after\": 3,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"93-102\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"明亮歌声层层推高，里面的声音互相拉扯\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93-102\"\n        },\n        {\n          \"text\": \"歌声带着恳求一次次向上伸展\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"93-102\"\n        },\n        {\n          \"text\": \"乐句末端迟迟不落，直到交界处才释放\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"96-103\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"他更想听对方说以后不变\",\n          \"accent\": \"以后不变\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"听到不变他仍问能否一直这样\",\n          \"accent\": \"能否一直这样\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他怕对方哪天不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"少露些喜欢会不会少疼些\",\n          \"accent\": \"少疼些\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他已装不回不在乎\",\n          \"accent\": \"装不回\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"怕一停下，刚得到的东西就会消失\",\n          \"after\": 1,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103-110\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"幸福里有了悲伤，握住才知留不住\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103-110\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"刚说了是，心里又问可是呢\",\n          \"after\": 1,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103-110\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"他明明相信这份幸福，心里还是发疼\",\n          \"after\": 1,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103-110\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"脚下站得很稳，胸口却一沉再沉\",\n          \"after\": 4,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103-110\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"想对他好是真心的，藏回去更难受\",\n          \"after\": 4,\n          \"from\": [\"S13-3\"],\n          \"bars\": \"\",\n          \"at\": 28\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"旋律反复渐强，后半段越绷越紧\",\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103-110\"\n        },\n        {\n          \"text\": \"明亮声音渐渐掺进尖锐暗沉的声响\",\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"107-110\"\n        },\n        {\n          \"text\": \"低处脚步稳住，上方声音一次次下坠\",\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103-110\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"最初他连喜欢都不敢多露\",\n          \"accent\": \"不敢多露\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"如今两人仍亲近他又甜又酸\",\n          \"accent\": \"又甜又酸\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S14-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他不后悔也仍会舍不得\",\n          \"accent\": \"不后悔\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-1\", \"S14-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他不再逼自己讨保证也不藏喜欢\",\n          \"accent\": \"不藏喜欢\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-2\", \"S14-3\"],\n          \"at\": 13\n        },\n        {\n          \"text\": \"以后怎样等到了再说\",\n          \"accent\": \"等到了再说\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-2\", \"S14-3\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": 