   "relation": "正在面对",
   "items": [
    {
     "id": "I44",
     "text": "既无法减轻喜欢，也无法决定对方的心意，他终于不再逼自己立刻作选择。",
     "key": "不再逼自己立刻选择",
     "kind": "",
     "key_model": "不再逼自己"
    },
    {
     "id": "I45",
     "text": "想靠近时他可以暂不向前，想克制时也无需把心里的眷恋都压下去。",
     "key": "靠近克制都不必勉强",
     "kind": "分清",
     "key_model": "暂不向前"
    },
    {
     "id": "I46",
     "text": "他容许愿望和没把握同时留在心里，不再让两种心思互相催逼。",
     "key": "容许愿望与没把握共存",
     "kind": "",
     "key_model": "没把握"
    },
