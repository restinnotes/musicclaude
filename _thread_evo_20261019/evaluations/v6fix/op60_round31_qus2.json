   {
    "sec": "S07",
    "bars": "51–61",
    "relation": "还说不清",
    "items": [
     {
      "id": "S07-1",
      "text": "他忽然发现，自己不只是被对方接纳的人，也能成为对方愿意依靠的人。",
      "key": "他忽然发现，自己",
      "follows": false,
