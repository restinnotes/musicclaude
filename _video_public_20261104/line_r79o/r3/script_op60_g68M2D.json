 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他忽然发现自己那么想靠近这个人",
       "keys": [
        "那么想靠近这个人"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像夏夜烟花缓缓飘落，又像刚踏上船板晃了一下",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他怕对方一看出自己有多需要这份亲近，就会觉得负担太重，所以只敢露出一点点喜欢",
       "keys": [
        "只敢露出一点点喜欢"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话到嘴边又咽了回去，连呼吸都放得很轻",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "像舌尖刚尝到一点甜，手指却还试探着不敢往前伸",
       "keys": [],
       "from": [
        "S01-3"
       ],
       "bead": "S01-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "对方没有因为他露出在意就退开，仍愿意跟他亲近，他才渐渐放松下来",
       "keys": [
        "渐渐放松下来"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像紧挨着耳语时温热的气息，又像夏末微黏的暖风",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "像熟人安静坐着不用找话，偶尔对视也只是笑笑",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "脚下不用踩实地面，身体像被船底温柔地托着晃",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他也想顺势靠得更近，有一阵子喜欢得几乎藏不住",
       "keys": [
        "喜欢得几乎藏不住"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "最后还是怕太急弄坏眼下的自在而收住了",
       "keys": [
        "怕太急弄坏眼下的自在"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "两个人待在一起这么好，他偏偏想到这样的时刻总会过去，还没分开就先有一点舍不得",
       "keys": [
        "先有一点舍不得"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像躺在船上舒服地漂着，船底的水声却一直往前流",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      },
      {
       "text": "像指尖碰到了软刺，暖洋洋的空气里忽然有点鼻酸",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他难得不去琢磨两个人往后会怎样，只想舒舒服服地待在这份亲近里",
       "keys": [
        "待在这份亲近里"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话音落下后还看着半空，嘴角微弯着走神",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "又像交谈后屋里静下来，目光顺着尾音慢慢飘向窗外",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想说有多喜欢这样，也想问对方是否一样",
       "keys": [
        "想说有多喜欢这样"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "没想好怎么开口，念头就淡了",
       "keys": [
        "念头就淡了"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像水底冒起一串气泡，刚浮到水面就轻轻破了",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "像步子在原地顿了一下，水里的倒影被风吹散了",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他几乎想把藏着的话全说出来，盼着对方也喜欢他不再小心收着的样子",
       "keys": [
        "全说出来"
       ],
       "from": [
        "S04-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像聊到兴头上语速越来越快，连手势都跟着多了起来",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      },
      {
       "text": "像热气直冲鼻尖，喉咙发紧，声音微微发抖",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他甚至盼着说出来能把眼下的好留得久一点",
       "keys": [
        "留得久一点"
       ],
       "from": [
        "S04-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像原本轻轻搭着的手指猛地收紧，指节都有点发白",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "像手心捧着易碎的薄冰，想握紧，又赶紧放轻了力道",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "这回他不知不觉就忘了藏好喜欢，等察觉时，对方已经看出他有多在乎",
       "keys": [
        "忘了藏好喜欢"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "他心里空落落的",
       "keys": [
        "空落落的"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像突然没了遮挡，站在原地连手脚都不知道往哪放",
       "keys": [],
       "from": [
        "S05-2"
       ],
       "bead": "S05-2"
      },
      {
       "text": "像脚下一滑漂进白雾里，刚才攥紧的手指也松开了",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "像石子丢进看不见底的深井，屏住气，却听不到回音",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "像眼前忽然蒙上一层水雾，连声音都变得遥远",
       "keys": [],
       "from": [
        "S05-3"
       ],
       "bead": "S05-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "这回对方看出他有多在乎，跟他相处却一点没变，他才又能像从前那样自在地待着",
       "keys": [
        "自在地待着"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像小船从刺眼的阳光下滑进桥洞，迎面扑来一阵清凉",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "像刚平息的水面又泛起涟漪，肩膀却慢慢软了下来",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "像整个人浸在温热的泉水里，暖气漫过鼻尖，晕乎乎的",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "对方不知道他刚才多怕被嫌弃，他有点孤单",
       "keys": [
        "他有点孤单"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像咽下一口温热的苦茶，胃里暖着，鼻尖却发酸",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他渐渐觉得，也许对方有时也需要他陪着，跟他在一起也能安心些",
       "keys": [
        "有时也需要他陪着"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他高兴得有点收不住，想到两个人也许能互相依靠",
       "keys": [
        "高兴得有点收不住"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "胸口忽然一紧，像被暖风裹住，迈不开步子",
       "keys": [],
       "from": [
        "S07-2"
       ],
       "bead": "S07-2"
      },
      {
       "text": "像身体里涌起一股热潮，推着人不由自主地往前倾",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "像滚烫的气息拂过耳畔，人被卷进温热的漩涡，越陷越深",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他真盼着，往后对方想找人陪时还会想到自己，自己也能一直陪在身边",
       "keys": [
        "一直陪在身边"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像伸手去掬溪水，水声那么好听，却一直在指缝间流走",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他想主动些，大大方方地回应",
       "keys": [
        "大大方方地回应"
       ],
       "from": [
        "S08-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像推开窗迎着阳光和风，伸了个懒腰，脚步都轻快起来",
       "keys": [],
       "from": [
        "S08-B1"
       ],
       "bead": "S08-B1"
      },
      {
       "text": "像藏着笑眨眨眼，拿指尖轻轻碰了一下",
       "keys": [],
       "from": [
        "S08-B2"
       ],
       "bead": "S08-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "可眼下两个人都愿意亲近，以后未必还会这样，他心里没底",
       "keys": [
        "心里没底"
       ],
       "from": [
        "S08-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "掌心还留着余温，目光却像在看远去的背影",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S09",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "那点没底越来越具体：要是哪天对方不再需要他陪，连和他待着都不自在了呢？",
       "keys": [
        "不再需要他陪"
       ],
       "from": [
        "S09-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他一下安静了，刚才还敢盼那么远，现在却不敢再往下想",
       "keys": [
        "不敢再往下想"
       ],
       "from": [
        "S09-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像话到要紧处猛地顿住，呼吸都停了，琴弦还绷得紧紧的",
       "keys": [],
       "from": [
        "S09-B1"
       ],
       "bead": "S09-B1"
      },
      {
       "text": "像忽然走进低气压里，四周的光还在，却隔了一层薄雾",
       "keys": [],
       "from": [
        "S09-B2"
       ],
       "bead": "S09-B2"
      },
      {
       "text": "像听着半空里悬着的尾音，眼神闪烁，脚尖迟疑着不敢落",
       "keys": [],
       "from": [
        "S09-B3"
       ],
       "bead": "S09-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "他想起对方一直没退开，两人眼下还亲近，这些都是真的",
       "keys": [
        "这些都是真的"
       ],
       "from": [
        "S09-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "像狂奔后停下抬头看夜空，心跳还快，晚风却吹干了汗",
       "keys": [],
       "from": [
        "S09-B4"
       ],
       "bead": "S09-B4"
      },
      {
       "text": "像乌云缝里漏下一束光，嘴角不自觉地弯了起来",
       "keys": [],
       "from": [
        "S09-3"
       ],
       "bead": "S09-3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S10",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他想着，再猜下去连今天也过不踏实",
       "keys": [
        "连今天也过不踏实"
       ],
       "from": [
        "S10-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "先前那阵紧绷慢慢松下去，他心里亮堂得几乎想笑，也有点想哭",
       "keys": [
        "几乎想笑，也有点想哭"
       ],
       "from": [
        "S10-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像耸着的肩膀一下垮了下来，长长吐出一口气，眼眶发热",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "像天边还积着云，人却已经松开领口，任由暖风吹过来",
       "keys": [],
       "from": [
        "S10-B1"
       ],
       "bead": "S10-B1"
      },
      {
       "text": "像闷热里吹来一阵清风，赶紧深吸一口，哪怕转眼又要散去",
       "keys": [],
       "from": [
        "S10-B2"
       ],
       "bead": "S10-B2"
      },
      {
       "text": "身体轻得像飘在夏夜微风里，地上的喧嚣一下退得好远",
       "keys": [],
       "from": [
        "S10-B3"
       ],
       "bead": "S10-B3"
      }
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "groups": [
