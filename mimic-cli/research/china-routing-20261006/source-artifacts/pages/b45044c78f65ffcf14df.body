<!-- Swiper Image Viewer start-->
    <style>
        #image_viewer {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            padding-top: 120px;
        }

        #image_viewer .swiper-wrapper {
            padding-top: 0;
        }

        #image_viewer .swiper-slide img {
            width: 100%;
            vertical-align: middle;
        }

        #image_viewer .swiper-pagination {
            top: 80px;
            bottom: auto;
            color: #fff;
        }
    </style>

    <div class="swiper-container" id="image_viewer">
        <div class="swiper-wrapper"></div>
        <div class="swiper-pagination"></div>
    </div>

    <script>
        $(document).ready(function () {
            $('.detailpage .article .content img').click(function () {
                $('.detailpage .article .content img').each(function () {
                    console.log("Init_list:" + $(this).attr("src"));
                    viewer.virtual.appendSlide('<div class="viewer-zoom-container"><img src="' +
                        $(this).attr("src") + '" /></div>');
                });
                var clickIndex = $(".detailpage .article .content img").index(this);
                //console.log("Click_Index:"+$(".detailpage .article .content img").index(this));        
                console.log("Click_Index:" + clickIndex);
                viewer.slideTo(clickIndex);
                $('#image_viewer').fadeIn('fast');
                viewerStatus = true;

            });
        });

        var viewer = new Swiper('#image_viewer', {
            zoom: true,
            width: window.innerWidth,
            virtual: true,
            spaceBetween: 20,
            pagination: {
                el: '.swiper-pagination',
                type: 'fraction',
            },
            on: {
                click: function () {
                    $('#image_viewer').fadeOut('fast');
                    this.virtual.slides.length = 0;
                    this.virtual.cache = [];
                    swiperStatus = false;

                },
            },

        });


        //切换图状态禁止页面缩放
        document.addEventListener('touchstart', function (event) {
            if (event.touches.length > 1 && viewerStatus) {
                event.preventDefault();
            }
        })
        var lastTouchEnd = 0;
        document.addEventListener('touchend', function (event) {
            var now = (new Date()).getTime();
            if (now - lastTouchEnd <= 300) {
                event.preventDefault();
            }
            lastTouchEnd = now;
        }, false)

        document.addEventListener('touchmove', function (e) {
                if (viewerStatus) {
                    e.preventDefault();
                }
            })
     </script>

<!-- end Swiper Image Viewer-- >


