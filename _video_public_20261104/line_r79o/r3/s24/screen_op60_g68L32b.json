     "bars": "80-83",
     "from": [
      "S10-B4"
     ]
    }
   ]
  },
  {
   "sec": "S11",
   "rows": [
    {
     "kind": "line",
     "text": "他不再躲着自己的感受，对这份亲近的肯定变得直接而坚定",
