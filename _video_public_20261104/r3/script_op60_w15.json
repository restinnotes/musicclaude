   "groups": [
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起起初连多露一点喜欢都紧张的自己，再想想一路走到现在，我心里柔软又发酸。",
       "keys": [],
       "from": [
        "S14-1"
