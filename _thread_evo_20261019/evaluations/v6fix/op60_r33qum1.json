      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "93–102",
    "relation": "正在面对",
    "items": [
     {
      "id": "S12-1",
      "text": "他不只想自己一直被需要，也真心希望往后的日子里，对方能一直从这份亲近里得到安慰。",
      "key": "他不只想自己一直",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S11-2"
      ]
     },
     {
      "id": "S12-2",
      "text": "一想到两个人眼下真能彼此依靠，他高兴得几乎受不住，甚至有点想哭。",
      "key": "一想到两个人眼下",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S12-1"
      ]
     },
     {
      "id": "S12-3",
      "text": "他想给对方更多，又怕无论做多少，都没法让将来仍像现在这样。",
      "key": "他想给对方更多，",
      "follows": false,
      "explains": [],
      "cite": [
       "S12-1",
       "S11-2"
      ]
     },
     {
      "id": "S12-4",
      "text": "熬过那阵急切，他又实实在在地喜欢起两个人如今这样相待，欢喜连着难过一起满了出来。",
      "key": "熬过那阵急切，他",
      "follows": false,
      "explains": [],
      "cite": [
       "S12-2",
       "S12-3"
      ]
     }
    ],
    "because": [
     {
