       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "呼吸贴在一起",
       "keys": [],
       "from": [
        "S02-B1-p1"
       ],
       "emotion": "亲密"
      },
      {
       "text": "沉默也舒服",
       "keys": [],
       "from": [
        "S02-B1-p3"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "我想再靠近对方一些，终究怕太急破坏自在，还是收住了。",
