    })
    $("#migration_tag").click(() => {
        window.localStorage.setItem('tags_name', 'migration');
    })

    $(".btn").bind('click', function () {
        // 搜索页由 search.hbs 无刷新处理
        if (window.__DSERS_SEARCH_PAGE__) return;
        let value = $("#search-input").val().toLowerCase()
        if (!value || /^[ ]+$/g.test(value)) {
            return
        }
        console.log('cccc-3')
                    eventCollect({
      module: 'help_center',
      name: 'click',
      action: 'help_center_search',
      params: {
        keyword: value,
        ts: Math.floor(Date.now() / 1000)
      },
    });
        window.location.href = `/search/?search_text=${value}`
    })

    $(function () {
        document.onkeydown = function (e) {
            let ev = document.all ? window.event : e;
            if (ev.keyCode == 13) {
                // 搜索页由 search.hbs 无刷新处理
                if (window.__DSERS_SEARCH_PAGE__) return;
