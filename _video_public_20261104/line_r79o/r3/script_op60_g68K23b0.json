       "from": [
        "S08-2",
        "S08-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声向上散开，余温里忽然泛起怀念",
       "keys": [],
       "from": [
        "S08-B3"
       ],
       "bead": "S08-B3"
      }
     ]
    }
   ]
  },
