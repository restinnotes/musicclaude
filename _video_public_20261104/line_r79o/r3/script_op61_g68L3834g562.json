       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "孤单",
     "lines": [
      {
       "text": "回到眼下时，他才分清：记忆里的归属感还能短暂回来，旧日生活却没有因此回来",
