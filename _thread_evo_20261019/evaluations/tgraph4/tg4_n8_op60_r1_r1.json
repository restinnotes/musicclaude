{
 "center": "对亲密的投入与自我克制始终相互牵制。",
 "segments": [
  {
   "bars": "1–3",
   "relation": "还说不清",
   "items": [
    {
     "id": "I1",
     "text": "他还说不清自己究竟在盼什么。",
     "key": "盼什么",
     "kind": ""
    },
    {
     "id": "I2",
     "text": "他心里有了一个格外愿意亲近的人。",
     "key": "愿意亲近",
     "kind": ""
    },
    {
     "id": "I3",
     "text": "想到对方，他便不由自主地心软。",
     "key": "不由自主",
     "kind": ""
    },
    {
     "id": "I4",
     "text": "他想让这份柔软多停留一会儿。",
     "key": "多停留",
     "kind": ""
    },
    {
     "id": "I5",
     "text": "他又本能地把心往回收。",
     "key": "往回收",
     "kind": ""
    },
    {
     "id": "I6",
     "text": "眼下并没有事催他作决定。",
     "key": "作决定",
     "kind": ""
    },
    {
     "id": "I7",
     "text": "他也不知自己为何这样谨慎。",
     "key": "这样谨慎",
     "kind": ""
    },
    {
     "id": "I8",
     "text": "他觉得那点喜欢似乎随时可以放下。",
     "key": "随时可以放下",
     "kind": ""
    },
    {
     "id": "I9",
     "text": "他偏偏舍不得放下。",
     "key": "舍不得放下",
     "kind": ""
    }
   ],
   "because": []
  },
  {
   "bars": "4–16",
   "relation": "正在面对",
   "items": [
    {
     "id": "I10",
     "text": "他不急着为这份在意决定去向。",
     "key": "决定去向",
     "kind": ""
    },
    {
     "id": "I11",
     "text": "他允许自己暂时不知道两人会怎样。",
     "key": "两人会怎样",
     "kind": ""
    },
    {
     "id": "I12",
     "text": "他不因喜欢就向对方期待什么。",
     "key": "期待什么",
     "kind": ""
    },
    {
     "id": "I13",
     "text": "他慢慢可以安心亲近对方。",
     "key": "安心亲近",
     "kind": ""
    },
    {
     "id": "I14",
     "text": "他喜欢自由地给予那份温柔。",
     "key": "自由地给予",
     "kind": ""
    },
    {
     "id": "I15",
     "text": "他不必时时确认心意有没有被领受。",
     "key": "有没有被领受",
     "kind": ""
    },
    {
     "id": "I16",
     "text": "他发现重视对方也能保持从容。",
     "key": "保持从容",
     "kind": ""
    },
    {
     "id": "I17",
     "text": "他有时甚至觉得比先前更自在。",
     "key": "更自在",
     "kind": ""
    },
    {
     "id": "I18",
     "text": "他渐渐不再提防自己的喜欢。",
     "key": "不再提防",
     "kind": ""
    },
    {
     "id": "I19",
     "text": "他有一点满意于自己如此宽和。",
     "key": "如此宽和",
     "kind": ""
    },
    {
     "id": "I20",
     "text": "他希望亲近能一直自然地发生，不必追问计较。",
     "key": "自然地发生",
     "kind": ""
    },
    {
     "id": "I21",
     "text": "他当时觉得这样已经足够。",
     "key": "已经足够",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I7",
     "to": "I10",
     "rel": "提供理由"
    },
    {
     "from": "I9",
     "to": "I13",
     "rel": "唤起"
    }
   ]
  },
  {
   "bars": "17–23",
   "relation": "正在面对",
   "items": [
    {
     "id": "I22",
     "text": "他开始盼望这份喜欢能够长久。",
     "key": "能够长久",
     "kind": ""
    },
    {
     "id": "I23",
     "text": "想到长久，他便想到对方的心意。",
     "key": "对方的心意",
     "kind": ""
    },
    {
     "id": "I24",
     "text": "他能决定自己怎样珍惜对方。",
     "key": "怎样珍惜",
     "kind": ""
    },
    {
     "id": "I25",
     "text": "他无法决定对方是否同样珍惜自己。",
     "key": "同样珍惜",
     "kind": ""
    },
    {
     "id": "I26",
     "text": "对方的回应开始牵动他。",
     "key": "回应开始牵动",
     "kind": ""
    },
    {
     "id": "I27",
     "text": "这愿望起初并不强烈。",
     "key": "并不强烈",
     "kind": ""
    },
    {
     "id": "I28",
     "text": "他并没打算向对方索取什么。",
     "key": "索取什么",
     "kind": ""
    },
    {
     "id": "I29",
     "text": "他偶尔想知道自己在对方心里是否特别。",
     "key": "是否特别",
     "kind": ""
    },
    {
     "id": "I30",
     "text": "仅多了一点期待，他便不再完全安稳。",
     "key": "不再完全安稳",
     "kind": ""
    },
    {
     "id": "I31",
     "text": "他意外发现，已经幸福仍会盼望更多。",
     "key": "盼望更多",
     "kind": "满足照出未满足"
    }
   ],
   "because": [
    {
     "from": "I20",
     "to": "I22",
     "rel": "唤起"
    },
    {
     "from": "I15",
     "to": "I26",
     "rel": "动摇"
    },
    {
     "from": "I21",
     "to": "I30",
     "rel": "动摇"
    }
   ]
  },
  {
   "bars": "24–34",
   "relation": "正在面对",
   "items": [
    {
     "id": "I32",
     "text": "他不愿新添的紧张破坏先前的快乐。",
     "key": "新添的紧张",
     "kind": ""
    },
    {
     "id": "I33",
     "text": "他知道对方并未答应过什么。",
     "key": "并未答应",
     "kind": ""
    },
    {
     "id": "I34",
     "text": "他不想让喜欢变成无形的催促。",
     "key": "无形的催促",
     "kind": ""
    },
    {
     "id": "I35",
     "text": "他试着把心放得更宽。",
     "key": "放得更宽",
     "kind": ""
    },
    {
     "id": "I36",
     "text": "他提醒自己珍惜对方无须事事得到表示。",
     "key": "事事得到表示",
     "kind": ""
    },
    {
     "id": "I37",
     "text": "他从关心、给予和为对方高兴中获得快乐。",
     "key": "为对方高兴",
     "kind": ""
    },
    {
     "id": "I38",
     "text": "他真的轻松起来，想求确认的紧张渐渐消退。",
     "key": "紧张渐渐消退",
     "kind": ""
    },
    {
     "id": "I39",
     "text": "他发现自己反而更愿意付出。",
     "key": "更愿意付出",
     "kind": ""
    },
    {
     "id": "I40",
     "text": "他不再衡量心意付出了多少。",
     "key": "付出了多少",
     "kind": ""
    },
    {
     "id": "I41",
     "text": "他不再怕多给会显得自己更在乎。",
     "key": "显得自己更在乎",
     "kind": ""
    },
    {
     "id": "I42",
     "text": "他为毫不勉强的热切感到幸福。",
     "key": "毫不勉强",
     "kind": ""
    },
    {
     "id": "I43",
     "text": "他仿佛终于能尽情给出小心保存的温柔。",
     "key": "小心保存的温柔",
     "kind": ""
    },
    {
     "id": "I44",
     "text": "那一阵，他甚至相信不提要求就能尽情去爱，也不会伤人。",
     "key": "不会伤人",
     "kind": ""
    },
    {
     "id": "I45",
     "text": "他那时还相信自己不会失去什么。",
     "key": "不会失去什么",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I30",
     "to": "I32",
     "rel": "提供理由"
    },
    {
     "from": "I28",
     "to": "I34",
     "rel": "仍在起作用"
    },
    {
     "from": "I14",
     "to": "I37",
     "rel": "仍在起作用"
    },
    {
     "from": "I29",
     "to": "I38",
     "rel": "改写"
    }
   ]
  },
  {
   "bars": "35–39",
   "relation": "还说不清",
   "items": [
    {
     "id": "I46",
     "text": "欢喜稍稍平息，他仍想知道自己是否同样被珍惜。",
     "key": "同样被珍惜",
     "kind": "办法的限度"
    },
    {
     "id": "I47",
     "text": "他为又盼望被看见感到难堪。",
     "key": "盼望被看见",
     "kind": ""
    },
    {
     "id": "I48",
     "text": "他怀疑此前的体贴藏着不肯承认的期待。",
     "key": "不肯承认的期待",
     "kind": ""
    },
    {
     "id": "I49",
     "text": "他没法轻易回答这个怀疑。",
     "key": "没法轻易回答",
     "kind": ""
    },
    {
     "id": "I50",
     "text": "他觉得说自己毫无所求似乎已不够诚实。",
     "key": "不够诚实",
     "kind": ""
    },
    {
     "id": "I51",
     "text": "他又知道此前的快乐并非为了换回应。",
     "key": "并非为了换回应",
     "kind": ""
    },
    {
     "id": "I52",
     "text": "他暂时留在这份不自在里。",
     "key": "不自在",
     "kind": ""
    },
    {
     "id": "I53",
     "text": "他不急着替自己辩解。",
     "key": "替自己辩解",
     "kind": ""
    },
    {
     "id": "I54",
     "text": "他也不再找热烈的感觉来遮盖它。",
     "key": "遮盖它",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I45",
     "to": "I46",
     "rel": "动摇"
    },
    {
     "from": "I29",
     "to": "I46",
     "rel": "仍在起作用"
    },
    {
     "from": "I39",
     "to": "I48",
     "rel": "唤起"
    },
    {
     "from": "I37",
     "to": "I51",
     "rel": "提供理由"
    }
   ]
  },
  {
   "bars": "40–50",
   "relation": "没在想",
   "items": [
    {
     "id": "I55",
     "text": "难堪没有减轻他的喜欢。",
     "key": "没有减轻",
     "kind": ""
    },
    {
     "id": "I56",
     "text": "他不愿继续用慷慨证明自己。",
     "key": "用慷慨证明",
     "kind": ""
    },
    {
     "id": "I57",
     "text": "他不想时时检查对方是否在意。",
     "key": "时时检查",
     "kind": ""
    },
    {
     "id": "I58",
     "text": "他也不想强迫自己毫无期待。",
     "key": "毫无期待",
     "kind": ""
    },
    {
     "id": "I59",
     "text": "他不再忙着猜两个人以后如何。",
     "key": "以后如何",
     "kind": ""
    },
    {
     "id": "I60",
     "text": "他只留心此刻愿意给予的关切。",
     "key": "此刻愿意给予",
     "kind": ""
    },
    {
     "id": "I61",
     "text": "他可以安静地惦念对方。",
     "key": "安静地惦念",
     "kind": ""
    },
    {
     "id": "I62",
     "text": "他因希望对方过得好而高兴。",
     "key": "希望对方过得好",
     "kind": ""
    },
    {
     "id": "I63",
     "text": "他不再用每份心意衡量两人的关系。",
     "key": "衡量两人的关系",
     "kind": ""
    },
    {
     "id": "I64",
     "text": "他发现有些快乐留在心里就很鲜明。",
     "key": "留在心里",
     "kind": ""
    },
    {
     "id": "I65",
     "text": "他甚至暂时忘了为何那么在意回应。",
     "key": "暂时忘了",
     "kind": ""
    },
    {
     "id": "I66",
     "text": "他只觉得细细地喜欢对方很甜。",
     "key": "喜欢对方很甜",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I47",
     "to": "I56",
     "rel": "提供理由"
    },
    {
     "from": "I46",
     "to": "I57",
     "rel": "改写"
    },
    {
     "from": "I50",
     "to": "I58",
     "rel": "提供理由"
    },
    {
     "from": "I51",
     "to": "I60",
     "rel": "提供理由"
    }
   ]
  },
  {
   "bars": "51–61",
   "relation": "正在面对",
   "items": [
    {
     "id": "I67",
     "text": "他发觉不声张的甜意已有重量。",
     "key": "已有重量",
     "kind": ""
    },
    {
     "id": "I68",
     "text": "他渐渐难以把喜欢收放自如。",
     "key": "收放自如",
     "kind": "办法的限度"
    },
    {
     "id": "I69",
     "text": "他更深地惦念对方。",
     "key": "更深地惦念",
     "kind": ""
    },
    {
     "id": "I70",
     "text": "他更希望自己的关切能被领会。",
     "key": "关切能被领会",
     "kind": ""
    },
    {
     "id": "I71",
     "text": "有时毫无特别缘由，他心里也满是对方。",
     "key": "毫无特别缘由",
     "kind": ""
    },
    {
     "id": "I72",
     "text": "他仍认为不催促对方是对的。",
     "key": "不催促对方",
     "kind": ""
    },
    {
     "id": "I73",
     "text": "他舍不得用期待换取对方迁就。",
     "key": "对方迁就",
     "kind": ""
    },
    {
     "id": "I74",
     "text": "他只得独自容纳没有着落的盼望。",
     "key": "没有着落的盼望",
     "kind": ""
    },
    {
     "id": "I75",
     "text": "他仍觉得这样喜欢值得。",
     "key": "喜欢值得",
     "kind": ""
    },
    {
     "id": "I76",
     "text": "他舍不得减轻给过自己甜蜜的感情。",
     "key": "舍不得减轻",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I64",
     "to": "I67",
     "rel": "改写"
    },
    {
     "from": "I60",
     "to": "I68",
     "rel": "限制"
    },
    {
     "from": "I61",
     "to": "I69",
     "rel": "仍在起作用"
    },
    {
     "from": "I29",
     "to": "I70",
     "rel": "仍在起作用"
    },
    {
     "from": "I34",
     "to": "I73",
     "rel": "仍在起作用"
    },
    {
     "from": "I66",
     "to": "I76",
     "rel": "提供理由"
    }
   ]
  },
  {
   "bars": "62–71",
   "relation": "正在面对",
   "items": [
    {
     "id": "I77",
     "text": "他忽然不愿再时时约束这份深情。",
     "key": "时时约束",
     "kind": ""
    },
    {
     "id": "I78",
     "text": "他明白那些快乐并不靠对方的承诺。",
     "key": "不靠对方的承诺",
     "kind": ""
    },
    {
     "id": "I79",
     "text": "他觉得心里仍有期待，也不必怀疑幸福的真切。",
     "key": "幸福的真切",
     "kind": "分清"
    },
    {
     "id": "I80",
     "text": "他不愿再因为怕受伤，连高兴都克制。",
     "key": "连高兴都克制",
     "kind": ""
    },
    {
     "id": "I81",
     "text": "他想让自己充分地喜欢一次。",
     "key": "充分地喜欢一次",
     "kind": ""
    },
    {
     "id": "I82",
     "text": "他暂时不急着追问结果。",
     "key": "追问结果",
     "kind": ""
    },
    {
     "id": "I83",
     "text": "他也不急着替以后安排退路。",
     "key": "安排退路",
     "kind": ""
    },
    {
     "id": "I84",
     "text": "他开始坦然享受积攒许久的眷恋。",
     "key": "坦然享受",
     "kind": ""
    },
    {
     "id": "I85",
     "text": "他不再计较心意给出了多少。",
     "key": "给出了多少",
     "kind": ""
    },
    {
     "id": "I86",
     "text": "他不再提醒自己心意深了就该收回。",
     "key": "就该收回",
     "kind": ""
    },
    {
     "id": "I87",
     "text": "他只为自己能这样爱对方而高兴。",
     "key": "爱对方而高兴",
     "kind": ""
    },
    {
     "id": "I88",
     "text": "有一阵，他的欢喜压过了全部顾虑。",
     "key": "压过了全部顾虑",
     "kind": ""
    },
    {
     "id": "I89",
     "text": "他知道还没有保证，却几乎感觉不到它的沉重。",
     "key": "几乎感觉不到",
     "kind": ""
    }
   ],
   "because": [
    {
     "from": "I68",
     "to": "I77",
     "rel": "唤起"
    },
    {
     "from": "I42",
     "to": "I78",
     "rel": "提供理由"
    },
    {
     "from": "I64",
     "to": "I79",
     "rel": "提供理由"
    },
    {
     "from": "I76",
     "to": "I81",
     "rel": "唤起"
    }
   ]
  },
  {
   "bars": "72–77",
   "relation": "正在面对",
   "items": [
    {
     "id": "I90",
     "text": "欢喜稍稍落定，他已无法含糊自己的愿望。",
     "key": "无法含糊",
     "kind": ""
    },
    {
     "id": "I91",
     "text": "他想让自己的深情有所相遇。",
     "key": "有所相遇",
     "kind": ""
    },
    {
     "id": "I92",
     "text": "他想知道对方是否同样渴望靠近。",
     "key": "同样渴望靠近",
     "kind": ""
    },
    {
     "id": "I93",
     "text": "他想知道对方是否也把他看得特别重要。",
     "key": "特别重要",
     "kind": ""
    },
    {
     "id": "I94",
     "text": "他不肯把自己的真心当作对方应回应的理由。",
     "key": "应回应的理由",
     "kind": "分清"
    },
    {
     "id": "I95",
     "text": "他觉得退回谨慎仿佛辜负刚承认的心意。",
     "key": "仿佛辜负",
     "kind": ""
    },
    {
     "id": "I96",
     "text": "他怕有一天分不清爱对方与要求对方满足自己。",
     "key": "要求对方满足自己",
     "kind": "选择的代价"
    },
    {
     "id": "I97",
     "text": "他想不出能同时保全两边的办法。",
     "key": "同时保全",
     "kind": ""
    },
    {
     "id": "I98",
     "text": "他因此感到委屈。",
     "key": "感到委屈",
     "kind": ""
    },
    {
     "id": "I99",
     "text": "他甚至厌倦反复为难自己。",
     "key": "厌倦反复",
     "kind": ""
    }
   ],
   "because": [
    {
