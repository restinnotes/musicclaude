       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "可想起以前跟大家一块儿时被人当成自己人，居然又高兴了一小会儿",
