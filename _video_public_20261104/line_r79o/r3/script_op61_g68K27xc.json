 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "安心",
     "lines": [
      {
       "text": "他离开了熟悉的生活，起初觉得总算不用再受委屈了",
       "keys": [
        "不用再受委屈"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "强迫自己挺直背脊不能倒下，心里其实很想停下来",
       "keys": [],
       "from": [
        "S01-B2"
       ],
       "bead": "S01-B2"
      },
      {
       "text": "旧日的声音和光线忽然回到眼前，可过去没法再变成现在",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "那点笃定没撑多久他心里就空落落的，说不清舍不得什么",
       "keys": [
        "空落落的"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像在又冷又空的地方醒来，胸口发紧，伸手只摸到一片空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他还是想往前过日子，却不知道以后靠什么让自己安心",
       "keys": [
        "靠什么让自己安心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前自在的日子，想到以后不能再那样过就发慌",
       "keys": [
        "舍不得从前自在的日子"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "像远处传来的旧歌只哼得出几句，珍惜的已没法照旧拥有",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他赶紧拿受过的气提醒自己，生怕心软忘了当初为什么走",
       "keys": [
        "受过的气"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像整理衣服抬头连说三遍没事，从几分信到硬信，反露出在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "难道为了不再受那些气，就得把以前的好日子一起丢掉吗？",
       "keys": [
        "以前的好日子"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "一边强撑着控制自己，一边在心里死扛：我不甘心就这样垮掉",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "欢喜",
     "lines": [
      {
       "text": "他心里还憋着一股气，想起曾被人当自己人又高兴了一小会儿",
