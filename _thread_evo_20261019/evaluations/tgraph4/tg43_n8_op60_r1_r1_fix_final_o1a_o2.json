     "rel": "提供理由",
     "audit": "支持",
     "old": [
      "N15",
      "N16"
     ]
    }
   ],
   "items_before_fix": [
    {
     "id": "I17",
     "text": "他不愿让新添的紧张破坏先前得来的快乐，也不想把喜欢变成无形的催促。",
     "key": "不愿快乐被紧张破坏",
     "kind": ""
    },
    {
     "id": "I18",
     "text": "他提醒自己，关心、给予并由衷为对方高兴，本身就是真实的快乐。",
     "key": "给予本身就是快乐",
     "kind": "",
     "follows": true
    },
    {
     "id": "I19",
     "text": "这样想让他轻松下来，也更愿意付出，不再小心衡量心意的多少。",
     "key": "轻松后更愿付出",
     "kind": "",
     "follows": true
    },
    {
     "id": "I20",
     "text": "他不再担心多给一点会显得自己更加在乎，反而为这种热切感到幸福。",
     "key": "不再担心给得更多",
     "kind": "",
     "follows": true
    },
    {
     "id": "I21",
     "text": "那一阵，他甚至相信，只要不提出要求，就能尽情地爱而不失去什么。",
     "key": "无要求便能尽情爱",
     "kind": "",
     "follows": true
    }
   ],
   "relation_votes": {
    "正在面对": 6
   },
   "relation_model": "正在面对",
   "items_before_reorg": [
    {
     "id": "N16",
     "text": "他不愿让新添的紧张毁掉先前的快乐；对方没答应过什么，他也不想催着人回应。",
     "from": [
      "I15",
