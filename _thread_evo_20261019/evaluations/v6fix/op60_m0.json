   {
    "sec": "S12",
    "bars": "93–102",
    "relation": "正在面对",
    "items": [
     {
      "id": "I93",
      "text": "亲近带来的快乐压过了旧有顾虑",
      "key": "旧有顾虑",
      "follows": null
     },
     {
      "id": "I94",
      "text": "他惊讶自己竟能喜欢得这样深",
      "key": "喜欢得这样深",
      "follows": null
     },
     {
      "id": "I95",
      "text": "他平日难放下的计较失了分量",
      "key": "计较失了分量",
      "follows": null
     },
     {
      "id": "I96",
      "text": "他不愿让欢喜有一点减损",
      "key": "一点减损",
      "follows": null
     },
     {
      "id": "I97",
      "text": "他恨不得把爱意全部给出去",
      "key": "全部给出去",
      "follows": null
     },
     {
      "id": "I98",
      "text": "他恨不得接住对方全部的温柔",
      "key": "全部的温柔",
      "follows": null
     },
     {
      "id": "I99",
      "text": "尽情相爱时，他更舍不得这一切",
      "key": "更舍不得这一切",
      "follows": null
     },
     {
      "id": "I100",
      "text": "那一点不安使幸福显得更珍贵",
      "key": "幸福显得更珍贵",
      "follows": null
     },
     {
      "id": "I101",
      "text": "他几乎分不清胸口的热是欢喜还是怕失去",
      "key": "几乎分不清",
      "follows": null
     },
     {
      "id": "I102",
      "text": "他欢喜得近乎疼痛",
      "key": "近乎疼痛",
      "follows": null
     },
     {
      "id": "I103",
      "text": "他仍一点也不愿退开",
      "key": "不愿退开",
      "follows": null
     }
