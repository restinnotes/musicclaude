      ],
      "bead_edges": [
        {
          "a": "S03-B1",
          "b": "S03-B2",
          "type": "段内先后",
          "note": "B2为B1的整体舞动感补出一种原稿明确描述的前后转弯：66–79焦躁急切，80–91柔和亲切。这是聆听路径，不是重新划分段落，也不意味着后半的不安必然消失。"
        },
        {
          "a": "S03-B1",
          "b": "S03-B3",
          "type": "可同时成立",
          "note": "舞步的活动感与旋律仿佛低语交缠，是不同的听觉层次。听者可以同时感到身体想动与耳边声音难以理清，不必把低语解释成具体人物之间的对话。"
        },
        {
          "a": "S03-B1",
          "b": "S03-B4",
          "type": "重叠但新增",
          "note": "两者都涉及活动与运动感；B4新增的是活动背后的可能动因——暂时把注意力从伤口移开，以及轻松可以真实存在的区别。它不需要再次重复困境未解的结论。"
        },
        {
          "a": "S03-B2",
          "b": "S03-B4",
          "type": "可同时成立",
          "note": "对旧日轻松亲近时刻的怀念，与现实中短暂恢复活动的兴致并不互斥。它们是不同的联想，不应拼成同一个人的连续经历。"
        },
        {
          "a": "S03-B1",
          "b": "S03-B5",
          "type": "另一种理解",
          "note": "B1把运动感听成想往前走却不能确定方向；B5则把它听成先前昂扬的热度慢慢退去。前者突出活动中的不安，后者突出坚定感的消退，不应写成同一个人物已经发生的连续心理过程。"
        },
        {
          "a": "S03-B2",
          "b": "S03-B5",
          "type": "另一种理解",
          "note": "后半的柔和可以被听成对旧日温暖的怀念，也可以被听成昂扬退潮后的自我怀疑。两者都能解释柔化的感受，但听者不必同时接受两套心理叙事。"
        }
      ],
