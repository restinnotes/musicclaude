<script>
  (function (w, d, l, i) {
    function loadGtm() {
      if (w.__erGtmLoaded) return;
      w.__erGtmLoaded = true;
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = d.getElementsByTagName('script')[0];
      var j = d.createElement('script');
      var dl = l !== 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    }

    ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (eventName) {
      w.addEventListener(eventName, loadGtm, { once: true, passive: true });
    });

    if ('requestIdleCallback' in w) {
      w.requestIdleCallback(loadGtm, { timeout: 8000 });
    } else {
      w.setTimeout(loadGtm, 6000);
    }
  })(window, document, 'dataLayer', 'GTM-5DD99HK');
</script>

<style>
.er-site-footer {
  background: #081d2d;
  color: #d6e3ec;
  padding: 4.5rem 1.5rem 2rem;
}

.er-site-footer__inner {
  max-width: 1220px;
  margin: 0 auto;
}

.er-site-footer__grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr 0.9fr 1.1fr;
  gap: 2.75rem;
}

.er-site-footer__brand {
  padding-right: 1rem;
}

.er-site-footer__logo {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  color: #ffffff;
  text-decoration: none;
}

.er-site-footer__logo-mark {
  width: 32px;
  height: 32px;
  border: 2px solid rgba(255,255,255,0.82);
  display: inline-block;
}

.er-site-footer__logo-text {
  display: flex;
  flex-direction: column;
  line-height: 0.92;
}

.er-site-footer__logo-text strong {
  font-size: 1.05rem;
  letter-spacing: 0.01em;
}

.er-site-footer__logo-text span {
  font-size: 0.66rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  opacity: 0.9;
}

.er-site-footer__intro {
  margin-top: 1.8rem;
  max-width: 270px;
  font-size: 1rem;
  line-height: 1.7;
  color: #6d88a0;
}

.er-site-footer__social {
  display: flex;
  gap: 0.7rem;
  margin-top: 1.8rem;
}

.er-site-footer__social-link {
  width: 34px;
  height: 34px;
  border: 1px solid rgba(132, 158, 180, 0.2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #6f8ca5;
  transition: 0.2s ease;
}

.er-site-footer__social-link:hover {
  color: #ffffff;
  border-color: rgba(21, 196, 223, 0.5);
  background: rgba(21, 196, 223, 0.08);
}

.er-site-footer__social-link svg {
  width: 16px;
  height: 16px;
}

.er-site-footer__col h4 {
  margin: 0 0 1.45rem;
  font-size: 0.98rem;
  font-weight: 700;
  color: #ffffff;
  text-transform: uppercase;
}

.er-site-footer__links {
  display: flex;
  flex-direction: column;
  gap: 0.95rem;
}

.er-site-footer__links a,
.er-site-footer__contact-item,
.er-site-footer__legal a {
  color: #58738a;
  text-decoration: none;
  font-size: 0.98rem;
  line-height: 1.45;
  transition: 0.2s ease;
}

.er-site-footer__links a:hover,
.er-site-footer__contact-item:hover,
.er-site-footer__legal a:hover {
  color: #11c2de;
}

.er-site-footer__view-all,
.er-site-footer__sample-link {
  display: inline-block;
  margin-top: 1.25rem;
  color: #11c2de;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
}

.er-site-footer__view-all:hover,
.er-site-footer__sample-link:hover {
  color: #ffffff;
}

.er-site-footer__contact-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.er-site-footer__contact-item {
  display: flex;
  align-items: flex-start;
  gap: 0.8rem;
}

.er-site-footer__contact-icon {
  width: 28px;
  height: 28px;
  border: 1px solid rgba(132, 158, 180, 0.2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #11c2de;
  flex-shrink: 0;
}

.er-site-footer__contact-icon svg {
  width: 15px;
  height: 15px;
}

.er-site-footer__bottom {
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(132, 158, 180, 0.14);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.2rem;
}

.er-site-footer__copy {
  margin: 0;
  color: #6d88a0;
  font-size: 0.92rem;
}

.er-site-footer__legal {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  flex-wrap: wrap;
}

.er-site-footer__legal span {
  color: #355068;
}

@media (max-width: 1100px) {
  .er-site-footer__grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 768px) {
  .er-site-footer {
    padding: 3.5rem 1.25rem 2rem;
  }

  .er-site-footer__grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .er-site-footer__intro {
    max-width: none;
  }

  .er-site-footer__bottom {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>

    <script>
      (function () {
        const body = document.body;
        const header = document.querySelector('.er-header');
        const searchOverlay = document.getElementById('erGlobalSearch');
        const searchTrigger = document.getElementById('erSearchTrigger');
        const mobileSearchOpen = document.getElementById('erMobileSearchOpen');
        const searchClose = document.getElementById('erSearchClose');
        const searchInput = document.getElementById('erGlobalSearchInput');
        const searchSubmit = document.getElementById('erGlobalSearchSubmit');
        const searchResults = document.getElementById('erGlobalSearchResults');
        const mobileMenu = document.getElementById('erMobileMenu');
        const mobileOpen = document.getElementById('erMobileOpen');
        const mobileClose = document.getElementById('erMobileClose');
        const mobileSearchInput = document.getElementById('erMobileSearchInput');
        const mobileSearchSubmit = document.getElementById('erMobileSearchSubmit');
        const megaSearchInput = document.getElementById('erMegaSearchInput');
        const megaCols = Array.from(document.querySelectorAll('#erMegaBody .er-mega-col'));
        const megaNoResults = document.getElementById('erMegaNoResults');
        const megaCount = document.getElementById('erMegaCount');
        const defaultMegaCount = megaCount ? megaCount.innerHTML : '';
        const mobileIndustryFilter = document.getElementById('erMobileIndustryFilter');
        const mobileIndustryItems = Array.from(document.querySelectorAll('.er-mobile-industry'));
        const searchChipButtons = Array.from(document.querySelectorAll('[data-search-chip]'));
        const navDropdownItems = Array.from(document.querySelectorAll('.er-nav-item--dropdown, .er-nav-item--mega'));
        const mobileSectionButtons = Array.from(document.querySelectorAll('[data-mobile-section]'));

        function setInteractiveHiddenState(element, isHidden) {
          if (!element) return;
          element.setAttribute('aria-hidden', isHidden ? 'true' : 'false');
          if ('inert' in element) {
            element.inert = isHidden;
          }
        }

        setInteractiveHiddenState(searchOverlay, !searchOverlay || !searchOverlay.classList.contains('er-search-overlay--open'));
        setInteractiveHiddenState(mobileMenu, !mobileMenu || !mobileMenu.classList.contains('er-mobile-menu--open'));

        function closeDesktopMenus() {
          navDropdownItems.forEach((item) => item.classList.remove('er-nav-item--open'));
        }

        navDropdownItems.forEach((item) => {
          const button = item.querySelector(':scope > button');
          if (!button) return;
          button.addEventListener('click', function (event) {
            if (window.innerWidth <= 960) return;
            event.preventDefault();
            const isOpen = item.classList.contains('er-nav-item--open');
            closeDesktopMenus();
            if (!isOpen) {
              item.classList.add('er-nav-item--open');
            }
          });
        });

        document.addEventListener('click', function (event) {
          if (event.target.closest('.er-nav-item')) return;
          closeDesktopMenus();
        });

        function openSearch(prefill) {
          if (!searchOverlay) return;
          searchOverlay.classList.add('er-search-overlay--open');
          body.classList.add('er-search-open');
          setInteractiveHiddenState(searchOverlay, false);
          body.style.overflow = 'hidden';
          if (typeof prefill === 'string') {
            searchInput.value = prefill;
          }
          window.setTimeout(function () {
            searchInput.focus();
            if (searchInput.value.trim().length >= 2) {
              performLiveSearch(searchInput.value.trim());
            }
          }, 120);
        }

        function closeSearch() {
          if (!searchOverlay) return;
          searchOverlay.classList.remove('er-search-overlay--open');
          body.classList.remove('er-search-open');
          setInteractiveHiddenState(searchOverlay, true);
          if (!mobileMenu || !mobileMenu.classList.contains('er-mobile-menu--open')) {
            body.style.overflow = '';
          }
        }

        function openMobile() {
          if (!mobileMenu) return;
          mobileMenu.classList.add('er-mobile-menu--open');
          setInteractiveHiddenState(mobileMenu, false);
          body.style.overflow = 'hidden';
        }

        function closeMobile() {
          if (!mobileMenu) return;
          mobileMenu.classList.remove('er-mobile-menu--open');
          setInteractiveHiddenState(mobileMenu, true);
          if (!searchOverlay || !searchOverlay.classList.contains('er-search-overlay--open')) {
            body.style.overflow = '';
          }
        }

        function redirectSearch(query) {
          const term = (query || '').trim();
          if (term.length < 2) return;
          window.location.href = `https://www.emergenresearch.com/search-reports/${encodeURIComponent(term)}`;
        }

        function renderSearchResults(items) {
          if (!searchResults) return;
          if (!items.length) {
            searchResults.innerHTML = '<div class="er-search-empty">No matching reports found.</div>';
            return;
          }

          searchResults.innerHTML = items.map(function (item) {
            const raw = item.url || item.slug || '';
            const href = /^https?:\/\//i.test(raw) ? raw : `https://www.emergenresearch.com/industry-report/${raw}`;
            const title = item.breadcum_title || item.title || 'Report';
            return `
              <a href="${href}" class="er-search-result">
                <span class="er-search-result__label">Report Match</span>
                <span class="er-search-result__title">${title}</span>
              </a>
            `;
          }).join('');
        }

        let searchTimer;
        function performLiveSearch(query) {
          const q = (query || '').trim();
          if (!searchResults) return;
          if (q.length < 2) {
            searchResults.innerHTML = '';
            return;
          }

          clearTimeout(searchTimer);
          searchTimer = window.setTimeout(function () {
            fetch(`https://www.emergenresearch.com/search/${encodeURIComponent(q)}`, {
              headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
              }
            })
              .then((response) => response.json())
              .then((data) => {
                renderSearchResults((data && data.reports) ? data.reports : []);
              })
              .catch(() => {
                searchResults.innerHTML = '<div class="er-search-empty">No matching reports found.</div>';
              });
          }, 220);
        }

        if (searchTrigger) {
          searchTrigger.addEventListener('click', function () {
            openSearch('');
          });
        }

        if (mobileSearchOpen) {
          mobileSearchOpen.addEventListener('click', function () {
            openSearch('');
          });
        }

        if (searchClose) {
          searchClose.addEventListener('click', closeSearch);
        }

        if (searchOverlay) {
          searchOverlay.addEventListener('click', function (event) {
            if (event.target === searchOverlay) {
              closeSearch();
            }
          });
        }

        if (searchInput) {
          searchInput.addEventListener('input', function () {
            performLiveSearch(searchInput.value);
          });
          searchInput.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
              event.preventDefault();
              redirectSearch(searchInput.value);
            }
          });
        }

        if (searchSubmit) {
          searchSubmit.addEventListener('click', function () {
            redirectSearch(searchInput.value);
          });
        }

        searchChipButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            const term = button.getAttribute('data-search-chip') || '';
            openSearch(term);
          });
        });

        document.addEventListener('keydown', function (event) {
          const key = event.key.toLowerCase();
          if ((event.ctrlKey || event.metaKey) && key === 'k') {
            event.preventDefault();
            openSearch('');
          }
          if (event.key === 'Escape') {
            closeSearch();
            closeDesktopMenus();
            closeMobile();
          }
        });

        if (mobileOpen) {
          mobileOpen.addEventListener('click', openMobile);
        }

        if (mobileClose) {
          mobileClose.addEventListener('click', closeMobile);
        }

        mobileSectionButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            const item = button.closest('.er-mobile-item');
            const isOpen = item.classList.contains('er-mobile-item--open');
            document.querySelectorAll('.er-mobile-item').forEach(function (node) {
              node.classList.remove('er-mobile-item--open');
            });
            if (!isOpen) {
              item.classList.add('er-mobile-item--open');
            }
          });
        });

        if (mobileSearchSubmit) {
          mobileSearchSubmit.addEventListener('click', function () {
            redirectSearch(mobileSearchInput.value);
          });
        }

        if (mobileSearchInput) {
          mobileSearchInput.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
              event.preventDefault();
              redirectSearch(mobileSearchInput.value);
            }
          });
        }

        function filterMega(query) {
          if (!megaCols.length || !megaCount || !megaNoResults) return;
          const q = (query || '').trim().toLowerCase();
          let visible = 0;
          megaCols.forEach(function (col) {
            const haystack = `${col.getAttribute('data-cat') || ''} ${col.textContent || ''}`.toLowerCase();
            const match = !q || haystack.includes(q);
            col.classList.toggle('er-mega-col--hidden', !match);
            if (match) visible += 1;
          });
          megaNoResults.classList.toggle('er-mega-no-results--visible', visible === 0);
          megaCount.innerHTML = q && visible !== megaCols.length
            ? `<strong>${visible}</strong> Matching Industries`
            : defaultMegaCount;
        }

        if (megaSearchInput) {
          megaSearchInput.addEventListener('input', function () {
            filterMega(megaSearchInput.value);
          });
        }

        if (mobileIndustryFilter) {
          mobileIndustryFilter.addEventListener('input', function () {
            const q = mobileIndustryFilter.value.trim().toLowerCase();
            mobileIndustryItems.forEach(function (item) {
              const haystack = item.getAttribute('data-industry') || '';
              item.classList.toggle('er-mobile-industry--hidden', !!q && !haystack.includes(q));
            });
          });
        }
      })();
    </script>
  <script>
  (function () {
    var promo = document.getElementById('erSitePromo');
    if (!promo) return;
    var mobileQuery = window.matchMedia('(max-width: 900px)');

    function clearPromoOffset() {
      document.body.classList.remove('er-site-promo-active');
      document.body.style.removeProperty('--er-site-promo-height');
    }

    function setHeight() {
      if (promo.classList.contains('is-hidden') || mobileQuery.matches) return;
      document.body.style.setProperty('--er-site-promo-height', promo.offsetHeight + 'px');
    }

    function openPromo() {
      if (mobileQuery.matches) {
        clearPromoOffset();
        return;
      }
      promo.classList.remove('is-hidden');
      document.body.classList.add('er-site-promo-active');
      setHeight();
    }

    openPromo();
    window.addEventListener('resize', setHeight, { passive: true });
    if (mobileQuery.addEventListener) {
      mobileQuery.addEventListener('change', openPromo);
    } else if (mobileQuery.addListener) {
      mobileQuery.addListener(openPromo);
    }
  })();
</script>
