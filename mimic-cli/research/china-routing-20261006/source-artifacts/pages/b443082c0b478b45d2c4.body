        <a href="https://www.messenger.com/t/DSersOfficial" class="support-btn">
            <span class="material-icons-round">chat</span>
            24/7 Live Support
        </a>

        <a href="mailto:support@dsers.com" class="support-btn">
            <span class="material-icons-round">email</span>
            Contact via Email
        </a>
    </div>
</div>





<script>
document.addEventListener('DOMContentLoaded', function () {

  if (document.querySelector('.tocbot')) {
    const tocbotContent = document.querySelector('.tocbot_content');
    if (tocbotContent) {
      tocbotContent.style.display = 'block';
    }
  }

  /* 移动端：将右侧目录和广告移入右侧抽屉 */
  (function initRightDrawer() {
    const toggleBtn = document.getElementById('rightDrawerToggleBtn');
    const panel = document.getElementById('rightDrawerPanel');
    const overlay = document.getElementById('rightDrawerOverlay');
    const closeBtn = document.getElementById('rightDrawerCloseBtn');
    const body = document.getElementById('rightDrawerBody');
    const tocbotContent = document.querySelector('.right-sidebar .tocbot_content');
    const adContainer = document.getElementById('ab-test-container');

    if (!toggleBtn || !panel || !overlay || !closeBtn || !body) return;

    function openRightDrawer() {
      body.innerHTML = '';
      if (tocbotContent) {
        body.appendChild(tocbotContent.cloneNode(true));
      }
      if (adContainer && adContainer.innerHTML.trim()) {
        const adClone = adContainer.cloneNode(true);
        adClone.removeAttribute('id');
        body.appendChild(adClone);
      }
      panel.classList.add('open');
      overlay.classList.add('open');
      toggleBtn.classList.add('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeRightDrawer() {
      panel.classList.remove('open');
      overlay.classList.remove('open');
      toggleBtn.classList.remove('hidden');
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      openRightDrawer();
    });
    closeBtn.addEventListener('click', closeRightDrawer);
    overlay.addEventListener('click', closeRightDrawer);
    window.addEventListener('resize', function () {
      if (window.innerWidth > 900) closeRightDrawer();
    });
  })();

  tocbot.init({
    tocSelector: '.tocbot_box',
    contentSelector: '.tocbot',
    headingSelector: 'h2, h3',
    hasInnerContainers: true,
    headingsOffset: 78,
    scrollSmoothOffset: -78,
  collapseDepth: 6, // 关键：所有层级都不折叠
  isCollapsedClass: 'is-collapsed',
  collapsibleClass: 'is-collapsible',
    headingObjectCallback: function (obj, heading) {
      const customText = heading.getAttribute('data-toc') || heading.textContent;
      if (customText) {
        obj.textContent = customText;
      }
      return obj;
    }
  });

  tocbot.refresh();


});
</script>



<script src="/blog/assets/built/tag-sort-order.js?v=dc29813cc6"></script>
<script>
    const drawerPanel = document.getElementById('drawerPanel');
    const drawerOverlay = document.getElementById('drawerOverlay');
    const drawerToggleBtn = document.getElementById('drawerToggleBtn');
    const drawerCloseBtn = document.getElementById('drawerCloseBtn');

    // 打开抽屉
/* ===================== 打开抽屉（最终完美版：无子菜单隐藏箭头） ===================== */
function openDrawer() {
    // ===== 1. Ghost API 初始化（正式/测试环境自动判断）=====
    const api = new GhostContentAPI({
        url: window.location.href.match('help.dsers.com') ? 'https://help.dsers.com' : 'https://help-dev.dsers.com',
        key: window.location.href.match('help.dsers.com') ? 'aba8f27e3ca137ee6541fd9a7c' : '193ea68ee8e27bfc6cdf440768',
        version: 'v3.0'
    })
    // ===== 2. 按文章所属 SaaS / AI Agent 选择菜单分类 =====
    const postTagSlugs = window.POST_TAG_SLUGS || [];
    const topTags = (typeof getTopTagsForPostTags === 'function')
        ? getTopTagsForPostTags(postTagSlugs)
        : TOP_TAGS;

    // ===== 3. 获取 DOM 元素 =====
    const tocList = document.querySelector('.drawer-toc .toc-list');
    const drawerPanel = document.querySelector('.drawer-panel');
    const drawerOverlay = document.querySelector('.drawer-overlay');
    const drawerToggleBtn = document.querySelector('.drawer-toggle-btn');

    // ===== 4. 显示 Loading（纯英文 + 动态CSS）=====
    function showLoading() {
        tocList.innerHTML = `
            <li class="toc-loading" style="padding: 18px 15px; text-align: center; color: #555; font-size:14px;">
                <span style="display:inline-block; animation:loadingRotate 1s linear infinite;">⏳</span>
                <span style="margin-left:6px;">Loading menu...</span>
            </li>
            <style>
                @keyframes loadingRotate { 0% { transform:rotate(0deg); } 100% { transform:rotate(360deg); } }
            </style>
        `;
    }

    // ===== 5. 隐藏 Loading =====
    function hideLoading() {
        const loadingEl = document.querySelector('.toc-loading');
        if (loadingEl) loadingEl.remove();
    }

    // ===== 6. 安全获取当前页面分类 =====
    function getCurrentCat() {
        try {
            return currentCat;
        } catch (e) {
            return null;
        }
    }

    // ===== 7. 绑定箭头折叠事件 =====
    function bindTocArrowEvents() {
        document.querySelectorAll('.toc-arrow-btn').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                const tocItem = this.closest('.toc-item');
                const tocSub = tocItem.querySelector('.toc-sub');

                tocItem.classList.toggle('open');
                tocSub.classList.toggle('open');
            });
        });
    }

    // ===== 8. 渲染多级菜单 =====
    function renderDrawerTree(treeList) {
        hideLoading();
        tocList.innerHTML = '';
        const currentCat = getCurrentCat();

        console.log(treeList, 'treeList')

        const sortedTagList = sortTagList(treeList, TAG_SORT_ORDER, topTags);
        console.log(sortedTagList);

        sortedTagList.forEach(topItem => {
            const topSlug = topItem.slug;
            const topName = topItem.name;
            const isAiTop = (typeof AI_TOP_TAGS !== 'undefined' && AI_TOP_TAGS.indexOf(topSlug) !== -1);
            const children = isAiTop ? [] : (topItem.children || []);
            const hasChildren = children.length > 0;
            const topHref = isAiTop ? `/aimode/?main=${topSlug}` : `/maintag/?main=${topSlug}`;

            // 一级菜单
            const li = document.createElement('li');
            li.className = `toc-item ${hasChildren ? 'has-sub' : ''}`;
            li.dataset.cat = topSlug;
            
            // 核心：有子菜单才显示箭头按钮
            const arrowBtnHtml = hasChildren ? `
                <button class="toc-arrow-btn">
                    <span class="material-icons-round">chevron_right</span>
                </button>
            ` : '';

            li.innerHTML = `
                <div class="toc-link">
                    <a class="toc-link-text" href="${topHref}">
                        ${topName}
                    </a>
                    ${arrowBtnHtml}
                </div>
                <ul class="toc-sub" id="toc-sub-${topSlug}"></ul>
            `;
            tocList.appendChild(li);

            // 子菜单（有就渲染，没有就空）
            const subUl = li.querySelector(`#toc-sub-${topSlug}`);
            let subHtml = '';
            if (hasChildren) {
                children.forEach(subItem => {
                    subHtml += `
                        <li class="toc-sub-item">
                            <a class="toc-sub-link" href="/articles/?main=${subItem.slug}">
                                <span>${subItem.name}</span>
                            </a>
                        </li>
                    `;
                });
            }
            subUl.innerHTML = subHtml;
        });

        // 绑定箭头事件
        bindTocArrowEvents();

        // 初始化高亮
        setTimeout(() => {
            initTocSidebarSafe();
        }, 0);
    }

    // ===== 9. 安全版目录初始化 =====
    function initTocSidebarSafe() {
        try {
            const currentCat = getCurrentCat();
            if (!currentCat) return;

            document.querySelectorAll('.toc-item').forEach(item => {
                item.classList.remove('open', 'active');
            });
            document.querySelectorAll('.toc-sub').forEach(sub => {
                sub.classList.remove('open');
            });

            const currentTocItem = document.querySelector(`.toc-item[data-cat="${currentCat}"]`);
            if (currentTocItem) {
                currentTocItem.classList.add('open', 'active');
                const subMenu = currentTocItem.querySelector('.toc-sub');
                if (subMenu) subMenu.classList.add('open');
            }
        } catch (e) {
            console.log('Menu highlight skipped');
        }
    }

    // =============================================
    // 开始请求
    // =============================================
    showLoading();

    api.tags.browse({ limit: 'all' }).then((res) => {
        const treeList = [];

        topTags.forEach(topSlug => {
            const topTag = res.find(item => item.slug === topSlug);
            if (!topTag) return;

            const children = res
                .filter(item => item.slug.startsWith(topSlug + '-') && item.slug !== topSlug)
                .map(item => ({
                    name: item.name.split('/')[1] || item.name,
                    slug: item.slug,
                    des: item.description
                }));

            treeList.push({
                name: topTag.name,
                slug: topTag.slug,
                des: topTag.description,
                children: children
            });
        });

        renderDrawerTree(treeList);

    }).catch((err) => {
        console.error('Failed to load menu', err);
        hideLoading();
        tocList.innerHTML = `<li style="padding:15px; text-align:center; color:#f56c6c;">Failed to load menu</li>`;
    });

    // ===== 打开抽屉 UI =====
    drawerPanel.classList.add('open');
    drawerOverlay.classList.add('open');
    if (drawerToggleBtn) {
        drawerToggleBtn.classList.add('hidden');
    }
    document.body.style.overflow = 'hidden';
}


    // 关闭抽屉
    function closeDrawer() {
        drawerPanel.classList.remove('open');
        drawerOverlay.classList.remove('open');

        if (drawerToggleBtn) {
            drawerToggleBtn.classList.remove('hidden');
        }

        document.body.style.overflow = '';
    }

    // 遮罩关闭
    drawerOverlay.addEventListener('click', closeDrawer);

    // 关闭按钮
    drawerCloseBtn.addEventListener('click', closeDrawer);

    // 所有箭头折叠
    document.querySelectorAll('.toc-arrow-btn').forEach(btn => {

        btn.addEventListener('click', function (e) {

            e.preventDefault();
            e.stopPropagation();

            const tocItem = this.closest('.toc-item');
            const tocSub = tocItem.querySelector('.toc-sub');

            tocItem.classList.toggle('open');
            tocSub.classList.toggle('open');
        });

    });
</script>

