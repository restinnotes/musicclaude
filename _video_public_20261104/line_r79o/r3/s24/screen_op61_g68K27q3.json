     "bars": "226–229;238–241",
     "from": [
      "S11-B2"
     ]
    }
   ]
  },
  {
   "sec": "S12",
   "rows": [
    {
     "kind": "line",
     "text": "他不再逼自己选边，当初受的气确实不该忍",
     "keys": [
      "不再逼自己选边"
