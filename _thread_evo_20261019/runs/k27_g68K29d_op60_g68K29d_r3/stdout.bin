{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然很想靠近，心里一下热起来\",\n          \"accent\": \"心里一下热起来\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"怕自己的需要成负担，只敢露出一点喜欢\",\n          \"accent\": \"只敢露出一点喜欢\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"这一点亲近已很甜，还不知下次能否坦白\",\n          \"accent\": \"还不知下次能否坦白\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-3\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"连自己也有点意外\",\n          \"after\": 0,\n          \"from\": [\"S01-1\"],\n          \"bars\": \"\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"像话到嘴边，因怕关系改变而沉默\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–3\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"像夏夜烟花迸开，碎光缓缓飘落\",\n          \"after\": 0,\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–3\",\n          \"at\": 2\n        },\n        {\n          \"text\": \"落下后仍悬在水面上方，船歌还没稳\",\n          \"after\": 0,\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–3\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"像刚踏上船板，木板微晃，身体一瞬失重\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"有些听法已在摇荡，这里还只是刚踏上船\",\n          \"after\": 0,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–3\",\n          \"at\": 13\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"1–3小节，开头两下和弦响亮而突然\",\n          \"from\": [\"S01-B1\"],\n          \"pt\": \"和弦\",\n          \"bars\": \"1–3\"\n        },\n        {\n          \"text\": \"1–3小节，船歌的摇荡感还没有成形\",\n          \"from\": [\"S01-B1\", \"S01-B3\"],\n          \"pt\": \"船歌\",\n          \"bars\": \"1–3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没有因为他露出在意就退开，他才渐渐放松下来\",\n          \"accent\": \"渐渐放松下来\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"像两个人挨得很近，连沉默也让他觉得自在\",\n          \"accent\": \"连沉默也让他觉得自在\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-B1\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"他也想顺势靠得更近，喜欢得几乎藏不住\",\n          \"accent\": \"喜欢得几乎藏不住\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"怕太急弄坏眼下的自在，他最后还是收住了\",\n          \"accent\": \"最后还是收住了\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 22\n        },\n        {\n          \"text\": \"两个人待在一起这么好，他还没分开就先舍不得\",\n          \"accent\": \"还没分开就先舍不得\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 31\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"肩膀挨着肩膀，连呼吸和体温都贴在一起\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约4–16\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"相识已久的人安静坐着，沉默也不紧张\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约4–16\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"夏末潮湿温热的风裹在皮肤上\",\n          \"after\": 1,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"约4–16\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"左手像心跳和水浪，船底托着身体放下重力\",\n          \"after\": 4,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–5\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"水一直在流，时间也一直往前走\",\n          \"after\": 4,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4–16\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"柔软落音甜蜜又惆怅，太喜欢便想让此刻慢些\",\n          \"after\": 4,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7–11\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"4–5小节，左手像心跳一样一下一下摇着\",\n          \"from\": [\"S02-B2\"],\n          \"pt\": \"左手\",\n          \"bars\": \"4–5\"\n        },\n        {\n          \"text\": \"12–14小节，歌声忽然往上涌\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"歌声\",\n          \"bars\": \"12–14\"\n        },\n        {\n          \"text\": \"14–16小节，歌声呼气般回到柔和\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"歌声\",\n          \"bars\": \"14–16\"\n        },\n        {\n          \"text\": \"7–11小节，几次柔软落音甜里带惆怅\",\n          \"from\": [\"S02-B4\"],\n          \"pt\": \"柔软落音\",\n          \"bars\": \"7–11\"\n        },\n        {\n          \"text\": \"4–16小节，右手两条旋律线贴得很近\",\n          \"from\": [\"S02-B1\"],\n          \"pt\": \"右手\",\n          \"bars\": \"4–16\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不去琢磨以后，只想舒服地待在亲近里\",\n          \"accent\": \"舒服地待在亲近里\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"像亲密交谈后安静下来，他有点陶醉、走神\",\n          \"accent\": \"有点陶醉、走神\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-B1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他想说有多喜欢，也想问对方是不是一样\",\n          \"accent\": \"也想问对方是不是一样\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S03-2\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"没想好怎么开口，念头就淡了\",\n          \"accent\": \"念头就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 25\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"歌声退到后面，只剩水波般的流动盘旋\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 2\n        },\n        {\n          \"text\": \"身体像在摇晃漂浮，暂时不去哪里\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"说过重要的话，心还停在那句话里面\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"沉默并不尴尬，反而很舒服\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17–23\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"急着表达的念头像露头一下，很快又沉回去\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20–21\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"倒影被风吹碎，亲密谈话碰到暗结，顺畅里生阻力\",\n          \"after\": 0,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20–22\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"17–23小节，歌声退后，只剩流动盘旋\",\n          \"from\": [\"S03-B1\"],\n          \"pt\": \"歌声\",\n          \"bars\": \"17–23\"\n        },\n        {\n          \"text\": \"20–21小节，短促急切的声音冒出\",\n          \"from\": [\"S03-B2\"],\n          \"pt\": \"声音\",\n          \"bars\": \"20–21\"\n        },\n        {\n          \"text\": \"20–22小节，流动像被暗流牵住\",\n          \"from\": [\"S03-B3\"],\n          \"pt\": \"流动\",\n          \"bars\": \"20–22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又让他满心欢喜\",\n          \"accent\": \"满心欢喜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想起上回明明想告诉对方，却没有开口\",\n          \"accent\": \"却没有开口\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"这回他几乎想把藏着的话全说出来\",\n          \"accent\": \"藏着的话全说出来\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"他盼着说出口，能把眼下的好留得久一点\",\n          \"accent\": \"把眼下的好留得久一点\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-2\"],\n          \"at\": 27\n        },\n        {\n          \"text\": \"可怕说太多让对方为难，连原有的自在也弄丢，最后还是留了些话\",\n          \"accent\": \"最后还是留了些话\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 38\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"熟悉歌声更华丽，花腔像水面晃动的光斑\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"像讲起往事，语速变了，又忍不住补细节\",\n          \"after\": 2,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24–34\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"高处长颤音像夕阳金光，亮得喉咙发颤\",\n          \"after\": 3,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30–34\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"像轻轻握着手，不知不觉握得更紧\",\n          \"after\": 4,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"越想抱紧当下，水面越颠簸，船舱越难平衡\",\n          \"after\": 4,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24–34\",\n          \"at\": 35\n        },\n        {\n          \"text\": \"左手水波一直向前，每一秒都像倒数\",\n          \"after\": 3,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24–34\",\n          \"at\": 42\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"24小节，熟悉歌声回来，花腔更华丽迫切\",\n          \"from\": [\"S04-B1\"],\n          \"pt\": \"歌声\",\n          \"bars\": \"24\"\n        },\n        {\n          \"text\": \"32小节附近，高处长颤音亮得刺眼\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"右手\",\n          \"bars\": \"约32\"\n        },\n        {\n          \"text\": \"34小节，摇晃渐渐放慢，话语余响\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"左手\",\n          \"bars\": \"34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他忘了藏好喜欢，对方已经看出他有多在乎\",\n          \"accent\": \"看出他有多在乎\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他心里空落落的，不知怎么相处，怕对方嫌他太黏\",\n          \"accent\": \"空落落的\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\", \"S05-3\"],\n          \"at\": 8\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"水波和摇荡忽然被抽掉，只剩单薄旋律游走\",\n          \"after\": 0,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\",\n          \"at\": 1\n        },\n        {\n          \"text\": \"像失去脚下支撑，漂进起雾水域，前路未卜\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35–39\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"熟悉的亲近也像忽然隔了一层\",\n          \"after\": 1,\n          \"from\": [\"S05-3\"],\n          \"bars\": \"\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"从两个人贴近耳语，忽然跌回自己的内心\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"这份幸福是真的吗？能维持多久？\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35–39\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"刚才想攥紧不放的冲动，轻轻退下去\",\n          \"after\": 1,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"35–39\",\n          \"at\": 16\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"35–39小节，丰满的水波和摇荡忽然消失\",\n          \"from\": [\"S05-B1\"],\n          \"pt\": \"左手\",\n          \"bars\": \"35–39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方看出他有多在乎，相处却一点没变，他才自在下来\",\n          \"accent\": \"相处却一点没变\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"安静时，他还想靠近，又怕自己要得太多\",\n          \"accent\": \"又怕自己要得太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"对方不知道他刚才多怕被嫌弃，他有点孤单\",\n          \"accent\": \"他有点孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\", \"S06-B3\"],\n          \"at\": 19\n        },\n        {\n          \"text\": \"他又忍不住想，对方会不会也舍不得结束这份亲近\",\n          \"accent\": \"也舍不得结束这份亲近\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 29\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"左手波浪变薄成细纹，暖金水面滑入古桥阴影\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"A大调新歌清澈舒展，像月光和初恋的下午\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40–50\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"低声像说着说着，不再费力显得完整\",\n          \"after\": 1,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"另一条声线时近时远地回应，像算了又放不下\",\n          \"after\": 1,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40–50\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"独处放大酸楚，亲近的人进不了心里，美好像回忆\",\n          \"after\": 2,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40–50\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"气味、身体、幻想、遗憾和快感混在一起，舒服得失去方向\",\n          \"after\": 1,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40–50\",\n          \"at\": 33\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"40小节，清澈的新旋律落进陌生水域\",\n          \"from\": [\"S06-B1\"],\n          \"pt\": \"旋律\",\n          \"bars\": \"40\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"这些日子对方总愿意陪他，他想也许对方也需要他\",\n          \"accent\": \"对方也需要他\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到两个人也许能互相依靠，他高兴得有点收不住\",\n          \"accent\": \"互相依靠\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-2\"],\n          \"at\": 11\n        },\n        {\n          \"text\": \"心里忽然一紧，他却还想这样待下去\",\n          \"accent\": \"心里忽然一紧\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-2\"],\n          \"at\": 22\n        },\n        {\n          \"text\": \"他盼着对方想找人陪时会想到自己，自己也能一直陪着\",\n          \"accent\": \"会想到自己\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-3\"],\n          \"at\": 31\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"跟他待在一起，也许对方也能安心些\",\n          \"after\": 0,\n          \"from\": [\"S07-1\"],\n          \"bars\": \"\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"清澈还在，底下却越来越不安分\",\n          \"after\": 1,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"安静享受不够，情欲、执念和生的眷恋推着往前\",\n          \"after\": 1,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51–61\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"有点情色的暖意，明知被卷进去还不想出来\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51–61\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"美没有消失，完美的一刻却停不住\",\n          \"after\": 3,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53–61\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"51–61小节，伴奏变密，内声部像暗涌攀爬\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"内声部\",\n          \"bars\": \"51–61\"\n        },\n        {\n          \"text\": \"51–61小节，低音八度与切分像沉重脉搏\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"低音\",\n          \"bars\": \"51–61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"上回无意间露了心意，这回见对方依然亲近\",\n          \"accent\": \"依然亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想主动些，大大方方地回应\",\n          \"accent\": \"大大方方地回应\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S08-1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"连往后的日子都开始盼了，觉得也许还能好很久\",\n          \"accent\": \"也许还能好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"可眼下的亲近未必一直如此，他心里没底\",\n          \"accent\": \"他心里没底\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-3\"],\n          \"at\": 27\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"旋律直接舒展，像意大利歌剧里的咏叹调\",\n          \"after\": 1,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"没有哲学和防卫，歌句越唱越开\",\n          \"after\": 1,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62–70\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"明亮轻盈，像重新接触阳光和风\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"身体像恢复弹性，甚至带一点玩心\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"轻快得像调情，也像回应\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62–70\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"快乐的余温还在，心头却泛起怀念\",\n          \"after\": 3,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69–71\",\n          \"at\": 29\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"62–70小节，旋律直接舒展，情绪一再抬高\",\n          \"from\": [\"S08-B1\"],\n          \"pt\": \"旋律\",\n          \"bars\": \"62–70\"\n        },\n        {\n          \"text\": \"69–70小节，歌声向上散开，像蒸发\",\n          \"from\": [\"S08-B3\"],\n          \"pt\": \"歌声\",\n          \"bars\": \"69–70\"\n        },\n        {\n          \"text\": \"71小节，歌声戛然而止，转入片刻静意\",\n          \"from\": [\"S08-B3\"],\n          \"pt\": \"歌声\",\n          \"bars\": \"71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他忽然担心，有天对方不再需要他陪\",\n          \"accent\": \"不再需要他陪\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"甚至连和他待着都不自在，他一下安静了\",\n          \"accent\": \"他一下安静了\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\", \"S09-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"刚才还敢盼那么远，现在却不敢再往下想\",\n          \"accent\": \"不敢再往下想\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-2\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"可对方一直没退开，两人眼下还亲近\",\n          \"accent\": \"两人眼下还亲近\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-3\"],\n          \"at\": 21\n        },\n        {\n          \"text\": \"也许对方也喜欢他在身边，他有点高兴\",\n          \"accent\": \"也喜欢他在身边\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S09-3\"],\n          \"at\": 27\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"前面的冲劲忽然收住，像话到要紧处停住\",\n          \"after\": 2,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72–75\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"渴望还在，却悬着没有发出来\",\n          \"after\": 2,\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"76–77\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"光还在，只像隔着薄雾，声音一层层暗下去\",\n          \"after\": 2,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72–77\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"他像在听自己的余响，问刚才是真的吗\",\n          \"after\": 3,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"心里还问，接下来怎么办\",\n          \"after\": 3,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72–77\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"夜空里的美好比愿望更大，不安暂时不占满心思\",\n          \"after\": 4,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72–77\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"72–75小节，前面的冲劲忽然收住\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"旋律\",\n          \"bars\": \"72–75\"\n        },\n        {\n          \"text\": \"76–77小节，飘渺颤音和轻柔和弦悬在半空\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"颤音与和弦\",\n          \"bars\": \"76–77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他想着，再猜下去连今天也过不踏实\",\n          \"accent\": \"连今天也过不踏实\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"便暂时不管往后怎样，先享受眼前的亲近\",\n          \"accent\": \"先享受眼前的亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"紧绷慢慢松开，他心里亮堂得几乎想笑，也有点想哭\",\n          \"accent\": \"亮堂得几乎想笑\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 20\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像绷着肩膀的人，终于长长呼出一口气\",\n          \"after\": 2,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"胸腔打开，压着的话有了舒展的空间\",\n          \"after\": 2,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"心事没解决，这一刻却不必控制感受\",\n          \"after\": 2,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78–83\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"身体像失去重量，灵魂飘在夏夜微风里\",\n          \"after\": 2,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"78–83\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"细亮音符像银色蛛丝，也像轻雨\",\n          \"after\": 2,\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"78–83\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"旋律短暂开出一块空地，不是永久避风处\",\n          \"after\": 1,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"78–83\",\n          \"at\": 30\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"78–83小节，原先的摇荡像被清风拨开\",\n          \"from\": [\"S10-B2\"],\n          \"pt\": \"左手\",\n          \"bars\": \"78–83\"\n        },\n        {\n          \"text\": \"80–83小节，一串琶音从高处倾泻而下\",\n          \"from\": [\"S10-B4\"],\n          \"pt\": \"右手\",\n          \"bars\": \"80–83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他想到自己需要对方，对方有时也需要他\",\n          \"accent\": \"对方有时也需要他\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"就算对方不需要，他仍愿意陪着，不再藏喜欢\",\n          \"accent\": \"不再藏喜欢\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S11-1\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"他高兴得顾不上害臊，觉得这么在乎也没什么不好\",\n          \"accent\": \"顾不上害臊\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S11-2\"],\n          \"at\": 15\n        },\n        {\n          \"text\": \"可对方以后还愿不愿让他陪，不由他决定\",\n          \"accent\": \"不由他决定\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-3\"],\n          \"at\": 23\n        },\n        {\n          \"text\": \"想到未必总能这样亲近，欢喜压得他心口发疼\",\n          \"accent\": \"心口发疼\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-3\"],\n          \"at\": 30\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"厚重和弦托起歌声，左手水波翻成惊涛\",\n          \"after\": 1,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像终于说出：这是我的感情，不再道歉\",\n          \"after\": 2,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84–92\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"力量短暂悬在半空，像等着下一阵浪\",\n          \"after\": 3,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"约92\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"也回应了第32小节那次未能落定的高潮\",\n          \"after\": 3,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"32\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"灿烂得像夕阳烧红天空，胸口反而发痛\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84–92\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"像重回旧房子，熟悉温柔还在，珍贵得让人心疼\",\n          \"after\": 4,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84–92\",\n          \"at\": 32\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"84小节，第一主题重新回来\",\n          \"from\": [\"S11-B1\"],\n          \"pt\": \"第一主题\",\n          \"bars\": \"84\"\n        },\n        {\n          \"text\": \"92小节附近，铺开的力量短暂悬在半空\",\n          \"from\": [\"S11-B2\"],\n          \"pt\": \"旋律\",\n          \"bars\": \"约92\"\n        },\n        {\n          \"text\": \"回应第32小节那次未能落定的高潮\",\n          \"from\": [\"S11-B2\"],\n          \"pt\": \"旋律\",\n          \"bars\": \"32\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他顾不上对方是否也在乎，只想把能给的都给对方\",\n          \"accent\": \"只想把能给的都给对方\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他希望对方安心，可再用心也保证不了以后\",\n          \"accent\": \"保证不了以后\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-1\", \"S12-2\"],\n          \"at\": 9\n        },\n        {\n          \"text\": \"这样的日子还是不够，他还想多陪对方一会儿\",\n          \"accent\": \"还想多陪对方一会儿\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-2\"],\n          \"at\": 18\n        },\n        {\n          \"text\": \"那阵高兴终于整个涌出来，他不再逼自己收着\",\n          \"accent\": \"高兴终于整个涌出来\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S12-3\"],\n          \"at\": 28\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"明亮开阔近乎英雄式，内声部彼此拉扯\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"私语放大成天地共振，整个人被卷进更大世界，自己退到后面\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93–102\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"这份狂喜像高烧，也像久别重逢\",\n          \"after\": 3,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"抱紧对方久久不愿松手，喉咙发紧\",\n          \"after\": 3,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"眼眶湿润，快乐到分不清想笑还是想哭\",\n          \"after\": 3,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93–102\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"温柔歌声带上恳求，旋律一次次向上伸展\",\n          \"after\": 2,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"93–102\",\n          \"at\": 33\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"93–102小节，晴朗歌声被放大到开阔尺度\",\n          \"from\": [\"S12-B1\"],\n          \"pt\": \"歌声\",\n          \"bars\": \"93–102\"\n        },\n        {\n          \"text\": \"96–100小节，乐句末端仍有牵扯和延迟\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"乐句末端\",\n          \"bars\": \"96–100\"\n        },\n        {\n          \"text\": \"102–103小节交界，悬着的气息终于释放\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"旋律\",\n          \"bars\": \"102–103交界\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"高兴过后，他更想听对方说以后也不变\",\n          \"accent\": \"以后也不变\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"就算听到保证，和他待在一起的时间仍过得飞快，他会问能一直这样吗\",\n          \"accent\": \"能一直这样吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"起初怕自己的需要添负担，如今更怕对方不再需要他\",\n          \"accent\": \"更怕对方不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 16\n        },\n        {\n          \"text\": \"他想，少露些心意会不会少疼些\",\n          \"accent\": \"会不会少疼些\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 24\n        },\n        {\n          \"text\": \"可他早已装不出不在乎，真往回藏反倒更难受\",\n          \"accent\": \"反倒更难受\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 31\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"长久悬着的心愿终于说出口\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"刚说出口，音乐仍反复渐强，像一浪推一浪\",\n          \"after\": 1,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103–110\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"幸福没有消失，悲伤却进入幸福里面\",\n          \"after\": 2,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"103–110\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"像刚说了是，心里马上冒出一句可是呢\",\n          \"after\": 3,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"103–110\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"下方像牢牢踩住地面，上方一次次落下，胸口一沉再沉\",\n          \"after\": 4,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103–110\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"刚才想对他好也是真心的\",\n          \"after\": 4,\n          \"from\": [\"S13-3\"],\n          \"bars\": \"\",\n          \"at\": 35\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"103小节，悬着的心愿终于说出口\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"旋律\",\n          \"bars\": \"103\"\n        },\n        {\n          \"text\": \"106小节以后，反复渐强，越推越紧\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"旋律\",\n          \"bars\": \"106以后\"\n        },\n        {\n          \"text\": \"107小节以后，明亮里掺进尖锐暗沉\",\n          \"from\": [\"S13-B2\"],\n          \"pt\": \"上方声部\",\n          \"bars\": \"107以后\"\n        },\n        {\n          \"text\": \"110–111小节交界，再有一次强烈冲击\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"旋律\",\n          \"bars\": \"110–111交界\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"最初他连喜欢都不敢多露，如今两人还亲近\",\n          \"accent\": \"如今两人还亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"心里又甜又酸，他还是舍不得，却并不后悔\",\n          \"accent\": \"又甜又酸\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S14-1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他仍不知道以后怎样，却不再逼自己要永远不变的保证\",\n          \"accent\": \"不再逼自己要永远不变的保证\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-2\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"既然喜欢已让对方看见，他就不往回藏，往后到了再说\",\n          \"accent\": \"他就不往回藏\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-3\"],\n          \"at\": 26\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像从美梦醒来，身体平静，心里还留着光\",\n          \"after\": 1,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111–115\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"像男中音独自沉思，熟悉的歌又回来\",\n          \"after\": 2,\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113–115\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"细碎琶音像水花溅向夜空\",\n          \"after\": 2,\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"115\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"最后几下和弦像铁锚落入水底\",\n          \"after\": 3,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"像经历震荡后站起身，整理衣服关上门\",\n          \"after\": 3,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"尾声像隔着很远回应开头，终于把悬着的话接完\",\n          \"after\": 3,\n          \"from\": [\"S14-B4\"],\n          \"bars\": \"113–116\",\n          \"at\": 33\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"110–111小节交界，最后一股浪头又推来\",\n          \"from\": [\"S14-B1\"],\n          \"pt\": \"旋律\",\n          \"bars\": \"110–111交界\"\n        },\n        {\n          \"text\": \"113小节，左手内声部幽幽唱出一句\",\n          \"from\": [\"S14-B2\"],\n          \"pt\": \"左手内声部\",\n          \"bars\": \"113\"\n        },\n        {\n          \"text\": \"115小节，右手细碎琶音像水花溅起\",\n          \"from\": [\"S14-B2\"],\n          \"pt\": \"右手\",\n          \"bars\": \"115\"\n        },\n        {\n          \"text\": \"116小节，最后几下和弦干脆而沉重\",\n          \"from\": [\"S14-B3\"],\n          \"pt\": \"和弦\",\n          \"bars\": \"116\"\n        },\n        {\n          \"text\": \"113小节回望开头，116小节像把话接完\",\n          \"from\": [\"S14-B4\"],\n          \"pt\