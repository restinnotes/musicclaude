     ],
     "beads": [
      {
       "text": "沉默不让人紧张",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "夏末温热的风",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
