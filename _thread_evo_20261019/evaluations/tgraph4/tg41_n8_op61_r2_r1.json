     "rel": "提供理由",
     "how": ""
    }
   ]
  },
  {
   "bars": "242–253",
   "relation": "正在面对",
   "items": [
    {
     "id": "I57",
     "text": "他不再等一个毫无损失的办法，久违的昂扬终于回来，也无须否认自己的脆弱。",
     "key": "昂扬",
     "kind": ""
    },
    {
     "id": "I58",
     "text": "他仍愿尽力改变事情，却不再借这份尽力证明自己无所不能。",
     "key": "无所不能",
     "kind": "分清"
    },
    {
     "id": "I59",
     "text": "他明白自己要承担什么，也肯让那些怕失去、想珍惜的感受被自己看见。",
     "key": "怕失去",
     "kind": ""
    },
    {
     "id": "I60",
     "text": "他愿为真心爱惜的一切负起责任，不再把牵挂看成行动的拖累。",
     "key": "负起责任",
     "kind": ""
    },
    {
     "id": "I61",
     "text": "他仍会犹疑，却已经允许自己不等它消失就重新下决心。",
     "key": "犹疑",
     "kind": ""
    }
   ],
   "because": [
