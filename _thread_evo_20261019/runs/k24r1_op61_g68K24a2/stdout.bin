{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"离开后他总算不用再委屈自己\",\n          \"accent\": \"不用再委屈自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他逼自己挺直背脊不能倒下\",\n          \"accent\": \"挺直背脊\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-B2\"],\n          \"at\": 22\n        },\n        {\n          \"text\": \"可他心里其实很想停下来\",\n          \"accent\": \"很想停下来\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S01-B2\"],\n          \"at\": 42\n        },\n        {\n          \"text\": \"空落落的他还说不清为何失落\",\n          \"accent\": \"说不清为何失落\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-2\", \"S01-B3\"],\n          \"at\": 62\n        },\n        {\n          \"text\": \"他仍想往前过却不知怎样安心\",\n          \"accent\": \"不知怎样安心\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-3\", \"S01-B5\"],\n          \"at\": 82\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"分不清是愤怒遗憾还是怀念\",\n          \"after\": 3,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–23\",\n          \"at\": 64\n        },\n        {\n          \"text\": \"刚醒来般恍惚，胸口发紧视线模糊\",\n          \"after\": 3,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"1–23\",\n          \"at\": 68\n        },\n        {\n          \"text\": \"四周冷而空，颤手只摸到虚空\",\n          \"after\": 3,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"1–23\",\n          \"at\": 70\n        },\n        {\n          \"text\": \"旧日声音光线回来了，却回不到现在\",\n          \"after\": 4,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"9–17\",\n          \"at\": 84\n        },\n        {\n          \"text\": \"身体先于意识记起怎样迈步\",\n          \"after\": 4,\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"18–23\",\n          \"at\": 86\n        },\n        {\n          \"text\": \"叹息刚出口就散在冷空气里\",\n          \"after\": 3,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–23\",\n          \"at\": 66\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"重和弦像召唤，琶音散开等回声\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1–6\"\n        },\n        {\n          \"text\": \"短句刚响起就被长停顿截断\",\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"波兰舞曲的步态渐渐浮现\",\n          \"from\": [\"S01-B5\"],\n          \"bars\": \"18–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"从前自在的日子让他舍不得\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-1\", \"S02-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到以后不能那样过他有些慌\",\n          \"accent\": \"有些慌\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-1\", \"S02-B2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他赶紧提醒自己受过的那些气\",\n          \"accent\": \"受过的那些气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\", \"S02-B4\"],\n          \"at\": 24\n        },\n        {\n          \"text\": \"可他还是不甘心就这样消亡\",\n          \"accent\": \"不甘心\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-3\", \"S02-B5\"],\n          \"at\": 36\n        },\n        {\n          \"text\": \"难道不受气就得丢掉好日子？\",\n          \"accent\": \"丢掉好日子\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\", \"S02-B5\"],\n          \"at\": 48\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像远处旧歌，只能模糊哼几句\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"珍惜的东西还在，却不能照旧拥有\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"腿脚发虚，还在记忆里挪动舞步\",\n          \"after\": 1,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24–65\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"抬头装作没事，后来连自己都难信\",\n          \"after\": 2,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"24–65\",\n          \"at\": 38\n        },\n        {\n          \"text\": \"怕一心软就忘了当初为何离开\",\n          \"after\": 2,\n          \"from\": [\"S02-2\", \"S02-B4\"],\n          \"bars\": \"\",\n          \"at\": 40\n        },\n        {\n          \"text\": \"连绵节奏催得呼吸越来越急\",\n          \"after\": 1,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"56–65\",\n          \"at\": 42\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"舞步庄严，旋律却脆弱凄婉\",\n          \"from\": [\"S02-B1\", \"S02-B2\"],\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"音乐猛地上冲又退下，随后再聚力\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"38–65\"\n        },\n        {\n          \"text\": \"连绵的三连音一串接一串\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"56–65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他心里还憋着一股气\",\n          \"accent\": \"憋着一股气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S03-1\", \"S03-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起曾被当作自己人\",\n          \"accent\": \"自己人\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\", \"S03-B2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他竟高兴了一小会儿\",\n          \"accent\": \"高兴了一小会儿\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S03-1\", \"S03-B2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"可那点高兴很快变酸\",\n          \"accent\": \"很快变酸\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S03-2\", \"S03-B2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"离开以后真的会更好过吗？\",\n          \"accent\": \"更好过吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\", \"S03-B5\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"想往前走，却定不下方向\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66–91\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"麦浪微风般轻盈，也想起亲近时光\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"80–91\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"从前轻松自在，不必时时防备\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\", \"S03-1\"],\n          \"bars\": \"80–91\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"暂时绕开伤口，轻松是真的却没答案\",\n          \"after\": 3,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"66–91\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"耳边多人低声絮语，脚下像流沙\",\n          \"after\": 3,\n          \"from\": [\"S03-B4\"],\n          \"bars\": \"66–91\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"我刚才真的相信那些话吗？\",\n          \"after\": 4,\n          \"from\": [\"S03-B5\"],\n          \"bars\": \"66–91\",\n          \"at\": 28\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"重和弦若突出，会像重锤砸下\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66\"\n        },\n        {\n          \"text\": \"舞步离开端正姿态，转为流动不安\",\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"前半急切，后半忽然柔和轻盈\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"66–91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"想起从前亲近的日子\",\n          \"accent\": \"亲近的日子\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-1\", \"S04-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他一度真盼着还能那样相处\",\n          \"accent\": \"还能那样相处\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\", \"S04-B1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"可亲近越鲜活当初委屈也翻上来\",\n          \"accent\": \"当初委屈\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\", \"S04-B2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他开始问那一步走得对不对\",\n          \"accent\": \"走得对不对\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\", \"S04-B4\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"没走的话如今又会怎样？\",\n          \"accent\": \"如今又会怎样\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\", \"S04-B4\"],\n          \"at\": 16\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"那时有感激亲密柔情和短暂幸福\",\n          \"after\": 1,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"记忆太美好，过去却回不来了\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108–115\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"细碎音符像急促脚步或乱跳心跳\",\n          \"after\": 2,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92–115\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"像被时间追着跑，身体停不下来\",\n          \"after\": 3,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92–115\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"脑子里反复问如果当时还能怎样\",\n          \"after\": 3,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94–115\",\n          \"at\": 26\n        },\n        {\n          \"text\": \"不停往前赶，只是为了不让自己停下\",\n          \"after\": 4,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94–115\",\n          \"at\": 28\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉主题回来，旋律更像独自倾诉\",\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\"\n        },\n        {\n          \"text\": \"音乐忽然变得风暴般激烈紧绷\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"108–115\"\n        },\n        {\n          \"text\": \"低沉的声音追赶，细碎音符急促乱跑\",\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"92–115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他仍觉得当初那些气不该忍\",\n          \"accent\": \"不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\", \"S05-B2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可他不想连开心的事都不敢想\",\n          \"accent\": \"开心的事\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-1\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"跟自己争到最后没了力气\",\n          \"accent\": \"没了力气\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\", \"S05-B5\"],\n          \"at\": 16\n        },\n        {\n          \"text\": \"那股不服气渐渐淡了\",\n          \"accent\": \"渐渐淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S05-2\"],\n          \"at\": 24\n        },\n        {\n          \"text\": \"如今不在那些人身边只觉得难受\",\n          \"accent\": \"只觉得难受\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\", \"S05-B3\"],\n          \"at\": 32\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"愤怒悲伤里还想维护自己\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116–127\",\n          \"at\": 34\n        },\n        {\n          \"text\": \"夜色里像两个影子低声说话\",\n          \"after\": 2,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"116–147\",\n          \"at\": 38\n        },\n        {\n          \"text\": \"旧日记忆有了温度，可能是人或故乡\",\n          \"after\": 4,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116–147\",\n          \"at\": 42\n        },\n        {\n          \"text\": \"眷恋里还带着失落\",\n          \"after\": 4,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116–147\",\n          \"at\": 46\n        },\n        {\n          \"text\": \"脚下像突然没了地板，只剩一个声音\",\n          \"after\": 4,\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128–147\",\n          \"at\": 50\n        },\n        {\n          \"text\": \"不安加深，几次深呼吸像抵抗累了\",\n          \"after\": 3,\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"132–147\",\n          \"at\": 54\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"柔和歌唱忽然像换了个人开口\",\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"116–147\"\n        },\n        {\n          \"text\": \"快速音型渐渐放缓变稀，化成疏和弦\",\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128–147\"\n        },\n        {\n          \"text\": \"末尾声音稀疏，像几次深深叹息\",\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"144–147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"难受缓下来他终于敢说心里话\",\n          \"accent\": \"终于敢说心里话\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\", \"S06-B2\", \"S06-B3\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"如今身边没人他才懂从前多轻松\",\n          \"accent\": \"多轻松\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S06-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他想再过那种自然亲近的日子\",\n          \"accent\": \"自然亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-3\", \"S06-B2\"],\n          \"at\": 24\n        },\n        {\n          \"text\": \"又怕以后再也没有\",\n          \"accent\": \"再也没有\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-3\"],\n          \"at\": 36\n        },\n        {\n          \"text\": \"看着回不去的旧日心里暖了些\",\n          \"accent\": \"心里暖了些\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-4\", \"S06-B4\"],\n          \"at\": 48\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像隔着透明玻璃罩，连呼吸都放轻\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\",\n          \"at\": 50\n        },\n        {\n          \"text\": \"像母亲在耳边轻轻哼摇篮曲\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\",\n          \"at\": 52\n        },\n        {\n          \"text\": \"这回没拿受过的气压住想念\",\n          \"after\": 0,\n          \"from\": [\"S06-1\"],\n          \"bars\": \"\",\n          \"at\": 54\n        },\n        {\n          \"text\": \"终于不用解释难过，也不用装坚强\",\n          \"after\": 0,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\",\n          \"at\": 56\n        },\n        {\n          \"text\": \"愿望委屈思念浮上来，向未知远方祈求\",\n          \"after\": 0,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\",\n          \"at\": 58\n        },\n        {\n          \"text\": \"远方忽然亮起，梦里看见回不去的家园\",\n          \"after\": 4,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"约160\",\n          \"at\": 60\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"音乐忽然滑进一片安静之中\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"旋律由含蓄试探逐渐展开，临近结尾停住\",\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"148–180\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"刚有点安心他又怕以后独自扛\",\n          \"accent\": \"怕以后独自扛\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-1\", \"S07-B1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"当初只想不再受气没料到孤单\",\n          \"accent\": \"没料到孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-2\", \"S07-B4\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"早知道会这么孤单还会走吗\",\n          \"accent\": \"还会走吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-2\"],\n          \"at\": 16\n        },\n        {\n          \"text\": \"他想找回亲近却不愿再受那些气\",\n          \"accent\": \"不愿再受那些气\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S07-3\", \"S07-B5\"],\n          \"at\": 24\n        },\n        {\n          \"text\": \"连当初离开的决心也找不回了\",\n          \"accent\": \"找不回了\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-3\"],\n          \"at\": 32\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"寒风吹开窗，把人从甜梦拽回严寒\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\",\n          \"at\": 34\n        },\n        {\n          \"text\": \"后颈发凉，脉搏猛地跳起来\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"新舞步闯入，思绪被截断，心里未必安定\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182–197\",\n          \"at\": 38\n        },\n        {\n          \"text\": \"事情像过去了，心里仍发颤找不到出口\",\n          \"after\": 3,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\",\n          \"at\": 42\n        },\n        {\n          \"text\": \"熟悉的舞步一闯进来，失去感更清楚\",\n          \"after\": 3,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181–205\",\n          \"at\": 46\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高处忽然浮出一串细长颤音\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\"\n        },\n        {\n          \"text\": \"新舞步闯入，与刚才的静谧形成反差\",\n          \"from\": [\"S07-B2\", \"S07-B5\"],\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"连续颤音一层层累积\",\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"他先把回去的事放一边\",\n          \"accent\": \"放一边\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起曾被当作自己人却没回头\",\n          \"accent\": \"却没回头\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"