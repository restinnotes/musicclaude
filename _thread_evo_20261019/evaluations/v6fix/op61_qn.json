      "rel": "引用"
     },
     {
      "from": "S03-2",
      "to": "S08-2",
      "rel": "引用"
     },
     {
      "from": "S07-3",
      "to": "S08-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "还说不清",
    "items": [
     {
      "id": "S09-1",
      "text": "他还留恋着那份熟悉，忽然又觉得如今的日子空落得很。",
      "key": "他还留恋着那份熟",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-1",
       "S06-1"
      ]
     },
     {
      "id": "S09-2",
      "text": "一阵心慌过去，他仍不知道自己若重选一次会怎么做。",
      "key": "一阵心慌过去，他",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-2",
       "S08-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S08-1",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S06-1",
      "to": "S09-1",
      "rel": "引用"
     },
     {
      "from": "S07-2",
