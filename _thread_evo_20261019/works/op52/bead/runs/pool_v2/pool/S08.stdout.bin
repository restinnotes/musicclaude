\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"那只是自己想象中的生活，现实并没有因此发生改变。\",\n      \"experience\": \"意识到想象中的安宁并未改变现实。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P08\",\n      \"src\": \"SRC-gpt56w-int-2\",\n      \"src_range\": \"mm. 100–128\",\n      \"measures\": \"100–128\",\n      \"range_reason\": \"\",\n      \"quote\": \"你想控制自己，却发现自己的情绪已经不完全听从意志。\",\n      \"experience\": \"试图控制情绪，却发现情绪不再受意志支配。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P09\",\n      \"src\": \"SRC-gpt56w-int-3\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"之前的安慰似乎已经不足以让人完全平静。\",\n      \"experience\": \"先前的安慰不再足以维持平静。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P10\",\n      \"src\": \"SRC-gpt56w-int-3\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"那些原本没有解决的问题又回来了。\",\n      \"experience\": \"休息结束后，未解决的问题重新浮现。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P11\",\n      \"src\": \"SRC-gpt56w-int-3\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"他的思绪开始加速。\",\n      \"experience\": \"思绪开始加快。\",\n      \"type\": \"变化\"\n    },\n    {\n      \"id\": \"P12\",\n      \"src\": \"SRC-gpt56w-int-3\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"越是想要抓住，越发现它并不是自己能够控制的东西。\",\n      \"experience\": \"越想留住刚才的美好，越感到无法控制。\",\n      \"type\": \"感受\"\n    },\n    {\n      \"id\": \"P13\",\n      \"src\": \"SRC-gpt56w-int-3\",\n      \"src_range\": \"mm. 100–111\",\n      \"measures\": \"100–111\",\n      \"range_reason\": \"\",\n      \"quote\": \"原本可以安放自己的情绪空间，又开始变得拥挤。\",\n      \"experience\": \"原本安放情绪的空间重新显得拥挤。\",\n      \"type\": \"画面\"\n    },\n    {\n      \"id\": \"P14\",\n      \"src\": \"SR