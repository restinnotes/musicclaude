{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"fine\": [\n        {\n          \"quote\": \"它像要宣告什么，紧接着的自由上行琶音却没把这份重量接住，反而像烟雾往高处散\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"尚未找到对象、也尚未找到语言的失落\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"可记忆再清晰，过去也不会因此重新变成现在\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"离开以后，他起初\",\n          \"point\": \"不用再委屈自己\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"起初\"\n        },\n        {\n          \"text\": \"可他很快觉得\",\n          \"point\": \"不知怎么才能安心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可他很快\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"fine\": [\n        {\n          \"quote\": \"你依稀记得它，却只能模糊地哼出几句\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"节奏本身庄严、傲慢，旋律却脆弱凄婉；底下的伴奏还有细碎、不安的半音在蠕动\",\n          \"carrier\": \"形容词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"说到第三次，连反复说这句话本身都暴露出：其实还是很在意\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"舍不得从前的自在\",\n          \"point\": \"忘了为何离开\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一心软\"\n        },\n        {\n          \"text\": \"他还是不甘心\",\n          \"point\": \"好日子也得丢掉\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"连从前的好日子也得丢掉\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"fine\": [\n        {\n          \"quote\": \"有人把他当作自己人\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"被当作自己人\"\n        },\n        {\n          \"quote\": \"那一刻的轻松可以是真的，并非假装；只是它没有替心里的事找到答案\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"越怀念，越能感觉它与眼前处境的距离\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他还憋着气\",\n          \"point\": \"想起从前那份亲近\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"却也因为\"\n        },\n        {\n          \"text\": \"没过多久，他心里又发酸\",\n          \"point\": \"日子真会更好吗\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"没过多久\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"fine\": [\n        {\n          \"quote\": \"外在的步伐还在向前，里面却有了更多回声\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"步伐还在向前\"\n        },\n        {\n          \"quote\": \"这份坚定也可能是他努力想成为的样子，而不再是一个毫无疑问的事实\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"还不是事实\"\n        },\n        {\n          \"quote\": \"不停地往前赶，只是为了避免停下来\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"只是为了\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"想起从前亲近的日子\",\n          \"point\": \"还能那样相处\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一度\"\n        },\n        {\n          \"text\": \"当初的委屈又翻上来\",\n          \"point\": \"走得对不对\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"又翻上来\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"fine\": [\n        {\n          \"quote\": \"可连过去开心的事都不敢多想，也太为难自己了\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"也太为难自己\"\n        },\n        {\n          \"quote\": \"两只手仿佛夜色里两个影子，彼此低声说话\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是已经想通了，而是抵抗得累了\",\n          \"carrier\": \"心里的话\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他仍觉得当初受的气\",\n          \"point\": \"当初受的那些气不该忍\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"也不敢多想从前的开心\"\n        },\n        {\n          \"text\": \"他跟自己反复较劲\",\n          \"point\": \"只剩下离开后的难受\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"直到没了力气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"fine\": [\n        {\n          \"quote\": \"他常常只能自己挺过去\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"没了\",\n          \"matter\": \"大\",\n          \"fix\": \"常常只能自己挺过去\"\n        },\n        {\n          \"quote\": \"不用多说也知道彼此亲近的日子\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"不用多说也知道彼此亲近\"\n        },\n        {\n          \"quote\": \"那样的日子自己毕竟真真切切过过\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"真真切切过过\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"难受慢慢缓下来\",\n          \"point\": \"没再拿受