    "relation": "正在面对",
    "items": [
     {
      "id": "I104",
      "text": "这份幸福已深得有些难承受",
      "key": "难承受",
      "follows": null
     },
     {
      "id": "I105",
      "text": "他仍想让幸福继续加深",
      "key": "继续加深",
      "follows": null
     },
     {
      "id": "I106",
      "text": "他尤其舍不得自己能这样全心爱着",
      "key": "全心爱着",
      "follows": null
     },
     {
      "id": "I107",
      "text": "他从未觉得心里的爱这样丰盛",
      "key": "这样丰盛",
      "follows": null
     },
     {
      "id": "I108",
      "text": "他清楚感到爱如此丰盛也留不住此刻",
      "key": "留不住此刻",
      "follows": null
     },
     {
      "id": "I109",
      "text": "一想到会失去，他已无法轻轻带过",
      "key": "无法轻轻带过",
      "follows": null
     },
     {
      "id": "I110",
      "text": "那份痛楚没有让幸福变得虚假",
      "key": "幸福变得虚假",
      "follows": null
     },
     {
      "id": "I111",
      "text": "他连欢喜和不舍中的任何一种都不盼消失",
      "key": "不盼消失",
      "follows": null
     },
     {
      "id": "I112",
      "text": "他发现舍不得的正是让他快乐的东西",
      "key": "让他快乐的东西",
      "follows": null
     }
