       "S10-3"
      ]
     },
     {
      "id": "S11-2",
      "text": "一想到那份归属还没有答案，他仍会被不安拖住，得一次次费力才能把心思收回来。",
      "key": "一想到那份归属还",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-2",
       "S11-1"
      ]
     },
     {
      "id": "S11-3",
      "text": "然而他渐渐肯承认，即使怀念没有得到满足，这样坚持也不是白费。",
      "key": "然而他渐渐肯承认",
      "follows": false,
      "explains": [],
      "cite": [
       "S05-2",
       "S11-1",
       "S11-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S10-3",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S10-2",
      "to": "S11-2",
      "rel": "引用"
     },
     {
      "from": "S11-1",
      "to": "S11-2",
      "rel": "引用"
     },
     {
      "from": "S05-2",
      "to": "S11-3",
      "rel": "引用"
     },
     {
      "from": "S11-1",
      "to": "S11-3",
      "rel": "引用"
     },
     {
      "from": "S11-2",
