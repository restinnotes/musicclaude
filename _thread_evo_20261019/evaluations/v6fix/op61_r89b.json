      "to": "S03-2",
      "rel": "引用"
     },
     {
      "from": "S03-1",
      "to": "S03-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S04",
    "bars": "92–115",
    "relation": "正在面对",
    "items": [
     {
      "id": "S04-1",
      "text": "想起那些亲近的时候，他有一阵真盼着一切还能照从前那样继续。",
      "key": "想起那些亲近的时",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S03-2"
      ]
     },
     {
      "id": "S04-2",
      "text": "可这么盼着，他又怀疑当初是不是走错了，却怎么也想不出，要是没走，如今会怎样。",
      "key": "可这么盼着，他又",
      "follows": false,
      "explains": [],
      "cite": [
       "S01-1",
       "S02-2",
       "S04-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-1",
      "to": "S04-1",
      "rel": "引用"
     },
     {
