       "from": [
        "S04-B3-p2"
       ]
      }
     ]
    },
    {
     "rank": "次",
     "kind": "另一侧面",
     "emotion": "悬着",
     "lines": [
      {
       "text": "日子似乎能轻盈些，我又盼长久安稳，却没把握。",
       "keys": [],
       "from": [
        "S04-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "轻轻起舞",
       "keys": [],
       "from": [
        "S04-B4-p1"
       ]
      },
      {
       "text": "希望升起又落空",
