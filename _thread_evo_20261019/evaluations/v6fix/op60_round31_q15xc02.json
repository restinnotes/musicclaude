      "rel": "引用"
     },
     {
      "from": "S05-2",
      "to": "S06-2",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S07",
    "bars": "51–61",
    "relation": "正在面对",
    "items": [
     {
      "id": "S07-1",
      "text": "他渐渐发现，对方不只是接纳他的依恋，也会向他寻求亲近和依靠。",
      "key": "他渐渐发现，对方",
      "follows": false,
      "explains": [],
      "cite": [
       "S06-1",
       "S06-2"
      ]
     },
     {
      "id": "S07-2",
      "text": "他第一次感到自己也成了对方需要的人，这份满足让他更愿意投入，也让他舍不得这种相互需要只停留在眼前。",
      "key": "他第一次感到自己",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1"
      ]
     }
    ],
    "because": [
     {
      "from": "S06-1",
      "to": "S07-1",
      "rel": "引用"
     },
     {
      "from": "S06-2",
