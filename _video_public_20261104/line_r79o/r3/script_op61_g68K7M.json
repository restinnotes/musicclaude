 ],
 "sections": [
  {
   "sec": "S01",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他已经离开那段熟悉的生活，起初还觉得总算不用再一次次委屈自己；开头那下重和弦，像他强迫自己挺直背脊。",
       "keys": [
        "离开那段熟悉的生活",
        "挺直背脊"
       ],
       "from": [
        "S01-1",
        "S01-B2"
       ]
      }
     ],
     "beads": [
      {
       "text": "自由上行的琶音没接住那份重量，反而像烟雾往高处散；也像一次召唤，停顿里还等着回声",
       "keys": [],
       "from": [
        "S01-B1"
       ],
       "bead": "S01-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可这份笃定没撑多久，他心里就空落落的，一时说不清到底舍不得什么。",
       "keys": [
        "空落落",
        "舍不得什么"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "短句像叹息，刚冒出来就被长停顿截断，余音散在冰冷空气里；还分不清这份不平静是愤怒、遗憾还是怀念",
       "keys": [],
       "from": [
        "S01-B3"
       ],
       "bead": "S01-B3"
      },
      {
       "text": "像刚从昏沉中醒来，四周冷而空，胸口发紧；伸手去摸，只有虚空",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "偶尔想起从前熟悉的日子，他还是想往前过，却不知道以后靠什么让自己安下心。",
       "keys": [
        "想往前过",
        "安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旋律轮廓稍稍清楚，旧日的声音、光线和熟悉感忽然回来",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      },
      {
       "text": "波兰舞曲的步态浮现，身体先于意识，隐约记起怎样迈步",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前那些自在的时候，一想到以后不能再像那样过日子，心里就有些慌。",
       "keys": [
        "自在的时候",
        "心里就有些慌"
       ],
       "from": [
        "S02-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "波兰舞曲的步态终于清楚，却不像英雄凯旋；主旋律像远处传来的旧歌，只能模糊哼出几句",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "庄严的舞曲与私人的低声哼唱叠在一起，珍惜的东西仿佛还在，却已不能照旧拥有",
       "keys": [],
       "from": [
        "S02-B1"
       ],
       "bead": "S02-B1"
      },
      {
       "text": "步伐不像士兵，更像腿脚虚浮的人在记忆里挪舞步；庄严节奏托着脆弱旋律，细碎半音在底下蠕动",
       "keys": [],
       "from": [
        "S02-B2"
       ],
       "bead": "S02-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "那份舍不得一上来，他就赶紧提醒自己受过的那些气，怕一心软，连当初为什么要走都忘了。",
       "keys": [
        "提醒自己受过的那些气",
        "为什么要走"
       ],
       "from": [
        "S02-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像整理好衣服、抬起头，不让别人看见动摇；反复对自己说“我没事”，说到后来，连反复说这句话本身都暴露出在意",
       "keys": [],
       "from": [
        "S02-B4"
       ],
       "bead": "S02-B4"
      },
      {
       "text": "音乐猛地往上推，却又退下来",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      },
      {
       "text": "再次聚拢力量，越往后越焦灼；连绵的三连音催得呼吸发急，最后仍没有舒服地落地",
       "keys": [],
       "from": [
        "S02-B3"
       ],
       "bead": "S02-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "可他还是不甘心：难道为了不再受那些气，就得把以前的好日子也一起丢掉吗？",
       "keys": [
        "不甘心",
        "好日子也一起丢掉"
       ],
       "from": [
        "S02-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "激昂像一句“我不甘心就这样消亡”：不是轻松恢复自信，而是负隅顽抗",
       "keys": [],
       "from": [
        "S02-B5"
       ],
       "bead": "S02-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S03",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他心里还憋着一股气，可想起从前和人在一起时，有人把他当作自己人，竟又高兴了一小会儿。",
       "keys": [
        "憋着一股气",
        "高兴了一小会儿"
       ],
       "from": [
        "S03-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "忽强忽弱的起伏和切分节奏让人心里一悬，音乐离开端正步态，转向灵活流动却不安定的方向",
       "keys": [],
       "from": [
        "S03-B1"
       ],
       "bead": "S03-B1"
      },
      {
       "text": "前半段焦躁、急切，像想往前走却始终定不下方向",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      },
      {
       "text": "后来忽然柔和，像故乡夏日的麦浪与微风，也像曾经不必时时防备的亲近",
       "keys": [],
       "from": [
        "S03-B2"
       ],
       "bead": "S03-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那点高兴还没退，他心里就酸了：从前那样的日子过不成了，可离开以后就一定会更好过吗？",
       "keys": [
        "心里就酸了",
        "一定会更好过吗"
       ],
       "from": [
        "S03-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像暂时侧身离开沉重的问题，聊点别的、出去走走；那一刻的轻松是真的，却没有答案",
       "keys": [],
       "from": [
        "S03-B3"
       ],
       "bead": "S03-B3"
      },
      {
       "text": "旋律像多个人在耳边低声絮语，彼此缠绕；调性像流沙，抓不住重心",
       "keys": [],
       "from": [
        "S03-B4"
       ],
       "bead": "S03-B4"
      },
      {
       "text": "前面的昂扬慢慢退潮，心里冒出一句：刚才是真的相信，还是只在努力让自己相信",
       "keys": [],
       "from": [
        "S03-B5"
       ],
       "bead": "S03-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S04",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前亲近的日子，他一度真盼着还能那样相处；熟悉的主题回来，旧记忆也忽然鲜活。",
       "keys": [
        "亲近的日子",
        "还能那样相处"
       ],
       "from": [
        "S04-1",
        "S04-B1"
       ]
      }
     ],
     "beads": [
      {
       "text": "流动的伴奏和装饰音让旋律更像独自说话，带出感激、柔情和短暂的幸福",
       "keys": [],
       "from": [
        "S04-B1"
       ],
       "bead": "S04-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "可那份亲近越鲜活，当初那些委屈也越清楚：那一步走得对不对？没走的话，如今又会怎样？",
       "keys": [
        "当初那些委屈",
        "走得对不对"
       ],
       "from": [
        "S04-2",
        "S04-B4"
       ]
      }
     ],
     "beads": [
      {
       "text": "温暖没有一路带向安稳；后来风暴般紧绷，像记忆太好，好到刺痛",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "半音阶下行又像步步后退，抵抗显得疲惫而仓促",
       "keys": [],
       "from": [
        "S04-B2"
       ],
       "bead": "S04-B2"
      },
      {
       "text": "细碎音符像乱拍的心跳，低音追赶，右手挣扎，身体被催着往前跑",
       "keys": [],
       "from": [
        "S04-B3"
       ],
       "bead": "S04-B3"
      },
      {
       "text": "脑子里反复问：如果当时……是不是还可以……究竟为什么会这样……越赶越停不下来",
       "keys": [],
       "from": [
        "S04-B4"
       ],
       "bead": "S04-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S05",
   "groups": [
    {
     "rank": "主",
     "emotion": "炽热",
     "lines": [
      {
       "text": "他仍不服气，觉得当初那些气不该忍；可连过去开心的事都不敢多想，也太为难自己了。",
       "keys": [
        "仍不服气",
        "过去开心的事"
       ],
       "from": [
        "S05-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌唱忽然柔和亲近，像夜色里两个影子彼此低声说话",
       "keys": [],
       "from": [
        "S05-B1"
       ],
       "bead": "S05-B1"
      },
      {
       "text": "柔和里仍有向前的压力，像在说：这件事不能就这样算了；愤怒、悲伤和维护自己的劲同时在",
       "keys": [],
       "from": [
        "S05-B2"
       ],
       "bead": "S05-B2"
      },
      {
       "text": "旧日记忆重新有了温度，眷恋里也带着失落",
       "keys": [],
       "from": [
        "S05-B3"
       ],
       "bead": "S05-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "跟自己争得没了力气，那股不服气也渐渐淡了；想到自己如今已不在那些人身边，只觉得难受。",
       "keys": [
        "没了力气",
        "只觉得难受"
       ],
       "from": [
        "S05-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "快速音型渐渐放缓、变稀，旋律像脚下的地板忽然不见，只剩一个声音自己说话",
       "keys": [],
       "from": [
        "S05-B4"
       ],
       "bead": "S05-B4"
      },
      {
       "text": "躁动和不安又加深，最后几次深呼吸般的和弦让紧绷松开；不是想通了，而是抵抗得累了",
       "keys": [],
       "from": [
        "S05-B5"
       ],
       "bead": "S05-B5"
      }
     ]
    }
   ]
  },
  {
   "sec": "S06",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "心里那阵难受慢慢缓下来，他又想起从前和人在一起、不必时时防备的时候；这回没急着拿受过的气压住想念。",
       "keys": [
        "慢慢缓下来",
        "压住想念"
       ],
       "from": [
        "S06-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "音乐忽然滑进一片与此前隔开的静谧，像透明玻璃罩住世界，连呼吸都不愿惊动；像摇篮曲般温柔，却不代表现实已经变好",
       "keys": [],
       "from": [
        "S06-B1"
       ],
       "bead": "S06-B1"
      },
      {
       "text": "这里先有近似圣咏的庄严，又像藏在心里的秘密念头；终于不用解释为什么难过，也不必维持坚强，压住的愿望、委屈和思念慢慢浮现",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      },
      {
       "text": "远方忽然被照亮，已经远去的家园在梦里显现",
       "keys": [],
       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "离开以后，遇上难熬的事，他常常只能自己挺过去，这才知道从前有人在身边能让自己轻松多少。",
       "keys": [
        "自己挺过去",
        "轻松多少"
       ],
       "from": [
        "S06-2"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他很想再过上那种不用多说也知道彼此亲近的日子，又怕以后再也没有了。",
       "keys": [
        "不用多说",
        "再也没有了"
       ],
       "from": [
        "S06-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "歌声从含蓄试探渐渐展开，后来更充实、更迫切，临近尾声却像停在一句没说完的话上",
       "keys": [],
       "from": [
        "S06-B3"
       ],
       "bead": "S06-B3"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "安心",
     "lines": [
      {
       "text": "不过，那样的日子自己毕竟真真切切过过，光是这么想着，心里也暖和了一点。",
       "keys": [
        "真真切切过过",
        "暖和了一点"
       ],
       "from": [
        "S06-4"
       ]
      }
     ],
     "beads": [
      {
       "text": "明知有些事挽不回，就放轻声音，好好看着珍惜过的东西，不急着把它抓回来",
       "keys": [],
       "from": [
        "S06-B4"
       ],
       "bead": "S06-B4"
      }
     ]
    }
   ]
  },
  {
   "sec": "S07",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "刚有点安心，他却猛然想到：以后再遇上难事，要还是只能一个人顶着，他真的撑得住吗？",
       "keys": [
        "刚有点安心",
        "撑得住吗"
       ],
       "from": [
        "S07-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "高音颤音像寒风吹开紧闭的窗，后颈一凉，脉搏猛跳，甜梦被拽回严寒",
       "keys": [],
       "from": [
        "S07-B1"
       ],
       "bead": "S07-B1"
      },
      {
       "text": "近乎祈祷的静谧忽然被带马祖卡色彩的舞步截断，像换了一个场景；舞步鲜明，心里未必安定",
       "keys": [],
       "from": [
        "S07-B2"
       ],
       "bead": "S07-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "当初走时他只想着别再受那些气，没料到会这么孤单；早知道这样，自己还会走吗？",
       "keys": [
        "没料到会这么孤单",
        "还会走吗"
       ],
       "from": [
        "S07-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "连续颤音把紧张一层层堆高，思绪翻转不停，想冲出去却找不到出口",
       "keys": [],
       "from": [
        "S07-B3"
       ],
       "bead": "S07-B3"
      },
      {
       "text": "熟悉的动作、舞蹈和日常细节忽然闯进来；越具体，越让人察觉失去了什么",
       "keys": [],
       "from": [
        "S07-B4"
       ],
       "bead": "S07-B4"
      },
      {
       "text": "先前带着宣告意味的舞曲声音又出现，却不再完整鲜明地建立秩序",
       "keys": [],
       "from": [
        "S07-B5"
       ],
       "bead": "S07-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "他想找回从前那份亲近，又不甘心回去再受那些气，可连当初走时那股决心也找不着了。",
       "keys": [
        "找回从前那份亲近",
        "决心也找不着了"
       ],
       "from": [
        "S07-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S08",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "他先把回去的事放一边，想起曾被当作自己人，心里暖了一会儿，却没因此想回头。",
       "keys": [
        "放一边",
        "没因此想回头"
