": \"又怕回去受气\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"fine\": [\n        {\n          \"quote\": \"你刚认出它，还没来得及重新安顿下来，它就又退去了。\",\n          \"carrier\": \"句子节奏\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"那一眼里有温柔，也有不舍。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"它只是瞬间的喘息，并不等于整个人重新安顿下来。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他先不管回不回去\",\n          \"point\": \"想起从前的亲近又暖了心\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"先不管回不回去\"\n        },\n        {\n          \"text\": \"可暖意转眼就淡了\",\n          \"point\": \"回忆也不能替他分担难处\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"也不能\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"声音短暂落稳，又向高处漂去，刚有的一点稳定感随即散掉\",\n          \"carrier\": \"副词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"像是从另一面重新看见了同一扇门\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"最初的问题又浮上来，却没有因此得到一个简单的答案。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他想回去\",\n          \"point\": \"是舍不得从前，还是难过时想有人陪\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"还是\"\n        },\n        {\n          \"text\": \"这念头吓得他\",\n          \"point\": \"不敢再往下想\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"吓得\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"fine\": [\n        {\n          \"quote\": \"熟悉的声音只是轻轻地、断断续续地浮现，像几块碎片。\",\n          \"carrier\": \"副词\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"只是这次变成了F小调。\",\n          \"carrier\": \"具体的事\",\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"明明知道它很重要，却已经没有力气把它重新讲述一遍。\",\n          \"carrier\": \"身体感觉\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他最舍不得的\",\n          \"point\": \"有人把他当自己人\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"最舍不得的\"\n        },\n        {\n          \"text\": \"可回去未必如从前\",\n          \"point\": \"回去未必如从前\",\n          \"where\": \"前\",\n          \"waste\": \"\",\n          \"keep\": \"那些委屈也不能当没发生\"\n        },\n        {\n          \"text\": \"反复想了很久\",\n          \"point\": \"仍没答案\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"日子也过不踏实\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"fine\": [\n        {\n          \"quote\": \"每次爆发之后，紧张都没有完全解除，反而又形成新的压力。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"祈祷开始变成意志。\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"不是问题解决了，而是停滞本身松开了一点。\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"可一