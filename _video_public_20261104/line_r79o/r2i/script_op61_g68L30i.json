       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "孤单",
     "lines": [
      {
       "text": "可他还得挺住，心里却等不到回声，其实也很想停下来",
       "keys": [
        "其实也很想停下来"
       ],
       "from": [
        "S01-1"
       ]
      }
     ],
     "beads": []
    },
    {
     "rank": "次",
     "emotion": "悬着",
     "lines": [
      {
       "text": "分不清是在气、在悔还是在想念",
       "keys": [
        "是在气、在悔还是在想念"
       ],
       "from": [
        "S01-2"
       ]
      }
     ],
     "beads": [
      {
       "text": "像从昏沉中醒来，四周又冷又空，胸口发紧、伸手只摸到空处",
       "keys": [],
       "from": [
        "S01-B4"
       ],
       "bead": "S01-B4"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "亲密",
     "lines": [
      {
       "text": "偶尔，熟悉的旧日场景会忽然浮现，连身体都像记起从前怎样迈步",
       "keys": [
        "记起从前怎样迈步"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": [
      {
       "text": "旧日子里的声音和光线，忽然又回到了眼前",
       "keys": [],
       "from": [
        "S01-B5"
       ],
       "bead": "S01-B5"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他还想往前过，却不知道以后靠什么才能安下心",
       "keys": [
        "不知道以后靠什么才能安下心"
       ],
       "from": [
        "S01-3"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S02",
   "groups": [
    {
     "rank": "主",
     "emotion": "不安",
     "lines": [
      {
       "text": "他舍不得从前自在的日子，仿佛还能听见却不能再照旧拥有",
