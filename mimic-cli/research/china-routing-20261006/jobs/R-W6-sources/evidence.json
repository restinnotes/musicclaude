  "claims": [
    {
      "claim_id": "RA01",
      "claim": "As of 2026-10-06, ordinary commercial shipments cannot rely on the former $800 Section 321(c) duty-free model; non-postal and postal suspensions are in force, with separate postal-process effective dates, and statutory repeal is scheduled for 2027-07-01.",
      "source_ids": [
        "S01",
        "S02",
        "S03",
        "S05",
        "S06"
      ]
    },
    {
      "claim_id": "RA02",
      "claim": "Tariff liability must be calculated from the frozen product's current HTS classification, origin and entry date: Column 1 General/NTR where applicable, plus any applicable Chapter 99 measures and exclusions. China's 2026 forced-labor Section 301 action uses 9903.05.31 with specified exemptions; legacy China technology-transfer Section 301 exclusions remain active through 2026-11-10. No blanket China tariff percentage is supportable.",
      "source_ids": [
        "S15",
        "S16",
        "S17",
        "S18"
      ]
    },
    {
      "claim_id": "RA03",
      "claim": "Purchaser/title, customs IOR and duty liability, customs-broker activity, and transport-only possession are distinct roles. Physical consolidation or rate negotiation alone does not establish IOR, while no-title CPSA logistics protection is not a general immunity.",
      "source_ids": [
        "S04",
        "S07",
        "S08",
        "S12"
      ]
    },
    {
      "claim_id": "RA04",
      "claim": "CPSC eFiling became effective 2026-07-08 for imported products subject to certification, but customs IOR and CPSC certificate-responsible party may differ when a licensed broker is IOR; a personal-use consumer is only 'not typically' treated as the certification importer.",
      "source_ids": [
        "S09",
        "S10",
        "S11"
      ]
    },
    {
      "claim_id": "RA05",
      "claim": "FCC marketing exposure is distinct from customs IOR. The 2026 marketplace-specific amendment published 2026-09-11 was not effective on the audit date; it becomes effective 2026-10-13, with FCC-ID display compliance dates in 2027.",
      "source_ids": [
        "S13",
        "S14"
      ]
    }
  ],
  "data_gaps": [
    {
      "gap": "Authenticated route-level documents identifying purchaser/title holder, owner, consignee, customs IOR, broker/POA, bond principal, duty payer and CPSC certificate-responsible party for Superbuy/Sugargoo/BuckyDrop U.S. routes.",
      "status": "AUTHENTICATED_DATA_REQUIRED"
    },
