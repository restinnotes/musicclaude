       "from": [
        "S12-2"
       ]
      }
     ],
     "beads": []
    }
   ]
  },
  {
   "sec": "S13",
   "groups": [
    {
     "rank": "主",
     "emotion": "亲密",
     "lines": [
      {
       "text": "想起从前自然亲近的日子，他心里又热了起来，也盼着以后还能那样相处。",
       "keys": [
        "心里又热了起来",
        "盼着以后还能那样相处"
       ],
       "from": [
        "S13-1"
       ]
      }
     ],
     "beads": [
      {
       "text": "柔软歌唱重新出现",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "像私下安慰",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "近乎祈祷",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "被带进宏大的音响",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "像温柔的歌站到明亮处",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "如管风琴般庄严",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "密集音符像狂飙激流",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "向天空喷涌",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "仿佛心脏以最高负荷跳动",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "还可以想到故土",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      },
      {
       "text": "共同记忆和希望",
       "keys": [],
       "from": [
        "S13-B1"
       ],
       "bead": "S13-B1"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "炽热",
     "lines": [
      {
       "text": "这么想着，他有了劲头，想把往后的日子好好过起来，不再整天跟从前的事较劲。",
       "keys": [
