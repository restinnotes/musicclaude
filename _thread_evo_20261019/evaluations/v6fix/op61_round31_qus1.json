      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S09",
    "bars": "214–215",
    "relation": "正在面对",
    "items": [
     {
      "id": "S09-1",
      "text": "熟悉的空落又沉回来，他刚觉得自己好像能承受，心里那点安稳便又散了。",
      "key": "熟悉的空落又沉回",
      "follows": false,
      "explains": [],
      "cite": [
       "S08-2",
       "S06-2"
      ]
     },
     {
      "id": "S09-2",
      "text": "那个老问题也跟着浮出来：离开以后，他还会不会有地方能自然地属于？这次它带着更重的分量，一阵短促的惊惶过去，仍没有答案。",
      "key": "那个老问题也跟着",
      "follows": false,
      "explains": [],
      "cite": [
       "S07-1",
       "S09-1"
      ]
     }
    ],
    "because": [
     {
