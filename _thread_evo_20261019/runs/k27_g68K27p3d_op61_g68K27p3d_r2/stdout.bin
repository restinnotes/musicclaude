{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他离开了熟悉的生活，起初觉得总算不用再委屈自己\",\n          \"accent\": \"不用再委屈自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可这份笃定没撑多久，心里很快空落落的\",\n          \"accent\": \"空落落的\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-2\"],\n          \"at\": 42\n        },\n        {\n          \"text\": \"他还想往前过，却不知道以后靠什么安下心\",\n          \"accent\": \"不知道以后靠什么安下心\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-3\"],\n          \"at\": 85\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像逼自己挺直背脊，尊严还在却没力气\",\n          \"after\": 0,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–23\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"我不能倒下，可我其实很想停下来\",\n          \"after\": 0,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1–23\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"还分不清这份不平静是愤怒、遗憾还是怀念\",\n          \"after\": 1,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–23\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"心里有东西，却还说不清是什么\",\n          \"after\": 1,\n          \"from\": [\"S01-B3\"],\n          \"bars\": \"1–23\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"胸口发紧，眼前模糊，伸手只摸到虚空\",\n          \"after\": 1,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"1–23\",\n          \"at\": 34\n        },\n        {\n          \"text\": \"像刚从昏沉里醒来，四周冷而空\",\n          \"after\": 1,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"1–23\",\n          \"at\": 42\n        },\n        {\n          \"text\": \"这还不是哭出来的悲伤，更像恍惚\",\n          \"after\": 1,\n          \"from\": [\"S01-B4\"],\n          \"bars\": \"1–23\",\n          \"at\": 50\n        },\n        {\n          \"text\": \"一时说不清到底舍不得什么\",\n          \"after\": 1,\n          \"from\": [\"S01-2\"],\n          \"bars\": \"\",\n          \"at\": 58\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"开头重和弦后，琶音像烟雾散开，声音轻而悬远\",\n          \"from\": [\"S01-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"1–6\"\n        },\n        {\n          \"text\": \"停顿像一声召唤后，仍等着回声\",\n          \"from\": [\"S01-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"1–6\"\n        },\n        {\n          \"text\": \"短句像叹息，余音在冷空气里散尽\",\n          \"from\": [\"S01-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"1–23\"\n        },\n        {\n          \"text\": \"9–17旧场景连声音和光线都回来\",\n          \"from\": [\"S01-B5\"],\n          \"pt\": \"\",\n          \"bars\": \"9–17\"\n        },\n        {\n          \"text\": \"18–23身体先记起舞步，主题到24才站稳\",\n          \"from\": [\"S01-B5\"],\n          \"pt\": \"\",\n          \"bars\": \"18–23\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"他舍不得从前那些自在日子，一想到以后不能那样过就心慌\",\n          \"accent\": \"舍不得\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"一心软，他就想起受过的气，怕忘了当初为什么离开\",\n          \"accent\": \"受过的气\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 27\n        },\n        {\n          \"text\": \"可他不甘心，难道不再受气就得把好日子也丢掉吗？\",\n          \"accent\": \"好日子也丢掉吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 56\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"不像凯旋，更像熟悉却哼不全的旧歌\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"珍惜的东西仿佛还在，却不能像从前那样拥有\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"24–65\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"像腿脚虚浮的人，在记忆里挪动舞步\",\n          \"after\": 0,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"24–65\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"他整理好衣服抬起头，不让人看见动摇\",\n          \"after\": 1,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"24–65\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"第一遍说我没事，还像真的相信\",\n          \"after\": 1,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"44–65\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"第二遍开始逼自己信，第三遍露出在意\",\n          \"after\": 1,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"44–65\",\n          \"at\": 42\n        },\n        {\n          \"text\": \"心里还有句：不甘心就这样消亡\",\n          \"after\": 2,\n          \"from\": [\"S02-B5\"],\n          \"bars\": \"44–65\",\n          \"at\": 60\n        },\n        {\n          \"text\": \"那不是轻松恢复自信，是在硬撑着抵抗\",\n          \"after\": 2,\n          \"from\": [\"S02-B5\"],\n          \"bars\": \"44–65\",\n          \"at\": 68\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"舞步带着庄严，歌声像私下哼唱\",\n          \"from\": [\"S02-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"节奏庄严傲慢，旋律脆弱凄婉，伴奏半音蠕动\",\n          \"from\": [\"S02-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"24–65\"\n        },\n        {\n          \"text\": \"38–43猛地上推又退下\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"38–43\"\n        },\n        {\n          \"text\": \"44–65重新聚力，52–63一带更焦灼\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"44–65\"\n        },\n        {\n          \"text\": \"56–65三连音把呼吸催得越来越急\",\n          \"from\": [\"S02-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"56–65\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他心里还憋着一股气\",\n          \"accent\": \"憋着一股气\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可想起曾被当作自己人，他又短暂地高兴起来\",\n          \"accent\": \"短暂地高兴起来\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 10\n        },\n        {\n          \"text\": \"那点高兴一退，他就发酸：离开后真会更好吗？\",\n          \"accent\": \"离开后真会更好吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 23\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"想往前走，心里却定不下方向\",\n          \"after\": 0,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"66–91\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像故乡夏日的麦浪和微风\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"66–91\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"越怀念越能感觉它离眼前很远\",\n          \"after\": 1,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"66–91\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"那样的日子已经过不成了\",\n          \"after\": 2,\n          \"from\": [\"S03-2\"],\n          \"bars\": \"\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"像暂时出去走走，先避开眼前的伤口\",\n          \"after\": 1,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"66–91\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"那一刻的轻松是真的，却没解决心事\",\n          \"after\": 1,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"66–91\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"像几个人在耳边低声絮语，找不到出口\",\n          \"after\": 2,\n          \"from\": [\"S03-B4\"],\n          \"bars\": \"66–91\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"他怀疑刚才是真的相信，还是努力让自己相信\",\n          \"after\": 2,\n          \"from\": [\"S03-B5\"],\n          \"bars\": \"66–91\",\n          \"at\": 34\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"66和弦若突出像重锤，切分起伏让心悬\",\n          \"from\": [\"S03-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"66–79焦躁，80–91忽然柔和轻盈\",\n          \"from\": [\"S03-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"66–91\"\n        },\n        {\n          \"text\": \"调性像流沙，抓不住重心\",\n          \"from\": [\"S03-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"66–91\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"想起从前亲近的日子，他真盼着还能那样相处\",\n          \"accent\": \"盼着还能那样相处\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可越想越鲜活，当初的委屈也跟着翻上来\",\n          \"accent\": \"委屈\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-2\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"他反复问自己当初该不该走，若没走又会怎样？\",\n          \"accent\": \"该不该走\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-2\"],\n          \"at\": 28\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"那段回忆里有感激、柔情和短暂的幸福\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–107\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"熟悉姿态回来了，心里却更柔软易伤\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–115\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"那份坚定更像他想成为的样子\",\n          \"after\": 0,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"92–115\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"记忆越美好，越让他感到刺痛\",\n          \"after\": 1,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"92–115\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"脑子里反复转着如果当初、是不是还可以\",\n          \"after\": 2,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94–115\",\n          \"at\": 25\n        },\n        {\n          \"text\": \"他不停往前赶，只是不敢停下来\",\n          \"after\": 2,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94–115\",\n          \"at\": 31\n        },\n        {\n          \"text\": \"思绪绕来绕去，始终没能抵达答案\",\n          \"after\": 2,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"94–115\",\n          \"at\": 36\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"92–107主题回返，伴奏流动、装饰音更抒情\",\n          \"from\": [\"S04-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"92–107\"\n        },\n        {\n          \"text\": \"108–115忽然风暴般紧绷，半音阶一路下行\",\n          \"from\": [\"S04-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"108–115\"\n        },\n        {\n          \"text\": \"细碎音符像急脚步，低音追赶右手挣扎\",\n          \"from\": [\"S04-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"92–115\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"他仍不服气，觉得当初那些气根本不该忍\",\n          \"accent\": \"根本不该忍\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可连过去开心的事都不敢多想，也太为难自己了\",\n          \"accent\": \"也太为难自己了\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-1\"],\n          \"at\": 23\n        },\n        {\n          \"text\": \"争到没力气后不服气渐渐淡去，只剩离开他们的难受\",\n          \"accent\": \"只剩离开他们的难受\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 46\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像夜色里两个影子，彼此低声说话\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"116–147\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"心里还有股劲：这件事不能就这样算了\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116–127\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"愤怒和悲伤里，也有想维护自己的劲\",\n          \"after\": 0,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"116–127\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"可能是某个人，也可能是故乡或旧生活\",\n          \"after\": 1,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116–147\",\n          \"at\": 27\n        },\n        {\n          \"text\": \"眷恋里也带着失落\",\n          \"after\": 2,\n          \"from\": [\"S05-B3\"],\n          \"bars\": \"116–147\",\n          \"at\": 34\n        },\n        {\n          \"text\": \"像脚下地板忽然不见，只剩一个声音\",\n          \"after\": 1,\n          \"from\": [\"S05-B4\"],\n          \"bars\": \"128–147\",\n          \"at\": 40\n        },\n        {\n          \"text\": \"那几口深呼吸，只让紧绷暂时松开\",\n          \"after\": 2,\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"132–147\",\n          \"at\": 52\n        },\n        {\n          \"text\": \"他只是抵抗累了，心里未必平静\",\n          \"after\": 2,\n          \"from\": [\"S05-B5\"],\n          \"bars\": \"132–147\",\n          \"at\": 58\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"116起语气转柔，两手像夜里低声私语\",\n          \"from\": [\"S05-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"116–147\"\n        },\n        {\n          \"text\": \"116–127柔和歌唱里仍有向前的压力\",\n          \"from\": [\"S05-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"116–127\"\n        },\n        {\n          \"text\": \"128起快速音型渐稀，最后化成慢和弦\",\n          \"from\": [\"S05-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"128–147\"\n        },\n        {\n          \"text\": \"128–129、139–144旋律几乎单独露出\",\n          \"from\": [\"S05-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"128–147\"\n        },\n        {\n          \"text\": \"132后不安加深，144–147像几次深呼吸\",\n          \"from\": [\"S05-B5\"],\n          \"pt\": \"\",\n          \"bars\": \"132–147\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"心里的难受慢慢缓下来，他又想起从前轻松相处的日子\",\n          \"accent\": \"难受慢慢缓下来\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"那时身边有人，他不用时时防备\",\n          \"accent\": \"不用时时防备\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-2\"],\n          \"at\": 17\n        },\n        {\n          \"text\": \"他很想再过那种不用多说也懂得亲近的日子\",\n          \"accent\": \"不用多说也懂得亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-3\"],\n          \"at\": 34\n        },\n        {\n          \"text\": \"可他怕以后再也遇不到那样的亲近\",\n          \"accent\": \"再也遇不到\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-3\"],\n          \"at\": 52\n        },\n        {\n          \"text\": \"不过他毕竟真真切切拥有过，想起时心里暖了一点\",\n          \"accent\": \"心里暖了一点\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-4\"],\n          \"at\": 70\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像隔着透明玻璃，连呼吸都不想惊动\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"像母亲在耳边轻轻哼着摇篮曲\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"这份安宁不等于现实已经变好\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"148–180\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"他终于不用解释难过，也不用装作坚强\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\",\n          \"at\": 23\n        },\n        {\n          \"text\": \"压住的愿望、委屈和思念终于浮上来\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"他向远方祈求，愿望真切却没人保证会回应\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"148–180\",\n          \"at\": 39\n        },\n        {\n          \"text\": \"这回他没拿受过的气压住想念\",\n          \"after\": 0,\n          \"from\": [\"S06-1\"],\n          \"bars\": \"\",\n          \"at\": 46\n        },\n        {\n          \"text\": \"明知有些事挽不回，就轻轻看着它\",\n          \"after\": 4,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"148–180\",\n          \"at\": 74\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"148起忽然换境，绵长声音近乎停驻\",\n          \"from\": [\"S06-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"近似圣咏的庄严，旋律像心底秘密\",\n          \"from\": [\"S06-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"148–180\"\n        },\n        {\n          \"text\": \"148–151含蓄试探，152–167歌唱展开\",\n          \"from\": [\"S06-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"148–167\"\n        },\n        {\n          \"text\": \"168–180更充实迫切，像话没说完\",\n          \"from\": [\"S06-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"168–180\"\n        },\n        {\n          \"text\": \"约160小节，远方家园在梦里短暂显现\",\n          \"from\": [\"S06-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"约160\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"刚有点安心，他就想到以后遇上难事还得独自扛\",\n          \"accent\": \"独自扛\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"当初只想着别再受气，没想到会这么孤单\",\n          \"accent\": \"这么孤单\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S07-2\"],\n          \"at\": 20\n        },\n        {\n          \"text\": \"他想找回亲近却不甘心回去受气，离开时的决心也弱了\",\n          \"accent\": \"离开时的决心也弱了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S07-3\"],\n          \"at\": 42\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"后颈一凉，脉搏也跟着猛跳\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"梦一下碎了，身体先一步惊醒\",\n          \"after\": 0,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"182附近\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"像突然换了场景，刚才的思路被截断\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182–197\",\n          \"at\": 22\n        },\n        {\n          \"text\": \"新舞步很鲜明，心里却未必安定\",\n          \"after\": 1,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"182–197\",\n          \"at\": 30\n        },\n        {\n          \"text\": \"紧张还在盘旋，想冲出去却找不到出口\",\n          \"after\": 2,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"198–205\",\n          \"at\": 40\n        },\n        {\n          \"text\": \"熟悉的动作、舞步和旧日生活闯进来\",\n          \"after\": 1,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181–205\",\n          \"at\": 48\n        },\n        {\n          \"text\": \"越熟悉，越知道自己失去了什么\",\n          \"after\": 1,\n          \"from\": [\"S07-B4\"],\n          \"bars\": \"181–205\",\n          \"at\": 55\n        },\n        {\n          \"text\": \"早知道会这么孤单，他还会走吗？\",\n          \"after\": 1,\n          \"from\": [\"S07-2\"],\n          \"bars\": \"\",\n          \"at\": 59\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"182附近高音长颤音，像寒风猛地掀窗\",\n          \"from\": [\"S07-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"182附近\"\n        },\n        {\n          \"text\": \"182–197马祖卡舞步突然闯入\",\n          \"from\": [\"S07-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"舞蹈材料截断祈祷般的静谧\",\n          \"from\": [\"S07-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"182–197\"\n        },\n        {\n          \"text\": \"198–205连续颤音，紧张一层层累积\",\n          \"from\": [\"S07-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"198–205\"\n        },\n        {\n          \"text\": \"波兰舞曲气息重现，却不再完整鲜明\",\n          \"from\": [\"S07-B5\"],\n          \"pt\": \"\",\n          \"bars\": \"182–197\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"他先把回去的事放在一边\",\n          \"accent\": \"放在一边\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想起曾被当作自己人，他心里暖了\",\n          \"accent\": \"心里暖了\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"那点暖意很快淡了\",\n          \"accent\": \"很快淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S08-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"回忆陪不了他面对以后，心又悬起来\",\n          \"accent\": \"心又悬起来\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-2\"],\n          \"at\": 13\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"那份熟悉的柔软处又短暂打开\",\n          \"after\": 1,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"206–213\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像离开前又回头看一眼刚待过的地方\",\n          \"after\": 2,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"206–213\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"那一眼里有温柔，也有不舍\",\n          \"after\": 2,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"206–213\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"胸口忽然吸进一口气，只是瞬间喘息\",\n          \"after\": 3,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"206–213\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"那口气没能让他重新安顿下来\",\n          \"after\": 3,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"206–213\",\n          \"at\": 17\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"206–213缓慢宽广的歌唱短暂回来\",\n          \"from\": [\"S08-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"206–213\"\n        },\n        {\n          \"text\": \"安静刚被认出来，就很快退去了\",\n          \"from\": [\"S08-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"206–213\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他忽然分不清，自己是舍不得那份亲近还是怕孤单\",\n          \"accent\": \"舍不得那份亲近\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"这念头让他心慌，连往下想都不敢了\",\n          \"accent\": \"连往下想都不敢了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 17\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"像重新遇见那个不知怎么办的自己\",\n          \"after\": 0,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–225\",\n          \"at\": 5\n        },\n        {\n          \"text\": \"这回他知道那个自己经历过什么\",\n          \"after\": 0,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–225\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"最初的问题又浮上来，还是没有简单答案\",\n          \"after\": 1,\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"214–225\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"甚至怕孤单到愿意再受那些气\",\n          \"after\": 0,\n          \"from\": [\"S09-1\"],\n          \"bars\": \"\",\n          \"at\": 20\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"214–215双手铺开巨大的颤音光晕\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"214–215\"\n        },\n        {\n          \"text\": \"开头沉重姿态阴冷闪回，落稳后又漂起\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"214–215\"\n        },\n        {\n          \"text\": \"引子回返，却不再像最初那样郑重召唤\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"214–215\"\n        },\n        {\n          \"text\": \"像从另一面重新看见那扇门，前进步伐未聚\",\n          \"from\": [\"S09-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"214–215\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他慢慢觉得，最舍不得的是曾被当作自己人的日子\",\n          \"accent\": \"最舍不得\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"可就算回去，还能像从前那样吗？\",\n          \"accent\": \"还能像从前那样吗\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-1\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"当初的委屈没法抹掉，光凭想念他不敢回去\",\n          \"accent\": \"光凭想念他不敢回去\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S10-2\"],\n          \"at\": 14\n        },\n        {\n          \"text\": \"他想得筋疲力尽仍没答案，眼下也不踏实\",\n          \"accent\": \"筋疲力尽\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S10-3\"],\n          \"at\": 21\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"如歌旋律和舞曲都只剩零碎片段\",\n          \"after\": 0,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216–225\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像摇篮曲碎了，变成F小调的哀婉\",\n          \"after\": 0,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"216–225\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"整个人忽然失重，悬在半空\",\n          \"after\": 3,\n          \"from\": [\"S10-B2\"],\n          \"bars\": \"221–225\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"那个问题又回来：以后究竟怎么生活？\",\n          \"after\": 3,\n          \"from\": [\"S10-B3\"],\n          \"bars\": \"216–225\",\n          \"at\": 17\n        },\n        {\n          \"text\": \"明明很重要，却已经没有力气重说一遍\",\n          \"after\": 3,\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"216–225\",\n          \"at\": 23\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"216–225没有完整旋律，熟悉声音断续浮现\",\n          \"from\": [\"S10-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"216–225\"\n        },\n        {\n          \"text\": \"221–225听感失重，方向和着落都模糊\",\n          \"from\": [\"S10-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"221–225\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"回去未必找得回亲近，他还是忍不住想万一呢？\",\n          \"accent\": \"万一呢\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他不愿只凭这点盼头，回去继续忍让\",\n          \"accent\": \"不愿只凭这点盼头\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-2\"],\n          \"at\": 7\n        },\n        {\n          \"text\": \"他怕以后独自扛事，仍决定先把眼下过稳\",\n          \"accent\": \"先把眼下过稳\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-3\", \"S11-4\"],\n          \"at\": 14\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"每次爆发后，紧张都没完全散开\",\n          \"after\": 2,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226–241\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"像困兽一次次顶住，再用力\",\n          \"after\": 2,\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"226–241\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"步子从试探慢慢聚拢，开始向前\",\n          \"after\": 2,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"226–241\",\n          \"at\": 10\n        },\n        {\n          \"text\": \"柔软的祈祷慢慢变成迈步的意志\",\n          \"after\": 2,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"226–241\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"心里仍怕，脚却已经往前走\",\n          \"after\": 2,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"226–241\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"不是问题解决了，是停滞松开一点\",\n          \"after\": 2,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"226–241\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"他心里仍没多少底\",\n          \"after\": 2,\n          \"from\": [\"S11-4\"],\n          \"bars\": \"\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"226起低音滚动，右手和弦像重锤砸下\",\n          \"from\": [\"S11-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"226–241\"\n        },\n        {\n          \"text\": \"226–229试探，238–241向上积聚\",\n          \"from\": [\"S11-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"226–241\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"当初那些气不该忍，从前的开心也是真的\",\n          \"accent\": \"从前的开心也是真的\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他不再逼自己非得选一边\",\n          \"accent\": \"不再逼自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他怕以后一个人熬，却不愿只为有人陪就回头\",\n          \"accent\": \"不愿只为有人陪就回头\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S12-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"他不怪自己离开，愿意带着想念继续过日子\",\n          \"accent\": \"带着想念继续过日子\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S12-2\"],\n          \"at\": 18\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"想起那些好时候，他还是会心软\",\n          \"after\": 0,\n          \"from\": [\"S12-2\"],\n          \"bars\": \"\",\n          \"at\": 3\n        },\n        {\n          \"text\": \"这股昂扬也像面向众人的公开姿态\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"242–253\",\n          \"at\": 7\n        },\n        {\n          \"text\": \"甚至带着一点集体的气势\",\n          \"after\": 0,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"242–253\",\n          \"at\": 11\n        },\n        {\n          \"text\": \"即使犹疑疲惫、心里想念，他仍能决定怎样站\",\n          \"after\": 1,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"242–253\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"他不必装作自己从来没受过伤\",\n          \"after\": 3,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"242–253\",\n          \"at\": 20\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"242起主题以雷鸣般声势轰然回归\",\n          \"from\": [\"S12-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"242–253\"\n        },\n        {\n          \"text\": \"249–253色彩忽变，脚步像短暂踩斜\",\n          \"from\": [\"S12-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"249–253\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"从前那些亲近的日子让他心里发热，他也盼着以后还能这样相处\",\n          \"accent\": \"心里发热\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他有了劲，想好好过日子不再跟过去较劲\",\n          \"accent\": \"好好过日子\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-2\"],\n          \"at\": 12\n        },\n        {\n          \"text\": \"可他怕还要等很久，才能再遇见亲近的人\",\n          \"accent\": \"等很久\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-3\"],\n          \"at\": 24\n        },\n        {\n          \"text\": \"若再有人把他当自己人，他会好好珍惜\",\n          \"accent\": \"好好珍惜\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-4\"],\n          \"at\": 38\n        },\n        {\n          \"text\": \"等不到也愿自己好好过，不为留人咽委屈\",\n          \"accent\": \"不为留人咽委屈\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S13-4\"],\n          \"at\": 49\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"柔软的歌声在宏大音响里亮起来，像管风琴\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254–270\",\n          \"at\": 4\n        },\n        {\n          \"text\": \"也让人想到故土、共同记忆和希望\",\n          \"after\": 0,\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"254–270\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"八度疾驰像气流推着人跑，兴奋得喘不过气\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\"],\n          \"bars\": \"269–280\",\n          \"at\": 14\n        },\n        {\n          \"text\": \"刚建立的成功又被轻轻问了一句：稳了吗？\",\n          \"after\": 2,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"281–287\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"也可能只是事情说完，终于能喘口气\",\n          \"after\": 2,\n          \"from\": [\"S13-B3\"],\n          \"bars\": \"281–287\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"劲头稍缓，心里渐渐静下来\",\n          \"after\": 2,\n          \"from\": [\"S13-3\"],\n          \"bars\": \"\",\n          \"at\": 36\n        },\n        {\n          \"text\": \"最后的高音可以听成一个决定\",\n          \"after\": 4,\n          \"from\": [\"S13-B5\"],\n          \"bars\": \"286–288\",\n          \"at\": 42\n        },\n        {\n          \"text\": \"也可以听成从梦里忽然醒来\",\n          \"after\": 4,\n          \"from\": [\"S13-B5\"],\n          \"bars\": \"286–288\",\n          \"at\": 50\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"254–270柔软歌唱进入开阔宏大音响\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"254–270\"\n        },\n        {\n          \"text\": \"密集音符像激流喷涌，心跳到最高负荷\",\n          \"from\": [\"S13-B1\"],\n          \"pt\": \"\",\n          \"bars\": \"254–270\"\n        },\n        {\n          \"text\": \"269附近快速八度明亮疾驰，能量释放\",\n          \"from\": [\"S13-B2\"],\n          \"pt\": \"\",\n          \"bars\": \"269–280\"\n        },\n        {\n          \"text\": \"281–285收敛，颤动装饰音带来不安\",\n          \"from\": [\"S13-B3\"],\n          \"pt\": \"\",\n          \"bars\": \"281–287\"\n        },\n        {\n          \"text\": \"低音两记耳语和弦，高音如寒星清脆如钟，结尾不必更猛\",\n          \"from\": [\"S13-B4\"],\n          \"pt\": \"\",\n          \"bars\": \"末尾几小节\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "374fb351-f