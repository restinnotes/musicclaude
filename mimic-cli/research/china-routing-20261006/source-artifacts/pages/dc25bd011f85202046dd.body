      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-bottom: 25px;
    }

    .store-item:hover {
      box-shadow: 0 3px 8px 0 rgba(36, 52, 63, 0.22);
    }

    .store-item .img-wrap {
      max-height: 55px;
      max-width: 126px;
      height: 55px;
      width: 111px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .store-item .img-wrap img {
      max-height: 55px;
      max-width: 111px;
    }

    .popup-tip {
      z-index: 10;
      position: absolute;
      top: 18px;
      right: 18px;
      padding: 19px 22px 30px 31px;
      border-radius: 10px;
      box-shadow: 0 3px 10px 0 rgba(0, 0, 0, 0.16);
      background-color: #ffffff;
      max-width: 340px;
    }

    .main-top {
      margin-top: 160px;
    }

    .main {
      background-color: #fff;
    }

    .login-pop-tip {
      position: fixed;
      width: 492px;
      height: 266px;
      top: 250px;
      left: 50%;
      margin-left: -246px;
      border-radius: 10px;
      box-shadow: 0 3px 30px 0 rgba(36, 52, 63, 0.3);
      background-color: #ffffff;
      padding: 60px 22px 20px;
      z-index: 100;
    }

    .full-header {
      width: 100%;
      background-image: linear-gradient(69deg, #7c66ef 19%, #10d9e6 81%);
    }

    .install-btn {
      padding: 12px 50px 11px;
      border-radius: 15px;
      box-shadow: 0 5px 10px 0 rgba(36, 52, 63, 0.1);
      background-color: #24343f;
      column-gap: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      width: -moz-fit-content;
      cursor: pointer;
      color: #fff;
    }

    .install-btn:hover {
      box-shadow: 0 5px 10px 0 rgba(36, 52, 63, 0.3);
    }

    .install-btn * {
      color: #fff;
      font-size: 20px;
    }

    #close-login-tip-x {
      position: absolute;
      top: 10px;
      right: 10px;
    }

    #close-login-tip-x:hover {
      border-radius: 50px;
      background-color: rgba(16, 40, 65, 0.08);
    }

    @media only screen and (max-width: 576px) {
      .store-item {
        width: 160px;
        padding-left: 30px;
        padding-right: 30px;
      }

      .store-item .img-wrap {
        width: 98px;
      }

      .main-top {
        margin-top: 40px;
      }

      .container {
        padding-left: 20px;
        padding-right: 20px;
      }

      .head {
        min-height: 56px;
      }

      .mobile-gap {
        gap: 10px !important;
      }
    }
  </style>
