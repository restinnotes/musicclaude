       "from": [
        "S06-B2"
       ],
       "bead": "S06-B2"
      }
     ]
    },
    {
     "rank": "次",
     "emotion": "不安",
     "lines": [
      {
       "text": "他很想再过上那种不用多说也知道彼此亲近的日子，又怕以后再也没有了",
