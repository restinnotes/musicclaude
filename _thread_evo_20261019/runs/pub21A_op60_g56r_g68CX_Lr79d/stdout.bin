,\n          \"screen\": \"变粗\",\n          \"matter\": \"小\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"正当你以为它还会继续唱下去，它却戛然而止\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"变粗\",\n          \"matter\": \"大\",\n          \"fix\": \"以为还会唱，却戛然而止\"\n        },\n        {\n          \"quote\": \"快乐的余温尚在，心头却已泛起一阵怀念\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"见对方依然愿意\",\n          \"point\": \"大大方方地回应\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"见对方依然愿意和自己亲近\"\n        },\n        {\n          \"text\": \"两人相处得这么好\",\n          \"point\": \"心里就没底\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"可一想到以后\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"fine\": [\n        {\n          \"quote\": \"强烈的渴望还在，却引而不发，那股绷紧的劲尚未真正松开\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"四周并未彻底暗下去，更像阳光被薄雾柔化——光还在，只是隔了一层朦胧的雾气\",\n          \"carrier\": \"比喻画面\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        },\n        {\n          \"quote\": \"心里的不安还没有得到回答，却暂时不再占据全部心思\",\n          \"carrier\": \"连接转折\",\n          \"screen\": \"在\",\n          \"matter\": \"大\",\n          \"fix\": \"\"\n        }\n      ],\n      \"lines\": [\n        {\n          \"text\": \"他一想到对方有一天\",\n          \"point\": \"不再需要他陪伴\",\n          \"where\": \"中\",\n          \"waste\": \"\",\n          \"keep\": \"有一天\"\n        },\n        {\n          \"text\": \"他一下安静下来\",\n          \"point\": \"连往后都不敢再想\",\n          \"where\": \"后\",\n          \"waste\": \"\",\n          \"keep\": \"一下安静下来\"\n        },\n        {\n          \"text\": \"可眼下对方还愿意\",\n          \"p