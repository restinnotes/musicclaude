 ]\n        }\n      ],\n      \"free_beads\": []\n    },\n    {\n      \"bars\": \"17–23\",\n      \"thread\": [\n        {\n          \"id\": \"T10\",\n          \"bars\": \"17–19\",\n          \"links\": [\n            {\n              \"bead\": \"B1.1\",\n              \"type\": \"呈现\",\n              \"note\": \"歌声退到后面，只剩水波般的流动与摇曳，呈现了亲近带来幸福后的沉浸。\"\n            },\n            {\n              \"bead\": \"B1.2\",\n              \"type\": \"呈现\",\n              \"note\": \"身体摇晃、漂浮而暂时不去哪里，呈现了沉浸在眼前幸福中的状态。\"\n            },\n            {\n              \"bead\": \"B1.3\",\n              \"type\": \"呈现\",\n              \"note\": \"说过重要的话以后仍陶醉地停留在其中，呈现了幸福尚未散去、开始舍不得它结束的感受。\"\n            },\n            {\n              \"bead\": \"B1.5\",\n              \"type\": \"呈现\",\n              \"note\": \"身体仍在原处而心慢慢漂远，呈现了亲近之后开始走神、希望幸福延续的状态。\"\n            }\n          ]\n        },\n        {\n          \"id\": \"T11\",\n          \"bars\": \"18–20\",\n          \"links\": [\n            {\n              \"bead\": \"B3.1\",\n              \"type\": \"呈现\",\n              \"note\": \"水波仍在晃动，流动却像被拖住，呈现了意识到事情并非都能由自己决定时的阻力。\"\n            },\n            {\n              \"bead\": \"B3.5\",\n              \"type\": \"呈现\",\n              \"note\": \"亲密谈话触碰到无法解开的结，呈现了自己能珍惜对方却无法决定对方心意的处境。\"\n            }\n          ]\n        },\n        {\n          \"id\": \"T12\",\n          \"bars\": \"20–21\",\n          \"links\": [\n            {\n              \"bead\": \"B2.1\",\n              \"type\": \"呈现\",\n              \"note\": \"持续摇曳中忽然冒出短促而急切的声音，呈现了原本不必确认的事开始牵动他的心。\"\n            },\n            {\n              \"bead\": \"B3.2\",\n              \"type\": \"呈现\",\n              \"note\": \"平稳的对话像被水下暗流拖住，呈现了原先的安稳开始受到念头干扰。\"\n            }\n          ]\n        },\n        {\n          \"id\": \"T13\",\n          \"bars\": \"20–22\",\n          \"links\": [\n            {\n              \"bead\": \"B2.2\",\n              \"type\": \"呈现\",\n              \"note\": \"某个念头只在水面露了一下