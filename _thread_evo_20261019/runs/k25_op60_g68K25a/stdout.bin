{"completed": true, "response": "<escape>{\n  \"sections\": [\n    {\n      \"sec\": \"S01\",\n      \"big\": [\n        {\n          \"text\": \"他忽然发现很想靠近对方\",\n          \"accent\": \"很想靠近\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S01-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他怕自己的需要成负担\",\n          \"accent\": \"成负担\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S01-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"所以只敢露出一点喜欢\",\n          \"accent\": \"一点喜欢\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S01-2\"],\n          \"at\": 5\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"一点亲近就很甜，下次还敢坦白吗？\",\n          \"after\": 2,\n          \"from\": [\"S01-3\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"话还没出口，沉默几秒，怕关系会变\",\n          \"after\": 1,\n          \"from\": [\"S01-B2\"],\n          \"bars\": \"1-3\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"威尼斯烟花光点落下，船板微晃身体失重\",\n          \"after\": 0,\n          \"from\": [\"S01-B1\", \"S01-B3\"],\n          \"bars\": \"1-3\",\n          \"at\": 6\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"两下和弦骤然响起，余音悬着，摇荡未稳\",\n          \"from\": [\"S01-B1\"],\n          \"bars\": \"1-3\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S02\",\n      \"big\": [\n        {\n          \"text\": \"对方没退开他才渐渐放松\",\n          \"accent\": \"渐渐放松\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S02-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想顺势靠得更近\",\n          \"accent\": \"靠得更近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S02-2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"喜欢几乎藏不住\",\n          \"accent\": \"藏不住\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S02-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"怕太急弄坏自在他还是收住\",\n          \"accent\": \"还是收住\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S02-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"他想到这样的好总会过去\",\n          \"accent\": \"总会过去\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S02-3\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"耳语贴近，呼吸体温相融，夏末潮风微黏\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6-16\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"熟人安静坐着，偶尔对望也不紧张\",\n          \"after\": 0,\n          \"from\": [\"S02-B1\"],\n          \"bars\": \"6-16\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"不必踩实地面，身体交给船底温柔托举\",\n          \"after\": 0,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4-5\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"漂得舒服不急靠岸，水和时间仍往前流\",\n          \"after\": 4,\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4-16\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"热切忽然涌上来，又像轻轻呼出一口气\",\n          \"after\": 2,\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12-16\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"柔软落音像温柔的刺，甜蜜里已鼻酸\",\n          \"after\": 4,\n          \"from\": [\"S02-B4\"],\n          \"bars\": \"7-11\",\n          \"at\": 36\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"左手像心跳一样，一下一下摇着\",\n          \"from\": [\"S02-B2\"],\n          \"bars\": \"4-5\"\n        },\n        {\n          \"text\": \"歌声短暂上涌，随后收回柔和\",\n          \"from\": [\"S02-B3\"],\n          \"bars\": \"12-16\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S03\",\n      \"big\": [\n        {\n          \"text\": \"他难得不去想以后\",\n          \"accent\": \"不去想以后\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S03-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"只想舒服地待在亲近里\",\n          \"accent\": \"舒服地待在亲近里\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他想说喜欢也想问对方是否一样\",\n          \"accent\": \"是否一样\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S03-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"没想好怎么开口念头就淡了\",\n          \"accent\": \"念头就淡了\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S03-2\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"水波托着身体漂浮，陶醉地停在话里\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17-23\",\n          \"at\": 13\n        },\n        {\n          \"text\": \"沉默很舒服，身体还在，心却慢慢漂远\",\n          \"after\": 1,\n          \"from\": [\"S03-B1\"],\n          \"bars\": \"17-23\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"急着表达的念头刚露头，很快又沉下去\",\n          \"after\": 2,\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20-21\",\n          \"at\": 19\n        },\n        {\n          \"text\": \"暗流拖住水波，碎倒影般碰上心结\",\n          \"after\": 3,\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"17-23\",\n          \"at\": 22\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"摇曳里忽然冒出几句短促急切的声音\",\n          \"from\": [\"S03-B2\"],\n          \"bars\": \"20-21\"\n        },\n        {\n          \"text\": \"流动忽然滞留，几处声音悬在半途\",\n          \"from\": [\"S03-B3\"],\n          \"bars\": \"20-22\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S04\",\n      \"big\": [\n        {\n          \"text\": \"熟悉的亲近又让他欢喜\",\n          \"accent\": \"又让他欢喜\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想起上回想说却没开口\",\n          \"accent\": \"没开口\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S04-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"这次他几乎想把藏着的话说完\",\n          \"accent\": \"说完\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S04-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他盼对方喜欢他坦白的样子\",\n          \"accent\": \"坦白的样子\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S04-2\"],\n          \"at\": 8\n        },\n        {\n          \"text\": \"怕对方为难他还是留了些话\",\n          \"accent\": \"留了些话\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S04-3\"],\n          \"at\": 12\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"贴耳低语，光斑晃眼，像讲往事越说越急\",\n          \"after\": 2,\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24-34\",\n          \"at\": 16\n        },\n        {\n          \"text\": \"夕阳金光刺眼，最深情意哽在喉咙口\",\n          \"after\": 2,\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30-34\",\n          \"at\": 20\n        },\n        {\n          \"text\": \"手不知不觉握紧，越想抱牢越怕失衡\",\n          \"after\": 4,\n          \"from\": [\"S04-B3\"],\n          \"bars\": \"24-34\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"明明好好的，心里却已舍不得这一刻\",\n          \"after\": 0,\n          \"from\": [\"S04-B4\"],\n          \"bars\": \"24-34\",\n          \"at\": 28\n        },\n        {\n          \"text\": \"盼说出口能让眼下的好久一点\",\n          \"after\": 3,\n          \"from\": [\"S04-3\"],\n          \"bars\": \"\",\n          \"at\": 32\n        },\n        {\n          \"text\": \"怕两个人原有的自在也被弄丢\",\n          \"after\": 4,\n          \"from\": [\"S04-3\"],\n          \"bars\": \"\",\n          \"at\": 36\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"细密花腔像水面折射的光斑\",\n          \"from\": [\"S04-B1\"],\n          \"bars\": \"24-34\"\n        },\n        {\n          \"text\": \"高处长颤音亮起，随后攀升又收弱\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"30-34\"\n        },\n        {\n          \"text\": \"句尾的摇晃渐渐放慢\",\n          \"from\": [\"S04-B2\"],\n          \"bars\": \"32-34\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S05\",\n      \"big\": [\n        {\n          \"text\": \"对方仍亲近这回他没藏住喜欢\",\n          \"accent\": \"没藏住喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S05-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"对方看出后他心里空落落\",\n          \"accent\": \"空落落\",\n          \"emotion\": \"孤单\",\n          \"from\": [\"S05-2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他怕对方嫌自己太黏\",\n          \"accent\": \"太黏\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S05-3\"],\n          \"at\": 3\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"连怎么相处都拿不准，熟悉亲近像隔层雾\",\n          \"after\": 1,\n          \"from\": [\"S05-2\", \"S05-3\"],\n          \"bars\": \"\",\n          \"at\": 6\n        },\n        {\n          \"text\": \"小船失托漂进雾里，攥紧的手也松开\",\n          \"after\": 1,\n          \"from\": [\"S05-B1\", \"S05-B3\"],\n          \"bars\": \"35-39\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"耳语停了，心问幸福真能长久吗？\",\n          \"after\": 1,\n          \"from\": [\"S05-B2\"],\n          \"bars\": \"35-39\",\n          \"at\": 12\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"丰满声音忽然抽空，只剩单薄旋律\",\n          \"from\": [\"S05-B1\"],\n          \"bars\": \"35-39\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S06\",\n      \"big\": [\n        {\n          \"text\": \"对方没变他才重新自在\",\n          \"accent\": \"重新自在\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S06-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"安静时他仍想靠近\",\n          \"accent\": \"仍想靠近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S06-2\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"却怕自己要得太多\",\n          \"accent\": \"要得太多\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S06-2\"],\n          \"at\": 4\n        },\n        {\n          \"text\": \"他猜对方是否也舍不得结束？\",\n          \"accent\": \"舍不得结束\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S06-3\"],\n          \"at\": 8\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"暖金水面入桥影，月光般清澈像童年初恋\",\n          \"after\": 0,\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40-50\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"算了又放不下，说着说着不再撑着\",\n          \"after\": 2,\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40-50\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"白天很好，夜里独处泛酸，恍如回忆\",\n          \"after\": 0,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40-50\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"再亲密也有人走不进心里每个角落\",\n          \"after\": 2,\n          \"from\": [\"S06-B3\"],\n          \"bars\": \"40-50\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"气味身体幻想遗憾快感交融，迷失方向\",\n          \"after\": 2,\n          \"from\": [\"S06-B4\"],\n          \"bars\": \"40-50\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"对方不知他刚才多怕被嫌，他有点孤单\",\n          \"after\": 3,\n          \"from\": [\"S06-2\"],\n          \"bars\": \"\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"水波伴奏变薄，新旋律清澈舒展\",\n          \"from\": [\"S06-B1\"],\n          \"bars\": \"40-50\"\n        },\n        {\n          \"text\": \"另一条声线时而靠近时而退开\",\n          \"from\": [\"S06-B2\"],\n          \"bars\": \"40-50\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S07\",\n      \"big\": [\n        {\n          \"text\": \"他觉得对方有时也需要他陪\",\n          \"accent\": \"有时也需要\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"跟他在一起对方也许更安心\",\n          \"accent\": \"也许更安心\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S07-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"想到互相依靠他高兴得收不住\",\n          \"accent\": \"高兴得收不住\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S07-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他盼对方以后还会想到自己\",\n          \"accent\": \"还会想到自己\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-3\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他想一直陪在对方身边\",\n          \"accent\": \"一直陪在身边\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S07-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"心里忽然一紧，却还想这样待着\",\n          \"after\": 2,\n          \"from\": [\"S07-2\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"情欲执念和对生的眷恋推着身体向前\",\n          \"after\": 2,\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51-61\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"气味身体幻想遗憾快感交融，情色暖意\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51-61\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"舒服得迷失方向，明知被卷入仍不想出来\",\n          \"after\": 2,\n          \"from\": [\"S07-B2\"],\n          \"bars\": \"51-61\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"美好还在，时间却一直经过，无法停住\",\n          \"after\": 3,\n          \"from\": [\"S07-B3\"],\n          \"bars\": \"53-61\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"伴奏音符渐密，内声部像暗涌攀升\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51-61\"\n        },\n        {\n          \"text\": \"低音八度与切分像沉重脉搏\",\n          \"from\": [\"S07-B1\"],\n          \"bars\": \"51-61\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S08\",\n      \"big\": [\n        {\n          \"text\": \"上回露心意后对方仍亲近\",\n          \"accent\": \"仍亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他想主动些大方回应\",\n          \"accent\": \"大方回应\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他开始盼两人能好很久\",\n          \"accent\": \"好很久\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S08-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"眼下两人都愿意亲近\",\n          \"accent\": \"都愿意亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S08-3\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他怕以后未必还能这样\",\n          \"accent\": \"未必还能这样\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S08-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"没有哲学也不设防，只想把歌句唱开\",\n          \"after\": 1,\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62-70\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"像重新碰到阳光和风，身体恢复弹性\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62-70\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"带一点玩心，像轻快的调情和回应\",\n          \"after\": 1,\n          \"from\": [\"S08-B2\"],\n          \"bars\": \"62-70\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"快乐余温还在，心头却泛起怀念\",\n          \"after\": 4,\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69-71\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"歌句舒展开来，情绪一再抬高\",\n          \"from\": [\"S08-B1\"],\n          \"bars\": \"62-70\"\n        },\n        {\n          \"text\": \"歌声向上散开，随后戛然而止\",\n          \"from\": [\"S08-B3\"],\n          \"bars\": \"69-71\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S09\",\n      \"big\": [\n        {\n          \"text\": \"他开始怕对方不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"连和他待着都不再自在\",\n          \"accent\": \"不再自在\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S09-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他一下安静不敢再想以后\",\n          \"accent\": \"不敢再想以后\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S09-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他想起对方没退开仍很亲近\",\n          \"accent\": \"仍很亲近\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S09-3\"],\n          \"at\": 6\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"强烈渴望还绷着，四周像隔着薄雾\",\n          \"after\": 2,\n          \"from\": [\"S09-B1\", \"S09-B2\"],\n          \"bars\": \"72-77\",\n          \"at\": 9\n        },\n        {\n          \"text\": \"听着余响，反复问刚才是真的吗、怎么办\",\n          \"after\": 2,\n          \"from\": [\"S09-B3\"],\n          \"bars\": \"72-77\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"夜空里的美好比愿望大，不安暂时退开\",\n          \"after\": 3,\n          \"from\": [\"S09-B4\"],\n          \"bars\": \"72-77\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"也许对方也喜欢他在身边，他有点高兴\",\n          \"after\": 3,\n          \"from\": [\"S09-3\"],\n          \"bars\": \"\",\n          \"at\": 18\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"熟悉摇摆忽然退开，颤音和和弦悬住\",\n          \"from\": [\"S09-B1\"],\n          \"bars\": \"72-77\"\n        },\n        {\n          \"text\": \"声音一层层下沉变暗，注意力收拢\",\n          \"from\": [\"S09-B2\"],\n          \"bars\": \"72-77\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S10\",\n      \"big\": [\n        {\n          \"text\": \"他决定先不猜往后的事\",\n          \"accent\": \"先不猜\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"先好好享受眼前的亲近\",\n          \"accent\": \"眼前的亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S10-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"紧绷松开他亮得想笑也想哭\",\n          \"accent\": \"想笑也想哭\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S10-2\"],\n          \"at\": 4\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"胸口终于打开，眼泪也不用再忍\",\n          \"after\": 2,\n          \"from\": [\"S10-B1\"],\n          \"bars\": \"78-83\",\n          \"at\": 8\n        },\n        {\n          \"text\": \"时间短暂松开，身体轻得像飘在夜风里\",\n          \"after\": 2,\n          \"from\": [\"S10-B2\", \"S10-B3\"],\n          \"bars\": \"78-83\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"高音像银丝细雨，琶音像清亮飞瀑\",\n          \"after\": 2,\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"80-83\",\n          \"at\": 16\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"高音区织出细亮音符，琶音清亮下泻\",\n          \"from\": [\"S10-B4\"],\n          \"bars\": \"80-83\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S11\",\n      \"big\": [\n        {\n          \"text\": \"他发现自己很需要对方\",\n          \"accent\": \"很需要对方\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"对方有时也需要他陪\",\n          \"accent\": \"有时也需要\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S11-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"即使对方不需要他仍愿意陪\",\n          \"accent\": \"仍愿意陪\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S11-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他决定不再藏着喜欢\",\n          \"accent\": \"不再藏着喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S11-1\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他管不了对方以后还要不要他陪\",\n          \"accent\": \"管不了\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S11-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"高兴得顾不上害臊，觉得在乎没什么不好\",\n          \"after\": 3,\n          \"from\": [\"S11-2\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"想到未必总能亲近，欢喜压得心口发疼\",\n          \"after\": 4,\n          \"from\": [\"S11-3\"],\n          \"bars\": \"\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"悬着的期待终于得到某种满足\",\n          \"after\": 3,\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"夕阳烧得血红金亮，灿烂得胸口发痛\",\n          \"after\": 4,\n          \"from\": [\"S11-B3\"],\n          \"bars\": \"84-92\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"多年后重回旧房，熟悉却多了新的重量\",\n          \"after\": 0,\n          \"from\": [\"S11-B4\"],\n          \"bars\": \"84-92\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"厚重和弦托起歌声，水波翻成惊涛\",\n          \"from\": [\"S11-B1\"],\n          \"bars\": \"84-92\"\n        },\n        {\n          \"text\": \"铺开的力量在高处短暂悬住\",\n          \"from\": [\"S11-B2\"],\n          \"bars\": \"92\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S12\",\n      \"big\": [\n        {\n          \"text\": \"他顾不上对方是否也在乎\",\n          \"accent\": \"顾不上\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"只想把能给的都给对方\",\n          \"accent\": \"都给对方\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他知道再用心也不能保证以后\",\n          \"accent\": \"不能保证以后\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S12-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他还是想多陪对方一会儿\",\n          \"accent\": \"多陪对方一会儿\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S12-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他终于不再收着喜欢\",\n          \"accent\": \"不再收着喜欢\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S12-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"只盼对方能因此安心\",\n          \"after\": 1,\n          \"from\": [\"S12-1\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"像被卷进更大的世界，连自己都退到后面\",\n          \"after\": 4,\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93-102\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"高烧般狂喜，像久别重逢紧紧相拥\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93-102\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"喉咙发紧眼眶湿润，分不清想笑还是想哭\",\n          \"after\": 4,\n          \"from\": [\"S12-B2\"],\n          \"bars\": \"93-102\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"还想要更多，却始终不能完全满足\",\n          \"after\": 3,\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"93-102\",\n          \"at\": 24\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"晴朗主题被放大，声浪一层层推高\",\n          \"from\": [\"S12-B1\"],\n          \"bars\": \"93-102\"\n        },\n        {\n          \"text\": \"旋律反复上伸，乐句末端仍有牵扯\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"96-100\"\n        },\n        {\n          \"text\": \"声浪在交界处得到重大释放\",\n          \"from\": [\"S12-B3\"],\n          \"bars\": \"102-103\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S13\",\n      \"big\": [\n        {\n          \"text\": \"他更想听对方说以后不变\",\n          \"accent\": \"以后不变\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他喜欢相处时总嫌时间太快\",\n          \"accent\": \"时间太快\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S13-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他怕对方哪天不再需要他\",\n          \"accent\": \"不再需要他\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"连这样的相处也会失去\",\n          \"accent\": \"也会失去\",\n          \"emotion\": \"不安\",\n          \"from\": [\"S13-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"他已装不回不在乎\",\n          \"accent\": \"装不回不在乎\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S13-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"就算听到保证，他仍问能一直这样吗？\",\n          \"after\": 0,\n          \"from\": [\"S13-1\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"起初怕添负担，如今怕他不再需要自己\",\n          \"after\": 2,\n          \"from\": [\"S13-2\"],\n          \"bars\": \"\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"少露些心意，会不会就少疼一点？\",\n          \"after\": 3,\n          \"from\": [\"S13-2\"],\n          \"bars\": \"\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"想对他好是真心的，往回藏反而更难受\",\n          \"after\": 4,\n          \"from\": [\"S13-3\"],\n          \"bars\": \"\",\n          \"at\": 21\n        },\n        {\n          \"text\": \"幸福里掺进苦涩的可是，越相信才越疼\",\n          \"after\": 1,\n          \"from\": [\"S13-B2\", \"S13-B3\"],\n          \"bars\": \"103-110\",\n          \"at\": 24\n        },\n        {\n          \"text\": \"脚步稳稳踩住地面，胸口却一沉再沉\",\n          \"after\": 1,\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103-110\",\n          \"at\": 27\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"反复渐强，后半段越绷越紧\",\n          \"from\": [\"S13-B1\"],\n          \"bars\": \"103-110\"\n        },\n        {\n          \"text\": \"上方的声音一次次往下落\",\n          \"from\": [\"S13-B4\"],\n          \"bars\": \"103-110\"\n        }\n      ]\n    },\n    {\n      \"sec\": \"S14\",\n      \"big\": [\n        {\n          \"text\": \"最初他连喜欢都不敢多露\",\n          \"accent\": \"不敢多露\",\n          \"emotion\": \"悬着\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"如今两人仍然亲近\",\n          \"accent\": \"仍然亲近\",\n          \"emotion\": \"亲密\",\n          \"from\": [\"S14-1\"],\n          \"at\": 0\n        },\n        {\n          \"text\": \"他心里又甜又酸却不后悔\",\n          \"accent\": \"又甜又酸\",\n          \"emotion\": \"欢喜\",\n          \"from\": [\"S14-1\"],\n          \"at\": 3\n        },\n        {\n          \"text\": \"他不再逼自己讨永远不变的保证\",\n          \"accent\": \"不再逼自己\",\n          \"emotion\": \"安心\",\n          \"from\": [\"S14-2\"],\n          \"at\": 6\n        },\n        {\n          \"text\": \"喜欢已经被看见他就不再藏\",\n          \"accent\": \"不再藏\",\n          \"emotion\": \"炽热\",\n          \"from\": [\"S14-3\"],\n          \"at\": 9\n        }\n      ],\n      \"small\": [\n        {\n          \"text\": \"仍会舍不得，往后怎样等到了再说\",\n          \"after\": 4,\n          \"from\": [\"S14-2\", \"S14-3\"],\n          \"bars\": \"\",\n          \"at\": 12\n        },\n        {\n          \"text\": \"像从美梦醒来，心里还留着梦里的光\",\n          \"after\": 2,\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"111-115\",\n          \"at\": 15\n        },\n        {\n          \"text\": \"像站起来整理衣服，关上门\",\n          \"after\": 4,\n          \"from\": [\"S14-B3\"],\n          \"bars\": \"116\",\n          \"at\": 18\n        },\n        {\n          \"text\": \"尾声像隔着很远回应开头，终于把话说完\",\n          \"after\": 4,\n          \"from\": [\"S14-B4\"],\n          \"bars\": \"113-116\",\n          \"at\": 21\n        }\n      ],\n      \"notes\": [\n        {\n          \"text\": \"最后一股浪头后，终结句渐渐松下来\",\n          \"from\": [\"S14-B1\"],\n          \"bars\": \"110-115\"\n        },\n        {\n          \"text\": \"左手幽幽唱出一句，像男中音独自沉思\",\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"113-115\"\n        },\n        {\n          \"text\": \"右手细碎琶音像水花溅落夜空\",\n          \"from\": [\"S14-B2\"],\n          \"bars\": \"115\"\n        },\n        {\n     