      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S11",
    "bars": "226–241",
    "relation": null,
    "items": [
     {
      "id": "S11-1",
      "text": "旧日归属又鲜明地浮上来，我仍然会想念它，可这次它只是记忆的一部分，没有把我重新带回等待里。",
      "key": "旧日归属又鲜明地",
      "follows": false,
      "explains": [],
      "cite": [
       "S03-1",
       "S09-1",
       "S10-1"
      ]
     },
     {
      "id": "S11-2",
      "text": "我开始把力气一点点聚到眼下，原先试探的劲头慢慢变成更明确的行动意愿，但不安还在。",
      "key": "我开始把力气一点",
      "follows": false,
      "explains": [],
      "cite": [
       "S10-1"
      ]
     },
     {
      "id": "S11-3",
      "text": "压力一次次重新涌上来，刚松一点又绷紧，我还是得在这样的反复里撑着。",
      "key": "压力一次次重新涌",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-2"
      ]
     },
     {
      "id": "S11-4",
      "text": "能继续做眼前的事，让我比停在那里时轻松一点；可这点轻松并不表示事情已经解决。",
      "key": "能继续做眼前的事",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-2",
       "S11-3"
      ]
     }
    ],
    "because": [
     {
      "from": "S03-1",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S09-1",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S10-1",
      "to": "S11-1",
      "rel": "引用"
     },
     {
      "from": "S10-1",
      "to": "S11-2",
      "rel": "引用"
     },
     {
      "from": "S11-2",
      "to": "S11-3",
      "rel": "引用"
     },
     {
      "from": "S11-2",
      "to": "S11-4",
      "rel": "引用"
     },
     {
      "from": "S11-3",
      "to": "S11-4",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S12",
    "bars": "242–253",
    "relation": null,
    "items": [
     {
      "id": "S12-1",
      "text": "我对自己的肯定变得更有力，也更愿意把自己放在重要的位置上。",
      "key": "我对自己的肯定变",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-2",
       "S11-4"
      ]
     },
     {
      "id": "S12-2",
      "text": "过去让我受过的伤并没有因此消失，我也不必否认它们，才能继续尊重自己。",
      "key": "过去让我受过的伤",
      "follows": false,
      "explains": [],
      "cite": [
       "S09-1",
       "S12-1"
      ]
     },
     {
      "id": "S12-3",
      "text": "这股向前的劲偶尔会晃一下，但很快又接上，没有把我带回原先的等待。",
      "key": "这股向前的劲偶尔",
      "follows": false,
      "explains": [],
      "cite": [
       "S12-1",
       "S12-2"
      ]
     }
    ],
    "because": [
     {
      "from": "S11-2",
      "to": "S12-1",
      "rel": "引用"
     },
     {
      "from": "S11-4",
      "to": "S12-1",
      "rel": "引用"
     },
     {
      "from": "S09-1",
      "to": "S12-2",
      "rel": "引用"
     },
     {
      "from": "S12-1",
      "to": "S12-2",
      "rel": "引用"
     },
     {
      "from": "S12-1",
      "to": "S12-3",
      "rel": "引用"
     },
     {
      "from": "S12-2",
      "to": "S12-3",
      "rel": "引用"
     }
    ]
   },
   {
    "sec": "S13",
    "bars": "254–288",
    "relation": null,
    "items": [
     {
      "id": "S13-1",
      "text": "那份私人的柔软和更有力量的自我肯定一起涌上来，情绪变得很满；旧日归属仍在我心里占着位置。",
      "key": "那份私人的柔软和",
      "follows": false,
      "explains": [],
      "cite": [
       "S11-1",
       "S12-1",
       "S12-2"
      ]
     },
     {
      "id": "S13-2",
      "text": "积了很久的力气一下子释放出来，我有了很强的向前冲动，几乎顾不上停下来细想。",
      "key": "积了很久的力气一",
      "follows": false,
      "explains": [],
      "cite": [
       "S13-1"
      ]
     },
     {
      "id": "S13-3",
      "text": "那股高涨慢慢退下去，我感到一点安定和完成感，心底却还留着一丝不确定。",
      "key": "那股高涨慢慢退下",
      "follows": false,
      "explains": [],
      "cite": [
       "S13-2"
      ]
     },
     {
      "id": "S13-4",
      "text": "最后留下的是很安静、很清楚的感觉，像这一段终于可以停在这里，不必再靠更大的力气证明自己。",
      "key": "最后留下的是很安",
      "follows": false,
      "explains": [],
      "cite": [
       "S13-3"
      ]
     }
    ],
    "because": [
