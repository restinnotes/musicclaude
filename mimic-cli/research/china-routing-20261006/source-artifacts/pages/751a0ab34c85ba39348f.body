<script type="text/javascript">
  function Events(unParsedCookies) {
    // Environment variables / config variables
    this.STAT_API_URL = 'https://s.joinhoney.com';
    this.EVENT_CODES = {
      'web:install:shown': 'web004001',
      'web:install:click': 'web004002',
      'web:install:success': 'web004003',
      'web:install:failure': 'web004004',
      'web:join:shown': 'web004011',
      'web:join:click': 'web004010',
      'web:page:show': 'web008010',
      'web:cookie_consent:shown': 'web000500',
      'web:cookie_consent:accepted': 'web000501',
    };

    function parseCookies(cookiesToParse) {
      return cookiesToParse.split(';').reduce((res, c) => {
        const [key, val] = c.trim().split('=').map(decodeURIComponent)
        const allNumbers = str => /^\d+$/.test(str);
        try {
          return Object.assign(res, { [key]: allNumbers(val) ?  val : JSON.parse(val) })
        } catch (e) {
          return Object.assign(res, { [key]: val })
        }
      }, {});
    }

    var cookies = parseCookies(unParsedCookies);

    // Constructor
    this.sessionID = new Date().getTime().toString();
    this._referrer = cookies != null ? cookies.referrer : undefined;
    this._visitor = cookies != null ? cookies.visitor : undefined;
    this._exv = cookies != null ? cookies.exv : undefined;

    var honeyCampaign = cookies != null ? cookies.honeycampaign : undefined;
    if (honeyCampaign) {
      this._campaign = {
        id: honeyCampaign.campaign,
        trackId: honeyCampaign.tid,
        token: honeyCampaign.token,
      };
    }
    var campaign = cookies != null ? cookies.campaign : undefined;    if (campaign && campaign.length && campaign[0]) {
      this._campaign = campaign[0];
    }
    // End: Constructor

    this.updateCookiesFromDocument = function () {
      if (typeof document === 'object' && document !== null && document.cookie) {
        var cookies = parseCookies(document.cookie);

        this._referrer = cookies != null ? cookies.referrer : undefined;
        this._visitor = cookies != null ? cookies.visitor : undefined;
        this._exv = cookies != null ? cookies.exv : undefined;

        var honeyCampaign = cookies != null ? cookies.honeycampaign : undefined;
        if (honeyCampaign) {
          this._campaign = {
            id: honeyCampaign.campaign,
            trackId: honeyCampaign.tid,
            token: honeyCampaign.token,
          };
        }
        var campaign = cookies != null ? cookies.campaign : undefined;
        if (campaign && campaign.length && campaign[0]) {
          this._campaign = campaign[0];
        }

        return this._exv;
      }
      return null;
    }

    // Convert an object with keys in camel case to one with keys in snake case
    this.camelToSnake = function(camelObj) {
      var that = this;

      if (!camelObj || typeof camelObj !== 'object') return camelObj;
      var defaultValue = Array.isArray(camelObj) ? [] : {};

      var snakified = Object.keys(camelObj).reduce(function(snakeObj, camelKey) {
        var val = camelObj[camelKey];
        var snakeKey = camelKey.replace(/[a-z][A-Z]/g, function(digram) {
          return digram[0] + '_' + digram[1];
        }).toLowerCase();

        // if val is a truthy object (not null)
        var valueToAdd = (val !== null && typeof val === 'object') ? that.camelToSnake(val) : val;

        var objectToAdd = {};
        objectToAdd[snakeKey] = valueToAdd;

        return Object.assign(snakeObj, objectToAdd);
      }, defaultValue);

      return snakified;
    }

    this.sdataEvent = function(sdataEventData) {
      var eventType = sdataEventData.eventType;
      var data = sdataEventData.data;
      var headers = sdataEventData.headers;
      var subSrc = sdataEventData.subSrc;
      var exv = sdataEventData.exv;

      var ipAddress;
      this.updateCookiesFromDocument();
      var code = this.EVENT_CODES[eventType];
      if (!code) { throw new Error('Missing sdata event type'); }

      var event = {
        campaign: this._campaign,
        visitorId: this._visitor,
        firstReferrerUrl: this._referrer && this._referrer.referrer,
        firstReferrerTs: this._referrer && this._referrer.ts,
        sessionId: this.sessionID,
        subSrc: subSrc || 'unknown',
      };

      if (data) {
        ipAddress = data.ipAddress;
        delete data.ipAddress; // eslint-disable-line no-param-reassign
        $.extend(event, data);
      }

      var payload = {
        src: 'website',
        event: event,
        exv: exv || this._exv,
        ipAddress: ipAddress,
      };

      // All sdata needs to be snake_case
      var snakePayload = this.camelToSnake(payload);

      return $.ajax({
        type: "POST",
        headers: headers || {},
        url: this.STAT_API_URL + "/ev/" + code,
        dataType: "json",
        data: JSON.stringify(snakePayload),
        contentType: "application/json",
      });
    }
  }
</script>

<script type="text/javascript">
  function installClicked(link) {
    var events = new Events(document.cookie);
    events.sdataEvent({
      eventType: 'web:install:click',
      data: {},
      headers: null,
      subSrc: 'help-center',
    });
    window.open(link, `_blank`);
  }
</script>

