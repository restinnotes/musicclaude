{
 "sections": [
  {
   "sec": "S01",
   "big": [
    {
     "text": "他忽然很想靠近这个人",
     "accent": "很想靠近",
     "emotion": "炽热",
     "from": [
      "S01-1"
     ]
    },
    {
     "text": "却怕自己的需要太重",
     "accent": "需要太重",
     "emotion": "不安",
     "from": [
      "S01-2"
     ]
    },
    {
     "text": "只敢露一点喜欢就觉得甜",
     "accent": "一点喜欢",
     "emotion": "欢喜",
     "from": [
      "S01-2",
      "S01-3"
     ]
    }
   ],
   "small": [
    {
     "text": "像话到嘴边，怕一说关系就变",
     "after": 1,
     "from": [
      "S01-B2"
     ],
     "bars": "1–3"
    },
    {
     "text": "像刚踏上小船，脚下微微一晃",
     "after": 0,
     "from": [
      "S01-B3"
     ],
     "bars": "1–3"
    },
    {
     "text": "他还拿不准，下次能不能坦白些",
     "after": 2,
     "from": [
      "S01-3"
     ],
     "bars": ""
    }
   ],
   "notes": [
    {
     "text": "开头两下和弦像烟花骤然升起",
     "from": [
      "S01-B1"
     ],
     "bars": "1–3"
    },
    {
     "text": "光点缓缓落下，仍悬在水面上方",
     "from": [
      "S01-B1"
     ],
     "bars": "1–3"
    },
    {
     "text": "有的演奏已轻摇，这里还没摇稳",
     "from": [
      "S01-B3"
     ],
     "bars": "1–3"
    }
   ]
  },
  {
   "sec": "S02",
   "big": [
    {
     "text": "对方仍愿意和他亲近",
     "accent": "仍愿意",
     "emotion": "亲密",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "他这才慢慢放松下来",
     "accent": "放松下来",
     "emotion": "安心",
     "from": [
      "S02-1"
     ]
    },
    {
     "text": "喜欢涌上来时他又收住",
     "accent": "涌上来",
     "emotion": "炽热",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "他怕太急弄坏眼下的自在",
     "accent": "弄坏自在",
     "emotion": "不安",
     "from": [
      "S02-2"
     ]
    },
    {
     "text": "想到好时光总会过去",
     "accent": "总会过去",
     "emotion": "悬着",
     "from": [
      "S02-3"
     ]
    }
   ],
   "small": [
    {
     "text": "像肩挨肩耳语，呼吸体温都贴近",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "4–16"
    },
    {
     "text": "熟人安静坐着，偶尔望来一眼也自在",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "4–16"
    },
    {
     "text": "夏末湿热的风裹在皮肤上",
     "after": 0,
     "from": [
      "S02-B1"
     ],
     "bars": "4–16"
    },
    {
     "text": "像不用踩实地面，任船底托着身体",
     "after": 1,
     "from": [
      "S02-B2"
     ],
     "bars": "4–5"
    },
    {
     "text": "像忍不住热切说了几句，又轻轻收住",
     "after": 2,
     "from": [
      "S02-B3"
     ],
     "bars": "12–16"
    },
    {
     "text": "还没分开就鼻酸，盼这一刻慢些",
     "after": 4,
     "from": [
      "S02-3",
      "S02-B4"
     ],
     "bars": "7–11"
    }
   ],
   "notes": [
    {
     "text": "两条旋律贴得很近，像耳语",
     "from": [
      "S02-B1"
     ],
     "bars": "4–16"
    },
    {
     "text": "歌声未起，水浪已一下一下摇动",
     "from": [
      "S02-B2"
     ],
     "bars": "4–5"
    },
    {
     "text": "歌声短暂上涌，随后轻轻收回",
     "from": [
      "S02-B3"
     ],
     "bars": "12–16"
    },
    {
     "text": "几次柔软的落音格外清楚",
     "from": [
      "S02-B4"
     ],
     "bars": "7–11"
    }
   ]
  },
  {
   "sec": "S03",
   "big": [
    {
     "text": "他难得不去想以后",
     "accent": "不去想以后",
     "emotion": "安心",
     "from": [
      "S03-1"
     ]
    },
    {
     "text": "只想舒服地待在亲近里",
     "accent": "舒服地待",
     "emotion": "亲密",
     "from": [
      "S03-1"
     ]
    },
    {
     "text": "想说喜欢也想问对方",
     "accent": "想说喜欢",
     "emotion": "炽热",
     "from": [
      "S03-2"
     ]
    },
    {
     "text": "没想好怎么开口就淡了",
     "accent": "就淡了",
     "emotion": "悬着",
     "from": [
      "S03-2"
     ]
    }
   ],
   "small": [
    {
     "text": "说完重要的话还陶醉，沉默也舒服",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23"
    },
    {
     "text": "身体还在这里，心却漂远，暂时不去哪里",
     "after": 1,
     "from": [
      "S03-B1"
     ],
     "bars": "17–23"
    },
    {
     "text": "急着说的话刚冒头，又沉下去",
     "after": 2,
     "from": [
      "S03-B2"
     ],
     "bars": "20–21"
    },
    {
     "text": "倒影碎了难拼，像谈话碰到难解的结",
     "after": 2,
     "from": [
      "S03-B3"
     ],
     "bars": "17–23"
    }
   ],
   "notes": [
    {
     "text": "歌声退到后面，只剩流动盘旋",
     "from": [
      "S03-B1"
     ],
     "bars": "17–23"
    },
    {
     "text": "短促急切的声音忽然冒出又沉下",
     "from": [
      "S03-B2"
     ],
     "bars": "20–21"
    },
    {
     "text": "流动绕远滞留，像被水下暗流拖住",
     "from": [
      "S03-B3"
     ],
     "bars": "20–22"
    },
    {
     "text": "顺畅的流动里忽然多了阻力",
     "from": [
      "S03-B3"
     ],
     "bars": "17–23"
    }
   ]
  },
  {
   "sec": "S04",
   "big": [
    {
     "text": "熟悉的亲近又让他欢喜",
     "accent": "欢喜",
     "emotion": "欢喜",
     "from": [
      "S04-1"
     ]
    },
    {
     "text": "他想起上回想说却没说",
     "accent": "想说却没说",
     "emotion": "悬着",
     "from": [
      "S04-1"
     ]
    },
    {
     "text": "这回几乎想说出全部心意",
     "accent": "全部心意",
     "emotion": "炽热",
     "from": [
      "S04-2"
     ]
    },
    {
     "text": "盼对方喜欢他坦白的样子",
     "accent": "坦白的样子",
     "emotion": "欢喜",
     "from": [
      "S04-2"
     ]
    },
    {
     "text": "怕说太多让对方为难而收住",
     "accent": "为难而收住",
     "emotion": "不安",
     "from": [
      "S04-3"
     ]
    }
   ],
   "small": [
    {
     "text": "两道声音贴耳低语，呼吸挨得很近",
     "after": 0,
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "像本来还能笑着说，后来忍不住补充",
     "after": 2,
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "他盼说出口，能让眼下的好久些",
     "after": 2,
     "from": [
      "S04-3"
     ],
     "bars": ""
    },
    {
     "text": "像想说出深情，话到喉咙却发颤",
     "after": 2,
     "from": [
      "S04-B2"
     ],
     "bars": "30–34"
    },
    {
     "text": "像握着对方的手，越紧船身越失衡",
     "after": 4,
     "from": [
      "S04-B3"
     ],
     "bars": "24–34"
    },
    {
     "text": "美好还在，心里鼻酸，像每秒都在倒数",
     "after": 0,
     "from": [
      "S04-B4"
     ],
     "bars": "24–34"
    }
   ],
   "notes": [
    {
     "text": "熟悉歌声回来，这次花腔更繁密急切",
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "细密花腔像水面折射的光斑",
     "from": [
      "S04-B1"
     ],
     "bars": "24–34"
    },
    {
     "text": "高处长颤音亮起，随后渐弱未落稳",
     "from": [
      "S04-B2"
     ],
     "bars": "30–34"
    },
    {
     "text": "末尾摇晃渐渐放慢",
     "from": [
      "S04-B2"
     ],
     "bars": "24–34"
    },
    {
     "text": "底下水波仍推着向前",
     "from": [
      "S04-B2",
      "S04-B4"
     ],
     "bars": "24–34"
    }
   ]
  },
  {
   "sec": "S05",
   "big": [
    {
     "text": "他这回没藏住喜欢",
     "accent": "没藏住喜欢",
     "emotion": "炽热",
     "from": [
      "S05-1"
     ]
    },
    {
     "text": "对方看出他在乎他怕被嫌黏",
     "accent": "怕被嫌黏",
     "emotion": "不安",
     "from": [
      "S05-1",
      "S05-3"
     ]
    },
    {
     "text": "他空落落地不知怎么相处",
     "accent": "空落落",
     "emotion": "孤单",
     "from": [
      "S05-2"
     ]
    }
   ],
   "small": [
    {
     "text": "熟悉的亲近，像忽然隔了一层",
     "after": 1,
     "from": [
      "S05-3"
     ],
     "bars": ""
    },
    {
     "text": "脚下失去支撑，时间松开，漂进雾里",
     "after": 2,
     "from": [
      "S05-B1"
     ],
     "bars": "35–39"
    },
    {
     "text": "耳语停了，他跌回心里问幸福能多久",
     "after": 2,
     "from": [
      "S05-B2"
     ],
     "bars": "35–39"
    },
    {
     "text": "像终于松开手，深吸一口气",
     "after": 2,
     "from": [
      "S05-B3"
     ],
     "bars": "35–39"
    }
   ],
   "notes": [
    {
     "text": "丰厚的陪衬忽然撤去，只剩单线游走",
     "from": [
      "S05-B1"
     ],
     "bars": "35–39"
    },
    {
     "text": "贴近的交谈感突然中断",
     "from": [
      "S05-B2"
     ],
     "bars": "35–39"
    }
   ]
  },
  {
   "sec": "S06",
   "big": [
    {
     "text": "对方看出他在乎却没有变",
     "accent": "没有变",
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "他终于又能自在地相处",
     "accent": "自在",
     "emotion": "安心",
     "from": [
      "S06-1"
     ]
    },
    {
     "text": "他仍想靠近却怕要太多",
     "accent": "怕要太多",
     "emotion": "不安",
     "from": [
      "S06-2"
     ]
    },
    {
     "text": "他孤单地藏着刚才的害怕",
     "accent": "孤单",
     "emotion": "孤单",
     "from": [
      "S06-2"
     ]
    },
    {
     "text": "他猜对方是否也舍不得结束亲近",
     "accent": "舍不得结束",
     "emotion": "悬着",
     "from": [
      "S06-3"
     ]
    }
   ],
   "small": [
    {
     "text": "暖金滑入桥影，凉如月光，像年少心动",
     "after": 1,
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "心里说算了又放不下，像忘了有人看着",
     "after": 3,
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    },
    {
     "text": "白天相处很好，夜里发酸，像已成回忆",
     "after": 3,
     "from": [
      "S06-B3"
     ],
     "bars": "40–50"
    },
    {
     "text": "再亲密的人，也走不进心里每个角落",
     "after": 3,
     "from": [
      "S06-B3"
     ],
     "bars": "40–50"
    },
    {
     "text": "气味、身体感觉，混着幻想遗憾和快感",
     "after": 2,
     "from": [
      "S06-B4"
     ],
     "bars": "40–50"
    },
    {
     "text": "情色暖意里，舒服得失去方向不想走",
     "after": 2,
     "from": [
      "S06-B4"
     ],
     "bars": "40–50"
    }
   ],
   "notes": [
    {
     "text": "摇荡变薄，碎成细密的小纹",
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "清澈舒展的新歌像朴素牧歌",
     "from": [
      "S06-B1"
     ],
     "bars": "40–50"
    },
    {
     "text": "低声旋律旁，另一条声音不断回应",
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    },
    {
     "text": "两条声音时而靠近，时而退开",
     "from": [
      "S06-B2"
     ],
     "bars": "40–50"
    }
   ]
  },
  {
   "sec": "S07",
   "big": [
    {
     "text": "他渐渐觉得对方也许需要他",
     "accent": "也许需要他",
     "emotion": "欢喜",
     "from": [
      "S07-1"
     ]
    },
    {
     "text": "想到能互相依靠他很高兴",
     "accent": "互相依靠",
     "emotion": "欢喜",
     "from": [
      "S07-2"
     ]
    },
    {
     "text": "可这份高兴让他心里一紧",
     "accent": "心里一紧",
     "emotion": "悬着",
     "from": [
      "S07-2"
     ]
    },
    {
     "text": "更深的渴望从心底翻涌",
     "accent": "更深的渴望",
     "emotion": "炽热",
     "from": [
      "S07-B1"
     ]
    },
    {
     "text": "他盼对方以后还会想到他",
     "accent": "还会想到他",
     "emotion": "悬着",
     "from": [
      "S07-3"
     ]
    }
   ],
   "small": [
    {
     "text": "对方总愿意和他待着，也许也能安心",
     "after": 0,
     "from": [
      "S07-1"
     ],
     "bars": ""
    },
    {
     "text": "他也想一直陪在对方身边",
     "after": 4,
     "from": [
      "S07-3"
     ],
     "bars": ""
    },
    {
     "text": "像情欲、执念和对生的眷恋翻涌",
     "after": 3,
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    },
    {
     "text": "记忆里气味身体感觉，混着幻想遗憾快感",
     "after": 3,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61"
    },
    {
     "text": "情色暖意里，失去方向仍不想抽身",
     "after": 3,
     "from": [
      "S07-B2"
     ],
     "bars": "51–61"
    },
    {
     "text": "这一刻再好，也没法让时间停下",
     "after": 4,
     "from": [
      "S07-B3"
     ],
     "bars": "53–61"
    }
   ],
   "notes": [
    {
     "text": "熟悉歌声回来，底下推动变得更密",
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    },
    {
     "text": "低音像沉重脉搏，催着人往前",
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    },
    {
     "text": "内里的暗涌不断攀升",
     "from": [
      "S07-B1"
     ],
     "bars": "51–61"
    }
   ]
  },
  {
   "sec": "S08",
   "big": [
    {
     "text": "对方依然愿意亲近他",
     "accent": "依然愿意",
     "emotion": "安心",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "他想大大方方回应这份亲近",
     "accent": "大大方方",
     "emotion": "欢喜",
     "from": [
      "S08-1"
     ]
    },
    {
     "text": "他开始盼两人能好很久",
     "accent": "好很久",
     "emotion": "欢喜",
     "from": [
      "S08-2"
     ]
    },
    {
     "text": "可他不知道以后是否还会这样",
     "accent": "不知道以后",
     "emotion": "不安",
     "from": [
      "S08-3"
     ]
    }
   ],
   "small": [
    {
     "text": "不想分析，也不设防，只想直接回应",
     "after": 1,
     "from": [
      "S08-B1"
     ],
     "bars": "62–70"
    },
    {
     "text": "身体像恢复弹性，带一点玩心",
     "after": 1,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70"
    },
    {
     "text": "像轻快的调情和回应",
     "after": 1,
     "from": [
      "S08-B2"
     ],
     "bars": "62–70"
    },
    {
     "text": "快乐余温还在，心头已泛起怀念",
     "after": 2,
     "from": [
      "S08-B3"
     ],
     "bars": "69–71"
    }
   ],
   "notes": [
    {
     "text": "歌句舒展开，情绪一再抬高",
     "from": [
      "S08-B1"
     ],
     "bars": "62–70"
    },
    {
     "text": "明亮轻盈的歌声像重新碰到阳光",
     "from": [
      "S08-B2"
     ],
     "bars": "62–70"
    },
    {
     "text": "歌声向上散开，随后突然停住",
     "from": [
      "S08-B3"
     ],
     "bars": "69–71"
    }
   ]
  },
  {
   "sec": "S09",
   "big": [
    {
     "text": "他怕对方不再需要他陪",
     "accent": "不再需要",
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "也怕对方和他待着不自在",
     "accent": "不自在",
     "emotion": "不安",
     "from": [
      "S09-1"
     ]
    },
    {
     "text": "他一下安静下来不敢再想",
     "accent": "安静下来",
     "emotion": "悬着",
     "from": [
      "S09-2"
     ]
    },
    {
     "text": "他想起对方一直没有退开",
     "accent": "没有退开",
     "emotion": "安心",
     "from": [
      "S09-3"
     ]
    }
   ],
   "small": [
    {
     "text": "阳光还在，渴望像薄雾中对视停住",
     "after": 2,
     "from": [
      "S09-B1",
      "S09-B2"
     ],
     "bars": "72–77"
    },
    {
     "text": "听着余响，问刚才是真的吗？接下来呢？",
     "after": 2,
     "from": [
      "S09-B3"
     ],
     "bars": "72–77"
    },
    {
     "text": "夜空下，美好比愿望更大，不安暂退",
     "after": 3,
     "from": [
      "S09-B4"
     ],
     "bars": "72–77"
    },
    {
     "text": "也许对方喜欢他在身边",
     "after": 3,
     "from": [
      "S09-3"
     ],
     "bars": ""
    }
   ],
   "notes": [
    {
     "text": "前面的势头忽然收住，摇荡退开",
     "from": [
      "S09-B1"
     ],
     "bars": "72–75"
    },
    {
     "text": "轻柔和弦与飘渺颤音悬在半空",
     "from": [
      "S09-B1"
     ],
     "bars": "76–77"
    },
    {
     "text": "声音一层层下沉，明朗蒙上薄雾",
     "from": [
      "S09-B2"
     ],
     "bars": "72–77"
    }
   ]
  },
  {
   "sec": "S10",
   "big": [
    {
     "text": "他暂时不再猜以后",
     "accent": "不再猜以后",
     "emotion": "安心",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "先好好享受眼前亲近",
     "accent": "眼前亲近",
     "emotion": "亲密",
     "from": [
      "S10-1"
     ]
    },
    {
     "text": "紧绷终于松开他想笑又想哭",
     "accent": "松开",
     "emotion": "欢喜",
     "from": [
      "S10-2"
     ]
    },
    {
     "text": "身体失去重量灵魂像飘开",
     "accent": "失去重量",
     "emotion": "安心",
     "from": [
      "S10-B3"
     ]
    }
   ],
   "small": [
    {
     "text": "肩膀松开，长呼气，胸口打开不必忍泪",
     "after": 2,
     "from": [
      "S10-B1"
     ],
     "bars": "78–83"
    },
    {
     "text": "心事没解决，这刻不必再控制感受",
     "after": 2,
     "from": [
      "S10-B1"
     ],
     "bars": "78–83"
    },
    {
     "text": "清风拨开时间，只留短暂空地",
     "after": 1,
     "from": [
      "S10-B2"
     ],
     "bars": "78–83"
    },
    {
     "text": "夏夜微风里，沉重负担碰不到自己",
     "after": 3,
     "from": [
      "S10-B3"
     ],
     "bars": "78–83"
    }
   ],
   "notes": [
    {
     "text": "高处细亮的小音符像银丝和细雨",
     "from": [
      "S10-B4"
     ],
     "bars": "78–83"
    },
    {
     "text": "一串清亮声音像飞瀑落进水里",
     "from": [
      "S10-B4"
     ],
     "bars": "80–83"
    }
   ]
  },
  {
   "sec": "S11",
   "big": [
    {
     "text": "他承认自己需要对方",
     "accent": "需要对方",
     "emotion": "亲密",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "对方有时也需要他",
     "accent": "也需要他",
     "emotion": "安心",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "即使对方不需要他他仍愿陪着",
     "accent": "仍愿陪着",
     "emotion": "亲密",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "他不再藏着自己的喜欢",
     "accent": "不再藏着",
     "emotion": "炽热",
     "from": [
      "S11-1"
     ]
    },
    {
     "text": "可以后能否陪伴由不得他",
     "accent": "由不得他",
     "emotion": "悬着",
     "from": [
      "S11-3"
     ]
    }
   ],
   "small": [
    {
     "text": "高兴得顾不上害臊，觉得在乎没错",
     "after": 3,
     "from": [
      "S11-2"
     ],
     "bars": ""
    },
    {
     "text": "未必总能亲近，欢喜压得心口疼",
     "after": 4,
     "from": [
      "S11-3"
     ],
     "bars": ""
    },
    {
     "text": "夕阳血红金亮，喜悦浓得胸口发疼",
     "after": 4,
     "from": [
      "S11-B3"
     ],
     "bars": "84–92"
    },
    {
     "text": "旧房子家具没变，自己却知道太多",
     "after": 3,
     "from": [
      "S11-B4"
     ],
     "bars": "84–92"
    },
    {
     "text": "知道它有多珍贵，心里更容易发疼",
     "after": 4,
     "from": [
      "S11-B4"
     ],
     "bars": "84–92"
    },
    {
     "text": "像悬了很久的期待，终于有了回应",
     "after": 3,
     "from": [
      "S11-B2"
     ],
     "bars": "92"
    }
   ],
   "notes": [
    {
     "text": "熟悉主题重来，这次歌声直接而有力",
     "from": [
      "S11-B1"
     ],
     "bars": "84–92"
    },
    {
     "text": "原先温柔的摇荡翻成横跨很远的巨浪",
     "from": [
      "S11-B1"
     ],
     "bars": "84–92"
    },
    {
     "text": "力量在高处短暂停住，随后仍继续向前",
     "from": [
      "S11-B2"
     ],
     "bars": "92"
    }
   ]
  },
  {
   "sec": "S12",
   "big": [
    {
     "text": "他只想把能给的都给对方",
     "accent": "都给对方",
     "emotion": "亲密",
     "from": [
      "S12-1"
     ]
    },
    {
     "text": "他顾不上对方是否同样在乎",
     "accent": "顾不上",
     "emotion": "炽热",
     "from": [
      "S12-1"
     ]
    },
    {
     "text": "他知道再用心也难保以后还好",
     "accent": "难保以后",
     "emotion": "悬着",
     "from": [
      "S12-2"
     ]
    },
    {
     "text": "可他还是想多陪一会儿",
     "accent": "多陪一会儿",
     "emotion": "亲密",
     "from": [
      "S12-2"
     ]
    },
    {
     "text": "这阵高兴终于整个涌出来",
     "accent": "整个涌出来",
     "emotion": "欢喜",
     "from": [
      "S12-3"
     ]
    }
   ],
   "small": [
    {
     "text": "他盼对方能安心",
     "after": 0,
     "from": [
      "S12-1"
     ],
     "bars": ""
    },
    {
     "text": "像被卷进更大的世界，自己退到后面",
     "after": 1,
     "from": [
      "S12-B1"
     ],
     "bars": "93–102"
    },
    {
     "text": "这份狂喜像高烧",
     "after": 4,
     "from": [
      "S12-B2"
     ],
     "bars": "93–102"
    },
    {
     "text": "像久别重逢，抱紧对方久久不松",
     "after": 4,
     "from": [
      "S12-B2"
     ],
     "bars": "93–102"
    },
    {
     "text": "喉咙发紧，眼眶湿润，分不清笑哭",
     "after": 4,
     "from": [
      "S12-B2"
     ],
     "bars": "93–102"
    },
    {
     "text": "心里还想要更多，却始终不满足",
     "after": 3,
     "from": [
      "S12-B3"
     ],
     "bars": "93–102"
    }
   ],
   "notes": [
    {
     "text": "晴朗的歌声被放大，变得开阔有力",
     "from": [
      "S12-B1"
     ],
     "bars": "93–102"
    },
    {
     "text": "内里的声音彼此拉扯，声浪一层高过一层",
     "from": [
      "S12-B1"
     ],
     "bars": "93–102"
    },
    {
     "text": "乐句末端仍牵扯延迟，迟迟不落定",
     "from": [
      "S12-B3"
     ],
     "bars": "96–100"
    },
    {
     "text": "悬着的气息到这里才得到释放",
     "from": [
      "S12-B3"
     ],
     "bars": "102–103"
    }
   ]
  },
  {
   "sec": "S13",
   "big": [
    {
     "text": "他更想听对方说以后不变",
     "accent": "以后不变",
     "emotion": "悬着",
     "from": [
      "S13-1"
     ]
    },
    {
     "text": "就算听到保证他仍怕留不住",
     "accent": "怕留不住",
     "emotion": "不安",
     "from": [
      "S13-1"
     ]
    },
    {
     "text": "他怕对方哪天不再需要他",
     "accent": "不再需要他",
     "emotion": "不安",
     "from": [
      "S13-2"
     ]
    },
    {
     "text": "少露些心意会不会少疼？",
     "accent": "少疼",
     "emotion": "悬着",
     "from": [
      "S13-2"
     ]
    },
    {
     "text": "可把喜欢藏回去他更难受",
     "accent": "更难受",
     "emotion": "炽热",
     "from": [
      "S13-3"
     ]
    }
   ],
   "small": [
    {
     "text": "幸福还在，像握住珍贵东西才知留不住",
     "after": 1,
     "from": [
      "S13-B2"
     ],
     "bars": "103–110"
    },
    {
     "text": "起初怕添负担，如今怕对方不再需要",
     "after": 2,
     "from": [
      "S13-2"
     ],
     "bars": ""
    },
    {
     "text": "喜欢和他待着，时间总显得很快",
     "after": 1,
     "from": [
      "S13-1"
     ],
     "bars": ""
    },
    {
     "text": "心里忽然追问：可是呢？",
     "after": 1,
     "from": [
      "S13-B3"
     ],
     "bars": "103–110"
    },
    {
     "text": "幸福没变假，真信过才会疼",
     "after": 1,
     "from": [
      "S13-B3"
     ],
     "bars": "103–110"
    },
    {
     "text": "人明明站稳了，胸口却一沉再沉",
     "after": 4,
     "from": [
      "S13-B4"
     ],
     "bars": "103–110"
    }
   ],
   "notes": [
    {
     "text": "愿望说出口后，乐句仍反复向前推",
     "from": [
      "S13-B1"
     ],
     "bars": "103–110"
    },
    {
     "text": "重复与渐强继续加紧，直逼下一次冲击",
     "from": [
      "S13-B1"
     ],
     "bars": "106–110"
    },
    {
     "text": "明亮之中渐渐混入尖锐暗沉的声音",
     "from": [
      "S13-B2"
     ],
     "bars": "107–110"
    },
    {
     "text": "下方脚步稳住，上方声音反复下落",
     "from": [
      "S13-B4"
     ],
     "bars": "103–110"
    }
   ]
  },
  {
   "sec": "S14",
   "big": [
    {
     "text": "最初他连喜欢都不敢多露",
     "accent": "不敢多露",
     "emotion": "悬着",
     "from": [
      "S14-1"
     ]
    },
    {
     "text": "如今两人仍然亲近",
     "accent": "仍然亲近",
     "emotion": "亲密",
     "from": [
      "S14-1"
     ]
    },
    {
     "text": "心里又甜又酸他却不后悔",
     "accent": "不后悔",
     "emotion": "欢喜",
     "from": [
      "S14-1"
     ]
    },
    {
     "text": "他不再逼对方保证永远不变",
     "accent": "不再逼",
     "emotion": "安心",
     "from": [
      "S14-2"
     ]
    },
    {
     "text": "既然喜欢被看见他就不再藏",
     "accent": "不再藏",
     "emotion": "炽热",
     "from": [
      "S14-3"
     ]
    }
   ],
   "small": [
    {
     "text": "他还是会舍不得，往后仍没把握",
     "after": 3,
     "from": [
      "S14-2"
     ],
     "bars": ""
    },
    {
     "text": "像从美梦醒来，还记得梦里的光",
     "after": 2,
     "from": [
      "S14-B1"
     ],
     "bars": "111–115"
    },
    {
     "text": "心里仍温热，身体慢慢平静",
     "after": 2,
     "from": [
      "S14-B1"
     ],
     "bars": "111–115"
    },
    {
     "text": "像经历震荡后站起，整理衣服关门",
     "after": 4,
     "from": [
      "S14-B3"
     ],
     "bars": "116"
    },
    {
     "text": "往后会怎样，等真的到了再说",
     "after": 4,
     "from": [
      "S14-3"
     ],
     "bars": ""
    }
   ],
   "notes": [
    {
     "text": "最后一股浪头又猛推一下",
     "from": [
      "S14-B1"
     ],
     "bars": "110–111"
    },
    {
     "text": "进入终结句后，声音慢慢松下来",
     "from": [
      "S14-B1"
     ],
     "bars": "111–115"
    },
    {
     "text": "低声的一句回望，熟悉歌唱与摇荡再现",
     "from": [
      "S14-B2"
     ],
     "bars": "113–115"
    },
    {
     "text": "细碎声响像水花溅向夜空",
     "from": [
      "S14-B2"
     ],
     "bars": "115"
    },
    {
     "text": "最后几下和弦干脆沉重，低音定住摇荡",
     "from": [
      "S14-B3"
     ],
     "bars": "116"
    },
    {
     "text": "尾声像接住开头悬着的话，终于说完",
     "from": [
      "S14-B4"
     ],
     "bars": "113–116"
    }
   ]
  }
 ]
}